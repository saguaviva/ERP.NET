@page "/ventas/albaranes/{ShipmentNumber:int}"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISalesOrderQueries SalesOrderQueries

<PageTitle>Albarán de venta @ShipmentNumber</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Ventas</p>
        <h1>@(shipment?.DisplayNumber ?? $"Salida {ShipmentNumber}")</h1>
        <p class="lead">Albarán de cliente generado desde la expedición del pedido.</p>
    </div>
    <div class="quick-links no-print">
        <a class="secondary-button link-button" href="/ventas/albaranes">Volver a albaranes</a>
        <a class="secondary-button link-button" href="/ventas/pre-facturacion">Abrir pre-facturación</a>
        @if (shipment is not null)
        {
            <a class="secondary-button link-button" href="/ventas/pedidos/editar/@shipment.OrderNumber">Abrir pedido</a>
            <a class="secondary-button link-button" href="/ventas/albaranes/@shipment.ShipmentNumber/pdf" target="_blank">Versión PDF</a>
            @if (shipment.InvoiceNumber is int invoiceNumber)
            {
                <a class="secondary-button link-button" href="/ventas/facturas/@invoiceNumber">Abrir factura</a>
            }
        }
        <button class="secondary-button" type="button" onclick="window.print()">Imprimir</button>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>No hay empresa activa seleccionada.</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert danger">@errorMessage</div>
}
else if (shipment is null)
{
    <div class="empty-state">
        <p>No se ha encontrado el albarán solicitado.</p>
    </div>
}
else
{
    <section class="panel receipt-document">
        <div class="receipt-document-header">
            <div>
                <p class="eyebrow">Albarán de cliente</p>
                <h2>@shipment.DisplayNumber</h2>
                <p class="muted">Pedido origen @shipment.OrderNumber</p>
            </div>
            <div class="receipt-document-meta">
                <strong>Fecha</strong>
                <span>@shipment.ShipmentDate.ToString("dd/MM/yyyy")</span>
            </div>
        </div>

        <div class="comparison-grid">
            <section class="info-card">
                <h2>Empresa expedidora</h2>
                <p><strong>@shipment.CompanyName</strong></p>
                <p class="muted">@shipment.TenantName</p>
                <p class="muted">Centro legacy @shipment.CompanyLegacyCenterCode</p>
            </section>
            <section class="info-card">
                <h2>Cliente</h2>
                <p><strong>@shipment.ClientName</strong></p>
                @if (!string.IsNullOrWhiteSpace(shipment.ClientTaxId))
                {
                    <p class="muted">NIF @shipment.ClientTaxId</p>
                }
                @if (!string.IsNullOrWhiteSpace(ClientLocation))
                {
                    <p class="muted">@ClientLocation</p>
                }
            </section>
        </div>

        <div class="receipt-detail-grid">
            <section class="info-card">
                <h2>Cabecera logística</h2>
                <div class="receipt-kv-grid">
                    <div>
                        <span class="muted">Almacén</span>
                        <strong>@DisplayValue(shipment.Warehouse)</strong>
                    </div>
                    <div>
                        <span class="muted">Fecha salida</span>
                        <strong>@shipment.ShipmentDate.ToString("dd/MM/yyyy")</strong>
                    </div>
                    <div>
                        <span class="muted">Pedido origen</span>
                        <strong>@shipment.OrderNumber</strong>
                    </div>
                </div>
            </section>
            <section class="info-card">
                <h2>Preparado para facturación</h2>
                <div class="receipt-kv-grid">
                    <div>
                        <span class="muted">Estado</span>
                        <strong>@FormatInvoiceStatus(shipment.InvoiceStatus)</strong>
                    </div>
                    <div>
                        <span class="muted">Referencia factura</span>
                        <strong>@(shipment.InvoiceDisplayNumber ?? DisplayValue(shipment.InvoiceReference))</strong>
                    </div>
                    <div>
                        <span class="muted">Listo desde</span>
                        <strong>@(shipment.InvoiceReadyUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Sin dato")</strong>
                    </div>
                </div>
            </section>
        </div>
    </section>

    <div class="card-grid purchase-summary-grid">
        <section class="info-card">
            <h2>@shipment.DisplayNumber</h2>
            <p>albarán</p>
        </section>
        <section class="info-card">
            <h2>Pedido @shipment.OrderNumber</h2>
            <p>@shipment.ClientName</p>
        </section>
        <section class="info-card">
            <h2>@shipment.ShipmentDate.ToString("dd/MM/yyyy")</h2>
            <p class="muted">fecha de salida</p>
        </section>
        <section class="info-card accent-card">
            <h2>@shipment.TotalShippedQuantity.ToString("0.###")</h2>
            <p class="muted">cantidad expedida</p>
        </section>
    </div>

    <section class="panel">
        <h2>Detalle de líneas</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Línea</th>
                    <th>Descripción</th>
                    <th>Cantidad</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in shipment.Lines)
                {
                    <tr>
                        <td>@line.LineNumber</td>
                        <td>@line.Description</td>
                        <td>@line.ShippedQuantity.ToString("0.###")</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    @if (!string.IsNullOrWhiteSpace(shipment.Notes))
    {
        <section class="panel">
            <h2>Notas</h2>
            <p>@shipment.Notes</p>
        </section>
    }
}

@code {
    [Parameter]
    public int ShipmentNumber { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private SalesOrderShipmentDto? shipment;
    private string errorMessage = string.Empty;

    private string ClientLocation
    {
        get
        {
            if (shipment is null)
            {
                return string.Empty;
            }

            var parts = new[]
            {
                shipment.ClientAddress,
                $"{shipment.ClientPostalCode} {shipment.ClientCity}".Trim(),
                shipment.ClientProvince,
                shipment.ClientCountry
            }.Where(part => !string.IsNullOrWhiteSpace(part));

            return string.Join(" · ", parts);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        try
        {
            errorMessage = string.Empty;
            shipment = await SalesOrderQueries.GetShipmentByNumberAsync(tenantId.Value, companyId.Value, ShipmentNumber);
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            shipment = null;
        }
    }

    private static string DisplayValue(string value) => string.IsNullOrWhiteSpace(value) ? "Sin dato" : value;
    private static string FormatInvoiceStatus(string status) => status switch
    {
        "Pending" => "Pendiente de facturar",
        "Drafted" => "En borrador de factura",
        "Invoiced" => "Facturado",
        _ => status
    };
}
