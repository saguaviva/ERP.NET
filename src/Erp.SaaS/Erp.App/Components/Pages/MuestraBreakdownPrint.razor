@page "/articulos/muestras/impresion/desglose/{Code}/{SampleLineNumber:int}"
@page "/articulos/complementos/impresion/desglose/{Code}/{SampleLineNumber:int}"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IMuestraQueries MuestraQueries
@inject NavigationManager NavigationManager
@inject AppText T

<PageTitle>@PageTitleText</PageTitle>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L($"Selecciona una empresa activa para imprimir el desglose del {moduleSingularLower}.", $"Selecciona una empresa activa per imprimir el desglossament del {moduleSingularLower}.", $"Select an active company to print the breakdown of the {moduleSingularLower}.")</p>
    </div>
}
else if (detail is null || line is null || breakdown is null)
{
    <div class="empty-state">
        <p>@L($"No se ha encontrado el desglose del {moduleSingularLower} solicitado.", $"No s'ha trobat el desglossament del {moduleSingularLower} sol·licitat.", $"The requested {moduleSingularLower} breakdown could not be found.")</p>
    </div>
}
else
{
    <section class="print-sheet-page">
        <header class="print-sheet-header">
            <div>
                <p class="eyebrow">@EyebrowText</p>
                <h1>@($"{(IsComplementMode ? L("Desglose técnico complemento", "Desglossament tècnic complement", "Complement technical breakdown") : L("Desglose técnico muestra", "Desglossament tècnic mostra", "Sample technical breakdown"))} · {detail.Code}")</h1>
                <p>@detail.Description</p>
                <p>@DisplayClient · @DisplayBreakdownTitle</p>
            </div>
            <div class="print-sheet-meta">
                <span>@DisplayMachine</span>
                <span>@DisplayDate</span>
                <span>@($"{breakdown.Lines.Count} {L("materiales", "materials", "materials")}")</span>
                <span>@($"{L("Coste", "Cost", "Cost")} {TotalCost.ToUiString("0.00##")}")</span>
            </div>
        </header>

        <section class="print-sheet-grid">
            <article>
                <h2>@L("Cabecera máquina", "Capçalera màquina", "Machine header")</h2>
                <dl class="print-definition-list">
                    <div><dt>@L("Cliente", "Client", "Customer")</dt><dd>@DisplayClient</dd></div>
                    <div><dt>@L("Color muestra", "Color mostra", "Sample color")</dt><dd>@DisplayColor</dd></div>
                    <div><dt>@L("Talla", "Talla", "Size")</dt><dd>@DisplaySize</dd></div>
                    <div><dt>@L("Máquina", "Màquina", "Machine")</dt><dd>@DisplayMachine</dd></div>
                    <div><dt>@L("Operación", "Operació", "Operation")</dt><dd>@DisplayOperation</dd></div>
                    <div><dt>@L("Agujas", "Agulles", "Needles")</dt><dd>@breakdown.Needles.ToUiString("0.##")</dd></div>
                    <div><dt>@L("Velocidad", "Velocitat", "Speed")</dt><dd>@breakdown.Speed.ToUiString("0.##")</dd></div>
                    <div><dt>@L("Disco", "Disc", "Disk")</dt><dd>@DisplayDisk</dd></div>
<div><dt>@L("Tiempo", "Temps", "Time")</dt><dd>@($"{breakdown.TimeMinutes.ToUiString("0.##")} min")</dd></div>
                    <div><dt>@L("Precio máquina", "Preu màquina", "Machine rate")</dt><dd>@breakdown.MachineRate.ToUiString("0.00##")</dd></div>
                    <div><dt>@L("Importe máquina", "Import màquina", "Machine amount")</dt><dd>@MachineImport.ToUiString("0.00##")</dd></div>
                    <div><dt>@L("Cortes", "Talls", "Cuts")</dt><dd>@DisplayCuts</dd></div>
                </dl>
            </article>

            <article>
                <h2>@L("Notas técnicas", "Notes tècniques", "Technical notes")</h2>
                <div class="print-notes-box">@DisplayNotes</div>
            </article>
        </section>

        <section class="panel">
            <h2>@L("Desglose de hilos y consumos", "Desglossament de fils i consums", "Yarn and consumption breakdown")</h2>
            <table class="data-table print-data-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@L("Hilo", "Fil", "Yarn")</th>
                        <th>@L("Proveedor", "Proveïdor", "Supplier")</th>
                        <th>@L("Color", "Color", "Color")</th>
                        <th>GH</th>
                        <th>@L("Cabos", "Caps", "Ends")</th>
                        <th>@L("Pasadas", "Passades", "Passes")</th>
                        <th>@L("Grad.", "Grad.", "Grad.")</th>
                        <th>@L("Consum", "Consum", "Consumption")</th>
                        <th>@L("Precio", "Preu", "Price")</th>
                        <th>@L("Importe", "Import", "Amount")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var material in breakdown.Lines.OrderBy(item => item.LineNumber))
                    {
                        <tr>
                            <td>@material.LineNumber</td>
                            <td>@DisplayYarn(material)</td>
                            <td>@DisplayProvider(material)</td>
                            <td>@DisplayMaterialColor(material)</td>
                            <td>@material.YarnMetric.ToUiString("0.##")</td>
                            <td>@material.Ends.ToUiString("0.##")</td>
                            <td>@material.Passes.ToUiString("0.##")</td>
                            <td>@material.Graduation</td>
                            <td>@material.Consumption.ToUiString("0.00##")</td>
                            <td>@material.Price.ToUiString("0.00##")</td>
                            <td>@CalculateImport(material).ToUiString("0.00##")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    </section>
}

@code {
    [Parameter]
    public string Code { get; set; } = string.Empty;

    [Parameter]
    public int SampleLineNumber { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private MuestraDetailDto? detail;
    private MuestraLineDto? line;
    private MuestraBreakdownDto? breakdown;
    private bool IsComplementMode => NavigationManager.Uri.Contains("/articulos/complementos", StringComparison.OrdinalIgnoreCase);
    private string moduleSingularLower => IsComplementMode ? L("complemento", "complement", "complement") : L("muestra", "mostra", "sample");
    private string EyebrowText => IsComplementMode ? L("ARTÍCULOS / COMPLEMENTOS", "ARTICLES / COMPLEMENTS", "ARTICLES / COMPLEMENTS") : L("ARTÍCULOS / MUESTRAS", "ARTICLES / MOSTRES", "ARTICLES / SAMPLES");
    private string PageTitleText => $"{(IsComplementMode ? L("Desglose complemento", "Desglossament complement", "Complement breakdown") : L("Desglose muestra", "Desglossament mostra", "Sample breakdown"))} {Code}";
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    private string DisplayClient => breakdown is not null && !string.IsNullOrWhiteSpace(breakdown.ClientName)
        ? breakdown.ClientName
        : detail is not null && !string.IsNullOrWhiteSpace(detail.ClientName)
            ? detail.ClientName
            : detail is not null ? $"{L("Cliente", "Client", "Customer")} {detail.ClientCode}" : string.Empty;
    private string DisplayBreakdownTitle => line is null ? string.Empty : $"{DisplayColor} · {DisplaySize}";
    private string DisplayColor => line is null || string.IsNullOrWhiteSpace(line.Color) ? L("Sin color", "Sense color", "No color") : line.Color;
    private string DisplaySize => line is null ? "-" : BuildSizeLabel(line);
    private string DisplayMachine => breakdown is null
        ? L("Sin máquina", "Sense màquina", "No machine")
        : !string.IsNullOrWhiteSpace(breakdown.MachineName) ? breakdown.MachineName : (breakdown.MachineCode > 0 ? $"{L("Máquina", "Màquina", "Machine")} {breakdown.MachineCode}" : L("Sin máquina", "Sense màquina", "No machine"));
    private string DisplayOperation => breakdown is null
        ? L("Sin operación", "Sense operació", "No operation")
        : !string.IsNullOrWhiteSpace(breakdown.OperationName) ? breakdown.OperationName : (breakdown.OperationCode > 0 ? $"{L("Operación", "Operació", "Operation")} {breakdown.OperationCode}" : L("Sin operación", "Sense operació", "No operation"));
    private string DisplayDate => breakdown?.WorkDate?.ToString("dd/MM/yyyy") ?? L("Sin fecha", "Sense data", "No date");
    private string DisplayDisk => breakdown is null || string.IsNullOrWhiteSpace(breakdown.Disk) ? "-" : breakdown.Disk;
    private string DisplayCuts => breakdown is null || string.IsNullOrWhiteSpace(breakdown.Cuts) ? "-" : breakdown.Cuts;
    private string DisplayNotes => breakdown is null || string.IsNullOrWhiteSpace(breakdown.Notes) ? L("Sin notas registradas.", "Sense notes registrades.", "No notes recorded.") : breakdown.Notes;
    private decimal MachineImport => breakdown is null ? 0m : Math.Round(breakdown.TimeMinutes * breakdown.MachineRate, 2);
    private decimal TotalCost => MachineImport + (breakdown?.Lines.Sum(CalculateImport) ?? 0m);

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            detail = null;
            line = null;
            breakdown = null;
            return;
        }

        detail = await MuestraQueries.GetByCodeAsync(tenantId.Value, companyId.Value, Uri.UnescapeDataString(Code));
        line = detail?.Lines.FirstOrDefault(item => item.LineNumber == SampleLineNumber);
        breakdown = line?.Breakdown;
    }

    private static string BuildSizeLabel(MuestraLineDto line)
    {
        var values = new[] { Normalize(line.SizeCode), Normalize(line.SizeHigh), Normalize(line.SizeLow) }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .ToArray();
        return values.Length == 0 ? "-" : string.Join(" · ", values);
    }

    private static string DisplayYarn(MuestraBreakdownLineDto line) =>
        string.IsNullOrWhiteSpace(line.YarnCode) ? "-" : line.YarnCode;

    private string DisplayProvider(MuestraBreakdownLineDto line) =>
        !string.IsNullOrWhiteSpace(line.ProviderName) ? line.ProviderName : (line.ProviderCode > 0 ? $"{L("Proveedor", "Proveïdor", "Supplier")} {line.ProviderCode}" : "-");

    private static string DisplayMaterialColor(MuestraBreakdownLineDto line) =>
        string.IsNullOrWhiteSpace(line.MaterialColor) ? "-" : line.MaterialColor;

    private static decimal CalculateImport(MuestraBreakdownLineDto line) =>
        Math.Round(line.Consumption * line.Price, 2);

    private static string Normalize(string? value) => value?.Trim() ?? string.Empty;
}
