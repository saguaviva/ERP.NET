@page "/almacen/inventarios/{CountNumber:int}/imprimir-recuento"
@layout EmptyLayout
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStockQueries StockQueries
@inject AppText T

<PageTitle>@($"{L("Hoja de recuento", "Full de recompte", "Count sheet")} {CountNumber}")</PageTitle>

<div class="document-shell">
    <div class="document-toolbar no-print">
        <a class="secondary-button link-button" href="/almacen/inventarios/editar/@CountNumber">@L("Volver al inventario", "Tornar a l'inventari", "Back to inventory")</a>
        <a class="secondary-button link-button" href="/almacen/inventarios/@CountNumber/imprimir">@L("Ver ficha completa", "Veure fitxa completa", "View full sheet")</a>
        <button class="primary-button" type="button" onclick="window.print()">@L("Imprimir / guardar PDF", "Imprimir / desar PDF", "Print / save PDF")</button>
    </div>

    @if (!tenantId.HasValue || !companyId.HasValue)
    {
        <div class="empty-state document-state">
            <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger document-state">@errorMessage</div>
    }
    else if (detail is null)
    {
        <div class="empty-state document-state">
            <p>@L("No se ha encontrado el inventario solicitado.", "No s'ha trobat l'inventari sol·licitat.", "The requested inventory could not be found.")</p>
        </div>
    }
    else
    {
        <section class="document-page count-sheet-page">
            <header class="count-sheet-header">
                <div>
                    <p class="eyebrow">@L("Almacén / Inventarios", "Magatzem / Inventaris", "Warehouse / Inventories")</p>
                    <h1>@L("Hoja de recuento", "Full de recompte", "Count sheet") @detail.CountNumber</h1>
                    <p class="muted">
                        @(detail.IsBlindCount ? L("Conteo ciego de planta.", "Recompte cec de planta.", "Blind warehouse-floor count.") : L("Hoja de recuento para planta.", "Full de recompte per a planta.", "Count sheet for warehouse floor."))
                        @L("Casillas vacías para anotar el conteo manual.", "Caselles buides per anotar el recompte manual.", "Empty boxes to write the manual count.")
                    </p>
                </div>
                <div class="count-sheet-meta">
                    <span><strong>@L("Fecha", "Data", "Date"):</strong> @detail.CountDate.ToString("dd/MM/yyyy")</span>
                    <span><strong>@L("Almacén", "Magatzem", "Warehouse"):</strong> @DisplayValue(detail.Warehouse)</span>
                    <span><strong>@L("Líneas", "Línies", "Lines"):</strong> @detail.LineCount</span>
                    <span><strong>@L("Modo", "Mode", "Mode"):</strong> @(detail.IsBlindCount ? L("Ciego", "Cec", "Blind") : L("Normal", "Normal", "Normal"))</span>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(detail.Notes))
            {
                <section class="document-section">
                    <div class="document-box">
                        <h2>@L("Observaciones", "Observacions", "Notes")</h2>
                        <p>@detail.Notes</p>
                    </div>
                </section>
            }

            <section class="document-section">
                <table class="data-table document-table count-sheet-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@L("Familia", "Família", "Family")</th>
                            <th>@L("Artículo", "Article", "Item")</th>
                            <th>@L("Descripción", "Descripció", "Description")</th>
                            <th>@L("Color", "Color", "Color")</th>
                            <th>@L("Unidad", "Unitat", "Unit")</th>
                            <th>@L("Conteo", "Recompte", "Count")</th>
                            <th>@L("Repaso", "Repàs", "Review")</th>
                            <th>@L("Final", "Final", "Final")</th>
                            <th>@L("Observaciones", "Observacions", "Notes")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in OrderedLines)
                        {
                            <tr>
                                <td>@line.LineNumber</td>
                                <td>@GetFamilyKey(line)</td>
                                <td>@DisplayValue(line.ItemCode)</td>
                                <td>@DisplayValue(line.ItemDescription)</td>
                                <td>@DisplayValue(line.Color)</td>
                                <td>@DisplayValue(line.UnitOfMeasure)</td>
                                <td><span class="count-sheet-box" aria-hidden="true"></span></td>
                                <td><span class="count-sheet-box" aria-hidden="true"></span></td>
                                <td><span class="count-sheet-box" aria-hidden="true"></span></td>
                                <td><span class="count-sheet-notes" aria-hidden="true"></span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        </section>
    }
</div>

@code {
    [Parameter]
    public int CountNumber { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private StockCountDetailDto? detail;
    private string errorMessage = string.Empty;
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    private IEnumerable<StockCountLineDto> OrderedLines =>
        detail is null
            ? Array.Empty<StockCountLineDto>()
            : detail.Lines
                .OrderBy(line => GetFamilyKey(line), StringComparer.OrdinalIgnoreCase)
                .ThenBy(line => line.ItemCode, StringComparer.OrdinalIgnoreCase)
                .ThenBy(line => line.Color, StringComparer.OrdinalIgnoreCase)
                .ThenBy(line => line.LineNumber);

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        try
        {
            errorMessage = string.Empty;
            detail = await StockQueries.GetCountByNumberAsync(tenantId.Value, companyId.Value, CountNumber);
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            detail = null;
        }
    }

    private string GetFamilyKey(StockCountLineDto line)
    {
        var code = line.ItemCode?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(code))
        {
            return L("Sin familia", "Sense família", "No family");
        }

        var separators = new[] { '-', '/', ' ', '_', '.' };
        foreach (var separator in separators)
        {
            var index = code.IndexOf(separator);
            if (index > 0)
            {
                return code[..index].Trim().ToUpperInvariant();
            }
        }

        return (code.Length <= 4 ? code : code[..4]).ToUpperInvariant();
    }

    private static string DisplayValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
