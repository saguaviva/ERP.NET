@page "/compras/pedidos"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILegacySyncService LegacySyncService
@inject IPurchaseOrderQueries PurchaseOrderQueries

<PageTitle>Compras / Pedidos</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Compras</p>
        <h1>Pedidos a proveedor</h1>
        <p class="lead">@(isLegacySyncActive
            ? "Consulta y filtra los pedidos replicados en la SaaS local, en solo lectura mientras el módulo siga sincronizado desde legacy."
            : "Listado web de pedidos por empresa activa, con estados, líneas y trazabilidad básica.")</p>
    </div>
    <div class="quick-links">
        @if (canEdit)
        {
            <a class="primary-button link-button" href="/compras/pedidos/nuevo">Nuevo pedido</a>
        }
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>Selecciona una empresa activa para trabajar con pedidos de compra.</p>
    </div>
}
else
{
    <section class="panel">
        <div class="filter-row">
            <input class="text-input" @bind="filter.Search" placeholder="Buscar por número, proveedor o notas" />
            <select class="text-input" @bind="filter.Status">
                <option value="">Todos los estados</option>
                @foreach (var status in PurchaseOrderStatuses.All)
                {
                    <option value="@status">@FormatStatus(status)</option>
                }
            </select>
            <label class="checkbox-field">
                <input type="checkbox" @bind="filter.IncludeClosed" />
                <span>Incluir cerrados</span>
            </label>
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? "Cargando..." : "Buscar")</button>
        </div>
        <div class="filter-row results-toolbar" style="margin-top: 0.85rem;">
            <span class="results-summary">
                @(totalCount == 0
                    ? "Sin resultados"
                    : $"Mostrando {PageStart}-{PageEnd} de {totalCount} pedidos")
            </span>
            <label class="field compact-field">
                <span>Tamaño de página</span>
                <select class="sidebar-select compact-select" value="@filter.PageSize" @onchange="OnPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }

    @if (isLegacySyncActive)
    {
        <div class="alert">
            Compras / Pedidos está en convivencia con legacy para esta empresa.
            La web muestra la réplica SaaS local y queda en solo lectura mientras la sincronización mande.
            @if (!string.IsNullOrWhiteSpace(syncStatusLabel))
            {
                <span>@syncStatusLabel</span>
            }
        </div>
    }

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)" aria-busy="@isLoading">
        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>Cargando pedidos de compra...</span>
            </div>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <SortableHeader Label="Número" IsActive="@(sortColumn == nameof(PurchaseOrderListItemDto.OrderNumber))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseOrderListItemDto.OrderNumber), true))" />
                    <SortableHeader Label="Proveedor" IsActive="@(sortColumn == nameof(PurchaseOrderListItemDto.SupplierName))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseOrderListItemDto.SupplierName)))" />
                    <SortableHeader Label="Fecha" IsActive="@(sortColumn == nameof(PurchaseOrderListItemDto.DocumentDate))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseOrderListItemDto.DocumentDate), true))" />
                    <SortableHeader Label="Prevista" IsActive="@(sortColumn == nameof(PurchaseOrderListItemDto.ExpectedDate))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseOrderListItemDto.ExpectedDate), true))" />
                    <SortableHeader Label="Estado" IsActive="@(sortColumn == nameof(PurchaseOrderListItemDto.Status))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseOrderListItemDto.Status)))" />
                    <SortableHeader Label="Líneas" IsActive="@(sortColumn == nameof(PurchaseOrderListItemDto.LineCount))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseOrderListItemDto.LineCount), true))" />
                    <SortableHeader Label="Total" IsActive="@(sortColumn == nameof(PurchaseOrderListItemDto.TotalAmount))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseOrderListItemDto.TotalAmount), true))" />
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    @for (var index = 0; index < 5; index++)
                    {
                        <tr class="table-skeleton-row">
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                        </tr>
                    }
                }
                else if (items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="table-empty">No hay pedidos para mostrar.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.OrderNumber</td>
                            <td>@item.SupplierName</td>
                            <td>@item.DocumentDate.ToString("dd/MM/yyyy")</td>
                            <td>@(item.ExpectedDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td><span class="status-pill @GetStatusClass(item.Status)">@FormatStatus(item.Status)</span></td>
                            <td>@item.LineCount</td>
                            <td>@item.TotalAmount.ToString("0.00") €</td>
                            <td>
                                <a class="inline-link" href="/compras/pedidos/editar/@item.OrderNumber">@(canEdit ? "Abrir" : "Ver")</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="pagination-bar">
            <span class="muted">Página @filter.Page de @TotalPages</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePageAsync(1)" disabled="@(!CanGoPrevious || isLoading)">Primera</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page - 1)" disabled="@(!CanGoPrevious || isLoading)">Anterior</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page + 1)" disabled="@(!CanGoNext || isLoading)">Siguiente</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(TotalPages)" disabled="@(!CanGoNext || isLoading)">Última</button>
            </div>
        </div>
    </section>
}

@code {
    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isLoading;
    private PurchaseOrderFilter filter = new() { Page = 1, PageSize = 25, SortColumn = nameof(PurchaseOrderListItemDto.OrderNumber), SortDescending = true };
    private IReadOnlyCollection<PurchaseOrderListItemDto> items = [];
    private string errorMessage = string.Empty;
    private string sortColumn = nameof(PurchaseOrderListItemDto.OrderNumber);
    private bool sortDescending = true;
    private bool isLegacySyncActive;
    private string syncStatusLabel = string.Empty;
    private int totalCount;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)filter.PageSize));
    private bool CanGoPrevious => filter.Page > 1;
    private bool CanGoNext => filter.Page < TotalPages;
    private int PageStart => totalCount == 0 ? 0 : ((filter.Page - 1) * filter.PageSize) + 1;
    private int PageEnd => totalCount == 0 ? 0 : Math.Min(filter.Page * filter.PageSize, totalCount);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);
        await LoadSyncStatusAsync();
        canEdit = canEdit && !isLegacySyncActive;

        await LoadAsync();
    }

    private async Task LoadSyncStatusAsync()
    {
        isLegacySyncActive = false;
        syncStatusLabel = string.Empty;

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var status = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
            .FirstOrDefault(item =>
                item.CompanyId == companyId.Value &&
                string.Equals(item.ModuleKey, LegacySyncModuleKeys.PurchaseOrders, StringComparison.OrdinalIgnoreCase));

        if (status is null || !status.HasSuccessfulSync)
        {
            return;
        }

        isLegacySyncActive = true;
        syncStatusLabel = status.LastCompletedUtc.HasValue
            ? $"Última sync: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Act: {status.LastUpdated} · Omi: {status.LastSkipped} · Err: {status.LastErrors}"
            : $"Estado: {status.LastStatus}";
    }

    private async Task LoadAsync()
    {
        errorMessage = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            items = [];
            totalCount = 0;
            return;
        }

        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            filter.SortColumn = sortColumn;
            filter.SortDescending = sortDescending;

            var result = await PurchaseOrderQueries.SearchAsync(tenantId.Value, companyId.Value, filter);
            items = result.Items;
            totalCount = result.TotalCount;
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            items = [];
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task SearchAsync()
    {
        filter.Page = 1;
        return LoadAsync();
    }

    private async Task SetSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(sortColumn, column, StringComparison.Ordinal))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = defaultDescending;
        }

        filter.Page = 1;
        await LoadAsync();
    }

    private async Task ChangePageAsync(int page)
    {
        var nextPage = Math.Clamp(page, 1, TotalPages);
        if (nextPage == filter.Page)
        {
            return;
        }

        filter.Page = nextPage;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return;
        }

        filter.PageSize = pageSize;
        filter.Page = 1;
        await LoadAsync();
    }

    private static string FormatStatus(string status) => status switch
    {
        PurchaseOrderStatuses.Draft => "Borrador",
        PurchaseOrderStatuses.Sent => "Enviado",
        PurchaseOrderStatuses.PartiallyReceived => "Recibido parcial",
        PurchaseOrderStatuses.Received => "Recibido total",
        PurchaseOrderStatuses.Cancelled => "Cancelado",
        _ => status
    };

    private static string GetStatusClass(string status) => status switch
    {
        PurchaseOrderStatuses.Draft => "warning",
        PurchaseOrderStatuses.Sent => "success",
        PurchaseOrderStatuses.PartiallyReceived => "warning",
        PurchaseOrderStatuses.Received => "success",
        PurchaseOrderStatuses.Cancelled => "danger",
        _ => "warning"
    };
}
