@page "/almacen/inventarios/{CountNumber:int}/imprimir"
@layout EmptyLayout
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStockQueries StockQueries
@inject AppText T

<PageTitle>@($"{L("Inventario", "Inventari", "Inventory")} {CountNumber}")</PageTitle>

<div class="document-shell">
    <div class="document-toolbar no-print">
        <a class="secondary-button link-button" href="/almacen/inventarios/editar/@CountNumber">@L("Volver al inventario", "Tornar a l'inventari", "Back to inventory")</a>
        <a class="secondary-button link-button" href="/almacen/inventarios/@CountNumber/imprimir-recuento">@L("Hoja de recuento", "Full de recompte", "Count sheet")</a>
        <button class="primary-button" type="button" onclick="window.print()">@L("Imprimir / guardar PDF", "Imprimir / desar PDF", "Print / save PDF")</button>
    </div>

    @if (!tenantId.HasValue || !companyId.HasValue)
    {
        <div class="empty-state document-state">
            <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger document-state">@errorMessage</div>
    }
    else if (detail is null)
    {
        <div class="empty-state document-state">
            <p>@L("No se ha encontrado el inventario solicitado.", "No s'ha trobat l'inventari sol·licitat.", "The requested inventory could not be found.")</p>
        </div>
    }
    else
    {
        <section class="document-page">
            <header class="document-header">
                <div>
                    <p class="eyebrow">@L("Inventario", "Inventari", "Inventory")</p>
                    <h1>@detail.CountNumber</h1>
                    <p class="muted">@L("Almacén", "Magatzem", "Warehouse") @DisplayValue(detail.Warehouse) · @L("Estado", "Estat", "Status") @GetStatusLabel(detail.Status) · @(detail.IsBlindCount ? L("Conteo ciego", "Recompte cec", "Blind count") : L("Conteo normal", "Recompte normal", "Standard count"))</p>
                </div>
                <div class="document-header-meta">
                    <div>
                        <span class="muted">@L("Fecha", "Data", "Date")</span>
                        <strong>@detail.CountDate.ToString("dd/MM/yyyy")</strong>
                    </div>
                    <div>
                        <span class="muted">@L("Líneas", "Línies", "Lines")</span>
                        <strong>@detail.LineCount</strong>
                    </div>
                    <div>
                        <span class="muted">@L("Con diferencia", "Amb diferència", "With difference")</span>
                        <strong>@detail.DifferenceLineCount</strong>
                    </div>
                </div>
            </header>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>@L("Resumen", "Resum", "Summary")</h2>
                        <div class="document-kv-grid">
                            <div><span class="muted">@L("Esperado", "Esperat", "Expected")</span><strong>@detail.ExpectedTotalQuantity.ToUiString("0.###")</strong></div>
                            <div><span class="muted">@L("Modo", "Mode", "Mode")</span><strong>@(detail.IsBlindCount ? L("Ciego", "Cec", "Blind") : L("Normal", "Normal", "Normal"))</strong></div>
                            <div><span class="muted">@L("Contado", "Comptat", "Counted")</span><strong>@detail.CountedTotalQuantity.ToUiString("0.###")</strong></div>
                            <div><span class="muted">@L("Diferencia", "Diferència", "Difference")</span><strong>@(IsBlindHidden ? L("Oculta", "Oculta", "Hidden") : detail.DifferenceTotalQuantity.ToUiString("0.###"))</strong></div>
                            <div><span class="muted">@L("Origen", "Origen", "Origin")</span><strong>@DisplayValue(detail.Origin)</strong></div>
                            <div><span class="muted">@L("Esperado", "Esperat", "Expected")</span><strong>@(IsBlindHidden ? L("Oculto", "Ocult", "Hidden") : detail.ExpectedTotalQuantity.ToUiString("0.###"))</strong></div>
                        </div>
                    </section>
                    <section class="document-box">
                        <h2>@L("Observaciones", "Observacions", "Notes")</h2>
                        <p>@(string.IsNullOrWhiteSpace(detail.Notes) ? L("Sin observaciones registradas.", "Sense observacions registrades.", "No remarks recorded.") : detail.Notes)</p>
                    </section>
                </div>
            </section>

            <section class="document-section">
                <h2>@L("Detalle de líneas", "Detall de línies", "Line items")</h2>
                <table class="data-table document-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@L("Familia", "Família", "Family")</th>
                            <th>@L("Artículo", "Article", "Item")</th>
                            <th>@L("Descripción", "Descripció", "Description")</th>
                            <th>@L("Color", "Color", "Color")</th>
                            <th>@L("Esperado", "Esperat", "Expected")</th>
                            <th>@L("Contado", "Comptat", "Counted")</th>
                            <th>@L("Diferencia", "Diferència", "Difference")</th>
                            <th>@L("Validada", "Validada", "Validated")</th>
                            <th>@L("Unidad", "Unitat", "Unit")</th>
                            <th>@L("Notas", "Notes", "Notes")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in detail.Lines.OrderBy(item => item.LineNumber))
                        {
                            <tr>
                                <td>@line.LineNumber</td>
                                <td>@GetFamilyKey(line)</td>
                                <td>@DisplayValue(line.ItemCode)</td>
                                <td>@DisplayValue(line.ItemDescription)</td>
                                <td>@DisplayValue(line.Color)</td>
                                <td>@(IsBlindHidden ? L("Oculto", "Ocult", "Hidden") : line.ExpectedQuantity.ToUiString("0.###"))</td>
                                <td>@line.CountedQuantity.ToUiString("0.###")</td>
                                <td>@(IsBlindHidden ? L("Oculta", "Oculta", "Hidden") : line.DifferenceQuantity.ToUiString("0.###"))</td>
                                <td>@(IsBlindHidden ? "-" : (line.DifferenceQuantity == 0m ? "OK" : (line.IsDifferenceValidated ? L("Sí", "Sí", "Yes") : L("No", "No", "No"))))</td>
                                <td>@DisplayValue(line.UnitOfMeasure)</td>
                                <td>@DisplayValue(line.Notes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        </section>
    }
</div>

@code {
    [Parameter]
    public int CountNumber { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private StockCountDetailDto? detail;
    private string errorMessage = string.Empty;
    private bool IsBlindHidden => detail?.IsBlindCount == true && detail.IsBlindCountRevealed == false;
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        try
        {
            errorMessage = string.Empty;
            detail = await StockQueries.GetCountByNumberAsync(tenantId.Value, companyId.Value, CountNumber);
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            detail = null;
        }
    }

    private string GetStatusLabel(string status) => status switch
    {
        StockCountStatuses.Draft => L("Borrador", "Esborrany", "Draft"),
        StockCountStatuses.Completed => L("Completado", "Completat", "Completed"),
        StockCountStatuses.Cancelled => L("Anulado", "Anul·lat", "Cancelled"),
        _ => status
    };

    private string GetFamilyKey(StockCountLineDto line)
    {
        var code = line.ItemCode?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(code))
        {
            return L("Sin familia", "Sense família", "No family");
        }

        var separators = new[] { '-', '/', ' ', '_', '.' };
        foreach (var separator in separators)
        {
            var index = code.IndexOf(separator);
            if (index > 0)
            {
                return code[..index].Trim().ToUpperInvariant();
            }
        }

        return (code.Length <= 4 ? code : code[..4]).ToUpperInvariant();
    }

    private static string DisplayValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
