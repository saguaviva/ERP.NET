@page "/compras/facturas/nueva"
@page "/compras/facturas/editar/{InvoiceNumber:int}"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IPurchaseInvoiceQueries PurchaseInvoiceQueries
@inject IPurchaseInvoiceService PurchaseInvoiceService
@inject IPurchaseOrderQueries PurchaseOrderQueries
@inject IProveedorQueries ProveedorQueries
@inject NavigationManager NavigationManager
@inject AppText T

<PageTitle>@(InvoiceNumber.HasValue ? $"{L("Factura proveedor", "Factura proveïdor", "Supplier invoice")} {InvoiceNumber}" : L("Nueva factura de proveedor", "Nova factura de proveïdor", "New supplier invoice"))</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("Compras", "Compres", "Purchasing")</p>
        <h1>@(InvoiceNumber.HasValue ? $"{L("Factura", "Factura", "Invoice")} {InvoiceNumber}" : L("Nueva factura de proveedor", "Nova factura de proveïdor", "New supplier invoice"))</h1>
        <p class="lead">@L("Factura local de proveedor con trazabilidad hacia recepciones y pedidos de compra.", "Factura local de proveïdor amb traçabilitat cap a recepcions i comandes de compra.", "Local supplier invoice with traceability back to receipts and purchase orders.")</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="/compras/facturas">@L("Volver al listado", "Tornar al llistat", "Back to list")</a>
        @if (InvoiceNumber.HasValue)
        {
            <a class="secondary-button link-button" href="/compras/facturas/@InvoiceNumber.Value/pdf" target="_blank">@L("Versión PDF", "Versió PDF", "PDF version")</a>
        }
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p>
    </div>
}
else if (!canEdit && !InvoiceNumber.HasValue)
{
    <div class="empty-state">
        <p>@L("No tienes permisos para crear facturas de proveedor.", "No tens permisos per crear factures de proveïdor.", "You do not have permission to create supplier invoices.")</p>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
    }

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <div class="form-grid">
            <label class="field">
                <span>@L("Proveedor", "Proveïdor", "Supplier")</span>
                <InputSelect class="text-input" @bind-Value="model.SupplierCode" disabled="@(!canEdit || InvoiceNumber.HasValue && hasReceiptLinks)">
                    <option value="0">@L("Selecciona proveedor", "Selecciona proveïdor", "Select supplier")</option>
                    @foreach (var supplier in suppliers)
                    {
                        <option value="@supplier.Code">@supplier.Name (@supplier.Code)</option>
                    }
                </InputSelect>
                @if (SelectedSupplier is not null)
                {
                    <span class="field-hint">@SelectedSupplier.TaxId · @SelectedSupplier.City</span>
                }
            </label>
            <label class="field">
                <span>@L("Fecha documento", "Data document", "Document date")</span>
                <InputDate class="text-input" @bind-Value="model.DocumentDate" disabled="@(!canEdit)" />
            </label>
            <label class="field">
                <span>@L("Vencimiento", "Venciment", "Due date")</span>
                <InputDate class="text-input" @bind-Value="model.DueDate" disabled="@(!canEdit)" />
            </label>
            <label class="field">
                <span>@L("Estado", "Estat", "Status")</span>
                <InputSelect class="text-input" @bind-Value="model.Status" disabled="@(!canEdit)">
                    @foreach (var status in PurchaseInvoiceStatuses.All)
                    {
                        <option value="@status">@FormatStatus(status)</option>
                    }
                </InputSelect>
            </label>
            <label class="field wide">
                <span>@L("Número factura proveedor", "Número factura proveïdor", "Supplier invoice number")</span>
                <InputText class="text-input" @bind-Value="model.SupplierDocumentNumber" disabled="@(!canEdit)" />
            </label>
            <label class="field wide">
                <span>@L("Notas", "Notes", "Notes")</span>
                <InputTextArea class="text-area" @bind-Value="model.Notes" disabled="@(!canEdit)" />
            </label>
        </div>

        <section class="panel">
            <div class="page-header">
                <div>
                    <h2>@L("Recepciones enlazadas", "Recepcions enllaçades", "Linked receipts")</h2>
                    <p class="muted">@L("La factura puede nacer desde una recepción y conserva aquí la trazabilidad documental.", "La factura pot néixer des d'una recepció i conserva aquí la traçabilitat documental.", "The invoice can originate from a receipt and keeps the document traceability here.")</p>
                </div>
            </div>

            @if (model.Receipts.Count == 0)
            {
                <p class="muted">@L("No hay recepciones enlazadas. Puedes crear la factura manualmente o partir desde una recepción.", "No hi ha recepcions enllaçades. Pots crear la factura manualment o partir des d'una recepció.", "There are no linked receipts. You can create the invoice manually or start from a receipt.")</p>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@L("Entrada", "Entrada", "Receipt")</th>
                            <th>@L("Pedido", "Comanda", "Order")</th>
                            <th>@L("Fecha", "Data", "Date")</th>
                            <th>@L("Cantidad", "Quantitat", "Quantity")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var receipt in model.Receipts)
                        {
                            <tr>
                                <td>@receipt.DisplayNumber</td>
                                <td>@receipt.OrderNumber</td>
                                <td>@receipt.ReceiptDate.ToString("dd/MM/yyyy")</td>
                                <td>@receipt.TotalReceivedQuantity.ToUiString("0.###")</td>
                                <td>
                                    <a class="inline-link" href="/compras/recepciones/@receipt.ReceiptNumber">@L("Abrir recepción", "Obrir recepció", "Open receipt")</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="panel">
            <div class="page-header">
                <div>
                    <h2>@L("Conciliación pedido · recepción · factura", "Conciliació comanda · recepció · factura", "Order · receipt · invoice reconciliation")</h2>
                    <p class="muted">@L("Comparativa rápida entre lo pedido, lo recibido y lo que estás facturando, con diferencias de cantidad y precio.", "Comparativa ràpida entre el que s'ha demanat, rebut i facturat, amb diferències de quantitat i preu.", "Quick comparison between what was ordered, received and invoiced, with quantity and price differences.")</p>
                </div>
            </div>

            @if (reconciliationRows.Count > 0)
            {
                <div class="alert @(ReconciliationHasDifferences ? "danger" : "success")">
                    <strong>@ReconciliationHeadline</strong>
                    <span>
                        @if (ReconciliationHasDifferences)
                        {
                        @($"{DifferenceLineCount.ToUiString("N0")} {L("líneas con diferencias", "línies amb diferències", "lines with differences")} · Qty {TotalQuantityDifference.ToUiString("0.###")} · {L("Precio", "Preu", "Price")} {TotalPriceDifference.ToUiString("0.0000")} · {L("Base", "Base", "Base")} {TotalBaseDifference.ToUiString("0.00")} €")
                        }
                        else
                        {
                            @(L("La factura cuadra con lo recibido y el precio esperado en las líneas conciliables.", "La factura quadra amb el rebut i el preu esperat a les línies conciliables.", "The invoice matches the received quantities and expected price on reconcilable lines."))
                        }
                    </span>
                </div>
            }

            <div class="card-grid purchase-summary-grid purchase-metrics-grid">
                <article class="info-card">
                    <h2>@reconciliationRows.Sum(row => row.ReceivedQuantity).ToUiString("0.###")</h2>
                    <p class="muted">@L("qty recibida", "qty rebuda", "received qty")</p>
                </article>
                <article class="info-card">
                    <h2>@reconciliationRows.Sum(row => row.InvoicedQuantity).ToUiString("0.###")</h2>
                    <p class="muted">@L("qty facturada", "qty facturada", "invoiced qty")</p>
                </article>
                <article class="info-card">
                    <h2>@reconciliationRows.Sum(row => row.ExpectedBase).ToUiString("0.00") €</h2>
                    <p class="muted">@L("base prevista", "base prevista", "expected base")</p>
                </article>
                <article class="info-card">
                    <h2>@reconciliationRows.Sum(row => row.InvoicedBase).ToUiString("0.00") €</h2>
                    <p class="muted">@L("base facturada", "base facturada", "invoiced base")</p>
                </article>
                <article class="info-card accent-card">
                    <h2>@reconciliationRows.Count(row => row.HasDifference)</h2>
                    <p class="muted">@L("líneas con diferencia", "línies amb diferència", "lines with difference")</p>
                </article>
                <article class="info-card">
                    <h2>@TotalBaseDifference.ToUiString("0.00") €</h2>
                    <p class="muted">@L("desviación base", "desviació base", "base deviation")</p>
                </article>
            </div>

            @if (reconciliationRows.Count == 0)
            {
                <p class="muted">@L("Todavía no hay datos suficientes para conciliar. Enlaza una recepción o marca el origen pedido de las líneas.", "Encara no hi ha dades suficients per conciliar. Enllaça una recepció o marca l'origen comanda de les línies.", "There is not enough data yet to reconcile. Link a receipt or mark the source order of the lines.")</p>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@L("Pedido", "Comanda", "Order")</th>
                            <th>@L("Línea", "Línia", "Line")</th>
                            <th>@L("Artículo", "Article", "Item")</th>
                            <th>@L("Descripción", "Descripció", "Description")</th>
                            <th>@L("Estado", "Estat", "Status")</th>
                            <th>@L("Pedida", "Demanada", "Ordered")</th>
                            <th>@L("Recibida", "Rebuda", "Received")</th>
                            <th>@L("Facturada", "Facturada", "Invoiced")</th>
                            <th>@L("Dif. qty", "Dif. qty", "Qty diff.")</th>
                            <th>@L("Precio pedido", "Preu comanda", "Order price")</th>
                            <th>@L("Precio factura", "Preu factura", "Invoice price")</th>
                            <th>@L("Dif. precio", "Dif. preu", "Price diff.")</th>
                            <th>@L("Base prevista", "Base prevista", "Expected base")</th>
                            <th>@L("Base factura", "Base factura", "Invoice base")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in reconciliationRows)
                        {
                            <tr class="@row.RowClass">
                                <td>@(row.OrderNumber?.ToString() ?? DisplayValue(null))</td>
                                <td>@(row.OrderLineNumber?.ToString() ?? DisplayValue(null))</td>
                                <td>@DisplayValue(row.ItemCode)</td>
                                <td>@row.Description</td>
                                <td><span class="status-pill @row.StatusClass">@FormatReconciliationStatus(row)</span></td>
                                <td>@row.OrderedQuantity.ToUiString("0.###")</td>
                                <td>@row.ReceivedQuantity.ToUiString("0.###")</td>
                                <td>@row.InvoicedQuantity.ToUiString("0.###")</td>
                                <td>@row.QuantityDifference.ToUiString("0.###")</td>
                                <td>@row.OrderUnitPrice.ToUiString("0.0000")</td>
                                <td>@row.InvoiceUnitPrice.ToUiString("0.0000")</td>
                                <td>@row.PriceDifference.ToUiString("0.0000")</td>
                                <td>@row.ExpectedBase.ToUiString("0.00") €</td>
                                <td>@row.InvoicedBase.ToUiString("0.00") €</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="panel">
            <div class="page-header">
                <div>
                    <h2>@L("Líneas de factura", "Línies de factura", "Invoice lines")</h2>
                    <p class="muted">@L("Puedes ajustar precios, IVA y descripciones antes de registrar la factura definitiva.", "Pots ajustar preus, IVA i descripcions abans de registrar la factura definitiva.", "You can adjust prices, VAT and descriptions before registering the final invoice.")</p>
                </div>
                @if (canEdit)
                {
                    <button class="secondary-button" type="button" @onclick="AddLine">@L("Añadir línea", "Afegir línia", "Add line")</button>
                }
            </div>

            <div class="stack">
                @for (var index = 0; index < model.Lines.Count; index++)
                {
                    var line = model.Lines[index];
                    <section class="panel line-editor">
                        <div class="panel-header">
                            <strong>@L("Línea", "Línia", "Line") @line.LineNumber</strong>
                            @if (canEdit && model.Lines.Count > 1)
                            {
                                <button class="secondary-button" type="button" @onclick="() => RemoveLine(index)">@L("Quitar", "Treure", "Remove")</button>
                            }
                        </div>
                        <div class="form-grid">
                            <label class="field">
                                <span>@L("Artículo", "Article", "Item")</span>
                                <InputText class="text-input" @bind-Value="line.ItemCode" disabled="@(!canEdit)" />
                            </label>
                            <label class="field wide">
                                <span>@L("Descripción", "Descripció", "Description")</span>
                                <InputText class="text-input" @bind-Value="line.Description" disabled="@(!canEdit)" />
                            </label>
                            <label class="field">
                                <span>@L("Cantidad", "Quantitat", "Quantity")</span>
                                <InputNumber class="text-input" @bind-Value="line.Quantity" disabled="@(!canEdit)" />
                            </label>
                            <label class="field">
                                <span>@L("Unidad", "Unitat", "Unit")</span>
                                <InputText class="text-input" @bind-Value="line.UnitOfMeasure" disabled="@(!canEdit)" />
                            </label>
                            <label class="field">
                                <span>@L("Precio unitario", "Preu unitari", "Unit price")</span>
                                <InputNumber class="text-input" @bind-Value="line.UnitPrice" disabled="@(!canEdit)" />
                            </label>
                            <label class="field">
                                <span>@L("IVA %", "IVA %", "VAT %")</span>
                                <InputNumber class="text-input" @bind-Value="line.TaxRate" disabled="@(!canEdit)" />
                            </label>
                        </div>
                        <div class="receipt-kv-grid">
                            <div>
                                <span class="muted">@L("Origen pedido", "Origen comanda", "Order source")</span>
                                <strong>@(line.SourceOrderNumber?.ToString() ?? DisplayValue(null))</strong>
                            </div>
                            <div>
                                <span class="muted">@L("Línea pedido", "Línia comanda", "Order line")</span>
                                <strong>@(line.SourceOrderLineNumber?.ToString() ?? DisplayValue(null))</strong>
                            </div>
                            <div>
                                <span class="muted">@L("Origen recepción", "Origen recepció", "Receipt source")</span>
                                <strong>@(line.SourceReceiptNumber?.ToString() ?? DisplayValue(null))</strong>
                            </div>
                            <div>
                                <span class="muted">@L("Base", "Base", "Base")</span>
                                <strong>@LineSubtotal(line).ToUiString("0.00") €</strong>
                            </div>
                            <div>
                                <span class="muted">@L("Total", "Total", "Total")</span>
                                <strong>@LineTotal(line).ToUiString("0.00") €</strong>
                            </div>
                        </div>
                    </section>
                }
            </div>
        </section>

        <section class="panel">
            <h2>@L("Resumen", "Resum", "Summary")</h2>
            <div class="card-grid purchase-summary-grid purchase-metrics-grid">
                <article class="info-card">
                    <h2>@model.Lines.Count</h2>
                    <p class="muted">@L("líneas", "línies", "lines")</p>
                </article>
                <article class="info-card">
                    <h2>@model.Receipts.Count</h2>
                    <p class="muted">@L("recepciones", "recepcions", "receipts")</p>
                </article>
                <article class="info-card">
                    <h2>@TotalNetAmount.ToUiString("0.00") €</h2>
                    <p class="muted">@L("base", "base", "base")</p>
                </article>
                <article class="info-card">
                    <h2>@TotalTaxAmount.ToUiString("0.00") €</h2>
                    <p class="muted">@L("IVA", "IVA", "VAT")</p>
                </article>
                <article class="info-card accent-card">
                    <h2>@TotalAmount.ToUiString("0.00") €</h2>
                    <p class="muted">@L("total", "total", "total")</p>
                </article>
            </div>
        </section>

        @if (InvoiceNumber.HasValue)
        {
            <section class="panel">
                <div class="page-header">
                    <div>
                        <h2>@L("Pagos proveedor", "Pagaments proveïdor", "Supplier payments")</h2>
                        <p class="muted">@L("Registro simple de pagos aplicados a esta factura para controlar lo pendiente.", "Registre simple de pagaments aplicats a aquesta factura per controlar el pendent.", "Simple register of payments applied to this invoice to control the outstanding amount.")</p>
                    </div>
                </div>

                <div class="card-grid purchase-summary-grid purchase-metrics-grid">
                    <article class="info-card">
                        <h2>@model.AmountPaid.ToUiString("0.00") €</h2>
                        <p class="muted">@L("pagado", "pagat", "paid")</p>
                    </article>
                    <article class="info-card accent-card">
                        <h2>@model.OutstandingAmount.ToUiString("0.00") €</h2>
                        <p class="muted">@L("pendiente", "pendent", "outstanding")</p>
                    </article>
                    <article class="info-card">
                        <h2>@(model.LastPaymentUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? L("Sin pago", "Sense pagament", "No payment"))</h2>
                        <p class="muted">@L("último pago", "últim pagament", "last payment")</p>
                    </article>
                </div>

                @if (canRegisterPayments)
                {
                    <div class="form-grid">
                        <label class="field">
                            <span>@L("Fecha pago", "Data pagament", "Payment date")</span>
                            <InputDate class="text-input" @bind-Value="paymentModel.PaymentDate" />
                        </label>
                        <label class="field">
                            <span>@L("Importe", "Import", "Amount")</span>
                            <InputNumber class="text-input" @bind-Value="paymentModel.Amount" />
                        </label>
                        <label class="field">
                            <span>@L("Método", "Mètode", "Method")</span>
                            <InputText class="text-input" @bind-Value="paymentModel.Method" />
                        </label>
                        <label class="field">
                            <span>@L("Referencia", "Referència", "Reference")</span>
                            <InputText class="text-input" @bind-Value="paymentModel.Reference" />
                        </label>
                        <label class="field wide">
                            <span>@L("Notas pago", "Notes pagament", "Payment notes")</span>
                            <InputTextArea class="text-area" @bind-Value="paymentModel.Notes" />
                        </label>
                    </div>

                    <div class="quick-links" style="margin-top: 1rem;">
                        <button class="secondary-button" type="button" @onclick="RegisterPaymentAsync" disabled="@isRegisteringPayment">
                            @(isRegisteringPayment ? L("Registrando pago...", "Registrant pagament...", "Registering payment...") : L("Registrar pago", "Registrar pagament", "Register payment"))
                        </button>
                    </div>
                }

                <table class="data-table" style="margin-top: 1rem;">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@L("Fecha", "Data", "Date")</th>
                            <th>@L("Importe", "Import", "Amount")</th>
                            <th>@L("Método", "Mètode", "Method")</th>
                            <th>@L("Referencia", "Referència", "Reference")</th>
                            <th>@L("Notas", "Notes", "Notes")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (model.Payments.Count == 0)
                        {
                            <tr><td colspan="6" class="table-empty">@L("Todavía no hay pagos registrados.", "Encara no hi ha pagaments registrats.", "There are no payments registered yet.")</td></tr>
                        }
                        else
                        {
                            @foreach (var payment in model.Payments)
                            {
                                <tr>
                                    <td>@payment.PaymentNumber</td>
                                    <td>@payment.PaymentDate.ToString("dd/MM/yyyy")</td>
                                    <td>@payment.Amount.ToUiString("0.00") €</td>
                                    <td>@DisplayValue(payment.Method)</td>
                                    <td>@DisplayValue(payment.Reference)</td>
                                    <td>@DisplayValue(payment.Notes)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </section>
        }

        @if (canEdit)
        {
            <div class="quick-links" style="margin-top: 1rem;">
                <button class="primary-button" type="submit" disabled="@isSaving">@(isSaving ? L("Guardando...", "Desant...", "Saving...") : L("Guardar factura", "Desar factura", "Save invoice"))</button>
                @if (InvoiceNumber.HasValue)
                {
                    <button class="secondary-button" type="button" @onclick="DeleteAsync" disabled="@isDeleting">@(isDeleting ? L("Eliminando...", "Eliminant...", "Deleting...") : L("Eliminar", "Eliminar", "Delete"))</button>
                }
            </div>
        }
    </EditForm>
}

@code {
    [Parameter]
    public int? InvoiceNumber { get; set; }

    [SupplyParameterFromQuery(Name = "receiptNumber")]
    public int? ReceiptNumberQuery { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isSaving;
    private bool isDeleting;
    private bool isRegisteringPayment;
    private bool hasReceiptLinks;
    private string statusMessage = string.Empty;
    private bool isError;
    private InvoiceFormModel model = new();
    private IReadOnlyCollection<ProveedorListItemDto> suppliers = [];
    private List<ReconciliationRowModel> reconciliationRows = [];
    private PaymentFormModel paymentModel = new();

    private ProveedorListItemDto? SelectedSupplier =>
        suppliers.FirstOrDefault(supplier => supplier.Code == model.SupplierCode);

    private bool canRegisterPayments =>
        canEdit &&
        InvoiceNumber.HasValue &&
        model.OutstandingAmount > 0m &&
        !string.Equals(model.Status, PurchaseInvoiceStatuses.Cancelled, StringComparison.OrdinalIgnoreCase);

    private bool ReconciliationHasDifferences => reconciliationRows.Any(row => row.HasDifference);
    private int DifferenceLineCount => reconciliationRows.Count(row => row.HasDifference);
    private decimal TotalQuantityDifference => decimal.Round(reconciliationRows.Sum(row => Math.Abs(row.QuantityDifference)), 3, MidpointRounding.AwayFromZero);
    private decimal TotalPriceDifference => decimal.Round(reconciliationRows.Sum(row => Math.Abs(row.PriceDifference)), 4, MidpointRounding.AwayFromZero);
    private decimal TotalBaseDifference => decimal.Round(reconciliationRows.Sum(row => row.BaseDifference), 2, MidpointRounding.AwayFromZero);
    private string ReconciliationHeadline => ReconciliationHasDifferences
        ? L("Factura con diferencias de conciliación", "Factura amb diferències de conciliació", "Invoice with reconciliation differences")
        : L("Factura cuadrada", "Factura quadrada", "Reconciled invoice");

    private decimal TotalNetAmount => model.Lines.Sum(LineSubtotal);
    private decimal TotalTaxAmount => model.Lines.Sum(line => decimal.Round(LineSubtotal(line) * (line.TaxRate / 100m), 2, MidpointRounding.AwayFromZero));
    private decimal TotalAmount => TotalNetAmount + TotalTaxAmount;
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        await LoadSuppliersAsync();

        if (InvoiceNumber.HasValue)
        {
            await LoadExistingInvoiceAsync();
            return;
        }

        await InitializeNewAsync();
    }

    private async Task LoadSuppliersAsync()
    {
        var result = await ProveedorQueries.SearchAsync(
            tenantId!.Value,
            companyId!.Value,
            new ProveedorFilter { Page = 1, PageSize = 200 },
            CancellationToken.None);
        suppliers = result.Items;
    }

    private async Task LoadExistingInvoiceAsync()
    {
        statusMessage = string.Empty;
        isError = false;

        var invoice = await PurchaseInvoiceQueries.GetInvoiceByNumberAsync(tenantId!.Value, companyId!.Value, InvoiceNumber!.Value);
        if (invoice is null)
        {
            statusMessage = L("No se ha encontrado la factura indicada.", "No s'ha trobat la factura indicada.", "The requested invoice could not be found.");
            isError = true;
            model = new InvoiceFormModel();
            return;
        }

        model = new InvoiceFormModel
        {
            InvoiceNumber = invoice.InvoiceNumber,
            SupplierCode = invoice.SupplierCode,
            SupplierDocumentNumber = invoice.SupplierDocumentNumber,
            DocumentDate = invoice.DocumentDate,
            DueDate = invoice.DueDate,
            Status = invoice.Status,
            Notes = invoice.Notes,
            AmountPaid = invoice.AmountPaid,
            OutstandingAmount = invoice.OutstandingAmount,
            LastPaymentUtc = invoice.LastPaymentUtc,
            Receipts = invoice.Receipts.Select(receipt => new PurchaseInvoiceReceiptLinkDto
            {
                ReceiptId = receipt.ReceiptId,
                ReceiptSeries = receipt.ReceiptSeries,
                ReceiptNumber = receipt.ReceiptNumber,
                OrderNumber = receipt.OrderNumber,
                ReceiptDate = receipt.ReceiptDate,
                TotalReceivedQuantity = receipt.TotalReceivedQuantity
            }).ToList(),
            Lines = invoice.Lines.Select(line => new InvoiceLineModel
            {
                LineNumber = line.LineNumber,
                ItemCode = line.ItemCode,
                Description = line.Description,
                Quantity = line.Quantity,
                UnitOfMeasure = line.UnitOfMeasure,
                UnitPrice = line.UnitPrice,
                TaxRate = line.TaxRate,
                SourceOrderNumber = line.SourceOrderNumber,
                SourceOrderLineNumber = line.SourceOrderLineNumber,
                SourceReceiptNumber = line.SourceReceiptNumber
            }).ToList(),
            Payments = invoice.Payments.ToList()
        };

        hasReceiptLinks = model.Receipts.Count > 0;
        paymentModel = new PaymentFormModel
        {
            PaymentDate = DateTime.Today,
            Amount = model.OutstandingAmount
        };
        EnsureAtLeastOneLine();
        await LoadReconciliationAsync();
    }

    private async Task InitializeNewAsync()
    {
        model = new InvoiceFormModel();
        hasReceiptLinks = false;

        if (ReceiptNumberQuery.HasValue && ReceiptNumberQuery.Value > 0)
        {
            var receipt = await PurchaseOrderQueries.GetReceiptByNumberAsync(tenantId!.Value, companyId!.Value, ReceiptNumberQuery.Value);
            if (receipt is not null)
            {
                PurchaseOrderDetailDto? order = null;
                if (receipt.OrderNumber > 0)
                {
                    order = await PurchaseOrderQueries.GetByOrderNumberAsync(tenantId.Value, companyId.Value, receipt.OrderNumber);
                }

                model.SupplierCode = receipt.SupplierCode;
                model.SupplierDocumentNumber = receipt.SupplierReference;
                model.DocumentDate = receipt.ReceiptDate;
                model.DueDate = receipt.ReceiptDate;
                model.Receipts =
                [
                    new PurchaseInvoiceReceiptLinkDto
                    {
                        ReceiptId = receipt.ReceiptId,
                        ReceiptSeries = receipt.ReceiptSeries,
                        ReceiptNumber = receipt.ReceiptNumber,
                        OrderNumber = receipt.OrderNumber,
                        ReceiptDate = receipt.ReceiptDate,
                        TotalReceivedQuantity = receipt.TotalReceivedQuantity
                    }
                ];

                model.Lines = receipt.Lines.Select(line =>
                {
                    var sourceLine = order?.Lines.FirstOrDefault(orderLine => orderLine.LineNumber == line.LineNumber);
                    return new InvoiceLineModel
                    {
                        LineNumber = line.LineNumber,
                        ItemCode = sourceLine?.ItemCode ?? string.Empty,
                        Description = sourceLine?.Description ?? line.Description,
                        Quantity = line.ReceivedQuantity,
                        UnitOfMeasure = sourceLine?.UnitOfMeasure ?? string.Empty,
                        UnitPrice = sourceLine?.UnitPrice ?? 0m,
                        TaxRate = 21m,
                        SourceOrderNumber = receipt.OrderNumber > 0 ? receipt.OrderNumber : sourceLine is null ? null : receipt.OrderNumber,
                        SourceOrderLineNumber = sourceLine?.LineNumber ?? line.LineNumber,
                        SourceReceiptNumber = receipt.ReceiptNumber
                    };
                }).ToList();

                hasReceiptLinks = true;
            }
        }

        paymentModel = new PaymentFormModel
        {
            PaymentDate = DateTime.Today,
            Amount = 0m
        };
        EnsureAtLeastOneLine();
        await LoadReconciliationAsync();
    }

    private void EnsureAtLeastOneLine()
    {
        if (model.Lines.Count == 0)
        {
            model.Lines.Add(new InvoiceLineModel { LineNumber = 1, TaxRate = 21m });
        }

        for (var index = 0; index < model.Lines.Count; index++)
        {
            model.Lines[index].LineNumber = index + 1;
        }
    }

    private void AddLine()
    {
        model.Lines.Add(new InvoiceLineModel
        {
            LineNumber = model.Lines.Count + 1,
            TaxRate = 21m
        });
    }

    private void RemoveLine(int index)
    {
        if (index < 0 || index >= model.Lines.Count)
        {
            return;
        }

        model.Lines.RemoveAt(index);
        EnsureAtLeastOneLine();
    }

    private async Task SaveAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !canEdit)
        {
            return;
        }

        isSaving = true;
        statusMessage = string.Empty;
        isError = false;

        try
        {
            var supplier = SelectedSupplier;
            var invoiceNumber = await PurchaseInvoiceService.SaveInvoiceAsync(new SavePurchaseInvoiceCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                InvoiceNumber = InvoiceNumber,
                SupplierCode = model.SupplierCode,
                SupplierName = supplier?.Name ?? string.Empty,
                SupplierTaxId = supplier?.TaxId ?? string.Empty,
                SupplierDocumentNumber = model.SupplierDocumentNumber,
                DocumentDate = model.DocumentDate,
                DueDate = model.DueDate,
                Status = model.Status,
                Notes = model.Notes,
                Receipts = model.Receipts,
                Lines = model.Lines.Select(line => new SavePurchaseInvoiceLineInputDto
                {
                    LineNumber = line.LineNumber,
                    ItemCode = line.ItemCode,
                    Description = line.Description,
                    Quantity = line.Quantity,
                    UnitOfMeasure = line.UnitOfMeasure,
                    UnitPrice = line.UnitPrice,
                    TaxRate = line.TaxRate,
                    SourceOrderNumber = line.SourceOrderNumber,
                    SourceOrderLineNumber = line.SourceOrderLineNumber,
                    SourceReceiptNumber = line.SourceReceiptNumber
                }).ToList()
            });

            NavigationManager.NavigateTo($"/compras/facturas/editar/{invoiceNumber}");
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task RegisterPaymentAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !InvoiceNumber.HasValue || !canRegisterPayments)
        {
            return;
        }

        isRegisteringPayment = true;
        statusMessage = string.Empty;
        isError = false;

        try
        {
            await PurchaseInvoiceService.RegisterPaymentAsync(new RegisterPurchaseInvoicePaymentCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                InvoiceNumber = InvoiceNumber.Value,
                PaymentDate = paymentModel.PaymentDate,
                Amount = paymentModel.Amount,
                Method = paymentModel.Method,
                Reference = paymentModel.Reference,
                Notes = paymentModel.Notes
            });

            await LoadExistingInvoiceAsync();
            statusMessage = L("Pago registrado correctamente.", "Pagament registrat correctament.", "Payment registered successfully.");
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
        finally
        {
            isRegisteringPayment = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !InvoiceNumber.HasValue || !canEdit)
        {
            return;
        }

        isDeleting = true;
        statusMessage = string.Empty;
