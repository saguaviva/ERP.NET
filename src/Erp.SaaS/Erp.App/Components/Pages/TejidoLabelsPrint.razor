@page "/articulos/tejidos/{Code}/etiquetas/{LabelCount:int}"
@layout EmptyLayout
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITejidoQueries TejidoQueries
@inject AppText T

<PageTitle>@($"{L("Etiquetas tejido", "Etiquetes teixit", "Fabric labels")} {Code}")</PageTitle>

<div class="document-shell">
    <div class="document-toolbar no-print">
        <a class="secondary-button link-button" href="/articulos/tejidos/editar/@Uri.EscapeDataString(Code)">@L("Volver al tejido", "Tornar al teixit", "Back to fabric")</a>
        <button class="primary-button" type="button" onclick="window.print()">@L("Imprimir / guardar PDF", "Imprimir / desar PDF", "Print / save PDF")</button>
    </div>

    @if (!tenantId.HasValue || !companyId.HasValue)
    {
        <div class="empty-state document-state">
            <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger document-state">@errorMessage</div>
    }
    else if (tejido is null)
    {
        <div class="empty-state document-state">
            <p>@L("No se ha encontrado el tejido solicitado.", "No s'ha trobat el teixit sol·licitat.", "The requested fabric could not be found.")</p>
        </div>
    }
    else
    {
        <section class="document-page">
            <header class="document-header">
                <div>
                    <p class="eyebrow">@L("Etiquetas tejido", "Etiquetes teixit", "Fabric labels")</p>
                    <h1>@tejido.Code</h1>
                    <p class="muted">@tejido.Description</p>
                </div>
                <div class="document-header-meta">
                    <div>
                        <span class="muted">@L("Cantidad", "Quantitat", "Quantity")</span>
                        <strong>@Math.Max(LabelCount, 1)</strong>
                    </div>
                </div>
            </header>

            <div class="labels-grid">
                @for (var index = 0; index < Math.Max(LabelCount, 1); index++)
                {
                    @RenderLabel()
                }
            </div>
        </section>
    }
</div>

@code {
    [Parameter]
    public string Code { get; set; } = string.Empty;

    [Parameter]
    public int LabelCount { get; set; }

    [SupplyParameterFromQuery]
    public string? Mode { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private TejidoDetailDto? tejido;
    private string errorMessage = string.Empty;
    private string EffectiveMode => string.IsNullOrWhiteSpace(Mode) ? "standard" : Mode.Trim().ToLowerInvariant();
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        try
        {
            errorMessage = string.Empty;
            tejido = await TejidoQueries.GetByCodeAsync(tenantId.Value, companyId.Value, Uri.UnescapeDataString(Code));
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
    }

    private static string DisplayValue(string value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private RenderFragment RenderLabel() => @<article class="fabric-label @(EffectiveMode == "compact" ? "compact" : EffectiveMode == "warehouse" ? "warehouse" : null)">
        @if (EffectiveMode == "warehouse")
        {
            <p class="eyebrow">@L("Almacén", "Magatzem", "Warehouse")</p>
            <h2>@tejido!.Code</h2>
            <p><strong>@tejido.Description</strong></p>
            <p>@L("Disponible", "Disponible", "Available") @tejido.AvailableStockMeters.ToUiString("0.###") m · @tejido.AvailableStockKilograms.ToUiString("0.###") kg</p>
            <p>@DisplayValue(tejido.WidthText) · @(tejido.IsTubular ? L("Tubular", "Tubular", "Tubular") : L("Plano", "Pla", "Flat"))</p>
        }
        else if (EffectiveMode == "compact")
        {
            <p class="eyebrow">@L("Tejido", "Teixit", "Fabric")</p>
            <h2>@tejido!.Code</h2>
            <p>@tejido.Description</p>
        }
        else
        {
            <p class="eyebrow">@L("Tejido", "Teixit", "Fabric")</p>
            <h2>@tejido!.Code</h2>
            <p><strong>@tejido.Description</strong></p>
            <p>@DisplayValue(tejido.CompositionText)</p>
            <p>@DisplayValue(tejido.WidthText) · @tejido.GramWeight.ToUiString("0.###") gr/m2</p>
        }
    </article>;
}
