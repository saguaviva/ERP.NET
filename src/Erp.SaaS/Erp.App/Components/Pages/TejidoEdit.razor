    private static string GetCoverageLabel(TejidoValuationRow row)
    {
        return GetCoverageLabel(row.CurrentMeters, row.MinimumMeters);
    }

    private static string GetCoverageLabel(decimal currentMeters, decimal minimumMeters)
    {
        if (minimumMeters <= 0m)
        {
            return currentMeters > 0m ? "Sin mínimo · con stock" : "Sin mínimo";
        }

        return $"{Math.Round(currentMeters / minimumMeters * 100m, 1, MidpointRounding.AwayFromZero):0.#}%";
    }

    private static string NormalizeLabelMode(string? mode)
    {
        return mode?.Trim().ToLowerInvariant() switch
        {
            "compact" => "compact",
            "warehouse" => "warehouse",
            _ => "standard"
        };
    }

    private static string GetLabelModeDisplayName(string mode)
    {
        return NormalizeLabelMode(mode) switch
        {
            "compact" => "Compacta",
            "warehouse" => "Almacén",
            _ => "Estándar"
        };
    }

    private static string GetLabelModeDescription(string mode)
    {
        return NormalizeLabelMode(mode) switch
        {
            "compact" => "Formato corto para identificar rápido código y descripción en tiradas cortas.",
            "warehouse" => "Formato pensado para almacén, centrado en disponibilidad, ancho y tipo de tejido.",
            _ => "Formato completo con código, descripción, composición y datos básicos del tejido."
        };
    }

    private static int NextLineNumber(IEnumerable<int> lineNumbers) =>
        lineNumbers.Any() ? lineNumbers.Max() + 1 : 1;

    private static void RemoveAndReorder<T>(ICollection<T> items, int lineNumber, Func<T, int> getLineNumber, Action<T, int> setLineNumber)
    {
        var item = items.FirstOrDefault(current => getLineNumber(current) == lineNumber);
        if (item is null)
        {
            return;
        }

        items.Remove(item);
        var ordered = items.OrderBy(getLineNumber).ToList();
        for (var index = 0; index < ordered.Count; index++)
        {
            setLineNumber(ordered[index], index + 1);
        }
    }

    private static decimal ResolveWidthMeters(decimal width2, string widthText)
    {
        if (width2 > 0)
        {
            return width2;
        }

        if (string.IsNullOrWhiteSpace(widthText))
        {
            return 0m;
        }

        var filtered = new string(widthText
            .Replace(',', '.')
            .Where(character => char.IsDigit(character) || character == '.')
            .ToArray());

        if (!decimal.TryParse(filtered, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var parsed))
        {
            return 0m;
        }

        return parsed >= 10m ? parsed / 100m : parsed;
    }

    private static string DisplayValue(string value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string DisplayValue(int value) =>
        value <= 0 ? "-" : value.ToString();

    private static int ParseMachineCode(string code) =>
        int.TryParse(code, out var parsedValue) ? parsedValue : 0;

    private static string FormatMachineOption(BaseCatalogListItemDto item) =>
        string.IsNullOrWhiteSpace(item.Name) ? item.Code : $"{item.Code} · {item.Name}";
