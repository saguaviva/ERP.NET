            <label class="field">
                <span>Coste tejer</span>
                <InputNumber class="text-input" @bind-Value="model.WeavingCost" />
            </label>
            <label class="field">
                <span>Estampador</span>
                <InputNumber class="text-input" @bind-Value="model.PrinterCode" />
            </label>
            <label class="field">
                <span>Coste estampar</span>
                <InputNumber class="text-input" @bind-Value="model.PrintingCost" />
            </label>
            <label class="field">
                <span>Acabador</span>
                <InputNumber class="text-input" @bind-Value="model.FinisherCode" />
