                        <button class="secondary-button" type="button" @onclick="ClearReplenishmentSelection">Limpiar selección</button>
                        <a class="primary-button link-button" href="@ReplenishmentSheetUrl" target="_blank">Abrir hoja de reposición</a>
                    </div>
                </div>
                <div class="stock-summary-status-grid">
                    <article class="stock-summary-status-card warning">
                        <strong>@SelectedReplenishmentCandidates.Count</strong>
                        <span>colores seleccionados</span>
                    </article>
                    <article class="stock-summary-status-card warning">
                        <strong>@SelectedReplenishmentMeters.ToString("0.###") m</strong>
                        <span>metros a reponer</span>
                    </article>
                    <article class="stock-summary-status-card warning">
                        <strong>@SelectedReplenishmentValue.ToString("0.00") €</strong>
                        <span>valor estimado</span>
                    </article>
                </div>
                <div class="table-scroll">
                    <table class="data-table detail-table">
                        <thead>
                            <tr>
                                <th>Incl.</th>
                                <th>Color</th>
                                <th>Estado</th>
                                <th>Actual</th>
                                <th>Mínimo</th>
                                <th>Falta</th>
                                <th>€/Mts.</th>
                                <th>Valor rep.</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ReplenishmentCandidates)
                            {
                                <tr class="@GetColorRowClass(item)">
                                    <td>
                                        <input type="checkbox" checked="@IsSelectedForReplenishment(item.LineNumber)" @onchange="args => SetReplenishmentSelection(item.LineNumber, args)" />
                                    </td>
                                    <td><strong>@DisplayValue(item.Color)</strong></td>
                                    <td><span class="status-pill @GetColorStatusClass(item)">@GetColorStatusLabel(item)</span></td>
                                    <td>@item.CurrentStock.ToString("0.###")</td>
                                    <td>@item.MinimumStock.ToString("0.###")</td>
