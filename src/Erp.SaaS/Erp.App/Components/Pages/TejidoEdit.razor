    private RenderFragment RenderImpresionTab() => @<section class="panel" style="margin-top: 1rem;">
        <div class="detail-panel-header">
            <div>
                <h2>Impressió Fitxa · Etiquetes</h2>
                <p class="muted">Previsualiza la ficha, las etiquetas y la valoración antes de abrir cada documento.</p>
            </div>
        </div>

        @if (string.IsNullOrWhiteSpace(model.Code))
        {
            <div class="alert">
                Guarda primero el tejido para poder generar la ficha técnica, las etiquetas y la valoración imprimible.
            </div>
        }
        else
        {
            <div class="impression-preview-grid">
                <article class="panel print-preview-card">
                    <p class="eyebrow">Fitxa tècnica</p>
                    <h3>@model.Code · Fitxa completa</h3>
                    <p class="muted">Incluye cabecera, costes, stock, carta de colores, composición y acabados.</p>
                    <div class="print-preview-sheet">
                        <div class="print-preview-sheet-header">
                            <strong>@model.Code</strong>
                            <span>@DisplayValue(model.Description)</span>
                        </div>
                        <div class="print-preview-kpis">
                            <span>@model.GramWeight.ToString("0.###") gr/m2</span>
                            <span>@DisplayValue(model.WidthText)</span>
                            <span>@(model.IsTubular ? "Tubular" : "Plano")</span>
                            <span>@ColorsCount colores</span>
                        </div>
                        <ul class="document-list print-preview-list">
                            <li>Composición texto: @DisplayValue(model.CompositionText)</li>
                            <li>Escandallo: @CompositionCount composiciones · @FinishesCount acabados</li>
                            <li>Stock: @model.AvailableStockMeters.ToString("0.###") m · @model.AvailableStockKilograms.ToString("0.###") kg</li>
                        </ul>
                    </div>
                    <div class="quick-links" style="margin-top: 0.85rem;">
                        <a class="primary-button link-button" href="@TechnicalSheetUrl" target="_blank">Abrir ficha imprimible</a>
                    </div>
                </article>
                <article class="panel print-preview-card">
                    <p class="eyebrow">Etiquetes</p>
                    <h3>@Math.Max(labelCount, 1) uds. · @GetLabelModeDisplayName(EffectiveLabelMode)</h3>
                    <p class="muted">@GetLabelModeDescription(EffectiveLabelMode)</p>
                    <div class="form-grid" style="margin-top: 0.75rem;">
                        <label class="field">
                            <span>Nº etiquetas</span>
                            <InputNumber class="text-input" @bind-Value="labelCount" />
                        </label>
                        <label class="field">
                            <span>Formato</span>
                            <InputSelect class="text-input" @bind-Value="labelMode">
                                <option value="standard">Estándar</option>
                                <option value="compact">Compacta</option>
                                <option value="warehouse">Almacén</option>
                            </InputSelect>
                        </label>
                    </div>
                    <div class="inline-action-list" style="margin-top: 0.35rem;">
                        <button class="secondary-button @(EffectiveLabelMode == "standard" ? "active-filter-chip" : null)" type="button" @onclick="@(() => SelectLabelMode("standard"))">Estándar</button>
                        <button class="secondary-button @(EffectiveLabelMode == "compact" ? "active-filter-chip" : null)" type="button" @onclick="@(() => SelectLabelMode("compact"))">Compacta</button>
                        <button class="secondary-button @(EffectiveLabelMode == "warehouse" ? "active-filter-chip" : null)" type="button" @onclick="@(() => SelectLabelMode("warehouse"))">Almacén</button>
                    </div>
                    <div class="labels-grid labels-grid-preview" style="margin-top: 1rem;">
                        @for (var previewIndex = 0; previewIndex < Math.Min(Math.Max(labelCount, 1), 2); previewIndex++)
                        {
                            @RenderLabelPreview()
                        }
                    </div>
                    <div class="quick-links" style="margin-top: 0.85rem;">
                        <button class="secondary-button" type="button" @onclick="OpenLabelsPrint">Abrir etiquetas</button>
                    </div>
                </article>
                <article class="panel print-preview-card">
                    <p class="eyebrow">Valoració stock</p>
                    <h3>@TotalStockValue.ToString("0.00") €</h3>
                    <p class="muted">Resumen económico del stock cru y del stock por color, con alertas y ranking.</p>
                    <div class="print-preview-sheet">
                        <div class="print-preview-kpis">
                            <span>Stock cru @RawStockValue.ToString("0.00") €</span>
                            <span>Stock color @FinishedStockValue.ToString("0.00") €</span>
                            <span>Cobertura @CoveragePercentage.ToString("0.#")%</span>
                        </div>
                        <ul class="document-list print-preview-list">
                            <li>@ValuationHealthyCount colores en rango</li>
                            <li>@ValuationBelowMinimumCount colores bajo mínimo</li>
                            <li>@ValuationWithoutStockCount colores sin stock</li>
                            @if (TopValuationRows.Count > 0)
                            {
                                <li>Top valor: @TopValuationRows[0].Color · @TopValuationRows[0].EstimatedValue.ToString("0.00") €</li>
                            }
                        </ul>
                    </div>
                    <div class="quick-links" style="margin-top: 0.85rem;">
                        <a class="secondary-button link-button" href="@ValuationSheetUrl" target="_blank">Abrir valoración</a>
                    </div>
                </article>
                <article class="panel print-preview-card">
                    <p class="eyebrow">Reposició</p>
                    <h3>@SelectedReplenishmentMeters.ToString("0.###") m</h3>
                    <p class="muted">Hoja agrupada con los colores seleccionados para reponer y su valor estimado.</p>
                    <div class="print-preview-sheet">
                        <div class="print-preview-kpis">
                            <span>@SelectedReplenishmentCandidates.Count colores</span>
                            <span>@SelectedReplenishmentValue.ToString("0.00") €</span>
                        </div>
                        @if (SelectedReplenishmentCandidates.Count == 0)
                        {
                            <p class="muted">No hay colores seleccionados para reposición en este momento.</p>
                        }
                        else
                        {
                            <ul class="document-list print-preview-list">
                                @foreach (var item in SelectedReplenishmentCandidates.Take(4))
                                {
                                    <li>@DisplayValue(item.Color) · faltan @GetSuggestedReplenishmentMeters(item).ToString("0.###") m</li>
                                }
                                @if (SelectedReplenishmentCandidates.Count > 4)
                                {
                                    <li>Y @((SelectedReplenishmentCandidates.Count - 4)) colores más en la selección.</li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="quick-links" style="margin-top: 0.85rem;">
                        <a class="secondary-button link-button" href="@ReplenishmentSheetUrl" target="_blank">Abrir reposición</a>
                    </div>
                </article>
            </div>
        }
    </section>;

    private RenderFragment RenderLabelPreview() => @<article class="fabric-label fabric-label-preview @(EffectiveLabelMode == "compact" ? "compact" : EffectiveLabelMode == "warehouse" ? "warehouse" : null)">
        @if (EffectiveLabelMode == "warehouse")
        {
            <p class="eyebrow">Almacén</p>
            <h2>@model.Code</h2>
            <p><strong>@DisplayValue(model.Description)</strong></p>
            <p>Disponible @model.AvailableStockMeters.ToString("0.###") m · @model.AvailableStockKilograms.ToString("0.###") kg</p>
            <p>@DisplayValue(model.WidthText) · @(model.IsTubular ? "Tubular" : "Plano")</p>
        }
        else if (EffectiveLabelMode == "compact")
        {
            <p class="eyebrow">Teixit</p>
            <h2>@model.Code</h2>
            <p>@DisplayValue(model.Description)</p>
        }
        else
        {
            <p class="eyebrow">Teixit</p>
            <h2>@model.Code</h2>
            <p><strong>@DisplayValue(model.Description)</strong></p>
            <p>@DisplayValue(model.CompositionText)</p>
            <p>@DisplayValue(model.WidthText) · @model.GramWeight.ToString("0.###") gr/m2</p>
        }
    </article>;

    private RenderFragment RenderValoracionTab() => @<section class="panel" style="margin-top: 1rem;">
        <div class="detail-panel-header">
            <div>
                <h2>Valoració Stock</h2>
                <p class="muted">Resumen económico del stock cru y del stock por color usando la información local del tejido.</p>
            </div>
        </div>

        <div class="tejido-valuation-grid">
            <article class="info-card">
                <p class="eyebrow">Stock cru</p>
                <h3>@RawStockValue.ToString("0.00") €</h3>
                <p class="muted">@model.RawStockKilograms.ToString("0.###") kg · @model.RawStockMeters.ToString("0.###") m</p>
            </article>
            <article class="info-card">
                <p class="eyebrow">Stock color</p>
                <h3>@FinishedStockValue.ToString("0.00") €</h3>
                <p class="muted">@TotalColorMeters.ToString("0.###") m sobre @ColorsCount colores</p>
            </article>
            <article class="info-card">
                <p class="eyebrow">Total</p>
                <h3>@TotalStockValue.ToString("0.00") €</h3>
                <p class="muted">Valor conjunto del tejido</p>
            </article>
            <article class="info-card">
                <p class="eyebrow">Cobertura</p>
                <h3>@CoveragePercentage.ToString("0.#")%</h3>
                <p class="muted">@ValuationHealthyCount en rango · @ValuationBelowMinimumCount bajo mínimo · @ValuationWithoutStockCount sin stock</p>
            </article>
            <article class="info-card">
                <p class="eyebrow">Peso stock color</p>
                <h3>@RawVsFinishedPercentage.ToString("0.#")%</h3>
                <p class="muted">del valor total está ya en colores</p>
            </article>
