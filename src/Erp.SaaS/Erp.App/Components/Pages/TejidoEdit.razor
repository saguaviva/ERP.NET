    private List<TejidoValuationRow> BuildValuationRows() =>
        model.Colors
            .OrderBy(item => item.LineNumber)
            .Select(item => new TejidoValuationRow(
                string.IsNullOrWhiteSpace(item.Color) ? $"Línea {item.LineNumber}" : item.Color,
                item.CurrentStock,
                item.MinimumStock,
                item.DyeingPrice,
                item.UnitCost,
                item.MetersPrice,
                item.KilogramsPrice,
                Math.Round(Math.Max(item.CurrentStock, 0m) * Math.Max(item.MetersPrice, 0m), 2, MidpointRounding.AwayFromZero),
                item.MinimumStock <= 0m
                    ? (item.CurrentStock > 0m ? 1m : 0m)
                    : Math.Round(item.CurrentStock / item.MinimumStock, 2, MidpointRounding.AwayFromZero),
                item.CurrentStock > 0m && item.MinimumStock > 0m && item.CurrentStock < item.MinimumStock,
                item.CurrentStock <= 0m))
            .ToList();

    private static decimal GetColorStockValue(TejidoColorDetailDto item) =>
        Math.Round(Math.Max(item.CurrentStock, 0m) * Math.Max(item.MetersPrice, 0m), 2, MidpointRounding.AwayFromZero);

    private string BuildColorMovementsUrl(TejidoColorDetailDto item) =>
        BuildMovementsUrl(BuildStockSearchText(item), "TEJIDO-COLOR");

    private string BuildDisposedMovementsUrl(TejidoColorDetailDto item) =>
        BuildMovementsUrl(model.Code ?? string.Empty, "TEJIDO-DISPUESTO");

    private string BuildRawMovementsUrl() =>
        BuildMovementsUrl(model.Code ?? string.Empty, "TEJIDO-CRUDO");

    private string BuildStockAdjustmentUrl(TejidoColorDetailDto item)
    {
        var description = string.IsNullOrWhiteSpace(item.Color)
            ? model.Description
            : $"{model.Description} · {item.Color}";

        return string.Concat(
            "/almacen/ajustes?ItemCode=", Uri.EscapeDataString(model.Code ?? string.Empty),
            "&Description=", Uri.EscapeDataString(description ?? string.Empty),
            "&Color=", Uri.EscapeDataString(item.Color ?? string.Empty),
            "&Unit=", Uri.EscapeDataString("m"),
            "&CurrentStock=", Uri.EscapeDataString(item.CurrentStock.ToString(System.Globalization.CultureInfo.InvariantCulture)));
    }

    private string BuildReplenishmentAdjustmentUrl(TejidoColorDetailDto item)
    {
        var suggestedMeters = GetSuggestedReplenishmentMeters(item);
        var description = string.IsNullOrWhiteSpace(item.Color)
            ? model.Description
            : $"{model.Description} · {item.Color}";
        var notes = string.Concat(
            "Reposición sugerida desde ficha de tejido. ",
            "Mínimo ", item.MinimumStock.ToString("0.###"),
            " m · actual ", item.CurrentStock.ToString("0.###"),
            " m.");

        return string.Concat(
            "/almacen/ajustes?Warehouse=", Uri.EscapeDataString("TEJIDO-COLOR"),
            "&ItemCode=", Uri.EscapeDataString(model.Code ?? string.Empty),
            "&Description=", Uri.EscapeDataString(description ?? string.Empty),
            "&Color=", Uri.EscapeDataString(item.Color ?? string.Empty),
            "&Unit=", Uri.EscapeDataString("m"),
            "&CurrentStock=", Uri.EscapeDataString(item.CurrentStock.ToString(System.Globalization.CultureInfo.InvariantCulture)),
            "&AdjustmentType=", Uri.EscapeDataString(StockMovementTypes.InboundManualAdjustment),
            "&Quantity=", Uri.EscapeDataString(suggestedMeters.ToString(System.Globalization.CultureInfo.InvariantCulture)),
            "&Notes=", Uri.EscapeDataString(notes));
    }

    private string BuildStockSearchText(TejidoColorDetailDto item)
    {
        if (string.IsNullOrWhiteSpace(item.Color))
        {
            return model.Code ?? string.Empty;
        }

        return string.Concat(model.Code, " ", item.Color).Trim();
    }

    private static string BuildMovementsUrl(string search, string warehouse)
    {
        return string.Concat(
            "/almacen/movimientos?search=", Uri.EscapeDataString(search ?? string.Empty),
            "&warehouse=", Uri.EscapeDataString(warehouse ?? string.Empty));
    }

    private static decimal GetSuggestedReplenishmentMeters(TejidoColorDetailDto item) =>
        Math.Round(Math.Max(item.MinimumStock - item.CurrentStock, 0m), 3, MidpointRounding.AwayFromZero);

    private static decimal GetSuggestedReplenishmentValue(TejidoColorDetailDto item) =>
        Math.Round(GetSuggestedReplenishmentMeters(item) * Math.Max(item.MetersPrice, 0m), 2, MidpointRounding.AwayFromZero);

    private static string GetColorCoverageLabel(TejidoColorDetailDto item) =>
        GetCoverageLabel(item.CurrentStock, item.MinimumStock);

    private static string GetColorStatusLabel(TejidoColorDetailDto item)
    {
        if (item.CurrentStock <= 0m)
        {
            return "Sin stock";
        }

        if (item.CurrentStock < item.MinimumStock)
        {
            return "Bajo mínimo";
        }

        return "OK";
    }

    private static string GetColorStatusClass(TejidoColorDetailDto item)
    {
        if (item.CurrentStock <= 0m)
        {
            return "danger";
        }

        if (item.CurrentStock < item.MinimumStock)
        {
            return "warning";
        }

        return "success";
    }

    private static string GetColorRowClass(TejidoColorDetailDto item)
    {
        if (item.CurrentStock <= 0m)
        {
            return "stock-zero-row";
        }

        if (item.CurrentStock < item.MinimumStock)
        {
            return "stock-warning-row";
        }

        return string.Empty;
    }

