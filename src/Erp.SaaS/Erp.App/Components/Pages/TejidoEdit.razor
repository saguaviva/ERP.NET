        <div class="tejido-valuation-grid" style="margin-top: 1rem;">
            <article class="panel valuation-mini-panel">
                <div class="detail-panel-header">
                    <div>
                        <h3>Ranking por valor</h3>
                        <p class="muted">Colores que más valor concentran en stock.</p>
                    </div>
                </div>
                @if (TopValuationRows.Count == 0)
                {
                    <p class="muted">Sin colores valorables todavía.</p>
                }
                else
                {
                    <div class="list-block">
                        @foreach (var row in TopValuationRows)
                        {
                            <article class="list-item">
                                <strong>@row.Color</strong>
                                <span>@row.EstimatedValue.ToString("0.00") € · @row.CurrentMeters.ToString("0.###") m · @GetCoverageLabel(row)</span>
                            </article>
                        }
                    </div>
                }
            </article>
            <article class="panel valuation-mini-panel">
                <div class="detail-panel-header">
                    <div>
                        <h3>Alertas de stock</h3>
                        <p class="muted">Colores con falta de cobertura o sin stock.</p>
                    </div>
                </div>
                @if (AlertValuationRows.Count == 0)
                {
                    <p class="muted">No hay alertas activas en la carta de colores.</p>
                }
                else
                {
                    <div class="list-block">
                        @foreach (var row in AlertValuationRows.Take(6))
                        {
                            <article class="list-item">
                                <strong>@row.Color</strong>
                                <span>@GetCoverageLabel(row) · mínimo @row.MinimumMeters.ToString("0.###") m · actual @row.CurrentMeters.ToString("0.###") m</span>
                            </article>
                        }
                    </div>
                }
