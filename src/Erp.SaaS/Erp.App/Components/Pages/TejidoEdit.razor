                    <tr>
                        <th>Color</th>
                        <th>Estado</th>
                        <th>Cobertura</th>
                        <th>Actual</th>
                        <th>Mínimo</th>
                        <th>Tintar</th>
                        <th>Precio</th>
                        <th>€/Mts.</th>
                        <th>€/KG</th>
                        <th>Valor stock</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ValuationRows.Count == 0)
                    {
                        <tr><td colspan="10" class="muted">No hay colores cargados para valorar el stock del tejido.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in ValuationRows)
                        {
                            <tr class="@GetValuationRowClass(row)">
                                <td>@row.Color</td>
                                <td><span class="status-pill status-pill-@GetValuationPillClass(row)">@GetValuationStatus(row)</span></td>
                                <td>@GetCoverageLabel(row)</td>
                                <td>@row.CurrentMeters.ToString("0.###")</td>
                                <td>@row.MinimumMeters.ToString("0.###")</td>
                                <td>@row.DyeingPrice.ToString("0.0000")</td>
                                <td>@row.UnitCost.ToString("0.0000")</td>
                                <td>@row.MetersPrice.ToString("0.0000")</td>
                                <td>@row.KilogramsPrice.ToString("0.0000")</td>
                                <td>@row.EstimatedValue.ToString("0.00") €</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>;

    private RenderFragment RenderColorsSection() => @<section class="panel detail-panel" style="margin-top: 1rem;">
