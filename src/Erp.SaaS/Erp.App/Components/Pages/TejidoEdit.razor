@page "/articulos/tejidos/nuevo"
@page "/articulos/tejidos/editar/{Code}"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuditLogService AuditLogService
@inject IBaseCatalogQueries BaseCatalogQueries
@inject ILegacySyncService LegacySyncService
@inject ITejidoQueries TejidoQueries
@inject ITejidoService TejidoService
@inject NavigationManager NavigationManager

<PageTitle>@(!string.IsNullOrWhiteSpace(Code) ? $"Editar tejido {Code}" : "Nuevo tejido")</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">ARTÍCULOS</p>
        <h1>@(!string.IsNullOrWhiteSpace(Code) ? $"Ficha tejido {Code}" : "Nuevo tejido")</h1>
        <p class="lead">@(isLegacySyncActive
            ? "Edición sobre la SaaS local. La importación manual desde legacy refresca solo registros marcados como legacy."
            : "Alta y edición sobre la réplica local de tejidos, filtrada por la empresa activa.")</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="/articulos/tejidos">Volver al listado</a>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>No hay empresa activa seleccionada.</p>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
    }

    @if (isLegacySyncActive)
    {
        <div class="alert">
            Artículos / Tejidos está en convivencia con legacy para esta empresa.
            Esta ficha guarda cambios solo en la SaaS local y la sync manual refresca únicamente registros de origen legacy.
            @if (!string.IsNullOrWhiteSpace(syncStatusLabel))
            {
                <span>@syncStatusLabel</span>
            }
        </div>
    }

    @if (!canEdit && string.IsNullOrWhiteSpace(Code))
    {
        <div class="alert">
            No tienes permisos de edición para crear tejidos nuevos en esta empresa.
        </div>
    }

    <section class="card-grid tejido-metrics-grid">
        <article class="info-card">
            <p class="eyebrow">Origen</p>
            <h2>@(string.IsNullOrWhiteSpace(Code) ? "Nuevo tejido" : model.Code)</h2>
            <p class="muted">@DisplayOrigin</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">Detalle</p>
            <h2>@ColorsCount colores</h2>
            <p class="muted">@CompositionCount composiciones · @FinishesCount acabados</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">Composición</p>
            <h2>@CompositionPercentageTotal%</h2>
            <p class="muted">Total declarado en escandallo</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">Stock disponible</p>
            <h2>@model.AvailableStockMeters.ToString("0.###") m</h2>
            <p class="muted">@model.AvailableStockKilograms.ToString("0.###") kg</p>
        </article>
    </section>

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <fieldset disabled="@isReadOnly">
            <div class="module-tabs" style="margin-top: 1rem;">
                <button class="module-tab @(activeTab == TejidoTab.Teixit ? "active" : null)" type="button" @onclick="@(() => SetTab(TejidoTab.Teixit))">Teixit</button>
                <button class="module-tab @(activeTab == TejidoTab.Escandall ? "active" : null)" type="button" @onclick="@(() => SetTab(TejidoTab.Escandall))">Escandall Teixit</button>
                <button class="module-tab @(activeTab == TejidoTab.Impresion ? "active" : null)" type="button" @onclick="@(() => SetTab(TejidoTab.Impresion))">Impressió Fitxa · Etiquetes</button>
                <button class="module-tab @(activeTab == TejidoTab.Valoracion ? "active" : null)" type="button" @onclick="@(() => SetTab(TejidoTab.Valoracion))">Valoració Stock</button>
            </div>

            @switch (activeTab)
            {
                case TejidoTab.Teixit:
                    @RenderFichaTab()
                    break;
                case TejidoTab.Escandall:
                    @RenderEscandalloTab()
                    break;
                case TejidoTab.Impresion:
                    @RenderImpresionTab()
                    break;
                case TejidoTab.Valoracion:
                    @RenderValoracionTab()
                    break;
            }

            <div class="quick-links" style="margin-top: 1rem;">
                @if (canEdit)
                {
                    <button class="primary-button" type="submit">Guardar tejido</button>
                }
                @if (canEdit && !string.IsNullOrWhiteSpace(Code))
                {
                    <button class="secondary-button danger-button" type="button" @onclick="DeleteAsync">Eliminar tejido</button>
                }
                @if (!string.IsNullOrWhiteSpace(Code))
                {
                    <button class="secondary-button" type="button" @onclick="LoadAuditAsync">Recargar historial</button>
                }
            </div>
        </fieldset>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(Code))
    {
        <section class="panel" style="margin-top: 1rem;">
            <h2>Historial reciente del tejido</h2>
            <div class="list-block">
                @if (recentAuditLogs.Count == 0)
                {
                    <p class="muted">Todavía no hay eventos auditados para este tejido.</p>
                }
                else
                {
                    @foreach (var entry in recentAuditLogs)
                    {
                        <article class="list-item">
                            <strong>@entry.Action</strong>
                            @if (!string.IsNullOrWhiteSpace(entry.Details))
                            {
                                <span>@entry.Details</span>
                            }
                            <span>@entry.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </article>
                    }
                }
            </div>
        </section>
    }
}

@code {
    [Parameter]
    public string? Code { get; set; }

    private enum TejidoTab
    {
        Teixit,
        Escandall,
        Impresion,
        Valoracion
    }

    private sealed record TejidoValuationRow(
        string Color,
        decimal CurrentMeters,
        decimal MinimumMeters,
        decimal DyeingPrice,
        decimal UnitCost,
        decimal MetersPrice,
        decimal KilogramsPrice,
        decimal EstimatedValue,
        decimal CoverageRatio,
        bool IsBelowMinimum,
        bool HasNoStock);

    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isReadOnly;
    private TejidoDetailDto model = new();
    private string statusMessage = string.Empty;
    private bool isError;
    private bool isLegacySyncActive;
    private string syncStatusLabel = string.Empty;
    private IReadOnlyCollection<AuditLogEntryDto> recentAuditLogs = [];
    private IReadOnlyCollection<BaseCatalogListItemDto> machineOptions = [];
    private TejidoTab activeTab = TejidoTab.Teixit;
    private int labelCount = 12;
    private string labelMode = "standard";
    private HashSet<int> selectedReplenishmentLines = [];

    private int ColorsCount => model.Colors.Count;
    private int CompositionCount => model.Composition.Count;
    private int FinishesCount => model.Finishes.Count;
    private int ColorsWithoutStockCount => model.Colors.Count(item => item.CurrentStock <= 0m);
    private int ColorsBelowMinimumCount => model.Colors.Count(item => item.CurrentStock > 0m && item.CurrentStock < item.MinimumStock);
    private int ColorsHealthyCount => model.Colors.Count(item => item.CurrentStock >= item.MinimumStock && item.CurrentStock > 0m);
    private int ColorsWithoutMinimumCount => model.Colors.Count(item => item.MinimumStock <= 0m);
    private int CompositionPercentageTotal => model.Composition.Sum(item => Math.Max(item.Percentage, 0));
    private decimal CompositionPercentageGap => 100m - CompositionPercentageTotal;
    private string DisplayOrigin => string.IsNullOrWhiteSpace(model.Code) ? "Pendiente de guardar" : $"Origen {(string.IsNullOrWhiteSpace(Code) ? "local" : "local/legacy")} · centro {model.CompanyCenterCode}";
    private decimal NormalizedWidthMeters => ResolveWidthMeters(model.Width2, model.WidthText);
    private decimal LinearMeterWeight => Math.Round(model.GramWeight * Math.Max(NormalizedWidthMeters, 0m) * (model.IsTubular ? 2m : 1m), 3, MidpointRounding.AwayFromZero);
    private decimal RawStockValue => Math.Round(model.RawStockKilograms * model.RawCost, 2, MidpointRounding.AwayFromZero);
    private decimal FinishedStockValue => Math.Round(model.Colors.Sum(item => Math.Max(item.CurrentStock, 0m) * Math.Max(item.MetersPrice, 0m)), 2, MidpointRounding.AwayFromZero);
    private decimal TotalStockValue => RawStockValue + FinishedStockValue;
    private decimal TotalColorMeters => model.Colors.Sum(item => Math.Max(item.CurrentStock, 0m));
    private int ValuationBelowMinimumCount => ValuationRows.Count(item => item.IsBelowMinimum);
    private int ValuationWithoutStockCount => ValuationRows.Count(item => item.HasNoStock);
    private int ValuationHealthyCount => ValuationRows.Count(item => !item.HasNoStock && !item.IsBelowMinimum);
    private decimal CoveragePercentage => ValuationRows.Count == 0 ? 100m : Math.Round((decimal)ValuationHealthyCount / ValuationRows.Count * 100m, 1, MidpointRounding.AwayFromZero);
    private decimal RawVsFinishedPercentage => TotalStockValue <= 0m ? 0m : Math.Round(FinishedStockValue / TotalStockValue * 100m, 1, MidpointRounding.AwayFromZero);
    private IReadOnlyList<TejidoValuationRow> TopValuationRows => ValuationRows.OrderByDescending(item => item.EstimatedValue).Take(5).ToList();
    private IReadOnlyList<TejidoValuationRow> AlertValuationRows => ValuationRows.Where(item => item.HasNoStock || item.IsBelowMinimum).OrderBy(item => item.HasNoStock ? 0 : 1).ThenBy(item => item.Color).ToList();
    private decimal SuggestedReplenishmentMeters => model.Colors.Sum(GetSuggestedReplenishmentMeters);
    private decimal SuggestedReplenishmentValue => model.Colors.Sum(GetSuggestedReplenishmentValue);
    private IReadOnlyList<TejidoColorDetailDto> ReplenishmentCandidates => model.Colors
        .Where(item => GetSuggestedReplenishmentMeters(item) > 0m)
        .OrderByDescending(GetSuggestedReplenishmentMeters)
        .ThenBy(item => item.Color)
        .ToList();
    private IReadOnlyList<TejidoColorDetailDto> SelectedReplenishmentCandidates => ReplenishmentCandidates
        .Where(item => selectedReplenishmentLines.Contains(item.LineNumber))
        .ToList();
    private decimal SelectedReplenishmentMeters => SelectedReplenishmentCandidates.Sum(GetSuggestedReplenishmentMeters);
    private decimal SelectedReplenishmentValue => SelectedReplenishmentCandidates.Sum(GetSuggestedReplenishmentValue);
    private string TechnicalSheetUrl => string.IsNullOrWhiteSpace(model.Code) ? string.Empty : $"/articulos/tejidos/{Uri.EscapeDataString(model.Code)}/ficha";
    private string LabelsSheetUrl => string.IsNullOrWhiteSpace(model.Code) ? string.Empty : $"/articulos/tejidos/{Uri.EscapeDataString(model.Code)}/etiquetas/{Math.Max(labelCount, 1)}?mode={Uri.EscapeDataString(EffectiveLabelMode)}";
    private string ValuationSheetUrl => string.IsNullOrWhiteSpace(model.Code) ? string.Empty : $"/articulos/tejidos/{Uri.EscapeDataString(model.Code)}/valoracion";
    private string ReplenishmentSheetUrl => string.IsNullOrWhiteSpace(model.Code)
        ? string.Empty
        : $"/articulos/tejidos/{Uri.EscapeDataString(model.Code)}/reposicion?lines={Uri.EscapeDataString(string.Join(",", SelectedReplenishmentCandidates.Select(item => item.LineNumber)))}";
    private IReadOnlyList<TejidoValuationRow> ValuationRows => BuildValuationRows();
    private string CompositionStatusLabel => CompositionPercentageTotal == 100 ? "Completa" : CompositionPercentageTotal < 100 ? "Incompleta" : "Excedida";
    private string FinishSummarySuggested => string.Join(" · ", model.Finishes.OrderBy(item => item.Order).ThenBy(item => item.LineNumber).Select(item => item.FinishCode).Where(item => !string.IsNullOrWhiteSpace(item)).Distinct(StringComparer.OrdinalIgnoreCase));
    private string CompositionTextSuggested => string.Join(" + ", model.Composition.OrderBy(item => item.LineNumber).Where(item => item.Percentage > 0 || !string.IsNullOrWhiteSpace(item.ComponentCode)).Select(item => $"{item.Percentage}% {item.ComponentCode}".Trim()).Where(item => !string.IsNullOrWhiteSpace(item)));
    private string EffectiveLabelMode => NormalizeLabelMode(labelMode);

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        await LoadMachineOptionsAsync();
        await LoadSyncStatusAsync();
        isReadOnly = !canEdit;

        if (!string.IsNullOrWhiteSpace(Code))
        {
            var detail = await TejidoQueries.GetByCodeAsync(tenantId.Value, companyId.Value, Uri.UnescapeDataString(Code));
            if (detail is null)
            {
                statusMessage = "No se ha encontrado el tejido solicitado.";
                isError = true;
                model = new TejidoDetailDto();
                recentAuditLogs = [];
                return;
            }

            model = detail;
            RecalculateColorPrices();
            SyncReplenishmentSelection();
            await LoadAuditAsync();
            return;
        }

        model = new TejidoDetailDto();
        RecalculateColorPrices();
        SyncReplenishmentSelection();
        recentAuditLogs = [];
    }

    private void SetTab(TejidoTab tab) => activeTab = tab;

    private async Task LoadMachineOptionsAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            machineOptions = [];
            return;
        }

        var result = await BaseCatalogQueries.SearchAsync(tenantId.Value, companyId.Value, BaseCatalogKeys.Machines, new BaseCatalogFilter
        {
            Page = 1,
            PageSize = 200
        });

        machineOptions = result.Items
            .Where(item => int.TryParse(item.Code, out _))
            .OrderBy(item => ParseMachineCode(item.Code))
            .ToArray();
    }

    private async Task SaveAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        if (isReadOnly)
        {
            statusMessage = "No tienes permisos de edición en este tenant.";
            isError = true;
            return;
        }

        try
        {
            statusMessage = string.Empty;
            isError = false;
            RecalculateColorPrices();

            var savedCode = await TejidoService.SaveAsync(new SaveTejidoCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                Code = string.IsNullOrWhiteSpace(Code) ? model.Code : Uri.UnescapeDataString(Code),
                Description = model.Description,
                CompositionText = model.CompositionText,
                MachineCode = model.MachineCode,
                MaterialCost = model.MaterialCost,
                Notes = model.Notes,
                VatCode = model.VatCode,
                WeaverCode = model.WeaverCode,
                WeavingCost = model.WeavingCost,
                PrinterCode = model.PrinterCode,
                PrintingCost = model.PrintingCost,
                FinisherCode = model.FinisherCode,
                FinishSummary = model.FinishSummary,
                FinishingCost = model.FinishingCost,
                RawCost = model.RawCost,
                WidthText = model.WidthText,
                Yield = model.Yield,
                Margin = model.Margin,
                GramWeight = model.GramWeight,
                PricePerMeter = model.PricePerMeter,
                PricePerKilogram = model.PricePerKilogram,
                RawStockMeters = model.RawStockMeters,
                AvailableStockMeters = model.AvailableStockMeters,
                RawStockKilograms = model.RawStockKilograms,
                AvailableStockKilograms = model.AvailableStockKilograms,
                SamplePrice = model.SamplePrice,
                IsTubular = model.IsTubular,
                Width2 = model.Width2,
                Colors = model.Colors.OrderBy(item => item.LineNumber).Select(item => new SaveTejidoColorInput
                {
                    LineNumber = item.LineNumber,
                    SupplierCode = item.SupplierCode,
                    Color = item.Color,
                    CurrentStock = item.CurrentStock,
                    MinimumStock = item.MinimumStock,
                    DyeingPrice = item.DyeingPrice,
                    UnitCost = item.UnitCost,
                    MetersPrice = item.MetersPrice,
                    KilogramsPrice = item.KilogramsPrice,
                    Notes = item.Notes
                }).ToList(),
                Composition = model.Composition.OrderBy(item => item.LineNumber).Select(item => new SaveTejidoCompositionInput
                {
                    LineNumber = item.LineNumber,
                    ComponentCode = item.ComponentCode,
                    Percentage = item.Percentage,
                    SupplierCode = item.SupplierCode,
                    UnitPrice = item.UnitPrice,
                    Amount = item.Amount
                }).ToList(),
                Finishes = model.Finishes.OrderBy(item => item.LineNumber).Select(item => new SaveTejidoFinishInput
                {
                    LineNumber = item.LineNumber,
                    FinishCode = item.FinishCode,
                    SupplierCode = item.SupplierCode,
                    Order = item.Order,
                    PricePerMeter = item.PricePerMeter,
                    PricePerKilogram = item.PricePerKilogram
                }).ToList()
            });

            statusMessage = !string.IsNullOrWhiteSpace(Code)
                ? "Tejido actualizado correctamente."
                : "Tejido creado correctamente.";

            if (string.IsNullOrWhiteSpace(Code))
            {
                NavigationManager.NavigateTo($"/articulos/tejidos/editar/{Uri.EscapeDataString(savedCode)}", forceLoad: false);
                return;
            }

            await LoadAuditAsync();
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private async Task LoadSyncStatusAsync()
    {
        isLegacySyncActive = false;
        syncStatusLabel = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var status = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
            .FirstOrDefault(item =>
                item.CompanyId == companyId.Value &&
                string.Equals(item.ModuleKey, LegacySyncModuleKeys.ArticleTejidos, StringComparison.OrdinalIgnoreCase));

        if (status is null || !status.HasSuccessfulSync)
        {
            return;
        }

        isLegacySyncActive = true;
        syncStatusLabel = status.LastCompletedUtc.HasValue
            ? $"Última sync: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Act: {status.LastUpdated} · Omi: {status.LastSkipped} · Err: {status.LastErrors}"
            : $"Estado: {status.LastStatus}";
    }

    private void AddColor()
    {
        model.Colors.Add(new TejidoColorDetailDto { LineNumber = NextLineNumber(model.Colors.Select(item => item.LineNumber)), SupplierCode = 0 });
        RecalculateColorPrices();
        SyncReplenishmentSelection();
    }

    private void AddComposition()
    {
        model.Composition.Add(new TejidoCompositionDetailDto { LineNumber = NextLineNumber(model.Composition.Select(item => item.LineNumber)) });
    }

    private void AddFinish()
    {
        model.Finishes.Add(new TejidoFinishDetailDto { LineNumber = NextLineNumber(model.Finishes.Select(item => item.LineNumber)), SupplierCode = model.FinisherCode });
    }

    private void RemoveColor(int lineNumber)
    {
        RemoveAndReorder(model.Colors, lineNumber, item => item.LineNumber, (item, number) => item.LineNumber = number);
        RecalculateColorPrices();
        SyncReplenishmentSelection();
    }

    private void RemoveComposition(int lineNumber)
    {
        RemoveAndReorder(model.Composition, lineNumber, item => item.LineNumber, (item, number) => item.LineNumber = number);
    }

    private void RemoveFinish(int lineNumber)
    {
        RemoveAndReorder(model.Finishes, lineNumber, item => item.LineNumber, (item, number) => item.LineNumber = number);
    }

    private async Task DeleteAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || string.IsNullOrWhiteSpace(Code))
        {
            return;
        }

        try
        {
            await TejidoService.DeleteAsync(tenantId.Value, companyId.Value, Uri.UnescapeDataString(Code));
            NavigationManager.NavigateTo("/articulos/tejidos");
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private async Task LoadAuditAsync()
    {
        if (!tenantId.HasValue || string.IsNullOrWhiteSpace(Code))
        {
            recentAuditLogs = [];
            return;
        }

        recentAuditLogs = await AuditLogService.GetRecentAsync(
            limit: 12,
            tenantId: tenantId.Value,
            entityName: "Tejido",
            entityId: Uri.UnescapeDataString(Code));
    }

    private void OpenLabelsPrint()
    {
        if (!string.IsNullOrWhiteSpace(model.Code))
        {
            NavigationManager.NavigateTo(LabelsSheetUrl, forceLoad: false);
        }
    }

    private void SelectLabelMode(string mode)
    {
        labelMode = NormalizeLabelMode(mode);
    }

    private void SelectAllReplenishmentCandidates()
    {
        selectedReplenishmentLines = ReplenishmentCandidates.Select(item => item.LineNumber).ToHashSet();
    }

    private void ClearReplenishmentSelection()
    {
        selectedReplenishmentLines.Clear();
    }

    private void SetReplenishmentSelection(int lineNumber, ChangeEventArgs args)
    {
        var selected = args.Value switch
        {
            bool value => value,
            string text when bool.TryParse(text, out var parsed) => parsed,
            _ => false
        };

        if (selected)
        {
            selectedReplenishmentLines.Add(lineNumber);
        }
        else
        {
            selectedReplenishmentLines.Remove(lineNumber);
        }
    }

    private bool IsSelectedForReplenishment(int lineNumber) => selectedReplenishmentLines.Contains(lineNumber);

    private void UseCurrentStockAsMissingMinimums()
    {
        foreach (var item in model.Colors.Where(item => item.MinimumStock <= 0m && item.CurrentStock > 0m))
        {
            item.MinimumStock = Math.Round(item.CurrentStock, 2, MidpointRounding.AwayFromZero);
        }

        SyncReplenishmentSelection();
    }

    private void UseCurrentStockAsMinimum(TejidoColorDetailDto item)
    {
        item.MinimumStock = Math.Round(Math.Max(item.CurrentStock, 0m), 2, MidpointRounding.AwayFromZero);
        SyncReplenishmentSelection();
    }

    private void SyncReplenishmentSelection()
    {
        var candidateLines = ReplenishmentCandidates.Select(item => item.LineNumber).ToHashSet();
        if (candidateLines.Count == 0)
        {
            selectedReplenishmentLines.Clear();
            return;
        }

        selectedReplenishmentLines.RemoveWhere(lineNumber => !candidateLines.Contains(lineNumber));
        if (selectedReplenishmentLines.Count == 0)
        {
            selectedReplenishmentLines = candidateLines;
        }
    }

    private void RecalculateColorPrices()
    {
        var safeMarginFactor = 1m - (model.Margin / 100m);
        if (safeMarginFactor <= 0m)
        {
            safeMarginFactor = 0.01m;
        }

        var safeYield = model.Yield <= 0m ? 1m : model.Yield;

        foreach (var color in model.Colors)
        {
            var productionBase = Math.Round(model.RawCost + Math.Max(color.DyeingPrice, 0m), 2, MidpointRounding.AwayFromZero);
            color.UnitCost = productionBase;
            color.KilogramsPrice = Math.Round(productionBase / safeMarginFactor, 2, MidpointRounding.AwayFromZero);
            color.MetersPrice = Math.Round(color.KilogramsPrice / safeYield, 2, MidpointRounding.AwayFromZero);
        }
    }

    private void ApplySuggestedFinishSummary()
    {
        model.FinishSummary = FinishSummarySuggested;
    }

    private void ApplySuggestedCompositionText()
    {
        model.CompositionText = CompositionTextSuggested;
    }

    private RenderFragment RenderFichaTab() => @<section class="panel" style="margin-top: 1rem;">
        <div class="teixit-layout">
            <div>
                <div class="detail-panel-header">
                    <div>
                        <h2>Teixit</h2>
                        <p class="muted">Ficha principal, stock y carta de colores del tejido.</p>
                    </div>
                </div>
                <div class="form-grid">
                    <label class="field">
                        <span>Codi teixit</span>
                        <InputText class="text-input" @bind-Value="model.Code" disabled="@(!string.IsNullOrWhiteSpace(Code))" />
                    </label>
                    <label class="field wide">
                        <span>Descripció</span>
                        <InputText class="text-input" @bind-Value="model.Description" />
                    </label>
                    <label class="field">
                        <span>Gramatge gr/m2</span>
                        <InputNumber class="text-input" @bind-Value="model.GramWeight" @bind-Value:after="RecalculateColorPrices" />
                    </label>
                    <label class="field">
                        <span>Metre lineal</span>
                        <input class="text-input" value="@LinearMeterWeight.ToString("0.###")" disabled />
                    </label>
                    <label class="field wide">
                        <span>Nro de fil</span>
                        <InputText class="text-input" @bind-Value="model.CompositionText" />
                    </label>
                    <label class="field">
                        <span>NC code</span>
                        <InputText class="text-input" @bind-Value="model.VatCode" />
                    </label>
                    <label class="field wide">
                        <span>Composició resum</span>
                        <InputText class="text-input" @bind-Value="model.FinishSummary" />
                    </label>
                    <label class="field">
                        <span>Ample</span>
                        <InputText class="text-input" @bind-Value="model.WidthText" />
                    </label>
                    <label class="field">
                        <span>Ample nou</span>
                        <InputNumber class="text-input" @bind-Value="model.Width2" @bind-Value:after="RecalculateColorPrices" />
                    </label>
                    <label class="field checkbox-field">
                        <InputCheckbox @bind-Value="model.IsTubular" @bind-Value:after="RecalculateColorPrices" />
                        <span>Tubular</span>
                    </label>
                    <label class="field">
                        <span>Rendiment</span>
                        <InputNumber class="text-input" @bind-Value="model.Yield" @bind-Value:after="RecalculateColorPrices" />
                    </label>
                    <label class="field">
                        <span>% marge</span>
                        <InputNumber class="text-input" @bind-Value="model.Margin" @bind-Value:after="RecalculateColorPrices" />
                    </label>
                    <label class="field">
                        <span>Màquina</span>
                        @if (machineOptions.Count == 0)
                        {
                            <InputNumber class="text-input" @bind-Value="model.MachineCode" />
                        }
                        else
                        {
                            <InputSelect class="text-input" @bind-Value="model.MachineCode">
                                <option value="0">Selecciona máquina</option>
                                @foreach (var machine in machineOptions)
                                {
                                    <option value="@ParseMachineCode(machine.Code)">@FormatMachineOption(machine)</option>
                                }
                            </InputSelect>
                        }
                    </label>
                    <label class="field">
                        <span>Preu metre</span>
                        <InputNumber class="text-input" @bind-Value="model.PricePerMeter" />
                    </label>
                    <label class="field">
                        <span>Preu quilo</span>
                        <InputNumber class="text-input" @bind-Value="model.PricePerKilogram" />
                    </label>
                    <label class="field">
                        <span>Preu model</span>
                        <InputNumber class="text-input" @bind-Value="model.SamplePrice" />
                    </label>
                </div>
            </div>
            <label class="field tejido-notes-area">
                <span>Notes</span>
                <InputTextArea class="text-area" @bind-Value="model.Notes" />
            </label>
        </div>

        <div class="tejido-stock-grid" style="margin-top: 1rem;">
            <article class="info-card stock-card raw">
                <p class="eyebrow">Stock cru</p>
                <h3>@model.RawStockKilograms.ToString("0.###") kg</h3>
                <p class="muted">@model.RawStockMeters.ToString("0.###") metres · valor @RawStockValue.ToString("0.00") €</p>
            </article>
            <article class="info-card stock-card finished">
                <p class="eyebrow">Stock disposat / color</p>
                <h3>@model.AvailableStockKilograms.ToString("0.###") kg</h3>
                <p class="muted">@TotalColorMeters.ToString("0.###") metres · valor @FinishedStockValue.ToString("0.00") €</p>
            </article>
        </div>

        <div class="tejido-color-signal-grid" style="margin-top: 1rem;">
            <article class="info-card stock-signal-card warning">
                <p class="eyebrow">Colores bajo mínimo</p>
                <h3>@ColorsBelowMinimumCount</h3>
                <p class="muted">Necesitan reposición o revisión de stock.</p>
            </article>
            <article class="info-card stock-signal-card danger">
                <p class="eyebrow">Colores sin stock</p>
                <h3>@ColorsWithoutStockCount</h3>
                <p class="muted">No tienen metros disponibles ahora mismo.</p>
            </article>
            <article class="info-card stock-signal-card success">
                <p class="eyebrow">Colores en rango</p>
                <h3>@ColorsHealthyCount</h3>
                <p class="muted">Cumplen mínimo y tienen stock disponible.</p>
            </article>
        </div>

        @RenderColorsSection()
    </section>;

    private RenderFragment RenderEscandalloTab() => @<section class="panel" style="margin-top: 1rem;">
