    private string GetCoverageLabel(decimal currentMeters, decimal minimumMeters)
    {
        if (minimumMeters <= 0m)
        {
            return currentMeters > 0m
                ? L("Sin mínimo · con stock", "Sense mínim · amb estoc", "No minimum · with stock")
                : L("Sin mínimo", "Sense mínim", "No minimum");
        }

        return $"{Math.Round(currentMeters / minimumMeters * 100m, 1, MidpointRounding.AwayFromZero).ToUiString("0.#")}%";
    }

    private static string NormalizeLabelMode(string? mode)
    {
        return mode?.Trim().ToLowerInvariant() switch
