            {
                <div class="inline-action-list">
                    <button class="secondary-button" type="button" @onclick="UseCurrentStockAsMissingMinimums">Fijar mínimos vacíos con stock actual</button>
                    <button class="secondary-button" type="button" @onclick="AddColor">Añadir línea</button>
                </div>
            }
