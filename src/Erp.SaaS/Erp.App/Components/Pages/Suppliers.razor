@page "/crm/proveedores"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IProveedorQueries ProveedorQueries
@inject ILegacySyncService LegacySyncService
@inject AppText T

<PageTitle>@L("CRM / Proveedores", "CRM / Proveïdors", "CRM / Suppliers")</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@T["menu.purchases"]</p>
        <h1>@L("Proveedores", "Proveïdors", "Suppliers")</h1>
        <p class="lead">@(isLegacySyncActive
            ? L("Consulta y edita los proveedores en la SaaS local. La sincronización manual solo refresca los registros que sigan siendo de origen legacy.", "Consulta i edita els proveïdors a la SaaS local. La sincronització manual només refresca els registres que continuïn sent d'origen legacy.", "Browse and edit suppliers in the local SaaS. Manual synchronization only refreshes records that still come from legacy.")
            : L("Consulta y filtra los proveedores del centro legacy asociado a la empresa activa.", "Consulta i filtra els proveïdors del centre legacy associat a l'empresa activa.", "Browse and filter suppliers from the legacy center linked to the active company."))</p>
    </div>
    <div class="quick-links">
        @if (canEdit)
        {
            <a class="primary-button link-button" href="/crm/proveedores/nuevo">@L("Nuevo proveedor", "Nou proveïdor", "New supplier")</a>
        }
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("Selecciona una empresa activa para trabajar con proveedores.", "Selecciona una empresa activa per treballar amb proveïdors.", "Select an active company to work with suppliers.")</p>
    </div>
}
else
{
    <section class="panel">
        <div class="filter-row">
            <input class="text-input" @bind="filter.Search" placeholder="@L("Buscar por nombre, NIF, contacto, ciudad, email o teléfono", "Buscar per nom, NIF, contacte, ciutat, email o telèfon", "Search by name, tax id, contact, city, email or phone")" />
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? L("Cargando...", "Carregant...", "Loading...") : L("Buscar", "Buscar", "Search"))</button>
        </div>
        <div class="filter-row results-toolbar" style="margin-top: 0.85rem;">
            <span class="results-summary">
                @(totalCount == 0
                    ? L("Sin resultados", "Sense resultats", "No results")
                    : L($"Mostrando {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} proveedores", $"Mostrant {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} proveïdors", $"Showing {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} of {totalCount.ToUiString("N0")} suppliers"))
            </span>
            <label class="field compact-field">
                <span>@L("Tamaño de página", "Mida de pàgina", "Page size")</span>
                <select class="sidebar-select compact-select" value="@filter.PageSize" @onchange="OnPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }

    @if (isLegacySyncActive)
    {
        <div class="alert">
            @L("Compras / Proveedores está en convivencia con legacy para esta empresa. La web sigue siendo editable en local y la sync manual solo actualiza los registros que sigan marcados como legacy.", "Compres / Proveïdors està en convivència amb legacy per a aquesta empresa. La web continua sent editable en local i la sync manual només actualitza els registres que continuïn marcats com legacy.", "Purchases / Suppliers is running in legacy coexistence mode for this company. The web app remains editable locally and manual sync only updates records still marked as legacy.")
            @if (!string.IsNullOrWhiteSpace(syncStatusLabel))
            {
                <span>@syncStatusLabel</span>
            }
        </div>
    }

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)" aria-busy="@isLoading">
        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>@L("Cargando proveedores...", "Carregant proveïdors...", "Loading suppliers...")</span>
            </div>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <SortableHeader Label="@L("Código", "Codi", "Code")" IsActive="@(sortColumn == nameof(ProveedorListItemDto.Code))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ProveedorListItemDto.Code), true))" />
                    <SortableHeader Label="@L("Nombre", "Nom", "Name")" IsActive="@(sortColumn == nameof(ProveedorListItemDto.Name))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ProveedorListItemDto.Name)))" />
                    <SortableHeader Label="@L("NIF", "NIF", "Tax ID")" IsActive="@(sortColumn == nameof(ProveedorListItemDto.TaxId))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ProveedorListItemDto.TaxId)))" />
                    <SortableHeader Label="@L("Contacto", "Contacte", "Contact")" IsActive="@(sortColumn == nameof(ProveedorListItemDto.ContactName))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ProveedorListItemDto.ContactName)))" />
                    <SortableHeader Label="@L("Ciudad", "Ciutat", "City")" IsActive="@(sortColumn == nameof(ProveedorListItemDto.City))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ProveedorListItemDto.City)))" />
                    <SortableHeader Label="Email" IsActive="@(sortColumn == nameof(ProveedorListItemDto.Email))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ProveedorListItemDto.Email)))" />
                    <SortableHeader Label="@L("Teléfono", "Telèfon", "Phone")" IsActive="@(sortColumn == nameof(ProveedorListItemDto.Phone))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ProveedorListItemDto.Phone)))" />
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    @for (var index = 0; index < 5; index++)
                    {
                        <tr class="table-skeleton-row">
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                        </tr>
                    }
                }
                else if (items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="table-empty">@L("No hay proveedores para mostrar.", "No hi ha proveïdors per mostrar.", "No suppliers to display.")</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.Code</td>
                            <td>@item.Name</td>
                            <td>@item.TaxId</td>
                            <td>@item.ContactName</td>
                            <td>@item.City</td>
                            <td>@item.Email</td>
                            <td>@item.Phone</td>
                            <td>
                                @if (canEdit)
                                {
                                    <a class="inline-link" href="/crm/proveedores/editar/@item.Code">@L("Abrir", "Obrir", "Open")</a>
                                }
                                else
                                {
                                    <span class="muted">@L("Sin permiso de edición", "Sense permís d'edició", "No edit permission")</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="pagination-bar">
            <span class="muted">@L($"Página {filter.Page} de {TotalPages}", $"Pàgina {filter.Page} de {TotalPages}", $"Page {filter.Page} of {TotalPages}")</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePageAsync(1)" disabled="@(!CanGoPrevious || isLoading)">@L("Primera", "Primera", "First")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page - 1)" disabled="@(!CanGoPrevious || isLoading)">@L("Anterior", "Anterior", "Previous")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page + 1)" disabled="@(!CanGoNext || isLoading)">@L("Siguiente", "Següent", "Next")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(TotalPages)" disabled="@(!CanGoNext || isLoading)">@L("Última", "Última", "Last")</button>
            </div>
        </div>
    </section>
}

@code {
    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isLoading;
    private ProveedorFilter filter = new() { Page = 1, PageSize = 25, SortColumn = nameof(ProveedorListItemDto.Code), SortDescending = true };
    private IReadOnlyCollection<ProveedorListItemDto> items = [];
    private string errorMessage = string.Empty;
    private string sortColumn = nameof(ProveedorListItemDto.Code);
    private bool sortDescending = true;
    private bool isLegacySyncActive;
    private string syncStatusLabel = string.Empty;
    private int totalCount;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)filter.PageSize));
    private bool CanGoPrevious => filter.Page > 1;
    private bool CanGoNext => filter.Page < TotalPages;
    private int PageStart => totalCount == 0 ? 0 : ((filter.Page - 1) * filter.PageSize) + 1;
    private int PageEnd => totalCount == 0 ? 0 : Math.Min(filter.Page * filter.PageSize, totalCount);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsInRole(PlatformRoles.TenantAdmin);

        await LoadSyncStatusAsync();

        await LoadAsync();
    }

    private async Task LoadSyncStatusAsync()
    {
        isLegacySyncActive = false;
        syncStatusLabel = string.Empty;

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var status = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
            .FirstOrDefault(item =>
                item.CompanyId == companyId.Value &&
                string.Equals(item.ModuleKey, LegacySyncModuleKeys.CrmSuppliers, StringComparison.OrdinalIgnoreCase));

        if (status is null || !status.HasSuccessfulSync)
        {
            return;
        }

        isLegacySyncActive = true;
        syncStatusLabel = status.LastCompletedUtc.HasValue
            ? $"{L("Última sync", "Última sync", "Last sync")}: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Act: {status.LastUpdated} · Omi: {status.LastSkipped} · Err: {status.LastErrors}"
            : $"{L("Estado", "Estat", "Status")}: {status.LastStatus}";
    }

    private async Task LoadAsync()
    {
        errorMessage = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            items = [];
            totalCount = 0;
            return;
        }

        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            filter.SortColumn = sortColumn;
            filter.SortDescending = sortDescending;

            var result = await ProveedorQueries.SearchAsync(tenantId.Value, companyId.Value, filter);
            items = result.Items;
            totalCount = result.TotalCount;
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            items = [];
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task SearchAsync()
    {
        filter.Page = 1;
        return LoadAsync();
    }

    private async Task SetSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(sortColumn, column, StringComparison.Ordinal))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = defaultDescending;
        }

        filter.Page = 1;
        await LoadAsync();
    }

    private async Task ChangePageAsync(int page)
    {
        var nextPage = Math.Clamp(page, 1, TotalPages);
        if (nextPage == filter.Page)
        {
            return;
        }

        filter.Page = nextPage;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return;
        }

        filter.PageSize = pageSize;
        filter.Page = 1;
        await LoadAsync();
    }

    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };
}
