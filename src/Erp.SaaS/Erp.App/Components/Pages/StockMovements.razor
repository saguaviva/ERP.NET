@page "/almacen/movimientos"
@page "/almacen/fils/movimientos"
@page "/almacen/tejidos/movimientos"
@page "/almacen/models/movimientos"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IStockQueries StockQueries
@inject AppText T

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@T["menu.warehouse"]</p>
        <h1>@PageHeadingText</h1>
        <p class="lead">@PageLeadText</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="@StockRoute">@StockLinkText</a>
        @if (IsYarnMovementsRoute)
        {
            <a class="secondary-button link-button" href="/articulos/hilos">@L("Ver maestro de hilos", "Veure mestre de fils", "Open yarn master")</a>
            <a class="secondary-button link-button" href="/compras/albaranes-entrega-fils">@L("Ver albaranes de hilo", "Veure albarans de fils", "View yarn receipts")</a>
        }
        else if (IsFabricMovementsRoute)
        {
            <a class="secondary-button link-button" href="/articulos/tejidos">@L("Ver maestro de tejidos", "Veure mestre de teixits", "Open fabrics master")</a>
        }
        else if (IsModelMovementsRoute)
        {
            <a class="secondary-button link-button" href="/articulos/models">@L("Ver maestro de models", "Veure mestre de models", "Open model master")</a>
        }
        <a class="secondary-button link-button" href="/almacen/inventarios">@L("Ver inventarios", "Veure inventaris", "View inventories")</a>
        <a class="secondary-button link-button" href="/almacen/traspasos">@L("Ver traspasos", "Veure traspassos", "View transfers")</a>
        <a class="secondary-button link-button" href="/almacen/ajustes">@L("Nuevo ajuste", "Nou ajust", "New adjustment")</a>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@NoCompanyText</p>
    </div>
}
else
{
    <section class="panel">
        <div class="filter-row">
            <input class="text-input" @bind="filter.Search" placeholder="@L("Buscar por artículo, color, proveedor, referencia, matrícula o documento", "Buscar per article, color, proveïdor, referència, matrícula o document", "Search by item, color, supplier, reference, registration or document")" disabled="@isLoading" />
            <input class="text-input" @bind="filter.Warehouse" placeholder="@L("Almacén", "Magatzem", "Warehouse")" disabled="@isLoading" />
            <input class="text-input" @bind="filter.SupplierName" placeholder="@L("Proveedor", "Proveïdor", "Supplier")" disabled="@isLoading" />
        </div>
        <div class="filter-row" style="margin-top: 0.85rem;">
            <input class="text-input" @bind="filter.Color" placeholder="@L("Color", "Color", "Color")" disabled="@isLoading" />
            <label class="field compact-field" style="min-width: 15rem;">
                <span>@L("Tipo de movimiento", "Tipus de moviment", "Movement type")</span>
                <select class="sidebar-select compact-select" @bind="filter.MovementType" disabled="@isLoading">
                    <option value="">@L("Todos", "Tots", "All")</option>
                    @foreach (var movementTypeOption in MovementTypeOptions)
                    {
                        <option value="@movementTypeOption.Value">@movementTypeOption.Label</option>
                    }
                </select>
            </label>
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? L("Cargando...", "Carregant...", "Loading...") : L("Buscar", "Buscar", "Search"))</button>
        </div>
        <div class="filter-row results-toolbar" style="margin-top: 0.85rem;">
            <span class="results-summary">
                @ResultsSummaryText
            </span>
            <label class="field compact-field">
                <span>@L("Tamaño de página", "Mida de pàgina", "Page size")</span>
                <select class="sidebar-select compact-select" value="@filter.PageSize" @onchange="OnPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
    </section>

    @if (legacySyncInfo.IsActive)
    {
        <section class="panel" style="margin-top: 1rem;">
            <p class="eyebrow">@L("Sync legacy", "Sync legacy", "Legacy sync")</p>
            <p class="muted">
                @LegacyLeadText
                @LegacyDeltaText
                @L("Última sync:", "Última sync:", "Last sync:") @(legacySyncInfo.LastCompletedUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? L("Sin fecha", "Sense data", "No date"))
                · Ins: @legacySyncInfo.LastInserted · Act: @legacySyncInfo.LastUpdated · Omi: @legacySyncInfo.LastSkipped · Err: @legacySyncInfo.LastErrors
            </p>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }

    <div class="card-grid purchase-summary-grid">
        <section class="info-card">
            <h2>@totalCount.ToUiString("N0")</h2>
            <p class="muted">@PrimaryKpiText</p>
        </section>
        <section class="info-card">
            <h2>@items.Select(item => item.SupplierName).Where(value => !string.IsNullOrWhiteSpace(value)).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToUiString("N0")</h2>
            <p class="muted">@SecondaryKpiText</p>
        </section>
        <section class="info-card">
            <h2>@items.Select(item => item.Color).Where(value => !string.IsNullOrWhiteSpace(value)).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToUiString("N0")</h2>
            <p class="muted">@ColorKpiText</p>
        </section>
        <section class="info-card">
            <h2>@items.Select(item => item.MovementType).Where(value => !string.IsNullOrWhiteSpace(value)).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToUiString("N0")</h2>
            <p class="muted">@MovementTypeKpiText</p>
        </section>
        <section class="info-card accent-card">
            <h2>@items.Sum(item => item.Quantity).ToUiString("0.###")</h2>
            <p class="muted">@TertiaryKpiText</p>
        </section>
    </div>

    @if ((IsYarnMovementsRoute || IsFabricMovementsRoute) && (supplierSummaries.Count > 0 || colorSummaries.Count > 0))
    {
        <div class="card-grid purchase-summary-grid">
            <section class="panel">
                <p class="eyebrow">@L("Proveedor", "Proveïdor", "Supplier")</p>
                <h2>@L("Resumen por proveedor", "Resum per proveïdor", "Supplier summary")</h2>
                <p class="muted">@L("Top del filtro actual por número de movimientos y cantidad acumulada.", "Top del filtre actual per nombre de moviments i quantitat acumulada.", "Current filter top list by movement count and accumulated quantity.")</p>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@L("Proveedor", "Proveïdor", "Supplier")</th>
                            <th>@L("Movs.", "Movs.", "Moves")</th>
                            <th>@L("Cantidad", "Quantitat", "Quantity")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (supplierSummaries.Count == 0)
                        {
                            <tr>
                                <td colspan="3" class="table-empty">@L("Sin proveedores para este filtro.", "Sense proveïdors per a aquest filtre.", "No suppliers for this filter.")</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var summary in supplierSummaries)
                            {
                                <tr>
                                    <td>@summary.Label</td>
                                    <td>@summary.MovementCount.ToUiString("N0")</td>
                                    <td>@summary.Quantity.ToUiString("0.###")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </section>

            <section class="panel">
                <p class="eyebrow">@L("Color", "Color", "Color")</p>
                <h2>@L("Resumen por color", "Resum per color", "Color summary")</h2>
                <p class="muted">@L("Top del filtro actual por color para detectar actividad y mezcla operativa.", "Top del filtre actual per color per detectar activitat i barreja operativa.", "Current filter top list by color to detect activity and operational mix.")</p>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@L("Color", "Color", "Color")</th>
                            <th>@L("Movs.", "Movs.", "Moves")</th>
                            <th>@L("Cantidad", "Quantitat", "Quantity")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (colorSummaries.Count == 0)
                        {
                            <tr>
                                <td colspan="3" class="table-empty">@L("Sin colores para este filtro.", "Sense colors per a aquest filtre.", "No colors for this filter.")</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var summary in colorSummaries)
                            {
                                <tr>
                                    <td>@summary.Label</td>
                                    <td>@summary.MovementCount.ToUiString("N0")</td>
                                    <td>@summary.Quantity.ToUiString("0.###")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </section>
        </div>
    }

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)">
        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>@LoadingText</span>
            </div>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <SortableHeader Label="@L("Fecha", "Data", "Date")" IsActive="@(sortColumn == nameof(StockMovementListItemDto.MovementDate))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockMovementListItemDto.MovementDate), true))" />
                    <SortableHeader Label="@L("Tipo", "Tipus", "Type")" IsActive="@(sortColumn == nameof(StockMovementListItemDto.MovementType))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockMovementListItemDto.MovementType)))" />
                    <SortableHeader Label="@L("Almacén", "Magatzem", "Warehouse")" IsActive="@(sortColumn == nameof(StockMovementListItemDto.Warehouse))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockMovementListItemDto.Warehouse)))" />
                    <SortableHeader Label="@L("Artículo", "Article", "Item")" IsActive="@(sortColumn == nameof(StockMovementListItemDto.ItemCode))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockMovementListItemDto.ItemCode)))" />
                    <SortableHeader Label="@L("Descripción", "Descripció", "Description")" IsActive="@(sortColumn == nameof(StockMovementListItemDto.ItemDescription))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockMovementListItemDto.ItemDescription)))" />
                    <SortableHeader Label="@L("Color", "Color", "Color")" IsActive="@(sortColumn == nameof(StockMovementListItemDto.Color))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockMovementListItemDto.Color)))" />
                    <SortableHeader Label="@L("Cantidad", "Quantitat", "Quantity")" IsActive="@(sortColumn == nameof(StockMovementListItemDto.Quantity))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockMovementListItemDto.Quantity), true))" />
                    <SortableHeader Label="@L("Proveedor", "Proveïdor", "Supplier")" IsActive="@(sortColumn == nameof(StockMovementListItemDto.SupplierName))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockMovementListItemDto.SupplierName)))" />
                    <SortableHeader Label="@L("Documento", "Document", "Document")" IsActive="@(sortColumn == nameof(StockMovementListItemDto.SourceDocumentDisplay))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockMovementListItemDto.SourceDocumentDisplay)))" />
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    @for (var index = 0; index < 5; index++)
                    {
                        <tr class="table-skeleton-row">
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                        </tr>
                    }
                }
                else if (items.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="table-empty">@EmptyTableText</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.MovementDate.ToString("dd/MM/yyyy")</td>
                            <td>@FormatMovementType(item.MovementType)</td>
                            <td>@DisplayValue(item.Warehouse)</td>
                            <td>@DisplayValue(item.ItemCode)</td>
                            <td>@item.ItemDescription</td>
                            <td>@DisplayValue(item.Color)</td>
                            <td>@item.Quantity.ToUiString("0.###") @item.UnitOfMeasure</td>
                            <td>@DisplayValue(item.SupplierName)</td>
                            <td>
                                @if (string.Equals(item.SourceDocumentType, "PurchaseReceipt", StringComparison.OrdinalIgnoreCase) && item.SourceDocumentNumber.HasValue)
                                {
                                    <a class="inline-link" href="@(IsYarnMovementsRoute ? $"/compras/albaranes-entrega-fils/{item.SourceDocumentNumber.Value}" : $"/compras/recepciones/{item.SourceDocumentNumber.Value}")">@item.SourceDocumentDisplay</a>
                                }
                                else if ((string.Equals(item.SourceDocumentType, "StockTransferOutbound", StringComparison.OrdinalIgnoreCase) ||
                                          string.Equals(item.SourceDocumentType, "StockTransferInbound", StringComparison.OrdinalIgnoreCase)) && item.SourceDocumentNumber.HasValue)
                                {
                                    <a class="inline-link" href="/almacen/traspasos/editar/@item.SourceDocumentNumber.Value">@item.SourceDocumentDisplay</a>
                                }
                                else if (string.Equals(item.SourceDocumentType, "StockCount", StringComparison.OrdinalIgnoreCase) && item.SourceDocumentNumber.HasValue)
                                {
                                    <a class="inline-link" href="/almacen/inventarios/editar/@item.SourceDocumentNumber.Value">@item.SourceDocumentDisplay</a>
                                }
                                else
                                {
                                    @item.SourceDocumentDisplay
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="pagination-bar">
            <span class="muted">@L($"Página {filter.Page} de {TotalPages}", $"Pàgina {filter.Page} de {TotalPages}", $"Page {filter.Page} of {TotalPages}")</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePageAsync(1)" disabled="@(!CanGoPrevious || isLoading)">@L("Primera", "Primera", "First")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page - 1)" disabled="@(!CanGoPrevious || isLoading)">@L("Anterior", "Anterior", "Previous")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page + 1)" disabled="@(!CanGoNext || isLoading)">@L("Siguiente", "Següent", "Next")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(TotalPages)" disabled="@(!CanGoNext || isLoading)">@L("Última", "Última", "Last")</button>
            </div>
        </div>
    </section>
}

@code {
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "warehouse")]
    public string? Warehouse { get; set; }

    [SupplyParameterFromQuery(Name = "supplier")]
    public string? SupplierQuery { get; set; }

    [SupplyParameterFromQuery(Name = "color")]
    public string? ColorQuery { get; set; }

    [SupplyParameterFromQuery(Name = "movementType")]
    public string? MovementTypeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? PageSizeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortQuery { get; set; }

    [SupplyParameterFromQuery(Name = "desc")]
    public bool? DescQuery { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool isLoading;
    private StockMovementFilter filter = new() { Page = 1, PageSize = 25, SortColumn = nameof(StockMovementListItemDto.MovementDate), SortDescending = true };
    private IReadOnlyCollection<StockMovementListItemDto> items = [];
    private IReadOnlyCollection<StockMovementGroupSummaryDto> supplierSummaries = [];
    private IReadOnlyCollection<StockMovementGroupSummaryDto> colorSummaries = [];
    private StockLegacySyncInfoDto legacySyncInfo = new();
    private string errorMessage = string.Empty;
    private string sortColumn = nameof(StockMovementListItemDto.MovementDate);
    private bool sortDescending = true;
    private int totalCount;
    private IReadOnlyList<MovementTypeOption> MovementTypeOptions =>
        movementTypeValues.Select(value => new MovementTypeOption(value, FormatMovementType(value))).ToArray();
    private bool IsYarnMovementsRoute => CurrentRelativePath.StartsWith("almacen/fils/movimientos", StringComparison.OrdinalIgnoreCase);
    private bool IsFabricMovementsRoute => CurrentRelativePath.StartsWith("almacen/tejidos/movimientos", StringComparison.OrdinalIgnoreCase);
    private bool IsModelMovementsRoute => CurrentRelativePath.StartsWith("almacen/models/movimientos", StringComparison.OrdinalIgnoreCase);
    private string CurrentRelativePath => NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0];
    private string PageTitleText => IsYarnMovementsRoute
        ? L("Almacén / Movimientos Fils", "Magatzem / Moviments Fils", "Warehouse / Yarn movements")
        : IsFabricMovementsRoute
            ? L("Almacén / Movimientos Teixits", "Magatzem / Moviments Teixits", "Warehouse / Fabric movements")
        : IsModelMovementsRoute
            ? L("Almacén / Movimientos Models", "Magatzem / Moviments Models", "Warehouse / Model movements")
            : L("Almacén / Movimientos", "Magatzem / Moviments", "Warehouse / Movements");
    private string PageHeadingText => IsYarnMovementsRoute
        ? L("Movimientos Fils", "Moviments Fils", "Yarn movements")
        : IsFabricMovementsRoute
            ? L("Movimientos Teixits", "Moviments Teixits", "Fabric movements")
        : IsModelMovementsRoute
            ? L("Movimientos Models", "Moviments Models", "Model movements")
            : L("Movimientos", "Moviments", "Movements");
    private string PageLeadText => IsYarnMovementsRoute
        ? L("Entradas y ajustes locales ligados al maestro fil y al circuito específico de hilos.", "Entrades i ajustos locals lligats al mestre fil i al circuit específic de fils.", "Inbound and local adjustments tied to the fil master and the yarn-specific workflow.")
        : IsFabricMovementsRoute
            ? L("Entradas, consumos y ajustes locales ligados al maestro teixits y al circuito específico de tejidos.", "Entrades, consums i ajustos locals lligats al mestre teixits i al circuit específic de teixits.", "Inbound, consumption and local adjustments tied to the teixits master and the fabric-specific workflow.")
        : IsModelMovementsRoute
            ? L("Entradas y ajustes locales ligados al catálogo de models.", "Entrades i ajustos locals lligats al catàleg de models.", "Inbound and local adjustments tied to the models catalogue.")
            : L("Entradas de stock generadas desde recepciones y futuros movimientos de almacén.", "Entrades d'estoc generades des de recepcions i futurs moviments de magatzem.", "Stock entries generated from receipts and future warehouse movements.");
    private string StockRoute => IsYarnMovementsRoute
        ? "/almacen/fils"
        : IsFabricMovementsRoute
            ? "/almacen/tejidos"
        : IsModelMovementsRoute
            ? "/almacen/models"
            : "/almacen/stock-actual";
    private string StockLinkText => IsYarnMovementsRoute
        ? L("Ver stock de hilos", "Veure estoc de fils", "View yarn stock")
        : IsFabricMovementsRoute
            ? L("Ver stock de tejidos", "Veure estoc de teixits", "View fabric stock")
        : IsModelMovementsRoute
            ? L("Ver stock models", "Veure estoc models", "View model stock")
            : L("Ver stock actual", "Veure estoc actual", "View current stock");
    private string NoCompanyText => IsYarnMovementsRoute
        ? L("Selecciona una empresa activa para revisar movimientos de hilos.", "Selecciona una empresa activa per revisar moviments de fils.", "Select an active company to review yarn movements.")
        : IsFabricMovementsRoute
            ? L("Selecciona una empresa activa para revisar movimientos de tejidos.", "Selecciona una empresa activa per revisar moviments de teixits.", "Select an active company to review fabric movements.")
        : IsModelMovementsRoute
            ? L("Selecciona una empresa activa para revisar movimientos de models.", "Selecciona una empresa activa per revisar moviments de models.", "Select an active company to review model movements.")
            : L("Selecciona una empresa activa para revisar movimientos de almacén.", "Selecciona una empresa activa per revisar moviments de magatzem.", "Select an active company to review warehouse movements.");
    private string ResultsSummaryText => totalCount == 0
        ? L("Sin resultados", "Sense resultats", "No results")
        : IsYarnMovementsRoute
            ? L($"Mostrando {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} movimientos de hilos", $"Mostrant {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} moviments de fils", $"Showing {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} of {totalCount.ToUiString("N0")} yarn movements")
            : IsFabricMovementsRoute
                ? L($"Mostrando {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} movimientos de tejidos", $"Mostrant {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} moviments de teixits", $"Showing {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} of {totalCount.ToUiString("N0")} fabric movements")
            : IsModelMovementsRoute
                ? L($"Mostrando {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} movimientos models", $"Mostrant {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} moviments models", $"Showing {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} of {totalCount.ToUiString("N0")} model movements")
                : L($"Mostrando {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} movimientos", $"Mostrant {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} moviments", $"Showing {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} of {totalCount.ToUiString("N0")} movements");
    private string LegacyLeadText => IsYarnMovementsRoute
        ? L("El saldo de fils manda desde TEX.NET y se replica en la SaaS local filtrado por el maestro fil. ", "El saldo de fils mana des de TEX.NET i es replica a la SaaS local filtrat pel mestre fil. ", "Yarn stock is driven from TEX.NET and replicated into the local SaaS filtered by the fil master. ")
        : IsFabricMovementsRoute
            ? L("El saldo de teixits manda desde TEX.NET y se replica en la SaaS local filtrado por el maestro teixits. ", "El saldo de teixits mana des de TEX.NET i es replica a la SaaS local filtrat pel mestre teixits. ", "Fabric stock is driven from TEX.NET and replicated into the local SaaS filtered by the teixits master. ")
        : IsModelMovementsRoute
            ? L("El saldo de models manda desde TEX.NET y se replica en la SaaS local filtrado por article_models. ", "El saldo de models mana des de TEX.NET i es replica a la SaaS local filtrat per article_models. ", "Model stock is driven from TEX.NET and replicated into the local SaaS filtered by article_models. ")
            : L("El saldo actual manda desde TEX.NET y se replica en la SaaS local. ", "El saldo actual mana des de TEX.NET i es replica a la SaaS local. ", "Current stock is driven from TEX.NET and replicated into the local SaaS. ");
    private string LegacyDeltaText => IsYarnMovementsRoute
        ? L("Esta pantalla muestra solo los movimientos web de hilos registrados en local; sirven como delta sobre el snapshot legacy y no tocan el remoto. ", "Aquesta pantalla mostra només els moviments web de fils registrats en local; serveixen com a delta sobre l'snapshot legacy i no toquen el remot. ", "This screen shows only locally stored web yarn movements; they work as a delta over the legacy snapshot and never touch the remote source. ")
