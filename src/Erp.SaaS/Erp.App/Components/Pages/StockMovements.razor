    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        ApplyQueryState();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        errorMessage = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            items = [];
            totalCount = 0;
            return;
        }

        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            legacySyncInfo = await StockQueries.GetLegacySyncInfoAsync(tenantId.Value, companyId.Value);
            filter.SortColumn = sortColumn;
            filter.SortDescending = sortDescending;
            var result = await StockQueries.SearchMovementsAsync(tenantId.Value, companyId.Value, filter);
            items = result.Items;
            supplierSummaries = result.SupplierSummaries;
            colorSummaries = result.ColorSummaries;
            totalCount = result.TotalCount;
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            items = [];
            supplierSummaries = [];
            colorSummaries = [];
            legacySyncInfo = new StockLegacySyncInfoDto();
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        filter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task SetSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(sortColumn, column, StringComparison.Ordinal))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = defaultDescending;
        }

        filter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task ChangePageAsync(int page)
    {
        var newPage = Math.Max(1, Math.Min(page, TotalPages));
        if (newPage == filter.Page)
        {
            return;
        }

        filter.Page = newPage;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return;
        }

        filter.PageSize = pageSize;
        filter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private void ApplyQueryState()
    {
        filter.Search = Search?.Trim() ?? string.Empty;
        filter.Warehouse = Warehouse?.Trim() ?? string.Empty;
        filter.SupplierName = SupplierQuery?.Trim() ?? string.Empty;
        filter.Color = ColorQuery?.Trim() ?? string.Empty;
        filter.MovementType = NormalizeMovementType(MovementTypeQuery);
        filter.CatalogScope = IsYarnMovementsRoute
            ? "Hilos"
            : IsFabricMovementsRoute
                ? "Tejidos"
            : IsModelMovementsRoute
                ? "Models"
                : string.Empty;
        filter.Page = Math.Max(PageQuery.GetValueOrDefault(1), 1);
        filter.PageSize = PageSizeQuery is 25 or 50 or 100 ? PageSizeQuery.Value : 25;
        sortColumn = NormalizeSortColumn(SortQuery);
        sortDescending = DescQuery ?? true;
        filter.SortColumn = sortColumn;
        filter.SortDescending = sortDescending;
    }

    private void UpdateQueryState()
    {
        var uri = NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["search"] = string.IsNullOrWhiteSpace(filter.Search) ? null : filter.Search,
            ["warehouse"] = string.IsNullOrWhiteSpace(filter.Warehouse) ? null : filter.Warehouse,
            ["supplier"] = string.IsNullOrWhiteSpace(filter.SupplierName) ? null : filter.SupplierName,
            ["color"] = string.IsNullOrWhiteSpace(filter.Color) ? null : filter.Color,
            ["movementType"] = string.IsNullOrWhiteSpace(filter.MovementType) ? null : filter.MovementType,
            ["page"] = filter.Page > 1 ? filter.Page : null,
            ["pageSize"] = filter.PageSize != 25 ? filter.PageSize : null,
            ["sort"] = string.Equals(sortColumn, nameof(StockMovementListItemDto.MovementDate), StringComparison.Ordinal) ? null : sortColumn,
            ["desc"] = sortDescending ? null : false
        });

        NavigationManager.NavigateTo(uri, replace: true);
    }

    private static string NormalizeSortColumn(string? sortColumn) => sortColumn switch
    {
        nameof(StockMovementListItemDto.MovementDate) => nameof(StockMovementListItemDto.MovementDate),
        nameof(StockMovementListItemDto.MovementType) => nameof(StockMovementListItemDto.MovementType),
        nameof(StockMovementListItemDto.Warehouse) => nameof(StockMovementListItemDto.Warehouse),
        nameof(StockMovementListItemDto.ItemCode) => nameof(StockMovementListItemDto.ItemCode),
        nameof(StockMovementListItemDto.ItemDescription) => nameof(StockMovementListItemDto.ItemDescription),
        nameof(StockMovementListItemDto.Color) => nameof(StockMovementListItemDto.Color),
        nameof(StockMovementListItemDto.Quantity) => nameof(StockMovementListItemDto.Quantity),
        nameof(StockMovementListItemDto.SupplierName) => nameof(StockMovementListItemDto.SupplierName),
        nameof(StockMovementListItemDto.SourceDocumentDisplay) => nameof(StockMovementListItemDto.SourceDocumentDisplay),
        _ => nameof(StockMovementListItemDto.MovementDate)
    };

    private string NormalizeMovementType(string? movementType) =>
        movementTypeValues.Any(value => string.Equals(value, movementType?.Trim(), StringComparison.Ordinal))
            ? movementType!.Trim()
            : string.Empty;

