@page "/almacen/ajustes"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStockService StockService
@inject IStockQueries StockQueries
@inject NavigationManager NavigationManager

<PageTitle>Almacén / Ajuste manual</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Almacén</p>
        <h1>Ajuste manual</h1>
        <p class="lead">Primera salida real de stock y correcciones manuales sobre la empresa activa.</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="/almacen/stock-actual">Volver a stock</a>
        <a class="secondary-button link-button" href="/almacen/movimientos">Ver movimientos</a>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>No hay empresa activa seleccionada.</p>
    </div>
}
else if (!canEdit)
{
    <div class="empty-state">
        <p>@blockedReason</p>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
    }

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <section class="panel">
            <div class="form-grid">
                <label class="field">
                    <span>Tipo de ajuste</span>
                    <InputSelect class="text-input" @bind-Value="model.AdjustmentType">
                        <option value="@StockMovementTypes.InboundManualAdjustment">Entrada manual</option>
                        <option value="@StockMovementTypes.OutboundManualAdjustment">Salida manual</option>
                    </InputSelect>
                </label>
                <label class="field">
                    <span>Fecha</span>
                    <InputDate class="text-input" @bind-Value="model.MovementDate" />
                </label>
                <label class="field">
                    <span>Almacén</span>
                    <InputText class="text-input" @bind-Value="model.Warehouse" />
                </label>
                <label class="field">
                    <span>Código artículo</span>
                    <InputText class="text-input" @bind-Value="model.ItemCode" />
                </label>
                <label class="field wide">
                    <span>Descripción artículo</span>
                    <InputText class="text-input" @bind-Value="model.ItemDescription" />
                </label>
                <label class="field">
                    <span>Unidad</span>
                    <InputText class="text-input" @bind-Value="model.UnitOfMeasure" />
                </label>
                <label class="field">
                    <span>Cantidad</span>
                    <InputNumber class="text-input" @bind-Value="model.Quantity" />
                </label>
                <label class="field wide">
                    <span>Notas</span>
                    <InputTextArea class="text-area" @bind-Value="model.Notes" />
                </label>
            </div>

            <div class="quick-links">
                <button class="primary-button" type="submit">Registrar ajuste</button>
            </div>
        </section>
    </EditForm>
}

@code {
    [SupplyParameterFromQuery]
    public string? Warehouse { get; set; }

    [SupplyParameterFromQuery]
    public string? ItemCode { get; set; }

    [SupplyParameterFromQuery]
    public string? Description { get; set; }

    [SupplyParameterFromQuery]
    public string? Unit { get; set; }

    [SupplyParameterFromQuery]
    public decimal? CurrentStock { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private string blockedReason = "No tienes permisos para registrar ajustes de almacén.";
    private string statusMessage = string.Empty;
    private bool isError;
    private StockAdjustmentFormModel model = new();

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);
        blockedReason = "No tienes permisos para registrar ajustes de almacén.";

        if (tenantId.HasValue && companyId.HasValue)
        {
            var legacySyncInfo = await StockQueries.GetLegacySyncInfoAsync(tenantId.Value, companyId.Value);
            if (legacySyncInfo.IsActive)
            {
                canEdit = false;
                blockedReason = "Almacén / Stock está en convivencia con legacy para esta empresa. Mientras la sync mande, los ajustes manuales quedan en solo lectura.";
            }
        }

        model.Warehouse = Warehouse?.Trim() ?? model.Warehouse;
        model.ItemCode = ItemCode?.Trim() ?? model.ItemCode;
        model.ItemDescription = Description?.Trim() ?? model.ItemDescription;
        model.UnitOfMeasure = Unit?.Trim() ?? model.UnitOfMeasure;
        model.Notes = CurrentStock.HasValue && string.IsNullOrWhiteSpace(model.Notes)
            ? $"Stock actual previo: {CurrentStock.Value:0.###}"
            : model.Notes;
    }

    private async Task SaveAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !canEdit)
        {
            return;
        }

        try
        {
            statusMessage = string.Empty;
            isError = false;

            await StockService.CreateAdjustmentAsync(new CreateStockAdjustmentCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                Warehouse = model.Warehouse,
                ItemCode = model.ItemCode,
                ItemDescription = model.ItemDescription,
                UnitOfMeasure = model.UnitOfMeasure,
                AdjustmentType = model.AdjustmentType,
                Quantity = model.Quantity,
                MovementDate = model.MovementDate,
                Notes = model.Notes
            });

            statusMessage = "Ajuste registrado correctamente.";
            NavigationManager.NavigateTo("/almacen/movimientos", forceLoad: false);
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private sealed class StockAdjustmentFormModel
    {
        public string Warehouse { get; set; } = string.Empty;
        public string ItemCode { get; set; } = string.Empty;
        public string ItemDescription { get; set; } = string.Empty;
        public string UnitOfMeasure { get; set; } = string.Empty;
        public string AdjustmentType { get; set; } = StockMovementTypes.InboundManualAdjustment;
        public decimal Quantity { get; set; }
        public DateTime MovementDate { get; set; } = DateTime.Today;
        public string Notes { get; set; } = string.Empty;
    }
}
