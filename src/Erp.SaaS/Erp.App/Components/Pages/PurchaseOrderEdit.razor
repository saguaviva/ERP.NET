@page "/compras/pedidos/nuevo"
@page "/compras/pedidos/editar/{OrderNumber:int}"
@page "/compras/comandes-fils/nuevo"
@page "/compras/comandes-fils/editar/{OrderNumber:int}"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AppText T
@inject IAuditLogService AuditLogService
@inject ILegacySyncService LegacySyncService
@inject IProveedorQueries ProveedorQueries
@inject IPurchaseOrderQueries PurchaseOrderQueries
@inject IPurchaseOrderService PurchaseOrderService
@inject NavigationManager NavigationManager

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("Compras", "Compres", "Purchases")</p>
        <h1>@PageHeading</h1>
        <p class="lead">@PageLead</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="@ListHref">@BackToListLabel</a>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p>
    </div>
}
else if (!canEdit && !OrderNumber.HasValue)
{
    <div class="empty-state">
        <p>@L("No tienes permisos para crear pedidos de compra.", "No tens permisos per crear comandes de compra.", "You do not have permission to create purchase orders.")</p>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
    }

    @if (isLegacySyncActive)
    {
        <div class="alert">
            @(IsYarnOrdersRoute
                ? L("Compras / Comandes Fils está en convivencia con legacy para esta empresa. La sync manual refresca solo pedidos de hilo con origen legacy y artículo presente en el maestro fil; los cambios que guardes desde la web convertirán este pedido a local y ya no se sobrescribirá.",
                    "Compres / Comandes Fils està en convivència amb legacy per a aquesta empresa. La sync manual refresca només comandes de fils amb origen legacy i article present al mestre fil; els canvis que guardis des del web convertiran aquesta comanda a local i ja no se sobreescriurà.",
                    "Purchases / Yarn orders coexists with legacy for this company. Manual sync refreshes only legacy-origin yarn orders whose item exists in the fil master; changes you save from the web will convert this order to local and it will no longer be overwritten.")
                : L("Compras / Pedidos está en convivencia con legacy para esta empresa. La sync manual refresca solo los pedidos con origen legacy; los cambios que guardes desde la web convertirán este pedido a local y ya no se sobrescribirá.",
                    "Compres / Comandes està en convivència amb legacy per a aquesta empresa. La sync manual refresca només les comandes amb origen legacy; els canvis que guardis des del web convertiran aquesta comanda a local i ja no se sobreescriurà.",
                    "Purchases / Orders coexists with legacy for this company. Manual sync refreshes only legacy-origin orders; changes you save from the web will convert this order to local and it will no longer be overwritten."))
            @if (!string.IsNullOrWhiteSpace(syncStatusLabel))
            {
                <span>@syncStatusLabel</span>
            }
        </div>
    }

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <div class="form-grid">
            <label class="field">
                <span>@L("Proveedor", "Proveïdor", "Supplier")</span>
                <InputSelect class="text-input" @bind-Value="model.SupplierCode" disabled="@(!canEdit)">
                    <option value="0">@L("Selecciona proveedor", "Selecciona proveïdor", "Select supplier")</option>
                    @foreach (var supplier in suppliers)
                    {
                        <option value="@supplier.Code">@supplier.Name (@supplier.Code)</option>
                    }
                </InputSelect>
                @if (SelectedSupplier is not null)
                {
                    <span class="field-hint">@SelectedSupplier.TaxId · @SelectedSupplier.ContactName</span>
                }
            </label>
            <label class="field">
                <span>@L("Fecha documento", "Data document", "Document date")</span>
                <InputDate class="text-input" @bind-Value="model.DocumentDate" disabled="@(!canEdit)" />
            </label>
            <label class="field">
                <span>@L("Fecha prevista", "Data prevista", "Expected date")</span>
                <InputDate class="text-input" @bind-Value="model.ExpectedDate" disabled="@(!canEdit)" />
            </label>
            <label class="field">
                <span>@L("Estado", "Estat", "Status")</span>
                <InputSelect class="text-input" @bind-Value="model.Status" disabled="@(!canEdit || HasAnyReceipt)">
                    @foreach (var status in PurchaseOrderStatuses.All)
                    {
                        <option value="@status">@FormatStatus(status)</option>
                    }
                </InputSelect>
                @if (HasAnyReceipt)
                {
                    <span class="field-hint">@L("El estado pasa a depender de las cantidades recibidas.", "L'estat passa a dependre de les quantitats rebudes.", "Status now depends on received quantities.")</span>
                }
            </label>
            <label class="field wide">
                <span>@L("Notas", "Notes", "Notes")</span>
                <InputTextArea class="text-area" @bind-Value="model.Notes" disabled="@(!canEdit)" />
            </label>
        </div>

        <section class="panel">
            <div class="page-header">
                <div>
                    <h2>@L("Líneas", "Línies", "Lines")</h2>
                    <p class="muted">@L("Añade conceptos, cantidades, precios y fechas previstas por línea.", "Afegeix conceptes, quantitats, preus i dates previstes per línia.", "Add concepts, quantities, prices, and expected dates per line.")</p>
                </div>
                @if (canEdit)
                {
                    <button class="secondary-button" type="button" @onclick="AddLine">@L("Añadir línea", "Afegir línia", "Add line")</button>
                }
            </div>

            <div class="stack">
                @for (var index = 0; index < model.Lines.Count; index++)
                {
                    var line = model.Lines[index];
                    <section class="panel line-editor">
                        <div class="panel-header">
                            <strong>@L($"Línea {line.LineNumber}", $"Línia {line.LineNumber}", $"Line {line.LineNumber}")</strong>
                            @if (canEdit && model.Lines.Count > 1)
                            {
                                <button class="secondary-button" type="button" @onclick="() => RemoveLine(index)">@L("Quitar", "Treure", "Remove")</button>
                            }
                        </div>
                        <div class="form-grid">
                            <label class="field">
                                <span>@L("Artículo", "Article", "Item")</span>
                                <InputText class="text-input" @bind-Value="line.ItemCode" disabled="@(!canEdit)" />
                            </label>
                            <label class="field wide">
                                <span>@L("Descripción", "Descripció", "Description")</span>
                                <InputText class="text-input" @bind-Value="line.Description" disabled="@(!canEdit)" />
                            </label>
                            <label class="field">
                                <span>@L("Cantidad", "Quantitat", "Quantity")</span>
                                <InputNumber class="text-input" @bind-Value="line.Quantity" disabled="@(!canEdit)" />
                            </label>
                            <label class="field">
                                <span>@L("Unidad", "Unitat", "Unit")</span>
                                <InputText class="text-input" @bind-Value="line.UnitOfMeasure" disabled="@(!canEdit)" />
                            </label>
                            <label class="field">
                                <span>@L("Precio unitario", "Preu unitari", "Unit price")</span>
                                <InputNumber class="text-input" @bind-Value="line.UnitPrice" disabled="@(!canEdit)" />
                            </label>
                            <label class="field">
                                <span>@L("Prevista", "Prevista", "Expected")</span>
                                <InputDate class="text-input" @bind-Value="line.ExpectedDate" disabled="@(!canEdit)" />
                            </label>
                            <label class="field wide">
                                <span>@L("Notas línea", "Notes línia", "Line notes")</span>
                                <InputTextArea class="text-area" @bind-Value="line.Notes" disabled="@(!canEdit)" />
                            </label>
                        </div>
                        <div class="stack">
                            <div class="muted">@L("Total línea:", "Total línia:", "Line total:") @LineTotal(line).ToUiString("0.00") €</div>
                            <div class="muted">@L("Recibido:", "Rebut:", "Received:") @line.ReceivedQuantity.ToUiString("0.###") · @L("Pendiente:", "Pendent:", "Pending:") @line.PendingQuantity.ToUiString("0.###")</div>
                        </div>
                    </section>
                }
            </div>
        </section>

        <section class="panel">
            <h2>@L("Resumen", "Resum", "Summary")</h2>
            <div class="card-grid purchase-summary-grid purchase-metrics-grid">
                <article class="info-card">
                    <h2>@model.Lines.Count</h2>
                    <p class="muted">@L("líneas", "línies", "lines")</p>
                </article>
                <article class="info-card">
                    <h2>@TotalQuantity.ToUiString("0.###")</h2>
                    <p class="muted">@L("cantidad total", "quantitat total", "total quantity")</p>
                </article>
                <article class="info-card">
                    <h2>@TotalReceivedQuantity.ToUiString("0.###")</h2>
                    <p class="muted">@L("recibido", "rebut", "received")</p>
                </article>
                <article class="info-card">
                    <h2>@TotalPendingQuantity.ToUiString("0.###")</h2>
                    <p class="muted">@L("pendiente", "pendent", "pending")</p>
                </article>
                <article class="info-card accent-card">
                    <h2>@TotalAmount.ToUiString("0.00") €</h2>
                    <p class="muted">@L("importe total", "import total", "total amount")</p>
                </article>
            </div>
        </section>

        @if (canEdit)
        {
            <div class="quick-links" style="margin-top: 1rem;">
                <button class="primary-button" type="submit">@L("Guardar pedido", "Guardar comanda", "Save order")</button>
            </div>
        }
    </EditForm>

    @if (OrderNumber.HasValue)
    {
        @if (canEdit && model.Lines.Any(line => line.PendingQuantity > 0) && !string.Equals(model.Status, PurchaseOrderStatuses.Cancelled, StringComparison.OrdinalIgnoreCase))
        {
            <section class="panel" style="margin-top: 1rem;">
                <h2>@(IsYarnOrdersRoute
                    ? L("Entrada de hilo", "Entrada de fils", "Yarn receipt")
                    : L("Recepción de mercancía", "Recepció de mercaderia", "Goods receipt"))</h2>
                <p class="muted">@(IsYarnOrdersRoute
                    ? L("Marca solo las cantidades de hilo que entran ahora. El estado del pedido se actualizará automáticamente.", "Marca només les quantitats de fils que entren ara. L'estat de la comanda s'actualitzarà automàticament.", "Mark only the yarn quantities received now. The order status will update automatically.")
                    : L("Marca solo las cantidades que entran ahora. El estado del pedido se actualizará automáticamente.", "Marca només les quantitats que entren ara. L'estat de la comanda s'actualitzarà automàticament.", "Mark only the quantities received now. The order status will update automatically."))</p>

                <div class="stack">
                    <div class="form-grid">
                        <label class="field">
                            <span>@L("Fecha de recepción", "Data de recepció", "Receipt date")</span>
                            <InputDate class="text-input" @bind-Value="receiptForm.ReceiptDate" />
                        </label>
                        <label class="field">
                            <span>@L("Almacén", "Magatzem", "Warehouse")</span>
                            <InputText class="text-input" @bind-Value="receiptForm.Warehouse" />
                        </label>
                        <label class="field">
                            <span>@L("Transportista", "Transportista", "Carrier")</span>
                            <InputText class="text-input" @bind-Value="receiptForm.Carrier" />
                        </label>
                        <label class="field">
                            <span>@L("Referencia proveedor", "Referència proveïdor", "Supplier reference")</span>
                            <InputText class="text-input" @bind-Value="receiptForm.SupplierReference" />
                        </label>
                        <label class="field">
                            <span>@L("Matrícula", "Matrícula", "Vehicle plate")</span>
                            <InputText class="text-input" @bind-Value="receiptForm.VehiclePlate" />
                        </label>
                        <label class="field">
                            <span>@L("Bultos", "Paquets", "Packages")</span>
                            <InputNumber class="text-input" @bind-Value="receiptForm.PackageCount" />
                        </label>
                        <label class="field">
                            <span>@L("Peso bruto (kg)", "Pes brut (kg)", "Gross weight (kg)")</span>
                            <InputNumber class="text-input" @bind-Value="receiptForm.GrossWeightKg" />
                        </label>
                        <label class="field wide">
                            <span>@L("Notas de recepción", "Notes de recepció", "Receipt notes")</span>
                            <InputTextArea class="text-area" @bind-Value="receiptForm.Notes" />
                        </label>
                    </div>
                </div>

                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@L("Línea", "Línia", "Line")</th>
                            <th>@L("Descripción", "Descripció", "Description")</th>
                            <th>@L("Pedida", "Demanada", "Ordered")</th>
                            <th>@L("Recibida", "Rebuda", "Received")</th>
                            <th>@L("Pendiente", "Pendent", "Pending")</th>
                            <th>@L("Recibir ahora", "Rebre ara", "Receive now")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in model.Lines)
                        {
                            <tr>
                                <td>@line.LineNumber</td>
                                <td>@line.Description</td>
                                <td>@line.Quantity.ToUiString("0.###")</td>
                                <td>@line.ReceivedQuantity.ToUiString("0.###")</td>
                                <td>@line.PendingQuantity.ToUiString("0.###")</td>
                                <td>
                                    <InputNumber class="text-input receipt-qty-input" @bind-Value="line.ReceiveNowQuantity" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="quick-links" style="margin-top: 1rem;">
                    <button class="primary-button" type="button" @onclick="RegisterReceiptAsync">@(IsYarnOrdersRoute
                        ? L("Registrar entrada de hilo", "Registrar entrada de fils", "Register yarn receipt")
                        : L("Registrar recepción", "Registrar recepció", "Register receipt"))</button>
                </div>
            </section>
        }

        <section class="panel" style="margin-top: 1rem;">
            <h2>@(IsYarnOrdersRoute
                ? L("Albaranes entrega de hilo", "Albarans entrega de fils", "Yarn delivery receipts")
                : L("Recepciones registradas", "Recepcions registrades", "Registered receipts"))</h2>
            <div class="list-block">
                @if (receipts.Count == 0)
                {
                    <p class="muted">@(IsYarnOrdersRoute
                        ? L("Todavía no hay albaranes entrega de hilo registrados para este pedido.", "Encara no hi ha albarans entrega de fils registrats per a aquesta comanda.", "There are no registered yarn delivery receipts for this order yet.")
                        : L("Todavía no hay recepciones registradas para este pedido.", "Encara no hi ha recepcions registrades per a aquesta comanda.", "There are no registered receipts for this order yet."))</p>
                }
                else
                {
                    @foreach (var receipt in receipts)
                    {
                        <article class="list-item">
                            <strong>
                                <a class="inline-link" href="@BuildReceiptDetailHref(receipt.ReceiptNumber)">@receipt.DisplayNumber</a>
                                · @receipt.ReceiptDate.ToString("dd/MM/yyyy")
                                · @receipt.TotalReceivedQuantity.ToUiString("0.###") @L("uds", "uds", "units")
                            </strong>
                            @if (!string.IsNullOrWhiteSpace(receipt.Notes))
                            {
                                <span>@receipt.Notes</span>
                            }
                                        <span>@string.Join(" · ", receipt.Lines.Select(line => $"L{line.LineNumber.ToUiString("N0")}: +{line.ReceivedQuantity.ToUiString("0.###")}"))</span>
                        </article>
                    }
                }
            </div>
        </section>

        <section class="panel" style="margin-top: 1rem;">
            <h2>@L("Historial reciente del pedido", "Historial recent de la comanda", "Recent order history")</h2>
            <div class="list-block">
                @if (recentAuditLogs.Count == 0)
                {
                    <p class="muted">@L("Todavía no hay eventos auditados para este pedido.", "Encara no hi ha esdeveniments auditats per a aquesta comanda.", "There are no audited events for this order yet.")</p>
                }
                else
                {
                    @foreach (var entry in recentAuditLogs)
                    {
                        <article class="list-item">
                            <strong>@entry.Action</strong>
                            @if (!string.IsNullOrWhiteSpace(entry.Details))
                            {
                                <span>@entry.Details</span>
                            }
                            <span>@entry.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </article>
                    }
                }
            </div>
        </section>
    }
}

@code {
    [Parameter]
    public int? OrderNumber { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private PurchaseOrderFormModel model = PurchaseOrderFormModel.CreateDefault();
    private IReadOnlyCollection<ProveedorListItemDto> suppliers = [];
    private IReadOnlyCollection<PurchaseOrderReceiptDto> receipts = [];
    private IReadOnlyCollection<AuditLogEntryDto> recentAuditLogs = [];
    private string statusMessage = string.Empty;
    private bool isError;
    private bool isLegacySyncActive;
    private string syncStatusLabel = string.Empty;
    private ReceiptFormModel receiptForm = new();
    private bool IsYarnOrdersRoute => CurrentRelativePath.StartsWith("compras/comandes-fils", StringComparison.OrdinalIgnoreCase);
    private string CurrentRelativePath => NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0];
    private string ListHref => IsYarnOrdersRoute ? "/compras/comandes-fils" : "/compras/pedidos";
    private string BackToListLabel => IsYarnOrdersRoute
        ? L("Volver a comandes de fils", "Tornar a comandes de fils", "Back to yarn orders")
        : L("Volver al listado", "Tornar al llistat", "Back to list");
    private string PageTitleText => IsYarnOrdersRoute
        ? (OrderNumber.HasValue
            ? L($"Compras / Comandes Fils / Pedido {OrderNumber}", $"Compres / Comandes Fils / Comanda {OrderNumber}", $"Purchases / Yarn orders / Order {OrderNumber}")
            : L("Compras / Comandes Fils / Nuevo pedido", "Compres / Comandes Fils / Nova comanda", "Purchases / Yarn orders / New order"))
        : (OrderNumber.HasValue
            ? L($"Pedido {OrderNumber}", $"Comanda {OrderNumber}", $"Order {OrderNumber}")
            : L("Nuevo pedido de compra", "Nova comanda de compra", "New purchase order"));
    private string PageHeading => IsYarnOrdersRoute
        ? (OrderNumber.HasValue
            ? L($"Pedido de hilo {OrderNumber}", $"Comanda de fils {OrderNumber}", $"Yarn order {OrderNumber}")
            : L("Nuevo pedido de hilo", "Nova comanda de fils", "New yarn order"))
        : (OrderNumber.HasValue
            ? L($"Pedido {OrderNumber}", $"Comanda {OrderNumber}", $"Order {OrderNumber}")
            : L("Nuevo pedido a proveedor", "Nova comanda a proveïdor", "New supplier order"));
    private string PageLead => IsYarnOrdersRoute
        ? (isLegacySyncActive
            ? L("Consulta y edición sobre la réplica SaaS local de compras de hilos. La sync manual refresca solo pedidos con origen legacy y artículo presente en el maestro fil.",
                "Consulta i edició sobre la rèplica SaaS local de compres de fils. La sync manual refresca només comandes amb origen legacy i article present al mestre fil.",
                "View and edit the local SaaS replica of yarn purchases. Manual sync refreshes only legacy-origin orders whose item exists in the fil master.")
            : L("Cabecera, líneas, recepción parcial o total y auditoría del circuito web de compras de hilos.",
                "Capçalera, línies, recepció parcial o total i auditoria del circuit web de compres de fils.",
                "Header, lines, partial or full receipt, and audit trail for the web yarn purchasing workflow."))
        : (isLegacySyncActive
            ? L("Consulta y edición sobre la réplica SaaS local de pedidos de compra. La sync manual refresca solo los pedidos con origen legacy.",
                "Consulta i edició sobre la rèplica SaaS local de comandes de compra. La sync manual refresca només les comandes amb origen legacy.",
                "View and edit the local SaaS replica of purchase orders. Manual sync refreshes only orders with legacy origin.")
            : L("Cabecera, líneas, recepción parcial o total y auditoría sobre el nuevo módulo web de compras.",
                "Capçalera, línies, recepció parcial o total i auditoria sobre el nou mòdul web de compres.",
                "Header, lines, partial or full receipt, and audit trail for the new web purchasing module."));

    private ProveedorListItemDto? SelectedSupplier =>
        suppliers.FirstOrDefault(supplier => supplier.Code == model.SupplierCode);

    private decimal TotalAmount => model.Lines.Sum(LineTotal);
    private decimal TotalQuantity => model.Lines.Sum(line => line.Quantity);
    private decimal TotalReceivedQuantity => model.Lines.Sum(line => line.ReceivedQuantity);
    private decimal TotalPendingQuantity => model.Lines.Sum(line => line.PendingQuantity);
    private bool HasAnyReceipt => model.Lines.Any(line => line.ReceivedQuantity > 0);

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);
        await LoadSyncStatusAsync();

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        suppliers = (await ProveedorQueries.SearchAsync(tenantId.Value, companyId.Value, new ProveedorFilter
        {
            Page = 1,
            PageSize = 200,
            SortColumn = nameof(ProveedorListItemDto.Name)
        })).Items;

        if (OrderNumber.HasValue)
        {
            await ReloadOrderAsync();
            await LoadAuditAsync();
        }
        else
        {
            model = PurchaseOrderFormModel.CreateDefault();
            receipts = [];
            recentAuditLogs = [];
        }
    }

    private async Task LoadSyncStatusAsync()
    {
        isLegacySyncActive = false;
        syncStatusLabel = string.Empty;

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var status = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
            .FirstOrDefault(item =>
                item.CompanyId == companyId.Value &&
                string.Equals(item.ModuleKey, LegacySyncModuleKeys.PurchaseOrders, StringComparison.OrdinalIgnoreCase));

        if (status is null || !status.HasSuccessfulSync)
        {
            return;
        }

        isLegacySyncActive = true;
        syncStatusLabel = status.LastCompletedUtc.HasValue
            ? $"{L("Última sync", "Última sync", "Last sync")}: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Act: {status.LastUpdated} · Omi: {status.LastSkipped} · Err: {status.LastErrors}"
            : $"{L("Estado", "Estat", "Status")}: {status.LastStatus}";
    }

    private async Task SaveAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !canEdit)
        {
            return;
        }

        try
        {
            statusMessage = string.Empty;
            isError = false;

            var orderNumber = await PurchaseOrderService.SaveAsync(new SavePurchaseOrderCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                OrderNumber = OrderNumber,
                SupplierCode = model.SupplierCode,
                DocumentDate = model.DocumentDate,
                ExpectedDate = model.ExpectedDate,
                Status = model.Status,
                Notes = model.Notes,
                Lines = model.Lines.Select(line => new PurchaseOrderLineInputDto
                {
                    LineNumber = line.LineNumber,
                    ItemCode = line.ItemCode,
                    Description = line.Description,
                    Quantity = line.Quantity,
                    UnitOfMeasure = line.UnitOfMeasure,
                    UnitPrice = line.UnitPrice,
                    ExpectedDate = line.ExpectedDate,
                    Notes = line.Notes
                }).ToList()
            });

            statusMessage = OrderNumber.HasValue
                ? L("Pedido actualizado correctamente.", "Comanda actualitzada correctament.", "Order updated successfully.")
                : L("Pedido creado correctamente.", "Comanda creada correctament.", "Order created successfully.");

            if (!OrderNumber.HasValue)
            {
                NavigationManager.NavigateTo(BuildOrderDetailHref(orderNumber), forceLoad: false);
                return;
            }

            await ReloadOrderAsync();
            await LoadAuditAsync();
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private async Task RegisterReceiptAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !OrderNumber.HasValue || !canEdit)
        {
            return;
        }

        try
        {
            statusMessage = string.Empty;
            isError = false;

            await PurchaseOrderService.ReceiveAsync(new RegisterPurchaseOrderReceiptCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                OrderNumber = OrderNumber.Value,
                ReceiptDate = receiptForm.ReceiptDate,
                Warehouse = receiptForm.Warehouse,
                Carrier = receiptForm.Carrier,
                SupplierReference = receiptForm.SupplierReference,
                VehiclePlate = receiptForm.VehiclePlate,
                PackageCount = receiptForm.PackageCount,
                GrossWeightKg = receiptForm.GrossWeightKg,
                Notes = receiptForm.Notes,
                Lines = model.Lines
                    .Where(line => line.ReceiveNowQuantity > 0)
                    .Select(line => new RegisterPurchaseOrderReceiptLineDto
                    {
                        LineNumber = line.LineNumber,
                        ReceivedQuantity = line.ReceiveNowQuantity
                    })
                    .ToList()
            });

            receiptForm = new ReceiptFormModel();
            statusMessage = L("Recepción registrada correctamente.", "Recepció registrada correctament.", "Receipt registered successfully.");
            await ReloadOrderAsync();
            await LoadAuditAsync();
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private void AddLine()
    {
        model.Lines.Add(new PurchaseOrderLineFormModel
        {
            LineNumber = GetNextLineNumber(),
            Quantity = 1
        });
    }

    private void RemoveLine(int index)
    {
        if (index < 0 || index >= model.Lines.Count)
        {
            return;
        }

        model.Lines.RemoveAt(index);
        if (model.Lines.Count == 0)
        {
            AddLine();
        }
    }

    private async Task ReloadOrderAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !OrderNumber.HasValue)
        {
            return;
        }

        var detail = await PurchaseOrderQueries.GetByOrderNumberAsync(tenantId.Value, companyId.Value, OrderNumber.Value);
        if (detail is null)
        {
            statusMessage = L("No se ha encontrado el pedido solicitado.", "No s'ha trobat la comanda sol·licitada.", "The requested order could not be found.");
            isError = true;
            model = PurchaseOrderFormModel.CreateDefault();
            receipts = [];
            return;
        }

        model = PurchaseOrderFormModel.FromDetail(detail);
        receipts = await PurchaseOrderQueries.GetReceiptsAsync(tenantId.Value, companyId.Value, OrderNumber.Value);
    }

    private async Task LoadAuditAsync()
    {
        if (!tenantId.HasValue || !OrderNumber.HasValue)
        {
            recentAuditLogs = [];
            return;
        }

        recentAuditLogs = await AuditLogService.GetRecentAsync(
            limit: 15,
            tenantId: tenantId.Value,
            entityName: "PedidoCompra",
            entityId: OrderNumber.Value.ToString());
    }

    private int GetNextLineNumber() => model.Lines.Count == 0 ? 1 : model.Lines.Max(line => line.LineNumber) + 1;

    private string BuildOrderDetailHref(int orderNumber) =>
        IsYarnOrdersRoute
            ? $"/compras/comandes-fils/editar/{orderNumber}"
            : $"/compras/pedidos/editar/{orderNumber}";

    private string BuildReceiptDetailHref(int receiptNumber) =>
        IsYarnOrdersRoute
            ? $"/compras/albaranes-entrega-fils/{receiptNumber}"
            : $"/compras/recepciones/{receiptNumber}";

    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    private static decimal LineTotal(PurchaseOrderLineFormModel line) =>
        decimal.Round(line.Quantity * line.UnitPrice, 2, MidpointRounding.AwayFromZero);

    private string FormatStatus(string status) => status switch
    {
        PurchaseOrderStatuses.Draft => L("Borrador", "Esborrany", "Draft"),
        PurchaseOrderStatuses.Sent => L("Enviado", "Enviada", "Sent"),
        PurchaseOrderStatuses.PartiallyReceived => L("Recibido parcial", "Rebut parcial", "Partially received"),
        PurchaseOrderStatuses.Received => L("Recibido total", "Rebut total", "Fully received"),
        PurchaseOrderStatuses.Cancelled => L("Cancelado", "Cancel·lada", "Cancelled"),
        _ => status
    };

    private sealed class PurchaseOrderFormModel
    {
        public int SupplierCode { get; set; }
        public DateTime DocumentDate { get; set; } = DateTime.Today;
        public DateTime? ExpectedDate { get; set; }
        public string Status { get; set; } = PurchaseOrderStatuses.Draft;
        public string Notes { get; set; } = string.Empty;
        public List<PurchaseOrderLineFormModel> Lines { get; } = [];

        public static PurchaseOrderFormModel CreateDefault()
        {
            var model = new PurchaseOrderFormModel();
            model.Lines.Add(new PurchaseOrderLineFormModel { LineNumber = 1, Quantity = 1 });
            return model;
        }

        public static PurchaseOrderFormModel FromDetail(PurchaseOrderDetailDto detail)
        {
            var model = new PurchaseOrderFormModel
            {
                SupplierCode = detail.SupplierCode,
                DocumentDate = detail.DocumentDate,
                ExpectedDate = detail.ExpectedDate,
                Status = detail.Status,
                Notes = detail.Notes
            };

            foreach (var line in detail.Lines)
            {
                model.Lines.Add(new PurchaseOrderLineFormModel
                {
                    LineNumber = line.LineNumber,
                    ItemCode = line.ItemCode,
                    Description = line.Description,
                    Quantity = line.Quantity,
                    ReceivedQuantity = line.ReceivedQuantity,
                    UnitOfMeasure = line.UnitOfMeasure,
                    UnitPrice = line.UnitPrice,
                    ExpectedDate = line.ExpectedDate,
                    Notes = line.Notes
                });
            }

            if (model.Lines.Count == 0)
            {
                model.Lines.Add(new PurchaseOrderLineFormModel { LineNumber = 1, Quantity = 1 });
            }

            return model;
        }
    }

    private sealed class PurchaseOrderLineFormModel
    {
        public int LineNumber { get; set; }
        public string ItemCode { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal Quantity { get; set; }
        public decimal ReceivedQuantity { get; set; }
        public string UnitOfMeasure { get; set; } = string.Empty;
        public decimal UnitPrice { get; set; }
        public DateTime? ExpectedDate { get; set; }
        public string Notes { get; set; } = string.Empty;
        public decimal ReceiveNowQuantity { get; set; }
        public decimal PendingQuantity => Math.Max(0m, Quantity - ReceivedQuantity);
    }

    private sealed class ReceiptFormModel
    {
        public DateTime ReceiptDate { get; set; } = DateTime.Today;
        public string Warehouse { get; set; } = string.Empty;
        public string Carrier { get; set; } = string.Empty;
        public string SupplierReference { get; set; } = string.Empty;
        public string VehiclePlate { get; set; } = string.Empty;
        public int? PackageCount { get; set; }
        public decimal? GrossWeightKg { get; set; }
        public string Notes { get; set; } = string.Empty;
    }
}
