@page "/articulos/tejidos/{Code}/ficha"
@layout EmptyLayout
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITejidoQueries TejidoQueries

<PageTitle>Ficha tejido @Code</PageTitle>

<div class="document-shell">
    <div class="document-toolbar no-print">
        <a class="secondary-button link-button" href="/articulos/tejidos/editar/@Uri.EscapeDataString(Code)">Volver al tejido</a>
        <button class="primary-button" type="button" onclick="window.print()">Guardar como PDF / Imprimir</button>
    </div>

    @if (!tenantId.HasValue || !companyId.HasValue)
    {
        <div class="empty-state document-state">
            <p>No hay empresa activa seleccionada.</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger document-state">@errorMessage</div>
    }
    else if (tejido is null)
    {
        <div class="empty-state document-state">
            <p>No se ha encontrado el tejido solicitado.</p>
        </div>
    }
    else
    {
        <section class="document-page">
            <header class="document-header">
                <div>
                    <p class="eyebrow">Fitxa teixit</p>
                    <h1>@tejido.Code</h1>
                    <p class="muted">@tejido.Description</p>
                </div>
                <div class="document-header-meta">
                    <div>
                        <span class="muted">Centro</span>
                        <strong>@tejido.CompanyCenterCode</strong>
                    </div>
                    <div>
                        <span class="muted">Tubular</span>
                        <strong>@(tejido.IsTubular ? "Sí" : "No")</strong>
                    </div>
                </div>
            </header>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>Ficha principal</h2>
                        <div class="document-kv-grid">
                            <div><span class="muted">Gramaje</span><strong>@tejido.GramWeight.ToString("0.###")</strong></div>
                            <div><span class="muted">Ancho</span><strong>@DisplayValue(tejido.WidthText)</strong></div>
                            <div><span class="muted">Ancho nuevo</span><strong>@tejido.Width2.ToString("0.###")</strong></div>
                            <div><span class="muted">Rendimiento</span><strong>@tejido.Yield.ToString("0.###")</strong></div>
                            <div><span class="muted">Margen</span><strong>@tejido.Margin.ToString("0.##") %</strong></div>
                            <div><span class="muted">Máquina</span><strong>@DisplayValue(tejido.MachineCode)</strong></div>
                            <div><span class="muted">IVA</span><strong>@DisplayValue(tejido.VatCode)</strong></div>
                            <div><span class="muted">Composición texto</span><strong>@DisplayValue(tejido.CompositionText)</strong></div>
                        </div>
                    </section>
                    <section class="document-box">
                        <h2>Costes</h2>
                        <div class="document-kv-grid">
                            <div><span class="muted">Material</span><strong>@tejido.MaterialCost.ToString("0.0000")</strong></div>
                            <div><span class="muted">Coste cru</span><strong>@tejido.RawCost.ToString("0.0000")</strong></div>
                            <div><span class="muted">Tejedor</span><strong>@DisplayValue(tejido.WeaverCode)</strong></div>
                            <div><span class="muted">Coste tejer</span><strong>@tejido.WeavingCost.ToString("0.0000")</strong></div>
                            <div><span class="muted">Estampador</span><strong>@DisplayValue(tejido.PrinterCode)</strong></div>
                            <div><span class="muted">Coste estampar</span><strong>@tejido.PrintingCost.ToString("0.0000")</strong></div>
                            <div><span class="muted">Acabador</span><strong>@DisplayValue(tejido.FinisherCode)</strong></div>
                            <div><span class="muted">Coste acabados</span><strong>@tejido.FinishingCost.ToString("0.0000")</strong></div>
                        </div>
                    </section>
                </div>
            </section>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>Stock</h2>
                        <div class="document-kv-grid">
                            <div><span class="muted">Cru kg</span><strong>@tejido.RawStockKilograms.ToString("0.###")</strong></div>
                            <div><span class="muted">Cru m</span><strong>@tejido.RawStockMeters.ToString("0.###")</strong></div>
                            <div><span class="muted">Disponible kg</span><strong>@tejido.AvailableStockKilograms.ToString("0.###")</strong></div>
                            <div><span class="muted">Disponible m</span><strong>@tejido.AvailableStockMeters.ToString("0.###")</strong></div>
                            <div><span class="muted">Precio metro</span><strong>@tejido.PricePerMeter.ToString("0.0000")</strong></div>
                            <div><span class="muted">Precio kilo</span><strong>@tejido.PricePerKilogram.ToString("0.0000")</strong></div>
                        </div>
                    </section>
                    <section class="document-box">
                        <h2>Notas</h2>
                        <p>@(string.IsNullOrWhiteSpace(tejido.Notes) ? "Sin notas." : tejido.Notes)</p>
                    </section>
                </div>
            </section>

            <section class="document-section">
                <h2>Colors per tipus de teixit</h2>
                <table class="data-table document-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Proveedor</th>
                            <th>Color</th>
                            <th>Actual</th>
                            <th>Mínimo</th>
                            <th>Tintar</th>
                            <th>Precio</th>
                            <th>€/Mts.</th>
                            <th>€/KG</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var color in tejido.Colors.OrderBy(item => item.LineNumber))
                        {
                            <tr>
                                <td>@color.LineNumber</td>
                                <td>@DisplayValue(color.SupplierCode)</td>
                                <td>@DisplayValue(color.Color)</td>
                                <td>@color.CurrentStock.ToString("0.###")</td>
                                <td>@color.MinimumStock.ToString("0.###")</td>
                                <td>@color.DyeingPrice.ToString("0.0000")</td>
                                <td>@color.UnitCost.ToString("0.0000")</td>
                                <td>@color.MetersPrice.ToString("0.0000")</td>
                                <td>@color.KilogramsPrice.ToString("0.0000")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>Escandall · Composició</h2>
                        <table class="data-table document-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Componente</th>
                                    <th>%</th>
                                    <th>Proveedor</th>
                                    <th>Precio</th>
                                    <th>Importe</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in tejido.Composition.OrderBy(item => item.LineNumber))
                                {
                                    <tr>
                                        <td>@row.LineNumber</td>
                                        <td>@DisplayValue(row.ComponentCode)</td>
                                        <td>@row.Percentage</td>
                                        <td>@DisplayValue(row.SupplierCode)</td>
                                        <td>@row.UnitPrice.ToString("0.0000")</td>
                                        <td>@row.Amount.ToString("0.0000")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </section>
                    <section class="document-box">
                        <h2>Escandall · Acabados</h2>
                        <table class="data-table document-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Acabado</th>
                                    <th>Proveedor</th>
                                    <th>Orden</th>
                                    <th>Precio m</th>
                                    <th>Precio kg</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in tejido.Finishes.OrderBy(item => item.LineNumber))
                                {
                                    <tr>
                                        <td>@row.LineNumber</td>
                                        <td>@DisplayValue(row.FinishCode)</td>
                                        <td>@DisplayValue(row.SupplierCode)</td>
                                        <td>@row.Order</td>
                                        <td>@row.PricePerMeter.ToString("0.0000")</td>
                                        <td>@row.PricePerKilogram.ToString("0.0000")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </section>
                </div>
            </section>
        </section>
    }
</div>

@code {
    [Parameter]
    public string Code { get; set; } = string.Empty;

    private Guid? tenantId;
    private Guid? companyId;
    private TejidoDetailDto? tejido;
    private string errorMessage = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        try
        {
            errorMessage = string.Empty;
            tejido = await TejidoQueries.GetByCodeAsync(tenantId.Value, companyId.Value, Uri.UnescapeDataString(Code));
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
    }

    private static string DisplayValue(string value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string DisplayValue(int value) => value <= 0 ? "-" : value.ToString();
}
