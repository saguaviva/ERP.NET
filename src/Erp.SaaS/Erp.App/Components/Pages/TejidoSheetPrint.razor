@page "/articulos/tejidos/{Code}/ficha"
@layout EmptyLayout
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITejidoQueries TejidoQueries
@inject AppText T

<PageTitle>@($"{L("Ficha técnica de tejido", "Fitxa tècnica de teixit", "Fabric specification sheet")} {Code}")</PageTitle>

<div class="document-shell">
    <div class="document-toolbar no-print">
        <a class="secondary-button link-button" href="/articulos/tejidos/editar/@Uri.EscapeDataString(Code)">@L("Volver al tejido", "Tornar al teixit", "Back to fabric")</a>
        <button class="primary-button" type="button" onclick="window.print()">@L("Imprimir / guardar PDF", "Imprimir / desar PDF", "Print / save PDF")</button>
    </div>

    @if (!tenantId.HasValue || !companyId.HasValue)
    {
        <div class="empty-state document-state">
            <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger document-state">@errorMessage</div>
    }
    else if (tejido is null)
    {
        <div class="empty-state document-state">
            <p>@L("No se ha encontrado el tejido solicitado.", "No s'ha trobat el teixit sol·licitat.", "The requested fabric could not be found.")</p>
        </div>
    }
    else
    {
        <section class="document-page">
            <header class="document-header">
                <div>
                    <p class="eyebrow">@L("Ficha técnica de tejido", "Fitxa tècnica de teixit", "Fabric specification sheet")</p>
                    <h1>@tejido.Code</h1>
                    <p class="muted">@tejido.Description</p>
                </div>
                <div class="document-header-meta">
                    <div>
                        <span class="muted">@L("Centro", "Centre", "Center")</span>
                        <strong>@tejido.CompanyCenterCode</strong>
                    </div>
                    <div>
                        <span class="muted">@L("Tubular", "Tubular", "Tubular")</span>
                        <strong>@(tejido.IsTubular ? L("Sí", "Sí", "Yes") : L("No", "No", "No"))</strong>
                    </div>
                </div>
            </header>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>@L("Datos principales", "Dades principals", "Main details")</h2>
                        <div class="document-kv-grid">
                            <div><span class="muted">@L("Gramaje", "Gramatge", "Weight")</span><strong>@tejido.GramWeight.ToUiString("0.###")</strong></div>
                            <div><span class="muted">@L("Ancho", "Ample", "Width")</span><strong>@DisplayValue(tejido.WidthText)</strong></div>
                            <div><span class="muted">@L("Ancho nuevo", "Ample nou", "New width")</span><strong>@tejido.Width2.ToUiString("0.###")</strong></div>
                            <div><span class="muted">@L("Rendimiento", "Rendiment", "Yield")</span><strong>@tejido.Yield.ToUiString("0.###")</strong></div>
                            <div><span class="muted">@L("Margen", "Marge", "Margin")</span><strong>@tejido.Margin.ToUiString("0.##") %</strong></div>
                            <div><span class="muted">@L("Máquina", "Màquina", "Machine")</span><strong>@DisplayValue(tejido.MachineCode)</strong></div>
                            <div><span class="muted">@L("IVA", "IVA", "VAT")</span><strong>@DisplayValue(tejido.VatCode)</strong></div>
                            <div><span class="muted">@L("Composición texto", "Composició text", "Composition text")</span><strong>@DisplayValue(tejido.CompositionText)</strong></div>
                        </div>
                    </section>
                    <section class="document-box">
                        <h2>@L("Costes", "Costos", "Costs")</h2>
                        <div class="document-kv-grid">
                            <div><span class="muted">@L("Material", "Material", "Material")</span><strong>@tejido.MaterialCost.ToUiString("0.0000")</strong></div>
                            <div><span class="muted">@L("Coste cru", "Cost cru", "Raw cost")</span><strong>@tejido.RawCost.ToUiString("0.0000")</strong></div>
                            <div><span class="muted">@L("Tejedor", "Teixidor", "Weaver")</span><strong>@DisplayValue(tejido.WeaverCode)</strong></div>
                            <div><span class="muted">@L("Coste tejer", "Cost teixir", "Weaving cost")</span><strong>@tejido.WeavingCost.ToUiString("0.0000")</strong></div>
                            <div><span class="muted">@L("Estampador", "Estampador", "Printer")</span><strong>@DisplayValue(tejido.PrinterCode)</strong></div>
                            <div><span class="muted">@L("Coste estampar", "Cost estampar", "Printing cost")</span><strong>@tejido.PrintingCost.ToUiString("0.0000")</strong></div>
                            <div><span class="muted">@L("Acabador", "Acabador", "Finisher")</span><strong>@DisplayValue(tejido.FinisherCode)</strong></div>
                            <div><span class="muted">@L("Coste acabados", "Cost acabats", "Finishing cost")</span><strong>@tejido.FinishingCost.ToUiString("0.0000")</strong></div>
                        </div>
                    </section>
                </div>
            </section>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>@L("Stock", "Estoc", "Stock")</h2>
                        <div class="document-kv-grid">
                            <div><span class="muted">@L("Cru kg", "Cru kg", "Raw kg")</span><strong>@tejido.RawStockKilograms.ToUiString("0.###")</strong></div>
                            <div><span class="muted">@L("Cru m", "Cru m", "Raw m")</span><strong>@tejido.RawStockMeters.ToUiString("0.###")</strong></div>
                            <div><span class="muted">@L("Disponible kg", "Disponible kg", "Available kg")</span><strong>@tejido.AvailableStockKilograms.ToUiString("0.###")</strong></div>
                            <div><span class="muted">@L("Disponible m", "Disponible m", "Available m")</span><strong>@tejido.AvailableStockMeters.ToUiString("0.###")</strong></div>
                            <div><span class="muted">@L("Precio metro", "Preu metre", "Price per meter")</span><strong>@tejido.PricePerMeter.ToUiString("0.0000")</strong></div>
                            <div><span class="muted">@L("Precio kilo", "Preu quilo", "Price per kilogram")</span><strong>@tejido.PricePerKilogram.ToUiString("0.0000")</strong></div>
                        </div>
                    </section>
                    <section class="document-box">
                        <h2>@L("Notas", "Notes", "Notes")</h2>
                        <p>@(string.IsNullOrWhiteSpace(tejido.Notes) ? L("Sin notas registradas.", "Sense notes registrades.", "No notes recorded.") : tejido.Notes)</p>
                    </section>
                </div>
            </section>

            <section class="document-section">
                <h2>@L("Colores por tipo de tejido", "Colors per tipus de teixit", "Colors by fabric type")</h2>
                <table class="data-table document-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@L("Proveedor", "Proveïdor", "Supplier")</th>
                            <th>@L("Color", "Color", "Color")</th>
                            <th>@L("Actual", "Actual", "Current")</th>
                            <th>@L("Mínimo", "Mínim", "Minimum")</th>
                            <th>@L("Tintar", "Tintar", "Dye")</th>
                            <th>@L("Precio", "Preu", "Price")</th>
                            <th>€/Mts.</th>
                            <th>€/KG</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var color in tejido.Colors.OrderBy(item => item.LineNumber))
                        {
                            <tr>
                                <td>@color.LineNumber</td>
                                <td>@DisplayValue(color.SupplierCode)</td>
                                <td>@DisplayValue(color.Color)</td>
                                <td>@color.CurrentStock.ToUiString("0.###")</td>
                                <td>@color.MinimumStock.ToUiString("0.###")</td>
                                <td>@color.DyeingPrice.ToUiString("0.0000")</td>
                                <td>@color.UnitCost.ToUiString("0.0000")</td>
                                <td>@color.MetersPrice.ToUiString("0.0000")</td>
                                <td>@color.KilogramsPrice.ToUiString("0.0000")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>@L("Escandall · Composición", "Escandall · Composició", "Bill of materials · Composition")</h2>
                        <table class="data-table document-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>@L("Componente", "Component", "Component")</th>
                                    <th>%</th>
                                    <th>@L("Proveedor", "Proveïdor", "Supplier")</th>
                                    <th>@L("Precio", "Preu", "Price")</th>
                                    <th>@L("Importe", "Import", "Amount")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in tejido.Composition.OrderBy(item => item.LineNumber))
                                {
                                    <tr>
                                        <td>@row.LineNumber</td>
                                        <td>@DisplayValue(row.ComponentCode)</td>
                                        <td>@row.Percentage</td>
                                        <td>@DisplayValue(row.SupplierCode)</td>
                                        <td>@row.UnitPrice.ToUiString("0.0000")</td>
                                        <td>@row.Amount.ToUiString("0.0000")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </section>
                    <section class="document-box">
                        <h2>@L("Escandall · Acabados", "Escandall · Acabats", "Bill of materials · Finishes")</h2>
                        <table class="data-table document-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>@L("Acabado", "Acabat", "Finish")</th>
                                    <th>@L("Proveedor", "Proveïdor", "Supplier")</th>
                                    <th>@L("Orden", "Ordre", "Order")</th>
                                    <th>@L("Precio m", "Preu m", "Price m")</th>
                                    <th>@L("Precio kg", "Preu kg", "Price kg")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in tejido.Finishes.OrderBy(item => item.LineNumber))
                                {
                                    <tr>
                                        <td>@row.LineNumber</td>
                                        <td>@DisplayValue(row.FinishCode)</td>
                                        <td>@DisplayValue(row.SupplierCode)</td>
                                        <td>@row.Order</td>
                                        <td>@row.PricePerMeter.ToUiString("0.0000")</td>
                                        <td>@row.PricePerKilogram.ToUiString("0.0000")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </section>
                </div>
            </section>
        </section>
    }
</div>

@code {
    [Parameter]
    public string Code { get; set; } = string.Empty;

    private Guid? tenantId;
    private Guid? companyId;
    private TejidoDetailDto? tejido;
    private string errorMessage = string.Empty;
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        try
        {
            errorMessage = string.Empty;
            tejido = await TejidoQueries.GetByCodeAsync(tenantId.Value, companyId.Value, Uri.UnescapeDataString(Code));
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
    }

    private static string DisplayValue(string value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string DisplayValue(int value) => value <= 0 ? "-" : value.ToString();
}
