@page "/articulos/models/{Id:guid}/imprimir"
@layout EmptyLayout
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IModeloQueries ModeloQueries
@inject AppText T

<PageTitle>@($"{L("Ficha técnica del model", "Fitxa tècnica del model", "Model specification sheet")} {Id}")</PageTitle>

<div class="document-shell">
    <div class="document-toolbar no-print">
        <a class="secondary-button link-button" href="/articulos/models/editar/@Id">@L("Volver al model", "Tornar al model", "Back to model")</a>
        <button class="primary-button" type="button" onclick="window.print()">@L("Imprimir / guardar PDF", "Imprimir / desar PDF", "Print / save PDF")</button>
    </div>

    @if (!tenantId.HasValue || !companyId.HasValue)
    {
        <div class="empty-state document-state">
            <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger document-state">@errorMessage</div>
    }
    else if (model is null)
    {
        <div class="empty-state document-state">
            <p>@L("No se ha encontrado el model solicitado.", "No s'ha trobat el model sol·licitat.", "The requested model could not be found.")</p>
        </div>
    }
    else
    {
        <section class="document-page">
            <header class="document-header">
                <div>
                    <p class="eyebrow">@L("Ficha técnica del model", "Fitxa tècnica del model", "Model specification sheet")</p>
                    <h1>@model.Code</h1>
                    <p class="muted">@DisplayValue(model.Description)</p>
                </div>
                <div class="document-header-meta">
                    <div>
                        <span class="muted">@L("Centro", "Centre", "Center")</span>
                        <strong>@DisplayValue(model.CompanyCenterCode)</strong>
                    </div>
                    <div>
                        <span class="muted">@L("Temporada", "Temporada", "Season")</span>
                        <strong>@DisplayValue(model.Season)</strong>
                    </div>
                    <div>
                        <span class="muted">@L("Serie", "Sèrie", "Series")</span>
                        <strong>@DisplayValue(model.Series)</strong>
                    </div>
                </div>
            </header>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>@L("Datos principales", "Dades principals", "Main details")</h2>
                        <div class="document-kv-grid">
                            <div><span class="muted">@L("Cliente", "Client", "Customer")</span><strong>@DisplayClient</strong></div>
                            <div><span class="muted">@L("Código model", "Codi model", "Model code")</span><strong>@DisplayValue(model.ModelCode)</strong></div>
                            <div><span class="muted">@L("Tejido", "Teixit", "Fabric")</span><strong>@DisplayFabric</strong></div>
                            <div><span class="muted">@L("Proveedor", "Proveïdor", "Supplier")</span><strong>@DisplaySupplier</strong></div>
                            <div><span class="muted">@L("Ancho", "Ample", "Width")</span><strong>@DisplayValue(model.WidthText)</strong></div>
                            <div><span class="muted">@L("Rendimiento", "Rendiment", "Yield")</span><strong>@model.Yield.ToUiString("0.###")</strong></div>
                            <div><span class="muted">@L("IVA", "IVA", "VAT")</span><strong>@DisplayValue(model.VatCode)</strong></div>
                            <div><span class="muted">@L("Origen", "Origen", "Origin")</span><strong>@DisplayValue(model.Origin)</strong></div>
                        </div>
                    </section>
                    <section class="document-box">
                        <h2>@L("Venta y costes", "Venda i costos", "Sales and costs")</h2>
                        <div class="document-kv-grid">
                            <div><span class="muted">@L("Coste", "Cost", "Cost")</span><strong>@model.CostPrice.ToUiString("0.00##")</strong></div>
                            <div><span class="muted">@L("Margen", "Marge", "Margin")</span><strong>@model.MarginPercent.ToUiString("0.0#") %</strong></div>
                            <div><span class="muted">@L("Venta", "Venda", "Sale")</span><strong>@model.SalePrice.ToUiString("0.00##")</strong></div>
                            <div><span class="muted">@L("Venta final", "Venda final", "Final sale")</span><strong>@model.FinalSalePrice.ToUiString("0.00##")</strong></div>
                            <div><span class="muted">@L("Coste pack", "Cost pack", "Pack cost")</span><strong>@model.PackagingPrice.ToUiString("0.00##")</strong></div>
                            <div><span class="muted">@L("Manipulación", "Manipulació", "Handling")</span><strong>@model.ManipulationPrice.ToUiString("0.00##")</strong></div>
                            <div><span class="muted">@L("Coste fornitura", "Cost fornitura", "Trim cost")</span><strong>@model.FornituraPrice.ToUiString("0.00##")</strong></div>
                            <div><span class="muted">@L("Coste confección", "Cost confecció", "Tailoring cost")</span><strong>@model.TailoringPrice.ToUiString("0.00##")</strong></div>
                        </div>
                    </section>
                </div>
            </section>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>@L("Operaciones y talleres", "Operacions i tallers", "Operations and workshops")</h2>
                        <div class="document-kv-grid">
                            <div><span class="muted">@L("Tintura", "Tintura", "Dyeing")</span><strong>@DisplayWorkshop(model.DyeingWorkshopCode, model.DyeingWorkshopName)</strong></div>
                            <div><span class="muted">@L("Acabado", "Acabat", "Finishing")</span><strong>@DisplayWorkshop(model.FinishingWorkshopCode, model.FinishingWorkshopName)</strong></div>
                            <div><span class="muted">@L("Estampación", "Estampació", "Printing")</span><strong>@DisplayWorkshop(model.PrintingWorkshopCode, model.PrintingWorkshopName)</strong></div>
                            <div><span class="muted">@L("Confección", "Confecció", "Tailoring")</span><strong>@DisplayWorkshop(model.TailoringWorkshopCode, model.TailoringWorkshopName)</strong></div>
                            <div><span class="muted">@L("Resumen fornitura", "Resum fornitura", "Trim summary")</span><strong>@DisplayValue(model.FornituraSummary)</strong></div>
                            <div><span class="muted">@L("Código estamp. 1", "Codi estamp. 1", "Print code 1")</span><strong>@DisplayValue(model.PrintingCode1)</strong></div>
                            <div><span class="muted">@L("Código estamp. 2", "Codi estamp. 2", "Print code 2")</span><strong>@DisplayValue(model.PrintingCode2)</strong></div>
<div><span class="muted">@L("Unidades estamp. 1/2", "Unitats estamp. 1/2", "Print units 1/2")</span><strong>@($"{model.PrintingUnits1.ToUiString("0.##")} / {model.PrintingUnits2.ToUiString("0.##")}")</strong></div>
                        </div>
                    </section>
                    <section class="document-box">
                        <h2>@L("Tallas y notas", "Talles i notes", "Sizes and notes")</h2>
                        <div class="document-kv-grid">
                            <div><span class="muted">@L("Talla 01", "Talla 01", "Size 01")</span><strong>@DisplayValue(model.Size01)</strong></div>
                            <div><span class="muted">@L("Talla 02", "Talla 02", "Size 02")</span><strong>@DisplayValue(model.Size02)</strong></div>
                            <div><span class="muted">@L("Talla 03", "Talla 03", "Size 03")</span><strong>@DisplayValue(model.Size03)</strong></div>
                            <div><span class="muted">@L("Talla 04", "Talla 04", "Size 04")</span><strong>@DisplayValue(model.Size04)</strong></div>
                            <div><span class="muted">@L("Talla 05", "Talla 05", "Size 05")</span><strong>@DisplayValue(model.Size05)</strong></div>
                            <div><span class="muted">@L("Talla 06", "Talla 06", "Size 06")</span><strong>@DisplayValue(model.Size06)</strong></div>
                            <div><span class="muted">@L("Talla 07", "Talla 07", "Size 07")</span><strong>@DisplayValue(model.Size07)</strong></div>
                            <div><span class="muted">@L("Talla 08", "Talla 08", "Size 08")</span><strong>@DisplayValue(model.Size08)</strong></div>
                            <div><span class="muted">@L("Talla 09", "Talla 09", "Size 09")</span><strong>@DisplayValue(model.Size09)</strong></div>
                            <div><span class="muted">@L("Talla 10", "Talla 10", "Size 10")</span><strong>@DisplayValue(model.Size10)</strong></div>
                        </div>
                        <p style="margin-top: 1rem;">@(string.IsNullOrWhiteSpace(model.Notes) ? L("Sin notas registradas.", "Sense notes registrades.", "No notes recorded.") : model.Notes)</p>
                    </section>
                </div>
            </section>

            <section class="document-section">
                <h2>@L("Escandall", "Escandall", "Bill of materials")</h2>
                <table class="data-table document-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@L("Pieza", "Peça", "Piece")</th>
                            <th>@L("Tejido", "Teixit", "Fabric")</th>
                            <th>@L("Consumo", "Consum", "Consumption")</th>
                            <th>@L("Precio", "Preu", "Price")</th>
                            <th>@L("Coste", "Cost", "Cost")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (model.ScandalloLines.Count == 0)
                        {
                            <tr><td colspan="6">@L("Sin líneas de escandallo.", "Sense línies d'escandall.", "No bill of materials lines.")</td></tr>
                        }
                        else
                        {
                            @foreach (var row in model.ScandalloLines.OrderBy(item => item.LineNumber))
                            {
                                <tr>
                                    <td>@row.LineNumber</td>
                                    <td>@DisplayValue(row.Title)</td>
                                    <td>@DisplayValue(row.FabricCode)</td>
                                    <td>@row.Consumption.ToUiString("0.####")</td>
                                    <td>@row.UnitPrice.ToUiString("0.00##")</td>
                                    <td>@row.CostPrice.ToUiString("0.00##")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </section>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>@L("Colores", "Colors", "Colors")</h2>
                        <table class="data-table document-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>MODCOL</th>
                                    <th>@L("Pieza", "Peça", "Piece")</th>
                                    <th>@L("Color pieza", "Color peça", "Piece color")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (model.ColorLines.Count == 0)
                                {
                                    <tr><td colspan="4">@L("Sin colores.", "Sense colors.", "No colors.")</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in model.ColorLines.OrderBy(item => item.LineNumber))
                                    {
                                        <tr>
                                            <td>@row.LineNumber</td>
                                            <td>@DisplayValue(row.ModelColorCode)</td>
                                            <td>@DisplayValue(row.Title)</td>
                                            <td>@DisplayValue(row.ColorTitle)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </section>
                    <section class="document-box">
                        <h2>@L("Fornituras", "Fornitures", "Trims")</h2>
                        <table class="data-table document-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>@L("Fornitura", "Fornitura", "Trim")</th>
                                    <th>@L("Medida", "Mesura", "Size")</th>
                                    <th>@L("Unidades", "Unitats", "Units")</th>
                                    <th>@L("Precio", "Preu", "Price")</th>
                                    <th>@L("Importe", "Import", "Amount")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (model.FornituraLines.Count == 0)
                                {
                                    <tr><td colspan="6">@L("Sin fornituras registradas.", "Sense fornitures registrades.", "No trims recorded.")</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in model.FornituraLines.OrderBy(item => item.LineNumber))
                                    {
                                        <tr>
                                            <td>@row.LineNumber</td>
                                            <td>@DisplayValue(row.FornituraCode)</td>
                                            <td>@DisplayValue(row.Measure)</td>
                                            <td>@row.Units.ToUiString("0.####")</td>
                                            <td>@row.UnitPrice.ToUiString("0.00##")</td>
                                            <td>@row.ImportAmount.ToUiString("0.00##")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </section>
                </div>
            </section>

            <section class="document-section">
                <h2>@L("Stock", "Estoc", "Stock")</h2>
                <table class="data-table document-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@L("Color", "Color", "Color")</th>
                            <th>@L("Talla", "Talla", "Size")</th>
                            <th>01</th>
                            <th>02</th>
                            <th>03</th>
                            <th>04</th>
                            <th>05</th>
                            <th>06</th>
                            <th>07</th>
                            <th>08</th>
                            <th>09</th>
                            <th>10</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (model.StockLines.Count == 0)
                        {
                            <tr><td colspan="13">@L("Sin stock registrado.", "Sense estoc registrat.", "No stock records.")</td></tr>
                        }
                        else
                        {
                            @foreach (var row in model.StockLines.OrderBy(item => item.LineNumber))
                            {
                                <tr>
                                    <td>@row.LineNumber</td>
                                    <td>@DisplayValue(row.Color)</td>
                                    <td>@DisplayValue(row.SizeText)</td>
                                    <td>@row.SizeQuantity01.ToUiString("0.##")</td>
                                    <td>@row.SizeQuantity02.ToUiString("0.##")</td>
                                    <td>@row.SizeQuantity03.ToUiString("0.##")</td>
                                    <td>@row.SizeQuantity04.ToUiString("0.##")</td>
                                    <td>@row.SizeQuantity05.ToUiString("0.##")</td>
                                    <td>@row.SizeQuantity06.ToUiString("0.##")</td>
                                    <td>@row.SizeQuantity07.ToUiString("0.##")</td>
                                    <td>@row.SizeQuantity08.ToUiString("0.##")</td>
                                    <td>@row.SizeQuantity09.ToUiString("0.##")</td>
                                    <td>@row.SizeQuantity10.ToUiString("0.##")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </section>
        </section>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private ModeloDetailDto? model;
    private string errorMessage = string.Empty;
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    private string DisplayClient => model is null
        ? "-"
        : string.IsNullOrWhiteSpace(model.ClientName)
            ? (model.ClientCode > 0 ? model.ClientCode.ToString() : "-")
            : $"{model.ClientCode} · {model.ClientName}";

    private string DisplayFabric => model is null
        ? "-"
        : string.IsNullOrWhiteSpace(model.FabricDescription)
            ? DisplayValue(model.FabricCode)
            : $"{DisplayValue(model.FabricCode)} · {model.FabricDescription}";

    private string DisplaySupplier => model is null
        ? "-"
        : string.IsNullOrWhiteSpace(model.SupplierName)
            ? (model.SupplierCode > 0 ? model.SupplierCode.ToString() : "-")
            : $"{model.SupplierCode} · {model.SupplierName}";

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        try
        {
            errorMessage = string.Empty;
            model = await ModeloQueries.GetByIdAsync(tenantId.Value, companyId.Value, Id);
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            model = null;
        }
    }

    private static string DisplayValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string DisplayWorkshop(int code, string? name)
    {
        if (!string.IsNullOrWhiteSpace(name))
        {
            return code > 0 ? $"{code} · {name}" : name;
        }

        return code > 0 ? code.ToString() : "-";
    }
}
