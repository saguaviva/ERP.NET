                            {
                                <span>@L("Checkpoint", "Checkpoint", "Checkpoint"): @job.CheckpointAfter</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(job.Summary))
                            {
                                <span>@job.Summary</span>
                            }
                            <span>@job.StartedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </article>
                    }
                }
            </div>
        </section>
    </div>
}

@code {
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    private string BuildSyncCompletedMessage(LegacySyncResultDto result) =>
        L(
            $"Sincronización completada. Empresas={result.CompaniesProcessed}, Insertados={result.RecordsInserted}, Actualizados={result.RecordsUpdated}, Omitidos={result.RecordsSkipped}, Errores={result.ErrorsCount}.",
            $"Sincronització completada. Empreses={result.CompaniesProcessed}, Inserits={result.RecordsInserted}, Actualitzats={result.RecordsUpdated}, Omesos={result.RecordsSkipped}, Errors={result.ErrorsCount}.",
            $"Sync completed. Companies={result.CompaniesProcessed}, Inserted={result.RecordsInserted}, Updated={result.RecordsUpdated}, Skipped={result.RecordsSkipped}, Errors={result.ErrorsCount}.");

    private string FormatSyncCounters(LegacySyncModuleStatusDto status) =>
        L(
            $"Ins.: {status.LastInserted} · Act.: {status.LastUpdated} · Omi.: {status.LastSkipped} · Err.: {status.LastErrors}",
            $"Ins.: {status.LastInserted} · Act.: {status.LastUpdated} · Omi.: {status.LastSkipped} · Err.: {status.LastErrors}",
            $"Ins.: {status.LastInserted} · Upd.: {status.LastUpdated} · Skip: {status.LastSkipped} · Err.: {status.LastErrors}");

    private string CompanyLabel => L("Empresa", "Empresa", "Company");
    private string AllTenantCompaniesLabel => L("Todas las empresas del tenant", "Totes les empreses del tenant", "All tenant companies");
    private string NotSyncedLabel => L("Sin sincronizar", "Sense sincronitzar", "Not synced");
    private string NeverLabel => L("Nunca", "Mai", "Never");
    private string LegacySyncLabel => L("Sync legacy", "Sync legacy", "Legacy sync");

    private static readonly string[] TenantRoles = [PlatformRoles.TenantAdmin, PlatformRoles.TenantReader];

    private Guid? currentTenantId;
    private Guid? currentUserId;
    private Guid? activeCompanyId;
    private bool isPlatformAdmin;
    private TenantSummaryDto? currentTenant;
    private IReadOnlyCollection<TenantSummaryDto> tenants = [];
    private IReadOnlyCollection<CompanySummaryDto> companies = [];
    private IReadOnlyCollection<LegacyCenterOptionDto> legacyCenters = [];
    private IReadOnlyCollection<TenantModuleSettingDto> moduleSettings = [];
    private IReadOnlyCollection<UserSummaryDto> users = [];
    private IReadOnlyCollection<AuditLogEntryDto> recentAuditLogs = [];
    private IReadOnlyCollection<LegacySyncModuleStatusDto> syncStatuses = [];
    private IReadOnlyCollection<LegacySyncJobSummaryDto> recentSyncJobs = [];
    private CompanyFormModel companyForm = new();
    private UserFormModel userForm = new();
    private string statusMessage = string.Empty;
    private bool isError;
    private string crmClientsDataScope = TenantModuleDataScopes.Company;
    private bool isRunningCrmClientsSync;
    private string selectedCrmClientsSyncCompanyId = string.Empty;
    private bool isRunningCrmRepresentativesSync;
    private string selectedCrmRepresentativesSyncCompanyId = string.Empty;
    private bool isRunningCrmCarriersSync;
    private string selectedCrmCarriersSyncCompanyId = string.Empty;
    private bool isRunningCrmWorkshopsSync;
    private string selectedCrmWorkshopsSyncCompanyId = string.Empty;
    private bool isRunningArticleForniturasSync;
    private string selectedArticleForniturasSyncCompanyId = string.Empty;
    private bool isRunningArticleHilosSync;
    private string selectedArticleHilosSyncCompanyId = string.Empty;
    private bool isRunningArticleTejidosSync;
    private string selectedArticleTejidosSyncCompanyId = string.Empty;
    private bool isRunningArticleModelsSync;
    private string selectedArticleModelsSyncCompanyId = string.Empty;
    private bool isRunningArticleMuestrasSync;
    private string selectedArticleMuestrasSyncCompanyId = string.Empty;
    private bool isRunningArticleDispositionsSync;
    private string selectedArticleDispositionsSyncCompanyId = string.Empty;
    private bool isRunningBaseBanksCashboxesSync;
    private string selectedBaseBanksCashboxesSyncCompanyId = string.Empty;
    private bool isRunningBasePaymentMethodsSync;
    private string selectedBasePaymentMethodsSyncCompanyId = string.Empty;
    private bool isRunningBaseOperationsSync;
    private string selectedBaseOperationsSyncCompanyId = string.Empty;
    private bool isRunningBaseMachinesSync;
    private string selectedBaseMachinesSyncCompanyId = string.Empty;
    private bool isRunningBaseSeasonsSync;
    private string selectedBaseSeasonsSyncCompanyId = string.Empty;
    private bool isRunningBaseVatTypesSync;
    private string selectedBaseVatTypesSyncCompanyId = string.Empty;
    private bool isRunningBaseIncotermsSync;
    private string selectedBaseIncotermsSyncCompanyId = string.Empty;
    private bool isRunningCrmSuppliersSync;
    private string selectedCrmSuppliersSyncCompanyId = string.Empty;
    private bool isRunningPurchaseOrdersSync;
    private string selectedPurchaseOrdersSyncCompanyId = string.Empty;
    private bool isRunningPurchaseReceiptsSync;
    private string selectedPurchaseReceiptsSyncCompanyId = string.Empty;
    private bool isRunningStockItemsSync;
    private string selectedStockItemsSyncCompanyId = string.Empty;
    private bool isRunningSalesOrdersSync;
    private string selectedSalesOrdersSyncCompanyId = string.Empty;
    private bool isRunningSalesShipmentsSync;
    private string selectedSalesShipmentsSyncCompanyId = string.Empty;
    private bool isRunningSalesInvoicesSync;
    private string selectedSalesInvoicesSyncCompanyId = string.Empty;
    private Guid? editingCompanyId;
    private string editingCompanyLegacyCenterCode = string.Empty;
    private CompanyLegacyCenterImpactDto? editingCompanyImpact;
