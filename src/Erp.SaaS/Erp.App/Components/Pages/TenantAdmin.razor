    private HashSet<Guid> editingCompanyIds = [];
    private HashSet<string> editingRoles = [];
    private Guid? passwordEditorUserId;
    private string passwordEditorValue = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUserId = user.GetUserId();
        currentTenantId = user.GetTenantId();
        activeCompanyId = user.GetActiveCompanyId();
        isPlatformAdmin = user.IsPlatformAdmin();

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (!currentTenantId.HasValue)
        {
            tenants = [];
            companies = [];
            legacyCenters = [];
            users = [];
            recentAuditLogs = [];
            currentTenant = null;
            return;
        }

        tenants = await TenantAdminService.GetTenantsAsync();
        currentTenant = tenants.FirstOrDefault(tenant => tenant.Id == currentTenantId.Value)
            ?? tenants.FirstOrDefault();

        if (currentTenant is null)
        {
            companies = [];
            legacyCenters = [];
            users = [];
            recentAuditLogs = [];
            return;
        }

        companies = await TenantAdminService.GetCompaniesAsync(currentTenant.Id);
        legacyCenters = await TenantAdminService.GetLegacyCentersAsync(currentTenant.Id);
        moduleSettings = await TenantAdminService.GetModuleSettingsAsync(currentTenant.Id);
        users = await TenantAdminService.GetUsersAsync(currentTenant.Id);
        recentAuditLogs = await AuditLogService.GetRecentAsync(limit: 30, tenantId: currentTenant.Id);
        syncStatuses = await LegacySyncService.GetModuleStatusesAsync(currentTenant.Id);
        recentSyncJobs = await LegacySyncService.GetRecentJobsAsync(currentTenant.Id, limit: 20);
        crmClientsDataScope = moduleSettings
            .FirstOrDefault(item => string.Equals(item.ModuleKey, TenantModuleKeys.CrmClients, StringComparison.OrdinalIgnoreCase))
            ?.DataScope ?? TenantModuleDataScopes.Company;
        SelectFirstAvailableLegacyCenter();
    }

