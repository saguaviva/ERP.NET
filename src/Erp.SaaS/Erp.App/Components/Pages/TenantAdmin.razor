@page "/administracion"
@attribute [Authorize(Roles = "TenantAdmin,PlatformAdmin")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITenantAdminService TenantAdminService
@inject IAuditLogService AuditLogService
@inject ILegacySyncService LegacySyncService

<PageTitle>Administración del tenant</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Tenant Admin</p>
        <h1>Administración del tenant</h1>
        <p class="lead">Gestiona companies, usuarios y permisos dentro del tenant activo, sin salir del alcance asignado.</p>
    </div>
    <div class="quick-links">
        @if (isPlatformAdmin)
        {
            <a class="secondary-button link-button" href="/plataforma">Volver a plataforma</a>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
}

@if (!currentTenantId.HasValue)
{
    <div class="empty-state">
        <p>Tu sesión no tiene un tenant activo. Vuelve a iniciar sesión o selecciona una empresa válida.</p>
    </div>
}
else if (currentTenant is null)
{
    <div class="empty-state">
        <p>No se ha podido cargar el tenant activo.</p>
    </div>
}
else
{
    <section class="card-grid">
        <article class="info-card">
            <p class="eyebrow">Tenant activo</p>
            <h2>@currentTenant.Name</h2>
            <p class="muted">@currentTenant.Slug</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">Companies</p>
            <h2>@companies.Count</h2>
            <p class="muted">Empresas operativas dentro del tenant.</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">Usuarios</p>
            <h2>@users.Count</h2>
            <p class="muted">Usuarios con acceso al tenant actual.</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">Actividad</p>
            <h2>@recentAuditLogs.Count</h2>
            <p class="muted">Eventos recientes del tenant.</p>
        </article>
    </section>

    <section class="panel" style="margin-top: 1rem;">
        <h2>Comportamiento de módulos</h2>
        <div class="admin-grid">
            <article class="info-card">
                <p class="eyebrow">CRM / Clientes</p>
                <h2>Ámbito de datos</h2>
                <p class="muted">Decide si el CRM usa una base lógica por company o una base compartida para todo el tenant.</p>
                <label class="field">
                    <span>Modo</span>
                    <InputSelect class="text-input" @bind-Value="crmClientsDataScope">
                        <option value="@TenantModuleDataScopes.Company">Por empresa activa</option>
                        <option value="@TenantModuleDataScopes.TenantShared">Compartido en todo el tenant</option>
                    </InputSelect>
                </label>
                <p class="muted">
                    En modo compartido, el listado y la numeración de clientes pasan a ser tenant-wide.
                    La persistencia física sigue usando el centro legacy de la empresa activa al crear nuevos registros.
                </p>
                <button class="primary-button" type="button" @onclick="SaveCrmClientsScopeAsync">Guardar configuración</button>
            </article>
            <article class="info-card">
                <p class="eyebrow">Ventas / Pedidos</p>
                <h2>Sync legacy</h2>
                <p class="muted">Mientras este módulo esté en convivencia, la fuente de verdad sigue siendo TEX.NET y la web consume una réplica controlada.</p>
                <label class="field">
                    <span>Company</span>
                    <InputSelect class="text-input" @bind-Value="selectedSalesOrdersSyncCompanyId">
                        <option value="">Todas las companies del tenant</option>
                        @foreach (var company in companies)
                        {
                            <option value="@company.Id.ToString()">@company.Name (@company.LegacyCenterCode)</option>
                        }
                    </InputSelect>
                </label>
                <button class="primary-button" type="button" @onclick="RunSalesOrdersSyncAsync" disabled="@isRunningSalesOrdersSync">
                    @(isRunningSalesOrdersSync ? "Sincronizando pedidos..." : "Sincronizar ventas / pedidos")
                </button>
                <div class="list-block" style="margin-top: 1rem;">
                    @foreach (var status in salesOrdersSyncStatuses)
                    {
                        <article class="list-item">
                            <strong>@status.CompanyName (@status.CompanyLegacyCenterCode)</strong>
                            <span>@(string.IsNullOrWhiteSpace(status.LastStatus) ? "Sin sincronizar" : status.LastStatus)</span>
                            <span>@(status.LastCompletedUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "Nunca")</span>
                            <span>Ins: @status.LastInserted · Act: @status.LastUpdated · Omi: @status.LastSkipped · Err: @status.LastErrors</span>
                        </article>
                    }
                </div>
            </article>
            <article class="info-card">
                <p class="eyebrow">CRM / Clientes</p>
                <h2>Sync legacy</h2>
                <p class="muted">Replica clients y adres desde TEX.NET hacia la SaaS local. Mientras esta sync mande, el CRM web queda en solo lectura para esa company.</p>
                <label class="field">
                    <span>Company</span>
                    <InputSelect class="text-input" @bind-Value="selectedCrmClientsSyncCompanyId">
                        <option value="">Todas las companies del tenant</option>
                        @foreach (var company in companies)
                        {
                            <option value="@company.Id.ToString()">@company.Name (@company.LegacyCenterCode)</option>
                        }
                    </InputSelect>
                </label>
                <button class="primary-button" type="button" @onclick="RunCrmClientsSyncAsync" disabled="@isRunningCrmClientsSync">
