@page "/administracion"
@attribute [Authorize(Roles = "TenantAdmin,PlatformAdmin")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITenantAdminService TenantAdminService
@inject IAuditLogService AuditLogService
@inject ILegacySyncService LegacySyncService
@inject AppText T

<PageTitle>@L("Administración del tenant", "Administració del tenant", "Tenant administration")</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("Tenant Admin", "Tenant Admin", "Tenant Admin")</p>
        <h1>@L("Administración del tenant", "Administració del tenant", "Tenant administration")</h1>
        <p class="lead">@L("Gestiona companies, usuarios y permisos dentro del tenant activo, sin salir del alcance asignado.", "Gestiona empreses, usuaris i permisos dins del tenant actiu, sense sortir de l'abast assignat.", "Manage companies, users and permissions within the active tenant without leaving the assigned scope.")</p>
    </div>
    <div class="quick-links">
        @if (isPlatformAdmin)
        {
            <a class="secondary-button link-button" href="/plataforma">@L("Volver a plataforma", "Tornar a plataforma", "Back to platform")</a>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
}

@if (!currentTenantId.HasValue)
{
    <div class="empty-state">
        <p>@L("Tu sesión no tiene un tenant activo. Vuelve a iniciar sesión o selecciona una empresa válida.", "La teva sessió no té cap tenant actiu. Torna a iniciar sessió o selecciona una empresa vàlida.", "Your session does not have an active tenant. Sign in again or select a valid company.")</p>
    </div>
}
else if (currentTenant is null)
{
    <div class="empty-state">
        <p>@L("No se ha podido cargar el tenant activo.", "No s'ha pogut carregar el tenant actiu.", "The active tenant could not be loaded.")</p>
    </div>
}
else
{
    <section class="card-grid">
        <article class="info-card">
            <p class="eyebrow">@L("Tenant activo", "Tenant actiu", "Active tenant")</p>
            <h2>@currentTenant.Name</h2>
            <p class="muted">@currentTenant.Slug</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Empresas", "Empreses", "Companies")</p>
            <h2>@companies.Count</h2>
            <p class="muted">@L("Empresas operativas dentro del tenant.", "Empreses operatives dins del tenant.", "Operating companies within the tenant.")</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Usuarios", "Usuaris", "Users")</p>
            <h2>@users.Count</h2>
            <p class="muted">@L("Usuarios con acceso al tenant actual.", "Usuaris amb accés al tenant actual.", "Users with access to the current tenant.")</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Actividad", "Activitat", "Activity")</p>
            <h2>@recentAuditLogs.Count</h2>
            <p class="muted">@L("Eventos recientes del tenant.", "Esdeveniments recents del tenant.", "Recent tenant events.")</p>
        </article>
    </section>

    <section class="panel" style="margin-top: 1rem;">
        <h2>@L("Comportamiento de módulos", "Comportament de mòduls", "Module behavior")</h2>
        <div class="admin-grid">
            <article class="info-card">
                <p class="eyebrow">@L("CRM / Clientes", "CRM / Clients", "CRM / Clients")</p>
                <h2>@L("Ámbito de datos", "Àmbit de dades", "Data scope")</h2>
                <p class="muted">@L("Decide si el CRM usa una base lógica por company o una base compartida para todo el tenant.", "Decideix si el CRM fa servir una base lògica per empresa o una base compartida per a tot el tenant.", "Choose whether CRM uses a logical database per company or a shared database across the tenant.")</p>
                <label class="field">
                    <span>@L("Modo", "Mode", "Mode")</span>
                    <InputSelect class="text-input" @bind-Value="crmClientsDataScope">
                        <option value="@TenantModuleDataScopes.Company">@L("Por empresa activa", "Per empresa activa", "Per active company")</option>
                        <option value="@TenantModuleDataScopes.TenantShared">@L("Compartido en todo el tenant", "Compartit a tot el tenant", "Shared across the tenant")</option>
                    </InputSelect>
                </label>
                <p class="muted">
                    @L("En modo compartido, el listado y la numeración de clientes pasan a ser tenant-wide.", "En mode compartit, el llistat i la numeració de clients passen a ser tenant-wide.", "In shared mode, client listing and numbering become tenant-wide.")
                    @L("La persistencia física sigue usando el centro legacy de la empresa activa al crear nuevos registros.", "La persistència física continua fent servir el centre legacy de l'empresa activa en crear nous registres.", "Physical persistence still uses the active company's legacy center when creating new records.")
                </p>
                <button class="primary-button" type="button" @onclick="SaveCrmClientsScopeAsync">@L("Guardar configuración", "Desar configuració", "Save settings")</button>
            </article>
            <article class="info-card">
                <p class="eyebrow">@L("Ventas / Pedidos", "Vendes / Comandes", "Sales / Orders")</p>
                <h2>@LegacySyncLabel</h2>
                <p class="muted">@L("Mientras este módulo esté en convivencia, la fuente de verdad sigue siendo TEX.NET y la web consume una réplica controlada.", "Mentre aquest mòdul estigui en convivència, la font de veritat continua sent TEX.NET i la web consumeix una rèplica controlada.", "While this module runs alongside legacy, TEX.NET remains the source of truth and the web consumes a controlled replica.")</p>
                <label class="field">
                    <span>@L("Empresa", "Empresa", "Company")</span>
                    <InputSelect class="text-input" @bind-Value="selectedSalesOrdersSyncCompanyId">
                        <option value="">@L("Todas las empresas del tenant", "Totes les empreses del tenant", "All tenant companies")</option>
                        @foreach (var company in companies)
                        {
                            <option value="@company.Id.ToString()">@company.Name (@company.LegacyCenterCode)</option>
                        }
                    </InputSelect>
                </label>
                <button class="primary-button" type="button" @onclick="RunSalesOrdersSyncAsync" disabled="@isRunningSalesOrdersSync">
                    @(isRunningSalesOrdersSync
                        ? L("Sincronizando pedidos...", "Sincronitzant comandes...", "Syncing orders...")
                        : L("Sincronizar ventas / pedidos", "Sincronitzar vendes / comandes", "Sync sales / orders"))
                </button>
                <div class="list-block" style="margin-top: 1rem;">
                    @foreach (var status in salesOrdersSyncStatuses)
                    {
                        <article class="list-item">
                            <strong>@status.CompanyName (@status.CompanyLegacyCenterCode)</strong>
                            <span>@(string.IsNullOrWhiteSpace(status.LastStatus) ? L("Sin sincronizar", "Sense sincronitzar", "Not synced") : status.LastStatus)</span>
                            <span>@(status.LastCompletedUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? L("Nunca", "Mai", "Never"))</span>
                            <span>@FormatSyncCounters(status)</span>
                        </article>
                    }
                </div>
            </article>
            <article class="info-card">
                <p class="eyebrow">@L("CRM / Clientes", "CRM / Clients", "CRM / Clients")</p>
                <h2>@LegacySyncLabel</h2>
                <p class="muted">@L("Replica clientes y direcciones desde TEX.NET hacia la SaaS local. La sync manual refresca solo registros con origen legacy y deja intactos los cambios locales.", "Replica clients i adreces des de TEX.NET cap a la SaaS local. La sync manual refresca només els registres amb origen legacy i deixa intactes els canvis locals.", "Replicates clients and addresses from TEX.NET into the local SaaS. Manual sync refreshes only legacy-origin records and leaves local changes untouched.")</p>
                <label class="field">
                    <span>@CompanyLabel</span>
                    <InputSelect class="text-input" @bind-Value="selectedCrmClientsSyncCompanyId">
                        <option value="">@AllTenantCompaniesLabel</option>
                        @foreach (var company in companies)
                        {
                            <option value="@company.Id.ToString()">@company.Name (@company.LegacyCenterCode)</option>
                        }
                    </InputSelect>
                </label>
