@page "/articulos/fornituras/nueva"
@page "/articulos/fornituras/editar/{Code}"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuditLogService AuditLogService
@inject ILegacySyncService LegacySyncService
@inject IFornituraQueries FornituraQueries
@inject IFornituraService FornituraService
@inject NavigationManager NavigationManager
@inject AppText T

<PageTitle>@(HasExistingRecord ? L($"Editar fornitura {CurrentCode}", $"Editar fornitura {CurrentCode}", $"Edit trim {CurrentCode}") : L("Nueva fornitura", "Nova fornitura", "New trim"))</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@T["menu.articles"]</p>
        <h1>@(HasExistingRecord ? L($"Editar fornitura {CurrentCode}", $"Editar fornitura {CurrentCode}", $"Edit trim {CurrentCode}") : L("Nueva fornitura", "Nova fornitura", "New trim"))</h1>
        <p class="lead">@(isLegacySyncActive
            ? L("Edición sobre la SaaS local. La importación manual desde legacy refresca solo registros marcados como legacy.", "Edició sobre la SaaS local. La importació manual des de legacy refresca només registres marcats com legacy.", "Editing on the local SaaS. Manual legacy import refreshes only records marked as legacy.")
            : L("Alta y edición sobre la tabla forni replicada en la SaaS local, filtrada por la empresa activa.", "Alta i edició sobre la taula forni replicada a la SaaS local, filtrada per l'empresa activa.", "Create and edit records on the forni table replicated into the local SaaS, filtered by the active company."))</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="/articulos/fornituras">@L("Volver al listado", "Tornar al llistat", "Back to list")</a>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "No active company is selected.")</p>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
    }

    @if (isLegacySyncActive)
    {
        <div class="alert">
            @L("Artículos / Fornituras está en convivencia con legacy para esta empresa. Esta ficha guarda cambios solo en la SaaS local y la sync manual refresca únicamente registros de origen legacy.", "Articles / Fornitures està en convivència amb legacy per a aquesta empresa. Aquesta fitxa desa canvis només a la SaaS local i la sync manual refresca únicament registres d'origen legacy.", "Articles / Trims is running in legacy coexistence mode for this company. This record saves changes only to the local SaaS and manual sync refreshes legacy-origin records only.")
            @if (!string.IsNullOrWhiteSpace(syncStatusLabel))
            {
                <span>@syncStatusLabel</span>
            }
        </div>
    }

    @if (!canEdit && !HasExistingRecord)
    {
        <div class="alert">
            @L("No tienes permisos de edición para crear fornituras nuevas en esta empresa.", "No tens permisos d'edició per crear fornitures noves en aquesta empresa.", "You do not have edit permissions to create new trims in this company.")
        </div>
    }

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <fieldset disabled="@isReadOnly">
            <div class="form-grid">
                <label class="field">
                    <span>@L("Código", "Codi", "Code")</span>
                    <InputText class="text-input" @bind-Value="model.Code" disabled="@HasExistingRecord" />
                </label>
                <label class="field wide">
                    <span>@L("Descripción", "Descripció", "Description")</span>
                    <InputText class="text-input" @bind-Value="model.Description" />
                </label>
                <label class="field">
                    <span>@L("Precio", "Preu", "Price")</span>
                    <InputNumber class="text-input" @bind-Value="model.UnitPrice" />
                </label>
                <label class="field">
                    <span>@L("Proveedor", "Proveïdor", "Supplier")</span>
                    <InputNumber class="text-input" @bind-Value="model.SupplierCode" />
                </label>
                <label class="field">
                    <span>@L("Referencia proveedor", "Referència proveïdor", "Supplier reference")</span>
                    <InputText class="text-input" @bind-Value="model.SupplierReference" />
                </label>
                <label class="field">
                    <span>@L("Cliente", "Client", "Client")</span>
                    <InputNumber class="text-input" @bind-Value="model.ClientCode" />
                </label>
                <label class="field">
                    <span>@L("Modelo", "Model", "Model")</span>
                    <InputText class="text-input" @bind-Value="model.Model" />
                </label>
                <label class="field">
                    <span>@L("Serie", "Sèrie", "Series")</span>
                    <InputText class="text-input" @bind-Value="model.Series" />
                </label>
                <label class="field">
                    <span>@L("Temporada", "Temporada", "Season")</span>
                    <InputText class="text-input" @bind-Value="model.Season" />
                </label>
            </div>

            <section class="panel detail-panel" style="margin-top: 1rem;">
                <div class="detail-panel-header">
                    <div>
                        <h2>@L("Detalle de la fornitura", "Detall de la fornitura", "Trim detail")</h2>
                        <p class="muted">@L("Código proveedor, color, medida, precio y stock actual por variante.", "Codi proveïdor, color, mida, preu i estoc actual per variant.", "Supplier code, color, size, price and current stock by variant.")</p>
                    </div>
                    @if (!isReadOnly)
                    {
                        <button class="secondary-button" type="button" @onclick="AddVariant">@L("Añadir línea", "Afegir línia", "Add line")</button>
                    }
                </div>

                <div class="table-scroll">
                    <table class="data-table detail-table fornitura-variants-table">
                        <thead>
                            <tr>
                                <th>@L("Código proveedor", "Codi proveïdor", "Supplier code")</th>
                                <th>@L("Color", "Color", "Color")</th>
                                <th>@L("Medida", "Mesura", "Size")</th>
                                <th>@L("Precio", "Preu", "Price")</th>
                                <th>@L("Stock actual", "Estoc actual", "Current stock")</th>
                                <th>@L("Stock mínimo", "Estoc mínim", "Minimum stock")</th>
                                <th>@L("Coste", "Cost", "Cost")</th>
                                @if (!isReadOnly)
                                {
                                    <th></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (model.Variants.Count == 0)
                            {
                                <tr>
                                    <td colspan="@(isReadOnly ? 7 : 8)" class="muted">@L("No hay detalle cargado para esta fornitura.", "No hi ha detall carregat per a aquesta fornitura.", "There is no detail loaded for this trim.")</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var variant in model.Variants.OrderBy(item => item.LineNumber))
                                {
                                    <tr @key="variant.LineNumber">
                                        <td>
                                            <InputText class="text-input table-input" @bind-Value="variant.SupplierItemCode" />
                                        </td>
                                        <td>
                                            <InputText class="text-input table-input" @bind-Value="variant.Color" />
                                        </td>
                                        <td>
                                            <InputText class="text-input table-input" @bind-Value="variant.Measure" />
                                        </td>
                                        <td>
                                            <InputNumber class="text-input table-input" @bind-Value="variant.UnitPrice" />
                                        </td>
                                        <td>
                                            <InputNumber class="text-input table-input" @bind-Value="variant.CurrentStock" />
                                        </td>
                                        <td>
                                            <InputNumber class="text-input table-input" @bind-Value="variant.MinimumStock" />
                                        </td>
                                        <td>
                                            <InputNumber class="text-input table-input" @bind-Value="variant.CostPrice" />
                                        </td>
                                        @if (!isReadOnly)
                                        {
                                            <td>
                                                <button class="danger-link" type="button" @onclick="() => RemoveVariant(variant.LineNumber)">@L("Quitar", "Treure", "Remove")</button>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <div class="quick-links" style="margin-top: 1rem;">
                @if (canEdit)
                {
                    <button class="primary-button" type="submit">@L("Guardar fornitura", "Desar fornitura", "Save trim")</button>
                }
                @if (canEdit && HasExistingRecord)
                {
                    <button class="secondary-button danger-button" type="button" @onclick="DeleteAsync">@L("Eliminar fornitura", "Eliminar fornitura", "Delete trim")</button>
                }
                @if (HasExistingRecord)
                {
                    <button class="secondary-button" type="button" @onclick="LoadAuditAsync">@L("Recargar historial", "Recarregar historial", "Reload history")</button>
                }
            </div>
        </fieldset>
    </EditForm>

    @if (HasExistingRecord)
    {
        <section class="panel" style="margin-top: 1rem;">
            <h2>@L("Historial reciente de la fornitura", "Historial recent de la fornitura", "Recent trim history")</h2>
            <div class="list-block">
                @if (recentAuditLogs.Count == 0)
                {
                    <p class="muted">@L("Todavía no hay eventos auditados para esta fornitura.", "Encara no hi ha esdeveniments auditats per a aquesta fornitura.", "There are no audited events for this trim yet.")</p>
                }
                else
                {
                    @foreach (var entry in recentAuditLogs)
                    {
                        <article class="list-item">
                            <strong>@entry.Action</strong>
                            @if (!string.IsNullOrWhiteSpace(entry.Details))
                            {
                                <span>@entry.Details</span>
                            }
                            <span>@entry.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </article>
                    }
                }
            </div>
        </section>
    }
}

@code {
    [Parameter]
    public string? Code { get; set; }

    private bool IsNewRoute => EditRouteMode.IsCreateRoute(NavigationManager, "articulos/fornituras/nueva");
    private bool HasExistingRecord => !IsNewRoute && !string.IsNullOrWhiteSpace(Code);
    private string CurrentCode => HasExistingRecord ? Uri.UnescapeDataString(Code!) : string.Empty;
    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isReadOnly;
    private FornituraDetailDto model = new();
    private string statusMessage = string.Empty;
    private bool isError;
    private bool isLegacySyncActive;
    private string syncStatusLabel = string.Empty;
    private IReadOnlyCollection<AuditLogEntryDto> recentAuditLogs = [];

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        await LoadSyncStatusAsync();
        isReadOnly = !canEdit;

        if (HasExistingRecord)
        {
            var detail = await FornituraQueries.GetByCodeAsync(tenantId.Value, companyId.Value, CurrentCode);
            if (detail is null)
            {
                statusMessage = L("No se ha encontrado la fornitura solicitada.", "No s'ha trobat la fornitura sol·licitada.", "The requested trim was not found.");
                isError = true;
                model = new FornituraDetailDto();
                recentAuditLogs = [];
                return;
            }

            model = detail;
            await LoadAuditAsync();
        }
        else
        {
            model = new FornituraDetailDto();
            recentAuditLogs = [];
        }
    }

    private async Task SaveAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        if (isReadOnly)
        {
            statusMessage = L("No tienes permisos de edición en este tenant.", "No tens permisos d'edició en aquest tenant.", "You do not have edit permissions in this tenant.");
            isError = true;
            return;
        }

        try
        {
            statusMessage = string.Empty;
            isError = false;
            var isNew = !HasExistingRecord;

            var savedCode = await FornituraService.SaveAsync(new SaveFornituraCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                IsNew = isNew,
                Code = isNew ? model.Code : CurrentCode,
                Description = model.Description,
                UnitPrice = model.UnitPrice,
                SupplierCode = model.SupplierCode,
                SupplierReference = model.SupplierReference,
                ClientCode = model.ClientCode,
                Model = model.Model,
                Series = model.Series,
                Season = model.Season,
                Variants = model.Variants
                    .OrderBy(item => item.LineNumber)
                    .Select(item => new SaveFornituraVariantInput
                    {
                        LineNumber = item.LineNumber,
                        SupplierCode = item.SupplierCode,
                        SupplierItemCode = item.SupplierItemCode,
                        Color = item.Color,
                        Measure = item.Measure,
                        UnitPrice = item.UnitPrice,
                        CurrentStock = item.CurrentStock,
                        MinimumStock = item.MinimumStock,
                        CostPrice = item.CostPrice
                    })
                    .ToList()
            });

            statusMessage = !isNew
                ? L("Fornitura actualizada correctamente.", "Fornitura actualitzada correctament.", "Trim updated successfully.")
                : L("Fornitura creada correctamente.", "Fornitura creada correctament.", "Trim created successfully.");

            if (isNew)
            {
                NavigationManager.NavigateTo($"/articulos/fornituras/editar/{Uri.EscapeDataString(savedCode)}", forceLoad: false);
                return;
            }

            await LoadAuditAsync();
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private async Task LoadSyncStatusAsync()
    {
        isLegacySyncActive = false;
        syncStatusLabel = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var status = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
            .FirstOrDefault(item =>
                item.CompanyId == companyId.Value &&
                string.Equals(item.ModuleKey, LegacySyncModuleKeys.ArticleFornituras, StringComparison.OrdinalIgnoreCase));

        if (status is null || !status.HasSuccessfulSync)
        {
            return;
        }

        isLegacySyncActive = true;
        syncStatusLabel = status.LastCompletedUtc.HasValue
            ? $"{L("Última sync", "Última sync", "Last sync")}: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Act: {status.LastUpdated} · Omi: {status.LastSkipped} · Err: {status.LastErrors}"
            : $"{L("Estado", "Estat", "Status")}: {status.LastStatus}";
    }

    private async Task LoadAuditAsync()
    {
        if (!tenantId.HasValue || !HasExistingRecord)
        {
            recentAuditLogs = [];
            return;
        }

        recentAuditLogs = await AuditLogService.GetRecentAsync(
            limit: 15,
            tenantId: tenantId.Value,
            entityName: "Fornitura",
            entityId: CurrentCode);
    }

    private void AddVariant()
    {
        var nextLineNumber = model.Variants.Count == 0
            ? 1
            : model.Variants.Max(item => item.LineNumber) + 1;

        model.Variants.Add(new FornituraVariantDto
        {
            LineNumber = nextLineNumber
        });
    }

    private void RemoveVariant(int lineNumber)
    {
        var variant = model.Variants.FirstOrDefault(item => item.LineNumber == lineNumber);
        if (variant is null)
        {
            return;
        }

        model.Variants.Remove(variant);
        for (var index = 0; index < model.Variants.Count; index++)
        {
            model.Variants[index].LineNumber = index + 1;
        }
    }

    private async Task DeleteAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !HasExistingRecord)
        {
            return;
        }

        if (!canEdit)
        {
            statusMessage = L("No tienes permisos de edición en este tenant.", "No tens permisos d'edició en aquest tenant.", "You do not have edit permissions in this tenant.");
            isError = true;
            return;
        }

        try
        {
            await FornituraService.DeleteAsync(tenantId.Value, companyId.Value, CurrentCode);
            NavigationManager.NavigateTo("/articulos/fornituras", forceLoad: false);
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };
}
