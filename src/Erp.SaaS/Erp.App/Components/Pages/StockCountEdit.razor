@page "/almacen/inventarios/nuevo"
@page "/almacen/inventarios/editar/{CountNumber:int}"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IStockQueries StockQueries
@inject IStockService StockService
@inject AppText T

<PageTitle>@(CountNumber.HasValue ? $"{L("Inventario", "Inventari", "Stock count")} {CountNumber}" : L("Nuevo inventario", "Nou inventari", "New stock count"))</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("Almacén", "Magatzem", "Warehouse")</p>
        <h1>@(CountNumber.HasValue ? $"{L("Inventario", "Inventari", "Stock count")} {CountNumber}" : L("Nuevo inventario", "Nou inventari", "New stock count"))</h1>
        <p class="lead">@L("Conteo por almacén con comparación entre stock esperado y contado, y ajuste automático al completar.", "Recompte per magatzem amb comparació entre l'estoc esperat i el comptat, i ajust automàtic en completar.", "Warehouse count comparing expected and counted stock, with automatic adjustment on completion.")</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="/almacen/inventarios">@L("Volver al listado", "Tornar al llistat", "Back to list")</a>
        <a class="secondary-button link-button" href="/almacen/stock-actual">@L("Ver stock actual", "Veure estoc actual", "View current stock")</a>
        <a class="secondary-button link-button" href="/almacen/movimientos">@L("Ver movimientos", "Veure moviments", "View movements")</a>
        @if (CountNumber.HasValue)
        {
            <a class="secondary-button link-button" href="/almacen/inventarios/@CountNumber.Value/imprimir">@L("Imprimir ficha", "Imprimir fitxa", "Print sheet")</a>
            <a class="secondary-button link-button" href="/almacen/inventarios/@CountNumber.Value/imprimir-recuento">@L("Hoja de recuento", "Full de recompte", "Count worksheet")</a>
        }
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p>
    </div>
}
else if (!canEdit && !CountNumber.HasValue)
{
    <div class="empty-state">
        <p>@L("No tienes permisos para crear inventarios.", "No tens permisos per crear inventaris.", "You do not have permission to create stock counts.")</p>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
    }

    <section class="card-grid">
        <article class="info-card">
            <p class="eyebrow">@L("Número", "Número", "Number")</p>
            <h2>@DisplayNumber</h2>
            <p class="muted">@L("Identificador interno del inventario.", "Identificador intern de l'inventari.", "Internal stock count identifier.")</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Estado", "Estat", "Status")</p>
            <h2>@FormatStatus(model.Status)</h2>
            <p class="muted">@L("Borrador editable o inventario completado con movimientos generados.", "Esborrany editable o inventari completat amb moviments generats.", "Editable draft or completed count with generated movements.")</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Líneas", "Línies", "Lines")</p>
            <h2>@model.Lines.Count</h2>
            <p class="muted">@L("Artículos incluidos en el conteo.", "Articles inclosos al recompte.", "Items included in the count.")</p>
        </article>
        <article class="info-card accent-card">
            <p class="eyebrow">@L("Diferencia neta", "Diferència neta", "Net difference")</p>
            <h2>@(IsBlindHidden ? L("Oculta", "Oculta", "Hidden") : model.Lines.Sum(GetDifference).ToUiString("0.###"))</h2>
            <p class="muted">@(IsBlindHidden ? L("El esperado sigue oculto hasta la validación.", "L'esperat continua ocult fins a la validació.", "Expected stock remains hidden until validation.") : L("Resultado entre stock esperado y contado.", "Resultat entre l'estoc esperat i el comptat.", "Result between expected and counted stock."))</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Modo", "Mode", "Mode")</p>
            <h2>@(model.IsBlindCount ? L("Conteo ciego", "Recompte cec", "Blind count") : L("Conteo normal", "Recompte normal", "Normal count"))</h2>
            <p class="muted">
                @(model.IsBlindCount
                    ? (model.IsBlindCountRevealed ? L("Esperado ya visible para validar.", "L'esperat ja és visible per validar.", "Expected stock is now visible for validation.") : L("Esperado oculto hasta revelar.", "L'esperat està ocult fins que es reveli.", "Expected stock is hidden until revealed."))
                    : L("El esperado está visible durante todo el conteo.", "L'esperat és visible durant tot el recompte.", "Expected stock stays visible during the whole count."))
            </p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Dif. validadas", "Dif. validades", "Validated diffs.")</p>
            <h2>@(IsBlindHidden ? "-" : $"{ValidatedDifferenceLinesCount} / {DifferenceLinesCount}")</h2>
            <p class="muted">@(IsBlindHidden ? L("Se habilitan al revelar el esperado.", "S'habiliten en revelar l'esperat.", "They become available when expected stock is revealed.") : L("Líneas con diferencia ya revisadas.", "Línies amb diferència ja revisades.", "Difference lines already reviewed."))</p>
        </article>
    </section>

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <fieldset disabled="@isReadOnly">
            <div class="form-grid" style="margin-top: 1rem;">
                <label class="field">
                    <span>@L("Fecha", "Data", "Date")</span>
                    <InputDate class="text-input" @bind-Value="model.CountDate" />
                </label>
                <label class="field">
                    <span>@L("Estado", "Estat", "Status")</span>
                    <InputSelect class="text-input" @bind-Value="model.Status">
                        @foreach (var status in StockCountStatuses.All)
                        {
                            <option value="@status">@FormatStatus(status)</option>
                        }
                    </InputSelect>
                </label>
                <label class="field">
                    <span>@L("Almacén", "Magatzem", "Warehouse")</span>
                    <InputText class="text-input" @bind-Value="model.Warehouse" />
                </label>
                <label class="field">
                    <span>@L("Conteo ciego", "Recompte cec", "Blind count")</span>
                    <InputCheckbox @bind-Value="model.IsBlindCount" />
                </label>
                <label class="field wide">
                    <span>@L("Notas", "Notes", "Notes")</span>
                    <InputTextArea class="text-area" @bind-Value="model.Notes" />
                </label>
            </div>

            @if (!isReadOnly && model.IsBlindCount)
            {
                <div class="quick-links" style="margin-top: 1rem;">
                    @if (!model.IsBlindCountRevealed)
                    {
                        <button class="secondary-button" type="button" @onclick="RevealBlindCount">@L("Mostrar esperado para validación", "Mostrar esperat per a la validació", "Show expected stock for validation")</button>
                    }
                    else
                    {
                        <span class="muted">@L("El stock esperado ya está visible para revisar diferencias.", "L'estoc esperat ja és visible per revisar diferències.", "Expected stock is already visible so you can review differences.")</span>
                    }
                </div>
            }

            @if (!isReadOnly)
            {
                <section class="panel" style="margin-top: 1rem;">
                    <div class="detail-panel-header">
                        <div>
                            <h2>@L("Conteo parcial", "Recompte parcial", "Partial count")</h2>
                            <p class="muted">@L("Limita la recarga del stock actual a un artículo, descripción o color concretos.", "Limita la recàrrega de l'estoc actual a un article, descripció o color concrets.", "Limit the current stock reload to a specific item, description or color.")</p>
                        </div>
                    </div>
                    <div class="form-grid">
                        <label class="field">
                            <span>@L("Artículo", "Article", "Item")</span>
                            <InputText class="text-input" @bind-Value="seedItemCode" />
                        </label>
                        <label class="field">
                            <span>@L("Descripción contiene", "La descripció conté", "Description contains")</span>
                            <InputText class="text-input" @bind-Value="seedDescription" />
                        </label>
                        <label class="field">
                            <span>@L("Color contiene", "El color conté", "Color contains")</span>
                            <InputText class="text-input" @bind-Value="seedColor" />
                        </label>
                    </div>
                </section>

                <section class="panel" style="margin-top: 1rem;">
                    <div class="detail-panel-header">
                        <div>
                            <h2>@L("Cierre por familia / almacén", "Tancament per família / magatzem", "Close by family / warehouse")</h2>
                            <p class="muted">@L("Agrupa por familia calculada del artículo y valida diferencias de forma masiva antes de completar.", "Agrupa per família calculada de l'article i valida diferències de manera massiva abans de completar.", "Group by calculated item family and validate differences in bulk before completion.")</p>
                        </div>
                        @if (!IsBlindHidden)
                        {
                            <div class="quick-links">
                                <button class="secondary-button" type="button" @onclick="ValidateVisibleDifferences">@L("Validar visibles", "Validar visibles", "Validate visible")</button>
                                <button class="secondary-button" type="button" @onclick="ValidateAllDifferences">@L("Validar todo", "Validar-ho tot", "Validate all")</button>
                                <button class="secondary-button" type="button" @onclick="ClearVisibleValidations">@L("Quitar validación visibles", "Treure validació visibles", "Clear visible validation")</button>
                            </div>
                        }
                    </div>

                    @if (IsBlindHidden)
                    {
                        <div class="alert warning">
                            @L("El conteo es ciego. Revela el stock esperado para activar la validación masiva de diferencias por familia.", "El recompte és cec. Revela l'estoc esperat per activar la validació massiva de diferències per família.", "This is a blind count. Reveal expected stock to enable bulk validation of family differences.")
                        </div>
                    }
                    else
                    {
                        <div class="form-grid">
                            <label class="field">
                                <span>@L("Familia activa", "Família activa", "Active family")</span>
                                <InputSelect class="text-input" @bind-Value="activeFamilyFilter">
                                    <option value="">@L("Todas las familias", "Totes les famílies", "All families")</option>
                                    @foreach (var summary in FamilySummaries)
                                    {
                                        <option value="@summary.FamilyKey">@summary.DisplayName (@summary.LineCount)</option>
                                    }
                                </InputSelect>
                            </label>
                        </div>

                        <div class="table-scroll" style="margin-top: 1rem;">
                            <table class="data-table detail-table">
                                <thead>
                                    <tr>
                                        <th>@L("Familia", "Família", "Family")</th>
                                        <th>@L("Líneas", "Línies", "Lines")</th>
                                        <th>@L("Con diferencia", "Amb diferència", "With difference")</th>
                                        <th>@L("Validadas", "Validades", "Validated")</th>
                                        <th>@L("Diferencia neta", "Diferència neta", "Net difference")</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var summary in FamilySummaries)
                                    {
                                        <tr>
                                            <td>@summary.DisplayName</td>
                                            <td>@summary.LineCount</td>
                                            <td>@summary.DifferenceLineCount</td>
                                            <td>@summary.ValidatedDifferenceLineCount</td>
                                            <td>@summary.DifferenceTotal.ToUiString("0.###")</td>
                                            <td>
                                                <div class="table-actions">
                                                    <button class="secondary-button" type="button" @onclick="() => activeFamilyFilter = summary.FamilyKey">@L("Ver", "Veure", "View")</button>
                                                    <button class="secondary-button" type="button" @onclick="() => ValidateDifferencesForFamily(summary.FamilyKey)">@L("Validar", "Validar", "Validate")</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }

            <section class="panel detail-panel" style="margin-top: 1rem;">
                <div class="detail-panel-header">
                    <div>
                        <h2>@L("Líneas del inventario", "Línies de l'inventari", "Count lines")</h2>
                        <p class="muted">@L("Puedes contar desde cero o recargar el stock actual del almacén seleccionado.", "Pots comptar des de zero o recarregar l'estoc actual del magatzem seleccionat.", "You can count from scratch or reload the current stock of the selected warehouse.")</p>
                    </div>
                    @if (!isReadOnly)
                    {
                        <div class="quick-links">
                            <button class="secondary-button" type="button" @onclick="ReloadSeedLinesAsync">@L("Recargar stock actual", "Recarregar estoc actual", "Reload current stock")</button>
                            <button class="secondary-button" type="button" @onclick="AddLine">@L("Añadir línea", "Afegir línia", "Add line")</button>
                        </div>
                    }
                </div>

                <div class="table-scroll">
                    <table class="data-table detail-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>@L("Familia", "Família", "Family")</th>
                                <th>@L("Artículo", "Article", "Item")</th>
                                <th>@L("Descripción", "Descripció", "Description")</th>
                                <th>@L("Color", "Color", "Color")</th>
                                <th>@L("Esperado", "Esperat", "Expected")</th>
                                <th>@L("Contado", "Comptat", "Counted")</th>
                                <th>@L("Diferencia", "Diferència", "Difference")</th>
                                <th>@L("Validada", "Validada", "Validated")</th>
                                <th>@L("Unidad", "Unitat", "Unit")</th>
                                <th>@L("Notas", "Notes", "Notes")</th>
                                <th>@L("Acciones", "Accions", "Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (VisibleLines.Count == 0)
                            {
                                <tr>
                                    <td colspan="12" class="muted">@L("No hay líneas cargadas para el filtro actual.", "No hi ha línies carregades per al filtre actual.", "There are no lines loaded for the current filter.")</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var line in VisibleLines)
                                {
                                    var difference = GetDifference(line);
                                    <tr @key="line.LineNumber">
                                        <td>@line.LineNumber</td>
                                        <td>@GetFamilyDisplay(line)</td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.ItemCode" /></td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.ItemDescription" /></td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.Color" /></td>
                                        <td>
                                            @if (IsBlindHidden)
                                            {
                                                <span class="muted">@L("Oculto", "Ocult", "Hidden")</span>
                                            }
                                            else
                                            {
                                                <InputNumber class="text-input table-input" @bind-Value="line.ExpectedQuantity" disabled="@isReadOnly" />
                                            }
                                        </td>
                                        <td><InputNumber class="text-input table-input" @bind-Value="line.CountedQuantity" /></td>
                                        <td>
                                            <strong>@(IsBlindHidden ? L("Oculta", "Oculta", "Hidden") : difference.ToUiString("0.###"))</strong>
                                        </td>
                                        <td>
                                            @if (IsBlindHidden)
                                            {
                                                <span class="muted">@L("Pend.", "Pend.", "Pend.")</span>
                                            }
                                            else if (difference == 0m)
                                            {
                                                <span class="muted">@L("OK", "OK", "OK")</span>
                                            }
                                            else
                                            {
                                                <InputCheckbox @bind-Value="line.IsDifferenceValidated" disabled="@isReadOnly" />
                                            }
                                        </td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.UnitOfMeasure" /></td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.Notes" /></td>
                                        <td>
                                            <div class="table-actions">
                                                @if (!string.IsNullOrWhiteSpace(line.ItemDescription))
                                                {
                                                    <a class="inline-link" href="@BuildMovementsUrl(line)">@L("Movs.", "Movs.", "Moves")</a>
                                                }
                                                @if (!isReadOnly)
                                                {
                                                    <button class="secondary-button danger-button" type="button" @onclick="() => RemoveLine(line.LineNumber)">@L("Quitar", "Treure", "Remove")</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            @if (canEdit)
            {
                <div class="quick-links" style="margin-top: 1rem;">
                    <button class="primary-button" type="submit">@L("Guardar", "Desar", "Save")</button>
                    @if (CountNumber.HasValue && !isReadOnly)
                    {
                        <button class="secondary-button danger-button" type="button" @onclick="DeleteAsync">@L("Eliminar", "Eliminar", "Delete")</button>
                    }
                </div>
            }
        </fieldset>
    </EditForm>
}

@code {
    [Parameter]
    public int? CountNumber { get; set; }

    [SupplyParameterFromQuery(Name = "warehouse")]
    public string? Warehouse { get; set; }

    [SupplyParameterFromQuery(Name = "itemCode")]
    public string? ItemCode { get; set; }

    [SupplyParameterFromQuery(Name = "description")]
    public string? Description { get; set; }

    [SupplyParameterFromQuery(Name = "color")]
    public string? Color { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isReadOnly;
    private bool isError;
    private string statusMessage = string.Empty;
    private string? initializedSeedSignature;
    private string activeFamilyFilter = string.Empty;
    private string seedItemCode = string.Empty;
    private string seedDescription = string.Empty;
    private string seedColor = string.Empty;
    private StockCountDetailDto model = new()
    {
        Status = StockCountStatuses.Draft,
        CountDate = DateTime.Today
    };

    private string DisplayNumber => CountNumber?.ToString() ?? L("Nuevo", "Nou", "New");
    private bool IsBlindHidden => model.IsBlindCount && !model.IsBlindCountRevealed;
    private int DifferenceLinesCount => model.Lines.Count(line => GetDifference(line) != 0m);
    private int ValidatedDifferenceLinesCount => model.Lines.Count(line => GetDifference(line) != 0m && line.IsDifferenceValidated);
    private IReadOnlyList<StockCountLineDto> VisibleLines => model.Lines
        .Where(line => string.IsNullOrWhiteSpace(activeFamilyFilter) || string.Equals(GetFamilyKey(line), activeFamilyFilter, StringComparison.OrdinalIgnoreCase))
        .OrderBy(line => line.LineNumber)
        .ToList();
    private IReadOnlyList<FamilySummaryRow> FamilySummaries => model.Lines
        .GroupBy(GetFamilyKey, StringComparer.OrdinalIgnoreCase)
        .OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
        .Select(group => new FamilySummaryRow(
            group.Key,
            group.Key == "NO_FAMILY" ? L("Sin familia", "Sense família", "No family") : group.Key,
            group.Count(),
            group.Count(line => GetDifference(line) != 0m),
            group.Count(line => GetDifference(line) != 0m && line.IsDifferenceValidated),
            group.Sum(GetDifference)))
        .ToList();
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        if (!CountNumber.HasValue)
        {
            seedItemCode = ItemCode?.Trim() ?? seedItemCode;
            seedDescription = Description?.Trim() ?? seedDescription;
            seedColor = Color?.Trim() ?? seedColor;
        }

        if (CountNumber.HasValue)
        {
            var detail = await StockQueries.GetCountByNumberAsync(tenantId.Value, companyId.Value, CountNumber.Value);
            if (detail is null)
            {
                statusMessage = L("No se ha encontrado el inventario solicitado.", "No s'ha trobat l'inventari sol·licitat.", "The requested stock count could not be found.");
                isError = true;
                model = new StockCountDetailDto();
                isReadOnly = true;
                return;
            }

            model = detail;
        }
        else if (!string.Equals(initializedSeedSignature, BuildSeedSignature(), StringComparison.Ordinal))
        {
            await InitializeNewAsync();
        }
        else if (model.Lines.Count == 0)
        {
            AddLine();
        }

        isReadOnly = !canEdit ||
            string.Equals(model.Status, StockCountStatuses.Completed, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(model.Status, StockCountStatuses.Cancelled, StringComparison.OrdinalIgnoreCase);
    }

    private async Task InitializeNewAsync()
    {
        initializedSeedSignature = BuildSeedSignature();
        var warehouse = Warehouse?.Trim() ?? string.Empty;
        model = new StockCountDetailDto
        {
            Status = StockCountStatuses.Draft,
            CountDate = DateTime.Today,
            Warehouse = warehouse
        };

        if (!string.IsNullOrWhiteSpace(warehouse) && tenantId.HasValue && companyId.HasValue)
        {
            var lines = await StockQueries.GetCountSeedLinesAsync(tenantId.Value, companyId.Value, warehouse);
            model.Lines = ApplySeedFilter(lines).ToList();
        }

        if (model.Lines.Count == 0)
        {
            AddLine();
        }
    }

    private async Task ReloadSeedLinesAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        try
        {
            statusMessage = string.Empty;
            isError = false;

            var warehouse = model.Warehouse?.Trim() ?? string.Empty;
            if (string.IsNullOrWhiteSpace(warehouse))
            {
                throw new InvalidOperationException(L("Indica un almacén antes de recargar el stock actual.", "Indica un magatzem abans de recarregar l'estoc actual.", "Specify a warehouse before reloading current stock."));
            }

            var lines = await StockQueries.GetCountSeedLinesAsync(tenantId.Value, companyId.Value, warehouse);
            model.Lines = ApplySeedFilter(lines).ToList();
            if (model.Lines.Count == 0)
            {
                AddLine();
            }

            statusMessage = L("Stock actual recargado correctamente.", "Estoc actual recarregat correctament.", "Current stock reloaded successfully.");
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private IEnumerable<StockCountLineDto> ApplySeedFilter(IEnumerable<StockCountLineDto> lines)
    {
        var filtered = lines;
        if (!string.IsNullOrWhiteSpace(seedItemCode))
        {
            filtered = filtered.Where(line => line.ItemCode.Contains(seedItemCode, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(seedDescription))
        {
            filtered = filtered.Where(line => line.ItemDescription.Contains(seedDescription, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(seedColor))
        {
            filtered = filtered.Where(line => line.Color.Contains(seedColor, StringComparison.OrdinalIgnoreCase));
        }

        return filtered
            .Select((line, index) =>
            {
                line.LineNumber = index + 1;
                line.IsDifferenceValidated = GetDifference(line) == 0m;
                return line;
            })
            .ToArray();
    }

    private void ValidateAllDifferences()
    {
        foreach (var line in model.Lines.Where(line => GetDifference(line) != 0m))
        {
            line.IsDifferenceValidated = true;
        }
    }

    private void RevealBlindCount()
    {
        model.IsBlindCountRevealed = true;
        statusMessage = L("Stock esperado visible. Ya puedes revisar y validar diferencias.", "Estoc esperat visible. Ja pots revisar i validar diferències.", "Expected stock is now visible. You can review and validate differences.");
        isError = false;
    }

    private void ValidateVisibleDifferences() => ValidateDifferencesForFamily(activeFamilyFilter);

    private void ValidateDifferencesForFamily(string? familyKey)
    {
        foreach (var line in model.Lines.Where(line => MatchesFamily(line, familyKey) && GetDifference(line) != 0m))
        {
            line.IsDifferenceValidated = true;
        }
    }

    private void ClearVisibleValidations()
    {
        foreach (var line in model.Lines.Where(line => MatchesFamily(line, activeFamilyFilter) && GetDifference(line) != 0m))
        {
            line.IsDifferenceValidated = false;
        }
    }

    private async Task SaveAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !canEdit)
        {
            return;
        }

        try
        {
            statusMessage = string.Empty;
            isError = false;

            var countNumber = await StockService.SaveCountAsync(new SaveStockCountCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                CountNumber = CountNumber,
                CountDate = model.CountDate,
                Status = model.Status,
                Warehouse = model.Warehouse,
                IsBlindCount = model.IsBlindCount,
                IsBlindCountRevealed = model.IsBlindCountRevealed,
                Notes = model.Notes,
                Lines = model.Lines
                    .OrderBy(line => line.LineNumber)
                    .Select(line => new StockCountLineDto
                    {
                        LineNumber = line.LineNumber,
                        ItemCode = line.ItemCode,
                        ItemDescription = line.ItemDescription,
                        Color = line.Color,
                        ExpectedQuantity = line.ExpectedQuantity,
                        CountedQuantity = line.CountedQuantity,
                        DifferenceQuantity = GetDifference(line),
                        IsDifferenceValidated = GetDifference(line) == 0m || line.IsDifferenceValidated,
                        UnitOfMeasure = line.UnitOfMeasure,
                        Notes = line.Notes
                    })
                    .ToList()
            });

            if (!CountNumber.HasValue)
            {
                NavigationManager.NavigateTo($"/almacen/inventarios/editar/{countNumber}", false);
                return;
            }

            statusMessage = L("Inventario guardado correctamente.", "Inventari desat correctament.", "Stock count saved successfully.");
            var detail = await StockQueries.GetCountByNumberAsync(tenantId.Value, companyId.Value, countNumber);
            if (detail is not null)
            {
                model = detail;
                isReadOnly = string.Equals(model.Status, StockCountStatuses.Completed, StringComparison.OrdinalIgnoreCase) ||
                             string.Equals(model.Status, StockCountStatuses.Cancelled, StringComparison.OrdinalIgnoreCase);
            }
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private async Task DeleteAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !CountNumber.HasValue || !canEdit)
        {
            return;
        }

        try
        {
            await StockService.DeleteCountAsync(tenantId.Value, companyId.Value, CountNumber.Value);
            NavigationManager.NavigateTo("/almacen/inventarios", false);
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private void AddLine()
    {
        var nextNumber = model.Lines.Count == 0 ? 1 : model.Lines.Max(line => line.LineNumber) + 1;
        model.Lines.Add(new StockCountLineDto
        {
            LineNumber = nextNumber,
            UnitOfMeasure = "kg"
        });
    }

    private void RemoveLine(int lineNumber)
    {
        var line = model.Lines.FirstOrDefault(item => item.LineNumber == lineNumber);
        if (line is null)
        {
            return;
        }

        model.Lines.Remove(line);
        var ordered = model.Lines.OrderBy(item => item.LineNumber).ToList();
        for (var index = 0; index < ordered.Count; index++)
        {
            ordered[index].LineNumber = index + 1;
        }
    }

    private string BuildMovementsUrl(StockCountLineDto line)
    {
        var search = string.IsNullOrWhiteSpace(line.Color)
            ? $"{line.ItemCode} {line.ItemDescription}".Trim()
            : $"{line.ItemCode} {line.Color}".Trim();

        return NavigationManager.GetUriWithQueryParameters("/almacen/movimientos", new Dictionary<string, object?>
        {
            ["search"] = string.IsNullOrWhiteSpace(search) ? null : search,
            ["warehouse"] = string.IsNullOrWhiteSpace(model.Warehouse) ? null : model.Warehouse
        });
    }

    private string BuildSeedSignature() =>
        $"{Warehouse?.Trim() ?? string.Empty}\u001f{seedItemCode}\u001f{seedDescription}\u001f{seedColor}";

    private static bool MatchesFamily(StockCountLineDto line, string? familyKey) =>
        string.IsNullOrWhiteSpace(familyKey) || string.Equals(GetFamilyKey(line), familyKey, StringComparison.OrdinalIgnoreCase);

    private static string GetFamilyKey(StockCountLineDto line)
    {
        var code = line.ItemCode?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(code))
        {
            return "NO_FAMILY";
        }

        var separators = new[] { '-', '/', ' ', '_', '.' };
        foreach (var separator in separators)
        {
            var index = code.IndexOf(separator);
            if (index > 0)
            {
                return code[..index].Trim().ToUpperInvariant();
            }
        }

        return (code.Length <= 4 ? code : code[..4]).ToUpperInvariant();
    }

    private static decimal GetDifference(StockCountLineDto line) =>
        decimal.Round(line.CountedQuantity - line.ExpectedQuantity, 3, MidpointRounding.AwayFromZero);

    private string FormatStatus(string status) => status switch
    {
        StockCountStatuses.Draft => L("Borrador", "Esborrany", "Draft"),
        StockCountStatuses.Completed => L("Completado", "Completat", "Completed"),
        StockCountStatuses.Cancelled => L("Anulado", "Anul·lat", "Cancelled"),
        _ => status
    };

    private string GetFamilyDisplay(StockCountLineDto line)
    {
        var familyKey = GetFamilyKey(line);
        return familyKey == "NO_FAMILY"
            ? L("Sin familia", "Sense família", "No family")
            : familyKey;
    }

    private sealed record FamilySummaryRow(
        string FamilyKey,
        string DisplayName,
        int LineCount,
        int DifferenceLineCount,
        int ValidatedDifferenceLineCount,
        decimal DifferenceTotal);
}
