        public IReadOnlyList<StatisticComparisonItemDto> FilterComparisons(IReadOnlyCollection<StatisticComparisonItemDto> items) =>
            slug switch
            {
                "sales" => items.Where(item => item.Label is "Facturación ventas" or "Pendiente cobro").ToArray(),
                "purchases" => items.Where(item => item.Label is "Facturación compras" or "Pendiente pago").ToArray(),
                "production" => items.Where(item => item.Label is "Órdenes vivas").ToArray(),
                "warehouse" => items.Where(item => item.Label is "Movimientos stock").ToArray(),
                _ => []
            };

