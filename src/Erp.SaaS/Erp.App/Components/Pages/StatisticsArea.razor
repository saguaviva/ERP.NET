        private static decimal CalculateRatio(int movements, int positions) =>
            positions <= 0 ? 0m : Math.Round((decimal)movements / positions, 2);

        private static string Localize(AppText text, string spanish, string catalan, string english) =>
            text.CurrentLanguage switch
            {
                AppLanguages.Catalan => catalan,
                AppLanguages.English => english,
                _ => spanish
            };
