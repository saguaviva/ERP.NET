@page "/estadisticas/ventas"
@page "/estadisticas/compras"
@page "/estadisticas/produccion"
@page "/estadisticas/almacen"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IReportingQueries ReportingQueries
@inject AppText T

@using Erp.Application.Reporting
@using System.Globalization

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("Estadísticas", "Estadístiques", "Statistics")</p>
        <h1>@HeaderTitle</h1>
        <p class="lead">@HeaderLead</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="/estadisticas">@L("Volver a estadísticas", "Tornar a estadístiques", "Back to statistics")</a>
        <a class="secondary-button link-button" href="@ReportsRoute">@ReportsLinkLabel</a>
        <a class="secondary-button link-button" href="@ExportCsvHref">@L("Exportar CSV", "Exportar CSV", "Export CSV")</a>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("Selecciona una empresa activa para calcular las estadísticas del área.", "Selecciona una empresa activa per calcular les estadístiques de l'àrea.", "Select an active company to calculate area statistics.")</p>
    </div>
}
else
{
    <section class="panel">
        <div class="filter-row">
            <label class="field compact-field">
                <span>@L("Desde", "Des de", "From")</span>
                <input class="text-input" type="date" @bind="filter.DateFrom" @bind:format="yyyy-MM-dd" disabled="@isLoading" />
            </label>
            <label class="field compact-field">
                <span>@L("Hasta", "Fins a", "To")</span>
                <input class="text-input" type="date" @bind="filter.DateTo" @bind:format="yyyy-MM-dd" disabled="@isLoading" />
            </label>
            <button class="secondary-button" @onclick="LoadAsync" disabled="@isLoading">@(isLoading ? L("Cargando...", "Carregant...", "Loading...") : L("Actualizar", "Actualitzar", "Refresh"))</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }

    @if (isLoading)
    {
        <section class="panel">
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>@LoadingLabel</span>
            </div>
        </section>
    }
    else
    {
        <section class="panel dashboard-section">
            <div class="dashboard-section-header">
                <div>
                    <p class="eyebrow">@PrimaryKicker</p>
                    <h2>@PrimaryTitle</h2>
                    <p class="lead">@PrimaryLead</p>
                </div>
            </div>
            <div class="dashboard-metric-grid">
                @foreach (var card in AreaMetricCards)
                {
                    <article class="@(card.AccentClass)">
                        <span class="dashboard-metric-label">@card.Label</span>
                        <strong class="dashboard-metric-value">@card.Value</strong>
                        <span class="dashboard-metric-description">@card.Description</span>
                    </article>
                }
            </div>
        </section>

        <div class="comparison-grid">
            <section class="panel">
                <p class="eyebrow">@L("Comparativa", "Comparativa", "Comparison")</p>
                <h2>@ComparisonTitle</h2>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@L("Métrica", "Mètrica", "Metric")</th>
                            <th>@L("Actual", "Actual", "Current")</th>
                            <th>@L("Anterior", "Anterior", "Previous")</th>
                            <th>@L("Delta", "Delta", "Delta")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredComparisons.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="table-empty">@L("Sin comparativa para este rango.", "Sense comparativa per a aquest rang.", "No comparison available for this range.")</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in FilteredComparisons)
                            {
                                <tr>
                                    <td>@TranslateComparisonLabel(item.Label)</td>
                                    <td>@FormatComparisonValue(item.CurrentValue, item.ValueKind)</td>
                                    <td>@FormatComparisonValue(item.PreviousValue, item.ValueKind)</td>
                                    <td>@BuildDeltaLabel(item)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <p class="lead">@BuildPreviousRangeLabel()</p>
            </section>

            <section class="panel">
                <p class="eyebrow">@L("Evolución", "Evolució", "Timeline")</p>
                <h2>@TimelineTitle</h2>
                @RenderTimelineTable()
            </section>
        </div>

        <div class="comparison-grid">
            @foreach (var breakdown in AreaBreakdowns)
            {
                <section class="panel">
                    <p class="eyebrow">@breakdown.Kicker</p>
                    <h2>@breakdown.Title</h2>
                    @RenderBreakdownTable(breakdown.Items, breakdown.LabelTitle, breakdown.ShowAmount)
                </section>
            }
        </div>

        @if (area.Slug == "sales")
        {
            <div class="comparison-grid">
                <section class="panel">
                    <p class="eyebrow">@L("Ventas", "Vendes", "Sales")</p>
                    <h2>@L("Concentración y mix por cliente", "Concentració i mix per client", "Customer concentration and mix")</h2>
                    <div class="dashboard-metric-grid">
                        <article class="dashboard-metric-card dashboard-metric-card-info">
                            <span class="dashboard-metric-label">@L("Cliente principal", "Client principal", "Top client")</span>
                            <strong class="dashboard-metric-value">@FormatPercent(stats.SalesTopClientSharePercent)</strong>
                            <span class="dashboard-metric-description">@L("Peso sobre la facturación del rango", "Pes sobre la facturació del rang", "Share of invoicing in range")</span>
                        </article>
                        <article class="dashboard-metric-card dashboard-metric-card-warning">
                            <span class="dashboard-metric-label">@L("Top 5 clientes", "Top 5 clients", "Top 5 clients")</span>
                            <strong class="dashboard-metric-value">@FormatPercent(stats.SalesTop5ClientsSharePercent)</strong>
                            <span class="dashboard-metric-description">@L("Concentración comercial acumulada", "Concentració comercial acumulada", "Accumulated commercial concentration")</span>
                        </article>
                    </div>
                    @RenderDistributionTable(stats.SalesCustomerMix, L("Cliente", "Client", "Client"))
                </section>

                <section class="panel">
                    <p class="eyebrow">@L("Ventas", "Vendes", "Sales")</p>
                    <h2>@L("Mix por artículo", "Mix per article", "Item mix")</h2>
                    @RenderDistributionTable(stats.SalesItemMix, L("Artículo", "Article", "Item"))
                </section>
            </div>

            <div class="comparison-grid">
                <section class="panel">
                    <p class="eyebrow">@L("Dirección", "Direcció", "Executive")</p>
                    <h2>@L("MTD / YTD comercial", "MTD / YTD comercial", "MTD / YTD sales")</h2>
                    <div class="dashboard-metric-grid">
                        <article class="dashboard-metric-card dashboard-metric-card-info">
                            <span class="dashboard-metric-label">@L("Facturado MTD", "Facturat MTD", "Invoiced MTD")</span>
                            <strong class="dashboard-metric-value">@FormatCurrency(stats.SalesInvoiceAmountMonthToDate)</strong>
                            <span class="dashboard-metric-description">@L("Desde el inicio del mes hasta la fecha de corte", "Des de l'inici del mes fins a la data de tall", "From month start to the cutoff date")</span>
                        </article>
                        <article class="dashboard-metric-card dashboard-metric-card-warning">
                            <span class="dashboard-metric-label">@L("Facturado YTD", "Facturat YTD", "Invoiced YTD")</span>
                            <strong class="dashboard-metric-value">@FormatCurrency(stats.SalesInvoiceAmountYearToDate)</strong>
                            <span class="dashboard-metric-description">@L("Desde el inicio del año hasta la fecha de corte", "Des de l'inici de l'any fins a la data de tall", "From year start to the cutoff date")</span>
                        </article>
                    </div>
                </section>

                <section class="panel">
                    <p class="eyebrow">@L("Cobros", "Cobraments", "Collections")</p>
                    <h2>@L("Aging de cobro", "Aging de cobrament", "Receivables aging")</h2>
                    @RenderBreakdownTable(stats.SalesAgingBuckets, L("Bucket", "Bucket", "Bucket"), true)
                </section>

                <section class="panel">
                    <p class="eyebrow">@L("Riesgo", "Risc", "Risk")</p>
                    <h2>@L("Riesgo comercial por cliente", "Risc comercial per client", "Commercial risk by client")</h2>
                    <div class="dashboard-metric-grid">
                        <article class="dashboard-metric-card dashboard-metric-card-info">
                            <span class="dashboard-metric-label">@L("Cliente principal", "Client principal", "Top client")</span>
                            <strong class="dashboard-metric-value">@FormatPercent(stats.SalesOutstandingTopClientSharePercent)</strong>
                            <span class="dashboard-metric-description">@L("Peso sobre el saldo pendiente", "Pes sobre el saldo pendent", "Share of total outstanding exposure")</span>
                        </article>
                        <article class="dashboard-metric-card dashboard-metric-card-warning">
                            <span class="dashboard-metric-label">@L("Top 5 clientes", "Top 5 clients", "Top 5 clients")</span>
                            <strong class="dashboard-metric-value">@FormatPercent(stats.SalesOutstandingTop5ClientsSharePercent)</strong>
                            <span class="dashboard-metric-description">@L("Concentración del saldo pendiente", "Concentració del saldo pendent", "Outstanding balance concentration")</span>
                        </article>
                    </div>
                    @RenderDistributionTable(stats.SalesOutstandingRiskByClient, L("Cliente", "Client", "Client"))
                </section>
            </div>
        }

        @if (area.Slug == "purchases")
        {
            <div class="comparison-grid">
                <section class="panel">
                    <p class="eyebrow">@L("Compras", "Compres", "Purchases")</p>
                    <h2>@L("Aging de pago", "Aging de pagament", "Payables aging")</h2>
                    @RenderBreakdownTable(stats.PurchaseAgingBuckets, L("Bucket", "Bucket", "Bucket"), true)
                </section>

                <section class="panel">
                    <p class="eyebrow">@L("Compras", "Compres", "Purchases")</p>
                    <h2>@L("Recepción vs factura", "Recepció vs factura", "Receipt vs invoice")</h2>
                    @RenderGapTable(stats.PurchaseReceiptInvoiceGaps)
                </section>

                <section class="panel">
                    <p class="eyebrow">@L("Dirección", "Direcció", "Executive")</p>
                    <h2>@L("MTD / YTD compras", "MTD / YTD compres", "MTD / YTD purchases")</h2>
                    <div class="dashboard-metric-grid">
                        <article class="dashboard-metric-card dashboard-metric-card-info">
                            <span class="dashboard-metric-label">@L("Facturado MTD", "Facturat MTD", "Invoiced MTD")</span>
                            <strong class="dashboard-metric-value">@FormatCurrency(stats.PurchaseInvoiceAmountMonthToDate)</strong>
                            <span class="dashboard-metric-description">@L("Desde el inicio del mes hasta la fecha de corte", "Des de l'inici del mes fins a la data de tall", "From month start to the cutoff date")</span>
                        </article>
                        <article class="dashboard-metric-card dashboard-metric-card-warning">
                            <span class="dashboard-metric-label">@L("Facturado YTD", "Facturat YTD", "Invoiced YTD")</span>
                            <strong class="dashboard-metric-value">@FormatCurrency(stats.PurchaseInvoiceAmountYearToDate)</strong>
                            <span class="dashboard-metric-description">@L("Desde el inicio del año hasta la fecha de corte", "Des de l'inici de l'any fins a la data de tall", "From year start to the cutoff date")</span>
                        </article>
                    </div>
                </section>
            </div>
        }

        @if (area.Slug == "production")
        {
            <div class="comparison-grid">
                <section class="panel">
                    <p class="eyebrow">@L("Producción", "Producció", "Production")</p>
                    <h2>@L("Carga por acabador", "Càrrega per acabador", "Load by finisher")</h2>
                    @RenderBreakdownTable(stats.ProductionLoadByFinisher, L("Acabador", "Acabador", "Finisher"), true)
                </section>

                <section class="panel">
                    <p class="eyebrow">@L("Producción", "Producció", "Production")</p>
                    <h2>@L("Carga semanal", "Càrrega setmanal", "Weekly load")</h2>
                    @RenderBreakdownTable(stats.ProductionLoadByWeek, L("Semana", "Setmana", "Week"), true)
                </section>
            </div>
        }

        @if (area.Slug == "warehouse")
        {
            <div class="comparison-grid">
                <section class="panel">
                    <p class="eyebrow">@L("Almacén", "Magatzem", "Warehouse")</p>
                    <h2>@L("Rotación por almacén", "Rotació per magatzem", "Rotation by warehouse")</h2>
                    @RenderBreakdownTable(stats.WarehouseRotationByWarehouse, L("Almacén", "Magatzem", "Warehouse"), true)
                </section>

                <section class="panel">
                    <p class="eyebrow">@L("Almacén", "Magatzem", "Warehouse")</p>
                    <h2>@L("Antigüedad de stock", "Antiguitat d'estoc", "Stock age")</h2>
                    @RenderBreakdownTable(stats.WarehouseStockAgeBuckets, L("Bucket", "Bucket", "Bucket"), true)
                </section>

                <section class="panel">
                    <p class="eyebrow">@L("Almacén", "Magatzem", "Warehouse")</p>
                    <h2>@L("Cobertura de stock", "Cobertura d'estoc", "Stock coverage")</h2>
                    @RenderBreakdownTable(stats.WarehouseCoverageBuckets, L("Bucket", "Bucket", "Bucket"), true)
                </section>
            </div>
        }
    }
}

@code {
    [SupplyParameterFromQuery(Name = "from")]
    public DateTime? FromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public DateTime? ToQuery { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool isLoading;
    private string errorMessage = string.Empty;
    private string? lastLoadKey;
    private BusinessStatisticsFilter filter = new() { DateFrom = DateTime.Today.AddDays(-30), DateTo = DateTime.Today };
    private BusinessStatisticsDto stats = new();
    private AreaDefinition area = AreaDefinition.Empty;

    private string PageTitleText => area.Localize(T, "pageTitle");
    private string HeaderTitle => area.Localize(T, "title");
    private string HeaderLead => area.Localize(T, "lead");
    private string ReportsRoute => area.ReportsRoute;
    private string ReportsLinkLabel => area.Localize(T, "reportsLink");
    private string LoadingLabel => area.Localize(T, "loadingLabel");
    private string PrimaryKicker => area.Localize(T, "primaryKicker");
    private string PrimaryTitle => area.Localize(T, "primaryTitle");
    private string PrimaryLead => area.Localize(T, "primaryLead");
    private string ComparisonTitle => area.Localize(T, "comparisonTitle");
    private string TimelineTitle => area.Localize(T, "timelineTitle");
    private string ExportCsvHref => NavigationManager.GetUriWithQueryParameters("/estadisticas/export/csv", new Dictionary<string, object?>
    {
        ["from"] = filter.DateFrom?.ToString("yyyy-MM-dd"),
        ["to"] = filter.DateTo?.ToString("yyyy-MM-dd"),
        ["area"] = area.Slug
    });
    private IReadOnlyList<MetricCard> AreaMetricCards => area.BuildMetricCards(T, stats);
    private IReadOnlyList<BreakdownDefinition> AreaBreakdowns => area.BuildBreakdowns(T, stats);
    private IReadOnlyList<StatisticComparisonItemDto> FilteredComparisons => area.FilterComparisons(stats.PeriodComparisons);

    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
    }

    protected override async Task OnParametersSetAsync()
    {
        area = AreaDefinition.FromRoute(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        var loadKey = string.Join("|",
            area.StatisticsRoute,
            FromQuery?.ToString("yyyy-MM-dd") ?? string.Empty,
            ToQuery?.ToString("yyyy-MM-dd") ?? string.Empty,
            tenantId?.ToString() ?? string.Empty,
            companyId?.ToString() ?? string.Empty);

        if (string.Equals(loadKey, lastLoadKey, StringComparison.Ordinal))
        {
            return;
        }

        filter.DateFrom = FromQuery ?? DateTime.Today.AddDays(-30);
        filter.DateTo = ToQuery ?? DateTime.Today;
        lastLoadKey = loadKey;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            stats = await ReportingQueries.GetBusinessStatisticsAsync(tenantId.Value, companyId.Value, filter);
            var target = NavigationManager.GetUriWithQueryParameters(area.StatisticsRoute, new Dictionary<string, object?>
            {
                ["from"] = filter.DateFrom?.ToString("yyyy-MM-dd"),
                ["to"] = filter.DateTo?.ToString("yyyy-MM-dd")
            });
            if (!string.Equals(target, NavigationManager.Uri, StringComparison.Ordinal))
            {
                NavigationManager.NavigateTo(target, replace: true);
            }
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            stats = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private string FormatCurrency(decimal value) => string.Format(CultureInfo.CurrentCulture, "{0:N2} €", value);
    private string FormatPercent(decimal value) => string.Format(CultureInfo.CurrentCulture, "{0:N2} %", value);
    private string FormatCount(int value) => value.ToString("N0", CultureInfo.CurrentCulture);
    private string FormatNumber(decimal value) => value.ToString("N2", CultureInfo.CurrentCulture);
    private string FormatQuantity(decimal value) => value.ToString("N3", CultureInfo.CurrentCulture);

    private string FormatComparisonValue(decimal value, string valueKind) =>
        valueKind switch
        {
            "currency" => FormatCurrency(value),
            "count" => value.ToString("N0", CultureInfo.CurrentCulture),
            _ => value.ToString("N2", CultureInfo.CurrentCulture)
        };

    private string BuildDeltaLabel(StatisticComparisonItemDto item)
    {
        var sign = item.DeltaValue > 0 ? "+" : string.Empty;
        var deltaValue = FormatComparisonValue(item.DeltaValue, item.ValueKind);
        return $"{sign}{deltaValue} ({sign}{item.DeltaPercentage.ToString("N2", CultureInfo.CurrentCulture)}%)";
    }

    private string TranslateComparisonLabel(string label) =>
        label switch
        {
            "Facturación ventas" => L("Facturación ventas", "Facturació vendes", "Sales invoicing"),
            "Facturación compras" => L("Facturación compras", "Facturació compres", "Purchase invoicing"),
            "Pendiente cobro" => L("Pendiente cobro", "Pendent cobrament", "Outstanding sales"),
            "Pendiente pago" => L("Pendiente pago", "Pendent pagament", "Outstanding purchases"),
            "Movimientos stock" => L("Movimientos stock", "Moviments estoc", "Stock movements"),
            "Órdenes vivas" => L("Órdenes vivas", "Ordres vives", "Live work orders"),
            _ => label
        };

    private string BuildPreviousRangeLabel()
    {
        var currentFrom = filter.DateFrom?.Date ?? DateTime.Today.AddDays(-30);
        var currentTo = filter.DateTo?.Date ?? DateTime.Today;
        var currentToExclusive = currentTo.AddDays(1);
        var previousFrom = currentFrom - (currentToExclusive - currentFrom);
        var previousTo = currentFrom.AddDays(-1);
        return L(
            $"Comparando contra {previousFrom:dd/MM/yyyy} - {previousTo:dd/MM/yyyy}.",
            $"Comparant contra {previousFrom:dd/MM/yyyy} - {previousTo:dd/MM/yyyy}.",
            $"Compared against {previousFrom:dd/MM/yyyy} - {previousTo:dd/MM/yyyy}.");
    }

    private RenderFragment RenderBreakdownTable(IReadOnlyCollection<StatisticBreakdownItemDto> items, string labelTitle, bool showAmount) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "table");
        builder.AddAttribute(sequence++, "class", "data-table");
        builder.OpenElement(sequence++, "thead");
        builder.OpenElement(sequence++, "tr");
        builder.OpenElement(sequence++, "th");
        builder.AddContent(sequence++, labelTitle);
        builder.CloseElement();
        builder.OpenElement(sequence++, "th");
        builder.AddContent(sequence++, L("Cantidad", "Quantitat", "Count"));
        builder.CloseElement();
        if (showAmount)
        {
            builder.OpenElement(sequence++, "th");
            builder.AddContent(sequence++, L("Importe", "Import", "Amount"));
            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(sequence++, "tbody");

        if (items.Count == 0)
        {
            builder.OpenElement(sequence++, "tr");
            builder.OpenElement(sequence++, "td");
            builder.AddAttribute(sequence++, "colspan", showAmount ? 3 : 2);
            builder.AddAttribute(sequence++, "class", "table-empty");
            builder.AddContent(sequence++, L("Sin datos para este rango.", "Sense dades per a aquest rang.", "No data for this range."));
            builder.CloseElement();
            builder.CloseElement();
        }
        else
        {
            foreach (var item in items)
            {
                builder.OpenElement(sequence++, "tr");
                builder.OpenElement(sequence++, "td");
                builder.AddContent(sequence++, TranslateAnalyticsLabel(item.Label));
                builder.CloseElement();
                builder.OpenElement(sequence++, "td");
                builder.AddContent(sequence++, FormatCount(item.Count));
                builder.CloseElement();
                if (showAmount)
                {
                    builder.OpenElement(sequence++, "td");
                    builder.AddContent(sequence++, FormatCurrency(item.Amount));
                    builder.CloseElement();
                }

                builder.CloseElement();
            }
        }

        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment RenderDistributionTable(IReadOnlyCollection<StatisticDistributionItemDto> items, string labelTitle) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "table");
        builder.AddAttribute(sequence++, "class", "data-table");
        builder.OpenElement(sequence++, "thead");
        builder.OpenElement(sequence++, "tr");
        builder.OpenElement(sequence++, "th");
        builder.AddContent(sequence++, labelTitle);
        builder.CloseElement();
        builder.OpenElement(sequence++, "th");
        builder.AddContent(sequence++, L("Cantidad", "Quantitat", "Count"));
        builder.CloseElement();
        builder.OpenElement(sequence++, "th");
        builder.AddContent(sequence++, L("Importe", "Import", "Amount"));
        builder.CloseElement();
        builder.OpenElement(sequence++, "th");
        builder.AddContent(sequence++, L("Peso %", "Pes %", "Share %"));
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(sequence++, "tbody");

        if (items.Count == 0)
        {
            builder.OpenElement(sequence++, "tr");
            builder.OpenElement(sequence++, "td");
            builder.AddAttribute(sequence++, "colspan", 4);
            builder.AddAttribute(sequence++, "class", "table-empty");
            builder.AddContent(sequence++, L("Sin datos para este rango.", "Sense dades per a aquest rang.", "No data for this range."));
            builder.CloseElement();
            builder.CloseElement();
        }
        else
        {
            foreach (var item in items)
            {
                builder.OpenElement(sequence++, "tr");
                builder.OpenElement(sequence++, "td");
                builder.AddContent(sequence++, item.Label);
                builder.CloseElement();
                builder.OpenElement(sequence++, "td");
                builder.AddContent(sequence++, FormatCount(item.Count));
                builder.CloseElement();
                builder.OpenElement(sequence++, "td");
                builder.AddContent(sequence++, FormatCurrency(item.Amount));
                builder.CloseElement();
                builder.OpenElement(sequence++, "td");
                builder.AddContent(sequence++, FormatPercent(item.SharePercent));
                builder.CloseElement();
                builder.CloseElement();
            }
        }

        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment RenderGapTable(IReadOnlyCollection<StatisticGapItemDto> items) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "table");
        builder.AddAttribute(sequence++, "class", "data-table");
        builder.OpenElement(sequence++, "thead");
        builder.OpenElement(sequence++, "tr");
        builder.OpenElement(sequence++, "th");
        builder.AddContent(sequence++, L("Proveedor", "Proveïdor", "Supplier"));
        builder.CloseElement();
        builder.OpenElement(sequence++, "th");
        builder.AddContent(sequence++, L("Recepcionado", "Recepcionat", "Received"));
        builder.CloseElement();
        builder.OpenElement(sequence++, "th");
        builder.AddContent(sequence++, L("Facturado", "Facturat", "Invoiced"));
        builder.CloseElement();
        builder.OpenElement(sequence++, "th");
        builder.AddContent(sequence++, L("Gap", "Gap", "Gap"));
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(sequence++, "tbody");

        if (items.Count == 0)
        {
            builder.OpenElement(sequence++, "tr");
            builder.OpenElement(sequence++, "td");
            builder.AddAttribute(sequence++, "colspan", 4);
            builder.AddAttribute(sequence++, "class", "table-empty");
            builder.AddContent(sequence++, L("Sin datos para este rango.", "Sense dades per a aquest rang.", "No data for this range."));
            builder.CloseElement();
            builder.CloseElement();
        }
        else
        {
            foreach (var item in items)
            {
                builder.OpenElement(sequence++, "tr");
                builder.OpenElement(sequence++, "td");
                builder.AddContent(sequence++, item.Label);
                builder.CloseElement();
                builder.OpenElement(sequence++, "td");
                builder.AddContent(sequence++, FormatCurrency(item.ExpectedValue));
                builder.CloseElement();
                builder.OpenElement(sequence++, "td");
                builder.AddContent(sequence++, FormatCurrency(item.ActualValue));
                builder.CloseElement();
                builder.OpenElement(sequence++, "td");
                builder.AddContent(sequence++, FormatCurrency(item.GapValue));
                builder.CloseElement();
                builder.CloseElement();
            }
        }

        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment RenderTimelineTable() => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "table");
        builder.AddAttribute(sequence++, "class", "data-table");
        builder.OpenElement(sequence++, "thead");
        builder.OpenElement(sequence++, "tr");
        builder.OpenElement(sequence++, "th");
        builder.AddContent(sequence++, L("Semana", "Setmana", "Week"));
        builder.CloseElement();
        foreach (var column in area.BuildTimelineColumns(T))
        {
            builder.OpenElement(sequence++, "th");
            builder.AddContent(sequence++, column.Header);
            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(sequence++, "tbody");

        if (stats.WeeklyTimeline.Count == 0)
        {
            builder.OpenElement(sequence++, "tr");
            builder.OpenElement(sequence++, "td");
            builder.AddAttribute(sequence++, "colspan", area.BuildTimelineColumns(T).Count + 1);
            builder.AddAttribute(sequence++, "class", "table-empty");
            builder.AddContent(sequence++, L("Sin evolución para este rango.", "Sense evolució per a aquest rang.", "No timeline data for this range."));
            builder.CloseElement();
            builder.CloseElement();
        }
        else
        {
            foreach (var point in stats.WeeklyTimeline)
            {
                builder.OpenElement(sequence++, "tr");
                builder.OpenElement(sequence++, "td");
                builder.AddContent(sequence++, point.Label);
                builder.CloseElement();
                foreach (var column in area.BuildTimelineColumns(T))
                {
                    builder.OpenElement(sequence++, "td");
                    builder.AddContent(sequence++, column.Value(point));
                    builder.CloseElement();
                }

                builder.CloseElement();
            }
        }

        builder.CloseElement();
        builder.CloseElement();
    };

