        private readonly string slug;

        private AreaDefinition(string slug)
        {
            this.slug = slug;
        }

        public string Slug => slug;

        public string ReportsRoute =>
            slug switch
            {
                "sales" => "/listados/ventas",
                "purchases" => "/listados/compras",
                "production" => "/listados/produccion",
                "warehouse" => "/listados/almacen",
                _ => "/listados/ventas"
            };

        public string StatisticsRoute =>
            slug switch
            {
                "sales" => "/estadisticas/ventas",
                "purchases" => "/estadisticas/compras",
                "production" => "/estadisticas/produccion",
                "warehouse" => "/estadisticas/almacen",
                _ => "/estadisticas/ventas"
            };

        public static AreaDefinition FromRoute(string route)
        {
            var normalized = (route ?? string.Empty).Split('?', '#')[0].Trim('/');
            return normalized switch
            {
                "estadisticas/compras" => new("purchases"),
                "estadisticas/produccion" => new("production"),
                "estadisticas/almacen" => new("warehouse"),
                _ => new("sales")
            };
        }

