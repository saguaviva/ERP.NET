@page "/compras/facturas/{InvoiceNumber:int}/pdf"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@layout EmptyLayout
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IPurchaseInvoiceQueries PurchaseInvoiceQueries
@inject AppText T

<PageTitle>@($"{L("Factura proveedor", "Factura proveïdor", "Supplier invoice")} {InvoiceNumber}")</PageTitle>

@if (!tenantId.HasValue || !companyId.HasValue || invoice is null)
{
    <div class="print-sheet">
        <p>@L("No se ha encontrado la factura de proveedor solicitada.", "No s'ha trobat la factura de proveïdor sol·licitada.", "The requested supplier invoice could not be found.")</p>
    </div>
}
else
{
    <article class="print-sheet">
        <header class="print-header">
            <div>
                <p class="eyebrow">@L("Compras", "Compres", "Purchases")</p>
                <h1>@L("Factura de proveedor", "Factura de proveïdor", "Supplier invoice") @invoice.DisplayNumber</h1>
                <p class="muted">@invoice.CompanyName · @L("Centro", "Centre", "Center") @invoice.CompanyLegacyCenterCode</p>
            </div>
            <div class="print-meta">
                <div><strong>@L("Fecha", "Data", "Date"):</strong> @invoice.DocumentDate.ToString("dd/MM/yyyy")</div>
                <div><strong>@L("Vencimiento", "Venciment", "Due date"):</strong> @(invoice.DueDate?.ToString("dd/MM/yyyy") ?? L("Sin dato", "Sense dada", "No data"))</div>
                <div><strong>@L("Estado", "Estat", "Status"):</strong> @FormatStatus(invoice.Status)</div>
            </div>
        </header>

        <section class="comparison-grid">
            <section class="info-card">
                <h2>@L("Proveedor", "Proveïdor", "Supplier")</h2>
                <p><strong>@invoice.SupplierName</strong></p>
                <p class="muted">@DisplayValue(invoice.SupplierTaxId)</p>
                <p class="muted">@SupplierLocation</p>
                <p class="muted">@L("Factura proveedor", "Factura proveïdor", "Supplier invoice"): @DisplayValue(invoice.SupplierDocumentNumber)</p>
            </section>
            <section class="info-card">
                <h2>@L("Resumen", "Resum", "Summary")</h2>
                <div class="receipt-kv-grid">
                    <div>
                        <span class="muted">@L("Base", "Base", "Base")</span>
                        <strong>@invoice.TotalNetAmount.ToUiString("0.00") €</strong>
                    </div>
                    <div>
                        <span class="muted">@L("IVA", "IVA", "VAT")</span>
                        <strong>@invoice.TotalTaxAmount.ToUiString("0.00") €</strong>
                    </div>
                    <div>
                        <span class="muted">@L("Total", "Total", "Total")</span>
                        <strong>@invoice.TotalAmount.ToUiString("0.00") €</strong>
                    </div>
                    <div>
                        <span class="muted">@L("Pagado", "Pagat", "Paid")</span>
                        <strong>@invoice.AmountPaid.ToUiString("0.00") €</strong>
                    </div>
                    <div>
                        <span class="muted">@L("Pendiente", "Pendent", "Pending")</span>
                        <strong>@invoice.OutstandingAmount.ToUiString("0.00") €</strong>
                    </div>
                    <div>
                        <span class="muted">@L("Último pago", "Últim pagament", "Last payment")</span>
                        <strong>@(invoice.LastPaymentUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? L("Sin pago", "Sense pagament", "No payment"))</strong>
                    </div>
                    <div>
                        <span class="muted">@L("Recepciones", "Recepcions", "Receipts")</span>
                        <strong>@invoice.Receipts.Count</strong>
                    </div>
                </div>
            </section>
        </section>

        <section class="panel">
            <h2>@L("Recepciones enlazadas", "Recepcions enllaçades", "Linked receipts")</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@L("Entrada", "Entrada", "Receipt")</th>
                        <th>@L("Pedido", "Comanda", "Order")</th>
                        <th>@L("Fecha", "Data", "Date")</th>
                        <th>@L("Cantidad", "Quantitat", "Quantity")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (invoice.Receipts.Count == 0)
                    {
                        <tr><td colspan="4" class="table-empty">@L("Sin recepciones enlazadas.", "Sense recepcions enllaçades.", "No linked receipts.")</td></tr>
                    }
                    else
                    {
                        @foreach (var receipt in invoice.Receipts)
                        {
                            <tr>
                                <td>@receipt.DisplayNumber</td>
                                <td>@receipt.OrderNumber</td>
                                <td>@receipt.ReceiptDate.ToString("dd/MM/yyyy")</td>
                                <td>@receipt.TotalReceivedQuantity.ToUiString("0.###")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </section>

        <section class="panel">
            <h2>@L("Líneas", "Línies", "Lines")</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@L("Línea", "Línia", "Line")</th>
                        <th>@L("Artículo", "Article", "Item")</th>
                        <th>@L("Descripción", "Descripció", "Description")</th>
                        <th>@L("Cantidad", "Quantitat", "Quantity")</th>
                        <th>@L("Precio", "Preu", "Price")</th>
                        <th>@L("IVA", "IVA", "VAT")</th>
                        <th>@L("Total", "Total", "Total")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in invoice.Lines)
                    {
                        <tr>
                            <td>@line.LineNumber</td>
                            <td>@DisplayValue(line.ItemCode)</td>
                            <td>@line.Description</td>
                            <td>@line.Quantity.ToUiString("0.###") @line.UnitOfMeasure</td>
                            <td>@line.UnitPrice.ToUiString("0.0000")</td>
                            <td>@line.TaxRate.ToUiString("0.##") %</td>
                            <td>@line.LineTotal.ToUiString("0.00") €</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        @if (invoice.Payments.Count > 0)
        {
            <section class="panel">
                <h2>@L("Pagos registrados", "Pagaments registrats", "Registered payments")</h2>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@L("Fecha", "Data", "Date")</th>
                            <th>@L("Importe", "Import", "Amount")</th>
                            <th>@L("Método", "Mètode", "Method")</th>
                            <th>@L("Referencia", "Referència", "Reference")</th>
                            <th>@L("Notas", "Notes", "Notes")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in invoice.Payments)
                        {
                            <tr>
                                <td>@payment.PaymentNumber</td>
                                <td>@payment.PaymentDate.ToString("dd/MM/yyyy")</td>
                                <td>@payment.Amount.ToUiString("0.00") €</td>
                                <td>@DisplayValue(payment.Method)</td>
                                <td>@DisplayValue(payment.Reference)</td>
                                <td>@DisplayValue(payment.Notes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(invoice.Notes))
        {
            <section class="panel">
                <h2>@L("Notas", "Notes", "Notes")</h2>
                <p>@invoice.Notes</p>
            </section>
        }
    </article>
}

@code {
    [Parameter]
    public int InvoiceNumber { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private PurchaseInvoiceDetailDto? invoice;
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    private string SupplierLocation
    {
        get
        {
            if (invoice is null)
            {
                return string.Empty;
            }

            var parts = new[]
            {
                invoice.SupplierAddress,
                $"{invoice.SupplierPostalCode} {invoice.SupplierCity}".Trim(),
                invoice.SupplierProvince,
                invoice.SupplierCountry
            }.Where(part => !string.IsNullOrWhiteSpace(part));

            return string.Join(" · ", parts);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        invoice = await PurchaseInvoiceQueries.GetInvoiceByNumberAsync(tenantId.Value, companyId.Value, InvoiceNumber);
    }

    private string FormatStatus(string status) => status switch
    {
        PurchaseInvoiceStatuses.Draft => L("Borrador", "Esborrany", "Draft"),
        PurchaseInvoiceStatuses.Registered => L("Registrada", "Registrada", "Registered"),
        PurchaseInvoiceStatuses.Paid => L("Pagada", "Pagada", "Paid"),
        PurchaseInvoiceStatuses.Cancelled => L("Anulada", "Anul·lada", "Cancelled"),
        _ => status
    };

    private string DisplayValue(string value) => string.IsNullOrWhiteSpace(value) ? L("Sin dato", "Sense dada", "No data") : value;
}
