@page "/listados/compras-ventas-ordenes"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IReportingQueries ReportingQueries
@inject AppText T

@using Erp.Application.Reporting

<PageTitle>@L("Listados / Compras · Ventas · Órdenes", "Llistats / Compres · Vendes · Ordres", "Reports / Purchases · Sales · Orders")</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("Listados", "Llistats", "Reports")</p>
        <h1>@L("Compras / Ventas / Órdenes", "Compres / Vendes / Ordres", "Purchases / Sales / Orders")</h1>
        <p class="lead">@L("Cruza el circuito documental principal en una sola vista para supervisión rápida y búsqueda transversal.", "Creua el circuit documental principal en una sola vista per a supervisió ràpida i cerca transversal.", "Cross the main document flow in one view for quick supervision and cross-searching.")</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="/listados">@L("Volver a listados", "Tornar a llistats", "Back to reports")</a>
        <a class="secondary-button link-button" href="/estadisticas">@L("Ver estadísticas", "Veure estadístiques", "View statistics")</a>
        <a class="secondary-button link-button" href="@ExportCsvHref">@L("Exportar CSV", "Exportar CSV", "Export CSV")</a>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("Selecciona una empresa activa para cargar el listado operativo.", "Selecciona una empresa activa per carregar el llistat operatiu.", "Select an active company to load the operational report.")</p>
    </div>
}
else
{
    <section class="panel">
        <div class="filter-row">
            <label class="field compact-field">
                <span>@L("Desde", "Des de", "From")</span>
                <input class="text-input" type="date" @bind="filter.DateFrom" @bind:format="yyyy-MM-dd" disabled="@isLoading" />
            </label>
            <label class="field compact-field">
                <span>@L("Hasta", "Fins a", "To")</span>
                <input class="text-input" type="date" @bind="filter.DateTo" @bind:format="yyyy-MM-dd" disabled="@isLoading" />
            </label>
            <label class="field compact-field">
                <span>@L("Categoría", "Categoria", "Category")</span>
                <select class="sidebar-select compact-select" @bind="filter.Category" disabled="@isLoading">
                    <option value="">@L("Todas", "Totes", "All")</option>
                    <option value="Sales">@L("Ventas", "Vendes", "Sales")</option>
                    <option value="Purchases">@L("Compras", "Compres", "Purchases")</option>
                    <option value="Production">@L("Producción", "Producció", "Production")</option>
                    <option value="Finance">@L("Finanzas", "Finances", "Finance")</option>
                    <option value="Warehouse">@L("Almacén", "Magatzem", "Warehouse")</option>
                </select>
            </label>
            <label class="field compact-field">
                <span>@L("Tipo documental", "Tipus documental", "Document type")</span>
                <select class="sidebar-select compact-select" @bind="filter.TypeKey" disabled="@isLoading">
                    <option value="">@L("Todos", "Tots", "All")</option>
                    <option value="SalesOrder">@L("Pedido venta", "Comanda venda", "Sales order")</option>
                    <option value="SalesShipment">@L("Albarán venta", "Albarà venda", "Sales shipment")</option>
                    <option value="SalesInvoice">@L("Factura venta", "Factura venda", "Sales invoice")</option>
                    <option value="PurchaseOrder">@L("Pedido compra", "Comanda compra", "Purchase order")</option>
                    <option value="PurchaseReceipt">@L("Recepción", "Recepció", "Receipt")</option>
                    <option value="PurchaseInvoice">@L("Factura proveedor", "Factura proveïdor", "Supplier invoice")</option>
                    <option value="FinishWorkOrder">@L("Orden fabricación", "Ordre fabricació", "Work order")</option>
                    <option value="SalesRemittance">@L("Remesa", "Remesa", "Remittance")</option>
                    <option value="StockTransfer">@L("Traspaso almacén", "Traspàs magatzem", "Warehouse transfer")</option>
                    <option value="StockCount">@L("Inventario", "Inventari", "Stock count")</option>
                </select>
            </label>
        </div>
        <div class="filter-row" style="margin-top:0.85rem;">
            <input class="text-input" @bind="filter.Search" placeholder="@L("Buscar por documento, tipo, tercero o estado", "Buscar per document, tipus, tercer o estat", "Search by document, type, counterparty or status")" disabled="@isLoading" />
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? L("Cargando...", "Carregant...", "Loading...") : L("Buscar", "Buscar", "Search"))</button>
        </div>
        <div class="filter-row results-toolbar" style="margin-top:0.85rem;">
            <span class="results-summary">@ResultsSummaryText</span>
            <label class="field compact-field">
                <span>@L("Tamaño de página", "Mida de pàgina", "Page size")</span>
                <select class="sidebar-select compact-select" value="@filter.PageSize" @onchange="OnPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }

    <div class="card-grid">
        <section class="info-card">
            <h2>@totalCount</h2>
            <p class="muted">@L("documentos encontrados", "documents trobats", "documents found")</p>
        </section>
        <section class="info-card">
            <h2>@items.Count(item => string.Equals(item.Category, "Sales", StringComparison.OrdinalIgnoreCase))</h2>
            <p class="muted">@L("ventas en página", "vendes en pàgina", "sales on page")</p>
        </section>
        <section class="info-card">
            <h2>@items.Count(item => string.Equals(item.Category, "Purchases", StringComparison.OrdinalIgnoreCase))</h2>
            <p class="muted">@L("compras en página", "compres en pàgina", "purchases on page")</p>
        </section>
        <section class="info-card">
            <h2>@items.Count(item => string.Equals(item.Category, "Production", StringComparison.OrdinalIgnoreCase))</h2>
            <p class="muted">@L("producción en página", "producció en pàgina", "production on page")</p>
        </section>
        <section class="info-card">
            <h2>@items.Count(item => string.Equals(item.Category, "Warehouse", StringComparison.OrdinalIgnoreCase))</h2>
            <p class="muted">@L("almacén en página", "magatzem en pàgina", "warehouse on page")</p>
        </section>
        <section class="info-card accent-card">
            <h2>@items.Sum(item => item.Amount).ToUiString("0.00")</h2>
            <p class="muted">@L("importe / volumen agregado en página", "import / volum agregat en pàgina", "aggregated amount / volume on page")</p>
        </section>
    </div>

    <div class="comparison-grid">
        <section class="panel">
            <p class="eyebrow">@L("Resumen", "Resum", "Summary")</p>
            <h2>@L("Por tipo de documento", "Per tipus de document", "By document type")</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@L("Tipo", "Tipus", "Type")</th>
                        <th>@L("Cantidad", "Quantitat", "Count")</th>
                        <th>@L("Importe", "Import", "Amount")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (TypeSummaries.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="table-empty">@L("Sin datos para este filtro.", "Sense dades per a aquest filtre.", "No data for this filter.")</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var summary in TypeSummaries)
                        {
                            <tr>
                                <td>@summary.Label</td>
                                <td>@summary.Count</td>
                                <td>@summary.Amount.ToUiString("0.00")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </section>

        <section class="panel">
            <p class="eyebrow">@L("Resumen", "Resum", "Summary")</p>
            <h2>@L("Por estado", "Per estat", "By status")</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@L("Estado", "Estat", "Status")</th>
                        <th>@L("Cantidad", "Quantitat", "Count")</th>
                        <th>@L("Importe", "Import", "Amount")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (StatusSummaries.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="table-empty">@L("Sin datos para este filtro.", "Sense dades per a aquest filtre.", "No data for this filter.")</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var summary in StatusSummaries)
                        {
                            <tr>
                                <td>@summary.Label</td>
                                <td>@summary.Count</td>
                                <td>@summary.Amount.ToUiString("0.00")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </section>
    </div>

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)">
        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>@L("Cargando documentos...", "Carregant documents...", "Loading documents...")</span>
            </div>
        }

        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <SortableHeader Label="@L("Fecha", "Data", "Date")" IsActive="@(sortColumn == nameof(OperationalDocumentListItemDto.DocumentDate))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(OperationalDocumentListItemDto.DocumentDate), true))" />
                        <SortableHeader Label="@L("Categoría", "Categoria", "Category")" IsActive="@(sortColumn == nameof(OperationalDocumentListItemDto.Category))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(OperationalDocumentListItemDto.Category)))" />
                        <SortableHeader Label="@L("Tipo", "Tipus", "Type")" IsActive="@(sortColumn == nameof(OperationalDocumentListItemDto.TypeLabel))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(OperationalDocumentListItemDto.TypeLabel)))" />
                        <SortableHeader Label="@L("Documento", "Document", "Document")" IsActive="@(sortColumn == nameof(OperationalDocumentListItemDto.DocumentDisplay))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(OperationalDocumentListItemDto.DocumentDisplay), true))" />
                        <SortableHeader Label="@L("Cliente / proveedor / banco", "Client / proveïdor / banc", "Client / supplier / bank")" IsActive="@(sortColumn == nameof(OperationalDocumentListItemDto.PartyName))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(OperationalDocumentListItemDto.PartyName)))" />
                        <SortableHeader Label="@L("Estado", "Estat", "Status")" IsActive="@(sortColumn == nameof(OperationalDocumentListItemDto.Status))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(OperationalDocumentListItemDto.Status)))" />
                        <SortableHeader Label="@L("Importe", "Import", "Amount")" IsActive="@(sortColumn == nameof(OperationalDocumentListItemDto.Amount))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(OperationalDocumentListItemDto.Amount), true))" />
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        @for (var index = 0; index < 5; index++)
                        {
                            <tr class="table-skeleton-row">
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                            </tr>
                        }
                    }
                    else if (items.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="table-empty">@L("No hay documentos para el filtro actual.", "No hi ha documents per al filtre actual.", "There are no documents for the current filter.")</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in items)
                        {
                            <tr>
                                <td>@item.DocumentDate.ToString("dd/MM/yyyy")</td>
                                <td>@FormatCategory(item.Category)</td>
                                <td>@FormatType(item.TypeKey)</td>
                                <td>@item.DocumentDisplay</td>
                                <td>@DisplayValue(item.PartyName)</td>
                                <td>@DisplayValue(item.Status)</td>
                                <td>@item.Amount.ToUiString("0.00")</td>
                                <td>
                                    <a class="inline-link" href="@item.Route">@L("Abrir", "Obrir", "Open")</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-bar">
            <span class="muted">@L($"Página {filter.Page} de {TotalPages}", $"Pàgina {filter.Page} de {TotalPages}", $"Page {filter.Page} of {TotalPages}")</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePageAsync(1)" disabled="@(!CanGoPrevious || isLoading)">@L("Primera", "Primera", "First")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page - 1)" disabled="@(!CanGoPrevious || isLoading)">@L("Anterior", "Anterior", "Previous")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page + 1)" disabled="@(!CanGoNext || isLoading)">@L("Siguiente", "Següent", "Next")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(TotalPages)" disabled="@(!CanGoNext || isLoading)">@L("Última", "Última", "Last")</button>
            </div>
        </div>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "from")]
    public DateTime? FromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public DateTime? ToQuery { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "category")]
    public string? CategoryQuery { get; set; }

    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? PageSizeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortQuery { get; set; }

    [SupplyParameterFromQuery(Name = "desc")]
    public bool? DescQuery { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool isLoading;
    private string errorMessage = string.Empty;
    private int totalCount;
    private string sortColumn = nameof(OperationalDocumentListItemDto.DocumentDate);
    private bool sortDescending = true;
    private OperationalDocumentFilter filter = new() { Page = 1, PageSize = 25, SortColumn = nameof(OperationalDocumentListItemDto.DocumentDate), SortDescending = true };
    private IReadOnlyCollection<OperationalDocumentListItemDto> items = [];

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)filter.PageSize));
    private bool CanGoPrevious => filter.Page > 1;
    private bool CanGoNext => filter.Page < TotalPages;
    private int PageStart => totalCount == 0 ? 0 : ((filter.Page - 1) * filter.PageSize) + 1;
    private int PageEnd => totalCount == 0 ? 0 : Math.Min(filter.Page * filter.PageSize, totalCount);
    private IReadOnlyList<DocumentSummary> TypeSummaries =>
        items.GroupBy(item => FormatType(item.TypeKey))
            .Select(group => new DocumentSummary(group.Key, group.Count(), group.Sum(item => item.Amount)))
            .OrderByDescending(summary => summary.Count)
            .ThenBy(summary => summary.Label)
            .ToArray();
    private IReadOnlyList<DocumentSummary> StatusSummaries =>
        items.GroupBy(item => DisplayValue(item.Status))
            .Select(group => new DocumentSummary(group.Key, group.Count(), group.Sum(item => item.Amount)))
            .OrderByDescending(summary => summary.Count)
            .ThenBy(summary => summary.Label)
            .ToArray();
    private string ExportCsvHref => NavigationManager.GetUriWithQueryParameters("/listados/compras-ventas-ordenes/export/csv", new Dictionary<string, object?>
    {
        ["from"] = filter.DateFrom?.ToString("yyyy-MM-dd"),
        ["to"] = filter.DateTo?.ToString("yyyy-MM-dd"),
        ["search"] = string.IsNullOrWhiteSpace(filter.Search) ? null : filter.Search,
        ["category"] = string.IsNullOrWhiteSpace(filter.Category) ? null : filter.Category,
        ["type"] = string.IsNullOrWhiteSpace(filter.TypeKey) ? null : filter.TypeKey
    });
    private string ResultsSummaryText =>
        totalCount == 0
            ? L("Sin resultados", "Sense resultats", "No results")
            : L($"Mostrando {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} documentos", $"Mostrant {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} documents", $"Showing {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} of {totalCount.ToUiString("N0")} documents");

    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        ApplyQueryState();
        await LoadAsync();
    }

    private void ApplyQueryState()
    {
        filter.DateFrom = FromQuery ?? DateTime.Today.AddDays(-30);
        filter.DateTo = ToQuery ?? DateTime.Today;
        filter.Search = SearchQuery ?? string.Empty;
        filter.Category = CategoryQuery ?? string.Empty;
        filter.TypeKey = TypeQuery ?? string.Empty;
        filter.Page = Math.Max(PageQuery ?? 1, 1);
        filter.PageSize = PageSizeQuery is > 0 ? PageSizeQuery.Value : 25;
        sortColumn = string.IsNullOrWhiteSpace(SortQuery) ? nameof(OperationalDocumentListItemDto.DocumentDate) : SortQuery;
        sortDescending = DescQuery ?? true;
    }

    private async Task LoadAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            items = [];
            totalCount = 0;
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            filter.SortColumn = sortColumn;
            filter.SortDescending = sortDescending;
            var result = await ReportingQueries.SearchOperationalDocumentsAsync(tenantId.Value, companyId.Value, filter);
            items = result.Items;
            totalCount = result.TotalCount;
            await SyncQueryStateAsync();
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            items = [];
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        filter.Page = 1;
        await LoadAsync();
    }

    private async Task ChangePageAsync(int page)
    {
        var newPage = Math.Max(1, Math.Min(page, TotalPages));
        if (newPage == filter.Page)
        {
            return;
        }

        filter.Page = newPage;
        await LoadAsync();
    }

    private async Task SetSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(sortColumn, column, StringComparison.Ordinal))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = defaultDescending;
        }

        filter.Page = 1;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return;
        }

        filter.PageSize = pageSize;
        filter.Page = 1;
        await LoadAsync();
    }

    private async Task SyncQueryStateAsync()
    {
        var query = new Dictionary<string, object?>
        {
            ["from"] = filter.DateFrom?.ToString("yyyy-MM-dd"),
            ["to"] = filter.DateTo?.ToString("yyyy-MM-dd"),
            ["search"] = string.IsNullOrWhiteSpace(filter.Search) ? null : filter.Search,
            ["category"] = string.IsNullOrWhiteSpace(filter.Category) ? null : filter.Category,
            ["type"] = string.IsNullOrWhiteSpace(filter.TypeKey) ? null : filter.TypeKey,
            ["page"] = filter.Page > 1 ? filter.Page : null,
            ["pageSize"] = filter.PageSize != 25 ? filter.PageSize : null,
            ["sort"] = sortColumn != nameof(OperationalDocumentListItemDto.DocumentDate) ? sortColumn : null,
            ["desc"] = sortDescending ? true : null
        };

        var target = NavigationManager.GetUriWithQueryParameters(query);
        if (!string.Equals(target, NavigationManager.Uri, StringComparison.Ordinal))
        {
            NavigationManager.NavigateTo(target, replace: true);
        }

        await Task.CompletedTask;
    }

    private string FormatCategory(string category) =>
        category switch
        {
            "Sales" => L("Ventas", "Vendes", "Sales"),
            "Purchases" => L("Compras", "Compres", "Purchases"),
            "Production" => L("Producción", "Producció", "Production"),
            "Finance" => L("Finanzas", "Finances", "Finance"),
            "Warehouse" => L("Almacén", "Magatzem", "Warehouse"),
            _ => category
        };

    private string FormatType(string typeKey) =>
        typeKey switch
        {
            "SalesOrder" => L("Pedido venta", "Comanda venda", "Sales order"),
            "SalesShipment" => L("Albarán venta", "Albarà venda", "Sales shipment"),
            "SalesInvoice" => L("Factura venta", "Factura venda", "Sales invoice"),
            "PurchaseOrder" => L("Pedido compra", "Comanda compra", "Purchase order"),
            "PurchaseReceipt" => L("Recepción compra", "Recepció compra", "Purchase receipt"),
            "PurchaseInvoice" => L("Factura proveedor", "Factura proveïdor", "Supplier invoice"),
            "FinishWorkOrder" => L("Orden fabricación", "Ordre fabricació", "Work order"),
            "SalesRemittance" => L("Remesa cliente", "Remesa client", "Customer remittance"),
            "StockTransfer" => L("Traspaso almacén", "Traspàs magatzem", "Warehouse transfer"),
            "StockCount" => L("Inventario", "Inventari", "Stock count"),
            _ => typeKey
        };

    private static string DisplayValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private sealed record DocumentSummary(string Label, int Count, decimal Amount);
}
