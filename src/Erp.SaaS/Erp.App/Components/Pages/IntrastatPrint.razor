@page "/ventas/intrastat/imprimir"
@layout EmptyLayout
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IIntrastatQueries IntrastatQueries
@inject AppText T

<PageTitle>@L("Intrastat", "Intrastat", "Intrastat")</PageTitle>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="document-shell">
        <div class="empty-state document-state">
            <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="document-shell">
        <div class="alert danger document-state">@errorMessage</div>
    </div>
}
else
{
    <div class="document-shell">
        <div class="document-toolbar no-print">
            <a class="secondary-button link-button" href="/ventas/intrastat">@L("Volver a Intrastat", "Tornar a Intrastat", "Back to Intrastat")</a>
            <button class="primary-button" type="button" onclick="window.print()">@L("Imprimir / guardar PDF", "Imprimir / desar PDF", "Print / save PDF")</button>
        </div>

        <section class="document-page">
            <header class="document-header">
                <div>
                    <p class="eyebrow">@L("Intrastat", "Intrastat", "Intrastat")</p>
                    <h1>@L("Listado ventas UE", "Llistat vendes UE", "EU sales report") · @filter.Month.ToString("00")/@filter.Year</h1>
                    <p class="muted">@L("Presentación operativa alineada con el Excel legacy: detalle, matriz, pesos, transporte e importes.", "Presentació operativa alineada amb l'Excel legacy: detall, matriu, pesos, transport i imports.", "Operational layout aligned with the legacy Excel: detail, matrix, weights, transport and amounts.")</p>
                </div>
                <div class="document-header-meta">
                    <div>
                        <span class="muted">@L("Líneas", "Línies", "Lines")</span>
                        <strong>@report.TotalCount</strong>
                    </div>
                    <div>
                        <span class="muted">@L("Países", "Països", "Countries")</span>
                        <strong>@report.CountriesCount</strong>
                    </div>
                    <div>
                        <span class="muted">@L("Kg total", "Kg total", "Total kg")</span>
                        <strong>@report.TotalWeightKg.ToUiString("0.00")</strong>
                    </div>
                    <div>
                        <span class="muted">@L("Total", "Total", "Total")</span>
                        <strong>@report.TotalWithTransportAmount.ToUiString("0.00") €</strong>
                    </div>
                </div>
            </header>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>@L("Resumen", "Resum", "Summary")</h2>
                        <div class="document-kv-grid">
                            <div>
                                <span class="muted">@L("Importe venta", "Import venda", "Sales amount")</span>
                                <strong>@report.SalesAmount.ToUiString("0.00") €</strong>
                            </div>
                            <div>
                                <span class="muted">@L("Transporte", "Transport", "Transport")</span>
                                <strong>@report.TransportAmount.ToUiString("0.00") €</strong>
                            </div>
                            <div>
                                <span class="muted">@L("Clasificadas", "Classificades", "Classified")</span>
                                <strong>@report.ClassifiedLinesCount</strong>
                            </div>
                            <div>
                                <span class="muted">@L("Sin NC code", "Sense NC code", "Without NC code")</span>
                                <strong>@report.UnclassifiedLinesCount</strong>
                            </div>
                        </div>
                    </section>
                    <section class="document-box">
                        <h2>@L("Filtro", "Filtre", "Filter")</h2>
                        <p><strong>@L("Mes", "Mes", "Month"):</strong> @filter.Month.ToString("00")</p>
                        <p><strong>@L("Año", "Any", "Year"):</strong> @filter.Year</p>
                        <p><strong>@L("Búsqueda", "Cerca", "Search"):</strong> @(string.IsNullOrWhiteSpace(filter.Search) ? L("Sin filtro", "Sense filtre", "No filter") : filter.Search)</p>
                        <p><strong>@L("Solo clasificadas", "Només classificades", "Only classified"):</strong> @(filter.OnlyClassified ? L("Sí", "Sí", "Yes") : L("No", "No", "No"))</p>
                    </section>
                </div>
            </section>

            <section class="document-section">
                <h2>@L("Matriz estilo Excel legacy", "Matriu estil Excel legacy", "Legacy-style Excel matrix")</h2>
                <table class="data-table document-table intrastat-matrix-table">
                    <thead>
                        <tr>
                            <th rowspan="2">@L("Clientes", "Clients", "Clients")</th>
                            <th rowspan="2">@L("Orden alfabético", "Ordre alfabètic", "Alphabetical order")</th>
                            <th rowspan="2">@L("Siglas", "Sigles", "Code")</th>
                            <th colspan="@report.MatrixNcCodes.Count">@L("Códigos arancelarios · PESOS/Kgrs", "Codis aranzelaris · PESOS/Kgrs", "Tariff codes · WEIGHTS/Kgs")</th>
                            <th rowspan="2">@L("TOTAL PESOS/Kgrs", "TOTAL PESOS/Kgrs", "TOTAL WEIGHTS/Kgs")</th>
                            <th colspan="@report.MatrixNcCodes.Count">@L("Códigos arancelarios · FACTURAS€", "Codis aranzelaris · FACTURES€", "Tariff codes · INVOICES€")</th>
                            <th rowspan="2">@L("TOTAL FACTURAS€", "TOTAL FACTURES€", "TOTAL INVOICES€")</th>
                        </tr>
                        <tr>
                            @foreach (var ncCode in report.MatrixNcCodes)
                            {
                                <th>@ncCode</th>
                            }
                            @foreach (var ncCode in report.MatrixNcCodes)
                            {
                                <th>@ncCode</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in report.MatrixRows)
                        {
                            <tr class="@GetMatrixRowClass(item)">
                                <td>@(item.HasClients ? L("sí", "sí", "yes") : L("no", "no", "no"))</td>
                                <td>@item.CountryName</td>
                                <td>@item.CountryCode</td>
                                @foreach (var ncCode in report.MatrixNcCodes)
                                {
                                    <td class="numeric-cell">@FormatMatrixCell(item.WeightByNcCode.TryGetValue(ncCode, out var weightValue) ? weightValue : 0m)</td>
                                }
                                <td class="numeric-cell">@item.TotalWeightKg.ToUiString("0.00")</td>
                                @foreach (var ncCode in report.MatrixNcCodes)
                                {
                                    <td class="numeric-cell">@FormatMatrixCell(item.AmountByNcCode.TryGetValue(ncCode, out var amountValue) ? amountValue : 0m)</td>
                                }
                                <td class="numeric-cell">@item.TotalInvoiceAmount.ToUiString("0.00")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>

            <section class="document-section">
                <h2>@L("Detalle", "Detall", "Detail")</h2>
                <table class="data-table document-table">
                    <thead>
                        <tr>
                            <th>@L("Factura", "Factura", "Invoice")</th>
                            <th>@L("Fecha", "Data", "Date")</th>
                            <th>@L("Cliente", "Client", "Customer")</th>
                            <th>@L("Descripción", "Descripció", "Description")</th>
                            <th>@L("Composición", "Composició", "Composition")</th>
                            <th>@L("Talla", "Talla", "Size")</th>
                            <th>@L("Cantidad", "Quantitat", "Quantity")</th>
                            <th>@L("Peso unit.", "Pes unit.", "Unit weight")</th>
                            <th>@L("Peso total/Kgrs", "Pes total/Kgrs", "Total weight/Kgs")</th>
                            <th>@L("Importe", "Import", "Amount")</th>
                            <th>@L("Código NC", "Codi NC", "CN code")</th>
                            <th>@L("IVA", "IVA", "VAT")</th>
                            <th>@L("Dte?", "Dte?", "Disc.?")</th>
                            <th>@L("País", "País", "Country")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in report.Items)
                        {
                            <tr class="@GetLineRowClass(item)">
                                <td>@item.DisplayInvoiceNumber</td>
                                <td>@item.IssueDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div>@item.ClientName</div>
                                    <div class="table-subtitle">@item.ClientTaxId</div>
                                </td>
                                <td>
                                    <div>@item.Description</div>
                                    @if (!string.IsNullOrWhiteSpace(item.ItemCode))
                                    {
                                        <div class="table-subtitle">@item.ItemCode</div>
                                    }
                                </td>
                                <td>@DisplayValue(item.Composition)</td>
                                <td>@DisplayValue(item.Size)</td>
                                <td>@item.Quantity.ToUiString("0.###")</td>
                                <td>@item.UnitWeight.ToUiString("0.###")</td>
                                <td>@item.TotalWeightKg.ToUiString("0.00")</td>
                                <td>@item.NetAmount.ToUiString("0.00") €</td>
                                <td>@(string.IsNullOrWhiteSpace(item.IntrastatCode) ? L("Sin clasificar", "Sense classificar", "Unclassified") : item.IntrastatCode)</td>
                                <td>@DisplayValue(item.ClientTaxId)</td>
                    <td>@(item.DiscountAmount == 0m ? "-" : $"{item.DiscountAmount.ToUiString("0.00")} €")</td>
                                <td>@item.CountryCode</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        </section>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "month")]
    public int? MonthQuery { get; set; }

    [SupplyParameterFromQuery(Name = "year")]
    public int? YearQuery { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "classified")]
    public bool? OnlyClassifiedQuery { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private IntrastatFilter filter = new() { Page = 1, PageSize = 10000 };
    private IntrastatReportDto report = new();
    private string errorMessage = string.Empty;
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();

        filter.Month = Math.Clamp(MonthQuery ?? DateTime.Today.Month, 1, 12);
        filter.Year = YearQuery ?? DateTime.Today.Year;
        filter.Search = SearchQuery ?? string.Empty;
        filter.OnlyClassified = OnlyClassifiedQuery ?? false;

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        try
        {
            report = await IntrastatQueries.GetReportAsync(tenantId.Value, companyId.Value, filter);
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
    }

    private static string GetLineRowClass(IntrastatLineDto item) =>
        item.IsTransportCharge ? "intrastat-transport-row" : string.Empty;

    private static string GetMatrixRowClass(IntrastatMatrixRowDto row) =>
        row.IsDomesticReference ? "intrastat-domestic-row" : string.Empty;

    private static string FormatMatrixCell(decimal value) =>
        value == 0m ? string.Empty : value.ToUiString("0.00");

    private static string DisplayValue(string value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;
}
