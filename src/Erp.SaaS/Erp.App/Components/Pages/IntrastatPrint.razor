@page "/ventas/intrastat/imprimir"
@layout EmptyLayout
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IIntrastatQueries IntrastatQueries

<PageTitle>Intrastat</PageTitle>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="document-shell">
        <div class="empty-state document-state">
            <p>No hay empresa activa seleccionada.</p>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="document-shell">
        <div class="alert danger document-state">@errorMessage</div>
    </div>
}
else
{
    <div class="document-shell">
        <div class="document-toolbar no-print">
            <a class="secondary-button link-button" href="/ventas/intrastat">Volver a Intrastat</a>
            <button class="primary-button" type="button" onclick="window.print()">Guardar como PDF / Imprimir</button>
        </div>

        <section class="document-page">
            <header class="document-header">
                <div>
                    <p class="eyebrow">Intrastat</p>
                    <h1>Listado ventas UE · @filter.Month.ToString("00")/@filter.Year</h1>
                    <p class="muted">Salida operativa equivalente al Excel legacy con detalle, matriz, pesos, transporte e importes.</p>
                </div>
                <div class="document-header-meta">
                    <div>
                        <span class="muted">Líneas</span>
                        <strong>@report.TotalCount</strong>
                    </div>
                    <div>
                        <span class="muted">Países</span>
                        <strong>@report.CountriesCount</strong>
                    </div>
                    <div>
                        <span class="muted">Kg total</span>
                        <strong>@report.TotalWeightKg.ToString("0.00")</strong>
                    </div>
                    <div>
                        <span class="muted">Total</span>
                        <strong>@report.TotalWithTransportAmount.ToString("0.00") €</strong>
                    </div>
                </div>
            </header>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>Resumen</h2>
                        <div class="document-kv-grid">
                            <div>
                                <span class="muted">Import venda</span>
                                <strong>@report.SalesAmount.ToString("0.00") €</strong>
                            </div>
                            <div>
                                <span class="muted">Transport</span>
                                <strong>@report.TransportAmount.ToString("0.00") €</strong>
                            </div>
                            <div>
                                <span class="muted">Clasificadas</span>
                                <strong>@report.ClassifiedLinesCount</strong>
                            </div>
                            <div>
                                <span class="muted">Sin NC code</span>
                                <strong>@report.UnclassifiedLinesCount</strong>
                            </div>
                        </div>
                    </section>
                    <section class="document-box">
                        <h2>Filtro</h2>
                        <p><strong>Mes:</strong> @filter.Month.ToString("00")</p>
                        <p><strong>Año:</strong> @filter.Year</p>
                        <p><strong>Búsqueda:</strong> @(string.IsNullOrWhiteSpace(filter.Search) ? "Sin filtro" : filter.Search)</p>
                        <p><strong>Solo clasificadas:</strong> @(filter.OnlyClassified ? "Sí" : "No")</p>
                    </section>
                </div>
            </section>

            <section class="document-section">
                <h2>Matriz Excel legacy</h2>
                <table class="data-table document-table intrastat-matrix-table">
                    <thead>
                        <tr>
                            <th rowspan="2">Clients</th>
                            <th rowspan="2">Ordre alfabètic</th>
                            <th rowspan="2">Sigles</th>
                            <th colspan="@report.MatrixNcCodes.Count">Codis arancelaris · PESOS/Kgrs</th>
                            <th rowspan="2">TOTAL PESOS/Kgrs</th>
                            <th colspan="@report.MatrixNcCodes.Count">Codis arancelaris · FACTURES€</th>
                            <th rowspan="2">TOTAL FACTURES€</th>
                        </tr>
                        <tr>
                            @foreach (var ncCode in report.MatrixNcCodes)
                            {
                                <th>@ncCode</th>
                            }
                            @foreach (var ncCode in report.MatrixNcCodes)
                            {
                                <th>@ncCode</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in report.MatrixRows)
                        {
                            <tr class="@GetMatrixRowClass(item)">
                                <td>@(item.HasClients ? "si" : "no")</td>
                                <td>@item.CountryName</td>
                                <td>@item.CountryCode</td>
                                @foreach (var ncCode in report.MatrixNcCodes)
                                {
                                    <td class="numeric-cell">@FormatMatrixCell(item.WeightByNcCode.TryGetValue(ncCode, out var weightValue) ? weightValue : 0m)</td>
                                }
                                <td class="numeric-cell">@item.TotalWeightKg.ToString("0.00")</td>
                                @foreach (var ncCode in report.MatrixNcCodes)
                                {
                                    <td class="numeric-cell">@FormatMatrixCell(item.AmountByNcCode.TryGetValue(ncCode, out var amountValue) ? amountValue : 0m)</td>
                                }
                                <td class="numeric-cell">@item.TotalInvoiceAmount.ToString("0.00")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>

            <section class="document-section">
                <h2>Detalle</h2>
                <table class="data-table document-table">
                    <thead>
                        <tr>
                            <th>Factura</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Descripción</th>
                            <th>Composición</th>
                            <th>Talla</th>
                            <th>Cantidad</th>
                            <th>Pes unit.</th>
                            <th>Pes total/Kgrs</th>
                            <th>Import</th>
                            <th>NC code</th>
                            <th>VAT</th>
                            <th>Dte?</th>
                            <th>País</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in report.Items)
                        {
                            <tr class="@GetLineRowClass(item)">
                                <td>@item.DisplayInvoiceNumber</td>
                                <td>@item.IssueDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div>@item.ClientName</div>
                                    <div class="table-subtitle">@item.ClientTaxId</div>
                                </td>
                                <td>
                                    <div>@item.Description</div>
                                    @if (!string.IsNullOrWhiteSpace(item.ItemCode))
                                    {
                                        <div class="table-subtitle">@item.ItemCode</div>
                                    }
                                </td>
                                <td>@DisplayValue(item.Composition)</td>
                                <td>@DisplayValue(item.Size)</td>
                                <td>@item.Quantity.ToString("0.###")</td>
                                <td>@item.UnitWeight.ToString("0.###")</td>
                                <td>@item.TotalWeightKg.ToString("0.00")</td>
                                <td>@item.NetAmount.ToString("0.00") €</td>
                                <td>@(string.IsNullOrWhiteSpace(item.IntrastatCode) ? "Sin clasificar" : item.IntrastatCode)</td>
                                <td>@DisplayValue(item.ClientTaxId)</td>
                                <td>@(item.DiscountAmount == 0m ? "-" : $"{item.DiscountAmount:0.00} €")</td>
                                <td>@item.CountryCode</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        </section>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "month")]
    public int? MonthQuery { get; set; }

    [SupplyParameterFromQuery(Name = "year")]
    public int? YearQuery { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "classified")]
    public bool? OnlyClassifiedQuery { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private IntrastatFilter filter = new() { Page = 1, PageSize = 10000 };
    private IntrastatReportDto report = new();
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();

        filter.Month = Math.Clamp(MonthQuery ?? DateTime.Today.Month, 1, 12);
        filter.Year = YearQuery ?? DateTime.Today.Year;
        filter.Search = SearchQuery ?? string.Empty;
        filter.OnlyClassified = OnlyClassifiedQuery ?? false;

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        try
        {
            report = await IntrastatQueries.GetReportAsync(tenantId.Value, companyId.Value, filter);
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
    }

    private static string GetLineRowClass(IntrastatLineDto item) =>
        item.IsTransportCharge ? "intrastat-transport-row" : string.Empty;

    private static string GetMatrixRowClass(IntrastatMatrixRowDto row) =>
        row.IsDomesticReference ? "intrastat-domestic-row" : string.Empty;

    private static string FormatMatrixCell(decimal value) =>
        value == 0m ? string.Empty : value.ToString("0.00");

    private static string DisplayValue(string value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;
}
