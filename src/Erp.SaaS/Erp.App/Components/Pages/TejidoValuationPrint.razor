@page "/articulos/tejidos/{Code}/valoracion"
@layout EmptyLayout
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITejidoQueries TejidoQueries
@inject AppText T

<PageTitle>@($"{L("Valoración stock tejido", "Valoració estoc teixit", "Fabric stock valuation")} {Code}")</PageTitle>

<div class="document-shell">
    <div class="document-toolbar no-print">
        <a class="secondary-button link-button" href="/articulos/tejidos/editar/@Uri.EscapeDataString(Code)">@L("Volver al tejido", "Tornar al teixit", "Back to fabric")</a>
        <button class="primary-button" type="button" onclick="window.print()">@L("Imprimir / guardar PDF", "Imprimir / desar PDF", "Print / save PDF")</button>
    </div>

    @if (!tenantId.HasValue || !companyId.HasValue)
    {
        <div class="empty-state document-state">
            <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger document-state">@errorMessage</div>
    }
    else if (tejido is null)
    {
        <div class="empty-state document-state">
            <p>@L("No se ha encontrado el tejido solicitado.", "No s'ha trobat el teixit sol·licitat.", "The requested fabric could not be found.")</p>
        </div>
    }
    else
    {
        <section class="document-page">
            <header class="document-header">
                <div>
                    <p class="eyebrow">@L("Valoración stock", "Valoració estoc", "Stock valuation")</p>
                    <h1>@tejido.Code</h1>
                    <p class="muted">@tejido.Description</p>
                </div>
                <div class="document-header-meta">
                    <div>
                        <span class="muted">@L("Centro", "Centre", "Center")</span>
                        <strong>@tejido.CompanyCenterCode</strong>
                    </div>
                </div>
            </header>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>@L("Resumen", "Resum", "Summary")</h2>
                        <div class="document-kv-grid">
                            <div><span class="muted">@L("Stock cru", "Estoc cru", "Raw stock")</span><strong>@RawStockValue.ToUiString("0.00") €</strong></div>
                            <div><span class="muted">@L("Stock color", "Estoc color", "Color stock")</span><strong>@FinishedStockValue.ToUiString("0.00") €</strong></div>
                            <div><span class="muted">@L("Total", "Total", "Total")</span><strong>@TotalStockValue.ToUiString("0.00") €</strong></div>
                            <div><span class="muted">@L("Cru kg", "Cru kg", "Raw kg")</span><strong>@tejido.RawStockKilograms.ToUiString("0.###")</strong></div>
                            <div><span class="muted">@L("Cru m", "Cru m", "Raw m")</span><strong>@tejido.RawStockMeters.ToUiString("0.###")</strong></div>
                            <div><span class="muted">@L("Disponible m", "Disponible m", "Available m")</span><strong>@tejido.Colors.Sum(item => Math.Max(item.CurrentStock, 0m)).ToUiString("0.###")</strong></div>
                        </div>
                    </section>
                    <section class="document-box">
                        <h2>@L("Base de valoración", "Base de valoració", "Valuation basis")</h2>
                        <p>@L("El stock cru se valora como", "L'estoc cru es valora com", "Raw stock is valued as") <strong>@L("kg crudos × coste cru", "kg crus × cost cru", "raw kg × raw cost")</strong>.</p>
                        <p>@L("El stock de color se valora como", "L'estoc de color es valora com", "Color stock is valued as") <strong>@L("metros actuales × €/mts", "metres actuals × €/mts", "current meters × €/mts")</strong> @L("de cada línea de color.", "de cada línia de color.", "for each color line.")</p>
                    </section>
                </div>
            </section>

            <section class="document-section">
                <h2>@L("Detalle de colores", "Detall de colors", "Color detail")</h2>
                <table class="data-table document-table">
                    <thead>
                        <tr>
                            <th>@L("Color", "Color", "Color")</th>
                            <th>@L("Actual", "Actual", "Current")</th>
                            <th>@L("Mínimo", "Mínim", "Minimum")</th>
                            <th>@L("Tintar", "Tintar", "Dye")</th>
                            <th>@L("Precio", "Preu", "Price")</th>
                            <th>€/Mts.</th>
                            <th>€/KG</th>
                            <th>@L("Valor stock", "Valor estoc", "Stock value")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in tejido.Colors.OrderBy(item => item.LineNumber))
                        {
                            <tr>
                                <td>@DisplayValue(row.Color)</td>
                                <td>@row.CurrentStock.ToUiString("0.###")</td>
                                <td>@row.MinimumStock.ToUiString("0.###")</td>
                                <td>@row.DyeingPrice.ToUiString("0.0000")</td>
                                <td>@row.UnitCost.ToUiString("0.0000")</td>
                                <td>@row.MetersPrice.ToUiString("0.0000")</td>
                                <td>@row.KilogramsPrice.ToUiString("0.0000")</td>
                                <td>@Math.Round(Math.Max(row.CurrentStock, 0m) * Math.Max(row.MetersPrice, 0m), 2, MidpointRounding.AwayFromZero).ToUiString("0.00") €</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        </section>
    }
</div>

@code {
    [Parameter]
    public string Code { get; set; } = string.Empty;

    private Guid? tenantId;
    private Guid? companyId;
    private TejidoDetailDto? tejido;
    private string errorMessage = string.Empty;
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    private decimal RawStockValue => tejido is null ? 0m : Math.Round(tejido.RawStockKilograms * tejido.RawCost, 2, MidpointRounding.AwayFromZero);
    private decimal FinishedStockValue => tejido is null ? 0m : Math.Round(tejido.Colors.Sum(item => Math.Max(item.CurrentStock, 0m) * Math.Max(item.MetersPrice, 0m)), 2, MidpointRounding.AwayFromZero);
    private decimal TotalStockValue => RawStockValue + FinishedStockValue;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        try
        {
            errorMessage = string.Empty;
            tejido = await TejidoQueries.GetByCodeAsync(tenantId.Value, companyId.Value, Uri.UnescapeDataString(Code));
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
    }

    private static string DisplayValue(string value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
