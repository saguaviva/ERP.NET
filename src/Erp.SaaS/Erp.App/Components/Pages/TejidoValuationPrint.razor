@page "/articulos/tejidos/{Code}/valoracion"
@layout EmptyLayout
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITejidoQueries TejidoQueries

<PageTitle>Valoración stock tejido @Code</PageTitle>

<div class="document-shell">
    <div class="document-toolbar no-print">
        <a class="secondary-button link-button" href="/articulos/tejidos/editar/@Uri.EscapeDataString(Code)">Volver al tejido</a>
        <button class="primary-button" type="button" onclick="window.print()">Guardar como PDF / Imprimir</button>
    </div>

    @if (!tenantId.HasValue || !companyId.HasValue)
    {
        <div class="empty-state document-state">
            <p>No hay empresa activa seleccionada.</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger document-state">@errorMessage</div>
    }
    else if (tejido is null)
    {
        <div class="empty-state document-state">
            <p>No se ha encontrado el tejido solicitado.</p>
        </div>
    }
    else
    {
        <section class="document-page">
            <header class="document-header">
                <div>
                    <p class="eyebrow">Valoració stock</p>
                    <h1>@tejido.Code</h1>
                    <p class="muted">@tejido.Description</p>
                </div>
                <div class="document-header-meta">
                    <div>
                        <span class="muted">Centro</span>
                        <strong>@tejido.CompanyCenterCode</strong>
                    </div>
                </div>
            </header>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>Resumen</h2>
                        <div class="document-kv-grid">
                            <div><span class="muted">Stock cru</span><strong>@RawStockValue.ToString("0.00") €</strong></div>
                            <div><span class="muted">Stock color</span><strong>@FinishedStockValue.ToString("0.00") €</strong></div>
                            <div><span class="muted">Total</span><strong>@TotalStockValue.ToString("0.00") €</strong></div>
                            <div><span class="muted">Cru kg</span><strong>@tejido.RawStockKilograms.ToString("0.###")</strong></div>
                            <div><span class="muted">Cru m</span><strong>@tejido.RawStockMeters.ToString("0.###")</strong></div>
                            <div><span class="muted">Disponible m</span><strong>@tejido.Colors.Sum(item => Math.Max(item.CurrentStock, 0m)).ToString("0.###")</strong></div>
                        </div>
                    </section>
                    <section class="document-box">
                        <h2>Base de cálculo</h2>
                        <p>Stock cru valorado como <strong>kg crudos x coste cru</strong>.</p>
                        <p>Stock color valorado como <strong>metros actuales x €/mts</strong> de cada línea de color.</p>
                    </section>
                </div>
            </section>

            <section class="document-section">
                <h2>Detalle por color</h2>
                <table class="data-table document-table">
                    <thead>
                        <tr>
                            <th>Color</th>
                            <th>Actual</th>
                            <th>Mínimo</th>
                            <th>Tintar</th>
                            <th>Precio</th>
                            <th>€/Mts.</th>
                            <th>€/KG</th>
                            <th>Valor stock</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in tejido.Colors.OrderBy(item => item.LineNumber))
                        {
                            <tr>
                                <td>@DisplayValue(row.Color)</td>
                                <td>@row.CurrentStock.ToString("0.###")</td>
                                <td>@row.MinimumStock.ToString("0.###")</td>
                                <td>@row.DyeingPrice.ToString("0.0000")</td>
                                <td>@row.UnitCost.ToString("0.0000")</td>
                                <td>@row.MetersPrice.ToString("0.0000")</td>
                                <td>@row.KilogramsPrice.ToString("0.0000")</td>
                                <td>@Math.Round(Math.Max(row.CurrentStock, 0m) * Math.Max(row.MetersPrice, 0m), 2, MidpointRounding.AwayFromZero).ToString("0.00") €</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        </section>
    }
</div>

@code {
    [Parameter]
    public string Code { get; set; } = string.Empty;

    private Guid? tenantId;
    private Guid? companyId;
    private TejidoDetailDto? tejido;
    private string errorMessage = string.Empty;

    private decimal RawStockValue => tejido is null ? 0m : Math.Round(tejido.RawStockKilograms * tejido.RawCost, 2, MidpointRounding.AwayFromZero);
    private decimal FinishedStockValue => tejido is null ? 0m : Math.Round(tejido.Colors.Sum(item => Math.Max(item.CurrentStock, 0m) * Math.Max(item.MetersPrice, 0m)), 2, MidpointRounding.AwayFromZero);
    private decimal TotalStockValue => RawStockValue + FinishedStockValue;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        try
        {
            errorMessage = string.Empty;
            tejido = await TejidoQueries.GetByCodeAsync(tenantId.Value, companyId.Value, Uri.UnescapeDataString(Code));
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
    }

    private static string DisplayValue(string value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
