@page "/preview-access"
@attribute [AllowAnonymous]
@inject IOptions<PreviewAccessOptions> PreviewAccessOptions
@inject NavigationManager NavigationManager
@inject AppText T

<PageTitle>@T["preview.title"]</PageTitle>

<div class="auth-shell">
    <section class="auth-panel">
        <p class="eyebrow">@T["preview.kicker"]</p>
        <h1>@T["preview.heading"]</h1>
        <p class="lead">@T["preview.lead"]</p>

        @if (Error == "email")
        {
            <div class="alert danger">@T["preview.error.email"]</div>
        }
        else if (Error == "password")
        {
            <div class="alert danger">@T["preview.error.password"]</div>
        }
        else if (Error == "config")
        {
            <div class="alert danger">@T["preview.error.config"]</div>
        }

        <form class="auth-form" method="post" action="/preview-access/unlock">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ResolvedReturnUrl" />

            @if (RequiresEmail)
            {
                <label class="field">
                    <span>@T["preview.email"]</span>
                    <input class="text-input" name="email" type="email" autocomplete="email" placeholder="@T["preview.emailPlaceholder"]" required />
                </label>
            }

            @if (RequiresPassword)
            {
                <label class="field">
                    <span>@T["preview.password"]</span>
                    <input class="text-input" name="password" type="password" autocomplete="current-password" placeholder="@T["preview.passwordPlaceholder"]" required />
                </label>
            }

            <button class="primary-button" type="submit">@T["preview.submit"]</button>
        </form>

        <div class="stack preview-help">
            <div class="info-card">
                <h2>@T["preview.howItWorks"]</h2>
                <p class="muted">@T["preview.howItWorksText"]</p>
                @if (RequiresEmail)
                {
                    <p class="muted">@T["preview.invitationText"]</p>
                }
            </div>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private PreviewAccessOptions Options => PreviewAccessOptions.Value;
    private bool RequiresEmail => Options.RequiresEmail;
    private bool RequiresPassword => Options.RequiresPassword;
    private string ResolvedReturnUrl => string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl;

    protected override void OnInitialized()
    {
        if (!Options.Enabled)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
    }
}
