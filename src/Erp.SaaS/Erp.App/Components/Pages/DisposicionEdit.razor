            ClientReferenceCode = source.ClientReferenceCode,
            Notes = source.Notes,
            ClientColor = source.ClientColor,
            Color = source.Color,
            TotalPieces = source.TotalPieces,
            TotalKilograms = source.TotalKilograms,
            IsReceived = source.IsReceived,
            IsCancelled = source.IsCancelled,
