@page "/articulos/disposiciones/nueva"
@page "/articulos/disposiciones/editar/{Code:int}"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuditLogService AuditLogService
@inject ILegacySyncService LegacySyncService
@inject IDisposicionQueries DisposicionQueries
@inject IDisposicionService DisposicionService
@inject NavigationManager NavigationManager
@inject AppText T

<PageTitle>@(Code.HasValue ? $"{L("Editar disposición", "Editar disposició", "Edit disposition")} {Code}" : L("Nueva disposición", "Nova disposició", "New disposition"))</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("ARTÍCULOS", "ARTICLES", "ARTICLES")</p>
        <h1>@(Code.HasValue ? $"{L("Editar disposición", "Editar disposició", "Edit disposition")} {Code}" : L("Nueva disposición", "Nova disposició", "New disposition"))</h1>
        <p class="lead">@(isLegacySyncActive
            ? L("Edición sobre la SaaS local. La importación manual desde legacy refresca solo registros marcados como legacy.", "Edició sobre la SaaS local. La importació manual des de legacy refresca només registres marcats com a legacy.", "Editing on the local SaaS copy. Manual import from legacy refreshes only records marked as legacy.")
            : L("Alta y edición sobre la réplica local de disposiciones, filtrada por la empresa activa.", "Alta i edició sobre la rèplica local de disposicions, filtrada per l'empresa activa.", "Create and edit on the local dispositions replica, filtered by the active company."))</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="/articulos/disposiciones">@L("Volver al listado", "Tornar al llistat", "Back to list")</a>
        @if (Code.HasValue)
        {
            @if (canEdit && !model.IsCancelled)
            {
                <a class="secondary-button link-button" href="@BuildParteAcabadoUrl()">@L("Crear parte de acabado", "Crear part d'acabat", "Create finish order")</a>
            }
            <a class="secondary-button link-button" href="/articulos/disposiciones/@Code/imprimir" target="_blank" rel="noopener noreferrer">@L("Imprimir ficha", "Imprimir fitxa", "Print sheet")</a>
        }
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
    }

    @if (isLegacySyncActive)
    {
        <div class="alert">
            @L("Artículos / Disposiciones está en convivencia con legacy para esta empresa.", "Articles / Disposicions està en convivència amb legacy per a aquesta empresa.", "Articles / Dispositions is running in coexistence with legacy for this company.")
            @L("Esta ficha guarda cambios solo en la SaaS local y la sync manual refresca únicamente registros de origen legacy.", "Aquesta fitxa desa canvis només a la SaaS local i la sync manual refresca únicament registres d'origen legacy.", "This sheet saves changes only in the local SaaS and manual sync refreshes only legacy-origin records.")
            @L("Guardar una disposición sincronizada la convierte en local.", "Desar una disposició sincronitzada la converteix en local.", "Saving a synced disposition converts it to local.")
            @if (!string.IsNullOrWhiteSpace(syncStatusLabel))
            {
                <span>@syncStatusLabel</span>
            }
        </div>
    }

    @if (!canEdit && !Code.HasValue)
    {
        <div class="alert">
            @L("No tienes permisos de edición para crear disposiciones nuevas en esta empresa.", "No tens permisos d'edició per crear disposicions noves en aquesta empresa.", "You do not have edit permissions to create new dispositions in this company.")
        </div>
    }

    <section class="card-grid">
        <article class="info-card">
            <p class="eyebrow">@L("Número visible", "Número visible", "Visible number")</p>
            <h2>@VisibleNumber</h2>
            <p class="muted">@L("Identificador de trabajo usado en la ficha.", "Identificador de treball usat a la fitxa.", "Work identifier used on this sheet.")</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Origen", "Origen", "Origin")</p>
            <h2>@DisplayOrigin</h2>
            <p class="muted">@L("Los cambios web pasan a origen local.", "Els canvis web passen a origen local.", "Web changes become local origin.")</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Totales", "Totals", "Totals")</p>
            <h2>@model.TotalKilograms.ToUiString("0.##") kg</h2>
            <p class="muted">@model.TotalPieces.ToUiString("0.##") @L("piezas", "peces", "pieces") · @model.Lines.Count @L("líneas", "línies", "lines")</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Estado", "Estat", "Status")</p>
            <h2>@StatusLabel</h2>
            <p class="muted">@L("Recepción y anulación de la disposición.", "Recepció i anul·lació de la disposició.", "Receipt and cancellation status of the disposition.")</p>
        </article>
    </section>

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <fieldset disabled="@isReadOnly">
            <div class="form-grid" style="margin-top: 1rem;">
                <label class="field">
                    <span>@L("Año / serie", "Any / sèrie", "Year / series")</span>
                    <InputText class="text-input" @bind-Value="model.Year" />
                </label>
                <label class="field">
                    <span>@L("Número", "Número", "Number")</span>
                    <InputNumber class="text-input" @bind-Value="model.Number" />
                </label>
                <label class="field">
                    <span>@L("Fecha", "Data", "Date")</span>
                    <InputDate TValue="DateTime?" class="text-input" @bind-Value="model.Date" />
                </label>
                <label class="field">
                    <span>@L("Recepción", "Recepció", "Receipt")</span>
                    <InputDate TValue="DateTime?" class="text-input" @bind-Value="model.ReceptionDate" />
                </label>
                <label class="field">
                    <span>@L("Cliente", "Client", "Customer")</span>
                    <InputNumber class="text-input" @bind-Value="model.ClientCode" />
                </label>
                <label class="field wide">
                    <span>@L("Nombre cliente", "Nom client", "Customer name")</span>
                    <InputText class="text-input" @bind-Value="model.ClientName" disabled />
                </label>
                <label class="field">
                    <span>@L("Acabador", "Acabador", "Finisher")</span>
                    <InputNumber class="text-input" @bind-Value="model.FinisherCode" />
                </label>
                <label class="field wide">
                    <span>@L("Nombre acabador", "Nom acabador", "Finisher name")</span>
                    <InputText class="text-input" @bind-Value="model.FinisherName" disabled />
                </label>
                <label class="field">
                    <span>@L("Código cliente", "Codi client", "Customer code")</span>
                    <InputText class="text-input" @bind-Value="model.ClientReferenceCode" />
                </label>
                <label class="field">
                    <span>@L("Color", "Color", "Color")</span>
                    <InputText class="text-input" @bind-Value="model.Color" />
                </label>
                <label class="field">
                    <span>@L("Color cliente", "Color client", "Customer color")</span>
                    <InputText class="text-input" @bind-Value="model.ClientColor" />
                </label>
                <label class="field">
                    <span>@L("Comanda", "Comanda", "Order ref.")</span>
                    <InputText class="text-input" @bind-Value="model.OrderReference" />
                </label>
                <label class="field checkbox-field">
                    <span>@L("Recibido", "Rebut", "Received")</span>
                    <input type="checkbox" checked="@model.IsReceived" @onchange="OnReceivedChanged" />
                </label>
                <label class="field checkbox-field">
                    <span>@L("Anulada", "Anul·lada", "Cancelled")</span>
                    <input type="checkbox" checked="@model.IsCancelled" @onchange="OnCancelledChanged" />
                </label>
                <label class="field wide">
                    <span>@L("Observaciones", "Observacions", "Notes")</span>
                    <InputTextArea class="text-input textarea-input" @bind-Value="model.Notes" />
                </label>
            </div>

            <section class="panel detail-panel" style="margin-top: 1rem;">
                <div class="detail-panel-header">
                    <div>
                        <h2>@L("Líneas de disposición", "Línies de disposició", "Disposition lines")</h2>
                        <p class="muted">@L("Tejedor, tejido, piezas, kg, acabado y estado por línea.", "Teixidor, teixit, peces, kg, acabat i estat per línia.", "Weaver, fabric, pieces, kg, finish and status per line.")</p>
                    </div>
                    @if (!isReadOnly)
                    {
                        <button class="secondary-button" type="button" @onclick="AddLine">@L("Añadir línea", "Afegir línia", "Add line")</button>
                    }
                </div>

                <div class="table-scroll">
                    <table class="data-table detail-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>@L("Descripción", "Descripció", "Description")</th>
                                <th>@L("Tejedor", "Teixidor", "Weaver")</th>
                                <th>@L("Alb.", "Alb.", "Ship.")</th>
                                <th>@L("Tejido", "Teixit", "Fabric")</th>
                                <th>@L("Composición", "Composició", "Composition")</th>
                                <th>@L("Piezas", "Peces", "Pieces")</th>
                                <th>@L("Total piezas", "Total peces", "Total pieces")</th>
                                <th>Kg</th>
                                <th>@L("Acabado", "Acabat", "Finish")</th>
                                <th>@L("Ancho", "Ample", "Width")</th>
                                <th>@L("Gramaje", "Gramatge", "Weight")</th>
                                <th>@L("Rdto.", "Rdt.", "Yield")</th>
                                <th>@L("Servido", "Servit", "Served")</th>
                                <th>@L("Dispuesto", "Disposat", "Prepared")</th>
                                <th>@L("Acciones", "Accions", "Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (model.Lines.Count == 0)
                            {
                                <tr>
                                    <td colspan="16" class="muted">@L("No hay líneas cargadas para esta disposición.", "No hi ha línies carregades per a aquesta disposició.", "There are no lines loaded for this disposition.")</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var line in model.Lines.OrderBy(item => item.LineNumber))
                                {
                                    <tr @key="line.LineNumber">
                                        <td>@line.LineNumber</td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.Description" /></td>
                                        <td><InputNumber class="text-input table-input" @bind-Value="line.WeaverCode" /></td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.DeliveryNoteNumber" /></td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.FabricCode" /></td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.CompositionText" /></td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.PiecesText" /></td>
                                        <td><InputNumber class="text-input table-input" @bind-Value="line.TotalPieces" /></td>
                                        <td><InputNumber class="text-input table-input" @bind-Value="line.TotalKilograms" disabled="@(line.IsDisposed || line.IsServed)" /></td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.FinishText" /></td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.WidthText" /></td>
                                        <td><InputNumber class="text-input table-input" @bind-Value="line.GramWeight" /></td>
                                        <td><InputNumber class="text-input table-input" @bind-Value="line.Yield" /></td>
                                        <td><input type="checkbox" checked="@line.IsServed" @onchange="args => OnServedChanged(line, args)" /></td>
                                        <td><input type="checkbox" checked="@line.IsDisposed" @onchange="args => OnDisposedChanged(line, args)" /></td>
                                        <td>
                                            <div class="inline-action-list">
                                                @if (!string.IsNullOrWhiteSpace(line.FabricCode))
                                                {
                                                    <a class="inline-link" href="@BuildTejidoUrl(line)">@L("Tejido", "Teixit", "Fabric")</a>
                                                    <a class="inline-link" href="@BuildMovementsUrl(line)">@L("Movs.", "Movs.", "Moves")</a>
                                                }
                                                @if (!isReadOnly)
                                                {
                                                    <button class="danger-link" type="button" @onclick="() => RemoveLine(line.LineNumber)">@L("Quitar", "Treure", "Remove")</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="panel" style="margin-top: 1rem;">
                <div class="detail-panel-header">
                    <div>
                        <h2>@L("Movimientos de stock generados", "Moviments d'estoc generats", "Generated stock movements")</h2>
                        <p class="muted">@L("Comparativa entre lo ya guardado y lo que quedará al guardar esta disposición.", "Comparativa entre allò ja desat i el que quedarà en desar aquesta disposició.", "Comparison between what is already saved and what will remain after saving this disposition.")</p>
                    </div>
                </div>

                @if (StockMovementSummaries.Count == 0)
                {
                    <p class="muted">@L("Todavía no hay movimientos de stock activos en esta disposición.", "Encara no hi ha moviments d'estoc actius en aquesta disposició.", "There are no active stock movements yet for this disposition.")</p>
                }
                else
                {
                    <div class="stock-summary-status-grid">
                        <article class="stock-summary-status-card active">
                            <strong>@StockMovementSummaries.Count(item => item.Status == StockMovementSummaryStatus.Active)</strong>
                            <span>@L("Activos", "Actius", "Active")</span>
                        </article>
                        <article class="stock-summary-status-card pending">
                            <strong>@StockMovementSummaries.Count(item => item.Status == StockMovementSummaryStatus.Pending)</strong>
                            <span>@L("Pendientes de guardar", "Pendents de desar", "Pending save")</span>
                        </article>
                        <article class="stock-summary-status-card reverted">
                            <strong>@StockMovementSummaries.Count(item => item.Status == StockMovementSummaryStatus.Reverted)</strong>
                            <span>@L("Revertidos", "Revertits", "Reverted")</span>
                        </article>
                    </div>

                    <div class="list-block">
                        @foreach (var movement in StockMovementSummaries)
                        {
                            <article class="list-item stock-summary-item @movement.CssClass">
                                <div class="stock-summary-item-header">
                                    <strong>@movement.Title</strong>
                                    <span class="stock-summary-badge @movement.CssClass">@GetStockMovementStatusLabel(movement.Status)</span>
                                </div>
                                <span>@movement.Description</span>
                            </article>
                        }
                    </div>
                }
            </section>

            <div class="quick-links" style="margin-top: 1rem;">
                @if (canEdit)
                {
                    <button class="primary-button" type="submit">@L("Guardar disposición", "Desar disposició", "Save disposition")</button>
                }
                @if (canEdit && Code.HasValue)
                {
                    <button class="secondary-button danger-button" type="button" @onclick="DeleteAsync">@L("Eliminar disposición", "Eliminar disposició", "Delete disposition")</button>
                }
                @if (Code.HasValue)
                {
                    <button class="secondary-button" type="button" @onclick="LoadAuditAsync">@L("Recargar historial", "Recarregar historial", "Reload history")</button>
                }
            </div>
        </fieldset>
    </EditForm>

    @if (Code.HasValue)
    {
        <section class="panel" style="margin-top: 1rem;">
            <h2>@L("Historial reciente de la disposición", "Historial recent de la disposició", "Recent disposition history")</h2>
            <div class="list-block">
                @if (recentAuditLogs.Count == 0)
                {
                    <p class="muted">@L("Todavía no hay eventos auditados para esta disposición.", "Encara no hi ha esdeveniments auditats per a aquesta disposició.", "There are no audited events yet for this disposition.")</p>
                }
                else
                {
                    @foreach (var entry in recentAuditLogs)
                    {
                        <article class="list-item">
                            <strong>@entry.Action</strong>
                            @if (!string.IsNullOrWhiteSpace(entry.Details))
                            {
                                <span>@entry.Details</span>
                            }
                            <span>@entry.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </article>
                    }
                }
            </div>
        </section>
    }
}

@code {
    [Parameter]
    public int? Code { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isReadOnly;
    private DisposicionDetailDto model = new();
    private DisposicionDetailDto originalModel = new();
    private string statusMessage = string.Empty;
    private bool isError;
    private bool isLegacySyncActive;
    private string syncStatusLabel = string.Empty;
    private IReadOnlyCollection<AuditLogEntryDto> recentAuditLogs = [];
    private enum StockMovementSummaryStatus
    {
        Active,
        Pending,
        Reverted
    }

    private sealed record StockMovementSummary(string Title, string Description, StockMovementSummaryStatus Status)
    {
        public string CssClass => Status switch
        {
            StockMovementSummaryStatus.Active => "active",
            StockMovementSummaryStatus.Pending => "pending",
            StockMovementSummaryStatus.Reverted => "reverted",
            _ => string.Empty
        };
    }

    private string VisibleNumber => FormatVisibleNumber(model.Number, model.Year);
    private string DisplayOrigin => string.IsNullOrWhiteSpace(model.Origin) ? L("local", "local", "local") : model.Origin;
    private string StatusLabel => model.IsCancelled ? L("Anulada", "Anul·lada", "Cancelled") : model.IsReceived ? L("Recibida", "Rebuda", "Received") : L("Pendiente", "Pendent", "Pending");
    private IReadOnlyList<StockMovementSummary> StockMovementSummaries => BuildStockMovementSummaries();
    private string GetStockMovementStatusLabel(StockMovementSummaryStatus status) => status switch
    {
        StockMovementSummaryStatus.Active => L("Activo", "Actiu", "Active"),
        StockMovementSummaryStatus.Pending => L("Pendiente", "Pendent", "Pending"),
        StockMovementSummaryStatus.Reverted => L("Revertido", "Revertit", "Reverted"),
        _ => string.Empty
    };
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        await LoadSyncStatusAsync();
        isReadOnly = !canEdit;

        if (Code.HasValue)
        {
            var detail = await DisposicionQueries.GetByCodeAsync(tenantId.Value, companyId.Value, Code.Value);
            if (detail is null)
            {
                statusMessage = L("No se ha encontrado la disposición solicitada.", "No s'ha trobat la disposició sol·licitada.", "The requested disposition could not be found.");
                isError = true;
                model = new DisposicionDetailDto();
                originalModel = new DisposicionDetailDto();
                recentAuditLogs = [];
                return;
            }

            model = detail;
            originalModel = CloneDetail(detail);
            await LoadAuditAsync();
        }
        else
        {
            model = new DisposicionDetailDto
            {
                Year = DateTime.Today.Year.ToString(),
                Date = DateTime.Today
            };
            originalModel = CloneDetail(model);
            recentAuditLogs = [];
        }
    }

    private async Task SaveAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        if (isReadOnly)
        {
            statusMessage = L("No tienes permisos de edición en este tenant.", "No tens permisos d'edició en aquest tenant.", "You do not have edit permissions in this tenant.");
            isError = true;
            return;
        }

        try
        {
            statusMessage = string.Empty;
            isError = false;

            var savedCode = await DisposicionService.SaveAsync(new SaveDisposicionCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                Code = Code,
                Year = model.Year,
                Number = model.Number,
                Date = model.Date,
                ReceptionDate = model.ReceptionDate,
                FinisherCode = model.FinisherCode,
                ClientCode = model.ClientCode,
                ClientReferenceCode = model.ClientReferenceCode,
                Notes = model.Notes,
                ClientColor = model.ClientColor,
                Color = model.Color,
                OrderReference = model.OrderReference,
                IsReceived = model.IsReceived,
                IsCancelled = model.IsCancelled,
                Lines = model.Lines
                    .OrderBy(item => item.LineNumber)
                    .Select(item => new SaveDisposicionLineInput
                    {
                        LineNumber = item.LineNumber,
                        Description = item.Description,
                        WeaverCode = item.WeaverCode,
                        DeliveryNoteNumber = item.DeliveryNoteNumber,
                        FabricCode = item.FabricCode,
                        CompositionText = item.CompositionText,
                        PiecesText = item.PiecesText,
                        TotalPieces = item.TotalPieces,
                        TotalKilograms = item.TotalKilograms,
                        FinishText = item.FinishText,
                        WidthText = item.WidthText,
                        GramWeight = item.GramWeight,
                        Yield = item.Yield,
                        IsServed = item.IsServed,
                        IsDisposed = item.IsDisposed
                    })
                    .ToList()
            });

            statusMessage = Code.HasValue
                ? L("Disposición actualizada correctamente.", "Disposició actualitzada correctament.", "Disposition updated successfully.")
                : L("Disposición creada correctamente.", "Disposició creada correctament.", "Disposition created successfully.");

            if (!Code.HasValue)
            {
                NavigationManager.NavigateTo($"/articulos/disposiciones/editar/{savedCode}", forceLoad: false);
                return;
            }

            model.TotalPieces = model.Lines.Sum(item => item.TotalPieces);
            model.TotalKilograms = model.Lines.Sum(item => item.TotalKilograms);
            model.Origin = "local";
            originalModel = CloneDetail(model);
            await LoadAuditAsync();
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private async Task DeleteAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !Code.HasValue)
        {
            return;
        }

        try
        {
            await DisposicionService.DeleteAsync(tenantId.Value, companyId.Value, Code.Value);
            NavigationManager.NavigateTo("/articulos/disposiciones", forceLoad: false);
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private void AddLine()
    {
        var nextLine = model.Lines.Count == 0 ? 1 : model.Lines.Max(item => item.LineNumber) + 1;
        model.Lines.Add(new DisposicionLineDto
        {
            LineNumber = nextLine
        });
    }

    private void RemoveLine(int lineNumber)
    {
        var line = model.Lines.FirstOrDefault(item => item.LineNumber == lineNumber);
        if (line is null)
        {
            return;
        }

        model.Lines.Remove(line);
        model.TotalPieces = model.Lines.Sum(item => item.TotalPieces);
        model.TotalKilograms = model.Lines.Sum(item => item.TotalKilograms);
    }

    private void OnCancelledChanged(ChangeEventArgs args)
    {
        statusMessage = string.Empty;
        isError = false;
        model.IsCancelled = args.Value is bool value && value;
        if (model.IsCancelled)
        {
            model.IsReceived = false;
            model.ReceptionDate = null;
        }
    }

    private void OnReceivedChanged(ChangeEventArgs args)
    {
        statusMessage = string.Empty;
        isError = false;
        var isChecked = args.Value is bool value && value;
        if (!isChecked)
        {
            model.IsReceived = false;
            model.ReceptionDate = null;
            return;
        }

        if (model.Lines.Any(item => !item.IsServed))
        {
            model.IsReceived = false;
            model.ReceptionDate = null;
            statusMessage = L("Para marcar la disposición como recibida, todas las líneas deben estar servidas.", "Per marcar la disposició com a rebuda, totes les línies han d'estar servides.", "To mark the disposition as received, all lines must be served.");
            isError = true;
            return;
        }

        model.IsReceived = true;
        model.IsCancelled = false;
        model.ReceptionDate ??= model.Date ?? DateTime.Today;
    }

    private void OnDisposedChanged(DisposicionLineDto line, ChangeEventArgs args)
    {
        statusMessage = string.Empty;
        isError = false;
        line.IsDisposed = args.Value is bool value && value;
        if (!line.IsDisposed && line.IsServed)
        {
            line.IsServed = false;
        }

        if (model.IsReceived && model.Lines.Any(item => !item.IsServed))
        {
            model.IsReceived = false;
            model.ReceptionDate = null;
        }
    }

    private void OnServedChanged(DisposicionLineDto line, ChangeEventArgs args)
    {
        statusMessage = string.Empty;
        isError = false;
        var isChecked = args.Value is bool value && value;
        if (isChecked && !line.IsDisposed)
        {
            line.IsServed = false;
            statusMessage = L($"Primero debes marcar como dispuesta la línea {line.LineNumber}.", $"Primer has de marcar com a disposada la línia {line.LineNumber}.", $"You must first mark line {line.LineNumber} as prepared.");
            isError = true;
            return;
        }

        line.IsServed = isChecked;
        if (model.IsReceived && model.Lines.Any(item => !item.IsServed))
        {
            model.IsReceived = false;
            model.ReceptionDate = null;
        }
    }

    private async Task LoadSyncStatusAsync()
    {
        isLegacySyncActive = false;
        syncStatusLabel = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var status = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
            .FirstOrDefault(item =>
                item.CompanyId == companyId.Value &&
                string.Equals(item.ModuleKey, LegacySyncModuleKeys.ArticleDispositions, StringComparison.OrdinalIgnoreCase));

        if (status is null || !status.HasSuccessfulSync)
        {
            return;
        }

        isLegacySyncActive = true;
        syncStatusLabel = status.LastCompletedUtc.HasValue
            ? $"{L("Última sync", "Última sync", "Last sync")}: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Act: {status.LastUpdated} · Omi: {status.LastSkipped} · Err: {status.LastErrors}"
            : $"{L("Estado", "Estat", "Status")}: {status.LastStatus}";
    }

    private async Task LoadAuditAsync()
    {
        if (!tenantId.HasValue || !Code.HasValue)
        {
            recentAuditLogs = [];
            return;
        }

        recentAuditLogs = await AuditLogService.GetRecentAsync(
            limit: 15,
            tenantId: tenantId.Value,
            entityName: "Disposicion",
            entityId: Code.Value.ToString());
    }

    private string BuildTejidoUrl(DisposicionLineDto line) =>
        string.IsNullOrWhiteSpace(line.FabricCode)
            ? string.Empty
            : $"/articulos/tejidos/editar/{Uri.EscapeDataString(line.FabricCode.Trim())}";

    private string BuildMovementsUrl(DisposicionLineDto line)
    {
        if (string.IsNullOrWhiteSpace(line.FabricCode))
        {
            return string.Empty;
        }

        var search = string.IsNullOrWhiteSpace(model.Color)
            ? line.FabricCode.Trim()
            : $"{line.FabricCode.Trim()} {model.Color.Trim()}";

        return $"/almacen/movimientos?search={Uri.EscapeDataString(search)}";
    }

    private string BuildParteAcabadoUrl() =>
        Code.HasValue ? $"/produccion/acabados/nueva?disposicionCode={Code.Value}" : "/produccion/acabados/nueva";

    private IReadOnlyList<StockMovementSummary> BuildStockMovementSummaries()
    {
        var items = new List<StockMovementSummary>();
        var currentByLine = model.Lines.ToDictionary(item => item.LineNumber);
        var originalByLine = originalModel.Lines.ToDictionary(item => item.LineNumber);
        var lineNumbers = currentByLine.Keys
            .Concat(originalByLine.Keys)
            .Distinct()
            .OrderBy(item => item);

        foreach (var lineNumber in lineNumbers)
        {
            var hasCurrent = currentByLine.TryGetValue(lineNumber, out var currentLine);
            var hasOriginal = originalByLine.TryGetValue(lineNumber, out var originalLine);

            var effectiveLine = currentLine ?? originalLine;
            if (effectiveLine is null || string.IsNullOrWhiteSpace(effectiveLine.FabricCode) || effectiveLine.TotalKilograms <= 0)
            {
                continue;
            }

            var currentColor = string.IsNullOrWhiteSpace(model.Color) ? L("sin color", "sense color", "no color") : model.Color.Trim();
            var originalColor = string.IsNullOrWhiteSpace(originalModel.Color) ? currentColor : originalModel.Color.Trim();
            var meters = CalculateMeters(effectiveLine.TotalKilograms, effectiveLine.Yield);
            var currentDisposed = hasCurrent && currentLine!.IsDisposed;
            var originalDisposed = hasOriginal && originalLine!.IsDisposed;
            var currentServed = hasCurrent && currentLine!.IsServed;
            var originalServed = hasOriginal && originalLine!.IsServed;

            if (currentDisposed && originalDisposed)
            {
                items.Add(new StockMovementSummary(
                    L($"Línea {lineNumber}: crudo -> dispuesto", $"Línia {lineNumber}: cru -> disposat", $"Line {lineNumber}: raw -> prepared"),
                    L($"Tejido {effectiveLine.FabricCode}: {effectiveLine.TotalKilograms.ToUiString("0.##")} kg y {meters.ToUiString("0.##")} m ya están en stock dispuesto.", $"Teixit {effectiveLine.FabricCode}: {effectiveLine.TotalKilograms.ToUiString("0.##")} kg i {meters.ToUiString("0.##")} m ja són a l'estoc disposat.", $"Fabric {effectiveLine.FabricCode}: {effectiveLine.TotalKilograms.ToUiString("0.##")} kg and {meters.ToUiString("0.##")} m are already in prepared stock."),
                    StockMovementSummaryStatus.Active));
            }

            if (currentDisposed && !originalDisposed)
            {
                items.Add(new StockMovementSummary(
                    L($"Línea {lineNumber}: crudo -> dispuesto", $"Línia {lineNumber}: cru -> disposat", $"Line {lineNumber}: raw -> prepared"),
                    L($"Tejido {effectiveLine.FabricCode}: al guardar se moverán {effectiveLine.TotalKilograms.ToUiString("0.##")} kg y {meters.ToUiString("0.##")} m a stock dispuesto.", $"Teixit {effectiveLine.FabricCode}: en desar es mouran {effectiveLine.TotalKilograms.ToUiString("0.##")} kg i {meters.ToUiString("0.##")} m a l'estoc disposat.", $"Fabric {effectiveLine.FabricCode}: saving will move {effectiveLine.TotalKilograms.ToUiString("0.##")} kg and {meters.ToUiString("0.##")} m into prepared stock."),
                    StockMovementSummaryStatus.Pending));
            }

            if (!currentDisposed && originalDisposed)
            {
                items.Add(new StockMovementSummary(
                    L($"Línea {lineNumber}: crudo -> dispuesto", $"Línia {lineNumber}: cru -> disposat", $"Line {lineNumber}: raw -> prepared"),
                    L($"Tejido {effectiveLine.FabricCode}: al guardar se revertirán {effectiveLine.TotalKilograms.ToUiString("0.##")} kg y {meters.ToUiString("0.##")} m desde stock dispuesto hacia crudo.", $"Teixit {effectiveLine.FabricCode}: en desar es revertiran {effectiveLine.TotalKilograms.ToUiString("0.##")} kg i {meters.ToUiString("0.##")} m des de l'estoc disposat cap al cru.", $"Fabric {effectiveLine.FabricCode}: saving will revert {effectiveLine.TotalKilograms.ToUiString("0.##")} kg and {meters.ToUiString("0.##")} m from prepared stock back to raw."),
                    StockMovementSummaryStatus.Reverted));
            }

            if (currentServed && originalServed)
            {
                items.Add(new StockMovementSummary(
                    L($"Línea {lineNumber}: dispuesto -> color", $"Línia {lineNumber}: disposat -> color", $"Line {lineNumber}: prepared -> color"),
                    L($"Tejido {effectiveLine.FabricCode}, color {currentColor}: el movimiento a color ya está activo con {meters.ToUiString("0.##")} m.", $"Teixit {effectiveLine.FabricCode}, color {currentColor}: el moviment a color ja és actiu amb {meters.ToUiString("0.##")} m.", $"Fabric {effectiveLine.FabricCode}, color {currentColor}: the move to color is already active with {meters.ToUiString("0.##")} m."),
                    StockMovementSummaryStatus.Active));
            }

            if (currentServed && !originalServed)
            {
                items.Add(new StockMovementSummary(
                    L($"Línea {lineNumber}: dispuesto -> color", $"Línia {lineNumber}: disposat -> color", $"Line {lineNumber}: prepared -> color"),
                    L($"Tejido {effectiveLine.FabricCode}, color {currentColor}: al guardar se añadirán {meters.ToUiString("0.##")} m al stock del color.", $"Teixit {effectiveLine.FabricCode}, color {currentColor}: en desar s'afegiran {meters.ToUiString("0.##")} m a l'estoc del color.", $"Fabric {effectiveLine.FabricCode}, color {currentColor}: saving will add {meters.ToUiString("0.##")} m to the color stock."),
                    StockMovementSummaryStatus.Pending));
            }

            if (!currentServed && originalServed)
            {
                items.Add(new StockMovementSummary(
                    L($"Línea {lineNumber}: dispuesto -> color", $"Línia {lineNumber}: disposat -> color", $"Line {lineNumber}: prepared -> color"),
                    L($"Tejido {effectiveLine.FabricCode}, color {originalColor}: al guardar se revertirán {meters.ToUiString("0.##")} m desde el color hacia stock dispuesto.", $"Teixit {effectiveLine.FabricCode}, color {originalColor}: en desar es revertiran {meters.ToUiString("0.##")} m des del color cap a l'estoc disposat.", $"Fabric {effectiveLine.FabricCode}, color {originalColor}: saving will revert {meters.ToUiString("0.##")} m from the color back to prepared stock."),
                    StockMovementSummaryStatus.Reverted));
            }
        }

        return items;
    }

    private static decimal CalculateMeters(decimal kilograms, decimal yield)
    {
        var effectiveYield = yield == 0 ? 1m : yield;
        return Math.Round(kilograms * effectiveYield, 2, MidpointRounding.AwayFromZero);
    }

    private static string FormatVisibleNumber(int number, string year) =>
        string.IsNullOrWhiteSpace(year) ? number.ToString() : $"{number}-{year}";

