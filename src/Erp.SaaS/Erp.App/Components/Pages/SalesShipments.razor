@page "/ventas/albaranes"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ISalesOrderQueries SalesOrderQueries
@inject ILegacySyncService LegacySyncService
@inject AppText T

<PageTitle>@L("Ventas / Albaranes", "Vendes / Albarans", "Sales / Shipments")</PageTitle>

<div class="page-header">
        <div>
            <p class="eyebrow">@L("Ventas", "Vendes", "Sales")</p>
            <h1>@L("Albaranes de cliente", "Albarans de client", "Customer shipments")</h1>
            <p class="lead">@L("Salidas documentales generadas desde pedidos de cliente y listas para el siguiente paso a facturación.", "Sortides documentals generades des de comandes de client i llestes per al següent pas a facturació.", "Document shipments generated from customer orders and ready for the next invoicing step.")</p>
        </div>
        <div class="quick-links">
            <a class="secondary-button link-button" href="/ventas/pre-facturacion">@L("Abrir pre-facturación", "Obrir pre-facturació", "Open pre-invoicing")</a>
        </div>
    </div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("Selecciona una empresa activa para revisar albaranes de venta.", "Selecciona una empresa activa per revisar albarans de venda.", "Select an active company to review sales shipments.")</p>
    </div>
}
else
{
    @if (syncStatus?.HasSuccessfulSync == true)
    {
        <div class="alert warning">
            @L("Ventas / Albaranes está en convivencia con legacy para esta empresa. La sync manual refresca solo los albaranes con origen legacy; los cambios locales posteriores ya no se sobrescriben.", "Vendes / Albarans està en convivència amb legacy per a aquesta empresa. La sync manual refresca només els albarans amb origen legacy; els canvis locals posteriors ja no se sobreescriuen.", "Sales / Shipments is running in legacy coexistence mode for this company. Manual sync refreshes only legacy-origin shipments; later local changes are no longer overwritten.")
            @if (syncStatus.LastCompletedUtc.HasValue)
            {
                <span>@L("Última sync:", "Última sync:", "Last sync:") @syncStatus.LastCompletedUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") · Ins: @syncStatus.LastInserted · Act: @syncStatus.LastUpdated · Omi: @syncStatus.LastSkipped · Err: @syncStatus.LastErrors</span>
            }
        </div>
    }

    <section class="panel">
        <div class="filter-row">
            <input class="text-input" @bind="filter.Search" placeholder="@L("Buscar por albarán, pedido, cliente, almacén o notas", "Buscar per albarà, comanda, client, magatzem o notes", "Search by shipment, order, client, warehouse or notes")" disabled="@isLoading" />
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? L("Cargando...", "Carregant...", "Loading...") : L("Buscar", "Buscar", "Search"))</button>
        </div>
        <div class="filter-row results-toolbar" style="margin-top: 0.85rem;">
            <span class="results-summary">
                @(totalCount == 0
                    ? L("Sin resultados", "Sense resultats", "No results")
                    : L($"Mostrando {PageStart}-{PageEnd} de {totalCount} albaranes", $"Mostrant {PageStart}-{PageEnd} de {totalCount} albarans", $"Showing {PageStart}-{PageEnd} of {totalCount} shipments"))
            </span>
            <label class="field compact-field">
                <span>@L("Tamaño de página", "Mida de pàgina", "Page size")</span>
                <select class="sidebar-select compact-select" value="@filter.PageSize" @onchange="OnPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)">
        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>@L("Cargando albaranes de cliente...", "Carregant albarans de client...", "Loading customer shipments...")</span>
            </div>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <SortableHeader Label="@L("Albarán", "Albarà", "Shipment")" IsActive="@(sortColumn == nameof(SalesOrderShipmentDto.ShipmentNumber))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderShipmentDto.ShipmentNumber), true))" />
                    <SortableHeader Label="@L("Pedido", "Comanda", "Order")" IsActive="@(sortColumn == nameof(SalesOrderShipmentDto.OrderNumber))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderShipmentDto.OrderNumber), true))" />
                    <SortableHeader Label="@L("Cliente", "Client", "Client")" IsActive="@(sortColumn == nameof(SalesOrderShipmentDto.ClientName))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderShipmentDto.ClientName)))" />
                    <SortableHeader Label="@L("Fecha", "Data", "Date")" IsActive="@(sortColumn == nameof(SalesOrderShipmentDto.ShipmentDate))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderShipmentDto.ShipmentDate), true))" />
                    <SortableHeader Label="@L("Almacén", "Magatzem", "Warehouse")" IsActive="@(sortColumn == nameof(SalesOrderShipmentDto.Warehouse))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderShipmentDto.Warehouse)))" />
                    <SortableHeader Label="@L("Cantidad", "Quantitat", "Quantity")" IsActive="@(sortColumn == nameof(SalesOrderShipmentDto.TotalShippedQuantity))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderShipmentDto.TotalShippedQuantity), true))" />
                    <SortableHeader Label="@L("Facturación", "Facturació", "Invoicing")" IsActive="@(sortColumn == nameof(SalesOrderShipmentDto.InvoiceStatus))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderShipmentDto.InvoiceStatus)))" />
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    @for (var index = 0; index < 5; index++)
                    {
                        <tr class="table-skeleton-row">
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                        </tr>
                    }
                }
                else if (items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="table-empty">@L("No hay albaranes para mostrar.", "No hi ha albarans per mostrar.", "There are no shipments to show.")</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.DisplayNumber</td>
                            <td>@item.OrderNumber</td>
                            <td>@item.ClientName</td>
                            <td>@item.ShipmentDate.ToString("dd/MM/yyyy")</td>
                            <td>@DisplayValue(item.Warehouse)</td>
                            <td>@item.TotalShippedQuantity.ToString("0.###")</td>
                            <td>
                                <span class="status-pill @GetInvoiceStatusClass(item.InvoiceStatus)">@FormatInvoiceStatus(item.InvoiceStatus)</span>
                                @if (!string.IsNullOrWhiteSpace(item.InvoiceDisplayNumber))
                                {
                                    <div class="table-subtitle">@item.InvoiceDisplayNumber</div>
                                }
                            </td>
                            <td>
                                <div class="table-actions">
                                    <a class="inline-link" href="/ventas/albaranes/@item.ShipmentNumber">@L("Ver documento", "Veure document", "View document")</a>
                                    <a class="inline-link" href="/ventas/albaranes/@item.ShipmentNumber/pdf" target="_blank">PDF</a>
                                    @if (item.InvoiceNumber is int invoiceNumber)
                                    {
                                        <a class="inline-link" href="/ventas/facturas/@invoiceNumber">@L("Factura", "Factura", "Invoice")</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="pagination-bar">
            <span class="muted">@L($"Página {filter.Page} de {TotalPages}", $"Pàgina {filter.Page} de {TotalPages}", $"Page {filter.Page} of {TotalPages}")</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePageAsync(1)" disabled="@(!CanGoPrevious || isLoading)">@L("Primera", "Primera", "First")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page - 1)" disabled="@(!CanGoPrevious || isLoading)">@L("Anterior", "Anterior", "Previous")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page + 1)" disabled="@(!CanGoNext || isLoading)">@L("Siguiente", "Següent", "Next")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(TotalPages)" disabled="@(!CanGoNext || isLoading)">@L("Última", "Última", "Last")</button>
            </div>
        </div>
    </section>
}

@code {
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    [SupplyParameterFromQuery(Name = "q")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? PageSizeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortQuery { get; set; }

    [SupplyParameterFromQuery(Name = "desc")]
    public bool? DescQuery { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool isLoading;
    private SalesOrderFilter filter = new() { Page = 1, PageSize = 25, SortColumn = nameof(SalesOrderShipmentDto.ShipmentNumber), SortDescending = true };
    private IReadOnlyCollection<SalesOrderShipmentDto> items = [];
    private string errorMessage = string.Empty;
    private LegacySyncModuleStatusDto? syncStatus;
    private string sortColumn = nameof(SalesOrderShipmentDto.ShipmentNumber);
    private bool sortDescending = true;
    private int totalCount;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)filter.PageSize));
    private bool CanGoPrevious => filter.Page > 1;
    private bool CanGoNext => filter.Page < TotalPages;
    private int PageStart => totalCount == 0 ? 0 : ((filter.Page - 1) * filter.PageSize) + 1;
    private int PageEnd => totalCount == 0 ? 0 : Math.Min(filter.Page * filter.PageSize, totalCount);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        if (tenantId.HasValue && companyId.HasValue)
        {
            syncStatus = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
                .FirstOrDefault(status =>
                    status.CompanyId == companyId.Value &&
                    string.Equals(status.ModuleKey, LegacySyncModuleKeys.SalesShipments, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        ApplyQueryState();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        errorMessage = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            items = [];
            totalCount = 0;
            return;
        }

        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            filter.SortColumn = sortColumn;
            filter.SortDescending = sortDescending;
            var result = await SalesOrderQueries.SearchShipmentsAsync(tenantId.Value, companyId.Value, filter);
            items = result.Items;
            totalCount = result.TotalCount;
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            items = [];
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        filter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task SetSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(sortColumn, column, StringComparison.Ordinal))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = defaultDescending;
        }

        filter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task ChangePageAsync(int page)
    {
        var newPage = Math.Max(1, Math.Min(page, TotalPages));
        if (newPage == filter.Page)
        {
            return;
        }

        filter.Page = newPage;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return;
        }

        filter.PageSize = pageSize;
        filter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private void ApplyQueryState()
    {
        filter.Search = SearchQuery?.Trim() ?? string.Empty;
        filter.Page = Math.Max(PageQuery.GetValueOrDefault(1), 1);
        filter.PageSize = PageSizeQuery is 25 or 50 or 100 ? PageSizeQuery.Value : 25;
        sortColumn = NormalizeSortColumn(SortQuery);
        sortDescending = DescQuery ?? true;
        filter.SortColumn = sortColumn;
        filter.SortDescending = sortDescending;
    }

    private void UpdateQueryState()
    {
        var uri = NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(filter.Search) ? null : filter.Search,
            ["page"] = filter.Page > 1 ? filter.Page : null,
            ["pageSize"] = filter.PageSize != 25 ? filter.PageSize : null,
            ["sort"] = string.Equals(sortColumn, nameof(SalesOrderShipmentDto.ShipmentNumber), StringComparison.Ordinal) ? null : sortColumn,
            ["desc"] = sortDescending ? null : false
        });

        NavigationManager.NavigateTo(uri, replace: true);
    }

    private static string NormalizeSortColumn(string? sortColumn) => sortColumn switch
    {
        nameof(SalesOrderShipmentDto.ShipmentNumber) => nameof(SalesOrderShipmentDto.ShipmentNumber),
        nameof(SalesOrderShipmentDto.OrderNumber) => nameof(SalesOrderShipmentDto.OrderNumber),
        nameof(SalesOrderShipmentDto.ClientName) => nameof(SalesOrderShipmentDto.ClientName),
        nameof(SalesOrderShipmentDto.ShipmentDate) => nameof(SalesOrderShipmentDto.ShipmentDate),
        nameof(SalesOrderShipmentDto.Warehouse) => nameof(SalesOrderShipmentDto.Warehouse),
        nameof(SalesOrderShipmentDto.TotalShippedQuantity) => nameof(SalesOrderShipmentDto.TotalShippedQuantity),
        nameof(SalesOrderShipmentDto.InvoiceStatus) => nameof(SalesOrderShipmentDto.InvoiceStatus),
        _ => nameof(SalesOrderShipmentDto.ShipmentNumber)
    };

    private string DisplayValue(string value) => string.IsNullOrWhiteSpace(value) ? L("Sin dato", "Sense dada", "No data") : value;
    private string FormatInvoiceStatus(string status) => status switch
    {
        "Pending" => L("Pendiente", "Pendent", "Pending"),
        "Drafted" => L("En borrador", "En esborrany", "Drafted"),
        "Invoiced" => L("Facturado", "Facturat", "Invoiced"),
        _ => status
    };

    private static string GetInvoiceStatusClass(string status) => status switch
    {
        "Pending" => "warning",
        "Drafted" => "warning",
        "Invoiced" => "success",
        _ => "success"
    };
}
