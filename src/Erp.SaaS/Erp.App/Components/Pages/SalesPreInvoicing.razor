@page "/ventas/pre-facturacion"
@page "/ventas/pre-facturacion-teixits-mostres"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISalesOrderQueries SalesOrderQueries
@inject ISalesOrderService SalesOrderService
@inject ILegacySyncService LegacySyncService
@inject NavigationManager NavigationManager
@inject AppText T

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("Ventas", "Vendes", "Sales")</p>
        <h1>@PageHeadingText</h1>
        <p class="lead">@PageLeadText</p>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@(IsTeixitsMostresPreInvoicingRoute
            ? L("Selecciona una empresa activa para preparar borradores del circuito Teixits-Mostres.", "Selecciona una empresa activa per preparar esborranys del circuit Teixits-Mostres.", "Select an active company to prepare drafts for the fabrics and samples workflow.")
            : L("Selecciona una empresa activa para preparar borradores de factura.", "Selecciona una empresa activa per preparar esborranys de factura.", "Select an active company to prepare invoice drafts."))</p>
    </div>
}
else
{
    @if (shipmentsSyncStatus?.HasSuccessfulSync == true)
    {
        <div class="alert warning">
            @(IsTeixitsMostresPreInvoicingRoute
                ? L("Ventas / Pre-facturación Teixits-Mostres trabaja sobre el documento general de albaranes y lo filtra al circuito de tejidos y muestras. La sync manual refresca solo los albaranes con origen legacy; cuando reserves albaranes desde la web para un borrador, esos cambios quedan en local.", "Vendes / Pre-facturació Teixits-Mostres treballa sobre el document general d'albarans i el filtra al circuit de teixits i mostres. La sync manual refresca només els albarans amb origen legacy; quan reservis albarans des del web per a un esborrany, aquests canvis queden en local.", "Sales / Fabric & sample pre-invoicing works on the standard shipment document and filters it to the fabrics and samples workflow. Manual sync refreshes only legacy-origin shipments; when you reserve shipments on the web for a draft, those changes remain local.")
                : L("Ventas / Albaranes está en convivencia con legacy para esta empresa. La sync manual refresca solo los albaranes con origen legacy; cuando reserves albaranes desde la web para un borrador, esos cambios quedan en local.", "Vendes / Albarans està en convivència amb legacy per a aquesta empresa. La sync manual refresca només els albarans amb origen legacy; quan reservis albarans des del web per a un esborrany, aquests canvis queden en local.", "Sales / Shipments is running in legacy coexistence mode for this company. Manual sync refreshes only legacy-origin shipments; when you reserve shipments on the web for a draft, those changes remain local."))
            @if (shipmentsSyncStatus.LastCompletedUtc.HasValue)
            {
                <span>@L("Última sync:", "Última sync:", "Last sync:") @shipmentsSyncStatus.LastCompletedUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") · Ins: @shipmentsSyncStatus.LastInserted · Act: @shipmentsSyncStatus.LastUpdated · Omi: @shipmentsSyncStatus.LastSkipped · Err: @shipmentsSyncStatus.LastErrors</span>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
    }

    <section class="panel">
        <div class="filter-row">
            <input class="text-input" @bind="searchText" placeholder="@L("Buscar por albarán, pedido, cliente o notas", "Buscar per albarà, comanda, client o notes", "Search by shipment, order, client or notes")" disabled="@isLoading" />
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? L("Cargando...", "Carregant...", "Loading...") : L("Buscar", "Buscar", "Search"))</button>
        </div>
    </section>

    <div class="card-grid purchase-summary-grid purchase-metrics-grid">
        <article class="info-card accent-card">
            <h2>@pendingTotalCount</h2>
            <p class="muted">@L("albaranes pendientes", "albarans pendents", "pending shipments")</p>
        </article>
        <article class="info-card">
            <h2>@pendingShipments.Sum(item => item.EstimatedAmount).ToUiString("0.00") €</h2>
            <p class="muted">@L("importe pendiente en página", "import pendent en pàgina", "outstanding amount on page")</p>
        </article>
        <article class="info-card">
            <h2>@draftTotalCount</h2>
            <p class="muted">@L("borradores creados", "esborranys creats", "created drafts")</p>
        </article>
        <article class="info-card">
            <h2>@invoiceDrafts.Sum(item => item.TotalAmount).ToUiString("0.00") €</h2>
            <p class="muted">@L("importe en borrador en página", "import en esborrany en pàgina", "draft amount on page")</p>
        </article>
    </div>

    @if (canEdit)
    {
        <section class="panel" style="margin-top: 1rem;">
            <h2>@L("Crear borrador", "Crear esborrany", "Create draft")</h2>
            <p class="muted">@L("Selecciona uno o varios albaranes pendientes del mismo cliente para agruparlos en un primer borrador de factura.", "Selecciona un o diversos albarans pendents del mateix client per agrupar-los en un primer esborrany de factura.", "Select one or more pending shipments from the same client to group them into a first invoice draft.")</p>

            <div class="form-grid">
                <label class="field">
                    <span>@L("Fecha borrador", "Data esborrany", "Draft date")</span>
                    <InputDate class="text-input" @bind-Value="draftForm.IssueDate" />
                </label>
                <label class="field">
                    <span>@L("Vencimiento", "Venciment", "Due date")</span>
                    <InputDate class="text-input" @bind-Value="draftForm.DueDate" />
                </label>
                <label class="field wide">
                    <span>@L("Notas", "Notes", "Notes")</span>
                    <InputTextArea class="text-area" @bind-Value="draftForm.Notes" />
                </label>
            </div>

            <div class="quick-links">
                <span class="muted">@L($"Seleccionados: {selectedShipmentIds.Count}", $"Seleccionats: {selectedShipmentIds.Count}", $"Selected: {selectedShipmentIds.Count}") @(selectedClientName is null ? string.Empty : L($"· Cliente {selectedClientName}", $"· Client {selectedClientName}", $"· Client {selectedClientName}"))</span>
                <button class="primary-button" type="button" disabled="@(selectedShipmentIds.Count == 0)" @onclick="CreateDraftAsync">@L("Crear borrador", "Crear esborrany", "Create draft")</button>
                <button class="secondary-button" type="button" disabled="@(selectedShipmentIds.Count == 0)" @onclick="ClearSelection">@L("Limpiar selección", "Netejar selecció", "Clear selection")</button>
            </div>
        </section>
    }

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)" style="margin-top: 1rem;">
        <div class="filter-row results-toolbar">
            <span class="results-summary">
                @(pendingTotalCount == 0
                    ? L("Sin albaranes pendientes", "Sense albarans pendents", "No pending shipments")
                    : IsTeixitsMostresPreInvoicingRoute
                        ? L($"Mostrando {PendingPageStart}-{PendingPageEnd} de {pendingTotalCount} albaranes teixits-mostres pendientes", $"Mostrant {PendingPageStart}-{PendingPageEnd} de {pendingTotalCount} albarans teixits-mostres pendents", $"Showing {PendingPageStart}-{PendingPageEnd} of {pendingTotalCount} pending fabric & sample shipments")
                        : L($"Mostrando {PendingPageStart}-{PendingPageEnd} de {pendingTotalCount} albaranes pendientes", $"Mostrant {PendingPageStart}-{PendingPageEnd} de {pendingTotalCount} albarans pendents", $"Showing {PendingPageStart}-{PendingPageEnd} of {pendingTotalCount} pending shipments"))
            </span>
            <label class="field compact-field">
                <span>@L("Tamaño de página", "Mida de pàgina", "Page size")</span>
                <select class="sidebar-select compact-select" value="@pendingFilter.PageSize" @onchange="OnPendingPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>

        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>@(IsTeixitsMostresPreInvoicingRoute
                    ? L("Cargando albaranes teixits-mostres pendientes...", "Carregant albarans teixits-mostres pendents...", "Loading pending fabric & sample shipments...")
                    : L("Cargando albaranes pendientes...", "Carregant albarans pendents...", "Loading pending shipments..."))</span>
            </div>
        }

        <h2>@(IsTeixitsMostresPreInvoicingRoute
            ? L("Albaranes pendientes teixits-mostres", "Albarans pendents teixits-mostres", "Pending fabric & sample shipments")
            : L("Albaranes pendientes", "Albarans pendents", "Pending shipments"))</h2>
        <table class="data-table">
            <thead>
                <tr>
                    @if (canEdit)
                    {
                        <th></th>
                    }
                    <SortableHeader Label="@L("Albarán", "Albarà", "Shipment")" IsActive="@(pendingSortColumn == nameof(PendingSalesShipmentDto.ShipmentNumber))" Descending="@pendingSortDescending" OnSort="@(() => SetPendingSortAsync(nameof(PendingSalesShipmentDto.ShipmentNumber), true))" />
                    <SortableHeader Label="@L("Pedido", "Comanda", "Order")" IsActive="@(pendingSortColumn == nameof(PendingSalesShipmentDto.OrderNumber))" Descending="@pendingSortDescending" OnSort="@(() => SetPendingSortAsync(nameof(PendingSalesShipmentDto.OrderNumber), true))" />
                    <SortableHeader Label="@L("Cliente", "Client", "Client")" IsActive="@(pendingSortColumn == nameof(PendingSalesShipmentDto.ClientName))" Descending="@pendingSortDescending" OnSort="@(() => SetPendingSortAsync(nameof(PendingSalesShipmentDto.ClientName)))" />
                    <SortableHeader Label="@L("Fecha", "Data", "Date")" IsActive="@(pendingSortColumn == nameof(PendingSalesShipmentDto.ShipmentDate))" Descending="@pendingSortDescending" OnSort="@(() => SetPendingSortAsync(nameof(PendingSalesShipmentDto.ShipmentDate), true))" />
                    <SortableHeader Label="@L("Almacén", "Magatzem", "Warehouse")" IsActive="@(pendingSortColumn == nameof(PendingSalesShipmentDto.Warehouse))" Descending="@pendingSortDescending" OnSort="@(() => SetPendingSortAsync(nameof(PendingSalesShipmentDto.Warehouse)))" />
                    <SortableHeader Label="@L("Cantidad", "Quantitat", "Quantity")" IsActive="@(pendingSortColumn == nameof(PendingSalesShipmentDto.TotalShippedQuantity))" Descending="@pendingSortDescending" OnSort="@(() => SetPendingSortAsync(nameof(PendingSalesShipmentDto.TotalShippedQuantity), true))" />
                    <SortableHeader Label="@L("Importe", "Import", "Amount")" IsActive="@(pendingSortColumn == nameof(PendingSalesShipmentDto.EstimatedAmount))" Descending="@pendingSortDescending" OnSort="@(() => SetPendingSortAsync(nameof(PendingSalesShipmentDto.EstimatedAmount), true))" />
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    @for (var index = 0; index < 5; index++)
                    {
                        <tr class="table-skeleton-row">
                            @if (canEdit)
                            {
                                <td><span class="skeleton-line short"></span></td>
                            }
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                        </tr>
                    }
                }
                else if (pendingShipments.Count == 0)
                {
                    <tr>
                        <td colspan="@(canEdit ? 9 : 8)" class="table-empty">@(IsTeixitsMostresPreInvoicingRoute
                            ? L("No hay albaranes teixits-mostres pendientes de facturar.", "No hi ha albarans teixits-mostres pendents de facturar.", "There are no fabric & sample shipments pending invoicing.")
                            : L("No hay albaranes pendientes de facturar.", "No hi ha albarans pendents de facturar.", "There are no shipments pending invoicing."))</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in pendingShipments)
                    {
                        <tr>
                            @if (canEdit)
                            {
                                <td>
                                    <input type="checkbox"
                                           checked="@selectedShipmentIds.Contains(item.ShipmentId)"
                                           disabled="@IsSelectionBlocked(item)"
                                           @onchange="args => ToggleSelection(item, args.Value)" />
                                </td>
                            }
                            <td>@item.DisplayNumber</td>
                            <td>@item.OrderNumber</td>
                            <td>@item.ClientName</td>
                            <td>@item.ShipmentDate.ToString("dd/MM/yyyy")</td>
                            <td>@DisplayValue(item.Warehouse)</td>
                            <td>@item.TotalShippedQuantity.ToUiString("0.###")</td>
                            <td>@item.EstimatedAmount.ToUiString("0.00") €</td>
                            <td><a class="inline-link" href="@BuildShipmentDetailHref(item.ShipmentNumber)">@L("Abrir", "Obrir", "Open")</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="pagination-bar">
            <span class="muted">@L($"Página {pendingFilter.Page} de {PendingTotalPages}", $"Pàgina {pendingFilter.Page} de {PendingTotalPages}", $"Page {pendingFilter.Page} of {PendingTotalPages}")</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePendingPageAsync(1)" disabled="@(!CanGoPendingPrevious || isLoading)">@L("Primera", "Primera", "First")</button>
                <button class="secondary-button" @onclick="() => ChangePendingPageAsync(pendingFilter.Page - 1)" disabled="@(!CanGoPendingPrevious || isLoading)">@L("Anterior", "Anterior", "Previous")</button>
                <button class="secondary-button" @onclick="() => ChangePendingPageAsync(pendingFilter.Page + 1)" disabled="@(!CanGoPendingNext || isLoading)">@L("Siguiente", "Següent", "Next")</button>
                <button class="secondary-button" @onclick="() => ChangePendingPageAsync(PendingTotalPages)" disabled="@(!CanGoPendingNext || isLoading)">@L("Última", "Última", "Last")</button>
            </div>
        </div>
    </section>

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)" style="margin-top: 1rem;">
        <div class="filter-row results-toolbar">
            <span class="results-summary">
                @(draftTotalCount == 0
                    ? L("Sin borradores", "Sense esborranys", "No drafts")
                    : L($"Mostrando {DraftPageStart}-{DraftPageEnd} de {draftTotalCount} borradores", $"Mostrant {DraftPageStart}-{DraftPageEnd} de {draftTotalCount} esborranys", $"Showing {DraftPageStart}-{DraftPageEnd} of {draftTotalCount} drafts"))
            </span>
            <label class="field compact-field">
                <span>@L("Tamaño de página", "Mida de pàgina", "Page size")</span>
                <select class="sidebar-select compact-select" value="@draftFilter.PageSize" @onchange="OnDraftPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>

        <h2>@L("Borradores recientes", "Esborranys recents", "Recent drafts")</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <SortableHeader Label="@L("Borrador", "Esborrany", "Draft")" IsActive="@(draftSortColumn == nameof(SalesInvoiceDraftListItemDto.DraftNumber))" Descending="@draftSortDescending" OnSort="@(() => SetDraftSortAsync(nameof(SalesInvoiceDraftListItemDto.DraftNumber), true))" />
                    <SortableHeader Label="@L("Cliente", "Client", "Client")" IsActive="@(draftSortColumn == nameof(SalesInvoiceDraftListItemDto.ClientName))" Descending="@draftSortDescending" OnSort="@(() => SetDraftSortAsync(nameof(SalesInvoiceDraftListItemDto.ClientName)))" />
                    <SortableHeader Label="@L("Fecha", "Data", "Date")" IsActive="@(draftSortColumn == nameof(SalesInvoiceDraftListItemDto.IssueDate))" Descending="@draftSortDescending" OnSort="@(() => SetDraftSortAsync(nameof(SalesInvoiceDraftListItemDto.IssueDate), true))" />
                    <SortableHeader Label="@L("Vencimiento", "Venciment", "Due date")" IsActive="@(draftSortColumn == nameof(SalesInvoiceDraftListItemDto.DueDate))" Descending="@draftSortDescending" OnSort="@(() => SetDraftSortAsync(nameof(SalesInvoiceDraftListItemDto.DueDate), true))" />
                    <SortableHeader Label="@L("Estado", "Estat", "Status")" IsActive="@(draftSortColumn == nameof(SalesInvoiceDraftListItemDto.Status))" Descending="@draftSortDescending" OnSort="@(() => SetDraftSortAsync(nameof(SalesInvoiceDraftListItemDto.Status)))" />
                    <SortableHeader Label="@L("Albaranes", "Albarans", "Shipments")" IsActive="@(draftSortColumn == nameof(SalesInvoiceDraftListItemDto.ShipmentCount))" Descending="@draftSortDescending" OnSort="@(() => SetDraftSortAsync(nameof(SalesInvoiceDraftListItemDto.ShipmentCount), true))" />
                    <SortableHeader Label="@L("Total", "Total", "Total")" IsActive="@(draftSortColumn == nameof(SalesInvoiceDraftListItemDto.TotalAmount))" Descending="@draftSortDescending" OnSort="@(() => SetDraftSortAsync(nameof(SalesInvoiceDraftListItemDto.TotalAmount), true))" />
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    @for (var index = 0; index < 5; index++)
                    {
                        <tr class="table-skeleton-row">
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                        </tr>
                    }
                }
                else if (invoiceDrafts.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="table-empty">@L("Todavía no hay borradores de factura.", "Encara no hi ha esborranys de factura.", "There are no invoice drafts yet.")</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in invoiceDrafts)
                    {
                        <tr>
                            <td>@item.DisplayNumber</td>
                            <td>@item.ClientName</td>
                            <td>@item.IssueDate.ToString("dd/MM/yyyy")</td>
                            <td>@(item.DueDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td><span class="status-pill @GetDraftStatusClass(item.Status)">@FormatDraftStatus(item.Status)</span></td>
                            <td>@item.ShipmentCount</td>
                            <td>@item.TotalAmount.ToUiString("0.00") €</td>
                            <td>
                                <div class="table-actions">
                                    <a class="inline-link" href="@BuildDraftDetailHref(item.DraftNumber)">@L("Ver borrador", "Veure esborrany", "View draft")</a>
                                    @if (item.InvoiceNumber is int invoiceNumber)
                                    {
                                        <a class="inline-link" href="@BuildInvoiceDetailHref(invoiceNumber)">@L("Abrir factura", "Obrir factura", "Open invoice")</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="pagination-bar">
            <span class="muted">@L($"Página {draftFilter.Page} de {DraftTotalPages}", $"Pàgina {draftFilter.Page} de {DraftTotalPages}", $"Page {draftFilter.Page} of {DraftTotalPages}")</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangeDraftPageAsync(1)" disabled="@(!CanGoDraftPrevious || isLoading)">@L("Primera", "Primera", "First")</button>
                <button class="secondary-button" @onclick="() => ChangeDraftPageAsync(draftFilter.Page - 1)" disabled="@(!CanGoDraftPrevious || isLoading)">@L("Anterior", "Anterior", "Previous")</button>
                <button class="secondary-button" @onclick="() => ChangeDraftPageAsync(draftFilter.Page + 1)" disabled="@(!CanGoDraftNext || isLoading)">@L("Siguiente", "Següent", "Next")</button>
                <button class="secondary-button" @onclick="() => ChangeDraftPageAsync(DraftTotalPages)" disabled="@(!CanGoDraftNext || isLoading)">@L("Última", "Última", "Last")</button>
            </div>
        </div>
    </section>
}

@code {
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    [SupplyParameterFromQuery(Name = "q")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "ppage")]
    public int? PendingPageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "ppageSize")]
    public int? PendingPageSizeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "psort")]
    public string? PendingSortQuery { get; set; }

    [SupplyParameterFromQuery(Name = "pdesc")]
    public bool? PendingDescQuery { get; set; }

    [SupplyParameterFromQuery(Name = "dpage")]
    public int? DraftPageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "dpageSize")]
    public int? DraftPageSizeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "dsort")]
    public string? DraftSortQuery { get; set; }

    [SupplyParameterFromQuery(Name = "ddesc")]
    public bool? DraftDescQuery { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isLoading;
    private string searchText = string.Empty;
    private SalesPreInvoiceFilter pendingFilter = new() { Page = 1, PageSize = 25, SortColumn = nameof(PendingSalesShipmentDto.ShipmentNumber), SortDescending = true };
    private SalesPreInvoiceFilter draftFilter = new() { Page = 1, PageSize = 25, SortColumn = nameof(SalesInvoiceDraftListItemDto.DraftNumber), SortDescending = true };
    private IReadOnlyCollection<PendingSalesShipmentDto> pendingShipments = [];
    private IReadOnlyCollection<SalesInvoiceDraftListItemDto> invoiceDrafts = [];
    private HashSet<Guid> selectedShipmentIds = [];
    private int? selectedClientCode;
    private string? selectedClientName;
    private string statusMessage = string.Empty;
    private bool isError;
    private DraftFormModel draftForm = new();
    private string pendingSortColumn = nameof(PendingSalesShipmentDto.ShipmentNumber);
    private bool pendingSortDescending = true;
    private string draftSortColumn = nameof(SalesInvoiceDraftListItemDto.DraftNumber);
    private bool draftSortDescending = true;
    private int pendingTotalCount;
    private int draftTotalCount;
    private LegacySyncModuleStatusDto? shipmentsSyncStatus;

    private int PendingTotalPages => Math.Max(1, (int)Math.Ceiling(pendingTotalCount / (double)pendingFilter.PageSize));
    private bool CanGoPendingPrevious => pendingFilter.Page > 1;
    private bool CanGoPendingNext => pendingFilter.Page < PendingTotalPages;
    private int PendingPageStart => pendingTotalCount == 0 ? 0 : ((pendingFilter.Page - 1) * pendingFilter.PageSize) + 1;
    private int PendingPageEnd => pendingTotalCount == 0 ? 0 : Math.Min(pendingFilter.Page * pendingFilter.PageSize, pendingTotalCount);
    private int DraftTotalPages => Math.Max(1, (int)Math.Ceiling(draftTotalCount / (double)draftFilter.PageSize));
    private bool CanGoDraftPrevious => draftFilter.Page > 1;
    private bool CanGoDraftNext => draftFilter.Page < DraftTotalPages;
    private int DraftPageStart => draftTotalCount == 0 ? 0 : ((draftFilter.Page - 1) * draftFilter.PageSize) + 1;
    private int DraftPageEnd => draftTotalCount == 0 ? 0 : Math.Min(draftFilter.Page * draftFilter.PageSize, draftTotalCount);
    private bool IsTeixitsMostresPreInvoicingRoute =>
        NavigationManager.ToBaseRelativePath(NavigationManager.Uri).StartsWith("ventas/pre-facturacion-teixits-mostres", StringComparison.OrdinalIgnoreCase);

    private string PageTitleText => IsTeixitsMostresPreInvoicingRoute
        ? L("Ventas / Pre-facturación Teixits-Mostres", "Vendes / Pre-facturació Teixits-Mostres", "Sales / Fabric & sample pre-invoicing")
        : L("Ventas / Pre-facturación", "Vendes / Pre-facturació", "Sales / Pre-invoicing");

    private string PageHeadingText => IsTeixitsMostresPreInvoicingRoute
        ? L("Pre-facturación Teixits-Mostres", "Pre-facturació Teixits-Mostres", "Fabric & sample pre-invoicing")
        : L("Pre-facturación", "Pre-facturació", "Pre-invoicing");

    private string PageLeadText => IsTeixitsMostresPreInvoicingRoute
        ? L("Bandeja de albaranes pendientes del circuito de tejidos y muestras y generación de borradores agrupados por cliente.", "Safata d'albarans pendents del circuit de teixits i mostres i generació d'esborranys agrupats per client.", "Queue of pending shipments from the fabrics and samples workflow and draft generation grouped by client.")
        : L("Bandeja de albaranes pendientes y generación de borradores de factura agrupados por cliente.", "Safata d'albarans pendents i generació d'esborranys de factura agrupats per client.", "Queue of pending shipments and invoice draft generation grouped by client.");

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);
        if (tenantId.HasValue && companyId.HasValue)
        {
            shipmentsSyncStatus = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
                .FirstOrDefault(status =>
                    status.CompanyId == companyId.Value &&
                    string.Equals(status.ModuleKey, LegacySyncModuleKeys.SalesShipments, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        ApplyQueryState();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        statusMessage = string.Empty;
        isError = false;

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            pendingShipments = [];
            invoiceDrafts = [];
            pendingTotalCount = 0;
            draftTotalCount = 0;
            return;
        }

        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            pendingFilter.Search = searchText;
            pendingFilter.CatalogScope = IsTeixitsMostresPreInvoicingRoute ? "TeixitsMostres" : string.Empty;
            pendingFilter.SortColumn = pendingSortColumn;
            pendingFilter.SortDescending = pendingSortDescending;
            draftFilter.Search = searchText;
            draftFilter.CatalogScope = IsTeixitsMostresPreInvoicingRoute ? "TeixitsMostres" : string.Empty;
            draftFilter.SortColumn = draftSortColumn;
            draftFilter.SortDescending = draftSortDescending;

            var pendingTask = SalesOrderQueries.SearchPendingShipmentsAsync(tenantId.Value, companyId.Value, pendingFilter);
            var draftTask = SalesOrderQueries.SearchInvoiceDraftsAsync(tenantId.Value, companyId.Value, draftFilter);
            await Task.WhenAll(pendingTask, draftTask);

            var pendingResult = await pendingTask;
            var draftResult = await draftTask;

            pendingShipments = pendingResult.Items;
            pendingTotalCount = pendingResult.TotalCount;
            invoiceDrafts = draftResult.Items;
            draftTotalCount = draftResult.TotalCount;
            SyncSelection();
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
            pendingShipments = [];
            invoiceDrafts = [];
            pendingTotalCount = 0;
            draftTotalCount = 0;
            ClearSelection();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        pendingFilter.Page = 1;
        draftFilter.Page = 1;
        ClearSelection();
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task CreateDraftAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !canEdit || selectedShipmentIds.Count == 0)
        {
            return;
        }

        try
        {
            statusMessage = string.Empty;
            isError = false;

            var draftNumber = await SalesOrderService.CreateInvoiceDraftAsync(new CreateSalesInvoiceDraftCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                IssueDate = draftForm.IssueDate,
                DueDate = draftForm.DueDate,
                Notes = draftForm.Notes,
                ShipmentIds = selectedShipmentIds.ToList()
            });

            ClearSelection();
            draftForm = new DraftFormModel();
            await LoadAsync();
            NavigationManager.NavigateTo(BuildDraftDetailHref(draftNumber));
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private void ToggleSelection(PendingSalesShipmentDto shipment, object? rawValue)
    {
        if (!bool.TryParse(Convert.ToString(rawValue), out var isChecked))
        {
            isChecked = false;
        }

        if (isChecked)
        {
            selectedShipmentIds.Add(shipment.ShipmentId);
        }
        else
        {
            selectedShipmentIds.Remove(shipment.ShipmentId);
        }

        SyncSelection();
    }

    private bool IsSelectionBlocked(PendingSalesShipmentDto shipment) =>
        selectedClientCode.HasValue &&
        selectedClientCode.Value != shipment.ClientCode &&
        !selectedShipmentIds.Contains(shipment.ShipmentId);

    private void SyncSelection()
    {
        selectedShipmentIds = pendingShipments
            .Where(item => selectedShipmentIds.Contains(item.ShipmentId))
            .Select(item => item.ShipmentId)
            .ToHashSet();

        var selectedShipments = pendingShipments
            .Where(item => selectedShipmentIds.Contains(item.ShipmentId))
            .ToArray();

        selectedClientCode = selectedShipments.FirstOrDefault()?.ClientCode;
        selectedClientName = selectedShipments.FirstOrDefault()?.ClientName;
    }

    private void ClearSelection()
    {
        selectedShipmentIds.Clear();
        selectedClientCode = null;
        selectedClientName = null;
    }

    private async Task SetPendingSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(pendingSortColumn, column, StringComparison.Ordinal))
        {
            pendingSortDescending = !pendingSortDescending;
        }
        else
        {
            pendingSortColumn = column;
            pendingSortDescending = defaultDescending;
        }

        pendingFilter.Page = 1;
        ClearSelection();
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task SetDraftSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(draftSortColumn, column, StringComparison.Ordinal))
        {
            draftSortDescending = !draftSortDescending;
        }
        else
        {
            draftSortColumn = column;
            draftSortDescending = defaultDescending;
        }

        draftFilter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task ChangePendingPageAsync(int page)
    {
        var newPage = Math.Max(1, Math.Min(page, PendingTotalPages));
        if (newPage == pendingFilter.Page)
        {
            return;
        }

        pendingFilter.Page = newPage;
        ClearSelection();
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task ChangeDraftPageAsync(int page)
    {
        var newPage = Math.Max(1, Math.Min(page, DraftTotalPages));
        if (newPage == draftFilter.Page)
        {
            return;
        }

        draftFilter.Page = newPage;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task OnPendingPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return;
        }

        pendingFilter.PageSize = pageSize;
        pendingFilter.Page = 1;
        ClearSelection();
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task OnDraftPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return;
        }

        draftFilter.PageSize = pageSize;
        draftFilter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private void ApplyQueryState()
    {
        searchText = SearchQuery?.Trim() ?? string.Empty;
        pendingFilter.Search = searchText;
        draftFilter.Search = searchText;
        pendingFilter.Page = Math.Max(PendingPageQuery.GetValueOrDefault(1), 1);
        pendingFilter.PageSize = PendingPageSizeQuery is 25 or 50 or 100 ? PendingPageSizeQuery.Value : 25;
        pendingSortColumn = NormalizePendingSortColumn(PendingSortQuery);
        pendingSortDescending = PendingDescQuery ?? true;
        pendingFilter.SortColumn = pendingSortColumn;
        pendingFilter.SortDescending = pendingSortDescending;

        draftFilter.Page = Math.Max(DraftPageQuery.GetValueOrDefault(1), 1);
        draftFilter.PageSize = DraftPageSizeQuery is 25 or 50 or 100 ? DraftPageSizeQuery.Value : 25;
        draftSortColumn = NormalizeDraftSortColumn(DraftSortQuery);
        draftSortDescending = DraftDescQuery ?? true;
        draftFilter.SortColumn = draftSortColumn;
        draftFilter.SortDescending = draftSortDescending;
    }

    private void UpdateQueryState()
    {
        var uri = NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(searchText) ? null : searchText,
            ["ppage"] = pendingFilter.Page > 1 ? pendingFilter.Page : null,
            ["ppageSize"] = pendingFilter.PageSize != 25 ? pendingFilter.PageSize : null,
            ["psort"] = string.Equals(pendingSortColumn, nameof(PendingSalesShipmentDto.ShipmentNumber), StringComparison.Ordinal) ? null : pendingSortColumn,
            ["pdesc"] = pendingSortDescending ? null : false,
            ["dpage"] = draftFilter.Page > 1 ? draftFilter.Page : null,
            ["dpageSize"] = draftFilter.PageSize != 25 ? draftFilter.PageSize : null,
            ["dsort"] = string.Equals(draftSortColumn, nameof(SalesInvoiceDraftListItemDto.DraftNumber), StringComparison.Ordinal) ? null : draftSortColumn,
            ["ddesc"] = draftSortDescending ? null : false
        });

        NavigationManager.NavigateTo(uri, replace: true);
    }

    private static string NormalizePendingSortColumn(string? sortColumn) => sortColumn switch
    {
        nameof(PendingSalesShipmentDto.ShipmentNumber) => nameof(PendingSalesShipmentDto.ShipmentNumber),
        nameof(PendingSalesShipmentDto.OrderNumber) => nameof(PendingSalesShipmentDto.OrderNumber),
        nameof(PendingSalesShipmentDto.ClientName) => nameof(PendingSalesShipmentDto.ClientName),
        nameof(PendingSalesShipmentDto.ShipmentDate) => nameof(PendingSalesShipmentDto.ShipmentDate),
        nameof(PendingSalesShipmentDto.Warehouse) => nameof(PendingSalesShipmentDto.Warehouse),
        nameof(PendingSalesShipmentDto.TotalShippedQuantity) => nameof(PendingSalesShipmentDto.TotalShippedQuantity),
        nameof(PendingSalesShipmentDto.EstimatedAmount) => nameof(PendingSalesShipmentDto.EstimatedAmount),
        _ => nameof(PendingSalesShipmentDto.ShipmentNumber)
    };

    private static string NormalizeDraftSortColumn(string? sortColumn) => sortColumn switch
    {
        nameof(SalesInvoiceDraftListItemDto.DraftNumber) => nameof(SalesInvoiceDraftListItemDto.DraftNumber),
        nameof(SalesInvoiceDraftListItemDto.ClientName) => nameof(SalesInvoiceDraftListItemDto.ClientName),
        nameof(SalesInvoiceDraftListItemDto.IssueDate) => nameof(SalesInvoiceDraftListItemDto.IssueDate),
        nameof(SalesInvoiceDraftListItemDto.DueDate) => nameof(SalesInvoiceDraftListItemDto.DueDate),
        nameof(SalesInvoiceDraftListItemDto.Status) => nameof(SalesInvoiceDraftListItemDto.Status),
        nameof(SalesInvoiceDraftListItemDto.ShipmentCount) => nameof(SalesInvoiceDraftListItemDto.ShipmentCount),
        nameof(SalesInvoiceDraftListItemDto.TotalAmount) => nameof(SalesInvoiceDraftListItemDto.TotalAmount),
        _ => nameof(SalesInvoiceDraftListItemDto.DraftNumber)
    };

    private string DisplayValue(string value) => string.IsNullOrWhiteSpace(value) ? L("Sin dato", "Sense dada", "No data") : value;
    private string FormatDraftStatus(string status) => status switch
    {
        SalesInvoiceDraftStatuses.Draft => L("Borrador", "Esborrany", "Draft"),
        SalesInvoiceDraftStatuses.Issued => L("Emitido", "Emès", "Issued"),
        _ => status
    };

    private static string GetDraftStatusClass(string status) => status switch
    {
        SalesInvoiceDraftStatuses.Issued => "success",
        _ => "warning"
    };

    private string BuildShipmentDetailHref(int shipmentNumber) =>
        IsTeixitsMostresPreInvoicingRoute
            ? $"/ventas/albaranes-teixits-mostres/{shipmentNumber}"
            : $"/ventas/albaranes/{shipmentNumber}";

    private string BuildDraftDetailHref(int draftNumber) =>
        IsTeixitsMostresPreInvoicingRoute
            ? $"/ventas/pre-facturacion-teixits-mostres/borradores/{draftNumber}"
            : $"/ventas/pre-facturacion/borradores/{draftNumber}";

    private string BuildInvoiceDetailHref(int invoiceNumber) =>
        IsTeixitsMostresPreInvoicingRoute
            ? $"/ventas/facturas-teixits-mostres/{invoiceNumber}"
            : $"/ventas/facturas/{invoiceNumber}";

    private sealed class DraftFormModel
    {
        public DateTime IssueDate { get; set; } = DateTime.Today;
        public DateTime? DueDate { get; set; }
        public string Notes { get; set; } = string.Empty;
    }
