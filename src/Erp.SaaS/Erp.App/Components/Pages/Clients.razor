@page "/crm/clientes"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IClienteQueries ClienteQueries
@inject ILegacySyncService LegacySyncService
@inject AppText T

<PageTitle>@L("CRM / Clientes", "CRM / Clients", "CRM / Clients")</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@T["menu.crm"]</p>
        <h1>@L("Clientes", "Clients", "Clients")</h1>
        <p class="lead">@L("Consulta y filtra los clientes replicados en la SaaS local, ya sea por empresa activa o compartidos en todo el tenant según la configuración del grupo.", "Consulta i filtra els clients replicats a la SaaS local, ja sigui per empresa activa o compartits a tot el tenant segons la configuració del grup.", "Browse and filter clients replicated in the local SaaS, either for the active company or shared across the whole tenant depending on group configuration.")</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="/crm/clientes/duplicados">@L("Bandeja de duplicados", "Safata de duplicats", "Duplicate inbox")</a>
        @if (canEdit)
        {
            <a class="primary-button link-button" href="/crm/clientes/nuevo">@L("Nuevo cliente", "Nou client", "New client")</a>
        }
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("Selecciona una empresa activa para trabajar con el CRM.", "Selecciona una empresa activa per treballar amb el CRM.", "Select an active company to work with CRM.")</p>
    </div>
}
else
{
    <section class="panel">
        <div class="filter-row">
            <input class="text-input" @bind="filter.Search" placeholder="@L("Buscar por nombre, NIF, ciudad, email o teléfono", "Buscar per nom, NIF, ciutat, email o telèfon", "Search by name, tax id, city, email or phone")" />
            <label class="checkbox-field compact">
                <input type="checkbox" @bind="filter.IncludeBlocked" />
                <span>@L("Incluir bloqueados", "Incloure bloquejats", "Include blocked")</span>
            </label>
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? L("Cargando...", "Carregant...", "Loading...") : L("Buscar", "Buscar", "Search"))</button>
        </div>
        <div class="filter-row" style="margin-top: 0.85rem;">
            <button class="@(qualityFilter == QualityFilterMode.All ? "primary-button" : "secondary-button")" @onclick="() => SetQualityFilter(QualityFilterMode.All)" disabled="@isLoading">@L("Todos", "Tots", "All") (@items.Count)</button>
            <button class="@(qualityFilter == QualityFilterMode.Ok ? "primary-button" : "secondary-button")" @onclick="() => SetQualityFilter(QualityFilterMode.Ok)" disabled="@isLoading">OK (@items.Count(IsQualityOk))</button>
            <button class="@(qualityFilter == QualityFilterMode.Review ? "primary-button" : "secondary-button")" @onclick="() => SetQualityFilter(QualityFilterMode.Review)" disabled="@isLoading">@L("Revisar", "Revisar", "Review") (@items.Count(IsReviewOnly))</button>
            <button class="@(qualityFilter == QualityFilterMode.HardDuplicate ? "primary-button" : "secondary-button")" @onclick="() => SetQualityFilter(QualityFilterMode.HardDuplicate)" disabled="@isLoading">@L("Duplicado duro", "Duplicat dur", "Hard duplicate") (@items.Count(HasHardDuplicate))</button>
        </div>
        <div class="filter-row results-toolbar" style="margin-top: 0.85rem;">
            <span class="results-summary">
                @(totalCount == 0
                    ? L("Sin resultados", "Sense resultats", "No results")
                    : L($"Mostrando {PageStart}-{PageEnd} de {totalCount} clientes", $"Mostrant {PageStart}-{PageEnd} de {totalCount} clients", $"Showing {PageStart}-{PageEnd} of {totalCount} clients"))
            </span>
            <label class="field compact-field">
                <span>@L("Tamaño de página", "Mida de pàgina", "Page size")</span>
                <select class="sidebar-select compact-select" value="@filter.PageSize" @onchange="OnPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }

    @if (isLegacySyncActive)
    {
        <div class="alert">
            @L("CRM / Clientes está en convivencia con legacy para esta empresa. La web trabaja sobre la SaaS local y la sincronización manual solo refresca los registros de origen legacy, sin pisar los cambios locales.", "CRM / Clients està en convivència amb legacy per a aquesta empresa. La web treballa sobre la SaaS local i la sincronització manual només refresca els registres d'origen legacy, sense trepitjar els canvis locals.", "CRM / Clients is running in legacy coexistence mode for this company. The web app works on the local SaaS and manual sync only refreshes legacy-origin records without overwriting local changes.")
            @if (!string.IsNullOrWhiteSpace(syncStatusLabel))
            {
                <span>@syncStatusLabel</span>
            }
        </div>
    }

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)" aria-busy="@isLoading">
        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>@L("Cargando clientes...", "Carregant clients...", "Loading clients...")</span>
            </div>
        }

        <div class="table-scroll">
            <table class="data-table clients-table">
                <thead>
                    <tr>
                        <SortableHeader Label="@L("Código", "Codi", "Code")" IsActive="@(sortColumn == nameof(ClienteListItemDto.Code))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ClienteListItemDto.Code), true))" />
                        <SortableHeader Label="@L("Nombre", "Nom", "Name")" IsActive="@(sortColumn == nameof(ClienteListItemDto.Name))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ClienteListItemDto.Name)))" />
                        <SortableHeader Label="@L("Calidad", "Qualitat", "Quality")" IsActive="@(sortColumn == "Quality")" Descending="@sortDescending" OnSort="@(() => SetSortAsync("Quality", true))" />
                        <SortableHeader Label="NIF" IsActive="@(sortColumn == nameof(ClienteListItemDto.TaxId))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ClienteListItemDto.TaxId)))" />
                        <SortableHeader Label="@L("Ciudad", "Ciutat", "City")" IsActive="@(sortColumn == nameof(ClienteListItemDto.City))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ClienteListItemDto.City)))" />
                        <SortableHeader Label="Email" IsActive="@(sortColumn == nameof(ClienteListItemDto.Email))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ClienteListItemDto.Email)))" />
                        <SortableHeader Label="@L("Teléfono", "Telèfon", "Phone")" IsActive="@(sortColumn == nameof(ClienteListItemDto.Phone))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ClienteListItemDto.Phone)))" />
                        <SortableHeader Label="@L("Estado", "Estat", "Status")" IsActive="@(sortColumn == "Status")" Descending="@sortDescending" OnSort="@(() => SetSortAsync("Status"))" />
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        @for (var index = 0; index < 6; index++)
                        {
                            <tr class="table-skeleton-row">
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                            </tr>
                        }
                    }
                    else if (filteredItems.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="table-empty">@L("No hay clientes para mostrar.", "No hi ha clients per mostrar.", "No clients to display.")</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in GetSortedItems())
                        {
                            <tr>
                                <td>@item.Code</td>
                                <td>@item.Name</td>
                                <td>
                                    @if (HasHardDuplicate(item))
                                    {
                                        <span class="status-pill danger" title="@GetDuplicateSummary(item)">@L("Duplicado duro", "Duplicat dur", "Hard duplicate")</span>
                                    }
                                    else if (HasSoftDuplicate(item))
                                    {
                                        <span class="status-pill warning" title="@GetDuplicateSummary(item)">@L("Revisar", "Revisar", "Review")</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill success">OK</span>
                                    }
                                </td>
                                <td>@item.TaxId</td>
                                <td>@item.City</td>
                                <td>@item.Email</td>
                                <td>@item.Phone</td>
                                <td>@(item.IsBlocked ? L("Bloqueado", "Bloquejat", "Blocked") : L("Activo", "Actiu", "Active"))</td>
                                <td>
                                    <a class="inline-link" href="/crm/clientes/editar/@item.Code">@(canEdit ? L("Abrir", "Obrir", "Open") : L("Ver", "Veure", "View"))</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-bar">
            <span class="muted">@L($"Página {filter.Page} de {TotalPages}", $"Pàgina {filter.Page} de {TotalPages}", $"Page {filter.Page} of {TotalPages}")</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePageAsync(1)" disabled="@(!CanGoPrevious || isLoading)">@L("Primera", "Primera", "First")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page - 1)" disabled="@(!CanGoPrevious || isLoading)">@L("Anterior", "Anterior", "Previous")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page + 1)" disabled="@(!CanGoNext || isLoading)">@L("Siguiente", "Següent", "Next")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(TotalPages)" disabled="@(!CanGoNext || isLoading)">@L("Última", "Última", "Last")</button>
            </div>
        </div>
    </section>
}

@code {
    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private ClienteFilter filter = new() { Page = 1, PageSize = 25, SortColumn = nameof(ClienteListItemDto.Code), SortDescending = true };
    private IReadOnlyCollection<ClienteListItemDto> items = [];
    private IReadOnlyCollection<ClienteListItemDto> filteredItems = [];
    private string errorMessage = string.Empty;
    private QualityFilterMode qualityFilter = QualityFilterMode.All;
    private bool isLoading;
    private string sortColumn = nameof(ClienteListItemDto.Code);
    private bool sortDescending = true;
    private bool isLegacySyncActive;
    private string syncStatusLabel = string.Empty;
    private int totalCount;

    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)filter.PageSize));
    private bool CanGoPrevious => filter.Page > 1;
    private bool CanGoNext => filter.Page < TotalPages;
    private int PageStart => totalCount == 0 ? 0 : ((filter.Page - 1) * filter.PageSize) + 1;
    private int PageEnd => totalCount == 0 ? 0 : Math.Min(filter.Page * filter.PageSize, totalCount);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsInRole(PlatformRoles.TenantAdmin);

        await LoadSyncStatusAsync();

        await LoadAsync();
    }

    private async Task LoadSyncStatusAsync()
    {
        isLegacySyncActive = false;
        syncStatusLabel = string.Empty;

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var status = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
            .FirstOrDefault(item =>
                item.CompanyId == companyId.Value &&
                string.Equals(item.ModuleKey, LegacySyncModuleKeys.CrmClients, StringComparison.OrdinalIgnoreCase));

        if (status is null || !status.HasSuccessfulSync)
        {
            return;
        }

        isLegacySyncActive = true;
        syncStatusLabel = status.LastCompletedUtc.HasValue
            ? L($"Última sync: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Act: {status.LastUpdated} · Omi: {status.LastSkipped} · Err: {status.LastErrors}",
                $"Última sync: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Act: {status.LastUpdated} · Omi: {status.LastSkipped} · Err: {status.LastErrors}",
                $"Last sync: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Upd: {status.LastUpdated} · Skip: {status.LastSkipped} · Err: {status.LastErrors}")
            : L($"Estado: {status.LastStatus}", $"Estat: {status.LastStatus}", $"Status: {status.LastStatus}");
    }

    private async Task LoadAsync()
    {
        errorMessage = string.Empty;
        isLoading = true;

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            items = [];
            filteredItems = [];
            isLoading = false;
            return;
        }

        try
        {
            await InvokeAsync(StateHasChanged);
            filter.SortColumn = sortColumn == "Quality" ? string.Empty : sortColumn;
            filter.SortDescending = sortColumn == "Quality" ? false : sortDescending;

            var result = await ClienteQueries.SearchAsync(tenantId.Value, companyId.Value, filter);
            items = result.Items;
            totalCount = result.TotalCount;
            ApplyQualityFilter();
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            items = [];
            filteredItems = [];
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        filter.Page = 1;
        await LoadAsync();
    }

    private void SetQualityFilter(QualityFilterMode mode)
    {
        qualityFilter = mode;
        ApplyQualityFilter();
    }

    private void ApplyQualityFilter()
    {
        filteredItems = qualityFilter switch
        {
            QualityFilterMode.Ok => items.Where(IsQualityOk).ToArray(),
            QualityFilterMode.Review => items.Where(IsReviewOnly).ToArray(),
            QualityFilterMode.HardDuplicate => items.Where(HasHardDuplicate).ToArray(),
            _ => items
        };
    }

    private static bool HasHardDuplicate(ClienteListItemDto item) =>
        item.HasDuplicateTaxId || item.HasDuplicateEmail;

    private static bool HasSoftDuplicate(ClienteListItemDto item) =>
        item.HasDuplicateName || item.HasDuplicatePhone;

    private static bool IsReviewOnly(ClienteListItemDto item) =>
        !HasHardDuplicate(item) && HasSoftDuplicate(item);

    private static bool IsQualityOk(ClienteListItemDto item) =>
        !HasHardDuplicate(item) && !HasSoftDuplicate(item);

    private IEnumerable<ClienteListItemDto> GetSortedItems()
    {
        if (!string.Equals(sortColumn, "Quality", StringComparison.Ordinal))
        {
            return filteredItems;
        }

        return sortColumn switch
        {
            "Quality" => ApplySort(filteredItems.OrderBy(GetQualityRank).ThenBy(item => item.Name, StringComparer.CurrentCultureIgnoreCase)),
            _ => filteredItems
        };
    }

    private IEnumerable<ClienteListItemDto> ApplySort(IOrderedEnumerable<ClienteListItemDto> orderedItems) =>
        sortDescending ? orderedItems.Reverse() : orderedItems;

    private async Task SetSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(sortColumn, column, StringComparison.Ordinal))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = defaultDescending;
        }

        filter.Page = 1;

        if (string.Equals(column, "Quality", StringComparison.Ordinal))
        {
            ApplyQualityFilter();
            return;
        }

        await LoadAsync();
    }

    private async Task ChangePageAsync(int page)
    {
        var nextPage = Math.Clamp(page, 1, TotalPages);
        if (nextPage == filter.Page)
        {
            return;
        }

        filter.Page = nextPage;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return;
        }

        filter.PageSize = pageSize;
        filter.Page = 1;
        await LoadAsync();
    }

    private static int GetQualityRank(ClienteListItemDto item) =>
        HasHardDuplicate(item) ? 2 : HasSoftDuplicate(item) ? 1 : 0;

    private string GetDuplicateSummary(ClienteListItemDto item)
    {
        var reasons = new List<string>();

        if (item.HasDuplicateTaxId)
        {
            reasons.Add(L("NIF repetido", "NIF repetit", "Duplicate tax id"));
        }

        if (item.HasDuplicateEmail)
        {
            reasons.Add(L("email repetido", "email repetit", "Duplicate email"));
        }

        if (item.HasDuplicateName)
        {
            reasons.Add(L("nombre repetido", "nom repetit", "Duplicate name"));
        }

        if (item.HasDuplicatePhone)
        {
            reasons.Add(L("teléfono repetido", "telèfon repetit", "Duplicate phone"));
        }

        return reasons.Count == 0 ? L("Sin incidencias", "Sense incidències", "No issues") : string.Join(", ", reasons);
    }

    private enum QualityFilterMode
    {
        All,
        Ok,
        Review,
        HardDuplicate
    }
}
