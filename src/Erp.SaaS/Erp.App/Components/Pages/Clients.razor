@page "/crm/clientes"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IClienteQueries ClienteQueries
@inject ILegacySyncService LegacySyncService

<PageTitle>CRM / Clientes</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">CRM</p>
        <h1>Clientes</h1>
        <p class="lead">Consulta y filtra los clientes replicados en la SaaS local, ya sea por empresa activa o compartidos en todo el tenant según la configuración del grupo.</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="/crm/clientes/duplicados">Bandeja de duplicados</a>
        @if (canEdit)
        {
            <a class="primary-button link-button" href="/crm/clientes/nuevo">Nuevo cliente</a>
        }
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>Selecciona una empresa activa para trabajar con el CRM.</p>
    </div>
}
else
{
    <section class="panel">
        <div class="filter-row">
            <input class="text-input" @bind="filter.Search" placeholder="Buscar por nombre, NIF, ciudad, email o teléfono" />
            <label class="checkbox-field compact">
                <input type="checkbox" @bind="filter.IncludeBlocked" />
                <span>Incluir bloqueados</span>
            </label>
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? "Cargando..." : "Buscar")</button>
        </div>
        <div class="filter-row" style="margin-top: 0.85rem;">
            <button class="@(qualityFilter == QualityFilterMode.All ? "primary-button" : "secondary-button")" @onclick="() => SetQualityFilter(QualityFilterMode.All)" disabled="@isLoading">Todos (@items.Count)</button>
            <button class="@(qualityFilter == QualityFilterMode.Ok ? "primary-button" : "secondary-button")" @onclick="() => SetQualityFilter(QualityFilterMode.Ok)" disabled="@isLoading">OK (@items.Count(IsQualityOk))</button>
            <button class="@(qualityFilter == QualityFilterMode.Review ? "primary-button" : "secondary-button")" @onclick="() => SetQualityFilter(QualityFilterMode.Review)" disabled="@isLoading">Revisar (@items.Count(IsReviewOnly))</button>
            <button class="@(qualityFilter == QualityFilterMode.HardDuplicate ? "primary-button" : "secondary-button")" @onclick="() => SetQualityFilter(QualityFilterMode.HardDuplicate)" disabled="@isLoading">Duplicado duro (@items.Count(HasHardDuplicate))</button>
        </div>
        <div class="filter-row results-toolbar" style="margin-top: 0.85rem;">
            <span class="results-summary">
                @(totalCount == 0
                    ? "Sin resultados"
                    : $"Mostrando {PageStart}-{PageEnd} de {totalCount} clientes")
            </span>
            <label class="field compact-field">
                <span>Tamaño de página</span>
                <select class="sidebar-select compact-select" value="@filter.PageSize" @onchange="OnPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }

    @if (isLegacySyncActive)
    {
        <div class="alert">
            CRM / Clientes está en convivencia con legacy para esta empresa.
            La web muestra la réplica SaaS local y queda en solo lectura mientras la sincronización mande.
            @if (!string.IsNullOrWhiteSpace(syncStatusLabel))
            {
                <span>@syncStatusLabel</span>
            }
        </div>
    }

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)" aria-busy="@isLoading">
        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>Cargando clientes...</span>
            </div>
        }

        <div class="table-scroll">
            <table class="data-table clients-table">
                <thead>
                    <tr>
                        <SortableHeader Label="Código" IsActive="@(sortColumn == nameof(ClienteListItemDto.Code))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ClienteListItemDto.Code), true))" />
                        <SortableHeader Label="Nombre" IsActive="@(sortColumn == nameof(ClienteListItemDto.Name))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ClienteListItemDto.Name)))" />
                        <SortableHeader Label="Calidad" IsActive="@(sortColumn == "Quality")" Descending="@sortDescending" OnSort="@(() => SetSortAsync("Quality", true))" />
                        <SortableHeader Label="NIF" IsActive="@(sortColumn == nameof(ClienteListItemDto.TaxId))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ClienteListItemDto.TaxId)))" />
                        <SortableHeader Label="Ciudad" IsActive="@(sortColumn == nameof(ClienteListItemDto.City))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ClienteListItemDto.City)))" />
                        <SortableHeader Label="Email" IsActive="@(sortColumn == nameof(ClienteListItemDto.Email))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ClienteListItemDto.Email)))" />
                        <SortableHeader Label="Teléfono" IsActive="@(sortColumn == nameof(ClienteListItemDto.Phone))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ClienteListItemDto.Phone)))" />
                        <SortableHeader Label="Estado" IsActive="@(sortColumn == "Status")" Descending="@sortDescending" OnSort="@(() => SetSortAsync("Status"))" />
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        @for (var index = 0; index < 6; index++)
                        {
                            <tr class="table-skeleton-row">
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                            </tr>
                        }
                    }
                    else if (filteredItems.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="table-empty">No hay clientes para mostrar.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in GetSortedItems())
                        {
                            <tr>
                                <td>@item.Code</td>
                                <td>@item.Name</td>
                                <td>
                                    @if (HasHardDuplicate(item))
                                    {
                                        <span class="status-pill danger" title="@GetDuplicateSummary(item)">Duplicado duro</span>
                                    }
                                    else if (HasSoftDuplicate(item))
                                    {
                                        <span class="status-pill warning" title="@GetDuplicateSummary(item)">Revisar</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill success">OK</span>
                                    }
                                </td>
                                <td>@item.TaxId</td>
                                <td>@item.City</td>
                                <td>@item.Email</td>
                                <td>@item.Phone</td>
                                <td>@(item.IsBlocked ? "Bloqueado" : "Activo")</td>
                                <td>
                                    <a class="inline-link" href="/crm/clientes/editar/@item.Code">@(canEdit ? "Abrir" : "Ver")</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-bar">
            <span class="muted">Página @filter.Page de @TotalPages</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePageAsync(1)" disabled="@(!CanGoPrevious || isLoading)">Primera</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page - 1)" disabled="@(!CanGoPrevious || isLoading)">Anterior</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page + 1)" disabled="@(!CanGoNext || isLoading)">Siguiente</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(TotalPages)" disabled="@(!CanGoNext || isLoading)">Última</button>
            </div>
        </div>
    </section>
}

@code {
    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private ClienteFilter filter = new() { Page = 1, PageSize = 25, SortColumn = nameof(ClienteListItemDto.Code), SortDescending = true };
    private IReadOnlyCollection<ClienteListItemDto> items = [];
    private IReadOnlyCollection<ClienteListItemDto> filteredItems = [];
    private string errorMessage = string.Empty;
    private QualityFilterMode qualityFilter = QualityFilterMode.All;
    private bool isLoading;
    private string sortColumn = nameof(ClienteListItemDto.Code);
    private bool sortDescending = true;
    private bool isLegacySyncActive;
    private string syncStatusLabel = string.Empty;
    private int totalCount;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)filter.PageSize));
    private bool CanGoPrevious => filter.Page > 1;
    private bool CanGoNext => filter.Page < TotalPages;
    private int PageStart => totalCount == 0 ? 0 : ((filter.Page - 1) * filter.PageSize) + 1;
    private int PageEnd => totalCount == 0 ? 0 : Math.Min(filter.Page * filter.PageSize, totalCount);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsInRole(PlatformRoles.TenantAdmin);

        await LoadSyncStatusAsync();
        canEdit = canEdit && !isLegacySyncActive;

        await LoadAsync();
    }

    private async Task LoadSyncStatusAsync()
    {
        isLegacySyncActive = false;
        syncStatusLabel = string.Empty;

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var status = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
            .FirstOrDefault(item =>
                item.CompanyId == companyId.Value &&
                string.Equals(item.ModuleKey, LegacySyncModuleKeys.CrmClients, StringComparison.OrdinalIgnoreCase));

        if (status is null || !status.HasSuccessfulSync)
        {
            return;
        }

        isLegacySyncActive = true;
        syncStatusLabel = status.LastCompletedUtc.HasValue
            ? $"Última sync: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Act: {status.LastUpdated} · Omi: {status.LastSkipped} · Err: {status.LastErrors}"
            : $"Estado: {status.LastStatus}";
    }

    private async Task LoadAsync()
    {
        errorMessage = string.Empty;
        isLoading = true;

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            items = [];
            filteredItems = [];
            isLoading = false;
            return;
        }

        try
        {
            await InvokeAsync(StateHasChanged);
            filter.SortColumn = sortColumn == "Quality" ? string.Empty : sortColumn;
            filter.SortDescending = sortColumn == "Quality" ? false : sortDescending;

            var result = await ClienteQueries.SearchAsync(tenantId.Value, companyId.Value, filter);
            items = result.Items;
            totalCount = result.TotalCount;
            ApplyQualityFilter();
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            items = [];
            filteredItems = [];
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        filter.Page = 1;
        await LoadAsync();
    }

    private void SetQualityFilter(QualityFilterMode mode)
    {
        qualityFilter = mode;
        ApplyQualityFilter();
    }

    private void ApplyQualityFilter()
    {
        filteredItems = qualityFilter switch
        {
            QualityFilterMode.Ok => items.Where(IsQualityOk).ToArray(),
            QualityFilterMode.Review => items.Where(IsReviewOnly).ToArray(),
            QualityFilterMode.HardDuplicate => items.Where(HasHardDuplicate).ToArray(),
            _ => items
        };
    }

    private static bool HasHardDuplicate(ClienteListItemDto item) =>
        item.HasDuplicateTaxId || item.HasDuplicateEmail;

    private static bool HasSoftDuplicate(ClienteListItemDto item) =>
        item.HasDuplicateName || item.HasDuplicatePhone;

    private static bool IsReviewOnly(ClienteListItemDto item) =>
        !HasHardDuplicate(item) && HasSoftDuplicate(item);

    private static bool IsQualityOk(ClienteListItemDto item) =>
        !HasHardDuplicate(item) && !HasSoftDuplicate(item);

    private IEnumerable<ClienteListItemDto> GetSortedItems()
    {
        if (!string.Equals(sortColumn, "Quality", StringComparison.Ordinal))
        {
            return filteredItems;
        }

        return sortColumn switch
        {
            "Quality" => ApplySort(filteredItems.OrderBy(GetQualityRank).ThenBy(item => item.Name, StringComparer.CurrentCultureIgnoreCase)),
            _ => filteredItems
        };
    }

    private IEnumerable<ClienteListItemDto> ApplySort(IOrderedEnumerable<ClienteListItemDto> orderedItems) =>
        sortDescending ? orderedItems.Reverse() : orderedItems;

    private async Task SetSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(sortColumn, column, StringComparison.Ordinal))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = defaultDescending;
        }

        filter.Page = 1;

        if (string.Equals(column, "Quality", StringComparison.Ordinal))
        {
            ApplyQualityFilter();
            return;
        }

        await LoadAsync();
    }

    private async Task ChangePageAsync(int page)
    {
        var nextPage = Math.Clamp(page, 1, TotalPages);
        if (nextPage == filter.Page)
        {
            return;
        }

        filter.Page = nextPage;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return;
        }

        filter.PageSize = pageSize;
        filter.Page = 1;
        await LoadAsync();
    }

    private static int GetQualityRank(ClienteListItemDto item) =>
        HasHardDuplicate(item) ? 2 : HasSoftDuplicate(item) ? 1 : 0;

    private static string GetDuplicateSummary(ClienteListItemDto item)
    {
        var reasons = new List<string>();

        if (item.HasDuplicateTaxId)
        {
            reasons.Add("NIF repetido");
        }

        if (item.HasDuplicateEmail)
        {
            reasons.Add("email repetido");
        }

        if (item.HasDuplicateName)
        {
            reasons.Add("nombre repetido");
        }

        if (item.HasDuplicatePhone)
        {
            reasons.Add("teléfono repetido");
        }

        return reasons.Count == 0 ? "Sin incidencias" : string.Join(", ", reasons);
    }

    private enum QualityFilterMode
    {
        All,
        Ok,
        Review,
        HardDuplicate
    }
}
