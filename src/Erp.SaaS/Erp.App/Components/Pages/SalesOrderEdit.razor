@page "/ventas/pedidos/nuevo"
@page "/ventas/pedidos/editar/{OrderNumber:int}"
@page "/ventas/pedidos-teixits-mostres/nuevo"
@page "/ventas/pedidos-teixits-mostres/editar/{OrderNumber:int}"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AppText T
@inject IAuditLogService AuditLogService
@inject IClienteQueries ClienteQueries
@inject ILegacySyncService LegacySyncService
@inject ISalesOrderQueries SalesOrderQueries
@inject ISalesOrderService SalesOrderService
@inject NavigationManager NavigationManager

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("Ventas", "Vendes", "Sales")</p>
        <h1>@PageHeadingText</h1>
        <p class="lead">@PageLeadText</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="@BackToListHref">@BackToListText</a>
        <a class="secondary-button link-button" href="@PreInvoicingHref">@PreInvoicingText</a>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p>
    </div>
}
else if (!canEdit && !OrderNumber.HasValue)
{
    <div class="empty-state">
        <p>@L("No tienes permisos para crear pedidos de cliente.", "No tens permisos per crear comandes de client.", "You do not have permission to create customer orders.")</p>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
    }

    @if (isLegacySyncActive)
    {
        <div class="alert warning">
            @(IsTeixitsMostresOrdersRoute
                ? L("Este módulo reutiliza el pedido comercial general y lo filtra al circuito Teixits-Mostres. La sync manual refresca solo los pedidos con origen legacy; cualquier cambio que guardes desde la web convertirá el pedido a local y ya no se sobrescribirá.",
                    "Aquest mòdul reutilitza la comanda comercial general i la filtra al circuit Teixits-Mostres. La sync manual refresca només les comandes amb origen legacy; qualsevol canvi que guardis des del web convertirà la comanda a local i ja no se sobreescriurà.",
                    "This module reuses the standard commercial order and filters it to the fabric and sample workflow. Manual sync refreshes only legacy-origin orders; any change you save from the web converts the order to local and it will no longer be overwritten.")
                : L("Este módulo está sincronizado desde legacy para la empresa activa. La sync manual refresca solo los pedidos con origen legacy; cualquier cambio que guardes desde la web convertirá el pedido a local y ya no se sobrescribirá.",
                    "Aquest mòdul està sincronitzat des de legacy per a l'empresa activa. La sync manual refresca només les comandes amb origen legacy; qualsevol canvi que guardis des del web convertirà la comanda a local i ja no se sobreescriurà.",
                    "This module is synced from legacy for the active company. Manual sync refreshes only orders with legacy origin; any change you save from the web converts the order to local and it will no longer be overwritten."))
            @if (lastSyncUtc.HasValue)
            {
                <span> @L("Última sync:", "Última sync:", "Last sync:") @lastSyncUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss").</span>
            }
        </div>
    }

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <div class="form-grid">
            <label class="field">
                <span>@L("Cliente", "Client", "Customer")</span>
                <InputSelect class="text-input" @bind-Value="model.ClientCode" disabled="@(!canModify)">
                    <option value="0">@L("Selecciona cliente", "Selecciona client", "Select customer")</option>
                    @foreach (var client in clients)
                    {
                        <option value="@client.Code">@client.Name (@client.Code)</option>
                    }
                </InputSelect>
                @if (SelectedClient is not null)
                {
                    <span class="field-hint">@SelectedClient.TaxId · @SelectedClient.City</span>
                }
            </label>
            <label class="field">
                <span>@L("Fecha documento", "Data document", "Document date")</span>
                <InputDate class="text-input" @bind-Value="model.DocumentDate" disabled="@(!canModify)" />
            </label>
            <label class="field">
                <span>@L("Fecha solicitada", "Data sol·licitada", "Requested date")</span>
                <InputDate class="text-input" @bind-Value="model.RequestedDate" disabled="@(!canModify)" />
            </label>
            <label class="field">
                <span>@L("Estado", "Estat", "Status")</span>
                <InputSelect class="text-input" @bind-Value="model.Status" disabled="@(!canModify || HasAnyShipment)">
                    @foreach (var status in SalesOrderStatuses.All)
                    {
                        <option value="@status">@FormatStatus(status)</option>
                    }
                </InputSelect>
                @if (HasAnyShipment)
                {
                    <span class="field-hint">@L("El estado pasa a depender de las cantidades expedidas.", "L'estat passa a dependre de les quantitats expedides.", "Status now depends on shipped quantities.")</span>
                }
            </label>
            <label class="field wide">
                <span>@L("Notas", "Notes", "Notes")</span>
                <InputTextArea class="text-area" @bind-Value="model.Notes" disabled="@(!canModify)" />
            </label>
        </div>

        <section class="panel">
            <div class="page-header">
                <div>
                    <h2>@L("Líneas", "Línies", "Lines")</h2>
                    <p class="muted">@L("Añade artículos, cantidades, precios y fechas pedidas por línea.", "Afegeix articles, quantitats, preus i dates demanades per línia.", "Add items, quantities, prices, and requested dates per line.")</p>
                </div>
                @if (canModify)
                {
                    <button class="secondary-button" type="button" @onclick="AddLine">@L("Añadir línea", "Afegir línia", "Add line")</button>
                }
            </div>

            <div class="stack">
                @for (var index = 0; index < model.Lines.Count; index++)
                {
                    var line = model.Lines[index];
                    <section class="panel line-editor">
                        <div class="panel-header">
                            <strong>@L($"Línea {line.LineNumber}", $"Línia {line.LineNumber}", $"Line {line.LineNumber}")</strong>
                            @if (canModify && model.Lines.Count > 1)
                            {
                                <button class="secondary-button" type="button" @onclick="() => RemoveLine(index)">@L("Quitar", "Treure", "Remove")</button>
                            }
                        </div>
                        <div class="form-grid">
                            <label class="field">
                                <span>@L("Artículo", "Article", "Item")</span>
                                <InputText class="text-input" @bind-Value="line.ItemCode" disabled="@(!canModify)" />
                            </label>
                            <label class="field wide">
                                <span>@L("Descripción", "Descripció", "Description")</span>
                                <InputText class="text-input" @bind-Value="line.Description" disabled="@(!canModify)" />
                            </label>
                            <label class="field">
                                <span>@L("Cantidad", "Quantitat", "Quantity")</span>
                                <InputNumber class="text-input" @bind-Value="line.Quantity" disabled="@(!canModify)" />
                            </label>
                            <label class="field">
                                <span>@L("Unidad", "Unitat", "Unit")</span>
                                <InputText class="text-input" @bind-Value="line.UnitOfMeasure" disabled="@(!canModify)" />
                            </label>
                            <label class="field">
                                <span>@L("Precio unitario", "Preu unitari", "Unit price")</span>
                                <InputNumber class="text-input" @bind-Value="line.UnitPrice" disabled="@(!canModify)" />
                            </label>
                            <label class="field">
                                <span>@L("Pedida", "Demanada", "Requested")</span>
                                <InputDate class="text-input" @bind-Value="line.RequestedDate" disabled="@(!canModify)" />
                            </label>
                            <label class="field wide">
                                <span>@L("Notas línea", "Notes línia", "Line notes")</span>
                                <InputTextArea class="text-area" @bind-Value="line.Notes" disabled="@(!canModify)" />
                            </label>
                        </div>
                        <div class="stack">
                            <div class="muted">@L("Total línea:", "Total línia:", "Line total:") @LineTotal(line).ToUiString("0.00") €</div>
                            <div class="muted">@L("Expedido:", "Expedit:", "Shipped:") @line.ShippedQuantity.ToUiString("0.###") · @L("Pendiente:", "Pendent:", "Pending:") @line.PendingQuantity.ToUiString("0.###")</div>
                        </div>
                    </section>
                }
            </div>
        </section>

        <section class="panel">
            <h2>@L("Resumen", "Resum", "Summary")</h2>
            <div class="card-grid purchase-summary-grid purchase-metrics-grid">
                <article class="info-card">
                    <h2>@model.Lines.Count</h2>
                    <p class="muted">@L("líneas", "línies", "lines")</p>
                </article>
                <article class="info-card">
                    <h2>@TotalQuantity.ToUiString("0.###")</h2>
                    <p class="muted">@L("cantidad total", "quantitat total", "total quantity")</p>
                </article>
                <article class="info-card">
                    <h2>@TotalShippedQuantity.ToUiString("0.###")</h2>
                    <p class="muted">@L("expedido", "expedit", "shipped")</p>
                </article>
                <article class="info-card">
                    <h2>@TotalPendingQuantity.ToUiString("0.###")</h2>
                    <p class="muted">@L("pendiente", "pendent", "pending")</p>
                </article>
                <article class="info-card accent-card">
                    <h2>@TotalAmount.ToUiString("0.00") €</h2>
                    <p class="muted">@L("importe total", "import total", "total amount")</p>
                </article>
            </div>
        </section>

        @if (canModify)
        {
            <div class="quick-links" style="margin-top: 1rem;">
                <button class="primary-button" type="submit">@L("Guardar pedido", "Guardar comanda", "Save order")</button>
            </div>
        }
    </EditForm>

    @if (OrderNumber.HasValue)
    {
        @if (canModify && model.Lines.Any(line => line.PendingQuantity > 0) && !string.Equals(model.Status, SalesOrderStatuses.Cancelled, StringComparison.OrdinalIgnoreCase))
        {
            <section class="panel" style="margin-top: 1rem;">
                <h2>@L("Salida de mercancía", "Sortida de mercaderia", "Goods shipment")</h2>
                <p class="muted">@L("Marca solo las cantidades que salen ahora. La salida generará movimientos de stock reales.", "Marca només les quantitats que surten ara. La sortida generarà moviments d'estoc reals.", "Mark only the quantities shipping now. The shipment will generate real stock movements.")</p>

                <div class="form-grid">
                    <label class="field">
                        <span>@L("Fecha de salida", "Data de sortida", "Shipment date")</span>
                        <InputDate class="text-input" @bind-Value="shipmentForm.ShipmentDate" />
                    </label>
                    <label class="field">
                        <span>@L("Almacén", "Magatzem", "Warehouse")</span>
                        <InputText class="text-input" @bind-Value="shipmentForm.Warehouse" />
                    </label>
                    <label class="field wide">
                        <span>@L("Notas de salida", "Notes de sortida", "Shipment notes")</span>
                        <InputTextArea class="text-area" @bind-Value="shipmentForm.Notes" />
                    </label>
                </div>

                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@L("Línea", "Línia", "Line")</th>
                            <th>@L("Descripción", "Descripció", "Description")</th>
                            <th>@L("Pedida", "Demanada", "Requested")</th>
                            <th>@L("Expedida", "Expedida", "Shipped")</th>
                            <th>@L("Pendiente", "Pendent", "Pending")</th>
                            <th>@L("Salir ahora", "Sortir ara", "Ship now")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in model.Lines)
                        {
                            <tr>
                                <td>@line.LineNumber</td>
                                <td>@line.Description</td>
                                <td>@line.Quantity.ToUiString("0.###")</td>
                                <td>@line.ShippedQuantity.ToUiString("0.###")</td>
                                <td>@line.PendingQuantity.ToUiString("0.###")</td>
                                <td>
                                    <InputNumber class="text-input receipt-qty-input" @bind-Value="line.ShipNowQuantity" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="quick-links" style="margin-top: 1rem;">
                    <button class="primary-button" type="button" @onclick="RegisterShipmentAsync">@L("Registrar salida", "Registrar sortida", "Register shipment")</button>
                </div>
            </section>
        }

        <section class="panel" style="margin-top: 1rem;">
            <h2>@L("Salidas registradas", "Sortides registrades", "Registered shipments")</h2>
            <div class="list-block">
                @if (shipments.Count == 0)
                {
                    <p class="muted">@L("Todavía no hay salidas registradas para este pedido.", "Encara no hi ha sortides registrades per a aquesta comanda.", "There are no registered shipments for this order yet.")</p>
                }
                else
                {
                    @foreach (var shipment in shipments)
                    {
                        <article class="list-item">
                            <strong>@shipment.DisplayNumber · @shipment.ShipmentDate.ToString("dd/MM/yyyy") · @shipment.TotalShippedQuantity.ToUiString("0.###") @L("uds", "uds", "units")</strong>
                            <span>@L("Almacén:", "Magatzem:", "Warehouse:") @DisplayValue(shipment.Warehouse)</span>
                            <span>@L("Facturación:", "Facturació:", "Invoicing:") @FormatInvoiceStatus(shipment.InvoiceStatus)</span>
                            @if (!string.IsNullOrWhiteSpace(shipment.Notes))
                            {
                                <span>@shipment.Notes</span>
                            }
                                        <span>@string.Join(" · ", shipment.Lines.Select(line => $"L{line.LineNumber.ToUiString("N0")}: -{line.ShippedQuantity.ToUiString("0.###")}"))</span>
                            <span><a class="inline-link" href="@BuildShipmentDetailHref(shipment.ShipmentNumber)">@L("Abrir albarán", "Obrir albarà", "Open shipment")</a> · <a class="inline-link" href="@BuildShipmentPdfHref(shipment.ShipmentNumber)" target="_blank">@L("PDF", "PDF", "PDF")</a></span>
                        </article>
                    }
                }
            </div>
        </section>

        <section class="panel" style="margin-top: 1rem;">
            <h2>@L("Historial reciente del pedido", "Historial recent de la comanda", "Recent order history")</h2>
            <div class="list-block">
                @if (recentAuditLogs.Count == 0)
                {
                    <p class="muted">@L("Todavía no hay eventos auditados para este pedido.", "Encara no hi ha esdeveniments auditats per a aquesta comanda.", "There are no audited events for this order yet.")</p>
                }
                else
                {
                    @foreach (var entry in recentAuditLogs)
                    {
                        <article class="list-item">
                            <strong>@entry.Action</strong>
                            @if (!string.IsNullOrWhiteSpace(entry.Details))
                            {
                                <span>@entry.Details</span>
                            }
                            <span>@entry.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </article>
                    }
                }
            </div>
        </section>
    }
}

@code {
    [Parameter]
    public int? OrderNumber { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isLegacySyncActive;
    private bool isLegacyOriginOrder;
    private DateTime? lastSyncUtc;
    private SalesOrderFormModel model = SalesOrderFormModel.CreateDefault();
    private IReadOnlyCollection<ClienteListItemDto> clients = [];
    private IReadOnlyCollection<SalesOrderShipmentDto> shipments = [];
    private IReadOnlyCollection<AuditLogEntryDto> recentAuditLogs = [];
    private string statusMessage = string.Empty;
    private bool isError;
    private ShipmentFormModel shipmentForm = new();
    private bool IsTeixitsMostresOrdersRoute =>
        NavigationManager.ToBaseRelativePath(NavigationManager.Uri).StartsWith("ventas/pedidos-teixits-mostres", StringComparison.OrdinalIgnoreCase);

    private string PageTitleText => OrderNumber.HasValue
        ? IsTeixitsMostresOrdersRoute
            ? L($"Pedido teixits-mostres {OrderNumber}", $"Comanda teixits-mostres {OrderNumber}", $"Fabric & sample order {OrderNumber}")
            : L($"Pedido venta {OrderNumber}", $"Comanda de venda {OrderNumber}", $"Sales order {OrderNumber}")
        : IsTeixitsMostresOrdersRoute
            ? L("Nuevo pedido teixits-mostres", "Nova comanda teixits-mostres", "New fabric & sample order")
            : L("Nuevo pedido de cliente", "Nova comanda de client", "New customer order");

    private string PageHeadingText => OrderNumber.HasValue
        ? IsTeixitsMostresOrdersRoute
            ? L($"Pedido Teixits-Mostres {OrderNumber}", $"Comanda Teixits-Mostres {OrderNumber}", $"Fabric & sample order {OrderNumber}")
            : L($"Pedido {OrderNumber}", $"Comanda {OrderNumber}", $"Order {OrderNumber}")
        : IsTeixitsMostresOrdersRoute
            ? L("Nuevo pedido teixits-mostres", "Nova comanda teixits-mostres", "New fabric & sample order")
            : L("Nuevo pedido de cliente", "Nova comanda de client", "New customer order");

    private string PageLeadText => IsTeixitsMostresOrdersRoute
        ? L("Cabecera, líneas y expedición parcial o total dentro del circuito comercial de tejidos y muestras.", "Capçalera, línies i expedició parcial o total dins del circuit comercial de teixits i mostres.", "Header, lines, and partial or full shipment within the fabrics and samples commercial workflow.")
        : L("Cabecera, líneas y expedición parcial o total con salida de stock desde almacén.", "Capçalera, línies i expedició parcial o total amb sortida d'estoc des del magatzem.", "Header, lines, and partial or full shipment with stock leaving the warehouse.");

    private string BackToListHref => IsTeixitsMostresOrdersRoute ? "/ventas/pedidos-teixits-mostres" : "/ventas/pedidos";

    private string BackToListText => IsTeixitsMostresOrdersRoute
        ? L("Volver a pedidos teixits-mostres", "Tornar a comandes teixits-mostres", "Back to fabric & sample orders")
        : L("Volver al listado", "Tornar al llistat", "Back to list");

    private string PreInvoicingHref => IsTeixitsMostresOrdersRoute ? "/ventas/pre-facturacion-teixits-mostres" : "/ventas/pre-facturacion";

    private string PreInvoicingText => IsTeixitsMostresOrdersRoute
        ? L("Abrir pre-facturación teixits-mostres", "Obrir pre-facturació teixits-mostres", "Open fabric & sample pre-invoicing")
        : L("Abrir pre-facturación", "Obrir pre-facturació", "Open pre-invoicing");

    private ClienteListItemDto? SelectedClient =>
        clients.FirstOrDefault(client => client.Code == model.ClientCode);

    private decimal TotalAmount => model.Lines.Sum(LineTotal);
    private decimal TotalQuantity => model.Lines.Sum(line => line.Quantity);
    private decimal TotalShippedQuantity => model.Lines.Sum(line => line.ShippedQuantity);
    private decimal TotalPendingQuantity => model.Lines.Sum(line => line.PendingQuantity);
    private bool HasAnyShipment => model.Lines.Any(line => line.ShippedQuantity > 0);
    private bool canModify => canEdit;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);
        isLegacyOriginOrder = false;

        if (tenantId.HasValue)
        {
            var syncStatuses = await LegacySyncService.GetModuleStatusesAsync(tenantId.Value);
            var currentSyncStatus = syncStatuses.FirstOrDefault(status =>
                companyId.HasValue &&
                status.CompanyId == companyId.Value &&
                string.Equals(status.ModuleKey, LegacySyncModuleKeys.SalesOrders, StringComparison.OrdinalIgnoreCase));
            isLegacySyncActive = currentSyncStatus?.HasSuccessfulSync == true;
            lastSyncUtc = currentSyncStatus?.LastCompletedUtc;
        }

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        clients = (await ClienteQueries.SearchAsync(tenantId.Value, companyId.Value, new ClienteFilter
        {
            IncludeBlocked = false,
            Page = 1,
            PageSize = 200,
            SortColumn = nameof(ClienteListItemDto.Name)
        })).Items;

        if (OrderNumber.HasValue)
        {
            await ReloadOrderAsync();
            await LoadAuditAsync();
        }
        else
        {
            model = SalesOrderFormModel.CreateDefault();
            shipments = [];
            recentAuditLogs = [];
        }
    }

    private async Task SaveAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !canEdit)
        {
            return;
        }

        try
        {
            statusMessage = string.Empty;
            isError = false;

            var orderNumber = await SalesOrderService.SaveAsync(new SaveSalesOrderCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                OrderNumber = OrderNumber,
                ClientCode = model.ClientCode,
                DocumentDate = model.DocumentDate,
                RequestedDate = model.RequestedDate,
                Status = model.Status,
                Notes = model.Notes,
                Lines = model.Lines.Select(line => new SalesOrderLineInputDto
                {
                    LineNumber = line.LineNumber,
                    ItemCode = line.ItemCode,
                    Description = line.Description,
                    Quantity = line.Quantity,
                    UnitOfMeasure = line.UnitOfMeasure,
                    UnitPrice = line.UnitPrice,
                    RequestedDate = line.RequestedDate,
                    Notes = line.Notes
                }).ToList()
            });

            statusMessage = OrderNumber.HasValue
                ? L("Pedido actualizado correctamente.", "Comanda actualitzada correctament.", "Order updated successfully.")
                : L("Pedido creado correctamente.", "Comanda creada correctament.", "Order created successfully.");

            if (!OrderNumber.HasValue)
            {
                NavigationManager.NavigateTo(BuildOrderEditHref(orderNumber), forceLoad: false);
                return;
            }

            await ReloadOrderAsync();
            await LoadAuditAsync();
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private async Task RegisterShipmentAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !OrderNumber.HasValue || !canEdit)
        {
            return;
        }

        try
        {
            statusMessage = string.Empty;
            isError = false;

            await SalesOrderService.ShipAsync(new RegisterSalesOrderShipmentCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                OrderNumber = OrderNumber.Value,
                ShipmentDate = shipmentForm.ShipmentDate,
                Warehouse = shipmentForm.Warehouse,
                Notes = shipmentForm.Notes,
                Lines = model.Lines
                    .Where(line => line.ShipNowQuantity > 0)
                    .Select(line => new RegisterSalesOrderShipmentLineDto
                    {
                        LineNumber = line.LineNumber,
                        ShippedQuantity = line.ShipNowQuantity
                    })
                    .ToList()
            });

            shipmentForm = new ShipmentFormModel();
            statusMessage = L("Salida registrada correctamente.", "Sortida registrada correctament.", "Shipment registered successfully.");
            await ReloadOrderAsync();
            await LoadAuditAsync();
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private void AddLine()
    {
        model.Lines.Add(new SalesOrderLineFormModel
        {
            LineNumber = GetNextLineNumber(),
            Quantity = 1
        });
    }

    private void RemoveLine(int index)
    {
        if (index < 0 || index >= model.Lines.Count)
        {
            return;
        }

        model.Lines.RemoveAt(index);
        if (model.Lines.Count == 0)
        {
            AddLine();
        }
    }

    private async Task ReloadOrderAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !OrderNumber.HasValue)
        {
            return;
        }

        var detail = await SalesOrderQueries.GetByOrderNumberAsync(tenantId.Value, companyId.Value, OrderNumber.Value);
        if (detail is null)
        {
            statusMessage = L("No se ha encontrado el pedido solicitado.", "No s'ha trobat la comanda sol·licitada.", "The requested order could not be found.");
            isError = true;
            model = SalesOrderFormModel.CreateDefault();
            shipments = [];
            return;
        }

        model = SalesOrderFormModel.FromDetail(detail);
        isLegacyOriginOrder = string.Equals(detail.Origin, SalesOrderOrigins.Legacy, StringComparison.OrdinalIgnoreCase);
        shipments = await SalesOrderQueries.GetShipmentsAsync(tenantId.Value, companyId.Value, OrderNumber.Value);
    }

    private async Task LoadAuditAsync()
    {
        if (!tenantId.HasValue || !OrderNumber.HasValue)
        {
            recentAuditLogs = [];
            return;
        }

        recentAuditLogs = await AuditLogService.GetRecentAsync(
            limit: 15,
            tenantId: tenantId.Value,
            entityName: "PedidoVenta",
            entityId: OrderNumber.Value.ToString());
    }

    private int GetNextLineNumber() => model.Lines.Count == 0 ? 1 : model.Lines.Max(line => line.LineNumber) + 1;

