@page "/ventas/intrastat"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IIntrastatQueries IntrastatQueries
@inject AppText T

<PageTitle>@L("Ventas / Intrastat", "Vendes / Intrastat", "Sales / Intrastat")</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("Ventas", "Vendes", "Sales")</p>
        <h1>@L("Listado Intrastat", "Llistat Intrastat", "Intrastat report")</h1>
        <p class="lead">@L("Detalle y matriz mensual de Intrastat con la misma lectura operativa del Excel legacy: pesos, importes, transporte y códigos arancelarios.",
            "Detall i matriu mensual d'Intrastat amb la mateixa lectura operativa de l'Excel legacy: pesos, imports, transport i codis aranzelaris.",
            "Monthly Intrastat detail and matrix with the same operational reading as the legacy Excel: weights, amounts, transport and tariff codes.")</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="@BuildPrintUrl()" target="_blank">@L("Imprimir", "Imprimir", "Print")</a>
        <a class="secondary-button link-button" href="@BuildExportUrl("excel")">@L("Excel legacy", "Excel legacy", "Legacy Excel")</a>
        <a class="secondary-button link-button" href="@BuildExportUrl("detail")">@L("CSV detalle", "CSV detall", "Detail CSV")</a>
        <a class="secondary-button link-button" href="@BuildExportUrl("summary")">@L("CSV matriz", "CSV matriu", "Matrix CSV")</a>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("Selecciona una empresa activa para generar Intrastat.", "Selecciona una empresa activa per generar Intrastat.", "Select an active company to generate Intrastat.")</p>
    </div>
}
else
{
    <section class="panel">
        <div class="filter-row">
            <label class="field compact-field">
                <span>@L("Mes", "Mes", "Month")</span>
                <select class="sidebar-select compact-select" @bind="filter.Month" disabled="@isLoading">
                    @for (var month = 1; month <= 12; month++)
                    {
                        <option value="@month">@GetMonthLabel(month)</option>
                    }
                </select>
            </label>
            <label class="field compact-field">
                <span>@L("Año", "Any", "Year")</span>
                <input class="text-input compact-input" type="number" @bind="filter.Year" disabled="@isLoading" />
            </label>
            <input class="text-input" @bind="filter.Search" placeholder="@L("Buscar por factura, cliente, VAT, NC code, artículo o descripción", "Buscar per factura, client, VAT, NC code, article o descripció", "Search by invoice, client, VAT, NC code, item or description")" disabled="@isLoading" />
            <label class="checkbox-field compact">
                <input type="checkbox" checked="@filter.OnlyClassified" @onchange="OnOnlyClassifiedChanged" disabled="@isLoading" />
                <span>@L("Solo clasificadas", "Només classificades", "Only classified")</span>
            </label>
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? L("Cargando...", "Carregant...", "Loading...") : L("Buscar", "Buscar", "Search"))</button>
        </div>
        <div class="filter-row results-toolbar" style="margin-top: 0.85rem;">
            <span class="results-summary">
                @(totalCount == 0
                    ? L("Sin resultados", "Sense resultats", "No results")
                    : string.Format(L("Mostrando {0}-{1} de {2} líneas Intrastat", "Mostrant {0}-{1} de {2} línies Intrastat", "Showing {0}-{1} of {2} Intrastat lines"), PageStart, PageEnd, totalCount))
            </span>
            <label class="field compact-field">
                <span>@L("Tamaño de página", "Mida de pàgina", "Page size")</span>
                <select class="sidebar-select compact-select" value="@filter.PageSize" @onchange="OnPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }
    else if (!string.IsNullOrWhiteSpace(periodInfoMessage))
    {
        <div class="alert info">@periodInfoMessage</div>
    }

    <div class="card-grid purchase-summary-grid intrastat-summary-grid">
        <section class="info-card">
            <h2>@report.TotalWeightKg.ToUiString("0.00")</h2>
            <p class="muted">@L("kg total", "kg total", "total kg")</p>
        </section>
        <section class="info-card">
            <h2>@report.SalesAmount.ToUiString("0.00") €</h2>
            <p class="muted">@L("importe venta", "import venda", "sales amount")</p>
        </section>
        <section class="info-card">
            <h2>@report.TransportAmount.ToUiString("0.00") €</h2>
            <p class="muted">@L("transporte", "transport", "transport")</p>
        </section>
        <section class="info-card accent-card">
            <h2>@report.TotalWithTransportAmount.ToUiString("0.00") €</h2>
            <p class="muted">@L("total con transporte", "total amb transport", "total with transport")</p>
        </section>
        <section class="info-card">
            <h2>@report.CountriesCount</h2>
            <p class="muted">@L("países UE", "països UE", "EU countries")</p>
        </section>
        <section class="info-card">
            <h2>@report.ClassifiedLinesCount</h2>
            <p class="muted">@L("líneas clasificadas", "línies classificades", "classified lines")</p>
        </section>
        <section class="info-card">
            <h2>@report.UnclassifiedLinesCount</h2>
            <p class="muted">@L("sin NC code", "sense NC code", "without NC code")</p>
        </section>
    </div>

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)">
        <div class="page-header">
            <div>
                <h2>@L("Detalle de facturas", "Detall de factures", "Invoice detail")</h2>
                <p class="muted">@L("Lectura tipo legacy: factura, cliente, descripción, composición, talla, peso, importe, VAT y descuento.", "Lectura tipus legacy: factura, client, descripció, composició, talla, pes, import, VAT i descompte.", "Legacy-style reading: invoice, client, description, composition, size, weight, amount, VAT and discount.")</p>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>@L("Generando detalle Intrastat...", "Generant detall Intrastat...", "Generating Intrastat detail...")</span>
            </div>
        }

        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <SortableHeader Label="@L("Factura", "Factura", "Invoice")" IsActive="@(sortColumn == nameof(IntrastatLineDto.InvoiceNumber))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(IntrastatLineDto.InvoiceNumber), true))" />
                        <SortableHeader Label="@L("Fecha", "Data", "Date")" IsActive="@(sortColumn == nameof(IntrastatLineDto.IssueDate))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(IntrastatLineDto.IssueDate), true))" />
                        <SortableHeader Label="@L("Cliente", "Client", "Client")" IsActive="@(sortColumn == nameof(IntrastatLineDto.ClientName))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(IntrastatLineDto.ClientName)))" />
                        <th>@L("Descripción", "Descripció", "Description")</th>
                        <th>@L("Composición", "Composició", "Composition")</th>
                        <th>@L("Talla", "Talla", "Size")</th>
                        <SortableHeader Label="@L("Cantidad", "Quantitat", "Quantity")" IsActive="@(sortColumn == nameof(IntrastatLineDto.Quantity))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(IntrastatLineDto.Quantity), true))" />
                        <th>@L("Peso unit.", "Pes unit.", "Unit weight")</th>
                        <SortableHeader Label="@L("Peso total/Kgrs", "Pes total/Kgrs", "Total weight/Kgs")" IsActive="@(sortColumn == nameof(IntrastatLineDto.TotalWeightKg))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(IntrastatLineDto.TotalWeightKg), true))" />
                        <SortableHeader Label="@L("Importe", "Import", "Amount")" IsActive="@(sortColumn == nameof(IntrastatLineDto.NetAmount))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(IntrastatLineDto.NetAmount), true))" />
                        <SortableHeader Label="@L("Código NC", "Codi NC", "CN code")" IsActive="@(sortColumn == nameof(IntrastatLineDto.IntrastatCode))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(IntrastatLineDto.IntrastatCode)))" />
                        <th>@L("IVA", "IVA", "VAT")</th>
                        <th>@L("Dte?", "Dte?", "Disc.?")</th>
                        <SortableHeader Label="@L("País", "País", "Country")" IsActive="@(sortColumn == nameof(IntrastatLineDto.CountryCode))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(IntrastatLineDto.CountryCode)))" />
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        @for (var index = 0; index < 6; index++)
                        {
                            <tr class="table-skeleton-row">
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line"></span></td>
                                <td><span class="skeleton-line"></span></td>
                                <td><span class="skeleton-line"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                            </tr>
                        }
                    }
                    else if (items.Count == 0)
                    {
                        <tr>
                            <td colspan="14" class="table-empty">@L("No hay líneas Intrastat para el filtro seleccionado.", "No hi ha línies Intrastat per al filtre seleccionat.", "There are no Intrastat lines for the selected filter.")</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in items)
                        {
                            <tr class="@GetLineRowClass(item)">
                                <td>
                                    <a class="inline-link" href="/ventas/facturas/@item.InvoiceNumber">@item.DisplayInvoiceNumber</a>
                                </td>
                                <td>@item.IssueDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div>@item.ClientName</div>
                                    <div class="table-subtitle">@item.ClientTaxId</div>
                                </td>
                                <td>
                                    <div>@item.Description</div>
                                    @if (!string.IsNullOrWhiteSpace(item.ItemCode))
                                    {
                                        <div class="table-subtitle">@item.ItemCode</div>
                                    }
                                    @if (item.IsTransportCharge)
                                    {
                                        <div class="intrastat-inline-note">@L("Transit and courier charges", "Transit and courier charges", "Transit and courier charges")</div>
                                    }
                                </td>
                                <td>@DisplayValue(item.Composition)</td>
                                <td>@DisplayValue(item.Size)</td>
                                <td>@item.Quantity.ToUiString("0.###")</td>
                                <td>@item.UnitWeight.ToUiString("0.###")</td>
                                <td>@item.TotalWeightKg.ToUiString("0.00")</td>
                                <td>@item.NetAmount.ToUiString("0.00") €</td>
                                <td>
                                    <span class="status-pill @(item.IsClassified ? "badge-info" : "badge-warning")">
                                        @(item.IsClassified ? item.IntrastatCode : L("Sin clasificar", "Sense classificar", "Unclassified"))
                                    </span>
                                </td>
                                <td>@DisplayValue(item.ClientTaxId)</td>
                    <td>@(item.DiscountAmount == 0m ? "-" : $"{item.DiscountAmount.ToUiString("0.00")} €")</td>
                                <td>
                                    <div>@item.CountryCode</div>
                                    <div class="table-subtitle">@item.CountryName</div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-bar">
            <span class="muted">@string.Format(L("Página {0} de {1}", "Pàgina {0} de {1}", "Page {0} of {1}"), filter.Page, TotalPages)</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePageAsync(1)" disabled="@(!CanGoPrevious || isLoading)">@L("Primera", "Primera", "First")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page - 1)" disabled="@(!CanGoPrevious || isLoading)">@L("Anterior", "Anterior", "Previous")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page + 1)" disabled="@(!CanGoNext || isLoading)">@L("Siguiente", "Següent", "Next")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(TotalPages)" disabled="@(!CanGoNext || isLoading)">@L("Última", "Última", "Last")</button>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="page-header">
            <div>
                <h2>@L("Matriz Intrastat · Excel legacy", "Matriu Intrastat · Excel legacy", "Intrastat matrix · legacy Excel")</h2>
                <p class="muted">@L("Matriz fija por país UE y código arancelario, con pesos y facturación como en la hoja agrupada del legacy.", "Matriu fixa per país UE i codi aranzelari, amb pesos i facturació com al full agrupat del legacy.", "Fixed matrix by EU country and tariff code, with weights and invoicing like the grouped legacy sheet.")</p>
            </div>
        </div>
        <div class="table-scroll">
            <table class="data-table intrastat-matrix-table">
                <thead>
                    <tr>
                        <th rowspan="2">@L("Clientes", "Clients", "Clients")</th>
                        <th rowspan="2">@L("Orden alfabético", "Ordre alfabètic", "Alphabetical order")</th>
                        <th rowspan="2">@L("Siglas", "Sigles", "Code")</th>
                        <th colspan="@report.MatrixNcCodes.Count">@L("Códigos arancelarios · PESOS/Kgrs", "Codis aranzelaris · PESOS/Kgrs", "Tariff codes · WEIGHTS/Kgs")</th>
                        <th rowspan="2">@L("TOTAL PESOS/Kgrs", "TOTAL PESOS/Kgrs", "TOTAL WEIGHTS/Kgs")</th>
                        <th colspan="@report.MatrixNcCodes.Count">@L("Códigos arancelarios · FACTURAS€", "Codis aranzelaris · FACTURES€", "Tariff codes · INVOICES€")</th>
                        <th rowspan="2">@L("TOTAL FACTURAS€", "TOTAL FACTURES€", "TOTAL INVOICES€")</th>
                    </tr>
                    <tr>
                        @foreach (var ncCode in report.MatrixNcCodes)
                        {
                            <th>@ncCode</th>
                        }
                        @foreach (var ncCode in report.MatrixNcCodes)
                        {
                            <th>@ncCode</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (report.MatrixRows.Count == 0)
                    {
                        <tr>
                            <td colspan="@(5 + (report.MatrixNcCodes.Count * 2))" class="table-empty">@L("No hay agrupación para este período.", "No hi ha agrupació per a aquest període.", "There is no grouping for this period.")</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var matrixRow in report.MatrixRows)
                        {
                            <tr class="@GetMatrixRowClass(matrixRow)">
                                <td>@(matrixRow.HasClients ? L("sí", "sí", "yes") : L("no", "no", "no"))</td>
                                <td>@matrixRow.CountryName</td>
                                <td>@matrixRow.CountryCode</td>
                                @foreach (var ncCode in report.MatrixNcCodes)
                                {
                                    <td class="numeric-cell">@FormatMatrixCell(matrixRow.WeightByNcCode.TryGetValue(ncCode, out var weightValue) ? weightValue : 0m)</td>
                                }
                                <td class="numeric-cell">@matrixRow.TotalWeightKg.ToUiString("0.00")</td>
                                @foreach (var ncCode in report.MatrixNcCodes)
                                {
                                    <td class="numeric-cell">@FormatMatrixCell(matrixRow.AmountByNcCode.TryGetValue(ncCode, out var amountValue) ? amountValue : 0m)</td>
                                }
                                <td class="numeric-cell">@matrixRow.TotalInvoiceAmount.ToUiString("0.00")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "month")]
    public int? MonthQuery { get; set; }

    [SupplyParameterFromQuery(Name = "year")]
    public int? YearQuery { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "classified")]
    public bool? OnlyClassifiedQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? PageSizeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortQuery { get; set; }

    [SupplyParameterFromQuery(Name = "desc")]
    public bool? DescQuery { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private IntrastatFilter filter = new();
    private IntrastatReportDto report = new();
    private IReadOnlyCollection<IntrastatLineDto> items = [];
    private bool isLoading;
    private string errorMessage = string.Empty;
    private string periodInfoMessage = string.Empty;
    private bool periodAutoSelected;
    private string sortColumn = nameof(IntrastatLineDto.IssueDate);
    private bool sortDescending = true;
    private int totalCount;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)filter.PageSize));
    private bool CanGoPrevious => filter.Page > 1;
    private bool CanGoNext => filter.Page < TotalPages;
    private int PageStart => totalCount == 0 ? 0 : ((filter.Page - 1) * filter.PageSize) + 1;
    private int PageEnd => totalCount == 0 ? 0 : Math.Min(filter.Page * filter.PageSize, totalCount);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        ApplyQueryState();
        await EnsureDefaultPeriodAsync();
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        ApplyQueryState();
        await Task.CompletedTask;
    }

    private void ApplyQueryState()
    {
        filter.Month = Math.Clamp(MonthQuery ?? DateTime.Today.Month, 1, 12);
        filter.Year = YearQuery ?? DateTime.Today.Year;
        filter.Search = SearchQuery ?? string.Empty;
        filter.OnlyClassified = OnlyClassifiedQuery ?? false;
        filter.Page = Math.Max(PageQuery ?? 1, 1);
        filter.PageSize = Math.Clamp(PageSizeQuery ?? 50, 25, 100);
        sortColumn = string.IsNullOrWhiteSpace(SortQuery) ? nameof(IntrastatLineDto.IssueDate) : SortQuery!;
        sortDescending = DescQuery ?? true;
        filter.SortColumn = sortColumn;
        filter.SortDescending = sortDescending;
    }

    private async Task EnsureDefaultPeriodAsync()
    {
        periodInfoMessage = string.Empty;
        periodAutoSelected = false;
        if (MonthQuery.HasValue || YearQuery.HasValue || !tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var latestPeriod = await IntrastatQueries.GetLatestPeriodAsync(tenantId.Value, companyId.Value);
        if (latestPeriod is null)
        {
            return;
        }

        if (latestPeriod.Year == filter.Year && latestPeriod.Month == filter.Month)
        {
            return;
        }

        filter.Year = latestPeriod.Year;
        filter.Month = latestPeriod.Month;
        periodAutoSelected = true;
        periodInfoMessage = string.Format(L("Mostrando el último período con datos Intrastat: {0} {1}.", "Mostrant l'últim període amb dades Intrastat: {0} {1}.", "Showing the latest period with Intrastat data: {0} {1}."), GetMonthLabel(filter.Month), filter.Year);
    }

    private async Task LoadAsync()
    {
        errorMessage = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            items = [];
            report = new IntrastatReportDto();
            totalCount = 0;
            return;
        }

        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            report = await IntrastatQueries.GetReportAsync(tenantId.Value, companyId.Value, filter);
            items = report.Items;
            totalCount = report.TotalCount;
            if (totalCount == 0)
            {
                var latestPeriod = await IntrastatQueries.GetLatestPeriodAsync(tenantId.Value, companyId.Value);
                if (latestPeriod is not null && (latestPeriod.Year != filter.Year || latestPeriod.Month != filter.Month))
                {
                    periodInfoMessage = string.Format(L("No hay líneas Intrastat para {0} {1}. Último período con datos: {2} {3}.", "No hi ha línies Intrastat per a {0} {1}. Últim període amb dades: {2} {3}.", "There are no Intrastat lines for {0} {1}. Latest period with data: {2} {3}."), GetMonthLabel(filter.Month), filter.Year, GetMonthLabel(latestPeriod.Month), latestPeriod.Year);
                }
                else if (!periodAutoSelected)
                {
                    periodInfoMessage = string.Empty;
                }
            }
            else if (!periodAutoSelected)
            {
                periodInfoMessage = string.Empty;
            }
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            items = [];
            report = new IntrastatReportDto();
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        filter.Page = 1;
        periodAutoSelected = false;
        periodInfoMessage = string.Empty;
        await UpdateQueryStateAsync();
    }

    private async Task SetSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(sortColumn, column, StringComparison.Ordinal))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = defaultDescending;
        }

        filter.SortColumn = sortColumn;
        filter.SortDescending = sortDescending;
        filter.Page = 1;
        periodAutoSelected = false;
        await UpdateQueryStateAsync();
    }

    private async Task ChangePageAsync(int page)
    {
        var newPage = Math.Max(1, Math.Min(page, TotalPages));
        if (newPage == filter.Page)
        {
            return;
        }

        filter.Page = newPage;
        periodAutoSelected = false;
        await UpdateQueryStateAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var newPageSize))
        {
            return;
        }

        filter.PageSize = Math.Clamp(newPageSize, 25, 100);
        filter.Page = 1;
        periodAutoSelected = false;
        await UpdateQueryStateAsync();
    }

    private async Task OnOnlyClassifiedChanged(ChangeEventArgs args)
    {
        filter.OnlyClassified = args.Value as bool? ?? false;
        filter.Page = 1;
        periodAutoSelected = false;
        await UpdateQueryStateAsync();
    }

    private async Task UpdateQueryStateAsync()
    {
        var query = new Dictionary<string, object?>
        {
            ["month"] = filter.Month,
            ["year"] = filter.Year,
            ["search"] = string.IsNullOrWhiteSpace(filter.Search) ? null : filter.Search,
            ["classified"] = filter.OnlyClassified ? true : null,
            ["page"] = filter.Page > 1 ? filter.Page : null,
            ["pageSize"] = filter.PageSize != 50 ? filter.PageSize : null,
            ["sort"] = sortColumn != nameof(IntrastatLineDto.IssueDate) ? sortColumn : null,
            ["desc"] = sortDescending ? true : null
        };

        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(query), replace: true);
        await LoadAsync();
    }

    private string BuildExportUrl(string mode)
    {
        var query = BuildQueryString(includePaging: false);
        return $"/ventas/intrastat/export/{mode}{query}";
    }

    private string BuildPrintUrl()
    {
        return $"/ventas/intrastat/imprimir{BuildQueryString(includePaging: false)}";
    }

    private string BuildQueryString(bool includePaging)
    {
        var parameters = new List<string>
        {
            $"month={filter.Month}",
            $"year={filter.Year}"
        };

        if (!string.IsNullOrWhiteSpace(filter.Search))
        {
            parameters.Add($"search={Uri.EscapeDataString(filter.Search)}");
        }

        if (filter.OnlyClassified)
        {
            parameters.Add("classified=true");
        }

        if (includePaging)
        {
            if (filter.Page > 1)
            {
                parameters.Add($"page={filter.Page}");
            }

            if (filter.PageSize != 50)
            {
                parameters.Add($"pageSize={filter.PageSize}");
            }
        }

        if (!string.Equals(sortColumn, nameof(IntrastatLineDto.IssueDate), StringComparison.Ordinal))
        {
            parameters.Add($"sort={Uri.EscapeDataString(sortColumn)}");
        }

        if (sortDescending)
        {
            parameters.Add("desc=true");
        }

        return parameters.Count == 0 ? string.Empty : $"?{string.Join("&", parameters)}";
    }

    private static string GetMonthLabel(int month) =>
        new DateTime(DateTime.Today.Year, month, 1).ToString("MMMM");

    private static string GetLineRowClass(IntrastatLineDto item)
    {
        if (item.IsTransportCharge)
        {
            return "intrastat-transport-row";
        }

        return item.IsClassified ? string.Empty : "table-row-warning";
    }

    private static string GetMatrixRowClass(IntrastatMatrixRowDto row) =>
        row.IsDomesticReference ? "intrastat-domestic-row" : string.Empty;

    private static string FormatMatrixCell(decimal value) =>
        value == 0m ? string.Empty : value.ToUiString("0.00");

    private static string DisplayValue(string value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };
}
