@page "/plataforma"
@attribute [Authorize(Roles = "PlatformAdmin")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITenantAdminService TenantAdminService
@inject ILeadCaptureService LeadCaptureService
@inject IDemoAccessService DemoAccessService
@inject IAuditLogService AuditLogService
@inject AppText T

<PageTitle>@L("Plataforma", "Plataforma", "Platform")</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("Platform Admin", "Platform Admin", "Platform Admin")</p>
        <h1>@L("Tenants, empresas y usuarios", "Tenants, empreses i usuaris", "Tenants, companies, and users")</h1>
        <p class="lead">@L("Backoffice inicial para alta manual, pricing asistido y gobierno multiempresa.", "Backoffice inicial per a alta manual, pricing assistit i govern multiempresa.", "Initial back office for manual onboarding, assisted pricing, and multi-company governance.")</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
}

<div class="admin-grid">
    <section class="panel">
        <h2>@L("Nuevo tenant", "Nou tenant", "New tenant")</h2>
        <EditForm Model="tenantForm" OnValidSubmit="CreateTenantAsync">
            <div class="stack">
                <label class="field">
                    <span>@L("Nombre", "Nom", "Name")</span>
                    <InputText class="text-input" @bind-Value="tenantForm.Name" />
                </label>
                <label class="field">
                    <span>@L("Slug", "Slug", "Slug")</span>
                    <InputText class="text-input" @bind-Value="tenantForm.Slug" />
                </label>
                <div class="field">
                    <span>@L("Empresas iniciales", "Empreses inicials", "Initial companies")</span>
                    <div class="stack">
                        @for (var index = 0; index < tenantForm.InitialCompanies.Count; index++)
                        {
                            var company = tenantForm.InitialCompanies[index];
                            <section class="panel">
                                <div class="panel-header">
                                    <strong>@L($"Empresa {index + 1}", $"Empresa {index + 1}", $"Company {index + 1}")</strong>
                                    @if (tenantForm.InitialCompanies.Count > 1)
                                    {
                                        <button class="secondary-button" type="button" @onclick="() => RemoveTenantInitialCompany(index)">@L("Quitar", "Treure", "Remove")</button>
                                    }
                                </div>
                                <div class="stack">
                                    <label class="field">
                                        <span>@L("Nombre", "Nom", "Name")</span>
                                        <InputText class="text-input" @bind-Value="company.Name" />
                                    </label>
                                    <label class="field">
                                        <span>@L("Slug", "Slug", "Slug")</span>
                                        <InputText class="text-input" @bind-Value="company.Slug" />
                                    </label>
                                    <label class="field">
                                        <span>@L("Centro legacy", "Centre legacy", "Legacy center")</span>
                                        @if (GetLegacyCentersForTenantInitialCompany(company).Any())
                                        {
                                            <InputSelect class="text-input" @bind-Value="company.LegacyCenterCode">
                                                <option value="">@L("Selecciona centro legacy", "Selecciona centre legacy", "Select legacy center")</option>
                                                @foreach (var center in GetLegacyCentersForTenantInitialCompany(company))
                                                {
                                                    <option value="@center.Code">@FormatLegacyCenter(center)</option>
                                                }
                                            </InputSelect>
                                        }
                                        else
                                        {
                                            <InputText class="text-input" @bind-Value="company.LegacyCenterCode" />
                                        }
                                    </label>
                                </div>
                            </section>
                        }
                    </div>
                    <button class="secondary-button" type="button" @onclick="AddTenantInitialCompany">@L("Añadir empresa inicial", "Afegir empresa inicial", "Add initial company")</button>
                    <p class="muted">@L("Opcional, pero muy útil para arrancar un grupo empresarial con varios centros de una vez.", "Opcional, però molt útil per arrencar un grup empresarial amb diversos centres d'una vegada.", "Optional, but very useful to bootstrap a business group with several centers at once.")</p>
                </div>
                <button class="primary-button" type="submit">@L("Crear tenant", "Crear tenant", "Create tenant")</button>
            </div>
        </EditForm>
    </section>

    <section class="panel">
        <h2>@L("Nueva empresa", "Nova empresa", "New company")</h2>
        <EditForm Model="companyForm" OnValidSubmit="CreateCompanyAsync">
            <div class="stack">
                <label class="field">
                    <span>@L("Tenant", "Tenant", "Tenant")</span>
                    <InputSelect class="text-input" @bind-Value="companyForm.TenantId" @onchange="OnCompanyTenantChanged">
                        <option value="">@L("Selecciona tenant", "Selecciona tenant", "Select tenant")</option>
                        @foreach (var tenant in tenants)
                        {
                            <option value="@tenant.Id">@tenant.Name</option>
                        }
                    </InputSelect>
                </label>
                <label class="field">
                    <span>@L("Nombre", "Nom", "Name")</span>
                    <InputText class="text-input" @bind-Value="companyForm.Name" />
                </label>
                <label class="field">
                    <span>@L("Slug", "Slug", "Slug")</span>
                    <InputText class="text-input" @bind-Value="companyForm.Slug" />
                </label>
                <label class="field">
                    <span>@L("Centro legacy", "Centre legacy", "Legacy center")</span>
                    @if (GetAvailableLegacyCentersForSelectedTenant().Any())
                    {
                        <InputSelect class="text-input" @bind-Value="companyForm.LegacyCenterCode">
                            <option value="">@L("Selecciona centro legacy", "Selecciona centre legacy", "Select legacy center")</option>
                            @foreach (var center in GetAvailableLegacyCentersForSelectedTenant())
                            {
                                <option value="@center.Code">@FormatLegacyCenter(center)</option>
                            }
                        </InputSelect>
                    }
                    else
                    {
                        <InputText class="text-input" @bind-Value="companyForm.LegacyCenterCode" />
                    }
                </label>
                <p class="muted">@L("Cada empresa del mismo tenant debe usar un centro legacy distinto. Si no aparecen centros, puedes escribir el código manualmente.", "Cada empresa del mateix tenant ha d'usar un centre legacy diferent. Si no apareixen centres, pots escriure el codi manualment.", "Each company in the same tenant must use a different legacy center. If no centers appear, you can type the code manually.")</p>
                <button class="primary-button" type="submit">@L("Crear empresa", "Crear empresa", "Create company")</button>
            </div>
        </EditForm>
    </section>

    <section class="panel">
        <h2>@L("Nuevo usuario", "Nou usuari", "New user")</h2>
        <EditForm Model="userForm" OnValidSubmit="CreateUserAsync">
            <div class="stack">
                <label class="field">
                    <span>@L("Tenant", "Tenant", "Tenant")</span>
                    <InputSelect class="text-input" @bind-Value="userForm.TenantId" @onchange="OnUserTenantChanged">
                        <option value="">@L("Selecciona tenant", "Selecciona tenant", "Select tenant")</option>
                        @foreach (var tenant in tenants)
                        {
                            <option value="@tenant.Id">@tenant.Name</option>
                        }
                    </InputSelect>
                </label>
                <label class="field">
                    <span>@L("Nombre", "Nom", "Name")</span>
                    <InputText class="text-input" @bind-Value="userForm.DisplayName" />
                </label>
                <label class="field">
                        <span>@L("Email", "Email", "Email")</span>
                    <InputText class="text-input" @bind-Value="userForm.Email" />
                </label>
                <label class="field">
                    <span>@L("Contraseña", "Contrasenya", "Password")</span>
                    <InputText class="text-input" @bind-Value="userForm.Password" />
                </label>
                <div class="field">
                    <span>@L("Empresas", "Empreses", "Companies")</span>
                    <div class="checkbox-list">
                        @foreach (var company in GetCompaniesForUserTenant())
                        {
                            <label class="checkbox-field compact">
                                <input type="checkbox" checked="@userForm.SelectedCompanyIds.Contains(company.Id)" @onchange="args => ToggleCompany(company.Id, args.Value)" />
                                <span>@company.Name (@company.LegacyCenterCode)</span>
                            </label>
                        }
                    </div>
                </div>
                <div class="field">
                    <span>@L("Roles", "Rols", "Roles")</span>
                    <div class="checkbox-list">
                        @foreach (var role in PlatformRoles.All.Where(role => role != PlatformRoles.PlatformAdmin))
                        {
                            <label class="checkbox-field compact">
                                <input type="checkbox" checked="@userForm.SelectedRoles.Contains(role)" @onchange="args => ToggleRole(role, args.Value)" />
                                <span>@role</span>
                            </label>
                        }
                    </div>
                </div>
                <button class="primary-button" type="submit">@L("Crear usuario", "Crear usuari", "Create user")</button>
            </div>
        </EditForm>
    </section>

    <section class="panel">
        <h2>@L("Leads recientes", "Leads recents", "Recent leads")</h2>
        <div class="list-block">
            @if (recentLeads.Count == 0)
            {
                <p class="muted">@L("Todavía no hay leads registrados.", "Encara no hi ha leads registrats.", "There are no leads registered yet.")</p>
            }
            else
            {
                @foreach (var lead in recentLeads)
                {
                    <article class="list-item">
                        <strong>@lead.CompanyName</strong>
                        <span>@lead.ContactName · @lead.Email</span>
                        <span>@lead.RequestedUsers usuarios · @lead.Status</span>
                    </article>
                }
            }
        </div>
    </section>
</div>

<div class="admin-grid">
    <section class="panel">
        <h2>@L("Solicitudes de acceso demo", "Sol·licituds d'accés demo", "Demo access requests")</h2>
        <div class="list-block">
            @if (recentDemoAccessRequests.Count == 0)
            {
                <p class="muted">@L("Todavía no hay solicitudes de acceso a demo.", "Encara no hi ha sol·licituds d'accés a demo.", "There are no demo access requests yet.")</p>
            }
            else
            {
                @foreach (var request in recentDemoAccessRequests)
                {
                    <article class="list-item">
                        <strong>@request.CompanyName</strong>
                        <span>@request.ContactName · @request.Email</span>
                        <span>@L($"{request.RequestedUsers} usuarios · Estado {request.Status}", $"{request.RequestedUsers} usuaris · Estat {request.Status}", $"{request.RequestedUsers} users · Status {request.Status}")</span>
                        @if (request.RequestedTesterEmails.Length > 0)
                        {
                            <span>@L("Testers pedidos", "Testers demanats", "Requested testers"): @string.Join(", ", request.RequestedTesterEmails)</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(request.Message))
                        {
                            <span>@request.Message</span>
                        }
                        <div class="quick-links">
                            <button class="secondary-button" type="button" @onclick="() => CreateInvitesFromRequestAsync(request)">@L("Invitar emails solicitados", "Convidar emails sol·licitats", "Invite requested emails")</button>
                        </div>
                    </article>
                }
            }
        </div>
    </section>

    <section class="panel">
        <h2>@L("Invitaciones demo", "Invitacions demo", "Demo invites")</h2>
        <EditForm Model="demoInviteForm" OnValidSubmit="CreateManualPreviewInviteAsync">
            <div class="stack">
                <label class="field">
                        <span>@L("Email", "Email", "Email")</span>
                    <InputText class="text-input" @bind-Value="demoInviteForm.Email" />
                </label>
                <label class="field">
                    <span>@L("Nombre", "Nom", "Name")</span>
                    <InputText class="text-input" @bind-Value="demoInviteForm.DisplayName" />
                </label>
                <label class="field">
                    <span>@L("Empresa o grupo", "Empresa o grup", "Company or group")</span>
                    <InputText class="text-input" @bind-Value="demoInviteForm.CompanyName" />
                </label>
                <label class="field">
                    <span>@L("Notas", "Notes", "Notes")</span>
                    <InputTextArea class="text-area" @bind-Value="demoInviteForm.Notes" />
                </label>
                <button class="primary-button" type="submit">@L("Crear invitación", "Crear invitació", "Create invite")</button>
            </div>
        </EditForm>

        <div class="list-block">
            @if (previewInvites.Count == 0)
            {
                <p class="muted">@L("Todavía no hay invitaciones creadas.", "Encara no hi ha invitacions creades.", "There are no invites created yet.")</p>
            }
            else
            {
                @foreach (var invite in previewInvites)
                {
                    <article class="list-item">
                        <strong>@invite.Email</strong>
                        <span>@(string.IsNullOrWhiteSpace(invite.DisplayName) ? L("Sin nombre", "Sense nom", "No name") : invite.DisplayName)</span>
                        <span>@(string.IsNullOrWhiteSpace(invite.CompanyName) ? L("Sin empresa", "Sense empresa", "No company") : invite.CompanyName)</span>
                        <span class="status-pill @(invite.IsActive ? "success" : "warning")">@(invite.IsActive ? L("Activa", "Activa", "Active") : L("Pausada", "Pausada", "Paused"))</span>
                        @if (!string.IsNullOrWhiteSpace(invite.Notes))
                        {
                            <span>@invite.Notes</span>
                        }
                        <div class="quick-links">
                            <button class="secondary-button" type="button" @onclick="() => TogglePreviewInviteActiveAsync(invite)">
                                @(invite.IsActive ? L("Desactivar", "Desactivar", "Deactivate") : L("Reactivar", "Reactivar", "Reactivate"))
                            </button>
                        </div>
                    </article>
                }
            }
        </div>
    </section>
</div>

<div class="admin-grid">
    <section class="panel">
        <h2>@L("Tenants", "Tenants", "Tenants")</h2>
        <div class="list-block">
            @foreach (var tenant in tenants)
            {
                <article class="list-item">
                    <strong>@tenant.Name</strong>
                    <span>@tenant.Slug</span>
                </article>
            }
        </div>
    </section>

    <section class="panel">
        <h2>@L("Empresas", "Empreses", "Companies")</h2>
        <div class="list-block">
            @foreach (var company in companies)
            {
                <article class="list-item">
                    <strong>@company.Name</strong>
                    <span>@GetTenantName(company.TenantId) · @company.LegacyCenterCode · @company.Slug</span>
                    <span>@(company.IsActive ? L("Activa", "Activa", "Active") : L("Inactiva", "Inactiva", "Inactive"))</span>
                    <div class="quick-links">
                        @if (editingCompanyId == company.Id)
                        {
                            <button class="secondary-button" type="button" @onclick="() => SaveCompanyLegacyCenterAsync(company)" disabled="@RequiresCompanyChangeConfirmation(company)">
                                @L("Guardar centro", "Desar centre", "Save center")
                            </button>
                            <button class="secondary-button" type="button" @onclick="CancelCompanyEdit">@L("Cancelar", "Cancel·lar", "Cancel")</button>
                        }
                        else
                        {
                            <button class="secondary-button" type="button" @onclick="() => BeginCompanyEditAsync(company)">@L("Cambiar centro", "Canviar centre", "Change center")</button>
                        }
                    </div>
                </article>

                @if (editingCompanyId == company.Id)
                {
                    <article class="list-item">
                        <strong>@L($"Centro legacy para {company.Name}", $"Centre legacy per a {company.Name}", $"Legacy center for {company.Name}")</strong>
                        <label class="field">
                            <span>@L("Centro legacy", "Centre legacy", "Legacy center")</span>
                            @if (GetLegacyCentersForCompanyEdit(company).Any())
                            {
                                <InputSelect class="text-input" @bind-Value="editingCompanyLegacyCenterCode">
                                    <option value="">@L("Selecciona centro legacy", "Selecciona centre legacy", "Select legacy center")</option>
                                    @foreach (var center in GetLegacyCentersForCompanyEdit(company))
                                    {
                                        <option value="@center.Code">@FormatLegacyCenter(center)</option>
                                    }
                                </InputSelect>
                            }
                            else
                            {
                                <InputText class="text-input" @bind-Value="editingCompanyLegacyCenterCode" />
                            }
                        </label>
                        <p class="muted">@L("El cambio afecta al centro legacy que usará esta empresa en los módulos migrados.", "El canvi afecta el centre legacy que farà servir aquesta empresa als mòduls migrats.", "This change affects the legacy center this company will use in migrated modules.")</p>
                        @if (editingCompanyImpact is not null && editingCompanyImpact.HasUsage)
                        {
                            <div class="alert danger">
                                <strong>@L("Impacto detectado", "Impacte detectat", "Impact detected")</strong>
                                <span>@L("Usuarios asignados", "Usuaris assignats", "Assigned users"): @editingCompanyImpact.AssignedUsersCount</span>
                                <span>@L("Clientes en centro actual", "Clients al centre actual", "Clients in current center"): @editingCompanyImpact.ClientCount</span>
                                <span>@L("Proveedores en centro actual", "Proveïdors al centre actual", "Suppliers in current center"): @editingCompanyImpact.SupplierCount</span>
                                <span>@L("Compras en centro actual", "Compres al centre actual", "Purchases in current center"): @editingCompanyImpact.PurchaseDocumentCount</span>
                                <span>@L("Ventas en centro actual", "Vendes al centre actual", "Sales in current center"): @editingCompanyImpact.SalesDocumentCount</span>
                                <span>@L("Eventos auditados", "Esdeveniments auditats", "Audited events"): @editingCompanyImpact.AuditEventCount</span>
                            </div>
                            <label class="checkbox-field">
                                <input type="checkbox" @bind="confirmCompanyLegacyCenterChange" />
                                <span>@L("Confirmo que quiero cambiar el centro legacy de esta empresa aunque ya tenga uso real.", "Confirmo que vull canviar el centre legacy d'aquesta empresa encara que ja tingui ús real.", "I confirm that I want to change the legacy center of this company even if it already has real usage.")</span>
                            </label>
                        }
                    </article>
                }
            }
        </div>
    </section>

    <section class="panel">
        <h2>@L("Usuarios", "Usuaris", "Users")</h2>
        <div class="list-block">
            @foreach (var user in users)
            {
                <article class="list-item">
                    <strong>@user.DisplayName</strong>
                    <span>@user.Email</span>
                    <span>@(user.IsActive ? L("Activo", "Actiu", "Active") : L("Inactivo", "Inactiu", "Inactive"))</span>
                    <span>@GetTenantName(user.TenantId)</span>
                    <span>@FormatUserCompanies(user)</span>
                    <span>@string.Join(", ", user.Roles)</span>
                    <div class="quick-links">
                        @if (user.TenantId.HasValue)
                        {
                            @if (editingUserId == user.Id)
                            {
                                <button class="secondary-button" type="button" @onclick="() => SaveUserAccessAsync(user)">@L("Guardar permisos", "Desar permisos", "Save permissions")</button>
                                <button class="secondary-button" type="button" @onclick="CancelUserEdit">@L("Cancelar", "Cancel·lar", "Cancel")</button>
                            }
                            else
                            {
                                <button class="secondary-button" type="button" @onclick="() => BeginUserEdit(user)">@L("Editar accesos", "Editar accessos", "Edit access")</button>
                            }
                        }

                        @if (passwordEditorUserId == user.Id)
                        {
                            <button class="secondary-button" type="button" @onclick="() => SaveUserPasswordAsync(user)">@L("Guardar contraseña", "Desar contrasenya", "Save password")</button>
                            <button class="secondary-button" type="button" @onclick="CancelPasswordEdit">@L("Cancelar contraseña", "Cancel·lar contrasenya", "Cancel password")</button>
                        }
                        else
                        {
                            <button class="secondary-button" type="button" @onclick="() => BeginPasswordEdit(user)">@L("Cambiar contraseña", "Canviar contrasenya", "Change password")</button>
                        }

                        <button class="secondary-button" type="button" @onclick="() => ToggleUserActiveAsync(user)">
                            @(user.IsActive ? L("Desactivar", "Desactivar", "Deactivate") : L("Activar", "Activar", "Activate"))
                        </button>
                    </div>
                </article>

                @if (editingUserId == user.Id && user.TenantId.HasValue)
                {
                    <article class="list-item">
                        <strong>@L($"Editar accesos de {user.DisplayName}", $"Editar accessos de {user.DisplayName}", $"Edit access for {user.DisplayName}")</strong>
                        <div class="field">
                            <span>@L("Empresas", "Empreses", "Companies")</span>
                            <div class="checkbox-list">
                                @foreach (var company in GetCompaniesForTenant(user.TenantId.Value))
                                {
                                    <label class="checkbox-field compact">
                                        <input type="checkbox" checked="@editingCompanyIds.Contains(company.Id)" @onchange="args => ToggleEditingCompany(company.Id, args.Value)" />
                                        <span>@company.Name (@company.LegacyCenterCode)</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="field">
                            <span>@L("Roles", "Rols", "Roles")</span>
                            <div class="checkbox-list">
                                @foreach (var role in PlatformRoles.All.Where(role => role != PlatformRoles.PlatformAdmin))
                                {
                                    <label class="checkbox-field compact">
                                        <input type="checkbox" checked="@editingRoles.Contains(role)" @onchange="args => ToggleEditingRole(role, args.Value)" />
                                        <span>@role</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </article>
                }

                @if (passwordEditorUserId == user.Id)
                {
                    <article class="list-item">
                        <strong>@L($"Nueva contraseña para {user.DisplayName}", $"Nova contrasenya per a {user.DisplayName}", $"New password for {user.DisplayName}")</strong>
                        <label class="field">
                            <span>@L("Contraseña nueva", "Contrasenya nova", "New password")</span>
                            <InputText class="text-input" type="password" @bind-Value="passwordEditorValue" />
                        </label>
                        <p class="muted">@L("Usa al menos 8 caracteres. El cambio se guarda al pulsar “Guardar contraseña”.", "Fes servir almenys 8 caràcters. El canvi es desa en prémer “Desar contrasenya”.", "Use at least 8 characters. The change is saved when you click “Save password”.")</p>
                    </article>
                }
            }
        </div>
    </section>
</div>

<section class="panel">
    <h2>@L("Actividad reciente", "Activitat recent", "Recent activity")</h2>
    <div class="list-block">
        @if (recentAuditLogs.Count == 0)
        {
            <p class="muted">@L("Todavía no hay eventos auditados.", "Encara no hi ha esdeveniments auditats.", "There are no audited events yet.")</p>
        }
        else
        {
            @foreach (var entry in recentAuditLogs)
            {
                <article class="list-item">
                    <strong>@entry.Action · @entry.EntityName</strong>
                    <span>@FormatAuditActor(entry)</span>
                    <span>@FormatAuditScope(entry)</span>
                    @if (!string.IsNullOrWhiteSpace(entry.Details))
                    {
                        <span>@entry.Details</span>
                    }
                    <span>@entry.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                </article>
            }
        }
    </div>
</section>

@code {
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    private Guid? currentUserId;
    private IReadOnlyCollection<TenantSummaryDto> tenants = [];
    private IReadOnlyCollection<CompanySummaryDto> companies = [];
    private IReadOnlyCollection<LegacyCenterOptionDto> legacyCenters = [];
    private IReadOnlyCollection<LegacyCenterOptionDto> platformLegacyCenters = [];
    private IReadOnlyCollection<UserSummaryDto> users = [];
    private IReadOnlyCollection<LeadSummaryDto> recentLeads = [];
    private IReadOnlyCollection<DemoAccessRequestSummaryDto> recentDemoAccessRequests = [];
    private IReadOnlyCollection<PreviewInviteSummaryDto> previewInvites = [];
    private IReadOnlyCollection<AuditLogEntryDto> recentAuditLogs = [];
    private TenantFormModel tenantForm = CreateTenantFormModel();
    private CompanyFormModel companyForm = new();
    private UserFormModel userForm = new();
    private DemoInviteFormModel demoInviteForm = new();
    private string statusMessage = string.Empty;
    private bool isError;
    private Guid? editingCompanyId;
    private string editingCompanyLegacyCenterCode = string.Empty;
    private CompanyLegacyCenterImpactDto? editingCompanyImpact;
    private bool confirmCompanyLegacyCenterChange;
    private Guid? editingUserId;
    private HashSet<Guid> editingCompanyIds = [];
    private HashSet<string> editingRoles = [];
    private Guid? passwordEditorUserId;
    private string passwordEditorValue = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.GetUserId();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
