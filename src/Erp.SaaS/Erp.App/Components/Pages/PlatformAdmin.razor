@page "/plataforma"
@attribute [Authorize(Roles = "PlatformAdmin")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITenantAdminService TenantAdminService
@inject ILeadCaptureService LeadCaptureService
@inject IDemoAccessService DemoAccessService
@inject IAuditLogService AuditLogService

<PageTitle>Plataforma</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Platform Admin</p>
        <h1>Tenants, companies y usuarios</h1>
        <p class="lead">Backoffice inicial para alta manual, pricing asistido y gobierno multiempresa.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
}

<div class="admin-grid">
    <section class="panel">
        <h2>Nuevo tenant</h2>
        <EditForm Model="tenantForm" OnValidSubmit="CreateTenantAsync">
            <div class="stack">
                <label class="field">
                    <span>Nombre</span>
                    <InputText class="text-input" @bind-Value="tenantForm.Name" />
                </label>
                <label class="field">
                    <span>Slug</span>
                    <InputText class="text-input" @bind-Value="tenantForm.Slug" />
                </label>
                <div class="field">
                    <span>Companies iniciales</span>
                    <div class="stack">
                        @for (var index = 0; index < tenantForm.InitialCompanies.Count; index++)
                        {
                            var company = tenantForm.InitialCompanies[index];
                            <section class="panel">
                                <div class="panel-header">
                                    <strong>Company @(index + 1)</strong>
                                    @if (tenantForm.InitialCompanies.Count > 1)
                                    {
                                        <button class="secondary-button" type="button" @onclick="() => RemoveTenantInitialCompany(index)">Quitar</button>
                                    }
                                </div>
                                <div class="stack">
                                    <label class="field">
                                        <span>Nombre</span>
                                        <InputText class="text-input" @bind-Value="company.Name" />
                                    </label>
                                    <label class="field">
                                        <span>Slug</span>
                                        <InputText class="text-input" @bind-Value="company.Slug" />
                                    </label>
                                    <label class="field">
                                        <span>Centro legacy</span>
                                        @if (GetLegacyCentersForTenantInitialCompany(company).Any())
                                        {
                                            <InputSelect class="text-input" @bind-Value="company.LegacyCenterCode">
                                                <option value="">Selecciona centro legacy</option>
                                                @foreach (var center in GetLegacyCentersForTenantInitialCompany(company))
                                                {
                                                    <option value="@center.Code">@FormatLegacyCenter(center)</option>
                                                }
                                            </InputSelect>
                                        }
                                        else
                                        {
                                            <InputText class="text-input" @bind-Value="company.LegacyCenterCode" />
                                        }
                                    </label>
                                </div>
                            </section>
                        }
                    </div>
                    <button class="secondary-button" type="button" @onclick="AddTenantInitialCompany">Añadir company inicial</button>
                    <p class="muted">Opcional, pero muy útil para arrancar un grupo empresarial con varios centros de una vez.</p>
                </div>
                <button class="primary-button" type="submit">Crear tenant</button>
            </div>
        </EditForm>
    </section>

    <section class="panel">
        <h2>Nueva company</h2>
        <EditForm Model="companyForm" OnValidSubmit="CreateCompanyAsync">
            <div class="stack">
                <label class="field">
                    <span>Tenant</span>
                    <InputSelect class="text-input" @bind-Value="companyForm.TenantId" @onchange="OnCompanyTenantChanged">
                        <option value="">Selecciona tenant</option>
                        @foreach (var tenant in tenants)
                        {
                            <option value="@tenant.Id">@tenant.Name</option>
                        }
                    </InputSelect>
                </label>
                <label class="field">
                    <span>Nombre</span>
                    <InputText class="text-input" @bind-Value="companyForm.Name" />
                </label>
                <label class="field">
                    <span>Slug</span>
                    <InputText class="text-input" @bind-Value="companyForm.Slug" />
                </label>
                <label class="field">
                    <span>Centro legacy</span>
                    @if (GetAvailableLegacyCentersForSelectedTenant().Any())
                    {
                        <InputSelect class="text-input" @bind-Value="companyForm.LegacyCenterCode">
                            <option value="">Selecciona centro legacy</option>
                            @foreach (var center in GetAvailableLegacyCentersForSelectedTenant())
                            {
                                <option value="@center.Code">@FormatLegacyCenter(center)</option>
                            }
                        </InputSelect>
                    }
                    else
                    {
                        <InputText class="text-input" @bind-Value="companyForm.LegacyCenterCode" />
                    }
                </label>
                <p class="muted">Cada company del mismo tenant debe usar un centro legacy distinto. Si no aparecen centros, puedes escribir el codi manualmente.</p>
                <button class="primary-button" type="submit">Crear company</button>
            </div>
        </EditForm>
    </section>

    <section class="panel">
        <h2>Nuevo usuario</h2>
        <EditForm Model="userForm" OnValidSubmit="CreateUserAsync">
            <div class="stack">
                <label class="field">
                    <span>Tenant</span>
                    <InputSelect class="text-input" @bind-Value="userForm.TenantId" @onchange="OnUserTenantChanged">
                        <option value="">Selecciona tenant</option>
                        @foreach (var tenant in tenants)
                        {
                            <option value="@tenant.Id">@tenant.Name</option>
                        }
                    </InputSelect>
                </label>
                <label class="field">
                    <span>Nombre</span>
                    <InputText class="text-input" @bind-Value="userForm.DisplayName" />
                </label>
                <label class="field">
                    <span>Email</span>
                    <InputText class="text-input" @bind-Value="userForm.Email" />
                </label>
                <label class="field">
                    <span>Contraseña</span>
                    <InputText class="text-input" @bind-Value="userForm.Password" />
                </label>
                <div class="field">
                    <span>Companies</span>
                    <div class="checkbox-list">
                        @foreach (var company in GetCompaniesForUserTenant())
                        {
                            <label class="checkbox-field compact">
                                <input type="checkbox" checked="@userForm.SelectedCompanyIds.Contains(company.Id)" @onchange="args => ToggleCompany(company.Id, args.Value)" />
                                <span>@company.Name (@company.LegacyCenterCode)</span>
                            </label>
                        }
                    </div>
                </div>
                <div class="field">
                    <span>Roles</span>
                    <div class="checkbox-list">
                        @foreach (var role in PlatformRoles.All.Where(role => role != PlatformRoles.PlatformAdmin))
                        {
                            <label class="checkbox-field compact">
                                <input type="checkbox" checked="@userForm.SelectedRoles.Contains(role)" @onchange="args => ToggleRole(role, args.Value)" />
                                <span>@role</span>
                            </label>
                        }
                    </div>
                </div>
                <button class="primary-button" type="submit">Crear usuario</button>
            </div>
        </EditForm>
    </section>

    <section class="panel">
        <h2>Leads recientes</h2>
        <div class="list-block">
            @if (recentLeads.Count == 0)
            {
                <p class="muted">Todavía no hay leads registrados.</p>
            }
            else
            {
                @foreach (var lead in recentLeads)
                {
                    <article class="list-item">
                        <strong>@lead.CompanyName</strong>
                        <span>@lead.ContactName · @lead.Email</span>
                        <span>@lead.RequestedUsers usuarios · @lead.Status</span>
                    </article>
                }
            }
        </div>
    </section>
</div>

<div class="admin-grid">
    <section class="panel">
        <h2>Solicitudes de acceso demo</h2>
        <div class="list-block">
            @if (recentDemoAccessRequests.Count == 0)
            {
                <p class="muted">Todavía no hay solicitudes de acceso a demo.</p>
            }
            else
            {
                @foreach (var request in recentDemoAccessRequests)
                {
                    <article class="list-item">
                        <strong>@request.CompanyName</strong>
                        <span>@request.ContactName · @request.Email</span>
                        <span>@request.RequestedUsers usuarios · Estado @request.Status</span>
                        @if (request.RequestedTesterEmails.Length > 0)
                        {
                            <span>Testers pedidos: @string.Join(", ", request.RequestedTesterEmails)</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(request.Message))
                        {
                            <span>@request.Message</span>
                        }
                        <div class="quick-links">
                            <button class="secondary-button" type="button" @onclick="() => CreateInvitesFromRequestAsync(request)">Invitar emails solicitados</button>
                        </div>
                    </article>
                }
            }
        </div>
    </section>

    <section class="panel">
        <h2>Invitaciones demo</h2>
        <EditForm Model="demoInviteForm" OnValidSubmit="CreateManualPreviewInviteAsync">
            <div class="stack">
                <label class="field">
                    <span>Email</span>
                    <InputText class="text-input" @bind-Value="demoInviteForm.Email" />
                </label>
                <label class="field">
                    <span>Nombre</span>
                    <InputText class="text-input" @bind-Value="demoInviteForm.DisplayName" />
                </label>
                <label class="field">
                    <span>Empresa o grupo</span>
                    <InputText class="text-input" @bind-Value="demoInviteForm.CompanyName" />
                </label>
                <label class="field">
                    <span>Notas</span>
                    <InputTextArea class="text-area" @bind-Value="demoInviteForm.Notes" />
                </label>
                <button class="primary-button" type="submit">Crear invitación</button>
            </div>
        </EditForm>

        <div class="list-block">
            @if (previewInvites.Count == 0)
            {
                <p class="muted">Todavía no hay invitaciones creadas.</p>
            }
            else
            {
                @foreach (var invite in previewInvites)
                {
                    <article class="list-item">
                        <strong>@invite.Email</strong>
                        <span>@(string.IsNullOrWhiteSpace(invite.DisplayName) ? "Sin nombre" : invite.DisplayName)</span>
                        <span>@(string.IsNullOrWhiteSpace(invite.CompanyName) ? "Sin empresa" : invite.CompanyName)</span>
                        <span class="status-pill @(invite.IsActive ? "success" : "warning")">@(invite.IsActive ? "Activa" : "Pausada")</span>
                        @if (!string.IsNullOrWhiteSpace(invite.Notes))
                        {
                            <span>@invite.Notes</span>
                        }
                        <div class="quick-links">
                            <button class="secondary-button" type="button" @onclick="() => TogglePreviewInviteActiveAsync(invite)">
                                @(invite.IsActive ? "Desactivar" : "Reactivar")
                            </button>
                        </div>
                    </article>
                }
            }
        </div>
    </section>
</div>

<div class="admin-grid">
    <section class="panel">
        <h2>Tenants</h2>
        <div class="list-block">
            @foreach (var tenant in tenants)
            {
                <article class="list-item">
                    <strong>@tenant.Name</strong>
                    <span>@tenant.Slug</span>
                </article>
            }
        </div>
    </section>

    <section class="panel">
        <h2>Companies</h2>
        <div class="list-block">
            @foreach (var company in companies)
            {
                <article class="list-item">
                    <strong>@company.Name</strong>
                    <span>@GetTenantName(company.TenantId) · @company.LegacyCenterCode · @company.Slug</span>
                    <span>@(company.IsActive ? "Activa" : "Inactiva")</span>
                    <div class="quick-links">
                        @if (editingCompanyId == company.Id)
                        {
                            <button class="secondary-button" type="button" @onclick="() => SaveCompanyLegacyCenterAsync(company)" disabled="@RequiresCompanyChangeConfirmation(company)">
                                Guardar centro
                            </button>
                            <button class="secondary-button" type="button" @onclick="CancelCompanyEdit">Cancelar</button>
                        }
                        else
                        {
                            <button class="secondary-button" type="button" @onclick="() => BeginCompanyEditAsync(company)">Cambiar centro</button>
                        }
                    </div>
                </article>

                @if (editingCompanyId == company.Id)
                {
                    <article class="list-item">
                        <strong>Centro legacy para @company.Name</strong>
                        <label class="field">
                            <span>Centro legacy</span>
                            @if (GetLegacyCentersForCompanyEdit(company).Any())
                            {
                                <InputSelect class="text-input" @bind-Value="editingCompanyLegacyCenterCode">
                                    <option value="">Selecciona centro legacy</option>
                                    @foreach (var center in GetLegacyCentersForCompanyEdit(company))
                                    {
                                        <option value="@center.Code">@FormatLegacyCenter(center)</option>
                                    }
                                </InputSelect>
                            }
                            else
                            {
                                <InputText class="text-input" @bind-Value="editingCompanyLegacyCenterCode" />
                            }
                        </label>
                        <p class="muted">El cambio afecta al centro legacy que usará esta company en los módulos migrados.</p>
                        @if (editingCompanyImpact is not null && editingCompanyImpact.HasUsage)
                        {
                            <div class="alert danger">
                                <strong>Impacto detectado</strong>
                                <span>Usuarios asignados: @editingCompanyImpact.AssignedUsersCount</span>
                                <span>Clientes en centro actual: @editingCompanyImpact.ClientCount</span>
                                <span>Proveedores en centro actual: @editingCompanyImpact.SupplierCount</span>
                                <span>Compras en centro actual: @editingCompanyImpact.PurchaseDocumentCount</span>
                                <span>Ventas en centro actual: @editingCompanyImpact.SalesDocumentCount</span>
                                <span>Eventos auditados: @editingCompanyImpact.AuditEventCount</span>
                            </div>
                            <label class="checkbox-field">
                                <input type="checkbox" @bind="confirmCompanyLegacyCenterChange" />
                                <span>Confirmo que quiero cambiar el centro legacy de esta company aunque ya tenga uso real.</span>
                            </label>
                        }
                    </article>
                }
            }
        </div>
    </section>

    <section class="panel">
        <h2>Usuarios</h2>
        <div class="list-block">
            @foreach (var user in users)
            {
                <article class="list-item">
                    <strong>@user.DisplayName</strong>
                    <span>@user.Email</span>
                    <span>@(user.IsActive ? "Activo" : "Inactivo")</span>
                    <span>@GetTenantName(user.TenantId)</span>
                    <span>@FormatUserCompanies(user)</span>
                    <span>@string.Join(", ", user.Roles)</span>
                    <div class="quick-links">
                        @if (user.TenantId.HasValue)
                        {
                            @if (editingUserId == user.Id)
                            {
                                <button class="secondary-button" type="button" @onclick="() => SaveUserAccessAsync(user)">Guardar permisos</button>
                                <button class="secondary-button" type="button" @onclick="CancelUserEdit">Cancelar</button>
                            }
                            else
                            {
                                <button class="secondary-button" type="button" @onclick="() => BeginUserEdit(user)">Editar accesos</button>
                            }
                        }

                        @if (passwordEditorUserId == user.Id)
                        {
                            <button class="secondary-button" type="button" @onclick="() => SaveUserPasswordAsync(user)">Guardar contraseña</button>
                            <button class="secondary-button" type="button" @onclick="CancelPasswordEdit">Cancelar contraseña</button>
                        }
                        else
                        {
                            <button class="secondary-button" type="button" @onclick="() => BeginPasswordEdit(user)">Cambiar contraseña</button>
                        }

                        <button class="secondary-button" type="button" @onclick="() => ToggleUserActiveAsync(user)">
                            @(user.IsActive ? "Desactivar" : "Activar")
                        </button>
                    </div>
                </article>

                @if (editingUserId == user.Id && user.TenantId.HasValue)
                {
                    <article class="list-item">
                        <strong>Editar accesos de @user.DisplayName</strong>
                        <div class="field">
                            <span>Companies</span>
                            <div class="checkbox-list">
                                @foreach (var company in GetCompaniesForTenant(user.TenantId.Value))
                                {
                                    <label class="checkbox-field compact">
                                        <input type="checkbox" checked="@editingCompanyIds.Contains(company.Id)" @onchange="args => ToggleEditingCompany(company.Id, args.Value)" />
                                        <span>@company.Name (@company.LegacyCenterCode)</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="field">
                            <span>Roles</span>
                            <div class="checkbox-list">
                                @foreach (var role in PlatformRoles.All.Where(role => role != PlatformRoles.PlatformAdmin))
                                {
                                    <label class="checkbox-field compact">
                                        <input type="checkbox" checked="@editingRoles.Contains(role)" @onchange="args => ToggleEditingRole(role, args.Value)" />
                                        <span>@role</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </article>
                }

                @if (passwordEditorUserId == user.Id)
                {
                    <article class="list-item">
                        <strong>Nueva contraseña para @user.DisplayName</strong>
                        <label class="field">
                            <span>Contraseña nueva</span>
                            <InputText class="text-input" type="password" @bind-Value="passwordEditorValue" />
                        </label>
                        <p class="muted">Usa al menos 8 caracteres. El cambio se guarda al pulsar “Guardar contraseña”.</p>
                    </article>
                }
            }
        </div>
    </section>
</div>

<section class="panel">
    <h2>Actividad reciente</h2>
    <div class="list-block">
        @if (recentAuditLogs.Count == 0)
        {
            <p class="muted">Todavía no hay eventos auditados.</p>
        }
        else
        {
            @foreach (var entry in recentAuditLogs)
            {
                <article class="list-item">
                    <strong>@entry.Action · @entry.EntityName</strong>
                    <span>@FormatAuditActor(entry)</span>
                    <span>@FormatAuditScope(entry)</span>
                    @if (!string.IsNullOrWhiteSpace(entry.Details))
                    {
                        <span>@entry.Details</span>
                    }
                    <span>@entry.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                </article>
            }
        }
    </div>
</section>

@code {
    private Guid? currentUserId;
    private IReadOnlyCollection<TenantSummaryDto> tenants = [];
    private IReadOnlyCollection<CompanySummaryDto> companies = [];
    private IReadOnlyCollection<LegacyCenterOptionDto> legacyCenters = [];
    private IReadOnlyCollection<LegacyCenterOptionDto> platformLegacyCenters = [];
    private IReadOnlyCollection<UserSummaryDto> users = [];
    private IReadOnlyCollection<LeadSummaryDto> recentLeads = [];
    private IReadOnlyCollection<DemoAccessRequestSummaryDto> recentDemoAccessRequests = [];
    private IReadOnlyCollection<PreviewInviteSummaryDto> previewInvites = [];
    private IReadOnlyCollection<AuditLogEntryDto> recentAuditLogs = [];
    private TenantFormModel tenantForm = CreateTenantFormModel();
    private CompanyFormModel companyForm = new();
    private UserFormModel userForm = new();
    private DemoInviteFormModel demoInviteForm = new();
    private string statusMessage = string.Empty;
    private bool isError;
    private Guid? editingCompanyId;
    private string editingCompanyLegacyCenterCode = string.Empty;
    private CompanyLegacyCenterImpactDto? editingCompanyImpact;
    private bool confirmCompanyLegacyCenterChange;
    private Guid? editingUserId;
    private HashSet<Guid> editingCompanyIds = [];
    private HashSet<string> editingRoles = [];
    private Guid? passwordEditorUserId;
    private string passwordEditorValue = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.GetUserId();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        tenants = await TenantAdminService.GetTenantsAsync();
        companies = await TenantAdminService.GetCompaniesAsync();
        platformLegacyCenters = await TenantAdminService.GetLegacyCentersAsync();
        legacyCenters = await TenantAdminService.GetLegacyCentersAsync(companyForm.TenantId == Guid.Empty ? null : companyForm.TenantId);
        users = await TenantAdminService.GetUsersAsync();
        recentLeads = await LeadCaptureService.GetRecentAsync();
        recentDemoAccessRequests = await DemoAccessService.GetRecentRequestsAsync();
        previewInvites = await DemoAccessService.GetRecentInvitesAsync();
        recentAuditLogs = await AuditLogService.GetRecentAsync();
    }

    private async Task CreateTenantAsync()
    {
        await RunAsync(async () =>
        {
            var tenant = await TenantAdminService.CreateTenantAsync(new CreateTenantCommand
            {
                Name = tenantForm.Name,
                Slug = tenantForm.Slug,
                InitialCompanies = tenantForm.InitialCompanies
                    .Select(company => new InitialCompanyInput
                    {
                        Name = company.Name,
                        Slug = company.Slug,
                        LegacyCenterCode = company.LegacyCenterCode
                    })
                    .ToArray()
            });
            tenantForm = CreateTenantFormModel();
            companyForm = new CompanyFormModel { TenantId = tenant.Id };
            userForm = new UserFormModel { TenantId = tenant.Id };
            await ReloadAsync();
            await LoadLegacyCentersAsync(tenant.Id, selectFirstAvailable: true);
        }, "Tenant creado correctamente.");
    }

    private async Task CreateCompanyAsync()
    {
        await RunAsync(async () =>
        {
            var tenantId = companyForm.TenantId;

            await TenantAdminService.CreateCompanyAsync(new CreateCompanyCommand
            {
                TenantId = companyForm.TenantId,
                Name = companyForm.Name,
                Slug = companyForm.Slug,
                LegacyCenterCode = companyForm.LegacyCenterCode
            });
            companyForm = new CompanyFormModel { TenantId = tenantId };
            userForm.TenantId = tenantId;
            await ReloadAsync();
            await LoadLegacyCentersAsync(tenantId, selectFirstAvailable: true);
        }, "Company creada correctamente.");
    }

    private async Task CreateUserAsync()
    {
        await RunAsync(async () =>
        {
            await TenantAdminService.CreateUserAsync(new CreateUserCommand
            {
                TenantId = userForm.TenantId,
                Email = userForm.Email,
                DisplayName = userForm.DisplayName,
                Password = userForm.Password,
                CompanyIds = userForm.SelectedCompanyIds.ToArray(),
                Roles = userForm.SelectedRoles.ToArray()
            });
            userForm = new UserFormModel();
            await ReloadAsync();
        }, "Usuario creado correctamente.");
    }

    private Task OnUserTenantChanged(ChangeEventArgs _)
    {
        userForm.SelectedCompanyIds.Clear();
        return Task.CompletedTask;
    }

    private async Task OnCompanyTenantChanged(ChangeEventArgs _)
    {
        await LoadLegacyCentersAsync(companyForm.TenantId, selectFirstAvailable: true);
    }

    private IEnumerable<CompanySummaryDto> GetCompaniesForUserTenant() =>
        companies.Where(company => company.TenantId == userForm.TenantId);

    private IEnumerable<CompanySummaryDto> GetCompaniesForTenant(Guid tenantId) =>
        companies.Where(company => company.TenantId == tenantId);

    private IEnumerable<LegacyCenterOptionDto> GetAvailableLegacyCentersForSelectedTenant() =>
        legacyCenters.Where(center => !center.IsAssigned);

    private IReadOnlyCollection<LegacyCenterOptionDto> GetLegacyCentersForTenantInitialCompany(TenantInitialCompanyFormModel company)
    {
        var selectedCodes = tenantForm.InitialCompanies
            .Where(otherCompany => !ReferenceEquals(otherCompany, company))
            .Select(otherCompany => otherCompany.LegacyCenterCode)
            .Where(code => !string.IsNullOrWhiteSpace(code))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return platformLegacyCenters
            .Where(center => !selectedCodes.Contains(center.Code))
            .Where(center => string.IsNullOrWhiteSpace(company.LegacyCenterCode) || string.Equals(center.Code, company.LegacyCenterCode, StringComparison.OrdinalIgnoreCase) || !selectedCodes.Contains(center.Code))
            .ToArray();
    }

    private IReadOnlyCollection<LegacyCenterOptionDto> GetLegacyCentersForCompanyEdit(CompanySummaryDto company)
    {
        var assignedCodes = companies
            .Where(candidate => candidate.TenantId == company.TenantId && candidate.Id != company.Id)
            .Select(candidate => candidate.LegacyCenterCode)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return platformLegacyCenters
            .Where(center => !assignedCodes.Contains(center.Code) || string.Equals(center.Code, company.LegacyCenterCode, StringComparison.OrdinalIgnoreCase))
            .ToArray();
    }

    private static string FormatLegacyCenter(LegacyCenterOptionDto center) =>
        string.IsNullOrWhiteSpace(center.Description) ? center.Code : $"{center.Description} ({center.Code})";

    private string GetTenantName(Guid? tenantId)
    {
        if (!tenantId.HasValue)
        {
            return "Plataforma";
        }

        return tenants.FirstOrDefault(tenant => tenant.Id == tenantId.Value)?.Name ?? "Tenant desconocido";
    }

    private string FormatUserCompanies(UserSummaryDto user)
    {
        if (!user.TenantId.HasValue)
        {
            return "Sin company";
        }

        var names = companies
            .Where(company => company.TenantId == user.TenantId.Value && user.CompanyIds.Contains(company.Id))
            .Select(company => $"{company.Name} ({company.LegacyCenterCode})")
            .ToArray();

        return names.Length == 0 ? "Sin companies asignadas" : string.Join(", ", names);
    }

    private static string FormatAuditActor(AuditLogEntryDto entry)
    {
        if (!string.IsNullOrWhiteSpace(entry.ActorDisplayName) && !string.IsNullOrWhiteSpace(entry.ActorEmail))
        {
            return $"{entry.ActorDisplayName} · {entry.ActorEmail}";
        }

        if (!string.IsNullOrWhiteSpace(entry.ActorDisplayName))
        {
            return entry.ActorDisplayName;
        }

        if (!string.IsNullOrWhiteSpace(entry.ActorEmail))
        {
            return entry.ActorEmail;
        }

        return "Actor no disponible";
    }

    private static string FormatAuditScope(AuditLogEntryDto entry)
    {
        var scopeParts = new List<string>();

        if (!string.IsNullOrWhiteSpace(entry.TenantName))
        {
            scopeParts.Add(entry.TenantName);
        }

        if (!string.IsNullOrWhiteSpace(entry.CompanyName))
        {
            scopeParts.Add(entry.CompanyName);
        }

        if (!string.IsNullOrWhiteSpace(entry.EntityId))
        {
            scopeParts.Add($"Id={entry.EntityId}");
        }

        return scopeParts.Count == 0 ? "Sin alcance" : string.Join(" · ", scopeParts);
    }

