    private async Task ToggleUserActiveAsync(UserSummaryDto user)
    {
        await RunAsync(async () =>
        {
            await TenantAdminService.SetUserActiveAsync(new SetUserActiveCommand
            {
                UserId = user.Id,
                IsActive = !user.IsActive
            });

            if (passwordEditorUserId == user.Id)
            {
                CancelPasswordEdit();
            }

            if (editingUserId == user.Id)
            {
                CancelUserEdit();
            }

            await ReloadAsync();
        }, user.IsActive ? "Usuario desactivado correctamente." : "Usuario activado correctamente.");
    }

