    private async Task LoadLegacyCentersAsync(Guid tenantId, bool selectFirstAvailable)
    {
        companyForm.LegacyCenterCode = string.Empty;
        legacyCenters = await TenantAdminService.GetLegacyCentersAsync(tenantId == Guid.Empty ? null : tenantId);

        if (selectFirstAvailable)
        {
            companyForm.LegacyCenterCode = GetAvailableLegacyCentersForSelectedTenant()
                .Select(center => center.Code)
                .FirstOrDefault() ?? string.Empty;
        }
    }

