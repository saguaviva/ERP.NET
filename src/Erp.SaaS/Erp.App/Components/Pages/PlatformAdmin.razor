    private void BeginUserEdit(UserSummaryDto user)
    {
        editingUserId = user.Id;
        editingCompanyIds = [.. user.CompanyIds];
        editingRoles = [.. user.Roles.Where(role => role != PlatformRoles.PlatformAdmin)];
    }

