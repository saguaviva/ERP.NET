    private async Task SaveUserAccessAsync(UserSummaryDto user)
    {
        if (!user.TenantId.HasValue)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await TenantAdminService.AssignUserCompaniesAsync(new AssignUserCompaniesCommand
            {
                UserId = user.Id,
                TenantId = user.TenantId.Value,
                CompanyIds = editingCompanyIds.ToArray()
            });

            await TenantAdminService.AssignUserRolesAsync(new AssignUserRolesCommand
            {
                UserId = user.Id,
                TenantId = user.TenantId.Value,
                Roles = editingRoles.ToArray()
            });

            CancelUserEdit();
            await ReloadAsync();
        }, L("Accesos del usuario actualizados correctamente.", "Accessos de l'usuari actualitzats correctament.", "User access updated successfully."));
    }

