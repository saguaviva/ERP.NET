    private IEnumerable<LegacyCenterOptionDto> GetAvailableLegacyCentersForSelectedTenant() =>
        legacyCenters.Where(center => !center.IsAssigned);

    private IReadOnlyCollection<LegacyCenterOptionDto> GetLegacyCentersForTenantInitialCompany(TenantInitialCompanyFormModel company)
    {
        var selectedCodes = tenantForm.InitialCompanies
            .Where(otherCompany => !ReferenceEquals(otherCompany, company))
            .Select(otherCompany => otherCompany.LegacyCenterCode)
            .Where(code => !string.IsNullOrWhiteSpace(code))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return platformLegacyCenters
            .Where(center => !selectedCodes.Contains(center.Code))
            .Where(center => string.IsNullOrWhiteSpace(company.LegacyCenterCode) || string.Equals(center.Code, company.LegacyCenterCode, StringComparison.OrdinalIgnoreCase) || !selectedCodes.Contains(center.Code))
            .ToArray();
    }

    private IReadOnlyCollection<LegacyCenterOptionDto> GetLegacyCentersForCompanyEdit(CompanySummaryDto company)
    {
        var assignedCodes = companies
            .Where(candidate => candidate.TenantId == company.TenantId && candidate.Id != company.Id)
            .Select(candidate => candidate.LegacyCenterCode)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return platformLegacyCenters
            .Where(center => !assignedCodes.Contains(center.Code) || string.Equals(center.Code, company.LegacyCenterCode, StringComparison.OrdinalIgnoreCase))
            .ToArray();
    }

    private static string FormatLegacyCenter(LegacyCenterOptionDto center) =>
        string.IsNullOrWhiteSpace(center.Description) ? center.Code : $"{center.Description} ({center.Code})";

    private string GetTenantName(Guid? tenantId)
    {
        if (!tenantId.HasValue)
        {
            return L("Plataforma", "Plataforma", "Platform");
        }

        return tenants.FirstOrDefault(tenant => tenant.Id == tenantId.Value)?.Name ?? L("Tenant desconocido", "Tenant desconegut", "Unknown tenant");
    }

    private string FormatUserCompanies(UserSummaryDto user)
    {
        if (!user.TenantId.HasValue)
        {
            return L("Sin empresa", "Sense empresa", "No company");
        }

        var names = companies
            .Where(company => company.TenantId == user.TenantId.Value && user.CompanyIds.Contains(company.Id))
            .Select(company => $"{company.Name} ({company.LegacyCenterCode})")
            .ToArray();

        return names.Length == 0 ? L("Sin empresas asignadas", "Sense empreses assignades", "No assigned companies") : string.Join(", ", names);
    }

    private string FormatAuditActor(AuditLogEntryDto entry)
    {
        if (!string.IsNullOrWhiteSpace(entry.ActorDisplayName) && !string.IsNullOrWhiteSpace(entry.ActorEmail))
        {
            return $"{entry.ActorDisplayName} · {entry.ActorEmail}";
        }

        if (!string.IsNullOrWhiteSpace(entry.ActorDisplayName))
        {
            return entry.ActorDisplayName;
        }

        if (!string.IsNullOrWhiteSpace(entry.ActorEmail))
        {
            return entry.ActorEmail;
        }

        return L("Actor no disponible", "Actor no disponible", "Actor unavailable");
    }

    private string FormatAuditScope(AuditLogEntryDto entry)
    {
        var scopeParts = new List<string>();

        if (!string.IsNullOrWhiteSpace(entry.TenantName))
        {
            scopeParts.Add(entry.TenantName);
        }

        if (!string.IsNullOrWhiteSpace(entry.CompanyName))
        {
            scopeParts.Add(entry.CompanyName);
        }

        if (!string.IsNullOrWhiteSpace(entry.EntityId))
        {
            scopeParts.Add($"Id={entry.EntityId}");
        }

        return scopeParts.Count == 0 ? L("Sin alcance", "Sense abast", "No scope") : string.Join(" · ", scopeParts);
    }

