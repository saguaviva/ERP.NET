    private bool RequiresCompanyChangeConfirmation(CompanySummaryDto company)
    {
        return editingCompanyImpact is not null &&
               editingCompanyImpact.HasUsage &&
               !string.Equals(editingCompanyLegacyCenterCode, company.LegacyCenterCode, StringComparison.OrdinalIgnoreCase) &&
               !confirmCompanyLegacyCenterChange;
    }

    private async Task RunAsync(Func<Task> action, string successMessage)
    {
        try
        {
            statusMessage = string.Empty;
            isError = false;
            await action();
            statusMessage = successMessage;
        }
        catch (Exception exception)
        {
            isError = true;
            statusMessage = exception.Message;
        }
    }

    private void AddTenantInitialCompany()
    {
        var company = new TenantInitialCompanyFormModel
        {
            LegacyCenterCode = platformLegacyCenters
                .Select(center => center.Code)
                .FirstOrDefault(code => tenantForm.InitialCompanies.All(existingCompany => !string.Equals(existingCompany.LegacyCenterCode, code, StringComparison.OrdinalIgnoreCase)))
                ?? string.Empty
        };

        tenantForm.InitialCompanies.Add(company);
    }

    private void RemoveTenantInitialCompany(int index)
    {
        if (index < 0 || index >= tenantForm.InitialCompanies.Count)
        {
            return;
        }

        tenantForm.InitialCompanies.RemoveAt(index);
        if (tenantForm.InitialCompanies.Count == 0)
        {
            tenantForm.InitialCompanies.Add(new TenantInitialCompanyFormModel());
        }
    }

    private static TenantFormModel CreateTenantFormModel()
    {
        var model = new TenantFormModel();
        model.InitialCompanies.Add(new TenantInitialCompanyFormModel());
        return model;
    }

