@page "/login"
@attribute [AllowAnonymous]
@inject ITenantAdminService TenantAdminService
@inject NavigationManager NavigationManager
@inject AppText T

<PageTitle>@T["login.title"]</PageTitle>

<div class="auth-shell">
    <section class="auth-panel">
        <p class="eyebrow">@T["brand.kicker"]</p>
        <h1>@T["login.heading"]</h1>
        <p class="lead">@T["login.lead"]</p>

        @if (Error == "1")
        {
            <div class="alert danger">@T["login.error.invalid"]</div>
        }

        @if (Setup == "1")
        {
            <div class="alert success">@T["login.setup.success"]</div>
        }

        <form class="auth-form" method="post" action="/account/login">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ResolvedReturnUrl" />

            <label class="field">
                <span>@T["login.email"]</span>
                <input class="text-input" name="email" type="email" autocomplete="username" placeholder="@T["login.emailPlaceholder"]" required />
            </label>

            <label class="field">
                <span>@T["login.password"]</span>
                <input class="text-input" name="password" type="password" autocomplete="current-password" placeholder="@T["login.passwordPlaceholder"]" required />
            </label>

            <label class="checkbox-field">
                <input name="rememberMe" type="checkbox" value="true" />
                <span>@T["login.remember"]</span>
            </label>

            <button class="primary-button" type="submit">@T["login.submit"]</button>
        </form>
    </section>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public string? Setup { get; set; }

    private string ResolvedReturnUrl => string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl;

    protected override async Task OnInitializedAsync()
    {
        var setupStatus = await TenantAdminService.GetSetupStatusAsync();
        if (setupStatus.CanRunInitialSetup)
        {
            NavigationManager.NavigateTo("/onboarding", forceLoad: true);
        }
    }
}
