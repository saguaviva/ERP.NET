@page "/articulos/muestras"
@page "/articulos/complementos"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IBaseCatalogQueries BaseCatalogQueries
@inject IMuestraQueries MuestraQueries
@inject ILegacySyncService LegacySyncService
@inject NavigationManager NavigationManager
@inject AppText T

<PageTitle>@L("Artículos", "Articles", "Articles") / @ModulePluralTitle</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@T["menu.articles"]</p>
        <h1>@ModulePluralTitle</h1>
        <p class="lead">@(isLegacySyncActive
            ? L($"Consulta y filtra los {modulePluralLower} de la SaaS local. La importación manual desde legacy refresca solo registros de origen legacy.", $"Consulta i filtra els {modulePluralLower} de la SaaS local. La importació manual des de legacy refresca només registres d'origen legacy.", $"Browse and filter {modulePluralLower} from the local SaaS. Manual import from legacy only refreshes legacy-origin records.")
            : L($"Consulta y filtra los {modulePluralLower} del centro legacy asociado a la empresa activa.", $"Consulta i filtra els {modulePluralLower} del centre legacy associat a l'empresa activa.", $"Browse and filter {modulePluralLower} from the legacy center linked to the active company."))</p>
    </div>
    <div class="quick-links">
        @if (canEdit)
        {
            <a class="primary-button link-button" href="@BuildNewUrl()">@L($"Nuevo {moduleSingularLower}", $"Nou {moduleSingularLower}", $"New {moduleSingularLower}")</a>
        }
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L($"Selecciona una empresa activa para trabajar con {modulePluralLower}.", $"Selecciona una empresa activa per treballar amb {modulePluralLower}.", $"Select an active company to work with {modulePluralLower}.")</p>
    </div>
}
else
{
    <section class="panel">
        <div class="filter-row">
            <input class="text-input" @bind="filter.Search" placeholder="@L("Buscar por código, descripción, cliente, referencia o temporada", "Buscar per codi, descripció, client, referència o temporada", "Search by code, description, client, reference or season")" />
            <select class="sidebar-select compact-select" value="@filter.MachineCode" @onchange="OnMachineChanged" disabled="@isLoading">
                <option value="0">@L("Todas las máquinas", "Totes les màquines", "All machines")</option>
                @foreach (var machine in machineOptions)
                {
                    <option value="@ParseMachineCode(machine.Code)">@FormatMachineOption(machine)</option>
                }
            </select>
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? L("Cargando...", "Carregant...", "Loading...") : L("Buscar", "Buscar", "Search"))</button>
        </div>
        <div class="filter-row results-toolbar" style="margin-top: 0.85rem;">
            <span class="results-summary">
            @(totalCount == 0
                ? L("Sin resultados", "Sense resultats", "No results")
                : L($"Mostrando {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} {modulePluralLower}", $"Mostrant {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} {modulePluralLower}", $"Showing {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} of {totalCount.ToUiString("N0")} {modulePluralLower}"))
            </span>
            <label class="field compact-field">
                <span>@L("Tamaño de página", "Mida de pàgina", "Page size")</span>
                <select class="sidebar-select compact-select" value="@filter.PageSize" @onchange="OnPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }

    @if (isLegacySyncActive)
    {
        <div class="alert">
            @L($"Artículos / {ModulePluralTitle} está en convivencia con legacy para esta empresa. La web guarda cambios solo en la SaaS local y la sync manual refresca únicamente registros de origen legacy.", $"Articles / {ModulePluralTitle} està en convivència amb legacy per a aquesta empresa. La web guarda canvis només a la SaaS local i la sync manual refresca únicament registres d'origen legacy.", $"Articles / {ModulePluralTitle} is running in legacy coexistence mode for this company. The web app saves changes only in the local SaaS and manual sync refreshes legacy-origin records only.")
            @if (IsComplementMode)
            {
                <span>@L(" Este módulo comparte la misma base y la misma sync que Muestras.", " Aquest mòdul comparteix la mateixa base i la mateixa sync que Mostres.", " This module shares the same dataset and sync as Samples.")</span>
            }
            @if (!string.IsNullOrWhiteSpace(syncStatusLabel))
            {
                <span>@syncStatusLabel</span>
            }
        </div>
    }

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)" aria-busy="@isLoading">
        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>@L($"Cargando {modulePluralLower}...", $"Carregant {modulePluralLower}...", $"Loading {modulePluralLower}...")</span>
            </div>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <SortableHeader Label="@L("Código", "Codi", "Code")" IsActive="@(sortColumn == nameof(MuestraListItemDto.Code))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(MuestraListItemDto.Code)))" />
                    <SortableHeader Label="@L("Descripción", "Descripció", "Description")" IsActive="@(sortColumn == nameof(MuestraListItemDto.Description))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(MuestraListItemDto.Description)))" />
                    <SortableHeader Label="@L("Cliente", "Client", "Client")" IsActive="@(sortColumn == nameof(MuestraListItemDto.ClientName))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(MuestraListItemDto.ClientName)))" />
                    <SortableHeader Label="@L("Referencia", "Referència", "Reference")" IsActive="@(sortColumn == nameof(MuestraListItemDto.Reference))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(MuestraListItemDto.Reference)))" />
                    <SortableHeader Label="@L("Temporada", "Temporada", "Season")" IsActive="@(sortColumn == nameof(MuestraListItemDto.Season))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(MuestraListItemDto.Season)))" />
                    <SortableHeader Label="@L("Máquina", "Màquina", "Machine")" IsActive="@(sortColumn == nameof(MuestraListItemDto.MachineCode))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(MuestraListItemDto.MachineCode)))" />
                    <SortableHeader Label="@L("Precio", "Preu", "Price")" IsActive="@(sortColumn == nameof(MuestraListItemDto.UnitPrice))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(MuestraListItemDto.UnitPrice), true))" />
                    <SortableHeader Label="@L("Líneas", "Línies", "Lines")" IsActive="@(sortColumn == nameof(MuestraListItemDto.DetailLinesCount))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(MuestraListItemDto.DetailLinesCount), true))" />
                    <SortableHeader Label="@L("Origen", "Origen", "Origin")" IsActive="@(sortColumn == nameof(MuestraListItemDto.Origin))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(MuestraListItemDto.Origin)))" />
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    @for (var index = 0; index < 5; index++)
                    {
                        <tr class="table-skeleton-row">
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line"></span></td>
                            <td><span class="skeleton-line"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                        </tr>
                    }
                }
                else if (items.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="table-empty">@L($"No hay {modulePluralLower} para mostrar.", $"No hi ha {modulePluralLower} per mostrar.", $"There are no {modulePluralLower} to display.")</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.Code</td>
                            <td>@item.Description</td>
                            <td>@(string.IsNullOrWhiteSpace(item.ClientName) ? L($"Cliente {item.ClientCode}", $"Client {item.ClientCode}", $"Client {item.ClientCode}") : item.ClientName)</td>
                            <td>@item.Reference</td>
                            <td>@item.Season</td>
                            <td>@(string.IsNullOrWhiteSpace(item.MachineName) ? item.MachineCode.ToString() : item.MachineName)</td>
                            <td>@item.UnitPrice.ToUiString("0.00##")</td>
                            <td>@item.DetailLinesCount</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Origin) ? L("local", "local", "local") : item.Origin)</td>
                            <td>
                                <a class="inline-link" href="@BuildEditUrl(item.Code)">@(canEdit ? L("Abrir", "Obrir", "Open") : L("Ver", "Veure", "View"))</a>
                                @if (canEdit)
                                {
                                    <span> · </span>
                                    <a class="inline-link" href="@BuildManufacturingOrderUrl(item)">@L("Crear orden", "Crear ordre", "Create order")</a>
                                }
                                <span> · </span>
                                <a class="inline-link" href="@BuildManufacturingOrdersUrl(item)">@L("Órdenes", "Ordres", "Orders")</a>
                                @if (item.MachineCode > 0)
                                {
                                    <span> · </span>
                                    <a class="inline-link" href="@BuildAcabadosUrl(item)">@L("Acabados", "Acabats", "Finishing")</a>
                                }
                                @if (IsComplementMode && canEdit)
                                {
                                    <span> · </span>
                                    <a class="inline-link" href="@BuildDuplicateUrl(item)">@L("Duplicar", "Duplicar", "Duplicate")</a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="pagination-bar">
            <span class="muted">@L($"Página {filter.Page} de {TotalPages}", $"Pàgina {filter.Page} de {TotalPages}", $"Page {filter.Page} of {TotalPages}")</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePageAsync(1)" disabled="@(!CanGoPrevious || isLoading)">@L("Primera", "Primera", "First")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page - 1)" disabled="@(!CanGoPrevious || isLoading)">@L("Anterior", "Anterior", "Previous")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page + 1)" disabled="@(!CanGoNext || isLoading)">@L("Siguiente", "Següent", "Next")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(TotalPages)" disabled="@(!CanGoNext || isLoading)">@L("Última", "Última", "Last")</button>
            </div>
        </div>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "machine")]
    public int? MachineQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? PageSizeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortQuery { get; set; }

    [SupplyParameterFromQuery(Name = "desc")]
    public bool? DescQuery { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isLoading;
    private bool IsComplementMode => NavigationManager.Uri.Contains("/articulos/complementos", StringComparison.OrdinalIgnoreCase);
    private string CurrentSourceSampleKind => IsComplementMode ? ParteAcabadoSourceKinds.Complement : ParteAcabadoSourceKinds.Sample;
    private string ModulePluralTitle => IsComplementMode ? L("Complementos", "Complements", "Complements") : L("Muestras", "Mostres", "Samples");
    private string modulePluralLower => IsComplementMode ? L("complementos", "complements", "complements") : L("muestras", "mostres", "samples");
    private string moduleSingularLower => IsComplementMode ? L("complemento", "complement", "complement") : L("muestra", "mostra", "sample");
    private MuestraFilter filter = new() { Page = 1, PageSize = 25, SortColumn = nameof(MuestraListItemDto.Code) };
    private IReadOnlyCollection<BaseCatalogListItemDto> machineOptions = [];
    private IReadOnlyCollection<MuestraListItemDto> items = [];
    private string errorMessage = string.Empty;
    private string sortColumn = nameof(MuestraListItemDto.Code);
    private bool sortDescending;
    private bool isLegacySyncActive;
    private string syncStatusLabel = string.Empty;
    private int totalCount;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)filter.PageSize));
    private bool CanGoPrevious => filter.Page > 1;
    private bool CanGoNext => filter.Page < TotalPages;
    private int PageStart => totalCount == 0 ? 0 : ((filter.Page - 1) * filter.PageSize) + 1;
    private int PageEnd => totalCount == 0 ? 0 : Math.Min(filter.Page * filter.PageSize, totalCount);
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);
        await LoadMachineOptionsAsync();
        await LoadSyncStatusAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        ApplyQueryState();
        await LoadAsync();
    }

    private async Task LoadSyncStatusAsync()
    {
        isLegacySyncActive = false;
        syncStatusLabel = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var status = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
            .FirstOrDefault(item =>
                item.CompanyId == companyId.Value &&
                string.Equals(item.ModuleKey, LegacySyncModuleKeys.ArticleMuestras, StringComparison.OrdinalIgnoreCase));

        if (status is null || !status.HasSuccessfulSync)
        {
            return;
        }

        isLegacySyncActive = true;
        syncStatusLabel = status.LastCompletedUtc.HasValue
            ? L($"Última sync: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Act: {status.LastUpdated} · Omi: {status.LastSkipped} · Err: {status.LastErrors}", $"Última sync: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Act: {status.LastUpdated} · Omi: {status.LastSkipped} · Err: {status.LastErrors}", $"Last sync: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Upd: {status.LastUpdated} · Skp: {status.LastSkipped} · Err: {status.LastErrors}")
            : L($"Estado: {status.LastStatus}", $"Estat: {status.LastStatus}", $"Status: {status.LastStatus}");
    }

    private async Task LoadAsync()
    {
        errorMessage = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            items = [];
            totalCount = 0;
            return;
        }

        isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            filter.SortColumn = sortColumn;
            filter.SortDescending = sortDescending;
            var result = await MuestraQueries.SearchAsync(tenantId.Value, companyId.Value, filter);
            items = result.Items;
            totalCount = result.TotalCount;
            if (filter.Page > TotalPages)
            {
                filter.Page = TotalPages;
                result = await MuestraQueries.SearchAsync(tenantId.Value, companyId.Value, filter);
                items = result.Items;
                totalCount = result.TotalCount;
            }
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            items = [];
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        filter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task ChangePageAsync(int page)
    {
        filter.Page = Math.Clamp(page, 1, TotalPages);
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task SetSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(sortColumn, column, StringComparison.Ordinal))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = defaultDescending;
        }

        filter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return;
        }

        filter.PageSize = pageSize;
        filter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task OnMachineChanged(ChangeEventArgs args)
    {
        var machineCode = ParseMachineCode(args.Value?.ToString() ?? string.Empty);
        filter.MachineCode = machineCode > 0 ? machineCode : null;
        filter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private void ApplyQueryState()
    {
        filter.Search = SearchQuery?.Trim() ?? string.Empty;
        filter.MachineCode = MachineQuery > 0 ? MachineQuery : null;
        filter.Page = Math.Max(PageQuery.GetValueOrDefault(1), 1);
        filter.PageSize = PageSizeQuery is 25 or 50 or 100 ? PageSizeQuery.Value : 25;
        sortColumn = NormalizeSortColumn(SortQuery);
        sortDescending = DescQuery.GetValueOrDefault();
        filter.SortColumn = sortColumn;
        filter.SortDescending = sortDescending;
    }

    private void UpdateQueryState()
    {
        var uri = NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(filter.Search) ? null : filter.Search,
            ["machine"] = filter.MachineCode,
            ["page"] = filter.Page > 1 ? filter.Page : null,
            ["pageSize"] = filter.PageSize != 25 ? filter.PageSize : null,
            ["sort"] = string.Equals(sortColumn, nameof(MuestraListItemDto.Code), StringComparison.Ordinal) ? null : sortColumn,
            ["desc"] = sortDescending ? true : null
        });

        NavigationManager.NavigateTo(uri, replace: true);
    }

    private static string NormalizeSortColumn(string? sortColumn) => sortColumn switch
    {
        nameof(MuestraListItemDto.Code) => nameof(MuestraListItemDto.Code),
        nameof(MuestraListItemDto.Description) => nameof(MuestraListItemDto.Description),
        nameof(MuestraListItemDto.ClientName) => nameof(MuestraListItemDto.ClientName),
        nameof(MuestraListItemDto.Reference) => nameof(MuestraListItemDto.Reference),
        nameof(MuestraListItemDto.Season) => nameof(MuestraListItemDto.Season),
        nameof(MuestraListItemDto.MachineCode) => nameof(MuestraListItemDto.MachineCode),
        nameof(MuestraListItemDto.UnitPrice) => nameof(MuestraListItemDto.UnitPrice),
        nameof(MuestraListItemDto.DetailLinesCount) => nameof(MuestraListItemDto.DetailLinesCount),
        nameof(MuestraListItemDto.Origin) => nameof(MuestraListItemDto.Origin),
        _ => nameof(MuestraListItemDto.Code)
    };

    private string BuildNewUrl() => IsComplementMode ? "/articulos/complementos/nueva" : "/articulos/muestras/nueva";

    private string BuildEditUrl(string code)
    {
        var basePath = IsComplementMode ? "/articulos/complementos/editar/" : "/articulos/muestras/editar/";
        return $"{basePath}{Uri.EscapeDataString(code)}";
    }

    private string BuildDuplicateUrl(MuestraListItemDto item)
    {
        var basePath = "/articulos/complementos/nueva";
        return $"{basePath}?duplicateCode={Uri.EscapeDataString(item.Code)}&duplicateClient={item.ClientCode}";
    }

    private string BuildManufacturingOrderUrl(MuestraListItemDto item) =>
        $"/compras/ordenes-fabricacion-muestras/nueva?sampleKind={Uri.EscapeDataString(CurrentSourceSampleKind)}&sampleCode={Uri.EscapeDataString(item.Code)}";

    private string BuildManufacturingOrdersUrl(MuestraListItemDto item) =>
        $"/compras/ordenes-fabricacion-muestras?sourceKind={Uri.EscapeDataString(CurrentSourceSampleKind)}&sourceCode={Uri.EscapeDataString(item.Code)}&live=true";

    private string BuildAcabadosUrl(MuestraListItemDto item) =>
        $"/produccion/acabados?machine={item.MachineCode}&live=true";

    private async Task LoadMachineOptionsAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            machineOptions = [];
            return;
        }

        var result = await BaseCatalogQueries.SearchAsync(tenantId.Value, companyId.Value, BaseCatalogKeys.Machines, new BaseCatalogFilter
        {
            Page = 1,
            PageSize = 200
        });

        machineOptions = result.Items
            .Where(item => int.TryParse(item.Code, out _))
            .OrderBy(item => ParseMachineCode(item.Code))
            .ToArray();
    }

    private static int ParseMachineCode(string code) =>
        int.TryParse(code, out var parsedValue) ? parsedValue : 0;

    private static string FormatMachineOption(BaseCatalogListItemDto item) =>
        string.IsNullOrWhiteSpace(item.Name) ? item.Code : $"{item.Code} · {item.Name}";
}
