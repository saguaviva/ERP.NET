    private void SeedStockFromColors()
    {
        foreach (var colorCode in DistinctModelColorCodes)
        {
            var exists = model.StockLines.Any(item => string.Equals(item.Color?.Trim(), colorCode, StringComparison.OrdinalIgnoreCase));
            if (exists)
            {
                continue;
            }

            model.StockLines.Add(new ModeloStockLineDto
            {
                LineNumber = NextLineNumber(model.StockLines.Select(item => item.LineNumber)),
                Color = colorCode,
                SizeText = string.Join(" / ", GetDefinedSizes())
            });
        }
    }

