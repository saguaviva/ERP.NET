            var targetUrl = $"/articulos/models/editar/{savedId}";
            if (!string.Equals(NavigationManager.Uri, NavigationManager.ToAbsoluteUri(targetUrl).ToString(), StringComparison.OrdinalIgnoreCase))
            {
                NavigationManager.NavigateTo(targetUrl, replace: true);
            }

            Id = savedId.ToString();
            await LoadAsync();
