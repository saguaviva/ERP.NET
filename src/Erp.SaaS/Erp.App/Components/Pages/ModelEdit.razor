        {
            statusMessage = exception.Message;
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !canEdit || model.Id == Guid.Empty)
        {
            return;
        }

        isLoading = true;
        try
        {
            await ModeloService.DeleteAsync(tenantId.Value, companyId.Value, model.Id);
            NavigationManager.NavigateTo("/articulos/models");
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadAuditAsync()
    {
        if (!tenantId.HasValue || model.Id == Guid.Empty)
        {
            recentAuditLogs = [];
            return;
        }

        recentAuditLogs = await AuditLogService.GetRecentAsync(
            limit: 15,
            tenantId: tenantId.Value,
            entityName: "article_model",
            entityId: model.Id.ToString());
    }

    private async Task LoadLinkedManufacturingOrdersAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || string.IsNullOrWhiteSpace(model.Code))
        {
            linkedManufacturingOrders = [];
            return;
        }

        isLoadingLinkedManufacturingOrders = true;
        try
        {
            var result = await ParteAcabadoQueries.SearchAsync(tenantId.Value, companyId.Value, new ParteAcabadoFilter
            {
                SourceSampleKind = ParteAcabadoSourceKinds.Model,
                SourceSampleCode = model.Code,
                ModelWorkflowOnly = true,
                Page = 1,
                PageSize = 20,
                SortColumn = nameof(ParteAcabadoListItemDto.Date),
                SortDescending = true
            });

            linkedManufacturingOrders = result.Items
                .OrderByDescending(item => item.Date ?? DateTime.MinValue)
                .ThenByDescending(item => item.OrderNumber)
                .ToArray();
        }
        catch
        {
            linkedManufacturingOrders = [];
        }
        finally
        {
            isLoadingLinkedManufacturingOrders = false;
        }
    }

    private void AddScandalloLine()
