    private int GetLinkedOrderStatusCount(string status) =>
        linkedManufacturingOrders.Count(item => string.Equals(item.Status, status, StringComparison.OrdinalIgnoreCase));

    private string GetLinkedOrderStatusLabel(string status) => status switch
    {
        ParteAcabadoStatuses.Pending => L("Pendiente", "Pendent", "Pending"),
        ParteAcabadoStatuses.InProgress => L("En proceso", "En procés", "In progress"),
        ParteAcabadoStatuses.Finished => L("Terminado", "Terminat", "Finished"),
        ParteAcabadoStatuses.Cancelled => L("Anulado", "Anul·lat", "Cancelled"),
        _ => status
    };

    private static string GetLinkedOrderStatusTone(string status) => status switch
    {
        ParteAcabadoStatuses.Finished => "ok",
        ParteAcabadoStatuses.InProgress => "review",
        ParteAcabadoStatuses.Cancelled => "blocked",
        _ => "review"
    };

    private static string GetLinkedOrderDisplayText(string name, int code)
    {
        if (!string.IsNullOrWhiteSpace(name))
        {
            return name;
        }

        return code > 0 ? code.ToString() : "-";
    }

    private static string GetLinkedOrderFabricLabel(ParteAcabadoListItemDto item) =>
        !string.IsNullOrWhiteSpace(item.PrimaryFabricDescription)
            ? item.PrimaryFabricDescription
            : !string.IsNullOrWhiteSpace(item.PrimaryFabricCode)
                ? item.PrimaryFabricCode
                : "-";

