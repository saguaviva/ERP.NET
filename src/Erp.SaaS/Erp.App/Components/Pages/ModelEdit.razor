}

@code {
    [Parameter]
    public string? Id { get; set; }

    private bool IsNewRoute => EditRouteMode.IsCreateRoute(NavigationManager, "articulos/models/nuevo");
    private bool HasExistingRecord => !IsNewRoute && !string.IsNullOrWhiteSpace(Id);

    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isLoading;
    private bool isError;
    private bool isLegacySyncActive;
    private string syncStatusLabel = string.Empty;
    private string statusMessage = string.Empty;
    private ModeloDetailDto model = new();
    private IReadOnlyCollection<AuditLogEntryDto> recentAuditLogs = [];
    private IReadOnlyCollection<ParteAcabadoListItemDto> linkedManufacturingOrders = [];
    private bool isLoadingLinkedManufacturingOrders;
    private ModelTab activeTab = ModelTab.Ficha;
    private string colorToAdd = string.Empty;
    private string colorToRemove = string.Empty;

    private string PageTitleText => !HasExistingRecord
        ? L("Nuevo model", "Nou model", "New model")
        : $"Model · {model.Code}";
    private bool isReadOnly => isLoading || !canEdit;
    private string DisplayOrigin => string.IsNullOrWhiteSpace(model.Origin)
        ? L("local", "local", "local")
        : model.Origin;
    private string DisplayClient => string.IsNullOrWhiteSpace(model.ClientName)
        ? $"{L("Cliente", "Client", "Client")} {model.ClientCode}"
        : model.ClientName;
    private List<string> DistinctScandalloTitles => model.ScandalloLines
        .Select(item => item.Title?.Trim())
        .Where(item => !string.IsNullOrWhiteSpace(item))
        .Select(item => item!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(item => item, StringComparer.OrdinalIgnoreCase)
        .ToList();
    private List<string> DistinctModelColorCodes => model.ColorLines
        .Select(item => item.ModelColorCode?.Trim())
        .Where(item => !string.IsNullOrWhiteSpace(item))
        .Select(item => item!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(item => item, StringComparer.OrdinalIgnoreCase)
        .ToList();
    private bool HasScandalloPieces => DistinctScandalloTitles.Count > 0;
    private bool HasColorCodes => DistinctModelColorCodes.Count > 0;
    private int MissingColorPieceRowsCount => CountMissingColorPieceRows();
    private int OrphanColorTitleCount => model.ColorLines.Count(item =>
        !string.IsNullOrWhiteSpace(item.Title) &&
        !DistinctScandalloTitles.Contains(item.Title.Trim(), StringComparer.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);
        await LoadSyncStatusAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        statusMessage = string.Empty;
        isError = false;

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        if (!HasExistingRecord)
        {
            model = new ModeloDetailDto();
            recentAuditLogs = [];
            linkedManufacturingOrders = [];
            activeTab = ModelTab.Ficha;
            return;
        }

        if (!Guid.TryParse(Id, out var idValue))
        {
            statusMessage = L("El identificador del model no es válido.", "L'identificador del model no és vàlid.", "The model identifier is not valid.");
            isError = true;
            model = new ModeloDetailDto();
            recentAuditLogs = [];
            linkedManufacturingOrders = [];
            return;
        }

        isLoading = true;
        try
        {
            var detail = await ModeloQueries.GetByIdAsync(tenantId.Value, companyId.Value, idValue);
            if (detail is null)
            {
                statusMessage = L("No se ha encontrado el model solicitado.", "No s'ha trobat el model sol·licitat.", "The requested model could not be found.");
                isError = true;
                model = new ModeloDetailDto();
                recentAuditLogs = [];
                linkedManufacturingOrders = [];
                return;
            }

            model = detail;
            await LoadAuditAsync();
            await LoadLinkedManufacturingOrdersAsync();
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
            model = new ModeloDetailDto();
            recentAuditLogs = [];
            linkedManufacturingOrders = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadSyncStatusAsync()
    {
        isLegacySyncActive = false;
        syncStatusLabel = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var status = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
            .FirstOrDefault(item =>
                item.CompanyId == companyId.Value &&
                string.Equals(item.ModuleKey, LegacySyncModuleKeys.ArticleModels, StringComparison.OrdinalIgnoreCase));

        if (status is null || !status.HasSuccessfulSync)
        {
            return;
        }

        isLegacySyncActive = true;
        syncStatusLabel = status.LastCompletedUtc.HasValue
            ? $"{L("Última sync", "Última sync", "Last sync")}: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Act: {status.LastUpdated} · Omi: {status.LastSkipped} · Err: {status.LastErrors}"
            : string.Empty;
    }

    private async Task SaveAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !canEdit)
        {
            return;
        }

        isLoading = true;
        try
        {
            var savedId = await ModeloService.SaveAsync(new SaveModeloCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                Id = HasExistingRecord && model.Id != Guid.Empty ? model.Id : null,
                Code = model.Code,
                Series = model.Series,
                Season = model.Season,
                ClientCode = model.ClientCode,
                ClientName = model.ClientName,
                Description = model.Description,
                ModelCode = model.ModelCode,
                FabricCode = model.FabricCode,
                FabricDescription = model.FabricDescription,
                SupplierCode = model.SupplierCode,
                SupplierName = model.SupplierName,
                WidthText = model.WidthText,
                DyeingWorkshopCode = model.DyeingWorkshopCode,
                DyeingWorkshopName = model.DyeingWorkshopName,
                FinishingWorkshopCode = model.FinishingWorkshopCode,
                FinishingWorkshopName = model.FinishingWorkshopName,
