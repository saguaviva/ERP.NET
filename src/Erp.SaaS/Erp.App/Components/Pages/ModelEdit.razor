@page "/articulos/models/nuevo"
@page "/articulos/models/editar/{Id}"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuditLogService AuditLogService
@inject IModeloQueries ModeloQueries
@inject IParteAcabadoQueries ParteAcabadoQueries
@inject IModeloService ModeloService
@inject ILegacySyncService LegacySyncService
@inject NavigationManager NavigationManager
@inject AppText T

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("ARTÍCULOS", "ARTICLES", "ARTICLES")</p>
        <h1>@PageTitleText</h1>
        <p class="lead">@(isLegacySyncActive
            ? L("Edición sobre la SaaS local. La importación manual desde legacy refresca solo registros marcados como legacy.", "Edició sobre la SaaS local. La importació manual des de legacy refresca només registres marcats com a legacy.", "Editing on the local SaaS. Manual legacy import only refreshes records marked as legacy.")
            : L("Alta y edición sobre la réplica SaaS de models, aislada por tenant y empresa activa.", "Alta i edició sobre la rèplica SaaS de models, aïllada per tenant i empresa activa.", "Create and edit on the SaaS model replica, isolated by tenant and active company."))</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="/articulos/models">@L("Volver al listado", "Tornar al llistat", "Back to list")</a>
        @if (model.Id != Guid.Empty)
        {
            <a class="secondary-button link-button" href="@BuildPrintUrl(model.Id)">@L("Imprimir ficha", "Imprimir fitxa", "Print sheet")</a>
            <a class="secondary-button link-button" href="@BuildManufacturingOrderUrl(model.Id)">@L("Crear orden fabricación", "Crear ordre fabricació", "Create manufacturing order")</a>
            @if (!string.IsNullOrWhiteSpace(model.Code))
            {
                <a class="secondary-button link-button" href="@BuildManufacturingOrdersUrl(model.Code)">@L("Órdenes fabricación", "Ordres fabricació", "Manufacturing orders")</a>
            }
        }
        @if (!string.IsNullOrWhiteSpace(model.FabricCode))
        {
            <a class="secondary-button link-button" href="@BuildTejidoUrl(model.FabricCode)">@L("Abrir tejido", "Obrir teixit", "Open fabric")</a>
        }
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "No active company selected.")</p>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
    }

    @if (isLegacySyncActive)
    {
        <div class="alert">
            @L("Artículos / Models está en convivencia con legacy para esta empresa.", "Articles / Models està en convivència amb legacy per a aquesta empresa.", "Articles / Models is running alongside legacy for this company.")
            @L("La ficha guarda cambios solo en la SaaS local y la sync manual refresca únicamente registros de origen legacy.", "La fitxa desa canvis només a la SaaS local i la sync manual refresca únicament registres d'origen legacy.", "This record saves changes only in the local SaaS and manual sync refreshes legacy-origin records only.")
            @if (!string.IsNullOrWhiteSpace(syncStatusLabel))
            {
                <span>@syncStatusLabel</span>
            }
        </div>
    }

    @if (!canEdit && !HasExistingRecord)
    {
        <div class="alert">
            @L("No tienes permisos de edición para crear models en esta empresa.", "No tens permisos d'edició per crear models en aquesta empresa.", "You do not have edit permissions to create models in this company.")
        </div>
    }

    <section class="summary-card-grid">
        <article class="summary-card">
            <span class="summary-card-label">@L("Origen", "Origen", "Origin")</span>
            <strong>@DisplayOrigin</strong>
            <span class="summary-card-meta">@($"{model.CompanyCenterCode} · {model.Season} · {model.Series}")</span>
        </article>
        <article class="summary-card">
            <span class="summary-card-label">@L("Cliente", "Client", "Client")</span>
            <strong>@DisplayClient</strong>
            <span class="summary-card-meta">@($"{L("Código", "Codi", "Code")} {model.ClientCode}")</span>
        </article>
        <article class="summary-card">
            <span class="summary-card-label">@L("Detalle", "Detall", "Detail")</span>
            <strong>@($"{model.ScandalloLines.Count} esc. · {model.ColorLines.Count} col.")</strong>
            <span class="summary-card-meta">@($"{model.FornituraLines.Count} {L("forn.", "forn.", "trim.")} · {model.StockLines.Count} {L("stock", "stock", "stock")}")</span>
        </article>
        <article class="summary-card">
            <span class="summary-card-label">@L("Venta final", "Venda final", "Final sale")</span>
            <strong>@model.FinalSalePrice.ToUiString("0.00##")</strong>
            <span class="summary-card-meta">@($"{L("Coste", "Cost", "Cost")} {model.CostPrice.ToUiString("0.00##")} · {L("margen", "marge", "margin")} {model.MarginPercent.ToUiString("0.0#")}%")</span>
        </article>
    </section>

    <div class="record-tabs" style="margin-top: 1rem;">
        <button class="record-tab @(activeTab == ModelTab.Ficha ? "active" : null)" type="button" @onclick="@(() => activeTab = ModelTab.Ficha)">@L("Model", "Model", "Model")</button>
        <button class="record-tab @(activeTab == ModelTab.Scandallo ? "active" : null)" type="button" @onclick="@(() => activeTab = ModelTab.Scandallo)">@L("Escandallo", "Escandall", "Bill of materials")</button>
        <button class="record-tab @(activeTab == ModelTab.Colores ? "active" : null)" type="button" @onclick="@(() => activeTab = ModelTab.Colores)">@L("Colores", "Colors", "Colors")</button>
        <button class="record-tab @(activeTab == ModelTab.Fornituras ? "active" : null)" type="button" @onclick="@(() => activeTab = ModelTab.Fornituras)">@L("Fornituras", "Fornitures", "Trims")</button>
        <button class="record-tab @(activeTab == ModelTab.Stock ? "active" : null)" type="button" @onclick="@(() => activeTab = ModelTab.Stock)">@L("Stock", "Stock", "Stock")</button>
        <button class="record-tab @(activeTab == ModelTab.Ordenes ? "active" : null)" type="button" @onclick="@(() => activeTab = ModelTab.Ordenes)">@L("Órdenes fabricación", "Ordres fabricació", "Manufacturing orders")</button>
    </div>

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <fieldset disabled="@isReadOnly">
            @if (activeTab == ModelTab.Ficha)
            {
                <div class="legacy-record-grid" style="margin-top: 1rem;">
                    <section class="panel detail-panel">
                        <div class="detail-panel-header">
                            <div>
                                <h2>@L("Ficha principal", "Fitxa principal", "Main record")</h2>
                                <p class="muted">@L("Identidad comercial del model, tejido base, cliente y coste/venta.", "Identitat comercial del model, teixit base, client i cost/venda.", "Commercial identity of the model, base fabric, client and cost/sale.")</p>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(model.Code))
                            {
                                <span class="stock-state-badge ok">@model.Code</span>
                            }
                        </div>

                        <div class="form-grid">
                            <label class="field">
                                <span>@L("Código", "Codi", "Code")</span>
                                <InputText class="text-input" @bind-Value="model.Code" />
                            </label>
                            <label class="field">
                                <span>@L("Serie", "Sèrie", "Series")</span>
                                <InputText class="text-input" @bind-Value="model.Series" />
                            </label>
                            <label class="field">
                                <span>@L("Temporada", "Temporada", "Season")</span>
                                <InputText class="text-input" @bind-Value="model.Season" />
                            </label>
                            <label class="field">
                                <span>@L("Cliente", "Client", "Client")</span>
                                <InputNumber class="text-input" @bind-Value="model.ClientCode" />
                            </label>
                            <label class="field wide">
                                <span>@L("Nombre cliente", "Nom client", "Client name")</span>
                                <InputText class="text-input" @bind-Value="model.ClientName" />
                            </label>
                            <label class="field wide">
                                <span>@L("Descripción", "Descripció", "Description")</span>
                                <InputText class="text-input" @bind-Value="model.Description" />
                            </label>
                            <label class="field">
                                <span>@L("Código model", "Codi model", "Model code")</span>
                                <InputText class="text-input" @bind-Value="model.ModelCode" />
                            </label>
                            <label class="field">
                                <span>@L("Tejido", "Teixit", "Fabric")</span>
                                <InputText class="text-input" @bind-Value="model.FabricCode" />
                            </label>
                            <label class="field wide">
                                <span>@L("Nombre tejido", "Nom teixit", "Fabric name")</span>
                                <InputText class="text-input" @bind-Value="model.FabricDescription" />
                            </label>
                            <label class="field">
                                <span>@L("Proveedor", "Proveïdor", "Supplier")</span>
                                <InputNumber class="text-input" @bind-Value="model.SupplierCode" />
                            </label>
                            <label class="field wide">
                                <span>@L("Nombre proveedor", "Nom proveïdor", "Supplier name")</span>
                                <InputText class="text-input" @bind-Value="model.SupplierName" />
                            </label>
                            <label class="field">
                                <span>@L("Ample", "Ample", "Width")</span>
                                <InputText class="text-input" @bind-Value="model.WidthText" />
                            </label>
                            <label class="field">
                                <span>@L("Rendiment", "Rendiment", "Yield")</span>
                                <InputNumber class="text-input" @bind-Value="model.Yield" />
                            </label>
                            <label class="field">
                                <span>@L("IVA", "IVA", "VAT")</span>
                                <InputText class="text-input" @bind-Value="model.VatCode" />
                            </label>
                            <label class="field">
                                <span>@L("Coste", "Cost", "Cost")</span>
                                <InputNumber class="text-input" @bind-Value="model.CostPrice" />
                            </label>
                            <label class="field">
                                <span>@L("% margen", "% marge", "% margin")</span>
                                <InputNumber class="text-input" @bind-Value="model.MarginPercent" />
                            </label>
                            <label class="field">
                                <span>@L("Venta", "Venda", "Sale")</span>
                                <InputNumber class="text-input" @bind-Value="model.SalePrice" />
                            </label>
                            <label class="field">
                                <span>@L("Venta final", "Venda final", "Final sale")</span>
                                <InputNumber class="text-input" @bind-Value="model.FinalSalePrice" />
                            </label>
                        </div>
                    </section>

                    <section class="panel detail-panel">
                        <div class="detail-panel-header">
                            <div>
                                <h2>@L("Operaciones y talleres", "Operacions i tallers", "Operations and workshops")</h2>
                                <p class="muted">@L("Asignación de tint, acabat, estampación y confección.", "Assignació de tint, acabat, estampació i confecció.", "Assignment of dyeing, finishing, printing, and tailoring.")</p>
                            </div>
                        </div>

                        <div class="form-grid">
                            <label class="field">
                                <span>@L("Tint", "Tint", "Dyeing")</span>
                                <InputNumber class="text-input" @bind-Value="model.DyeingWorkshopCode" />
                            </label>
                            <label class="field wide">
                                <span>@L("Nombre tint", "Nom tint", "Dyeing name")</span>
                                <InputText class="text-input" @bind-Value="model.DyeingWorkshopName" />
                            </label>
                            <label class="field">
                                <span>@L("Acabat", "Acabat", "Finishing")</span>
                                <InputNumber class="text-input" @bind-Value="model.FinishingWorkshopCode" />
                            </label>
                            <label class="field wide">
                                <span>@L("Nombre acabat", "Nom acabat", "Finishing name")</span>
                                <InputText class="text-input" @bind-Value="model.FinishingWorkshopName" />
                            </label>
                            <label class="field">
                                <span>@L("Estampació", "Estampació", "Printing")</span>
                                <InputNumber class="text-input" @bind-Value="model.PrintingWorkshopCode" />
                            </label>
                            <label class="field wide">
                                <span>@L("Nombre estampació", "Nom estampació", "Printing name")</span>
                                <InputText class="text-input" @bind-Value="model.PrintingWorkshopName" />
                            </label>
                            <label class="field">
                                <span>@L("Confecció", "Confecció", "Tailoring")</span>
                                <InputNumber class="text-input" @bind-Value="model.TailoringWorkshopCode" />
                            </label>
                            <label class="field wide">
                                <span>@L("Nombre confecció", "Nom confecció", "Tailoring name")</span>
                                <InputText class="text-input" @bind-Value="model.TailoringWorkshopName" />
                            </label>
                            <label class="field">
                                <span>@L("Fornitura", "Fornitura", "Trim summary")</span>
                                <InputText class="text-input" @bind-Value="model.FornituraSummary" />
                            </label>
                            <label class="field">
                                <span>@L("Manipulación", "Manipulació", "Handling")</span>
                                <InputNumber class="text-input" @bind-Value="model.ManipulationPrice" />
                            </label>
                            <label class="field">
                                <span>@L("Cost estamp 1", "Cost estamp 1", "Print cost 1")</span>
                                <InputText class="text-input" @bind-Value="model.PrintingCode1" />
                            </label>
                            <label class="field">
                                <span>@L("Cost estamp 2", "Cost estamp 2", "Print cost 2")</span>
                                <InputText class="text-input" @bind-Value="model.PrintingCode2" />
                            </label>
                            <label class="field">
                                <span>@L("Unitats estamp 1", "Unitats estamp 1", "Print units 1")</span>
                                <InputNumber class="text-input" @bind-Value="model.PrintingUnits1" />
                            </label>
                            <label class="field">
                                <span>@L("Unitats estamp 2", "Unitats estamp 2", "Print units 2")</span>
                                <InputNumber class="text-input" @bind-Value="model.PrintingUnits2" />
                            </label>
                        </div>
                    </section>
                </div>

                <section class="panel detail-panel" style="margin-top: 1rem;">
                    <div class="detail-panel-header">
                        <div>
                            <h2>@L("Costes secundarios, tallas y notas", "Costos secundaris, talles i notes", "Secondary costs, sizes, and notes")</h2>
                            <p class="muted">@L("Bloque económico complementario y tallas de referencia del model.", "Bloc econòmic complementari i talles de referència del model.", "Additional cost block and reference sizes for the model.")</p>
                        </div>
                    </div>

                    <div class="form-grid">
                        <label class="field">
                            <span>@L("C estamp", "C estamp", "Print ref.")</span>
                            <InputText class="text-input" @bind-Value="model.PrintingCode1" />
                        </label>
                        <label class="field">
                            <span>@L("C estamp 2", "C estamp 2", "Print ref. 2")</span>
                            <InputText class="text-input" @bind-Value="model.PrintingCode2" />
                        </label>
                        <label class="field">
                            <span>@L("N estamp", "N estamp", "Print qty")</span>
                            <InputNumber class="text-input" @bind-Value="model.PrintingUnits1" />
                        </label>
                        <label class="field">
                            <span>@L("N estamp 2", "N estamp 2", "Print qty 2")</span>
                            <InputNumber class="text-input" @bind-Value="model.PrintingUnits2" />
                        </label>
                        <label class="field">
                            <span>@L("Coste confección", "Cost confecció", "Tailoring cost")</span>
                            <InputNumber class="text-input" @bind-Value="model.TailoringPrice" />
                        </label>
                        <label class="field">
                            <span>@L("N planxa", "N planxa", "Plate cost")</span>
                            <InputNumber class="text-input" @bind-Value="model.PlatePrice" />
                        </label>
                        <label class="field">
                            <span>@L("N repas", "N repas", "Review cost")</span>
                            <InputNumber class="text-input" @bind-Value="model.ReviewPrice" />
                        </label>
                        <label class="field">
                            <span>@L("Q trans", "Q trans", "Transfer qty")</span>
                            <InputNumber class="text-input" @bind-Value="model.TransferQuantity" />
                        </label>
                        <label class="field">
                            <span>@L("N trans", "N trans", "Transfer cost")</span>
                            <InputNumber class="text-input" @bind-Value="model.TransferPrice" />
                        </label>
                        <label class="field">
                            <span>@L("Q flocat", "Q flocat", "Flocked qty")</span>
                            <InputNumber class="text-input" @bind-Value="model.FlockedQuantity" />
                        </label>
                        <label class="field">
                            <span>@L("N flocat", "N flocat", "Flocked cost")</span>
                            <InputNumber class="text-input" @bind-Value="model.FlockedPrice" />
                        </label>
                        <label class="field">
                            <span>@L("Q brodat", "Q brodat", "Embroidery qty")</span>
                            <InputNumber class="text-input" @bind-Value="model.EmbroideredQuantity" />
                        </label>
                        <label class="field">
                            <span>@L("N brodat", "N brodat", "Embroidery cost")</span>
                            <InputNumber class="text-input" @bind-Value="model.EmbroideredPrice" />
                        </label>
                        <label class="field">
                            <span>@L("N estamp", "N estamp", "Print cost")</span>
                            <InputNumber class="text-input" @bind-Value="model.PrintingPrice" />
                        </label>
                        <label class="field">
                            <span>@L("N tint p", "N tint p", "Dyeing cost")</span>
                            <InputNumber class="text-input" @bind-Value="model.DyeingPrice" />
                        </label>
                        <label class="field">
                            <span>@L("N acab p", "N acab p", "Finishing cost")</span>
                            <InputNumber class="text-input" @bind-Value="model.FinishingPrice" />
                        </label>
                        <label class="field">
                            <span>@L("Coste fornitura", "Cost fornitura", "Trim cost")</span>
                            <InputNumber class="text-input" @bind-Value="model.FornituraPrice" />
                        </label>
                        <label class="field">
                            <span>@L("Coste pack", "Cost pack", "Packaging cost")</span>
                            <InputNumber class="text-input" @bind-Value="model.PackagingPrice" />
                        </label>
                    </div>

                    <div class="form-grid" style="margin-top: 1rem;">
                        <label class="field"><span>@L("Talla 01", "Talla 01", "Size 01")</span><InputText class="text-input" @bind-Value="model.Size01" /></label>
                        <label class="field"><span>@L("Talla 02", "Talla 02", "Size 02")</span><InputText class="text-input" @bind-Value="model.Size02" /></label>
                        <label class="field"><span>@L("Talla 03", "Talla 03", "Size 03")</span><InputText class="text-input" @bind-Value="model.Size03" /></label>
                        <label class="field"><span>@L("Talla 04", "Talla 04", "Size 04")</span><InputText class="text-input" @bind-Value="model.Size04" /></label>
                        <label class="field"><span>@L("Talla 05", "Talla 05", "Size 05")</span><InputText class="text-input" @bind-Value="model.Size05" /></label>
                        <label class="field"><span>@L("Talla 06", "Talla 06", "Size 06")</span><InputText class="text-input" @bind-Value="model.Size06" /></label>
                        <label class="field"><span>@L("Talla 07", "Talla 07", "Size 07")</span><InputText class="text-input" @bind-Value="model.Size07" /></label>
                        <label class="field"><span>@L("Talla 08", "Talla 08", "Size 08")</span><InputText class="text-input" @bind-Value="model.Size08" /></label>
                        <label class="field"><span>@L("Talla 09", "Talla 09", "Size 09")</span><InputText class="text-input" @bind-Value="model.Size09" /></label>
                        <label class="field"><span>@L("Talla 10", "Talla 10", "Size 10")</span><InputText class="text-input" @bind-Value="model.Size10" /></label>
                    </div>

                    <label class="field field-full" style="margin-top: 1rem;">
                        <span>@L("Observaciones", "Observacions", "Observations")</span>
                        <InputTextArea class="text-input textarea-input" @bind-Value="model.Notes" />
                    </label>
                </section>
            }

            @if (activeTab == ModelTab.Scandallo)
            {
                <section class="panel detail-panel" style="margin-top: 1rem;">
                    <div class="detail-panel-header">
                        <div>
                            <h2>@L("Escandallo del model", "Escandall del model", "Model bill of materials")</h2>
                            <p class="muted">@L("Tejidos, consumos y coste detallado por línea.", "Teixits, consums i cost detallat per línia.", "Fabrics, consumption, and detailed cost per line.")</p>
                        </div>
                        @if (!isReadOnly)
                        {
                            <button class="secondary-button" type="button" @onclick="AddScandalloLine">@L("Añadir línea", "Afegir línia", "Add line")</button>
                        }
                    </div>
                    <div class="table-scroll">
                        <table class="data-table detail-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>@L("Título", "Títol", "Title")</th>
                                    <th>@L("Tejido", "Teixit", "Fabric")</th>
                                    <th>@L("Consum", "Consum", "Consumption")</th>
                                    <th>@L("Precio", "Preu", "Price")</th>
                                    <th>@L("Cost", "Cost", "Cost")</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (model.ScandalloLines.Count == 0)
                                {
                                    <tr><td colspan="7" class="muted">@L("No hay escandallo cargado.", "No hi ha escandall carregat.", "No bill of materials loaded.")</td></tr>
                                }
                                else
                                {
                                    @foreach (var line in model.ScandalloLines.OrderBy(item => item.LineNumber))
                                    {
                                        <tr @key="line.LineNumber">
                                            <td><span class="line-number-badge">#@line.LineNumber</span></td>
                                            <td><InputText class="text-input table-input" @bind-Value="line.Title" /></td>
                                            <td><InputText class="text-input table-input" @bind-Value="line.FabricCode" /></td>
                                            <td><InputNumber class="text-input table-input" @bind-Value="line.Consumption" /></td>
                                            <td><InputNumber class="text-input table-input" @bind-Value="line.UnitPrice" /></td>
                                            <td><InputNumber class="text-input table-input" @bind-Value="line.CostPrice" /></td>
                                            <td>
                                                @if (!isReadOnly)
                                                {
                                                    <button class="secondary-button" type="button" @onclick="() => RemoveScandalloLine(line.LineNumber)">@L("Quitar", "Treure", "Remove")</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }

            @if (activeTab == ModelTab.Colores)
            {
                <section class="panel detail-panel" style="margin-top: 1rem;">
                    <div class="detail-panel-header">
                        <div>
                            <h2>@L("Carta de colores del model", "Carta de colors del model", "Model color card")</h2>
                            <p class="muted">@L("Detalle MODCOL y títulos/color tal como llega del legacy.", "Detall MODCOL i títols/color tal com arriba del legacy.", "MODCOL detail and title/color rows as they arrive from legacy.")</p>
                        </div>
                        @if (!isReadOnly)
                        {
                            <button class="secondary-button" type="button" @onclick="AddColorLine">@L("Añadir línea", "Afegir línia", "Add line")</button>
                        }
                    </div>
                    @if (HasScandalloPieces)
                    {
                        <div class="alert" style="margin-bottom: 1rem;">
                            @L($"El escandallo define {DistinctScandalloTitles.Count} piezas activas. Puedes añadir un color a todas las piezas o completar colores pendientes sin tocar la remota.",
                                $"L'escandall defineix {DistinctScandalloTitles.Count} peces actives. Pots afegir un color a totes les peces o completar colors pendents sense tocar la remota.",
                                $"The bill of materials defines {DistinctScandalloTitles.Count} active pieces. You can add a color to all pieces or complete pending colors without touching the remote source.")
