        }
    }

    private int CountMissingColorPieceRows()
    {
        if (!HasScandalloPieces || !HasColorCodes)
        {
            return 0;
        }

        var missing = 0;
        foreach (var colorCode in DistinctModelColorCodes)
        {
            foreach (var title in DistinctScandalloTitles)
            {
                var exists = model.ColorLines.Any(item =>
                    string.Equals(item.ModelColorCode?.Trim(), colorCode, StringComparison.OrdinalIgnoreCase) &&
                    string.Equals(item.Title?.Trim(), title, StringComparison.OrdinalIgnoreCase));

                if (!exists)
                {
                    missing++;
                }
            }
        }

        return missing;
    }

    private IEnumerable<string> GetDefinedSizes()
    {
        return new[]
        {
            model.Size01,
            model.Size02,
            model.Size03,
            model.Size04,
            model.Size05,
            model.Size06,
            model.Size07,
            model.Size08,
            model.Size09,
            model.Size10
        }
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Select(value => value.Trim());
    }

    private static int NextLineNumber(IEnumerable<int> lineNumbers) => lineNumbers.DefaultIfEmpty(0).Max() + 1;

