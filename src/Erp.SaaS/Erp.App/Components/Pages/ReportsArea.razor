        public IReadOnlyList<MetricCard> BuildMetricCards(AppText text, BusinessStatisticsDto stats, int totalCount, IReadOnlyCollection<OperationalDocumentListItemDto> items) =>
            slug switch
            {
                "sales" =>
                [
                    new(Localize(text, "documentos en rango", "documents en rang", "documents in range"), totalCount.ToString("N0", CultureInfo.CurrentCulture)),
                    new(Localize(text, "pedidos venta", "comandes venda", "sales orders"), stats.SalesOrderCount.ToString("N0", CultureInfo.CurrentCulture)),
                    new(Localize(text, "albaranes", "albarans", "shipments"), stats.SalesShipmentCount.ToString("N0", CultureInfo.CurrentCulture)),
                    new(Localize(text, "facturas", "factures", "invoices"), stats.SalesInvoiceCount.ToString("N0", CultureInfo.CurrentCulture)),
                    new(Localize(text, "pendiente cobro", "pendent cobrament", "outstanding sales"), string.Format(CultureInfo.CurrentCulture, "{0:N2}", stats.SalesOutstandingAmount), true)
                ],
                "purchases" =>
                [
                    new(Localize(text, "documentos en rango", "documents en rang", "documents in range"), totalCount.ToString("N0", CultureInfo.CurrentCulture)),
                    new(Localize(text, "pedidos compra", "comandes compra", "purchase orders"), stats.PurchaseOrderCount.ToString("N0", CultureInfo.CurrentCulture)),
                    new(Localize(text, "recepciones", "recepcions", "receipts"), stats.PurchaseReceiptCount.ToString("N0", CultureInfo.CurrentCulture)),
                    new(Localize(text, "facturas proveedor", "factures proveïdor", "supplier invoices"), stats.PurchaseInvoiceCount.ToString("N0", CultureInfo.CurrentCulture)),
                    new(Localize(text, "pendiente pago", "pendent pagament", "outstanding purchases"), string.Format(CultureInfo.CurrentCulture, "{0:N2}", stats.PurchaseOutstandingAmount), true)
                ],
                "production" =>
                [
                    new(Localize(text, "órdenes en rango", "ordres en rang", "orders in range"), totalCount.ToString("N0", CultureInfo.CurrentCulture)),
                    new(Localize(text, "órdenes vivas", "ordres vives", "live work orders"), stats.LiveFinishOrders.ToString("N0", CultureInfo.CurrentCulture)),
                    new(Localize(text, "estados activos", "estats actius", "active statuses"), stats.FinishStatusBreakdown.Count.ToString("N0", CultureInfo.CurrentCulture)),
                    new(Localize(text, "acabadores visibles", "acabadors visibles", "visible finishers"), stats.TopFinishers.Count.ToString("N0", CultureInfo.CurrentCulture)),
                    new(Localize(text, "volumen en página", "volum en pàgina", "page volume"), string.Format(CultureInfo.CurrentCulture, "{0:N2}", items.Sum(item => item.Amount)), true)
                ],
                "warehouse" =>
                [
                    new(Localize(text, "documentos en rango", "documents en rang", "documents in range"), totalCount.ToString("N0", CultureInfo.CurrentCulture)),
                    new(Localize(text, "posiciones stock", "posicions estoc", "stock positions"), stats.StockPositions.ToString("N0", CultureInfo.CurrentCulture)),
                    new(Localize(text, "movimientos", "moviments", "movements"), stats.StockMovementsInRange.ToString("N0", CultureInfo.CurrentCulture)),
                    new(Localize(text, "inventarios borrador", "inventaris esborrany", "draft counts"), stats.DraftCounts.ToString("N0", CultureInfo.CurrentCulture)),
                    new(Localize(text, "traspasos borrador", "traspassos esborrany", "draft transfers"), stats.DraftTransfers.ToString("N0", CultureInfo.CurrentCulture), true)
                ],
                _ => []
            };

        private static string Localize(AppText text, string spanish, string catalan, string english) =>
            text.CurrentLanguage switch
            {
                AppLanguages.Catalan => catalan,
                AppLanguages.English => english,
                _ => spanish
            };
    }
