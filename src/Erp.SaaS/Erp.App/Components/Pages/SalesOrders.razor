@page "/ventas/pedidos"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ILegacySyncService LegacySyncService
@inject ISalesOrderQueries SalesOrderQueries
@inject AppText T

<PageTitle>@L("Ventas / Pedidos", "Vendes / Comandes", "Sales / Orders")</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("Ventas", "Vendes", "Sales")</p>
        <h1>@L("Pedidos de cliente", "Comandes de client", "Customer orders")</h1>
        <p class="lead">@L("Listado web de pedidos por empresa activa, con líneas y expediciones enlazadas a stock.", "Llistat web de comandes per empresa activa, amb línies i expedicions enllaçades a estoc.", "Web list of orders for the active company, with lines and shipments linked to stock.")</p>
    </div>
    <div class="quick-links">
        @if (canEdit)
        {
            <a class="primary-button link-button" href="/ventas/pedidos/nuevo">@L("Nuevo pedido", "Nova comanda", "New order")</a>
        }
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("Selecciona una empresa activa para trabajar con pedidos de cliente.", "Selecciona una empresa activa per treballar amb comandes de client.", "Select an active company to work with customer orders.")</p>
    </div>
}
else
{
    @if (isLegacySyncActive)
    {
        <div class="alert warning">
            @L("Ventas / Pedidos está en convivencia con legacy para esta empresa. La sync manual refresca solo los pedidos con origen legacy; los nuevos o modificados desde la web quedan como locales.", "Vendes / Comandes està en convivència amb legacy per a aquesta empresa. La sync manual refresca només les comandes amb origen legacy; les noves o modificades des del web queden com a locals.", "Sales / Orders is running in legacy coexistence mode for this company. Manual sync refreshes only legacy-origin orders; new or edited web orders remain local.")
            @if (lastSyncUtc.HasValue)
            {
                <span> @L("Última sync:", "Última sync:", "Last sync:") @lastSyncUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss").</span>
            }
        </div>
    }

    <section class="panel">
        <div class="filter-row">
            <input class="text-input" @bind="filter.Search" placeholder="@L("Buscar por número, cliente o notas", "Buscar per número, client o notes", "Search by number, client or notes")" disabled="@isLoading" />
            <select class="text-input" @bind="filter.Status" disabled="@isLoading">
                <option value="">@L("Todos los estados", "Tots els estats", "All statuses")</option>
                @foreach (var status in SalesOrderStatuses.All)
                {
                    <option value="@status">@FormatStatus(status)</option>
                }
            </select>
            <label class="checkbox-field">
                <input type="checkbox" @bind="filter.IncludeClosed" disabled="@isLoading" />
                <span>@L("Incluir cerrados", "Incloure tancades", "Include closed")</span>
            </label>
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? L("Cargando...", "Carregant...", "Loading...") : L("Buscar", "Buscar", "Search"))</button>
        </div>
        <div class="filter-row results-toolbar" style="margin-top: 0.85rem;">
            <span class="results-summary">
                @(totalCount == 0
                    ? L("Sin resultados", "Sense resultats", "No results")
                    : L($"Mostrando {PageStart}-{PageEnd} de {totalCount} pedidos", $"Mostrant {PageStart}-{PageEnd} de {totalCount} comandes", $"Showing {PageStart}-{PageEnd} of {totalCount} orders"))
            </span>
            <label class="field compact-field">
                <span>@L("Tamaño de página", "Mida de pàgina", "Page size")</span>
                <select class="sidebar-select compact-select" value="@filter.PageSize" @onchange="OnPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)">
        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>@L("Cargando pedidos de cliente...", "Carregant comandes de client...", "Loading customer orders...")</span>
            </div>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <SortableHeader Label="@L("Número", "Número", "Number")" IsActive="@(sortColumn == nameof(SalesOrderListItemDto.OrderNumber))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderListItemDto.OrderNumber), true))" />
                    <SortableHeader Label="@L("Cliente", "Client", "Client")" IsActive="@(sortColumn == nameof(SalesOrderListItemDto.ClientName))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderListItemDto.ClientName)))" />
                    <SortableHeader Label="@L("Fecha", "Data", "Date")" IsActive="@(sortColumn == nameof(SalesOrderListItemDto.DocumentDate))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderListItemDto.DocumentDate), true))" />
                    <SortableHeader Label="@L("Solicitada", "Sol·licitada", "Requested")" IsActive="@(sortColumn == nameof(SalesOrderListItemDto.RequestedDate))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderListItemDto.RequestedDate), true))" />
                    <SortableHeader Label="@L("Estado", "Estat", "Status")" IsActive="@(sortColumn == nameof(SalesOrderListItemDto.Status))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderListItemDto.Status)))" />
                    <SortableHeader Label="@L("Líneas", "Línies", "Lines")" IsActive="@(sortColumn == nameof(SalesOrderListItemDto.LineCount))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderListItemDto.LineCount), true))" />
                    <SortableHeader Label="@L("Total", "Total", "Total")" IsActive="@(sortColumn == nameof(SalesOrderListItemDto.TotalAmount))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderListItemDto.TotalAmount), true))" />
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    @for (var index = 0; index < 5; index++)
                    {
                        <tr class="table-skeleton-row">
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                        </tr>
                    }
                }
                else if (items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="table-empty">
                            @if (HasActiveFilters)
                            {
                                <span>@L("No hay pedidos que encajen con los filtros actuales.", "No hi ha comandes que encaixin amb els filtres actuals.", "No orders match the current filters.")</span>
                            }
                            else
                            {
                                <div class="empty-table-state">
                                    <strong>@L("Todavía no hay pedidos de cliente en este módulo.", "Encara no hi ha comandes de client en aquest mòdul.", "There are no customer orders in this module yet.")</strong>
                                    <span>@L("Los pedidos que ves aquí salen del modelo SaaS. Si esta empresa está en convivencia con legacy, primero debes lanzar la sincronización para traer el histórico.", "Les comandes que veus aquí surten del model SaaS. Si aquesta empresa està en convivència amb legacy, primer has de llançar la sincronització per portar l'històric.", "The orders shown here come from the SaaS model. If this company is in legacy coexistence mode, you must run sync first to bring in the history.")</span>
                                    @if (canEdit)
                                    {
                                        <a class="primary-button link-button" href="/ventas/pedidos/nuevo">@L("Crear primer pedido", "Crear primera comanda", "Create first order")</a>
                                    }
                                </div>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.OrderNumber</td>
                            <td>
                                <div>@GetClientDisplayName(item)</div>
                                @if (ShouldShowClientFallback(item))
                                {
                                    <div class="muted">@(item.ClientName) · Codi @item.ClientCode</div>
                                }
                            </td>
                            <td>@item.DocumentDate.ToString("dd/MM/yyyy")</td>
                            <td>@(item.RequestedDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>
                                <span class="status-pill @GetStatusClass(item.Status)">@FormatStatus(item.Status)</span>
                                @if (string.Equals(item.Origin, SalesOrderOrigins.Legacy, StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="muted">@L("Legacy", "Legacy", "Legacy")</div>
                                }
                            </td>
                            <td>@item.LineCount</td>
                            <td>@item.TotalAmount.ToString("0.00") €</td>
                            <td>
                                <a class="inline-link" href="/ventas/pedidos/editar/@item.OrderNumber">@(canEdit ? L("Abrir", "Obrir", "Open") : L("Ver", "Veure", "View"))</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="pagination-bar">
            <span class="muted">@L($"Página {filter.Page} de {TotalPages}", $"Pàgina {filter.Page} de {TotalPages}", $"Page {filter.Page} of {TotalPages}")</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePageAsync(1)" disabled="@(!CanGoPrevious || isLoading)">@L("Primera", "Primera", "First")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page - 1)" disabled="@(!CanGoPrevious || isLoading)">@L("Anterior", "Anterior", "Previous")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page + 1)" disabled="@(!CanGoNext || isLoading)">@L("Siguiente", "Següent", "Next")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(TotalPages)" disabled="@(!CanGoNext || isLoading)">@L("Última", "Última", "Last")</button>
            </div>
        </div>
    </section>
}

@code {
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    [SupplyParameterFromQuery(Name = "q")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = "closed")]
    public bool? ClosedQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? PageSizeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortQuery { get; set; }

    [SupplyParameterFromQuery(Name = "desc")]
    public bool? DescQuery { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isLoading;
    private SalesOrderFilter filter = new() { Page = 1, PageSize = 25, SortColumn = nameof(SalesOrderListItemDto.OrderNumber), SortDescending = true };
    private IReadOnlyCollection<SalesOrderListItemDto> items = [];
    private IReadOnlyCollection<LegacySyncModuleStatusDto> syncStatuses = [];
    private string errorMessage = string.Empty;
    private bool isLegacySyncActive;
    private DateTime? lastSyncUtc;
    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(filter.Search) || !string.IsNullOrWhiteSpace(filter.Status) || filter.IncludeClosed;
    private string sortColumn = nameof(SalesOrderListItemDto.OrderNumber);
    private bool sortDescending = true;
    private int totalCount;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)filter.PageSize));
    private bool CanGoPrevious => filter.Page > 1;
    private bool CanGoNext => filter.Page < TotalPages;
    private int PageStart => totalCount == 0 ? 0 : ((filter.Page - 1) * filter.PageSize) + 1;
    private int PageEnd => totalCount == 0 ? 0 : Math.Min(filter.Page * filter.PageSize, totalCount);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);

        if (tenantId.HasValue)
        {
            syncStatuses = await LegacySyncService.GetModuleStatusesAsync(tenantId.Value);
            var currentSyncStatus = syncStatuses.FirstOrDefault(status =>
                companyId.HasValue &&
                status.CompanyId == companyId.Value &&
                string.Equals(status.ModuleKey, LegacySyncModuleKeys.SalesOrders, StringComparison.OrdinalIgnoreCase));
            isLegacySyncActive = currentSyncStatus?.HasSuccessfulSync == true;
            lastSyncUtc = currentSyncStatus?.LastCompletedUtc;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        ApplyQueryState();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        errorMessage = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            items = [];
            totalCount = 0;
            return;
        }

        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            filter.SortColumn = sortColumn;
            filter.SortDescending = sortDescending;

            var result = await SalesOrderQueries.SearchAsync(tenantId.Value, companyId.Value, filter);
            items = result.Items;
            totalCount = result.TotalCount;
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            items = [];
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task SearchAsync()
    {
        filter.Page = 1;
        UpdateQueryState();
        return Task.CompletedTask;
    }

    private async Task SetSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(sortColumn, column, StringComparison.Ordinal))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = defaultDescending;
        }

        filter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task ChangePageAsync(int page)
    {
        var nextPage = Math.Clamp(page, 1, TotalPages);
        if (nextPage == filter.Page)
        {
            return;
        }

        filter.Page = nextPage;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return;
        }

        filter.PageSize = pageSize;
        filter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private void ApplyQueryState()
    {
        filter.Search = SearchQuery?.Trim() ?? string.Empty;
        filter.Status = NormalizeStatus(StatusQuery);
        filter.IncludeClosed = ClosedQuery.GetValueOrDefault();
        filter.Page = Math.Max(PageQuery.GetValueOrDefault(1), 1);
        filter.PageSize = PageSizeQuery is 25 or 50 or 100 ? PageSizeQuery.Value : 25;
        sortColumn = NormalizeSortColumn(SortQuery);
        sortDescending = DescQuery ?? true;
        filter.SortColumn = sortColumn;
        filter.SortDescending = sortDescending;
    }

    private void UpdateQueryState()
    {
        var uri = NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(filter.Search) ? null : filter.Search,
            ["status"] = string.IsNullOrWhiteSpace(filter.Status) ? null : filter.Status,
            ["closed"] = filter.IncludeClosed ? true : null,
            ["page"] = filter.Page > 1 ? filter.Page : null,
            ["pageSize"] = filter.PageSize != 25 ? filter.PageSize : null,
            ["sort"] = string.Equals(sortColumn, nameof(SalesOrderListItemDto.OrderNumber), StringComparison.Ordinal) ? null : sortColumn,
            ["desc"] = sortDescending ? null : false
        });

        NavigationManager.NavigateTo(uri, replace: true);
    }

    private static string NormalizeStatus(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var match = SalesOrderStatuses.All.FirstOrDefault(item => string.Equals(item, value, StringComparison.OrdinalIgnoreCase));
        return match ?? string.Empty;
    }

    private static string NormalizeSortColumn(string? sortColumn) => sortColumn switch
    {
        nameof(SalesOrderListItemDto.OrderNumber) => nameof(SalesOrderListItemDto.OrderNumber),
        nameof(SalesOrderListItemDto.ClientName) => nameof(SalesOrderListItemDto.ClientName),
        nameof(SalesOrderListItemDto.DocumentDate) => nameof(SalesOrderListItemDto.DocumentDate),
        nameof(SalesOrderListItemDto.RequestedDate) => nameof(SalesOrderListItemDto.RequestedDate),
        nameof(SalesOrderListItemDto.Status) => nameof(SalesOrderListItemDto.Status),
        nameof(SalesOrderListItemDto.LineCount) => nameof(SalesOrderListItemDto.LineCount),
        nameof(SalesOrderListItemDto.TotalAmount) => nameof(SalesOrderListItemDto.TotalAmount),
        _ => nameof(SalesOrderListItemDto.OrderNumber)
    };

    private string FormatStatus(string status) => status switch
    {
        SalesOrderStatuses.Draft => L("Borrador", "Esborrany", "Draft"),
        SalesOrderStatuses.Confirmed => L("Confirmado", "Confirmada", "Confirmed"),
        SalesOrderStatuses.PartiallyShipped => L("Expedido parcial", "Expedit parcial", "Partially shipped"),
        SalesOrderStatuses.Shipped => L("Expedido total", "Expedit total", "Fully shipped"),
        SalesOrderStatuses.Cancelled => L("Cancelado", "Cancel·lada", "Cancelled"),
        _ => status
    };

    private static string GetStatusClass(string status) => status switch
    {
        SalesOrderStatuses.Draft => "warning",
        SalesOrderStatuses.Confirmed => "success",
        SalesOrderStatuses.PartiallyShipped => "warning",
        SalesOrderStatuses.Shipped => "success",
        SalesOrderStatuses.Cancelled => "danger",
        _ => "warning"
    };

    private static string GetClientDisplayName(SalesOrderListItemDto item)
    {
        if (!LooksLikeClientFallback(item.ClientName))
        {
            return item.ClientName;
        }

        var customerReference = ExtractLegacyCustomerReference(item.Notes);
        return string.IsNullOrWhiteSpace(customerReference) ? item.ClientName : customerReference;
    }

    private static bool ShouldShowClientFallback(SalesOrderListItemDto item) =>
        LooksLikeClientFallback(item.ClientName) &&
        !string.IsNullOrWhiteSpace(ExtractLegacyCustomerReference(item.Notes));

    private static bool LooksLikeClientFallback(string value) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.StartsWith("Cliente ", StringComparison.CurrentCultureIgnoreCase);

    private static string ExtractLegacyCustomerReference(string notes)
    {
        if (string.IsNullOrWhiteSpace(notes))
        {
            return string.Empty;
        }

        using var reader = new StringReader(notes);
        while (reader.ReadLine() is { } rawLine)
        {
            var line = rawLine.Trim();
            if (line.StartsWith("Ref. cliente:", StringComparison.CurrentCultureIgnoreCase))
            {
                return line["Ref. cliente:".Length..].Trim();
            }
        }

        return string.Empty;
    }
}
