@page "/ventas/pedidos"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILegacySyncService LegacySyncService
@inject ISalesOrderQueries SalesOrderQueries

<PageTitle>Ventas / Pedidos</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Ventas</p>
        <h1>Pedidos de cliente</h1>
        <p class="lead">Listado web de pedidos por empresa activa, con líneas y expediciones enlazadas a stock.</p>
    </div>
    <div class="quick-links">
        @if (canEdit && !isLegacySyncActive)
        {
            <a class="primary-button link-button" href="/ventas/pedidos/nuevo">Nuevo pedido</a>
        }
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>Selecciona una empresa activa para trabajar con pedidos de cliente.</p>
    </div>
}
else
{
    @if (isLegacySyncActive)
    {
        <div class="alert warning">
            Ventas / Pedidos está en convivencia con legacy para esta empresa. Los datos se refrescan por sincronización y la web queda en solo lectura.
            @if (lastSyncUtc.HasValue)
            {
                <span> Última sync: @lastSyncUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss").</span>
            }
        </div>
    }

    <section class="panel">
        <div class="filter-row">
            <input class="text-input" @bind="filter.Search" placeholder="Buscar por número, cliente o notas" disabled="@isLoading" />
            <select class="text-input" @bind="filter.Status" disabled="@isLoading">
                <option value="">Todos los estados</option>
                @foreach (var status in SalesOrderStatuses.All)
                {
                    <option value="@status">@FormatStatus(status)</option>
                }
            </select>
            <label class="checkbox-field">
                <input type="checkbox" @bind="filter.IncludeClosed" disabled="@isLoading" />
                <span>Incluir cerrados</span>
            </label>
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? "Cargando..." : "Buscar")</button>
        </div>
        <div class="filter-row results-toolbar" style="margin-top: 0.85rem;">
            <span class="results-summary">
                @(totalCount == 0
                    ? "Sin resultados"
                    : $"Mostrando {PageStart}-{PageEnd} de {totalCount} pedidos")
            </span>
            <label class="field compact-field">
                <span>Tamaño de página</span>
                <select class="sidebar-select compact-select" value="@filter.PageSize" @onchange="OnPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)">
        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>Cargando pedidos de cliente...</span>
            </div>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <SortableHeader Label="Número" IsActive="@(sortColumn == nameof(SalesOrderListItemDto.OrderNumber))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderListItemDto.OrderNumber), true))" />
                    <SortableHeader Label="Cliente" IsActive="@(sortColumn == nameof(SalesOrderListItemDto.ClientName))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderListItemDto.ClientName)))" />
                    <SortableHeader Label="Fecha" IsActive="@(sortColumn == nameof(SalesOrderListItemDto.DocumentDate))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderListItemDto.DocumentDate), true))" />
                    <SortableHeader Label="Solicitada" IsActive="@(sortColumn == nameof(SalesOrderListItemDto.RequestedDate))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderListItemDto.RequestedDate), true))" />
                    <SortableHeader Label="Estado" IsActive="@(sortColumn == nameof(SalesOrderListItemDto.Status))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderListItemDto.Status)))" />
                    <SortableHeader Label="Líneas" IsActive="@(sortColumn == nameof(SalesOrderListItemDto.LineCount))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderListItemDto.LineCount), true))" />
                    <SortableHeader Label="Total" IsActive="@(sortColumn == nameof(SalesOrderListItemDto.TotalAmount))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesOrderListItemDto.TotalAmount), true))" />
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    @for (var index = 0; index < 5; index++)
                    {
                        <tr class="table-skeleton-row">
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                        </tr>
                    }
                }
                else if (items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="table-empty">
                            @if (HasActiveFilters)
                            {
                                <span>No hay pedidos que encajen con los filtros actuales.</span>
                            }
                            else
                            {
                                <div class="empty-table-state">
                                    <strong>Todavía no hay pedidos de cliente en este módulo.</strong>
                                    <span>Los pedidos que ves aquí salen del modelo SaaS. Si esta empresa está en convivencia con legacy, primero debes lanzar la sincronización para traer el histórico.</span>
                                    @if (canEdit && !isLegacySyncActive)
                                    {
                                        <a class="primary-button link-button" href="/ventas/pedidos/nuevo">Crear primer pedido</a>
                                    }
                                </div>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.OrderNumber</td>
                            <td>
                                <div>@GetClientDisplayName(item)</div>
                                @if (ShouldShowClientFallback(item))
                                {
                                    <div class="muted">@(item.ClientName) · Codi @item.ClientCode</div>
                                }
                            </td>
                            <td>@item.DocumentDate.ToString("dd/MM/yyyy")</td>
                            <td>@(item.RequestedDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>
                                <span class="status-pill @GetStatusClass(item.Status)">@FormatStatus(item.Status)</span>
                                @if (string.Equals(item.Origin, SalesOrderOrigins.Legacy, StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="muted">Legacy</div>
                                }
                            </td>
                            <td>@item.LineCount</td>
                            <td>@item.TotalAmount.ToString("0.00") €</td>
                            <td>
                                <a class="inline-link" href="/ventas/pedidos/editar/@item.OrderNumber">@(canEdit ? "Abrir" : "Ver")</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="pagination-bar">
            <span class="muted">Página @filter.Page de @TotalPages</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePageAsync(1)" disabled="@(!CanGoPrevious || isLoading)">Primera</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page - 1)" disabled="@(!CanGoPrevious || isLoading)">Anterior</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page + 1)" disabled="@(!CanGoNext || isLoading)">Siguiente</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(TotalPages)" disabled="@(!CanGoNext || isLoading)">Última</button>
            </div>
        </div>
    </section>
}

@code {
    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isLoading;
    private SalesOrderFilter filter = new() { Page = 1, PageSize = 25, SortColumn = nameof(SalesOrderListItemDto.OrderNumber), SortDescending = true };
    private IReadOnlyCollection<SalesOrderListItemDto> items = [];
    private IReadOnlyCollection<LegacySyncModuleStatusDto> syncStatuses = [];
    private string errorMessage = string.Empty;
    private bool isLegacySyncActive;
    private DateTime? lastSyncUtc;
    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(filter.Search) || !string.IsNullOrWhiteSpace(filter.Status) || filter.IncludeClosed;
    private string sortColumn = nameof(SalesOrderListItemDto.OrderNumber);
    private bool sortDescending = true;
    private int totalCount;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)filter.PageSize));
    private bool CanGoPrevious => filter.Page > 1;
    private bool CanGoNext => filter.Page < TotalPages;
    private int PageStart => totalCount == 0 ? 0 : ((filter.Page - 1) * filter.PageSize) + 1;
    private int PageEnd => totalCount == 0 ? 0 : Math.Min(filter.Page * filter.PageSize, totalCount);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);

        if (tenantId.HasValue)
        {
            syncStatuses = await LegacySyncService.GetModuleStatusesAsync(tenantId.Value);
            var currentSyncStatus = syncStatuses.FirstOrDefault(status =>
                companyId.HasValue &&
                status.CompanyId == companyId.Value &&
                string.Equals(status.ModuleKey, LegacySyncModuleKeys.SalesOrders, StringComparison.OrdinalIgnoreCase));
            isLegacySyncActive = currentSyncStatus?.HasSuccessfulSync == true;
            lastSyncUtc = currentSyncStatus?.LastCompletedUtc;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        errorMessage = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            items = [];
            totalCount = 0;
            return;
        }

        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            filter.SortColumn = sortColumn;
            filter.SortDescending = sortDescending;

            var result = await SalesOrderQueries.SearchAsync(tenantId.Value, companyId.Value, filter);
            items = result.Items;
            totalCount = result.TotalCount;
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            items = [];
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task SearchAsync()
    {
        filter.Page = 1;
        return LoadAsync();
    }

    private async Task SetSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(sortColumn, column, StringComparison.Ordinal))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = defaultDescending;
        }

        filter.Page = 1;
        await LoadAsync();
    }

    private async Task ChangePageAsync(int page)
    {
        var nextPage = Math.Clamp(page, 1, TotalPages);
        if (nextPage == filter.Page)
        {
            return;
        }

        filter.Page = nextPage;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return;
        }

        filter.PageSize = pageSize;
        filter.Page = 1;
        await LoadAsync();
    }

    private static string FormatStatus(string status) => status switch
    {
        SalesOrderStatuses.Draft => "Borrador",
        SalesOrderStatuses.Confirmed => "Confirmado",
        SalesOrderStatuses.PartiallyShipped => "Expedido parcial",
        SalesOrderStatuses.Shipped => "Expedido total",
        SalesOrderStatuses.Cancelled => "Cancelado",
        _ => status
    };

    private static string GetStatusClass(string status) => status switch
    {
        SalesOrderStatuses.Draft => "warning",
        SalesOrderStatuses.Confirmed => "success",
        SalesOrderStatuses.PartiallyShipped => "warning",
        SalesOrderStatuses.Shipped => "success",
        SalesOrderStatuses.Cancelled => "danger",
        _ => "warning"
    };

    private static string GetClientDisplayName(SalesOrderListItemDto item)
    {
        if (!LooksLikeClientFallback(item.ClientName))
        {
            return item.ClientName;
        }

        var customerReference = ExtractLegacyCustomerReference(item.Notes);
        return string.IsNullOrWhiteSpace(customerReference) ? item.ClientName : customerReference;
    }

    private static bool ShouldShowClientFallback(SalesOrderListItemDto item) =>
        LooksLikeClientFallback(item.ClientName) &&
        !string.IsNullOrWhiteSpace(ExtractLegacyCustomerReference(item.Notes));

    private static bool LooksLikeClientFallback(string value) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.StartsWith("Cliente ", StringComparison.CurrentCultureIgnoreCase);

    private static string ExtractLegacyCustomerReference(string notes)
    {
        if (string.IsNullOrWhiteSpace(notes))
        {
            return string.Empty;
        }

        using var reader = new StringReader(notes);
        while (reader.ReadLine() is { } rawLine)
        {
            var line = rawLine.Trim();
            if (line.StartsWith("Ref. cliente:", StringComparison.CurrentCultureIgnoreCase))
            {
                return line["Ref. cliente:".Length..].Trim();
            }
        }

        return string.Empty;
    }
}
