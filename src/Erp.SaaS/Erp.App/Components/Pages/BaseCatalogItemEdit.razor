@page "/base-datos/{CatalogKey}/nuevo"
@page "/base-datos/{CatalogKey}/editar/{Code}"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IBaseCatalogQueries BaseCatalogQueries
@inject IBaseCatalogService BaseCatalogService
@inject NavigationManager NavigationManager
@inject AppText T

<PageTitle>@($"{Definition.Title} · {(string.IsNullOrWhiteSpace(Code) ? L("Nuevo", "Nou", "New") : L("Editar", "Editar", "Edit"))}")</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("Base de datos", "Base de dades", "Master data")</p>
        <h1>@(string.IsNullOrWhiteSpace(Code)
            ? $"{L("Nuevo", "Nou", "New")} {Definition.Title}"
            : $"{L("Editar", "Editar", "Edit")} {Definition.Title}: {Code}")</h1>
        <p class="lead">@Definition.Lead</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="/base-datos/@CatalogKey">@L("Volver al listado", "Tornar al llistat", "Back to list")</a>
    </div>
</div>

@if (!isValidCatalog)
{
    <div class="empty-state"><p>@L("El catálogo solicitado no existe.", "El catàleg sol·licitat no existeix.", "The requested catalog does not exist.")</p></div>
}
else if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state"><p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p></div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
    }

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <fieldset disabled="@isReadOnly">
            <div class="form-grid">
                <label class="field">
                    <span>@Definition.CodeLabel</span>
                    <InputText class="text-input" @bind-Value="model.Code" />
                </label>
                <label class="field">
                    <span>@Definition.NameLabel</span>
                    <InputText class="text-input" @bind-Value="model.Name" />
                </label>
                @if (HasDescription)
                {
                    <label class="field wide">
                        <span>@Definition.DescriptionLabel</span>
                        <InputText class="text-input" @bind-Value="model.Description" />
                    </label>
                }
                @if (HasReference)
                {
                    <label class="field wide">
                        <span>@Definition.ReferenceLabel</span>
                        <InputText class="text-input" @bind-Value="model.Reference" />
                    </label>
                }
                @if (HasSecondaryReference)
                {
                    <label class="field wide">
                        <span>@Definition.SecondaryReferenceLabel</span>
                        <InputText class="text-input" @bind-Value="model.SecondaryReference" />
                    </label>
                }
                @if (HasNumeric)
                {
                    <label class="field">
                        <span>@Definition.NumericLabel</span>
                        <InputNumber class="text-input" @bind-Value="model.NumericValue" />
                    </label>
                }
                @if (HasSecondaryNumeric)
                {
                    <label class="field">
                        <span>@Definition.SecondaryNumericLabel</span>
                        <InputNumber class="text-input" @bind-Value="model.SecondaryNumericValue" />
                    </label>
                }
                <label class="field checkbox-field">
                    <InputCheckbox @bind-Value="model.IsActive" />
                    <span>@L("Activo", "Actiu", "Active")</span>
                </label>
                <label class="field wide">
                    <span>@L("Notas", "Notes", "Notes")</span>
                    <InputTextArea class="text-area" @bind-Value="model.Notes" />
                </label>
            </div>

            <div class="quick-links" style="margin-top: 1rem;">
                @if (canEdit)
                {
                    <button class="primary-button" type="submit">@L("Guardar", "Desar", "Save")</button>
                }
                @if (canEdit && !string.IsNullOrWhiteSpace(Code))
                {
                    <button class="secondary-button danger-button" type="button" @onclick="DeleteAsync">@L("Eliminar", "Eliminar", "Delete")</button>
                }
            </div>
        </fieldset>
    </EditForm>
}

@code {
    [Parameter] public string CatalogKey { get; set; } = string.Empty;
    [Parameter] public string? Code { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isReadOnly;
    private bool isValidCatalog;
    private string statusMessage = string.Empty;
    private bool isError;
    private CatalogDefinition Definition = new("", "Catalog", string.Empty, "Code", string.Empty, string.Empty, string.Empty, string.Empty, string.Empty, string.Empty, false);
    private BaseCatalogDetailDto model = new();

    protected override async Task OnParametersSetAsync()
    {
        Definition = GetDefinition(CatalogKey);
        isValidCatalog = Definition.IsValid;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);
        isReadOnly = !canEdit;

        if (!tenantId.HasValue || !companyId.HasValue || !isValidCatalog)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(Code))
        {
            var detail = await BaseCatalogQueries.GetByCodeAsync(tenantId.Value, companyId.Value, CatalogKey, Code);
            if (detail is null)
            {
                statusMessage = L("No se ha encontrado el registro solicitado.", "No s'ha trobat el registre sol·licitat.", "The requested record was not found.");
                isError = true;
                model = new BaseCatalogDetailDto { CatalogKey = CatalogKey };
                return;
            }

            model = detail;
            return;
        }

        model = new BaseCatalogDetailDto
        {
            CatalogKey = CatalogKey,
            IsActive = true
        };
    }

    private async Task SaveAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || isReadOnly)
        {
            return;
        }

        try
        {
            statusMessage = string.Empty;
            isError = false;

            var code = await BaseCatalogService.SaveAsync(new SaveBaseCatalogItemCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                CatalogKey = CatalogKey,
                OriginalCode = Code,
                Code = model.Code,
                Name = model.Name,
                Description = model.Description,
                Reference = model.Reference,
                SecondaryReference = model.SecondaryReference,
                NumericValue = model.NumericValue,
                SecondaryNumericValue = model.SecondaryNumericValue,
                Notes = model.Notes,
                IsActive = model.IsActive
            });

            if (string.IsNullOrWhiteSpace(Code))
            {
                NavigationManager.NavigateTo($"/base-datos/{CatalogKey}/editar/{Uri.EscapeDataString(code)}", false);
                return;
            }

            statusMessage = L("Registro guardado correctamente.", "Registre desat correctament.", "Record saved successfully.");
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private async Task DeleteAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || string.IsNullOrWhiteSpace(Code) || !canEdit)
        {
            return;
        }

        try
        {
            await BaseCatalogService.DeleteAsync(tenantId.Value, companyId.Value, CatalogKey, Code);
            NavigationManager.NavigateTo($"/base-datos/{CatalogKey}", false);
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private bool HasDescription => !string.IsNullOrWhiteSpace(Definition.DescriptionLabel);
    private bool HasReference => !string.IsNullOrWhiteSpace(Definition.ReferenceLabel);
    private bool HasSecondaryReference => !string.IsNullOrWhiteSpace(Definition.SecondaryReferenceLabel);
    private bool HasNumeric => !string.IsNullOrWhiteSpace(Definition.NumericLabel);
    private bool HasSecondaryNumeric => !string.IsNullOrWhiteSpace(Definition.SecondaryNumericLabel);

    private sealed record CatalogDefinition(
        string Key,
        string Title,
        string Lead,
        string CodeLabel,
        string NameLabel,
        string DescriptionLabel,
        string ReferenceLabel,
        string SecondaryReferenceLabel,
        string NumericLabel,
        string SecondaryNumericLabel,
        bool IsValid = true);

    private CatalogDefinition GetDefinition(string key) => key?.Trim().ToLowerInvariant() switch
    {
        BaseCatalogKeys.BanksCashboxes => new(key, L("Bancos / Cajas", "Bancs / Caixes", "Banks / Cashboxes"), L("Gestión local de bancos, cajas y cuentas operativas.", "Gestió local de bancs, caixes i comptes operatius.", "Local management of banks, cashboxes and operating accounts."), L("Código banco", "Codi banc", "Bank code"), L("Nombre banco", "Nom banc", "Bank name"), L("Núm. cuenta", "Núm. compte", "Account no."), "IBAN", "SWIFT / BIC", string.Empty, string.Empty),
        BaseCatalogKeys.PaymentMethods => new(key, L("Formas de pago", "Formes de pagament", "Payment methods"), L("Métodos y condiciones de pago disponibles en la SaaS local.", "Mètodes i condicions de pagament disponibles a la SaaS local.", "Payment methods and terms available in the local SaaS database."), L("Código forma", "Codi forma", "Method code"), L("Forma pago", "Forma pagament", "Payment method"), L("Descripción operativa", "Descripció operativa", "Operational description"), L("Referencia / tipo", "Referència / tipus", "Reference / type"), string.Empty, L("Días pago", "Dies pagament", "Payment days"), L("Dte. pago %", "Dte. pagament %", "Payment discount %")),
        BaseCatalogKeys.Operations => new(key, L("Operaciones", "Operacions", "Operations"), L("Catálogo de operaciones de trabajo y proceso, como en el legacy.", "Catàleg d'operacions de treball i procés, com al legacy.", "Catalog of work and process operations, like in legacy."), L("Código operación", "Codi operació", "Operation code"), L("Descripción", "Descripció", "Description"), string.Empty, string.Empty, string.Empty, string.Empty, string.Empty),
        BaseCatalogKeys.Machines => new(key, L("Máquinas", "Màquines", "Machines"), L("Maestro de máquinas con código, descripción y precio operativo.", "Mestre de màquines amb codi, descripció i preu operatiu.", "Machine master data with code, description and operating price."), L("Código máquina", "Codi màquina", "Machine code"), L("Descripción", "Descripció", "Description"), string.Empty, string.Empty, string.Empty, L("Precio", "Preu", "Price"), string.Empty),
        BaseCatalogKeys.Seasons => new(key, L("Temporadas", "Temporades", "Seasons"), L("Catálogo simple de temporadas, como en el legacy.", "Catàleg simple de temporades, com al legacy.", "Simple season catalog, like in legacy."), L("Temporada", "Temporada", "Season"), L("Descripción", "Descripció", "Description"), string.Empty, string.Empty, string.Empty, string.Empty, string.Empty),
        BaseCatalogKeys.VatTypes => new(key, L("Tipos de IVA", "Tipus d'IVA", "VAT types"), L("Tipos impositivos para ventas y compras, con IVA y recargo de equivalencia.", "Tipus impositius per a vendes i compres, amb IVA i recàrrec d'equivalència.", "Tax types for sales and purchases, including VAT and surcharge."), L("Código IVA", "Codi IVA", "VAT code"), L("Descripción", "Descripció", "Description"), L("Descripción operativa", "Descripció operativa", "Operational description"), L("Clave fiscal", "Clau fiscal", "Tax key"), string.Empty, "% IVA", "% RE"),
        BaseCatalogKeys.Incoterms => new(key, "Incoterms", L("Condiciones de entrega y responsabilidad comercial, como en el legacy.", "Condicions de lliurament i responsabilitat comercial, com al legacy.", "Delivery terms and commercial responsibility, like in legacy."), L("Nombre", "Nom", "Name"), L("Descripción", "Descripció", "Description"), string.Empty, string.Empty, string.Empty, string.Empty, string.Empty),
        _ => new("", L("Catálogo", "Catàleg", "Catalog"), string.Empty, L("Código", "Codi", "Code"), string.Empty, string.Empty, string.Empty, string.Empty, string.Empty, string.Empty, false)
    };

    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };
}
