@page "/ventas/albaranes/{ShipmentNumber:int}/pdf"
@page "/ventas/albaranes-teixits-mostres/{ShipmentNumber:int}/pdf"
@page "/ventas/albaranes-models/{ShipmentNumber:int}/pdf"
@layout EmptyLayout
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ISalesOrderQueries SalesOrderQueries
@inject AppText T

<PageTitle>@PageTitleText</PageTitle>

<div class="document-shell">
    <div class="document-toolbar no-print">
        <a class="secondary-button link-button" href="@BackToDocumentHref">@BackToDocumentText</a>
        <button class="primary-button" type="button" onclick="window.print()">@L("Imprimir / guardar PDF", "Imprimir / desar PDF", "Print / save PDF")</button>
    </div>

    @if (!tenantId.HasValue || !companyId.HasValue)
    {
        <div class="empty-state document-state">
            <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "No active company selected.")</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger document-state">@errorMessage</div>
    }
    else if (shipment is null)
    {
        <div class="empty-state document-state">
            <p>@L("No se ha encontrado el albarán solicitado.", "No s'ha trobat l'albarà sol·licitat.", "The requested shipment could not be found.")</p>
        </div>
    }
    else
    {
        <section class="document-page">
            <header class="document-header">
                <div>
                    <p class="eyebrow">@DocumentEyebrowText</p>
                    <h1>@shipment.DisplayNumber</h1>
                    <p class="muted">@L("Pedido origen", "Comanda origen", "Source order") @shipment.OrderNumber</p>
                </div>
                <div class="document-header-meta">
                    <div>
                        <span class="muted">@L("Fecha", "Data", "Date")</span>
                        <strong>@shipment.ShipmentDate.ToString("dd/MM/yyyy")</strong>
                    </div>
                    <div>
                        <span class="muted">@L("Centro", "Centre", "Center")</span>
                        <strong>@shipment.CompanyLegacyCenterCode</strong>
                    </div>
                </div>
            </header>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>@L("Empresa expedidora", "Empresa expedidora", "Shipping company")</h2>
                        <p><strong>@shipment.CompanyName</strong></p>
                        <p class="muted">@shipment.TenantName</p>
                        <p class="muted">@L("Centro legacy", "Centre legacy", "Legacy center") @shipment.CompanyLegacyCenterCode</p>
                    </section>
                    <section class="document-box">
                        <h2>@L("Cliente", "Client", "Client")</h2>
                        <p><strong>@shipment.ClientName</strong></p>
                        @if (!string.IsNullOrWhiteSpace(shipment.ClientTaxId))
                        {
                            <p class="muted">@L("NIF", "NIF", "Tax ID") @shipment.ClientTaxId</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(ClientLocation))
                        {
                            <p class="muted">@ClientLocation</p>
                        }
                    </section>
                </div>
            </section>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>@L("Cabecera logística", "Capçalera logística", "Logistics header")</h2>
                        <div class="document-kv-grid">
                            <div>
                                <span class="muted">@L("Almacén", "Magatzem", "Warehouse")</span>
                                <strong>@DisplayValue(shipment.Warehouse)</strong>
                            </div>
                            <div>
                                <span class="muted">@L("Fecha salida", "Data de sortida", "Ship date")</span>
                                <strong>@shipment.ShipmentDate.ToString("dd/MM/yyyy")</strong>
                            </div>
                            <div>
                                <span class="muted">@L("Pedido origen", "Comanda origen", "Source order")</span>
                                <strong>@shipment.OrderNumber</strong>
                            </div>
                        </div>
                    </section>
                    <section class="document-box">
                        <h2>@L("Preparado para facturación", "Preparat per a facturació", "Ready for invoicing")</h2>
                        <div class="document-kv-grid">
                            <div>
                                <span class="muted">@L("Estado", "Estat", "Status")</span>
                                <strong>@FormatInvoiceStatus(shipment.InvoiceStatus)</strong>
                            </div>
                            <div>
                                <span class="muted">@L("Referencia factura", "Referència factura", "Invoice reference")</span>
                                <strong>@(shipment.InvoiceDisplayNumber ?? DisplayValue(shipment.InvoiceReference))</strong>
                            </div>
                            <div>
                                <span class="muted">@L("Listo desde", "Llest des de", "Ready since")</span>
                                <strong>@(shipment.InvoiceReadyUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? L("Sin dato", "Sense dada", "No data"))</strong>
                            </div>
                        </div>
                    </section>
                </div>
            </section>

            <section class="document-section">
                <h2>@L("Detalle de líneas", "Detall de línies", "Line items")</h2>
                <table class="data-table document-table">
                    <thead>
                        <tr>
                            <th>@L("Línea", "Línia", "Line")</th>
                            <th>@L("Descripción", "Descripció", "Description")</th>
                            <th>@L("Cantidad", "Quantitat", "Quantity")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in shipment.Lines)
                        {
                            <tr>
                                <td>@line.LineNumber</td>
                                <td>@line.Description</td>
                                <td>@line.ShippedQuantity.ToUiString("0.###")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>@L("Resumen", "Resum", "Summary")</h2>
                        <div class="document-kv-grid">
                            <div>
                                <span class="muted">@L("Albarán", "Albarà", "Shipment")</span>
                                <strong>@shipment.DisplayNumber</strong>
                            </div>
                            <div>
                                <span class="muted">@L("Fecha", "Data", "Date")</span>
                                <strong>@shipment.ShipmentDate.ToString("dd/MM/yyyy")</strong>
                            </div>
                            <div>
                                <span class="muted">@L("Total expedido", "Total expedit", "Total shipped")</span>
                                <strong>@shipment.TotalShippedQuantity.ToUiString("0.###")</strong>
                            </div>
                        </div>
                    </section>
                    <section class="document-box">
                        <h2>@L("Notas", "Notes", "Notes")</h2>
                        <p>@(string.IsNullOrWhiteSpace(shipment.Notes) ? L("Sin observaciones registradas.", "Sense observacions registrades.", "No remarks recorded.") : shipment.Notes)</p>
                    </section>
                </div>
            </section>
        </section>
    }
</div>

@code {
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    [Parameter]
    public int ShipmentNumber { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private SalesOrderShipmentDto? shipment;
    private string errorMessage = string.Empty;
    private bool IsModelShipmentsRoute =>
        NavigationManager.ToBaseRelativePath(NavigationManager.Uri).StartsWith("ventas/albaranes-models", StringComparison.OrdinalIgnoreCase);

    private bool IsTeixitsMostresShipmentsRoute =>
        NavigationManager.ToBaseRelativePath(NavigationManager.Uri).StartsWith("ventas/albaranes-teixits-mostres", StringComparison.OrdinalIgnoreCase);

    private string PageTitleText => IsModelShipmentsRoute
        ? $"{L("PDF albarán models", "PDF albarà models", "Model shipment PDF")} {ShipmentNumber}"
        : IsTeixitsMostresShipmentsRoute
            ? $"{L("PDF albarán teixits-mostres", "PDF albarà teixits-mostres", "Fabric & sample shipment PDF")} {ShipmentNumber}"
            : $"{L("PDF albarán venta", "PDF albarà de venda", "Sales shipment PDF")} {ShipmentNumber}";

    private string DocumentEyebrowText => IsModelShipmentsRoute
        ? L("Albarán Models", "Albarà Models", "Model shipment")
        : IsTeixitsMostresShipmentsRoute
            ? L("Albarán Teixits-Mostres", "Albarà Teixits-Mostres", "Fabric & sample shipment")
            : L("Albarán de cliente", "Albarà de client", "Customer shipment");

    private string BackToDocumentHref => IsModelShipmentsRoute
        ? $"/ventas/albaranes-models/{ShipmentNumber}"
        : IsTeixitsMostresShipmentsRoute
            ? $"/ventas/albaranes-teixits-mostres/{ShipmentNumber}"
            : $"/ventas/albaranes/{ShipmentNumber}";

    private string BackToDocumentText => IsModelShipmentsRoute
        ? L("Volver al albarán models", "Tornar a l'albarà models", "Back to model shipment")
        : IsTeixitsMostresShipmentsRoute
            ? L("Volver al albarán teixits-mostres", "Tornar a l'albarà teixits-mostres", "Back to fabric & sample shipment")
            : L("Volver al albarán", "Tornar a l'albarà", "Back to shipment");

    private string ClientLocation
    {
        get
        {
            if (shipment is null)
            {
                return string.Empty;
            }

            var parts = new[]
            {
                shipment.ClientAddress,
                $"{shipment.ClientPostalCode} {shipment.ClientCity}".Trim(),
                shipment.ClientProvince,
                shipment.ClientCountry
            }.Where(part => !string.IsNullOrWhiteSpace(part));

            return string.Join(" · ", parts);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        try
        {
            errorMessage = string.Empty;
            shipment = await SalesOrderQueries.GetShipmentByNumberAsync(tenantId.Value, companyId.Value, ShipmentNumber);
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            shipment = null;
        }
    }

    private string DisplayValue(string value) => string.IsNullOrWhiteSpace(value) ? L("Sin dato", "Sense dada", "No data") : value;
    private string FormatInvoiceStatus(string status) => status switch
    {
        "Pending" => L("Pendiente de facturar", "Pendent de facturar", "Pending invoicing"),
        "Drafted" => L("En borrador de factura", "En esborrany de factura", "In invoice draft"),
        "Invoiced" => L("Facturado", "Facturat", "Invoiced"),
        _ => status
    };
}
