@page "/crm/talleres"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITallerQueries TallerQueries
@inject ILegacySyncService LegacySyncService
@inject AppText T

<PageTitle>@L("CRM / Talleres", "CRM / Tallers", "CRM / Workshops")</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">CRM</p>
        <h1>@L("Talleres", "Tallers", "Workshops")</h1>
        <p class="lead">@(isLegacySyncActive
            ? L("Consulta y filtra los talleres de la SaaS local. La importación manual desde legacy refresca solo registros de origen legacy.",
                "Consulta i filtra els tallers de la SaaS local. La importació manual des de legacy refresca només registres d'origen legacy.",
                "Browse and filter workshops in the local SaaS database. Manual legacy import only refreshes legacy-origin records.")
            : L("Consulta y filtra los talleres del centro legacy asociado a la empresa activa.",
                "Consulta i filtra els tallers del centre legacy associat a l'empresa activa.",
                "Browse and filter workshops from the legacy center linked to the active company."))</p>
    </div>
    <div class="quick-links">
        @if (canEdit)
        {
            <a class="primary-button link-button" href="/crm/talleres/nuevo">@L("Nuevo taller", "Nou taller", "New workshop")</a>
        }
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("Selecciona una empresa activa para trabajar con talleres.", "Selecciona una empresa activa per treballar amb tallers.", "Select an active company to work with workshops.")</p>
    </div>
}
else
{
    <section class="panel">
        <div class="filter-row">
            <input class="text-input" @bind="filter.Search" placeholder="@L("Buscar por nombre, NIF, ciudad, email o teléfono", "Buscar per nom, NIF, ciutat, email o telèfon", "Search by name, tax ID, city, email or phone")" />
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? L("Cargando...", "Carregant...", "Loading...") : L("Buscar", "Buscar", "Search"))</button>
        </div>
        <div class="filter-row results-toolbar" style="margin-top: 0.85rem;">
            <span class="results-summary">
                @(totalCount == 0
                    ? L("Sin resultados", "Sense resultats", "No results")
                    : string.Format(L("Mostrando {0}-{1} de {2} talleres", "Mostrant {0}-{1} de {2} tallers", "Showing {0}-{1} of {2} workshops"), PageStart, PageEnd, totalCount))
            </span>
            <label class="field compact-field">
                <span>@L("Tamaño de página", "Mida de pàgina", "Page size")</span>
                <select class="sidebar-select compact-select" value="@filter.PageSize" @onchange="OnPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }

    @if (isLegacySyncActive)
    {
        <div class="alert">
            @L("CRM / Talleres está en convivencia con legacy para esta empresa.", "CRM / Tallers està en convivència amb legacy per a aquesta empresa.", "CRM / Workshops is running in coexistence with legacy for this company.")
            @L("La web guarda cambios solo en la SaaS local y la sync manual refresca únicamente registros de origen legacy.", "La web desa canvis només a la SaaS local i la sync manual refresca únicament registres d'origen legacy.", "The web app saves changes only in the local SaaS database and manual sync only refreshes legacy-origin records.")
            @if (!string.IsNullOrWhiteSpace(syncStatusLabel))
            {
                <span>@syncStatusLabel</span>
            }
        </div>
    }

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)" aria-busy="@isLoading">
        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>@L("Cargando talleres...", "Carregant tallers...", "Loading workshops...")</span>
            </div>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <SortableHeader Label="@L("Código", "Codi", "Code")" IsActive="@(sortColumn == nameof(TallerListItemDto.Code))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(TallerListItemDto.Code), true))" />
                    <SortableHeader Label="@L("Nombre", "Nom", "Name")" IsActive="@(sortColumn == nameof(TallerListItemDto.Name))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(TallerListItemDto.Name)))" />
                    <SortableHeader Label="@L("NIF", "NIF", "Tax ID")" IsActive="@(sortColumn == nameof(TallerListItemDto.TaxId))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(TallerListItemDto.TaxId)))" />
                    <SortableHeader Label="@L("Ciudad", "Ciutat", "City")" IsActive="@(sortColumn == nameof(TallerListItemDto.City))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(TallerListItemDto.City)))" />
                    <SortableHeader Label="Email" IsActive="@(sortColumn == nameof(TallerListItemDto.PrimaryEmail))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(TallerListItemDto.PrimaryEmail)))" />
                    <SortableHeader Label="@L("Teléfono", "Telèfon", "Phone")" IsActive="@(sortColumn == nameof(TallerListItemDto.Phone))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(TallerListItemDto.Phone)))" />
                    <SortableHeader Label="@L("Teléfono 2", "Telèfon 2", "Phone 2")" IsActive="@(sortColumn == nameof(TallerListItemDto.SecondaryPhone))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(TallerListItemDto.SecondaryPhone)))" />
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    @for (var index = 0; index < 5; index++)
                    {
                        <tr class="table-skeleton-row">
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                        </tr>
                    }
                }
                else if (items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="table-empty">@L("No hay talleres para mostrar.", "No hi ha tallers per mostrar.", "There are no workshops to display.")</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.Code</td>
                            <td>@item.Name</td>
                            <td>@item.TaxId</td>
                            <td>@item.City</td>
                            <td>@item.PrimaryEmail</td>
                            <td>@item.Phone</td>
                            <td>@item.SecondaryPhone</td>
                            <td><a class="inline-link" href="/crm/talleres/editar/@item.Code">@(canEdit ? L("Abrir", "Obrir", "Open") : L("Ver", "Veure", "View"))</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="pagination-bar">
            <span class="muted">@string.Format(L("Página {0} de {1}", "Pàgina {0} de {1}", "Page {0} of {1}"), filter.Page, TotalPages)</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePageAsync(1)" disabled="@(!CanGoPrevious || isLoading)">@L("Primera", "Primera", "First")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page - 1)" disabled="@(!CanGoPrevious || isLoading)">@L("Anterior", "Anterior", "Previous")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page + 1)" disabled="@(!CanGoNext || isLoading)">@L("Siguiente", "Següent", "Next")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(TotalPages)" disabled="@(!CanGoNext || isLoading)">@L("Última", "Última", "Last")</button>
            </div>
        </div>
    </section>
}

@code {
    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isLoading;
    private TallerFilter filter = new() { Page = 1, PageSize = 25, SortColumn = nameof(TallerListItemDto.Code), SortDescending = true };
    private IReadOnlyCollection<TallerListItemDto> items = [];
    private string errorMessage = string.Empty;
    private string sortColumn = nameof(TallerListItemDto.Code);
    private bool sortDescending = true;
    private bool isLegacySyncActive;
    private string syncStatusLabel = string.Empty;
    private int totalCount;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)filter.PageSize));
    private bool CanGoPrevious => filter.Page > 1;
    private bool CanGoNext => filter.Page < TotalPages;
    private int PageStart => totalCount == 0 ? 0 : ((filter.Page - 1) * filter.PageSize) + 1;
    private int PageEnd => totalCount == 0 ? 0 : Math.Min(filter.Page * filter.PageSize, totalCount);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();

        await LoadSyncStatusAsync();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);
        await LoadAsync();
    }

    private async Task LoadSyncStatusAsync()
    {
        isLegacySyncActive = false;
        syncStatusLabel = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var status = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
            .FirstOrDefault(item =>
                item.CompanyId == companyId.Value &&
                string.Equals(item.ModuleKey, LegacySyncModuleKeys.CrmWorkshops, StringComparison.OrdinalIgnoreCase));

        if (status is null || !status.HasSuccessfulSync)
        {
            return;
        }

        isLegacySyncActive = true;
        syncStatusLabel = status.LastCompletedUtc.HasValue
            ? $"{L("Última sync", "Última sync", "Last sync")}: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Act: {status.LastUpdated} · Omi: {status.LastSkipped} · Err: {status.LastErrors}"
            : $"{L("Estado", "Estat", "Status")}: {status.LastStatus}";
    }

    private async Task LoadAsync()
    {
        errorMessage = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            items = [];
            totalCount = 0;
            return;
        }

        isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            filter.SortColumn = sortColumn;
            filter.SortDescending = sortDescending;
            var result = await TallerQueries.SearchAsync(tenantId.Value, companyId.Value, filter);
            items = result.Items;
            totalCount = result.TotalCount;
            if (filter.Page > TotalPages)
            {
                filter.Page = TotalPages;
                result = await TallerQueries.SearchAsync(tenantId.Value, companyId.Value, filter);
                items = result.Items;
                totalCount = result.TotalCount;
            }
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            items = [];
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        filter.Page = 1;
        await LoadAsync();
    }

    private async Task ChangePageAsync(int page)
    {
        filter.Page = Math.Clamp(page, 1, TotalPages);
        await LoadAsync();
    }

    private async Task SetSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(sortColumn, column, StringComparison.Ordinal))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = defaultDescending;
        }

        filter.Page = 1;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return;
        }

        filter.PageSize = pageSize;
        filter.Page = 1;
        await LoadAsync();
    }

    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };
}
