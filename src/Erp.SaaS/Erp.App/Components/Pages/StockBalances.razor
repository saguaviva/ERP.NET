@page "/almacen/stock-actual"
@page "/almacen/fils"
@page "/almacen/tejidos"
@page "/almacen/models"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IStockQueries StockQueries
@inject AppText T

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@T["menu.warehouse"]</p>
        <h1>@PageHeadingText</h1>
        <p class="lead">@PageLeadText</p>
    </div>
    <div class="quick-links">
        @if (IsYarnStockRoute)
        {
            <a class="secondary-button link-button" href="/articulos/hilos">@L("Ver maestro de hilos", "Veure mestre de fils", "Open yarn master")</a>
        }
        else if (IsFabricStockRoute)
        {
            <a class="secondary-button link-button" href="/articulos/tejidos">@L("Ver maestro de tejidos", "Veure mestre de teixits", "Open fabrics master")</a>
        }
        else if (IsModelStockRoute)
        {
            <a class="secondary-button link-button" href="/articulos/models">@L("Ver maestro de models", "Veure mestre de models", "Open model master")</a>
        }
        <a class="secondary-button link-button" href="/almacen/inventarios">@L("Ver inventarios", "Veure inventaris", "View counts")</a>
        <a class="secondary-button link-button" href="/almacen/traspasos">@L("Ver traspasos", "Veure traspassos", "View transfers")</a>
        <a class="secondary-button link-button" href="/almacen/ajustes">@L("Nuevo ajuste", "Nou ajust", "New adjustment")</a>
        <a class="secondary-button link-button" href="@MovementsRoute">@MovementsLinkText</a>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@NoCompanyText</p>
    </div>
}
else
{
    <section class="panel">
        <div class="filter-row">
            <input class="text-input" @bind="filter.Search" placeholder="@L("Buscar por artículo, descripción o almacén", "Buscar per article, descripció o magatzem", "Search by item, description or warehouse")" disabled="@isLoading" />
            <input class="text-input" @bind="filter.Warehouse" placeholder="@L("Almacén", "Magatzem", "Warehouse")" disabled="@isLoading" />
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? L("Cargando...", "Carregant...", "Loading...") : L("Buscar", "Buscar", "Search"))</button>
        </div>
        <div class="filter-row results-toolbar" style="margin-top: 0.85rem;">
            <span class="results-summary">
                @ResultsSummaryText
            </span>
            <label class="field compact-field">
                <span>@L("Tamaño de página", "Mida de pàgina", "Page size")</span>
                <select class="sidebar-select compact-select" value="@filter.PageSize" @onchange="OnPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
    </section>

    @if (legacySyncInfo.IsActive)
    {
        <section class="panel" style="margin-top: 1rem;">
            <p class="eyebrow">@L("Sync legacy", "Sync legacy", "Legacy sync")</p>
            <p class="muted">
                @(IsYarnStockRoute
                    ? L("El stock de fils se está leyendo desde la réplica SaaS local sincronizada con TEX.NET y filtrada por el maestro fil. Los ajustes manuales web se aplican encima en local y no modifican el remoto.", "L'estoc de fils s'està llegint des de la rèplica SaaS local sincronitzada amb TEX.NET i filtrada pel mestre fil. Els ajustos manuals web s'apliquen per sobre en local i no modifiquen el remot.", "Yarn stock is being read from the local SaaS replica synchronized with TEX.NET and filtered by the fil master. Manual web adjustments are applied locally on top and do not change the remote source.")
                    : IsFabricStockRoute
                        ? L("El stock de teixits se está leyendo desde la réplica SaaS local sincronizada con TEX.NET y filtrada por el maestro teixits. Los ajustes manuales web se aplican encima en local y no modifican el remoto.", "L'estoc de teixits s'està llegint des de la rèplica SaaS local sincronitzada amb TEX.NET i filtrada pel mestre teixits. Els ajustos manuals web s'apliquen per sobre en local i no modifiquen el remot.", "Fabric stock is being read from the local SaaS replica synchronized with TEX.NET and filtered by the teixits master. Manual web adjustments are applied locally on top and do not change the remote source.")
                    : IsModelStockRoute
                        ? L("El stock de models se está leyendo desde la réplica SaaS local sincronizada con TEX.NET y filtrada por el maestro article_models. Los ajustes manuales web se aplican encima en local y no modifican el remoto.", "L'estoc de models s'està llegint des de la rèplica SaaS local sincronitzada amb TEX.NET i filtrada pel mestre article_models. Els ajustos manuals web s'apliquen per sobre en local i no modifiquen el remot.", "Model stock is being read from the local SaaS replica synchronized with TEX.NET and filtered by the article_models master. Manual web adjustments are applied locally on top and do not change the remote source.")
                    : L("El stock actual se está leyendo desde la réplica SaaS local sincronizada con TEX.NET. Los ajustes manuales web se aplican encima en local y no modifican el remoto.", "L'estoc actual s'està llegint des de la rèplica SaaS local sincronitzada amb TEX.NET. Els ajustos manuals web s'apliquen per sobre en local i no modifiquen el remot.", "Current stock is being read from the local SaaS replica synchronized with TEX.NET. Manual web adjustments are applied locally on top and do not change the remote source."))
                @L("Última sync:", "Última sync:", "Last sync:") @(legacySyncInfo.LastCompletedUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? L("Sin fecha", "Sense data", "No date"))
                · Ins: @legacySyncInfo.LastInserted · Act: @legacySyncInfo.LastUpdated · Omi: @legacySyncInfo.LastSkipped · Err: @legacySyncInfo.LastErrors
            </p>
            <p class="muted">@L("En algunos artículos legacy el campo “Almacén” representa una agrupación técnica del origen, no un almacén físico.", "En alguns articles legacy el camp “Magatzem” representa una agrupació tècnica de l'origen, no un magatzem físic.", "In some legacy items the “Warehouse” field represents a technical source grouping, not a physical warehouse.")</p>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }

    <div class="card-grid purchase-summary-grid">
        <section class="info-card">
            <h2>@totalCount</h2>
            <p class="muted">@PrimaryKpiText</p>
        </section>
        <section class="info-card">
            <h2>@items.Select(item => item.Warehouse).Where(value => !string.IsNullOrWhiteSpace(value)).Distinct(StringComparer.OrdinalIgnoreCase).Count()</h2>
            <p class="muted">@SecondaryKpiText</p>
        </section>
        <section class="info-card accent-card">
            <h2>@items.Sum(item => item.CurrentStock).ToUiString("0.###")</h2>
            <p class="muted">@TertiaryKpiText</p>
        </section>
    </div>

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)">
        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>@LoadingText</span>
            </div>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <SortableHeader Label="@L("Almacén", "Magatzem", "Warehouse")" IsActive="@(sortColumn == nameof(StockBalanceListItemDto.Warehouse))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockBalanceListItemDto.Warehouse)))" />
                    <SortableHeader Label="@L("Artículo", "Article", "Item")" IsActive="@(sortColumn == nameof(StockBalanceListItemDto.ItemCode))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockBalanceListItemDto.ItemCode)))" />
                    <SortableHeader Label="@L("Descripción", "Descripció", "Description")" IsActive="@(sortColumn == nameof(StockBalanceListItemDto.ItemDescription))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockBalanceListItemDto.ItemDescription)))" />
                    <SortableHeader Label="@L("Stock", "Estoc", "Stock")" IsActive="@(sortColumn == nameof(StockBalanceListItemDto.CurrentStock))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockBalanceListItemDto.CurrentStock), true))" />
                    <SortableHeader Label="@L("Movimientos", "Moviments", "Movements")" IsActive="@(sortColumn == nameof(StockBalanceListItemDto.MovementCount))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockBalanceListItemDto.MovementCount), true))" />
                    <SortableHeader Label="@L("Último movimiento", "Últim moviment", "Last movement")" IsActive="@(sortColumn == nameof(StockBalanceListItemDto.LastMovementDate))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockBalanceListItemDto.LastMovementDate), true))" />
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    @for (var index = 0; index < 5; index++)
                    {
                        <tr class="table-skeleton-row">
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                        </tr>
                    }
                }
                else if (items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="table-empty">@EmptyTableText</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@DisplayValue(item.Warehouse)</td>
                            <td>@DisplayValue(item.ItemCode)</td>
                            <td>@item.ItemDescription</td>
                            <td><strong>@item.CurrentStock.ToUiString("0.###") @item.UnitOfMeasure</strong></td>
                            <td>@item.MovementCount</td>
                            <td>@(item.LastMovementDate?.ToString("dd/MM/yyyy") ?? L("Sin dato", "Sense dada", "No data"))</td>
                            <td>
                                <div class="table-actions">
                                    <a class="inline-link" href="@BuildTransferUrl(item)">@L("Traspasar", "Traspassar", "Transfer")</a>
                                    <a class="inline-link" href="@BuildCountUrl(item)">@L("Inventariar", "Inventariar", "Count")</a>
                                    <a class="inline-link" href="@BuildAdjustmentUrl(item)">@L("Ajustar", "Ajustar", "Adjust")</a>
                                    <a class="inline-link" href="@BuildMovementsUrl(item)">@L("Movs.", "Movs.", "Moves")</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="pagination-bar">
            <span class="muted">@L($"Página {filter.Page} de {TotalPages}", $"Pàgina {filter.Page} de {TotalPages}", $"Page {filter.Page} of {TotalPages}")</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePageAsync(1)" disabled="@(!CanGoPrevious || isLoading)">@L("Primera", "Primera", "First")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page - 1)" disabled="@(!CanGoPrevious || isLoading)">@L("Anterior", "Anterior", "Previous")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page + 1)" disabled="@(!CanGoNext || isLoading)">@L("Siguiente", "Següent", "Next")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(TotalPages)" disabled="@(!CanGoNext || isLoading)">@L("Última", "Última", "Last")</button>
            </div>
        </div>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "warehouse")]
    public string? WarehouseQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? PageSizeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortQuery { get; set; }

    [SupplyParameterFromQuery(Name = "desc")]
    public bool? DescQuery { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool isLoading;
    private StockBalanceFilter filter = new() { Page = 1, PageSize = 25, SortColumn = nameof(StockBalanceListItemDto.Warehouse), SortDescending = false };
    private IReadOnlyCollection<StockBalanceListItemDto> items = [];
    private StockLegacySyncInfoDto legacySyncInfo = new();
    private string errorMessage = string.Empty;
    private string sortColumn = nameof(StockBalanceListItemDto.Warehouse);
    private bool sortDescending;
    private int totalCount;
    private bool IsYarnStockRoute => CurrentRelativePath.StartsWith("almacen/fils", StringComparison.OrdinalIgnoreCase);
    private bool IsFabricStockRoute => CurrentRelativePath.StartsWith("almacen/tejidos", StringComparison.OrdinalIgnoreCase);
    private bool IsModelStockRoute => CurrentRelativePath.StartsWith("almacen/models", StringComparison.OrdinalIgnoreCase);
    private string CurrentRelativePath => NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0];
    private string NoCompanyText => IsYarnStockRoute
        ? L("Selecciona una empresa activa para revisar stock de hilos.", "Selecciona una empresa activa per revisar estoc de fils.", "Select an active company to review yarn stock.")
        : IsFabricStockRoute
            ? L("Selecciona una empresa activa para revisar stock de tejidos.", "Selecciona una empresa activa per revisar estoc de teixits.", "Select an active company to review fabric stock.")
        : IsModelStockRoute
            ? L("Selecciona una empresa activa para revisar stock de models.", "Selecciona una empresa activa per revisar estoc de models.", "Select an active company to review model stock.")
            : L("Selecciona una empresa activa para revisar stock.", "Selecciona una empresa activa per revisar estoc.", "Select an active company to review stock.");
    private string ResultsSummaryText => totalCount == 0
        ? L("Sin resultados", "Sense resultats", "No results")
        : IsYarnStockRoute
            ? L($"Mostrando {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} posiciones de stock de hilos", $"Mostrant {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} posicions d'estoc de fils", $"Showing {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} of {totalCount.ToUiString("N0")} yarn stock positions")
            : IsFabricStockRoute
                ? L($"Mostrando {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} posiciones de stock de tejidos", $"Mostrant {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} posicions d'estoc de teixits", $"Showing {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} of {totalCount.ToUiString("N0")} fabric stock positions")
            : IsModelStockRoute
                ? L($"Mostrando {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} posiciones de stock models", $"Mostrant {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} posicions d'estoc models", $"Showing {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} of {totalCount.ToUiString("N0")} model stock positions")
                : L($"Mostrando {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} posiciones de stock", $"Mostrant {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} posicions d'estoc", $"Showing {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} of {totalCount.ToUiString("N0")} stock positions");
    private string PrimaryKpiText => IsYarnStockRoute
        ? L("posiciones de hilo con stock", "posicions de fil amb estoc", "yarn stock positions")
        : IsFabricStockRoute
            ? L("posiciones de tejido con stock", "posicions de teixit amb estoc", "fabric stock positions")
        : IsModelStockRoute
            ? L("posiciones models con stock", "posicions models amb estoc", "model stock positions")
            : L("posiciones con stock", "posicions amb estoc", "positions with stock");
    private string SecondaryKpiText => IsYarnStockRoute
        ? L("almacenes con hilos en página", "magatzems amb fils a la pàgina", "warehouses with yarns on page")
        : IsFabricStockRoute
            ? L("almacenes con tejidos en página", "magatzems amb teixits a la pàgina", "warehouses with fabrics on page")
        : IsModelStockRoute
            ? L("almacenes con models en página", "magatzems amb models a la pàgina", "warehouses with models on page")
            : L("almacenes en página", "magatzems a la pàgina", "warehouses on page");
    private string TertiaryKpiText => IsYarnStockRoute
        ? L("unidades netas de hilo en página", "unitats netes de fil a la pàgina", "net yarn units on page")
        : IsFabricStockRoute
            ? L("unidades netas de tejido en página", "unitats netes de teixit a la pàgina", "net fabric units on page")
        : IsModelStockRoute
            ? L("unidades netas models en página", "unitats netes models a la pàgina", "net model units on page")
            : L("unidades netas en página", "unitats netes a la pàgina", "net units on page");
    private string MovementsRoute => IsYarnStockRoute
        ? "/almacen/fils/movimientos"
        : IsFabricStockRoute
            ? "/almacen/tejidos/movimientos"
        : IsModelStockRoute
            ? "/almacen/models/movimientos"
            : "/almacen/movimientos";
    private string MovementsLinkText => IsYarnStockRoute
        ? L("Ver movimientos de hilos", "Veure moviments de fils", "View yarn movements")
        : IsFabricStockRoute
            ? L("Ver movimientos de tejidos", "Veure moviments de teixits", "View fabric movements")
        : IsModelStockRoute
            ? L("Ver movimientos models", "Veure moviments models", "View model movements")
            : L("Ver movimientos", "Veure moviments", "View movements");
    private string LoadingText => IsYarnStockRoute
        ? L("Cargando stock de hilos...", "Carregant estoc de fils...", "Loading yarn stock...")
        : IsFabricStockRoute
            ? L("Cargando stock de tejidos...", "Carregant estoc de teixits...", "Loading fabric stock...")
        : IsModelStockRoute
            ? L("Cargando stock models...", "Carregant estoc models...", "Loading model stock...")
            : L("Cargando stock actual...", "Carregant estoc actual...", "Loading current stock...");
    private string EmptyTableText => IsYarnStockRoute
        ? L("Todavía no hay stock de hilos calculado para mostrar.", "Encara no hi ha estoc de fils calculat per mostrar.", "There is no calculated yarn stock to display yet.")
        : IsFabricStockRoute
            ? L("Todavía no hay stock de tejidos calculado para mostrar.", "Encara no hi ha estoc de teixits calculat per mostrar.", "There is no calculated fabric stock to display yet.")
        : IsModelStockRoute
            ? L("Todavía no hay stock models calculado para mostrar.", "Encara no hi ha estoc models calculat per mostrar.", "There is no calculated model stock to display yet.")
            : L("Todavía no hay stock calculado para mostrar.", "Encara no hi ha estoc calculat per mostrar.", "There is no calculated stock to display yet.");
    private string PageTitleText => IsYarnStockRoute
        ? L("Almacén / Fils", "Magatzem / Fils", "Warehouse / Yarns")
        : IsFabricStockRoute
            ? L("Almacén / Teixits", "Magatzem / Teixits", "Warehouse / Fabrics")
        : IsModelStockRoute
            ? L("Almacén / Models", "Magatzem / Models", "Warehouse / Models")
            : L("Almacén / Stock actual", "Magatzem / Estoc actual", "Warehouse / Current stock");
    private string PageHeadingText => IsYarnStockRoute
        ? L("Fils", "Fils", "Yarns")
        : IsFabricStockRoute
            ? L("Teixits", "Teixits", "Fabrics")
        : IsModelStockRoute
            ? L("Stock Models", "Estoc Models", "Model stock")
            : L("Stock actual", "Estoc actual", "Current stock");
    private string PageLeadText => IsYarnStockRoute
        ? L("Consulta el stock de hilos por artículo y almacén, limitado al maestro fil y a los movimientos locales o legacy sincronizados.", "Consulta l'estoc de fils per article i magatzem, limitat al mestre fil i als moviments locals o legacy sincronitzats.", "Review yarn stock by item and warehouse, limited to the fil master and to local or synchronized legacy movements.")
        : IsFabricStockRoute
            ? L("Consulta el stock de tejidos por artículo y almacén, limitado al maestro teixits y a los movimientos locales o legacy sincronizados.", "Consulta l'estoc de teixits per article i magatzem, limitat al mestre teixits i als moviments locals o legacy sincronitzats.", "Review fabric stock by item and warehouse, limited to the teixits master and to local or synchronized legacy movements.")
        : IsModelStockRoute
            ? L("Consulta el stock de models por artículo y almacén, limitado al maestro article_models y a los movimientos locales o legacy sincronizados.", "Consulta l'estoc de models per article i magatzem, limitat al mestre article_models i als moviments locals o legacy sincronitzats.", "Review model stock by item and warehouse, limited to the article_models master and to local or synchronized legacy movements.")
            : L("Saldo calculado por artículo y almacén a partir de los movimientos registrados o de la réplica legacy activa.", "Saldo calculat per article i magatzem a partir dels moviments registrats o de la rèplica legacy activa.", "Balance calculated by item and warehouse from recorded movements or the active legacy replica.");
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)filter.PageSize));
    private bool CanGoPrevious => filter.Page > 1;
    private bool CanGoNext => filter.Page < TotalPages;
    private int PageStart => totalCount == 0 ? 0 : ((filter.Page - 1) * filter.PageSize) + 1;
    private int PageEnd => totalCount == 0 ? 0 : Math.Min(filter.Page * filter.PageSize, totalCount);
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
    }

    protected override async Task OnParametersSetAsync()
    {
        ApplyQueryState();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        errorMessage = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            items = [];
            totalCount = 0;
            return;
        }

        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            legacySyncInfo = await StockQueries.GetLegacySyncInfoAsync(tenantId.Value, companyId.Value);
            filter.SortColumn = sortColumn;
            filter.SortDescending = sortDescending;
            var result = await StockQueries.SearchBalancesAsync(tenantId.Value, companyId.Value, filter);
            items = result.Items;
            totalCount = result.TotalCount;
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            items = [];
            legacySyncInfo = new StockLegacySyncInfoDto();
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        filter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task SetSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(sortColumn, column, StringComparison.Ordinal))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = defaultDescending;
        }

        filter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task ChangePageAsync(int page)
    {
        var newPage = Math.Max(1, Math.Min(page, TotalPages));
        if (newPage == filter.Page)
        {
            return;
        }

        filter.Page = newPage;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return;
        }

        filter.PageSize = pageSize;
        filter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private void ApplyQueryState()
    {
        filter.Search = SearchQuery?.Trim() ?? string.Empty;
        filter.Warehouse = WarehouseQuery?.Trim() ?? string.Empty;
        filter.CatalogScope = IsYarnStockRoute
            ? "Hilos"
            : IsFabricStockRoute
                ? "Tejidos"
            : IsModelStockRoute
                ? "Models"
                : string.Empty;
        filter.Page = Math.Max(PageQuery.GetValueOrDefault(1), 1);
        filter.PageSize = PageSizeQuery is 25 or 50 or 100 ? PageSizeQuery.Value : 25;
        sortColumn = NormalizeSortColumn(SortQuery);
        sortDescending = DescQuery.GetValueOrDefault();
        filter.SortColumn = sortColumn;
        filter.SortDescending = sortDescending;
    }

    private void UpdateQueryState()
    {
        var uri = NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["search"] = string.IsNullOrWhiteSpace(filter.Search) ? null : filter.Search,
            ["warehouse"] = string.IsNullOrWhiteSpace(filter.Warehouse) ? null : filter.Warehouse,
            ["page"] = filter.Page > 1 ? filter.Page : null,
            ["pageSize"] = filter.PageSize != 25 ? filter.PageSize : null,
            ["sort"] = string.Equals(sortColumn, nameof(StockBalanceListItemDto.Warehouse), StringComparison.Ordinal) ? null : sortColumn,
            ["desc"] = sortDescending ? true : null
        });

        NavigationManager.NavigateTo(uri, replace: true);
    }

    private static string NormalizeSortColumn(string? sortColumn) => sortColumn switch
    {
        nameof(StockBalanceListItemDto.Warehouse) => nameof(StockBalanceListItemDto.Warehouse),
        nameof(StockBalanceListItemDto.ItemCode) => nameof(StockBalanceListItemDto.ItemCode),
        nameof(StockBalanceListItemDto.ItemDescription) => nameof(StockBalanceListItemDto.ItemDescription),
        nameof(StockBalanceListItemDto.CurrentStock) => nameof(StockBalanceListItemDto.CurrentStock),
        nameof(StockBalanceListItemDto.MovementCount) => nameof(StockBalanceListItemDto.MovementCount),
        nameof(StockBalanceListItemDto.LastMovementDate) => nameof(StockBalanceListItemDto.LastMovementDate),
        _ => nameof(StockBalanceListItemDto.Warehouse)
    };

    private string DisplayValue(string value) => string.IsNullOrWhiteSpace(value) ? L("Sin dato", "Sense dada", "No data") : value;

    private static string BuildAdjustmentUrl(StockBalanceListItemDto item)
    {
        var warehouse = Uri.EscapeDataString(item.Warehouse ?? string.Empty);
        var itemCode = Uri.EscapeDataString(item.ItemCode ?? string.Empty);
        var description = Uri.EscapeDataString(item.ItemDescription ?? string.Empty);
        var unit = Uri.EscapeDataString(item.UnitOfMeasure ?? string.Empty);
        return $"/almacen/ajustes?warehouse={warehouse}&itemCode={itemCode}&description={description}&unit={unit}&currentStock={item.CurrentStock}";
    }

    private static string BuildTransferUrl(StockBalanceListItemDto item)
    {
        var warehouse = Uri.EscapeDataString(item.Warehouse ?? string.Empty);
        var itemCode = Uri.EscapeDataString(item.ItemCode ?? string.Empty);
        var description = Uri.EscapeDataString(item.ItemDescription ?? string.Empty);
        var unit = Uri.EscapeDataString(item.UnitOfMeasure ?? string.Empty);
        return $"/almacen/traspasos/nuevo?fromWarehouse={warehouse}&itemCode={itemCode}&description={description}&unit={unit}&quantity={item.CurrentStock}";
    }

    private static string BuildCountUrl(StockBalanceListItemDto item)
    {
        var warehouse = Uri.EscapeDataString(item.Warehouse ?? string.Empty);
        var itemCode = Uri.EscapeDataString(item.ItemCode ?? string.Empty);
        var description = Uri.EscapeDataString(item.ItemDescription ?? string.Empty);
        return $"/almacen/inventarios/nuevo?warehouse={warehouse}&itemCode={itemCode}&description={description}";
    }

    private string BuildMovementsUrl(StockBalanceListItemDto item)
    {
        var route = IsYarnStockRoute
            ? "/almacen/fils/movimientos"
            : IsFabricStockRoute
                ? "/almacen/tejidos/movimientos"
            : IsModelStockRoute
                ? "/almacen/models/movimientos"
                : "/almacen/movimientos";
        var search = Uri.EscapeDataString(item.ItemCode ?? string.Empty);
        var warehouse = Uri.EscapeDataString(item.Warehouse ?? string.Empty);
        return $"{route}?search={search}&warehouse={warehouse}";
    }
}
