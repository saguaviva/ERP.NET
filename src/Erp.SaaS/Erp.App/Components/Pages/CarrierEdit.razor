@page "/crm/transportistas/nuevo"
@page "/crm/transportistas/editar/{Code:int}"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuditLogService AuditLogService
@inject ILegacySyncService LegacySyncService
@inject ITransportistaQueries TransportistaQueries
@inject ITransportistaService TransportistaService
@inject NavigationManager NavigationManager
@inject AppText T

<PageTitle>@(Code.HasValue ? L("Editar transportista", "Editar transportista", "Edit carrier") : L("Nuevo transportista", "Nou transportista", "New carrier"))</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@T["menu.crm"]</p>
        <h1>@(Code.HasValue ? L($"Editar transportista {Code}", $"Editar transportista {Code}", $"Edit carrier {Code}") : L("Nuevo transportista", "Nou transportista", "New carrier"))</h1>
        <p class="lead">@(isLegacySyncActive
            ? L("Edición sobre la SaaS local. La importación manual desde legacy refresca solo registros marcados como legacy.", "Edició sobre la SaaS local. La importació manual des de legacy refresca només registres marcats com legacy.", "Editing on the local SaaS. Manual legacy import refreshes only records marked as legacy.")
            : L("Alta y edición sobre la tabla trans replicada en la SaaS local, filtrada por la empresa activa.", "Alta i edició sobre la taula trans replicada a la SaaS local, filtrada per l'empresa activa.", "Create and edit records on the trans table replicated into the local SaaS, filtered by the active company."))</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="/crm/transportistas">@L("Volver al listado", "Tornar al llistat", "Back to list")</a>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "No active company is selected.")</p>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
    }

    @if (isLegacySyncActive)
    {
        <div class="alert">
            @L("CRM / Transportistas está en convivencia con legacy para esta empresa. Esta ficha guarda cambios solo en la SaaS local y la sync manual refresca únicamente registros de origen legacy.", "CRM / Transportistes està en convivència amb legacy per a aquesta empresa. Aquesta fitxa desa canvis només a la SaaS local i la sync manual refresca únicament registres d'origen legacy.", "CRM / Carriers is running in legacy coexistence mode for this company. This record saves changes only to the local SaaS and manual sync refreshes legacy-origin records only.")
            @if (!string.IsNullOrWhiteSpace(syncStatusLabel))
            {
                <span>@syncStatusLabel</span>
            }
        </div>
    }

    @if (!canEdit && !Code.HasValue)
    {
        <div class="alert">
            @L("No tienes permisos de edición para crear transportistas nuevos en esta empresa.", "No tens permisos d'edició per crear transportistes nous en aquesta empresa.", "You do not have edit permissions to create new carriers in this company.")
        </div>
    }

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <fieldset disabled="@isReadOnly">
            <div class="form-grid">
                <label class="field">
                    <span>@L("Nombre", "Nom", "Name")</span>
                    <InputText class="text-input" @bind-Value="model.Name" />
                </label>
                <label class="field">
                    <span>@L("NIF", "NIF", "Tax ID")</span>
                    <InputText class="text-input" @bind-Value="model.TaxId" />
                </label>
                <label class="field">
                    <span>@L("Teléfono", "Telèfon", "Phone")</span>
                    <InputText class="text-input" @bind-Value="model.Phone" />
                </label>
                <label class="field">
                    <span>@L("Teléfono 2", "Telèfon 2", "Phone 2")</span>
                    <InputText class="text-input" @bind-Value="model.SecondaryPhone" />
                </label>
                <label class="field">
                    <span>@L("Fax", "Fax", "Fax")</span>
                    <InputText class="text-input" @bind-Value="model.Fax" />
                </label>
                <label class="field">
                    <span>@L("Email", "Email", "Email")</span>
                    <InputText class="text-input" @bind-Value="model.Email" />
                </label>
                <label class="field wide">
                    <span>@L("Dirección", "Adreça", "Address")</span>
                    <InputText class="text-input" @bind-Value="model.Address" />
                </label>
                <label class="field">
                    <span>@L("Código postal", "Codi postal", "Postal code")</span>
                    <InputText class="text-input" @bind-Value="model.PostalCode" />
                </label>
                <label class="field">
                    <span>@L("Ciudad", "Ciutat", "City")</span>
                    <InputText class="text-input" @bind-Value="model.City" />
                </label>
                <label class="field">
                    <span>@L("Provincia", "Província", "Province")</span>
                    <InputText class="text-input" @bind-Value="model.Province" />
                </label>
                <label class="field">
                    <span>@L("País", "País", "Country")</span>
                    <InputText class="text-input" @bind-Value="model.Country" />
                </label>
                <label class="field">
                    <span>@L("Web", "Web", "Website")</span>
                    <InputText class="text-input" @bind-Value="model.Website" />
                </label>
                <label class="field">
                    <span>@L("Formato", "Format", "Format")</span>
                    <InputText class="text-input" @bind-Value="model.Format" />
                </label>
                <label class="field wide">
                    <span>@L("Notas", "Notes", "Notes")</span>
                    <InputTextArea class="text-area" @bind-Value="model.Notes" />
                </label>
            </div>

            <div class="quick-links" style="margin-top: 1rem;">
                @if (canEdit)
                {
                    <button class="primary-button" type="submit">@L("Guardar transportista", "Desar transportista", "Save carrier")</button>
                }
                @if (canEdit && Code.HasValue)
                {
                    <button class="secondary-button danger-button" type="button" @onclick="DeleteAsync">@L("Eliminar transportista", "Eliminar transportista", "Delete carrier")</button>
                }
                @if (Code.HasValue)
                {
                    <button class="secondary-button" type="button" @onclick="LoadAuditAsync">@L("Recargar historial", "Recarregar historial", "Reload history")</button>
                }
            </div>
        </fieldset>
    </EditForm>

    @if (Code.HasValue)
    {
        <section class="panel" style="margin-top: 1rem;">
            <h2>@L("Historial reciente del transportista", "Historial recent del transportista", "Recent carrier history")</h2>
            <div class="list-block">
                @if (recentAuditLogs.Count == 0)
                {
                    <p class="muted">@L("Todavía no hay eventos auditados para este transportista.", "Encara no hi ha esdeveniments auditats per a aquest transportista.", "There are no audited events for this carrier yet.")</p>
                }
                else
                {
                    @foreach (var entry in recentAuditLogs)
                    {
                        <article class="list-item">
                            <strong>@entry.Action</strong>
                            @if (!string.IsNullOrWhiteSpace(entry.Details))
                            {
                                <span>@entry.Details</span>
                            }
                            <span>@entry.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </article>
                    }
                }
            </div>
        </section>
    }
}

@code {
    [Parameter]
    public int? Code { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isReadOnly;
    private TransportistaDetailDto model = new();
    private string statusMessage = string.Empty;
    private bool isError;
    private bool isLegacySyncActive;
    private string syncStatusLabel = string.Empty;
    private IReadOnlyCollection<AuditLogEntryDto> recentAuditLogs = [];

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        await LoadSyncStatusAsync();
        isReadOnly = !canEdit;

        if (Code.HasValue)
        {
            var detail = await TransportistaQueries.GetByCodeAsync(tenantId.Value, companyId.Value, Code.Value);
            if (detail is null)
            {
                statusMessage = L("No se ha encontrado el transportista solicitado.", "No s'ha trobat el transportista sol·licitat.", "The requested carrier was not found.");
                isError = true;
                model = new TransportistaDetailDto();
                recentAuditLogs = [];
                return;
            }

            model = detail;
            await LoadAuditAsync();
        }
        else
        {
            model = new TransportistaDetailDto();
            recentAuditLogs = [];
        }
    }

    private async Task SaveAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        if (isReadOnly)
        {
            statusMessage = L("No tienes permisos de edición en este tenant.", "No tens permisos d'edició en aquest tenant.", "You do not have edit permissions in this tenant.");
            isError = true;
            return;
        }

        try
        {
            statusMessage = string.Empty;
            isError = false;

            var code = await TransportistaService.SaveAsync(new SaveTransportistaCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                Code = Code,
                Name = model.Name,
                TaxId = model.TaxId,
                Address = model.Address,
                PostalCode = model.PostalCode,
                City = model.City,
                Province = model.Province,
                Phone = model.Phone,
                SecondaryPhone = model.SecondaryPhone,
                Fax = model.Fax,
                Email = model.Email,
                Website = model.Website,
                Country = model.Country,
                Format = model.Format,
                Notes = model.Notes
            });

            statusMessage = Code.HasValue
                ? L("Transportista actualizado correctamente.", "Transportista actualitzat correctament.", "Carrier updated successfully.")
                : L("Transportista creado correctamente.", "Transportista creat correctament.", "Carrier created successfully.");

            if (!Code.HasValue)
            {
                NavigationManager.NavigateTo($"/crm/transportistas/editar/{code}", forceLoad: false);
                return;
            }

            await LoadAuditAsync();
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private async Task LoadSyncStatusAsync()
    {
        isLegacySyncActive = false;
        syncStatusLabel = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var status = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
            .FirstOrDefault(item =>
                item.CompanyId == companyId.Value &&
                string.Equals(item.ModuleKey, LegacySyncModuleKeys.CrmCarriers, StringComparison.OrdinalIgnoreCase));

        if (status is null || !status.HasSuccessfulSync)
        {
            return;
        }

        isLegacySyncActive = true;
        syncStatusLabel = status.LastCompletedUtc.HasValue
            ? $"{L("Última sync", "Última sync", "Last sync")}: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Act: {status.LastUpdated} · Omi: {status.LastSkipped} · Err: {status.LastErrors}"
            : $"{L("Estado", "Estat", "Status")}: {status.LastStatus}";
    }

    private async Task LoadAuditAsync()
    {
        if (!tenantId.HasValue || !Code.HasValue)
        {
            recentAuditLogs = [];
            return;
        }

        recentAuditLogs = await AuditLogService.GetRecentAsync(
            limit: 15,
            tenantId: tenantId.Value,
            entityName: "Transportista",
            entityId: Code.Value.ToString());
    }

    private async Task DeleteAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !Code.HasValue)
        {
            return;
        }

        if (!canEdit)
        {
            statusMessage = L("No tienes permisos de edición en este tenant.", "No tens permisos d'edició en aquest tenant.", "You do not have edit permissions in this tenant.");
            isError = true;
            return;
        }

        try
        {
            await TransportistaService.DeleteAsync(tenantId.Value, companyId.Value, Code.Value);
            NavigationManager.NavigateTo("/crm/transportistas", forceLoad: false);
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };
}
