@page "/ventas/facturas/{InvoiceNumber:int}"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISalesOrderQueries SalesOrderQueries
@inject ISalesOrderService SalesOrderService
@inject ILegacySyncService LegacySyncService

<PageTitle>Factura @InvoiceNumber</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Ventas</p>
        <h1>@(invoice?.DisplayNumber ?? $"Factura {InvoiceNumber}")</h1>
        <p class="lead">Factura emitida desde un borrador de pre-facturación y vinculada a sus albaranes de origen.</p>
    </div>
    <div class="quick-links no-print">
        <a class="secondary-button link-button" href="/ventas/facturas">Volver a facturas</a>
        @if (invoice is not null)
        {
            @if (!string.Equals(invoice.Origin, SalesOrderOrigins.Legacy, StringComparison.OrdinalIgnoreCase))
            {
                <a class="secondary-button link-button" href="/ventas/pre-facturacion/borradores/@invoice.DraftNumber">Abrir borrador</a>
            }
            <a class="secondary-button link-button" href="/ventas/facturas/@invoice.InvoiceNumber/pdf" target="_blank">Versión PDF</a>
        }
        <button class="secondary-button" type="button" onclick="window.print()">Imprimir</button>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>No hay empresa activa seleccionada.</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert danger">@errorMessage</div>
}
else if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
}
else if (invoice is null)
{
    <div class="empty-state">
        <p>No se ha encontrado la factura solicitada.</p>
    </div>
}
else
{
    @if (invoiceSyncStatus?.HasSuccessfulSync == true)
    {
        <div class="alert warning">
            Ventas / Facturas está en convivencia con legacy para esta empresa. La sync manual refresca solo las facturas con origen legacy; si registras cobros o haces cambios web, esa factura pasa a tratarse como local.
            @if (invoiceSyncStatus.LastCompletedUtc.HasValue)
            {
                <span>Última sync: @invoiceSyncStatus.LastCompletedUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") · Ins: @invoiceSyncStatus.LastInserted · Act: @invoiceSyncStatus.LastUpdated · Omi: @invoiceSyncStatus.LastSkipped · Err: @invoiceSyncStatus.LastErrors</span>
            }
        </div>
    }

    <section class="panel receipt-document">
        <div class="receipt-document-header">
            <div>
                <p class="eyebrow">Factura de cliente</p>
                <h2>@invoice.DisplayNumber</h2>
                <p class="muted">
                    @(string.Equals(invoice.Origin, SalesOrderOrigins.Legacy, StringComparison.OrdinalIgnoreCase)
                        ? "Factura sincronizada desde legacy"
                        : $"Borrador origen {invoice.DraftDisplayNumber}")
                </p>
            </div>
            <div class="receipt-document-meta">
                <strong>Fecha</strong>
                <span>@invoice.IssueDate.ToString("dd/MM/yyyy")</span>
            </div>
        </div>

        <div class="comparison-grid">
            <section class="info-card">
                <h2>Empresa emisora</h2>
                <p><strong>@invoice.CompanyName</strong></p>
                <p class="muted">@invoice.TenantName</p>
                <p class="muted">Centro legacy @invoice.CompanyLegacyCenterCode</p>
            </section>
            <section class="info-card">
                <h2>Cliente</h2>
                <p><strong>@invoice.ClientName</strong></p>
                @if (!string.IsNullOrWhiteSpace(invoice.ClientTaxId))
                {
                    <p class="muted">NIF @invoice.ClientTaxId</p>
                }
                @if (!string.IsNullOrWhiteSpace(ClientLocation))
                {
                    <p class="muted">@ClientLocation</p>
                }
            </section>
        </div>

        <div class="receipt-detail-grid">
            <section class="info-card">
                <h2>Cabecera de facturación</h2>
                <div class="receipt-kv-grid">
                    <div>
                        <span class="muted">Estado</span>
                        <strong>@FormatInvoiceStatus(invoice.Status)</strong>
                    </div>
                    <div>
                        <span class="muted">Cobro</span>
                        <strong>@FormatPaymentStatus(invoice.PaymentStatus, invoice.IsOverdue)</strong>
                    </div>
                    <div>
                        <span class="muted">Vencimiento</span>
                        <strong>@(invoice.DueDate?.ToString("dd/MM/yyyy") ?? "Sin dato")</strong>
                    </div>
                    <div>
                        <span class="muted">Emitida</span>
                        <strong>@invoice.IssuedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                </div>
            </section>
            <section class="info-card">
                <h2>Resumen económico</h2>
                <div class="receipt-kv-grid">
                    <div>
                        <span class="muted">Base</span>
                        <strong>@invoice.SubtotalAmount.ToString("0.00") €</strong>
                    </div>
                    <div>
                        <span class="muted">IVA</span>
                        <strong>@invoice.TaxAmount.ToString("0.00") €</strong>
                    </div>
                    <div>
                        <span class="muted">Total</span>
                        <strong>@invoice.TotalAmount.ToString("0.00") €</strong>
                    </div>
                    <div>
                        <span class="muted">Cobrado</span>
                        <strong>@invoice.AmountPaid.ToString("0.00") €</strong>
                    </div>
                    <div>
                        <span class="muted">Pendiente</span>
                        <strong>@invoice.OutstandingAmount.ToString("0.00") €</strong>
                    </div>
                </div>
            </section>
        </div>
    </section>

    <section class="panel" style="margin-top: 1rem;">
        <div class="comparison-grid">
            <section class="info-card">
                <h2>Cobros</h2>
                <div class="receipt-kv-grid">
                    <div>
                        <span class="muted">Estado</span>
                        <strong>@FormatPaymentStatus(invoice.PaymentStatus, invoice.IsOverdue)</strong>
                    </div>
                    <div>
                        <span class="muted">Último cobro</span>
                        <strong>@(invoice.LastPaymentUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Sin dato")</strong>
                    </div>
                    <div>
                        <span class="muted">Pendiente</span>
                        <strong>@invoice.OutstandingAmount.ToString("0.00") €</strong>
                    </div>
                </div>
            </section>
            <section class="info-card">
                <h2>Contabilidad</h2>
                <div class="receipt-kv-grid">
                    <div>
                        <span class="muted">Estado</span>
                        <strong>@FormatAccountingStatus(invoice.AccountingStatus)</strong>
                    </div>
                    <div>
                        <span class="muted">Referencia</span>
                        <strong>@DisplayValue(invoice.AccountingReference)</strong>
                    </div>
                    <div>
                        <span class="muted">Preparada desde</span>
                        <strong>@(invoice.AccountingReadyUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Sin dato")</strong>
                    </div>
                </div>
            </section>
        </div>
    </section>

    @if (canEdit && !string.Equals(invoice.Status, SalesInvoiceStatuses.Cancelled, StringComparison.OrdinalIgnoreCase) && invoice.OutstandingAmount > 0)
    {
        <section class="panel" style="margin-top: 1rem;">
            <h2>Registrar cobro</h2>
            <div class="form-grid">
                <label class="field">
                    <span>Fecha cobro</span>
                    <InputDate class="text-input" @bind-Value="paymentForm.PaymentDate" />
                </label>
                <label class="field">
                    <span>Importe</span>
                    <InputNumber class="text-input" @bind-Value="paymentForm.Amount" />
                </label>
                <label class="field">
                    <span>Método</span>
                    <InputText class="text-input" @bind-Value="paymentForm.Method" />
                </label>
                <label class="field">
                    <span>Referencia</span>
                    <InputText class="text-input" @bind-Value="paymentForm.Reference" />
                </label>
                <label class="field wide">
                    <span>Notas</span>
                    <InputTextArea class="text-area" @bind-Value="paymentForm.Notes" />
                </label>
            </div>
            <div class="quick-links">
                <span class="muted">Pendiente actual: @invoice.OutstandingAmount.ToString("0.00") €</span>
                <button class="primary-button" type="button" @onclick="RegisterPaymentAsync" disabled="@isSavingPayment">@(isSavingPayment ? "Guardando..." : "Registrar cobro")</button>
            </div>
        </section>
    }

    <section class="panel" style="margin-top: 1rem;">
        <h2>Historial de cobros</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Cobro</th>
                    <th>Fecha</th>
                    <th>Importe</th>
                    <th>Método</th>
                    <th>Referencia</th>
                    <th>Notas</th>
                </tr>
            </thead>
            <tbody>
                @if (invoice.Payments.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="table-empty">Todavía no hay cobros registrados.</td>
                    </tr>
                }
                else
                {
                    @foreach (var payment in invoice.Payments)
                    {
                        <tr>
                            <td>@payment.PaymentNumber</td>
                            <td>@payment.PaymentDate.ToString("dd/MM/yyyy")</td>
                            <td>@payment.Amount.ToString("0.00") €</td>
                            <td>@DisplayValue(payment.Method)</td>
                            <td>@DisplayValue(payment.Reference)</td>
                            <td>@DisplayValue(payment.Notes)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </section>

    <section class="panel" style="margin-top: 1rem;">
        <h2>Albaranes incluidos</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Albarán</th>
                    <th>Pedido</th>
                    <th>Fecha</th>
                    <th>Almacén</th>
                    <th>Cantidad</th>
                    <th>Importe</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var shipment in invoice.Shipments)
                {
                    <tr>
                        <td>@shipment.DisplayNumber</td>
                        <td>@shipment.OrderNumber</td>
                        <td>@shipment.ShipmentDate.ToString("dd/MM/yyyy")</td>
                        <td>@DisplayValue(shipment.Warehouse)</td>
                        <td>@shipment.TotalShippedQuantity.ToString("0.###")</td>
                        <td>@shipment.EstimatedAmount.ToString("0.00") €</td>
                        <td><a class="inline-link" href="/ventas/albaranes/@shipment.ShipmentNumber">Abrir albarán</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section class="panel" style="margin-top: 1rem;">
        <h2>Líneas de la factura</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Línea</th>
                    <th>Artículo</th>
                    <th>Descripción</th>
                    <th>Cantidad</th>
                    <th>Unidad</th>
                    <th>Precio</th>
                    <th>Base</th>
                    <th>IVA</th>
                    <th>Total</th>
                    <th>Origen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in invoice.Lines)
                {
                    <tr>
                        <td>@line.LineNumber</td>
                        <td>@DisplayValue(line.ItemCode)</td>
                        <td>@line.Description</td>
                        <td>@line.Quantity.ToString("0.###")</td>
                        <td>@DisplayValue(line.UnitOfMeasure)</td>
                        <td>@line.UnitPrice.ToString("0.0000")</td>
                        <td>@line.LineSubtotal.ToString("0.00") €</td>
                        <td>@line.TaxAmount.ToString("0.00") €</td>
                        <td>@line.LineTotal.ToString("0.00") €</td>
                        <td>@DisplayValue(line.SourceSummary)</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    @if (!string.IsNullOrWhiteSpace(invoice.Notes))
    {
        <section class="panel" style="margin-top: 1rem;">
            <h2>Notas</h2>
            <p>@invoice.Notes</p>
        </section>
    }
}

@code {
    [Parameter]
    public int InvoiceNumber { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private SalesInvoiceDto? invoice;
    private string errorMessage = string.Empty;
    private string statusMessage = string.Empty;
    private bool isError;
    private bool canEdit;
    private bool isSavingPayment;
    private PaymentFormModel paymentForm = new();
    private LegacySyncModuleStatusDto? invoiceSyncStatus;

    private string ClientLocation
    {
        get
        {
            if (invoice is null)
            {
                return string.Empty;
            }

            var parts = new[]
            {
                invoice.ClientAddress,
                $"{invoice.ClientPostalCode} {invoice.ClientCity}".Trim(),
                invoice.ClientProvince,
                invoice.ClientCountry
            }.Where(part => !string.IsNullOrWhiteSpace(part));

            return string.Join(" · ", parts);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);
        if (tenantId.HasValue && companyId.HasValue)
        {
            invoiceSyncStatus = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
                .FirstOrDefault(status =>
                    status.CompanyId == companyId.Value &&
                    string.Equals(status.ModuleKey, LegacySyncModuleKeys.SalesInvoices, StringComparison.OrdinalIgnoreCase));
        }

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        try
        {
            errorMessage = string.Empty;
            statusMessage = string.Empty;
            isError = false;
            invoice = await SalesOrderQueries.GetInvoiceByNumberAsync(tenantId.Value, companyId.Value, InvoiceNumber);
            if (invoice is not null)
            {
                paymentForm.Amount = invoice.OutstandingAmount;
            }
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            invoice = null;
        }
    }

    private async Task RegisterPaymentAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || invoice is null)
        {
            return;
        }

        try
        {
            isSavingPayment = true;
            errorMessage = string.Empty;
            statusMessage = string.Empty;
            isError = false;

            await SalesOrderService.RegisterInvoicePaymentAsync(new RegisterSalesInvoicePaymentCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                InvoiceNumber = invoice.InvoiceNumber,
                PaymentDate = paymentForm.PaymentDate,
                Amount = paymentForm.Amount,
                Method = paymentForm.Method,
                Reference = paymentForm.Reference,
                Notes = paymentForm.Notes
            });

            statusMessage = "Cobro registrado correctamente.";
            paymentForm = new PaymentFormModel();
            invoice = await SalesOrderQueries.GetInvoiceByNumberAsync(tenantId.Value, companyId.Value, InvoiceNumber);
            if (invoice is not null)
            {
                paymentForm.Amount = invoice.OutstandingAmount;
            }
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
        finally
        {
            isSavingPayment = false;
        }
    }

    private static string DisplayValue(string value) => string.IsNullOrWhiteSpace(value) ? "Sin dato" : value;

    private static string FormatInvoiceStatus(string status) => status switch
    {
        SalesInvoiceStatuses.Issued => "Emitida",
        SalesInvoiceStatuses.Cancelled => "Anulada",
        _ => status
    };

    private static string FormatPaymentStatus(string status, bool isOverdue) => status switch
    {
        SalesInvoicePaymentStatuses.Pending when isOverdue => "Pendiente vencida",
        SalesInvoicePaymentStatuses.Pending => "Pendiente",
        SalesInvoicePaymentStatuses.PartiallyPaid when isOverdue => "Parcial vencida",
        SalesInvoicePaymentStatuses.PartiallyPaid => "Cobro parcial",
        SalesInvoicePaymentStatuses.Paid => "Cobrada",
        _ => status
    };

    private static string FormatAccountingStatus(string status) => status switch
    {
        SalesInvoiceAccountingStatuses.Pending => "Pendiente",
        SalesInvoiceAccountingStatuses.Ready => "Preparada",
        SalesInvoiceAccountingStatuses.Exported => "Exportada",
        _ => status
    };

    private sealed class PaymentFormModel
    {
        public DateTime PaymentDate { get; set; } = DateTime.Today;
        public decimal Amount { get; set; }
        public string Method { get; set; } = string.Empty;
        public string Reference { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
    }
}
