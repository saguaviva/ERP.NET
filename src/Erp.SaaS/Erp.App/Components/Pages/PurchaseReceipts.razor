@page "/compras/recepciones"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ILegacySyncService LegacySyncService
@inject IPurchaseOrderQueries PurchaseOrderQueries
@inject AppText T

<PageTitle>@L("Compras / Recepciones", "Compres / Recepcions", "Purchases / Receipts")</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("Compras", "Compres", "Purchases")</p>
        <h1>@L("Recepciones", "Recepcions", "Receipts")</h1>
        <p class="lead">@(isLegacySyncActive
            ? L("Consulta y filtra las recepciones replicadas en la SaaS local. La sync manual refresca solo las recepciones con origen legacy.", "Consulta i filtra les recepcions replicades a la SaaS local. La sync manual refresca només les recepcions amb origen legacy.", "Browse and filter receipts replicated into the local SaaS. Manual sync only refreshes legacy-origin receipts.")
            : L("Listado de entradas de mercancía registradas para la empresa activa.", "Llistat d'entrades de mercaderia registrades per a l'empresa activa.", "List of goods receipts recorded for the active company."))</p>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("Selecciona una empresa activa para revisar recepciones.", "Selecciona una empresa activa per revisar recepcions.", "Select an active company to review receipts.")</p>
    </div>
}
else
{
    <section class="panel">
        <div class="filter-row">
            <input class="text-input" @bind="filter.Search" placeholder="@L("Buscar por entrada, pedido, proveedor o notas", "Buscar per entrada, comanda, proveïdor o notes", "Search by receipt, order, supplier or notes")" disabled="@isLoading" />
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? L("Cargando...", "Carregant...", "Loading...") : L("Buscar", "Buscar", "Search"))</button>
        </div>
        <div class="filter-row results-toolbar" style="margin-top: 0.85rem;">
            <span class="results-summary">
                @(totalCount == 0
                    ? L("Sin resultados", "Sense resultats", "No results")
                    : L($"Mostrando {PageStart}-{PageEnd} de {totalCount} recepciones", $"Mostrant {PageStart}-{PageEnd} de {totalCount} recepcions", $"Showing {PageStart}-{PageEnd} of {totalCount} receipts"))
            </span>
            <label class="field compact-field">
                <span>@L("Tamaño de página", "Mida de pàgina", "Page size")</span>
                <select class="sidebar-select compact-select" value="@filter.PageSize" @onchange="OnPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }

    @if (isLegacySyncActive)
    {
        <div class="alert">
            @L("Compras / Recepciones está en convivencia con legacy para esta empresa. La sync manual refresca solo las recepciones con origen legacy; cualquier nueva recepción web queda ya como local.", "Compres / Recepcions està en convivència amb legacy per a aquesta empresa. La sync manual refresca només les recepcions amb origen legacy; qualsevol nova recepció web queda ja com a local.", "Purchases / Receipts is running in legacy coexistence mode for this company. Manual sync refreshes only legacy-origin receipts; any new web receipt is already local.")
            @if (!string.IsNullOrWhiteSpace(syncStatusLabel))
            {
                <span>@syncStatusLabel</span>
            }
        </div>
    }

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)">
        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>@L("Cargando recepciones...", "Carregant recepcions...", "Loading receipts...")</span>
            </div>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <SortableHeader Label="@L("Entrada", "Entrada", "Receipt")" IsActive="@(sortColumn == nameof(PurchaseReceiptListItemDto.ReceiptNumber))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseReceiptListItemDto.ReceiptNumber), true))" />
                    <SortableHeader Label="@L("Pedido", "Comanda", "Order")" IsActive="@(sortColumn == nameof(PurchaseReceiptListItemDto.OrderNumber))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseReceiptListItemDto.OrderNumber), true))" />
                    <SortableHeader Label="@L("Proveedor", "Proveïdor", "Supplier")" IsActive="@(sortColumn == nameof(PurchaseReceiptListItemDto.SupplierName))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseReceiptListItemDto.SupplierName)))" />
                    <SortableHeader Label="@L("Fecha", "Data", "Date")" IsActive="@(sortColumn == nameof(PurchaseReceiptListItemDto.ReceiptDate))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseReceiptListItemDto.ReceiptDate), true))" />
                    <SortableHeader Label="@L("Líneas", "Línies", "Lines")" IsActive="@(sortColumn == nameof(PurchaseReceiptListItemDto.LineCount))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseReceiptListItemDto.LineCount), true))" />
                    <SortableHeader Label="@L("Cantidad", "Quantitat", "Quantity")" IsActive="@(sortColumn == nameof(PurchaseReceiptListItemDto.TotalReceivedQuantity))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseReceiptListItemDto.TotalReceivedQuantity), true))" />
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    @for (var index = 0; index < 5; index++)
                    {
                        <tr class="table-skeleton-row">
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                        </tr>
                    }
                }
                else if (items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="table-empty">@L("No hay recepciones para mostrar.", "No hi ha recepcions per mostrar.", "There are no receipts to show.")</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.DisplayNumber</td>
                            <td>@item.OrderNumber</td>
                            <td>@item.SupplierName</td>
                            <td>@item.ReceiptDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.LineCount</td>
                            <td>@item.TotalReceivedQuantity.ToString("0.###")</td>
                            <td>
                                <div class="table-actions">
                                    <a class="inline-link" href="/compras/recepciones/@item.ReceiptNumber">@L("Ver documento", "Veure document", "View document")</a>
                                    @if (canEdit)
                                    {
                                        <a class="inline-link" href="/compras/facturas/nueva?receiptNumber=@item.ReceiptNumber">@L("Crear factura", "Crear factura", "Create invoice")</a>
                                    }
                                    <a class="inline-link" href="/compras/recepciones/@item.ReceiptNumber/pdf" target="_blank">PDF</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="pagination-bar">
            <span class="muted">@L($"Página {filter.Page} de {TotalPages}", $"Pàgina {filter.Page} de {TotalPages}", $"Page {filter.Page} of {TotalPages}")</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePageAsync(1)" disabled="@(!CanGoPrevious || isLoading)">@L("Primera", "Primera", "First")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page - 1)" disabled="@(!CanGoPrevious || isLoading)">@L("Anterior", "Anterior", "Previous")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page + 1)" disabled="@(!CanGoNext || isLoading)">@L("Siguiente", "Següent", "Next")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(TotalPages)" disabled="@(!CanGoNext || isLoading)">@L("Última", "Última", "Last")</button>
            </div>
        </div>
    </section>
}

@code {
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    [SupplyParameterFromQuery(Name = "q")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? PageSizeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortQuery { get; set; }

    [SupplyParameterFromQuery(Name = "desc")]
    public bool? DescQuery { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isLoading;
    private PurchaseReceiptFilter filter = new() { Page = 1, PageSize = 25, SortColumn = nameof(PurchaseReceiptListItemDto.ReceiptNumber), SortDescending = true };
    private IReadOnlyCollection<PurchaseReceiptListItemDto> items = [];
    private string errorMessage = string.Empty;
    private string sortColumn = nameof(PurchaseReceiptListItemDto.ReceiptNumber);
    private bool sortDescending = true;
    private bool isLegacySyncActive;
    private string syncStatusLabel = string.Empty;
    private int totalCount;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)filter.PageSize));
    private bool CanGoPrevious => filter.Page > 1;
    private bool CanGoNext => filter.Page < TotalPages;
    private int PageStart => totalCount == 0 ? 0 : ((filter.Page - 1) * filter.PageSize) + 1;
    private int PageEnd => totalCount == 0 ? 0 : Math.Min(filter.Page * filter.PageSize, totalCount);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);
        await LoadSyncStatusAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        ApplyQueryState();
        await LoadAsync();
    }

    private async Task LoadSyncStatusAsync()
    {
        isLegacySyncActive = false;
        syncStatusLabel = string.Empty;

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var status = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
            .FirstOrDefault(item =>
                item.CompanyId == companyId.Value &&
                string.Equals(item.ModuleKey, LegacySyncModuleKeys.PurchaseReceipts, StringComparison.OrdinalIgnoreCase));

        if (status is null || !status.HasSuccessfulSync)
        {
            return;
        }

        isLegacySyncActive = true;
        syncStatusLabel = status.LastCompletedUtc.HasValue
            ? $"{L("Última sync:", "Última sync:", "Last sync:")} {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Act: {status.LastUpdated} · Omi: {status.LastSkipped} · Err: {status.LastErrors}"
            : $"{L("Estado:", "Estat:", "Status:")} {status.LastStatus}";
    }

    private async Task LoadAsync()
    {
        errorMessage = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            items = [];
            totalCount = 0;
            return;
        }

        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            filter.SortColumn = sortColumn;
            filter.SortDescending = sortDescending;
            var result = await PurchaseOrderQueries.SearchReceiptsAsync(tenantId.Value, companyId.Value, filter);
            items = result.Items;
            totalCount = result.TotalCount;
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            items = [];
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        filter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task SetSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(sortColumn, column, StringComparison.Ordinal))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = defaultDescending;
        }

        filter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task ChangePageAsync(int page)
    {
        var newPage = Math.Max(1, Math.Min(page, TotalPages));
        if (newPage == filter.Page)
        {
            return;
        }

        filter.Page = newPage;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return;
        }

        filter.PageSize = pageSize;
        filter.Page = 1;
        UpdateQueryState();
        await Task.CompletedTask;
    }

    private void ApplyQueryState()
    {
        filter.Search = SearchQuery?.Trim() ?? string.Empty;
        filter.Page = Math.Max(PageQuery.GetValueOrDefault(1), 1);
        filter.PageSize = PageSizeQuery is 25 or 50 or 100 ? PageSizeQuery.Value : 25;
        sortColumn = NormalizeSortColumn(SortQuery);
        sortDescending = DescQuery ?? true;
        filter.SortColumn = sortColumn;
        filter.SortDescending = sortDescending;
    }

    private void UpdateQueryState()
    {
        var uri = NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(filter.Search) ? null : filter.Search,
            ["page"] = filter.Page > 1 ? filter.Page : null,
            ["pageSize"] = filter.PageSize != 25 ? filter.PageSize : null,
            ["sort"] = string.Equals(sortColumn, nameof(PurchaseReceiptListItemDto.ReceiptNumber), StringComparison.Ordinal) ? null : sortColumn,
            ["desc"] = sortDescending ? null : false
        });

        NavigationManager.NavigateTo(uri, replace: true);
    }

    private static string NormalizeSortColumn(string? sortColumn) => sortColumn switch
    {
        nameof(PurchaseReceiptListItemDto.ReceiptNumber) => nameof(PurchaseReceiptListItemDto.ReceiptNumber),
        nameof(PurchaseReceiptListItemDto.OrderNumber) => nameof(PurchaseReceiptListItemDto.OrderNumber),
        nameof(PurchaseReceiptListItemDto.SupplierName) => nameof(PurchaseReceiptListItemDto.SupplierName),
        nameof(PurchaseReceiptListItemDto.ReceiptDate) => nameof(PurchaseReceiptListItemDto.ReceiptDate),
        nameof(PurchaseReceiptListItemDto.LineCount) => nameof(PurchaseReceiptListItemDto.LineCount),
        nameof(PurchaseReceiptListItemDto.TotalReceivedQuantity) => nameof(PurchaseReceiptListItemDto.TotalReceivedQuantity),
        _ => nameof(PurchaseReceiptListItemDto.ReceiptNumber)
    };
}
