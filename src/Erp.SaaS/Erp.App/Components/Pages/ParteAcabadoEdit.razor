    private async Task TryApplyDispositionBaseAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || OrderNumber.HasValue || !DispositionCodeFromQuery.HasValue || !string.IsNullOrWhiteSpace(SampleCodeFromQuery) || !string.IsNullOrWhiteSpace(ModelIdFromQuery))
        {
            return;
        }

        if (appliedDispositionCode == DispositionCodeFromQuery.Value)
        {
            return;
        }

        var disposition = await DisposicionQueries.GetByCodeAsync(tenantId.Value, companyId.Value, DispositionCodeFromQuery.Value);
        if (disposition is null)
        {
            statusMessage = L("No se ha encontrado la disposición usada como base para el parte de acabado.", "No s'ha trobat la disposició usada com a base per al part d'acabat.", "The disposition used as the base for the finish order could not be found.");
            isError = true;
            return;
        }

        model = BuildFromDisposition(disposition);
        await InferMachineFromLinesAsync();
        appliedDispositionCode = DispositionCodeFromQuery.Value;
        statusMessage = L($"Parte precargado desde la disposición {FormatDispositionLabel(disposition)}.", $"Part precarregat des de la disposició {FormatDispositionLabel(disposition)}.", $"Order preloaded from disposition {FormatDispositionLabel(disposition)}.");
        isError = false;
    }

    private async Task TryApplySampleBaseAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || OrderNumber.HasValue || string.IsNullOrWhiteSpace(SampleCodeFromQuery))
        {
            return;
        }

        var sampleCode = SampleCodeFromQuery.Trim();
        var sampleLine = SampleLineFromQuery.GetValueOrDefault();
        var sampleKind = ParteAcabadoSourceKinds.Normalize(SampleKindFromQuery, hasLinkedSource: true);
        if (string.Equals(appliedSampleCode, sampleCode, StringComparison.OrdinalIgnoreCase) &&
            appliedSampleLineNumber == sampleLine &&
            string.Equals(appliedSampleKind, sampleKind, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var sample = await MuestraQueries.GetByCodeAsync(tenantId.Value, companyId.Value, sampleCode);
        if (sample is null)
        {
            statusMessage = L("No se ha encontrado la muestra usada como base para el parte de acabado.", "No s'ha trobat la mostra usada com a base per al part d'acabat.", "The sample used as the base for the finish order could not be found.");
            isError = true;
            return;
        }

        model = BuildFromSample(sample, sampleLine > 0 ? sampleLine : null, sampleKind);
        appliedSampleCode = sampleCode;
        appliedSampleLineNumber = sampleLine > 0 ? sampleLine : null;
        appliedSampleKind = sampleKind;
        var sourceKindLabel = GetSourceKindLabel(sampleKind).ToLowerInvariant();
        statusMessage = sampleLine > 0
            ? L($"Parte precargado desde {sourceKindLabel} {sample.Code}, línea {sampleLine}.", $"Part precarregat des de {sourceKindLabel} {sample.Code}, línia {sampleLine}.", $"Order preloaded from {sourceKindLabel} {sample.Code}, line {sampleLine}.")
            : L($"Parte precargado desde {sourceKindLabel} {sample.Code}.", $"Part precarregat des de {sourceKindLabel} {sample.Code}.", $"Order preloaded from {sourceKindLabel} {sample.Code}.");
        isError = false;
    }

    private async Task TryApplyModelBaseAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || OrderNumber.HasValue || string.IsNullOrWhiteSpace(ModelIdFromQuery))
        {
            return;
        }

        var modelIdText = ModelIdFromQuery.Trim();
        if (string.Equals(appliedModelId, modelIdText, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (!Guid.TryParse(modelIdText, out var modelId))
        {
            statusMessage = L("El identificador del model usado como base no es válido.", "L'identificador del model usat com a base no és vàlid.", "The model identifier used as the base is not valid.");
            isError = true;
            return;
        }

        var sourceModel = await ModeloQueries.GetByIdAsync(tenantId.Value, companyId.Value, modelId);
        if (sourceModel is null)
        {
            statusMessage = L("No se ha encontrado el model usado como base para la orden de fabricación.", "No s'ha trobat el model usat com a base per a l'ordre de fabricació.", "The model used as the base for the manufacturing order could not be found.");
            isError = true;
            return;
        }

        model = BuildFromModel(sourceModel);
        await InferMachineFromLinesAsync();
        appliedModelId = modelIdText;
        statusMessage = L($"Parte precargado desde model {sourceModel.Code}.", $"Part precarregat des de model {sourceModel.Code}.", $"Order preloaded from model {sourceModel.Code}.");
        isError = false;
    }

    private async Task InferMachineFromLinesAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || model.MachineCode > 0)
        {
            if (model.MachineCode > 0 && string.IsNullOrWhiteSpace(model.MachineName))
            {
                model.MachineName = ResolveMachineName(model.MachineCode);
            }

            if (model.OperationCode > 0 && string.IsNullOrWhiteSpace(model.OperationName))
            {
                model.OperationName = ResolveOperationName(model.OperationCode);
            }

            return;
        }

        foreach (var line in model.Lines.OrderBy(item => item.LineNumber))
        {
            if (string.IsNullOrWhiteSpace(line.FabricCode))
            {
                continue;
            }

            var fabric = await TejidoQueries.GetByCodeAsync(tenantId.Value, companyId.Value, line.FabricCode);
            if (fabric is null || fabric.MachineCode <= 0)
            {
                continue;
            }

            model.MachineCode = fabric.MachineCode;
            model.MachineName = ResolveMachineName(fabric.MachineCode);
            return;
        }
    }

    private static ParteAcabadoDetailDto BuildFromDisposition(DisposicionDetailDto disposition)
    {
        var detail = new ParteAcabadoDetailDto
        {
            Date = disposition.Date ?? DateTime.Today,
            Status = ParteAcabadoStatuses.Pending,
            ClientCode = disposition.ClientCode,
            ClientName = disposition.ClientName,
            FinisherCode = disposition.FinisherCode,
            FinisherName = disposition.FinisherName,
            DispositionCode = disposition.Code,
            DispositionLabel = FormatDispositionLabel(disposition),
            Notes = disposition.Notes,
            Origin = "local",
            Lines = disposition.Lines
                .OrderBy(item => item.LineNumber)
                .Select(item => new ParteAcabadoLineDto
                {
                    LineNumber = item.LineNumber,
                    FabricCode = item.FabricCode,
                    FabricDescription = item.Description,
                    Color = disposition.Color,
                    TotalKilograms = item.TotalKilograms,
                    TotalPieces = item.TotalPieces,
                    Status = item.IsServed
                        ? ParteAcabadoStatuses.Finished
                        : item.IsDisposed
                            ? ParteAcabadoStatuses.InProgress
                            : ParteAcabadoStatuses.Pending,
                    Notes = item.FinishText
                })
                .ToList()
        };

        detail.TotalKilograms = detail.Lines.Sum(item => item.TotalKilograms);
        detail.TotalPieces = detail.Lines.Sum(item => item.TotalPieces);
        return detail;
    }

    private ParteAcabadoDetailDto BuildFromSample(MuestraDetailDto sample, int? sampleLineNumber, string sourceSampleKind)
    {
        var selectedLines = sampleLineNumber.HasValue
            ? sample.Lines.Where(item => item.LineNumber == sampleLineNumber.Value).ToList()
            : sample.Lines.OrderBy(item => item.LineNumber).ToList();

        if (selectedLines.Count == 0)
        {
            selectedLines =
            [
                new MuestraLineDto
                {
                    LineNumber = 1,
                    Description = sample.Description,
                    Color = string.Empty,
                    ClientCode = sample.ClientCode,
                    ClientName = sample.ClientName
                }
            ];
        }

        var primaryBreakdown = selectedLines
            .Select(item => item.Breakdown)
            .FirstOrDefault(item => item is not null && (item.MachineCode > 0 || item.WorkDate.HasValue || item.OperationCode > 0 || !string.IsNullOrWhiteSpace(item.OperationName)));

        var detail = new ParteAcabadoDetailDto
        {
            Date = primaryBreakdown?.WorkDate ?? DateTime.Today,
            Status = ParteAcabadoStatuses.Pending,
            ClientCode = sample.ClientCode,
            ClientName = sample.ClientName,
            MachineCode = primaryBreakdown?.MachineCode ?? sample.MachineCode,
            MachineName = !string.IsNullOrWhiteSpace(primaryBreakdown?.MachineName) ? primaryBreakdown.MachineName : sample.MachineName,
            OperationCode = primaryBreakdown?.OperationCode ?? 0,
            OperationName = primaryBreakdown?.OperationName ?? string.Empty,
            SourceSampleKind = ParteAcabadoSourceKinds.Normalize(sourceSampleKind, hasLinkedSource: true),
            SourceSampleCode = sample.Code,
            SourceSampleLineNumber = sampleLineNumber,
            Notes = BuildSampleNotes(sample, sampleLineNumber, primaryBreakdown),
            Origin = "local",
            Lines = selectedLines
                .OrderBy(item => item.LineNumber)
                .Select(item => new ParteAcabadoLineDto
                {
                    LineNumber = item.LineNumber,
                    FabricCode = sample.Code,
                    FabricDescription = string.IsNullOrWhiteSpace(item.Description) ? sample.Description : item.Description,
                    Color = item.Color,
                    TotalKilograms = 0,
                    TotalPieces = 1,
                    Status = ParteAcabadoStatuses.Pending,
                    Notes = BuildSampleLineNotes(item)
                })
                .ToList()
        };

        detail.TotalKilograms = detail.Lines.Sum(item => item.TotalKilograms);
        detail.TotalPieces = detail.Lines.Sum(item => item.TotalPieces);
        return detail;
    }

    private ParteAcabadoDetailDto BuildFromModel(ModeloDetailDto sourceModel)
    {
        var detail = new ParteAcabadoDetailDto
        {
            Date = DateTime.Today,
            Status = ParteAcabadoStatuses.Pending,
            ClientCode = sourceModel.ClientCode,
            ClientName = sourceModel.ClientName,
            FinisherCode = sourceModel.FinishingWorkshopCode,
            FinisherName = sourceModel.FinishingWorkshopName,
            SourceSampleKind = ParteAcabadoSourceKinds.Model,
            SourceSampleCode = sourceModel.Code,
            SourceRecordId = sourceModel.Id.ToString(),
            Notes = BuildModelNotes(sourceModel),
            Origin = "local"
        };

        var stockLines = sourceModel.StockLines
            .OrderBy(item => item.LineNumber)
            .Select(item => new ParteAcabadoLineDto
            {
                LineNumber = item.LineNumber,
                FabricCode = string.IsNullOrWhiteSpace(sourceModel.FabricCode) ? sourceModel.Code : sourceModel.FabricCode,
                FabricDescription = string.IsNullOrWhiteSpace(sourceModel.FabricDescription) ? sourceModel.Description : sourceModel.FabricDescription,
                Color = item.Color,
                TotalKilograms = 0,
                TotalPieces = SumStockPieces(item),
                Status = ParteAcabadoStatuses.Pending,
                Notes = item.SizeText
            })
            .Where(item => !string.IsNullOrWhiteSpace(item.FabricCode) || !string.IsNullOrWhiteSpace(item.FabricDescription))
            .ToList();

        if (stockLines.Count > 0)
        {
            detail.Lines = stockLines;
        }
        else
        {
            var colorLines = sourceModel.ColorLines
                .OrderBy(item => item.LineNumber)
                .Select(item => new ParteAcabadoLineDto
                {
                    LineNumber = item.LineNumber,
                    FabricCode = string.IsNullOrWhiteSpace(sourceModel.FabricCode) ? sourceModel.Code : sourceModel.FabricCode,
                    FabricDescription = string.IsNullOrWhiteSpace(item.Title) ? (string.IsNullOrWhiteSpace(sourceModel.Description) ? sourceModel.Code : sourceModel.Description) : item.Title,
                    Color = string.IsNullOrWhiteSpace(item.ColorTitle) ? item.ModelColorCode : item.ColorTitle,
                    TotalKilograms = 0,
                    TotalPieces = 0,
                    Status = ParteAcabadoStatuses.Pending,
                    Notes = item.ModelColorCode
                })
                .ToList();

            detail.Lines = colorLines.Count > 0
                ? colorLines
                : new List<ParteAcabadoLineDto>
                {
                    new()
                    {
                        LineNumber = 1,
                        FabricCode = string.IsNullOrWhiteSpace(sourceModel.FabricCode) ? sourceModel.Code : sourceModel.FabricCode,
                        FabricDescription = string.IsNullOrWhiteSpace(sourceModel.Description) ? sourceModel.Code : sourceModel.Description,
                        Color = string.Empty,
                        TotalKilograms = 0,
                        TotalPieces = 0,
                        Status = ParteAcabadoStatuses.Pending
                    }
                };
        }

        detail.TotalKilograms = detail.Lines.Sum(item => item.TotalKilograms);
        detail.TotalPieces = detail.Lines.Sum(item => item.TotalPieces);
        return detail;
    }

    private string BuildSampleNotes(MuestraDetailDto sample, int? sampleLineNumber, MuestraBreakdownDto? breakdown)
    {
        var notes = new List<string>
        {
            $"{L("Base muestra", "Base mostra", "Sample base")}: {sample.Code}"
        };

        if (sampleLineNumber.HasValue)
        {
            notes.Add($"{L("Línea muestra", "Línia mostra", "Sample line")}: {sampleLineNumber.Value}");
        }

        if (!string.IsNullOrWhiteSpace(sample.Reference))
        {
            notes.Add($"{L("Referencia", "Referència", "Reference")}: {sample.Reference}");
        }

        if (!string.IsNullOrWhiteSpace(sample.Season))
        {
            notes.Add($"{L("Temporada", "Temporada", "Season")}: {sample.Season}");
        }

        if (breakdown is not null)
        {
            if (!string.IsNullOrWhiteSpace(breakdown.Cuts))
            {
                notes.Add($"{L("Cortes", "Talls", "Cuts")}: {breakdown.Cuts}");
            }

            if (!string.IsNullOrWhiteSpace(breakdown.Notes))
            {
                notes.Add($"{L("Desglose", "Desglossament", "Breakdown")}: {breakdown.Notes}");
            }
        }

        if (!string.IsNullOrWhiteSpace(sample.Notes))
        {
            notes.Add(sample.Notes);
        }

        return string.Join(" · ", notes.Where(item => !string.IsNullOrWhiteSpace(item)));
    }

    private string BuildSampleLineNotes(MuestraLineDto line)
    {
        var notes = new List<string>();

        var size = string.Join(" / ", new[] { line.SizeCode, line.SizeHigh, line.SizeLow }.Where(item => !string.IsNullOrWhiteSpace(item)));
        if (!string.IsNullOrWhiteSpace(size))
        {
            notes.Add($"{L("Talla", "Talla", "Size")}: {size}");
        }

        if (line.ClientCode > 0)
        {
            notes.Add($"{L("Cliente línea", "Client línia", "Line customer")}: {line.ClientCode}");
        }

        if (!string.IsNullOrWhiteSpace(line.NcCode))
        {
            notes.Add($"NC: {line.NcCode}");
        }

        return string.Join(" · ", notes);
    }

    private string BuildModelNotes(ModeloDetailDto sourceModel)
    {
        var notes = new List<string>
        {
            $"{L("Base model", "Base model", "Model base")}: {sourceModel.Code}"
        };

        if (!string.IsNullOrWhiteSpace(sourceModel.Season))
        {
            notes.Add($"{L("Temporada", "Temporada", "Season")}: {sourceModel.Season}");
        }

        if (!string.IsNullOrWhiteSpace(sourceModel.Series))
        {
            notes.Add($"{L("Serie", "Sèrie", "Series")}: {sourceModel.Series}");
        }

        if (!string.IsNullOrWhiteSpace(sourceModel.Description))
        {
            notes.Add(sourceModel.Description);
        }

        if (!string.IsNullOrWhiteSpace(sourceModel.Notes))
        {
            notes.Add(sourceModel.Notes);
        }

        return string.Join(" · ", notes.Where(item => !string.IsNullOrWhiteSpace(item)));
    }

    private static decimal SumStockPieces(ModeloStockLineDto line) =>
        line.SizeQuantity01 +
        line.SizeQuantity02 +
        line.SizeQuantity03 +
        line.SizeQuantity04 +
        line.SizeQuantity05 +
        line.SizeQuantity06 +
        line.SizeQuantity07 +
        line.SizeQuantity08 +
        line.SizeQuantity09 +
        line.SizeQuantity10;

    private string ResolveMachineName(int machineCode)
    {
        if (machineCode <= 0)
        {
            return string.Empty;
        }

        return machineOptions.FirstOrDefault(item => ParseMachineCode(item.Code) == machineCode)?.Name ?? string.Empty;
    }

    private string ResolveOperationName(int operationCode)
    {
        if (operationCode <= 0)
        {
            return string.Empty;
        }

        return operationOptions.FirstOrDefault(item => ParseOperationCode(item.Code) == operationCode)?.Name ?? string.Empty;
    }

    private static string FormatDispositionLabel(DisposicionDetailDto disposition) =>
        string.IsNullOrWhiteSpace(disposition.Year)
            ? disposition.Number.ToString()
            : $"{disposition.Number}-{disposition.Year}";

    private static int ParseMachineCode(string code) =>
        int.TryParse(code, out var parsedValue) ? parsedValue : 0;

    private static string FormatMachineOption(BaseCatalogListItemDto item) =>
        string.IsNullOrWhiteSpace(item.Name) ? item.Code : $"{item.Code} · {item.Name}";

    private static int ParseOperationCode(string code) =>
        int.TryParse(code, out var parsedValue) ? parsedValue : 0;

    private static string FormatOperationOption(BaseCatalogListItemDto item) =>
        string.IsNullOrWhiteSpace(item.Name) ? item.Code : $"{item.Code} · {item.Name}";
}
