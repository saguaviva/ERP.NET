@page "/produccion/acabados/nueva"
@page "/produccion/acabados/editar/{OrderNumber:int}"
@page "/compras/ordenes-fabricacion-muestras/nueva"
@page "/compras/ordenes-fabricacion-muestras/editar/{OrderNumber:int}"
@page "/compras/ordenes-fabricacion-models/nueva"
@page "/compras/ordenes-fabricacion-models/editar/{OrderNumber:int}"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuditLogService AuditLogService
@inject IBaseCatalogQueries BaseCatalogQueries
@inject IDisposicionQueries DisposicionQueries
@inject IModeloQueries ModeloQueries
@inject IMuestraQueries MuestraQueries
@inject IParteAcabadoQueries ParteAcabadoQueries
@inject IParteAcabadoService ParteAcabadoService
@inject ITejidoQueries TejidoQueries
@inject NavigationManager NavigationManager
@inject AppText T

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@HeaderEyebrowText</p>
        <h1>@HeaderTitleText</h1>
        <p class="lead">@HeaderLeadText</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="@BackToListUrl">@L("Volver al listado", "Tornar al llistat", "Back to list")</a>
        @if (OrderNumber.HasValue)
        {
            <a class="secondary-button link-button" href="@BuildCurrentPrintUrl(OrderNumber.Value)" target="_blank" rel="noopener noreferrer">@L("Imprimir ficha", "Imprimir fitxa", "Print sheet")</a>
        }
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
    }

    @if (!canEdit && !OrderNumber.HasValue)
    {
        <div class="alert">
            @L("No tienes permisos para crear órdenes / partes de acabado nuevas en esta empresa.", "No tens permisos per crear ordres / parts d'acabat nous en aquesta empresa.", "You do not have permission to create new finish orders in this company.")
        </div>
    }

    <section class="card-grid">
        <article class="info-card">
            <p class="eyebrow">@L("Número", "Número", "Number")</p>
            <h2>@DisplayNumber</h2>
            <p class="muted">@L("Identificador de trabajo interno.", "Identificador de treball intern.", "Internal work identifier.")</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Estado", "Estat", "Status")</p>
            <h2>@GetStatusLabel(model.Status)</h2>
            <p class="muted">@L("Situación actual del trabajo de acabado.", "Situació actual del treball d'acabat.", "Current status of the finish order.")</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Totales", "Totals", "Totals")</p>
            <h2>@model.TotalKilograms.ToUiString("0.##") kg</h2>
            <p class="muted">@model.TotalPieces.ToUiString("0.##") @L("piezas", "peces", "pieces") · @model.Lines.Count @L("líneas", "línies", "lines")</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Origen", "Origen", "Origin")</p>
            <h2>@DisplayOrigin</h2>
            <p class="muted">@L("Todas las altas y cambios se guardan en local.", "Totes les altes i canvis es desen en local.", "All creates and changes are stored locally.")</p>
        </article>
    </section>

    <section class="card-grid" style="margin-top: 1rem;">
        <article class="info-card">
            <p class="eyebrow">@L("Líneas pendientes", "Línies pendents", "Pending lines")</p>
            <h2>@PendingLinesCount</h2>
            <p class="muted">@L("Todavía sin pasar a proceso.", "Encara sense passar a procés.", "Not yet moved into processing.")</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("En proceso", "En procés", "In progress")</p>
            <h2>@InProgressLinesCount</h2>
            <p class="muted">@L("Ya dispuestas, pendientes de terminar.", "Ja disposades, pendents d'acabar.", "Already prepared, waiting to be finished.")</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Terminadas", "Acabades", "Finished")</p>
            <h2>@FinishedLinesCount</h2>
            <p class="muted">@L("Servidas y reflejadas en disposición.", "Servides i reflectides a disposició.", "Served and reflected on the linked disposition.")</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Disposición enlazada", "Disposició enllaçada", "Linked disposition")</p>
            <h2>@(string.IsNullOrWhiteSpace(model.DispositionLabel) ? L("Sin enlace", "Sense enllaç", "No link") : model.DispositionLabel)</h2>
            <p class="muted">
                @if (HasLinkedDisposition)
                {
                    <a class="inline-link" href="@BuildDispositionUrl()">@L("Abrir disposición", "Obrir disposició", "Open disposition")</a>
                }
                else
                {
                    <span>@L("Sin disposición enlazada.", "Sense disposició enllaçada.", "No linked disposition.")</span>
                }
            </p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Origen enlazado", "Origen enllaçat", "Linked source")</p>
            <h2>@DisplaySourceSample</h2>
            <p class="muted">
                @if (HasLinkedSample)
                {
                    <a class="inline-link" href="@BuildSampleUrl()">@L("Abrir", "Obrir", "Open") @DisplaySourceKind.ToLowerInvariant()</a>
                }
                else
                {
                    <span>@L("Sin origen enlazado.", "Sense origen enllaçat.", "No linked source.")</span>
                }
            </p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Máquina", "Màquina", "Machine")</p>
            <h2>@DisplayMachine</h2>
            <p class="muted">@L("Referencia principal de máquina para este trabajo de acabado.", "Referència principal de màquina per a aquest treball d'acabat.", "Main machine reference for this finish order.")</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Operación", "Operació", "Operation")</p>
            <h2>@DisplayOperation</h2>
            <p class="muted">@L("Proceso principal aplicado a esta orden de acabado.", "Procés principal aplicat a aquesta ordre d'acabat.", "Main process applied to this finish order.")</p>
        </article>
    </section>

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <fieldset disabled="@isReadOnly">
            <div class="form-grid" style="margin-top: 1rem;">
                <label class="field">
                    <span>@L("Fecha", "Data", "Date")</span>
                    <InputDate TValue="DateTime?" class="text-input" @bind-Value="model.Date" />
                </label>
                <label class="field">
                    <span>@L("Estado", "Estat", "Status")</span>
                    <InputSelect class="text-input" @bind-Value="model.Status">
                        @foreach (var status in ParteAcabadoStatuses.All)
                        {
                            <option value="@status">@GetStatusLabel(status)</option>
                        }
                    </InputSelect>
                </label>
                <label class="field">
                    <span>@L("Cliente", "Client", "Customer")</span>
                    <InputNumber class="text-input" @bind-Value="model.ClientCode" />
                </label>
                <label class="field wide">
                    <span>@L("Nombre cliente", "Nom client", "Customer name")</span>
                    <InputText class="text-input" @bind-Value="model.ClientName" />
                </label>
                <label class="field">
                    <span>@L("Acabador", "Acabador", "Finisher")</span>
                    <InputNumber class="text-input" @bind-Value="model.FinisherCode" />
                </label>
                <label class="field wide">
                    <span>@L("Nombre acabador", "Nom acabador", "Finisher name")</span>
                    <InputText class="text-input" @bind-Value="model.FinisherName" />
                </label>
                <label class="field">
                    <span>@L("Máquina", "Màquina", "Machine")</span>
                    @if (machineOptions.Count == 0)
                    {
                        <InputNumber class="text-input" @bind-Value="model.MachineCode" />
                    }
                    else
                    {
                        <select class="text-input" value="@model.MachineCode" @onchange="OnMachineChanged">
                            <option value="0">@L("Selecciona máquina", "Selecciona màquina", "Select machine")</option>
                            @foreach (var machine in machineOptions)
                            {
                                <option value="@ParseMachineCode(machine.Code)">@FormatMachineOption(machine)</option>
                            }
                        </select>
                    }
                </label>
                <label class="field wide">
                    <span>@L("Nombre máquina", "Nom màquina", "Machine name")</span>
                    @if (machineOptions.Count == 0)
                    {
                        <InputText class="text-input" @bind-Value="model.MachineName" />
                    }
                    else
                    {
                        <input class="text-input" value="@model.MachineName" disabled />
                    }
                </label>
                <label class="field">
                    <span>@L("Operación", "Operació", "Operation")</span>
                    @if (operationOptions.Count == 0)
                    {
                        <InputNumber class="text-input" @bind-Value="model.OperationCode" />
                    }
                    else
                    {
                        <select class="text-input" value="@model.OperationCode" @onchange="OnOperationChanged">
                            <option value="0">@L("Selecciona operación", "Selecciona operació", "Select operation")</option>
                            @foreach (var operation in operationOptions)
                            {
                                <option value="@ParseOperationCode(operation.Code)">@FormatOperationOption(operation)</option>
                            }
                        </select>
                    }
                </label>
                <label class="field wide">
                    <span>@L("Nombre operación", "Nom operació", "Operation name")</span>
                    @if (operationOptions.Count == 0)
                    {
                        <InputText class="text-input" @bind-Value="model.OperationName" />
                    }
                    else
                    {
                        <input class="text-input" value="@model.OperationName" disabled />
                    }
                </label>
                <label class="field">
                    <span>@L("Disposición", "Disposició", "Disposition")</span>
                    <InputNumber class="text-input" @bind-Value="model.DispositionCode" />
                </label>
                <label class="field wide">
                    <span>@L("Etiqueta disposición", "Etiqueta disposició", "Disposition label")</span>
                    <InputText class="text-input" @bind-Value="model.DispositionLabel" />
                </label>
                <label class="field">
                    <span>@L("Tipo origen", "Tipus origen", "Source type")</span>
                    <InputSelect class="text-input" @bind-Value="model.SourceSampleKind">
                        <option value="">@L("Sin enlace", "Sense enllaç", "No link")</option>
                        <option value="@ParteAcabadoSourceKinds.Sample">@L("Muestra", "Mostra", "Sample")</option>
                        <option value="@ParteAcabadoSourceKinds.Complement">@L("Complemento", "Complement", "Complement")</option>
                        <option value="@ParteAcabadoSourceKinds.Model">@L("Model", "Model", "Model")</option>
                    </InputSelect>
                </label>
                <label class="field">
                    <span>@L("Código origen", "Codi origen", "Source code")</span>
                    <InputText class="text-input" @bind-Value="model.SourceSampleCode" />
                </label>
                <label class="field">
                    <span>@L("Línea origen", "Línia origen", "Source line")</span>
                    <InputNumber class="text-input" @bind-Value="model.SourceSampleLineNumber" />
                </label>
                <label class="field wide">
                    <span>@L("Notas", "Notes", "Notes")</span>
                    <InputTextArea class="text-input textarea-input" @bind-Value="model.Notes" />
                </label>
            </div>

            <section class="panel detail-panel" style="margin-top: 1rem;">
                <div class="detail-panel-header">
                    <div>
                        <h2>@L("Líneas del parte", "Línies del part", "Order lines")</h2>
                        <p class="muted">@L("Tejido, color, piezas, kg y estado de cada trabajo de acabado.", "Teixit, color, peces, kg i estat de cada treball d'acabat.", "Fabric, color, pieces, kg and status of each finish task.")</p>
                    </div>
                    @if (!isReadOnly)
                    {
                        <button class="secondary-button" type="button" @onclick="AddLine">@L("Añadir línea", "Afegir línia", "Add line")</button>
                    }
                </div>

                <div class="table-scroll">
                    <table class="data-table detail-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>@L("Tejido", "Teixit", "Fabric")</th>
                                <th>@L("Descripción", "Descripció", "Description")</th>
                                <th>@L("Color", "Color", "Color")</th>
                                <th>Kg</th>
                                <th>@L("Piezas", "Peces", "Pieces")</th>
                                <th>@L("Estado", "Estat", "Status")</th>
                                <th>@L("Notas", "Notes", "Notes")</th>
                                <th>@L("Acciones", "Accions", "Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (model.Lines.Count == 0)
                            {
                                <tr>
                                    <td colspan="9" class="muted">@L("No hay líneas cargadas para este parte de acabado.", "No hi ha línies carregades per a aquest part d'acabat.", "There are no lines loaded for this finish order.")</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var line in model.Lines.OrderBy(item => item.LineNumber))
                                {
                                    <tr @key="line.LineNumber">
                                        <td>@line.LineNumber</td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.FabricCode" /></td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.FabricDescription" /></td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.Color" /></td>
                                        <td><InputNumber class="text-input table-input" @bind-Value="line.TotalKilograms" /></td>
                                        <td><InputNumber class="text-input table-input" @bind-Value="line.TotalPieces" /></td>
                                        <td>
                                            <InputSelect class="text-input table-input" @bind-Value="line.Status">
                                                @foreach (var status in ParteAcabadoStatuses.All)
                                                {
                                                    <option value="@status">@GetStatusLabel(status)</option>
                                                }
                                            </InputSelect>
                                        </td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.Notes" /></td>
                                        <td>
                                            <div class="inline-action-list">
                                                @if (!string.IsNullOrWhiteSpace(line.FabricCode))
                                                {
                                                    <a class="inline-link" href="@BuildTejidoUrl(line)">@L("Tejido", "Teixit", "Fabric")</a>
                                                    <a class="inline-link" href="@BuildMovementsUrl(line)">@L("Movs.", "Movs.", "Moves")</a>
                                                }
                                                @if (!isReadOnly)
                                                {
                                                    <button class="danger-link" type="button" @onclick="() => RemoveLine(line.LineNumber)">@L("Quitar", "Treure", "Remove")</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <div class="quick-links" style="margin-top: 1rem;">
                @if (canEdit)
                {
                    <button class="primary-button" type="submit">@L("Guardar parte de acabado", "Desar part d'acabat", "Save finish order")</button>
                }
                @if (canEdit && OrderNumber.HasValue)
                {
                    <button class="secondary-button danger-button" type="button" @onclick="DeleteAsync">@L("Eliminar parte", "Eliminar part", "Delete order")</button>
                }
                @if (OrderNumber.HasValue)
                {
                    <button class="secondary-button" type="button" @onclick="LoadAuditAsync">@L("Recargar historial", "Recarregar historial", "Reload history")</button>
                }
            </div>
        </fieldset>
    </EditForm>

    @if (OrderNumber.HasValue)
    {
        <section class="panel" style="margin-top: 1rem;">
            <h2>@L("Historial reciente del parte de acabado", "Historial recent del part d'acabat", "Recent finish order history")</h2>
            <div class="list-block">
                @if (recentAuditLogs.Count == 0)
                {
                    <p class="muted">@L("Todavía no hay eventos auditados para este parte.", "Encara no hi ha esdeveniments auditats per a aquest part.", "There are no audited events yet for this order.")</p>
                }
                else
                {
                    @foreach (var entry in recentAuditLogs)
                    {
                        <article class="list-item">
                            <strong>@entry.Action</strong>
                            @if (!string.IsNullOrWhiteSpace(entry.Details))
                            {
                                <span>@entry.Details</span>
                            }
                            <span>@entry.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </article>
                    }
                }
            </div>
        </section>
    }
}

@code {
    [Parameter]
    public int? OrderNumber { get; set; }
    [SupplyParameterFromQuery(Name = "disposicionCode")]
    public int? DispositionCodeFromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "sampleCode")]
    public string? SampleCodeFromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "sampleLine")]
    public int? SampleLineFromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "sampleKind")]
    public string? SampleKindFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "modelId")]
    public string? ModelIdFromQuery { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isReadOnly;
    private ParteAcabadoDetailDto model = new() { Date = DateTime.Today };
    private IReadOnlyCollection<BaseCatalogListItemDto> machineOptions = [];
    private IReadOnlyCollection<BaseCatalogListItemDto> operationOptions = [];
    private string statusMessage = string.Empty;
    private bool isError;
    private IReadOnlyCollection<AuditLogEntryDto> recentAuditLogs = [];
    private int? appliedDispositionCode;
    private string? appliedSampleCode;
    private int? appliedSampleLineNumber;
    private string? appliedSampleKind;
    private string appliedModelId = string.Empty;
    private string CurrentPath => NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0];
    private bool IsSampleManufacturingView => CurrentPath.StartsWith("compras/ordenes-fabricacion-muestras", StringComparison.OrdinalIgnoreCase);
    private bool IsModelManufacturingView => CurrentPath.StartsWith("compras/ordenes-fabricacion-models", StringComparison.OrdinalIgnoreCase);
    private string HeaderEyebrowText => IsSampleManufacturingView || IsModelManufacturingView
        ? T["menu.purchases"]
        : T["menu.production"];
    private string PageTitleText => OrderNumber.HasValue
        ? $"{EditOrderLabel} {OrderNumber}"
        : NewOrderLabel;
    private string HeaderTitleText => OrderNumber.HasValue
        ? $"{EditOrderLabel} {OrderNumber}"
        : NewOrderLabel;
    private string HeaderLeadText => IsSampleManufacturingView
        ? L("Ficha operativa de la orden de fabricación nacida desde muestras o complementos, con cliente, máquina, operación y líneas de trabajo.", "Fitxa operativa de l'ordre de fabricació nascuda des de mostres o complements, amb client, màquina, operació i línies de treball.", "Operational manufacturing order created from samples or complements, with client, machine, operation and work lines.")
        : IsModelManufacturingView
            ? L("Ficha operativa de la orden de fabricación nacida desde models, con trazabilidad al model origen y sus líneas de producción.", "Fitxa operativa de l'ordre de fabricació nascuda des de models, amb traçabilitat al model origen i les seves línies de producció.", "Operational manufacturing order created from models, with traceability back to the source model and its production lines.")
            : L("Ficha operativa de acabado con estado, cliente, acabador y líneas de tejido/color.", "Fitxa operativa d'acabat amb estat, client, acabador i línies de teixit/color.", "Operational finish sheet with status, customer, finisher and fabric/color lines.");
    private string NewOrderLabel => IsSampleManufacturingView
        ? L("Nueva orden fabricación muestras", "Nova ordre fabricació mostres", "New sample manufacturing order")
        : IsModelManufacturingView
            ? L("Nueva orden fabricación models", "Nova ordre fabricació models", "New model manufacturing order")
            : L("Nueva orden de acabado", "Nova ordre d'acabat", "New finish order");
    private string EditOrderLabel => IsSampleManufacturingView
        ? L("Editar orden fabricación muestras", "Editar ordre fabricació mostres", "Edit sample manufacturing order")
        : IsModelManufacturingView
            ? L("Editar orden fabricación models", "Editar ordre fabricació models", "Edit model manufacturing order")
            : L("Editar orden de acabado", "Editar ordre d'acabat", "Edit finish order");
    private string BackToListUrl => IsSampleManufacturingView
        ? "/compras/ordenes-fabricacion-muestras"
        : IsModelManufacturingView
            ? "/compras/ordenes-fabricacion-models"
            : "/produccion/acabados";

    private string DisplayNumber => model.OrderNumber > 0 ? model.OrderNumber.ToString() : L("Nuevo", "Nou", "New");
    private string DisplayOrigin => string.IsNullOrWhiteSpace(model.Origin) ? L("local", "local", "local") : model.Origin;
    private int PendingLinesCount => model.Lines.Count(item => string.Equals(item.Status, ParteAcabadoStatuses.Pending, StringComparison.OrdinalIgnoreCase));
    private int InProgressLinesCount => model.Lines.Count(item => string.Equals(item.Status, ParteAcabadoStatuses.InProgress, StringComparison.OrdinalIgnoreCase));
    private int FinishedLinesCount => model.Lines.Count(item => string.Equals(item.Status, ParteAcabadoStatuses.Finished, StringComparison.OrdinalIgnoreCase));
    private bool HasLinkedDisposition => model.DispositionCode.HasValue && model.DispositionCode.Value > 0;
    private bool HasLinkedSample => !string.IsNullOrWhiteSpace(model.SourceSampleCode);
    private string DisplaySourceKind => HasLinkedSample ? GetSourceKindLabel(model.SourceSampleKind) : L("Sin enlace", "Sense enllaç", "No link");
    private string DisplaySourceSample => HasLinkedSample
        ? (model.SourceSampleLineNumber.HasValue ? $"{DisplaySourceKind} {model.SourceSampleCode} · {L("línea", "línia", "line")} {model.SourceSampleLineNumber.Value}" : $"{DisplaySourceKind} {model.SourceSampleCode}")
        : L("Sin enlace", "Sense enllaç", "No link");
    private string DisplayMachine => model.MachineCode > 0
        ? (string.IsNullOrWhiteSpace(model.MachineName) ? model.MachineCode.ToString() : $"{model.MachineCode} · {model.MachineName}")
        : L("Sin máquina", "Sense màquina", "No machine");
    private string DisplayOperation => model.OperationCode > 0
        ? (string.IsNullOrWhiteSpace(model.OperationName) ? model.OperationCode.ToString() : $"{model.OperationCode} · {model.OperationName}")
        : L("Sin operación", "Sense operació", "No operation");
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);
        isReadOnly = !canEdit;

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        await LoadMachineOptionsAsync();
        await LoadOperationOptionsAsync();

        if (OrderNumber.HasValue)
        {
            var detail = await ParteAcabadoQueries.GetByNumberAsync(tenantId.Value, companyId.Value, OrderNumber.Value);
            if (detail is null)
            {
                statusMessage = L("No se ha encontrado la orden / parte de acabado solicitada.", "No s'ha trobat l'ordre / part d'acabat sol·licitada.", "The requested finish order could not be found.");
                isError = true;
                model = new ParteAcabadoDetailDto { Date = DateTime.Today };
                recentAuditLogs = [];
                return;
            }

            model = detail;
            await LoadAuditAsync();
            return;
        }

        model = new ParteAcabadoDetailDto
        {
            Date = DateTime.Today,
            Status = ParteAcabadoStatuses.Pending,
            Origin = "local"
        };
        ApplyWorkflowDefaults();
        recentAuditLogs = [];
        await TryApplySampleBaseAsync();
        await TryApplyModelBaseAsync();
        await TryApplyDispositionBaseAsync();
    }

    private async Task SaveAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        if (isReadOnly)
        {
            statusMessage = L("No tienes permisos de edición en este tenant.", "No tens permisos d'edició en aquest tenant.", "You do not have edit permissions in this tenant.");
            isError = true;
            return;
        }

        try
        {
            statusMessage = string.Empty;
            isError = false;

            var savedOrderNumber = await ParteAcabadoService.SaveAsync(new SaveParteAcabadoCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                OrderNumber = OrderNumber,
                Date = model.Date,
                Status = model.Status,
                ClientCode = model.ClientCode,
                ClientName = model.ClientName,
                FinisherCode = model.FinisherCode,
                FinisherName = model.FinisherName,
                MachineCode = model.MachineCode,
                MachineName = model.MachineName,
                OperationCode = model.OperationCode,
                OperationName = model.OperationName,
                DispositionCode = model.DispositionCode,
                DispositionLabel = model.DispositionLabel,
                SourceSampleKind = model.SourceSampleKind,
                SourceSampleCode = model.SourceSampleCode,
                SourceSampleLineNumber = model.SourceSampleLineNumber,
                SourceRecordId = model.SourceRecordId,
                Notes = model.Notes,
                Lines = model.Lines
                    .OrderBy(item => item.LineNumber)
                    .Select(item => new SaveParteAcabadoLineInput
                    {
                        LineNumber = item.LineNumber,
                        FabricCode = item.FabricCode,
                        FabricDescription = item.FabricDescription,
                        Color = item.Color,
                        TotalKilograms = item.TotalKilograms,
                        TotalPieces = item.TotalPieces,
                        Status = item.Status,
                        Notes = item.Notes
                    })
                    .ToList()
            });

            statusMessage = OrderNumber.HasValue
                ? L("Parte de acabado actualizado correctamente.", "Part d'acabat actualitzat correctament.", "Finish order updated successfully.")
                : L("Parte de acabado creado correctamente.", "Part d'acabat creat correctament.", "Finish order created successfully.");

            if (!OrderNumber.HasValue)
            {
                NavigationManager.NavigateTo(BuildCurrentEditUrl(savedOrderNumber), forceLoad: false);
                return;
            }

            model.OrderNumber = savedOrderNumber;
            model.TotalKilograms = model.Lines.Sum(item => item.TotalKilograms);
            model.TotalPieces = model.Lines.Sum(item => item.TotalPieces);
            model.Origin = "local";
            await LoadAuditAsync();
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

