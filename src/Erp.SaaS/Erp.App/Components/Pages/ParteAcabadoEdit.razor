    {
        if (!HasLinkedSample)
        {
            return "/articulos/muestras";
        }

        if (string.Equals(ParteAcabadoSourceKinds.Normalize(model.SourceSampleKind, hasLinkedSource: true), ParteAcabadoSourceKinds.Model, StringComparison.OrdinalIgnoreCase) &&
