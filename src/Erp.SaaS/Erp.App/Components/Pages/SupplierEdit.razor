@page "/crm/proveedores/nuevo"
@page "/crm/proveedores/editar/{Code:int}"
@attribute [Authorize(Roles = "TenantAdmin")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuditLogService AuditLogService
@inject ILegacySyncService LegacySyncService
@inject IProveedorQueries ProveedorQueries
@inject IProveedorService ProveedorService
@inject NavigationManager NavigationManager
@inject AppText T

<PageTitle>@(Code.HasValue
    ? L("Editar proveedor", "Editar proveïdor", "Edit supplier")
    : L("Nuevo proveedor", "Nou proveïdor", "New supplier"))</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("Compras", "Compres", "Purchases")</p>
        <h1>@(Code.HasValue
            ? $"{L("Editar proveedor", "Editar proveïdor", "Edit supplier")} {Code}"
            : L("Nuevo proveedor", "Nou proveïdor", "New supplier"))</h1>
        <p class="lead">@(isLegacySyncActive
            ? L("Alta y edición sobre la réplica SaaS local. La sincronización manual solo refresca los registros que sigan siendo de origen legacy.",
                "Alta i edició sobre la rèplica SaaS local. La sincronització manual només refresca els registres que continuen sent d'origen legacy.",
                "Create and edit data on the local SaaS replica. Manual sync only refreshes records that still remain legacy-origin.")
            : L("Alta y edición sobre la tabla prove replicada en la SaaS local, filtrada por la empresa activa.",
                "Alta i edició sobre la taula prove replicada a la SaaS local, filtrada per l'empresa activa.",
                "Create and edit data on the SaaS-local replicated prove table, filtered by the active company."))</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="/crm/proveedores">@L("Volver al listado", "Tornar al llistat", "Back to list")</a>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
    }

    @if (isLegacySyncActive)
    {
        <div class="alert">
            @L("Compras / Proveedores está en convivencia con legacy para esta empresa.",
                "Compres / Proveïdors està en convivència amb legacy per a aquesta empresa.",
                "Purchases / Suppliers is running in coexistence with legacy for this company.")
            @L("Esta ficha sigue siendo editable en local. Si modificas un proveedor importado, pasará a tratarse como registro local y la sync manual ya no lo sobreescribirá.",
                "Aquesta fitxa continua sent editable en local. Si modifiques un proveïdor importat, passarà a tractar-se com a registre local i la sync manual ja no el sobreescriurà.",
                "This record remains editable locally. If you modify an imported supplier, it will become a local record and manual sync will no longer overwrite it.")
            @if (!string.IsNullOrWhiteSpace(syncStatusLabel))
            {
                <span>@syncStatusLabel</span>
            }
        </div>
    }

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <fieldset>
        <div class="form-grid">
            <label class="field">
                <span>@L("Nombre", "Nom", "Name")</span>
                <InputText class="text-input" @bind-Value="model.Name" />
            </label>
            <label class="field">
                <span>@L("NIF", "NIF", "Tax ID")</span>
                <InputText class="text-input" @bind-Value="model.TaxId" />
            </label>
            <label class="field">
                <span>@L("Contacto", "Contacte", "Contact")</span>
                <InputText class="text-input" @bind-Value="model.ContactName" />
            </label>
            <label class="field">
                <span>@L("Teléfono", "Telèfon", "Phone")</span>
                <InputText class="text-input" @bind-Value="model.Phone" />
            </label>
            <label class="field">
                <span>@L("Teléfono 2", "Telèfon 2", "Phone 2")</span>
                <InputText class="text-input" @bind-Value="model.SecondaryPhone" />
            </label>
            <label class="field">
                <span>@L("Fax", "Fax", "Fax")</span>
                <InputText class="text-input" @bind-Value="model.Fax" />
            </label>
            <label class="field checkbox-field">
                <span>@L("Estado", "Estat", "Status")</span>
                <label class="checkbox-row">
                    <InputCheckbox @bind-Value="model.IsBlocked" />
                    <span>@L("Proveedor bloqueado", "Proveïdor bloquejat", "Blocked supplier")</span>
                </label>
            </label>
            <label class="field">
                <span>@L("Email principal", "Email principal", "Primary email")</span>
                <InputText class="text-input" @bind-Value="model.PrimaryEmail" />
            </label>
            <label class="field">
                <span>@L("Email secundario", "Email secundari", "Secondary email")</span>
                <InputText class="text-input" @bind-Value="model.SecondaryEmail" />
            </label>
            <label class="field">
                <span>@L("Forma de pago", "Forma de pagament", "Payment method")</span>
                <InputSelect class="text-input" @bind-Value="model.PaymentMethodCode">
                    <option value="">@L("Selecciona una forma", "Selecciona una forma", "Select a method")</option>
                    @foreach (var option in paymentMethods)
                    {
                        <option value="@option.Code">@option.Name (@option.Code)</option>
                    }
                </InputSelect>
                @if (SelectedPaymentMethod is not null)
                {
                    <span class="field-hint">@(FormatPaymentMethodSummary(SelectedPaymentMethod))</span>
                }
            </label>
            <label class="field">
                <span>@L("Banco", "Banc", "Bank")</span>
                <InputSelect class="text-input" @bind-Value="model.BankCode">
                    <option value="">@L("Selecciona un banco", "Selecciona un banc", "Select a bank")</option>
                    @foreach (var option in banks)
                    {
                        <option value="@option.Code">@option.Name (@option.Code)</option>
                    }
                </InputSelect>
            </label>
            <label class="field">
                <span>@L("Entidad", "Entitat", "Entity")</span>
                <InputText class="text-input" @bind-Value="model.BankEntityCode" />
            </label>
            <label class="field">
                <span>@L("Oficina", "Oficina", "Office")</span>
                <InputText class="text-input" @bind-Value="model.BankOfficeCode" />
            </label>
            <label class="field">
                <span>@L("Dígito control", "Dígit control", "Control digit")</span>
                <InputText class="text-input" @bind-Value="model.BankControlDigit" />
            </label>
            <label class="field">
                <span>@L("Cuenta", "Compte", "Account")</span>
                <InputText class="text-input" @bind-Value="model.BankAccountNumber" />
            </label>
            <label class="field">
                <span>@L("Día pago 1", "Dia pagament 1", "Payment day 1")</span>
                <InputNumber class="text-input" @bind-Value="model.PaymentDay1" />
            </label>
            <label class="field">
                <span>@L("Día pago 2", "Dia pagament 2", "Payment day 2")</span>
                <InputNumber class="text-input" @bind-Value="model.PaymentDay2" />
            </label>
            <label class="field">
                <span>@L("Día pago 3", "Dia pagament 3", "Payment day 3")</span>
                <InputNumber class="text-input" @bind-Value="model.PaymentDay3" />
            </label>
            <label class="field">
                <span>@L("IVA", "IVA", "VAT")</span>
                <InputSelect class="text-input" @bind-Value="model.TaxCode">
                    <option value="">@L("Selecciona un IVA", "Selecciona un IVA", "Select a VAT rate")</option>
                    @foreach (var option in vatRates)
                    {
                        <option value="@option.Code">@option.Name (@option.Code)</option>
                    }
                </InputSelect>
                @if (SelectedVatRate is not null)
                {
                    <span class="field-hint">@L("IVA", "IVA", "VAT") @FormatPercent(SelectedVatRate.TaxPercent) · RE @FormatPercent(SelectedVatRate.SurchargePercent)</span>
                }
            </label>
            <label class="field">
                <span>@L("Subcuenta", "Subcompte", "Subaccount")</span>
                <InputText class="text-input" @bind-Value="model.SubAccount" />
            </label>
            <label class="field checkbox-field">
                <span>@L("Contabilidad", "Comptabilitat", "Accounting")</span>
                <label class="checkbox-row">
                    <InputCheckbox @bind-Value="model.TransferToAccounting" />
                    <span>@L("Marcar para traspaso contable", "Marcar per a traspàs comptable", "Mark for accounting transfer")</span>
                </label>
            </label>
            <label class="field">
                <span>@L("IBAN", "IBAN", "IBAN")</span>
                <InputText class="text-input" @bind-Value="model.Iban" />
            </label>
            <label class="field">
                <span>@L("SWIFT", "SWIFT", "SWIFT")</span>
                <InputText class="text-input" @bind-Value="model.Swift" />
            </label>
            <label class="field">
                <span>@L("Incoterm", "Incoterm", "Incoterm")</span>
                <InputSelect class="text-input" @bind-Value="model.IncotermCode">
                    <option value="">@L("Selecciona un incoterm", "Selecciona un incoterm", "Select an incoterm")</option>
                    @foreach (var option in incoterms)
                    {
                        <option value="@option.Code">@option.Name (@option.Code)</option>
                    }
                </InputSelect>
            </label>
            <label class="field wide">
                <span>@L("Dirección", "Adreça", "Address")</span>
                <InputText class="text-input" @bind-Value="model.Address" />
            </label>
            <label class="field">
                <span>@L("Código postal", "Codi postal", "Postal code")</span>
                <InputText class="text-input" @bind-Value="model.PostalCode" />
            </label>
            <label class="field">
                <span>@L("Ciudad", "Ciutat", "City")</span>
                <InputText class="text-input" @bind-Value="model.City" />
            </label>
            <label class="field">
                <span>@L("Provincia", "Província", "Province")</span>
                <InputText class="text-input" @bind-Value="model.Province" />
            </label>
            <label class="field">
                <span>@L("País", "País", "Country")</span>
                <InputText class="text-input" @bind-Value="model.Country" />
            </label>
            <label class="field wide">
                <span>@L("Web", "Web", "Website")</span>
                <InputText class="text-input" @bind-Value="model.Website" />
            </label>
            <label class="field wide">
                <span>@L("Notas", "Notes", "Notes")</span>
                <InputTextArea class="text-area" @bind-Value="model.Notes" />
            </label>
        </div>

        <div class="quick-links" style="margin-top: 1rem;">
            <button class="primary-button" type="submit">@L("Guardar proveedor", "Desar proveïdor", "Save supplier")</button>
            @if (Code.HasValue)
            {
                <button class="secondary-button danger" type="button" @onclick="DeleteAsync">@L("Eliminar proveedor", "Eliminar proveïdor", "Delete supplier")</button>
                <button class="secondary-button" type="button" @onclick="LoadAuditAsync">@L("Recargar historial", "Recarregar historial", "Reload history")</button>
            }
        </div>
        </fieldset>
    </EditForm>

    @if (Code.HasValue)
    {
        <section class="panel" style="margin-top: 1rem;">
            <h2>@L("Historial reciente del proveedor", "Historial recent del proveïdor", "Recent supplier history")</h2>
            <div class="list-block">
                @if (recentAuditLogs.Count == 0)
                {
                    <p class="muted">@L("Todavía no hay eventos auditados para este proveedor.", "Encara no hi ha esdeveniments auditats per a aquest proveïdor.", "There are no audited events for this supplier yet.")</p>
                }
                else
                {
                    @foreach (var entry in recentAuditLogs)
                    {
                        <article class="list-item">
                            <strong>@entry.Action</strong>
                            @if (!string.IsNullOrWhiteSpace(entry.Details))
                            {
                                <span>@entry.Details</span>
                            }
                            <span>@entry.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </article>
                    }
                }
            </div>
        </section>
    }
}

@code {
    [Parameter]
    public int? Code { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private ProveedorDetailDto model = new();
    private string statusMessage = string.Empty;
    private bool isError;
    private bool isLegacySyncActive;
    private string syncStatusLabel = string.Empty;
    private IReadOnlyCollection<AuditLogEntryDto> recentAuditLogs = [];
    private IReadOnlyCollection<ProveedorCatalogOptionDto> paymentMethods = [];
    private IReadOnlyCollection<ProveedorCatalogOptionDto> banks = [];
    private IReadOnlyCollection<ProveedorCatalogOptionDto> vatRates = [];
    private IReadOnlyCollection<ProveedorCatalogOptionDto> incoterms = [];

    private ProveedorCatalogOptionDto? SelectedPaymentMethod =>
        paymentMethods.FirstOrDefault(option => string.Equals(option.Code, model.PaymentMethodCode, StringComparison.OrdinalIgnoreCase));

    private ProveedorCatalogOptionDto? SelectedVatRate =>
        vatRates.FirstOrDefault(option => string.Equals(option.Code, model.TaxCode, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        await LoadSyncStatusAsync();
        paymentMethods = await ProveedorQueries.GetPaymentMethodsAsync();
        banks = await ProveedorQueries.GetBanksAsync();
        vatRates = await ProveedorQueries.GetVatRatesAsync(tenantId.Value, companyId.Value);
        incoterms = await ProveedorQueries.GetIncotermsAsync();

        if (Code.HasValue)
        {
            var detail = await ProveedorQueries.GetByCodeAsync(tenantId.Value, companyId.Value, Code.Value);
            if (detail is null)
            {
                statusMessage = L("No se ha encontrado el proveedor solicitado.", "No s'ha trobat el proveïdor sol·licitat.", "The requested supplier was not found.");
                isError = true;
                model = new ProveedorDetailDto();
                recentAuditLogs = [];
                return;
            }

            model = detail;
            await LoadAuditAsync();
        }
        else
        {
            model = new ProveedorDetailDto();
            recentAuditLogs = [];
        }
    }

    private async Task SaveAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        try
        {
            statusMessage = string.Empty;
            isError = false;

            var code = await ProveedorService.SaveAsync(new SaveProveedorCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                Code = Code,
                Name = model.Name,
                TaxId = model.TaxId,
                Address = model.Address,
                PostalCode = model.PostalCode,
                City = model.City,
                Province = model.Province,
                Country = model.Country,
                ContactName = model.ContactName,
                Phone = model.Phone,
                SecondaryPhone = model.SecondaryPhone,
                Fax = model.Fax,
                IsBlocked = model.IsBlocked,
                PrimaryEmail = model.PrimaryEmail,
                SecondaryEmail = model.SecondaryEmail,
                PaymentMethodCode = model.PaymentMethodCode,
                BankCode = model.BankCode,
                BankEntityCode = model.BankEntityCode,
                BankOfficeCode = model.BankOfficeCode,
                BankControlDigit = model.BankControlDigit,
                BankAccountNumber = model.BankAccountNumber,
                PaymentDay1 = model.PaymentDay1,
                PaymentDay2 = model.PaymentDay2,
                PaymentDay3 = model.PaymentDay3,
                TaxCode = model.TaxCode,
                SubAccount = model.SubAccount,
                TransferToAccounting = model.TransferToAccounting,
                Iban = model.Iban,
                Swift = model.Swift,
                IncotermCode = model.IncotermCode,
                Website = model.Website,
                Notes = model.Notes
            });

            statusMessage = Code.HasValue
                ? L("Proveedor actualizado correctamente.", "Proveïdor actualitzat correctament.", "Supplier updated successfully.")
                : L("Proveedor creado correctamente.", "Proveïdor creat correctament.", "Supplier created successfully.");

            if (!Code.HasValue)
            {
                NavigationManager.NavigateTo($"/crm/proveedores/editar/{code}", forceLoad: false);
                return;
            }

            await LoadAuditAsync();
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private async Task DeleteAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !Code.HasValue)
        {
            return;
        }

        try
        {
            await ProveedorService.DeleteAsync(tenantId.Value, companyId.Value, Code.Value);
            NavigationManager.NavigateTo("/crm/proveedores", forceLoad: false);
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private async Task LoadSyncStatusAsync()
    {
        isLegacySyncActive = false;
        syncStatusLabel = string.Empty;

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var status = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
            .FirstOrDefault(item =>
                item.CompanyId == companyId.Value &&
                string.Equals(item.ModuleKey, LegacySyncModuleKeys.CrmSuppliers, StringComparison.OrdinalIgnoreCase));

        if (status is null || !status.HasSuccessfulSync)
        {
            return;
        }

        isLegacySyncActive = true;
        syncStatusLabel = status.LastCompletedUtc.HasValue
            ? $"{L("Última sync", "Última sync", "Last sync")}: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Act: {status.LastUpdated} · Omi: {status.LastSkipped} · Err: {status.LastErrors}"
            : $"{L("Estado", "Estat", "Status")}: {status.LastStatus}";
    }

    private async Task LoadAuditAsync()
    {
        if (!tenantId.HasValue || !Code.HasValue)
        {
            recentAuditLogs = [];
            return;
        }

        recentAuditLogs = await AuditLogService.GetRecentAsync(
            limit: 15,
            tenantId: tenantId.Value,
            entityName: "Proveedor",
            entityId: Code.Value.ToString());
    }

    private string FormatPaymentMethodSummary(ProveedorCatalogOptionDto option)
    {
        var fragments = new List<string>();

        if (option.NumberOfPayments.HasValue)
        {
            fragments.Add($"{option.NumberOfPayments.Value} {L("pagos", "pagaments", "payments")}");
        }

        if (option.PaymentDays.HasValue)
        {
            fragments.Add($"{option.PaymentDays.Value} {L("días", "dies", "days")}");
        }

        if (option.FirstPaymentDays.HasValue)
        {
            fragments.Add($"{L("1er vencimiento", "1r venciment", "1st due date")} {option.FirstPaymentDays.Value} {L("días", "dies", "days")}");
        }

        return fragments.Count == 0
            ? L("Sin detalle legacy adicional.", "Sense detall legacy addicional.", "No additional legacy detail.")
            : string.Join(" · ", fragments);
    }

    private static string FormatPercent(decimal? value)
    {
        return value.HasValue ? $"{value.Value.ToUiString("0.##")}%" : "-";
    }

    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };
}
