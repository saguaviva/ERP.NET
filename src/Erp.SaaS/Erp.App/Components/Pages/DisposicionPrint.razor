@page "/articulos/disposiciones/{Code:int}/imprimir"
@layout EmptyLayout
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDisposicionQueries DisposicionQueries
@inject AppText T

<PageTitle>@($"{L("Ficha disposición", "Fitxa disposició", "Disposition sheet")} {Code}")</PageTitle>

<div class="document-shell">
    <div class="document-toolbar no-print">
        <a class="secondary-button link-button" href="/articulos/disposiciones/editar/@Code">@L("Volver a la disposición", "Tornar a la disposició", "Back to disposition")</a>
        <button class="primary-button" type="button" onclick="window.print()">@L("Imprimir / guardar PDF", "Imprimir / desar PDF", "Print / save PDF")</button>
    </div>

    @if (!tenantId.HasValue || !companyId.HasValue)
    {
        <div class="empty-state document-state">
            <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger document-state">@errorMessage</div>
    }
    else if (detail is null)
    {
        <div class="empty-state document-state">
            <p>@L("No se ha encontrado la disposición solicitada.", "No s'ha trobat la disposició sol·licitada.", "The requested disposition could not be found.")</p>
        </div>
    }
    else
    {
        <section class="document-page">
            <header class="document-header">
                <div>
                    <p class="eyebrow">@L("Disposición", "Disposició", "Disposition")</p>
                    <h1>@VisibleNumber</h1>
                    <p class="muted">@L("Color", "Color", "Color") @DisplayValue(detail.Color) · @L("Comanda", "Comanda", "Order ref.") @DisplayValue(detail.OrderReference)</p>
                </div>
                <div class="document-header-meta">
                    <div>
                        <span class="muted">@L("Fecha", "Data", "Date")</span>
                        <strong>@FormatDate(detail.Date)</strong>
                    </div>
                    <div>
                        <span class="muted">@L("Recepción", "Recepció", "Receipt")</span>
                        <strong>@FormatDate(detail.ReceptionDate)</strong>
                    </div>
                    <div>
                        <span class="muted">@L("Estado", "Estat", "Status")</span>
                        <strong>@StatusLabel</strong>
                    </div>
                </div>
            </header>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>@L("Cabecera", "Capçalera", "Header")</h2>
                        <div class="document-kv-grid">
                            <div><span class="muted">@L("Cliente", "Client", "Customer")</span><strong>@DisplayClient</strong></div>
                            <div><span class="muted">@L("Acabador", "Acabador", "Finisher")</span><strong>@DisplayFinisher</strong></div>
                            <div><span class="muted">@L("Código cliente", "Codi client", "Customer code")</span><strong>@DisplayValue(detail.ClientReferenceCode)</strong></div>
                            <div><span class="muted">@L("Color cliente", "Color client", "Customer color")</span><strong>@DisplayValue(detail.ClientColor)</strong></div>
                            <div><span class="muted">@L("Origen", "Origen", "Origin")</span><strong>@DisplayValue(detail.Origin)</strong></div>
                            <div><span class="muted">@L("Centro", "Centre", "Center")</span><strong>@DisplayValue(detail.CompanyCenterCode)</strong></div>
                        </div>
                    </section>
                    <section class="document-box">
                        <h2>@L("Totales", "Totals", "Totals")</h2>
                        <div class="document-kv-grid">
                            <div><span class="muted">@L("Piezas", "Peces", "Pieces")</span><strong>@detail.TotalPieces.ToUiString("0.##")</strong></div>
                            <div><span class="muted">Kg</span><strong>@detail.TotalKilograms.ToUiString("0.##")</strong></div>
                            <div><span class="muted">@L("Líneas", "Línies", "Lines")</span><strong>@detail.Lines.Count</strong></div>
                        </div>
                    </section>
                </div>
            </section>

            <section class="document-section">
                <h2>@L("Detalle de líneas", "Detall de línies", "Line items")</h2>
                <table class="data-table document-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@L("Descripción", "Descripció", "Description")</th>
                            <th>@L("Tejedor", "Teixidor", "Weaver")</th>
                            <th>@L("Alb.", "Alb.", "Ship.")</th>
                            <th>@L("Tejido", "Teixit", "Fabric")</th>
                            <th>@L("Piezas", "Peces", "Pieces")</th>
                            <th>Kg</th>
                            <th>@L("Acabado", "Acabat", "Finish")</th>
                            <th>@L("Estado", "Estat", "Status")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in detail.Lines.OrderBy(item => item.LineNumber))
                        {
                            <tr>
                                <td>@line.LineNumber</td>
                                <td>@DisplayValue(line.Description)</td>
                                <td>@(line.WeaverCode > 0 ? line.WeaverCode.ToString() : "-")</td>
                                <td>@DisplayValue(line.DeliveryNoteNumber)</td>
                                <td>@DisplayValue(line.FabricCode)</td>
                                <td>@line.TotalPieces.ToUiString("0.##")</td>
                                <td>@line.TotalKilograms.ToUiString("0.##")</td>
                                <td>@DisplayValue(line.FinishText)</td>
                                <td>@BuildLineStatus(line)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>

            <section class="document-section">
                <div class="document-grid-two">
                    <section class="document-box">
                        <h2>@L("Observaciones", "Observacions", "Notes")</h2>
                        <p>@(string.IsNullOrWhiteSpace(detail.Notes) ? L("Sin observaciones registradas.", "Sense observacions registrades.", "No remarks recorded.") : detail.Notes)</p>
                    </section>
                    <section class="document-box">
                        <h2>@L("Movimientos de stock activos", "Moviments d'estoc actius", "Active stock movements")</h2>
                        @if (ActiveMovementSummaries.Count == 0)
                        {
                            <p>@L("Sin movimientos activos.", "Sense moviments actius.", "No active movements.")</p>
                        }
                        else
                        {
                            <ul class="document-list">
                                @foreach (var item in ActiveMovementSummaries)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }
                    </section>
                </div>
            </section>
        </section>
    }
</div>

@code {
    [Parameter]
    public int Code { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private DisposicionDetailDto? detail;
    private string errorMessage = string.Empty;

    private string VisibleNumber => detail is null ? Code.ToString() : FormatVisibleNumber(detail.Number, detail.Year);
    private string StatusLabel => detail is null ? string.Empty : detail.IsCancelled ? L("Anulada", "Anul·lada", "Cancelled") : detail.IsReceived ? L("Recibida", "Rebuda", "Received") : L("Pendiente", "Pendent", "Pending");
    private string DisplayClient => detail is null ? "-" : string.IsNullOrWhiteSpace(detail.ClientName) ? (detail.ClientCode > 0 ? detail.ClientCode.ToString() : "-") : $"{detail.ClientCode} · {detail.ClientName}";
    private string DisplayFinisher => detail is null ? "-" : string.IsNullOrWhiteSpace(detail.FinisherName) ? (detail.FinisherCode > 0 ? detail.FinisherCode.ToString() : "-") : $"{detail.FinisherCode} · {detail.FinisherName}";
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    private IReadOnlyList<string> ActiveMovementSummaries =>
        detail is null
            ? []
            : detail.Lines
                .OrderBy(item => item.LineNumber)
                .SelectMany(BuildActiveMovementLines)
                .ToList();

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        try
        {
            errorMessage = string.Empty;
            detail = await DisposicionQueries.GetByCodeAsync(tenantId.Value, companyId.Value, Code);
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            detail = null;
        }
    }

    private IEnumerable<string> BuildActiveMovementLines(DisposicionLineDto line)
    {
        if (string.IsNullOrWhiteSpace(line.FabricCode) || line.TotalKilograms <= 0)
        {
            yield break;
        }

        var meters = CalculateMeters(line.TotalKilograms, line.Yield);
        if (line.IsDisposed)
        {
            yield return $"{L("Línea", "Línia", "Line")} {line.LineNumber.ToUiString("N0")}: {L("crudo", "cru", "raw")} -> {L("dispuesto", "disposat", "prepared")} · {line.FabricCode} · {line.TotalKilograms.ToUiString("0.##")} kg · {meters.ToUiString("0.##")} m";
        }

        if (line.IsServed)
        {
            yield return $"{L("Línea", "Línia", "Line")} {line.LineNumber.ToUiString("N0")}: {L("dispuesto", "disposat", "prepared")} -> {L("color", "color", "color")} · {line.FabricCode} · {DisplayValue(detail?.Color)} · {meters.ToUiString("0.##")} m";
        }
    }

    private string BuildLineStatus(DisposicionLineDto line) =>
        line.IsServed ? L("Servido", "Servit", "Served") : line.IsDisposed ? L("Dispuesto", "Disposat", "Prepared") : L("Pendiente", "Pendent", "Pending");

    private static decimal CalculateMeters(decimal kilograms, decimal yield)
    {
        var effectiveYield = yield == 0 ? 1m : yield;
        return Math.Round(kilograms * effectiveYield, 2, MidpointRounding.AwayFromZero);
    }

    private static string DisplayValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string FormatVisibleNumber(int number, string year) => string.IsNullOrWhiteSpace(year) ? number.ToString() : $"{number}-{year}";
    private static string FormatDate(DateTime? value) => value?.ToString("dd/MM/yyyy") ?? "-";
}
