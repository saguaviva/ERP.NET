@page "/crm/clientes/nuevo"
@page "/crm/clientes/editar/{Code:int}"
@attribute [Authorize(Roles = "TenantAdmin")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuditLogService AuditLogService
@inject IClienteQueries ClienteQueries
@inject IClienteService ClienteService
@inject ILegacySyncService LegacySyncService
@inject NavigationManager NavigationManager
@inject AppText T

<PageTitle>@(Code.HasValue
    ? L("Editar cliente", "Editar client", "Edit client")
    : L("Nuevo cliente", "Nou client", "New client"))</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">CRM</p>
        <h1>@(Code.HasValue
            ? $"{L("Editar cliente", "Editar client", "Edit client")} {Code}"
            : L("Nuevo cliente", "Nou client", "New client"))</h1>
        <p class="lead">@(isLegacySyncActive
            ? L("Alta y edición sobre la réplica SaaS local. La sincronización manual solo refresca los registros que sigan siendo de origen legacy.",
                "Alta i edició sobre la rèplica SaaS local. La sincronització manual només refresca els registres que continuen sent d'origen legacy.",
                "Create and edit data on the local SaaS replica. Manual sync only refreshes records that still remain legacy-origin.")
            : L("Alta y edición sobre la tabla clients replicada en la SaaS local, filtrada por la empresa activa.",
                "Alta i edició sobre la taula clients replicada a la SaaS local, filtrada per l'empresa activa.",
                "Create and edit data on the SaaS-local replicated clients table, filtered by the active company."))</p>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
    }

    @if (isLegacySyncActive)
    {
        <div class="alert">
            @L("CRM / Clientes está en convivencia con legacy para esta empresa.", "CRM / Clients està en convivència amb legacy per a aquesta empresa.", "CRM / Clients is running in coexistence with legacy for this company.")
            @L("Esta ficha sigue siendo editable en local. Si modificas un cliente importado, pasará a tratarse como registro local y la sync manual ya no lo sobreescribirá.",
                "Aquesta fitxa continua sent editable en local. Si modifiques un client importat, passarà a tractar-se com a registre local i la sync manual ja no el sobreescriurà.",
                "This record remains editable locally. If you modify an imported client, it will become a local record and manual sync will no longer overwrite it.")
            @if (!string.IsNullOrWhiteSpace(syncStatusLabel))
            {
                <span>@syncStatusLabel</span>
            }
        </div>
    }

    @if (duplicates.Count > 0)
    {
        <section class="panel" style="margin-bottom: 1rem;">
            <h2>@L("Posibles duplicados", "Possibles duplicats", "Possible duplicates")</h2>
            <div class="list-block">
                @foreach (var duplicate in duplicates)
                {
                    <article class="list-item">
                        <strong>
                            @L("Cliente", "Client", "Client") @duplicate.Code · @duplicate.Name
                            @if (duplicate.IsHardConflict)
                            {
                                <span> · @L("conflicto duro", "conflicte dur", "hard conflict")</span>
                            }
                        </strong>
                        <span>@string.Join(", ", duplicate.MatchReasons)</span>
                        <span>@duplicate.TaxId · @duplicate.City · @FirstNonEmpty(duplicate.PrimaryEmail, duplicate.SecondaryEmail, duplicate.Phone)</span>
                        @if (!string.IsNullOrWhiteSpace(duplicate.ReviewStatus))
                        {
                            <span>@FormatDuplicateReview(duplicate)</span>
                        }
                        @if (Code.HasValue)
                        {
                            <div class="quick-links">
                                <button class="secondary-button" type="button" @onclick="() => SetDuplicateReviewAsync(duplicate, ClienteDuplicateReviewStatus.Reviewed)">@L("Marcar revisado", "Marcar revisat", "Mark reviewed")</button>
                                <button class="secondary-button" type="button" @onclick="() => SetDuplicateReviewAsync(duplicate, ClienteDuplicateReviewStatus.FalsePositive)">@L("Falso positivo", "Fals positiu", "False positive")</button>
                                @if (!string.IsNullOrWhiteSpace(duplicate.ReviewStatus))
                                {
                                    <button class="secondary-button" type="button" @onclick="() => ClearDuplicateReviewAsync(duplicate)">@L("Quitar marca", "Treure marca", "Remove mark")</button>
                                }
                            </div>
                        }
                        <a class="inline-link" href="/crm/clientes/editar/@duplicate.Code">@L("Abrir cliente", "Obrir client", "Open client")</a>
                    </article>
                }
            </div>
        </section>
    }

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <fieldset>
        <div class="form-grid">
            <label class="field">
                <span>@L("Nombre", "Nom", "Name")</span>
                <InputText class="text-input" @bind-Value="model.Name" />
            </label>
            <label class="field">
                <span>@L("NIF", "NIF", "Tax ID")</span>
                <InputText class="text-input" @bind-Value="model.TaxId" />
            </label>
            <label class="field">
                <span>@L("Contacto", "Contacte", "Contact")</span>
                <InputText class="text-input" @bind-Value="model.ContactName" />
            </label>
            <label class="field">
                <span>@L("Teléfono", "Telèfon", "Phone")</span>
                <InputText class="text-input" @bind-Value="model.Phone" />
            </label>
            <label class="field wide">
                <span>@L("Dirección", "Adreça", "Address")</span>
                <InputText class="text-input" @bind-Value="model.Address" />
            </label>
            <label class="field">
                <span>@L("Código postal", "Codi postal", "Postal code")</span>
                <InputText class="text-input" @bind-Value="model.PostalCode" />
            </label>
            <label class="field">
                <span>@L("Ciudad", "Ciutat", "City")</span>
                <InputText class="text-input" @bind-Value="model.City" />
            </label>
            <label class="field">
                <span>@L("Provincia", "Província", "Province")</span>
                <InputText class="text-input" @bind-Value="model.Province" />
            </label>
            <label class="field">
                <span>@L("País", "País", "Country")</span>
                <InputText class="text-input" @bind-Value="model.Country" />
            </label>
            <label class="field">
                <span>@L("Email principal", "Email principal", "Primary email")</span>
                <InputText class="text-input" @bind-Value="model.PrimaryEmail" />
            </label>
            <label class="field">
                <span>@L("Email secundario", "Email secundari", "Secondary email")</span>
                <InputText class="text-input" @bind-Value="model.SecondaryEmail" />
            </label>
            <label class="field">
                <span>@L("Fax", "Fax", "Fax")</span>
                <InputText class="text-input" @bind-Value="model.Fax" />
            </label>
            <label class="field wide">
                <span>@L("Web", "Web", "Website")</span>
                <InputText class="text-input" @bind-Value="model.Website" />
            </label>
            <label class="field wide">
                <span>@L("Notas", "Notes", "Notes")</span>
                <InputTextArea class="text-area" @bind-Value="model.Notes" />
            </label>
            <label class="checkbox-field">
                <InputCheckbox @bind-Value="model.IsBlocked" />
                <span>@L("Cliente bloqueado", "Client bloquejat", "Blocked client")</span>
            </label>
        </div>

        <section class="panel" style="margin-bottom: 1rem;">
            <div class="page-header" style="margin-bottom: 1rem;">
                <div>
                    <h2>@L("Direcciones secundarias", "Adreces secundàries", "Secondary addresses")</h2>
                    <p class="lead">@L("Direcciones de envio y contactos adicionales del cliente.", "Adreces d'enviament i contactes addicionals del client.", "Shipping addresses and additional client contacts.")</p>
                </div>
                <div class="quick-links">
                    <button class="secondary-button" type="button" @onclick="AddSecondaryAddress">@L("Añadir dirección", "Afegir adreça", "Add address")</button>
                </div>
            </div>

            @if (model.SecondaryAddresses.Count == 0)
            {
                <p class="muted">@L("Todavía no hay direcciones secundarias para este cliente.", "Encara no hi ha adreces secundàries per a aquest client.", "There are no secondary addresses for this client yet.")</p>
            }
            else
            {
                @for (var index = 0; index < model.SecondaryAddresses.Count; index++)
                {
                    var address = model.SecondaryAddresses[index];

                    <article class="panel comparison-panel" style="margin-bottom: 1rem;">
                        <div class="page-header" style="margin-bottom: 1rem;">
                            <div>
                                <p class="eyebrow">@L("Dirección secundaria", "Adreça secundària", "Secondary address") @(index + 1)</p>
                                <h2>@GetSecondaryAddressTitle(address, index)</h2>
                            </div>
                            <div class="quick-links">
                                <button class="secondary-button" type="button" @onclick="() => RemoveSecondaryAddress(index)">@L("Quitar", "Treure", "Remove")</button>
                            </div>
                        </div>

                        <div class="form-grid">
                            <label class="field">
                                <span>@L("Nombre / consignatario", "Nom / consignatari", "Name / consignee")</span>
                                <InputText class="text-input" @bind-Value="address.Name" />
                            </label>
                            <label class="field">
                                <span>@L("Contacto", "Contacte", "Contact")</span>
                                <InputText class="text-input" @bind-Value="address.ContactName" />
                            </label>
                            <label class="field wide">
                                <span>@L("Dirección", "Adreça", "Address")</span>
                                <InputText class="text-input" @bind-Value="address.Address" />
                            </label>
                            <label class="field">
                                <span>@L("Código postal", "Codi postal", "Postal code")</span>
                                <InputText class="text-input" @bind-Value="address.PostalCode" />
                            </label>
                            <label class="field">
                                <span>@L("Ciudad", "Ciutat", "City")</span>
                                <InputText class="text-input" @bind-Value="address.City" />
                            </label>
                            <label class="field">
                                <span>@L("Provincia", "Província", "Province")</span>
                                <InputText class="text-input" @bind-Value="address.Province" />
                            </label>
                            <label class="field">
                                <span>@L("País", "País", "Country")</span>
                                <InputText class="text-input" @bind-Value="address.Country" />
                            </label>
                            <label class="field">
                                <span>@L("Teléfono", "Telèfon", "Phone")</span>
                                <InputText class="text-input" @bind-Value="address.Phone" />
                            </label>
                            <label class="field">
                                <span>@L("Fax", "Fax", "Fax")</span>
                                <InputText class="text-input" @bind-Value="address.Fax" />
                            </label>
                        </div>
                    </article>
                }
            }
        </section>

        <section class="panel" style="margin-bottom: 1rem;">
            <div class="page-header" style="margin-bottom: 1rem;">
                <div>
                    <h2>@L("Contactos del cliente", "Contactes del client", "Client contacts")</h2>
                    <p class="lead">@L("Agenda comercial y operativa asociada a este cliente.", "Agenda comercial i operativa associada a aquest client.", "Commercial and operational agenda linked to this client.")</p>
                </div>
                <div class="quick-links">
                    <button class="secondary-button" type="button" @onclick="AddContact">@L("Añadir contacto", "Afegir contacte", "Add contact")</button>
                </div>
            </div>

            @if (model.Contacts.Count == 0)
            {
                <p class="muted">@L("Todavía no hay contactos adicionales para este cliente.", "Encara no hi ha contactes addicionals per a aquest client.", "There are no additional contacts for this client yet.")</p>
            }
            else
            {
                @for (var index = 0; index < model.Contacts.Count; index++)
                {
                    var contact = model.Contacts[index];

                    <article class="panel comparison-panel" style="margin-bottom: 1rem;">
                        <div class="page-header" style="margin-bottom: 1rem;">
                            <div>
                                <p class="eyebrow">@L("Contacto", "Contacte", "Contact") @(index + 1)</p>
                                <h2>@GetContactTitle(contact, index)</h2>
                            </div>
                            <div class="quick-links">
                                <button class="secondary-button" type="button" @onclick="() => RemoveContact(index)">@L("Quitar", "Treure", "Remove")</button>
                            </div>
                        </div>

                        <div class="form-grid">
                            <label class="field">
                                <span>@L("Nombre", "Nom", "Name")</span>
                                <InputText class="text-input" @bind-Value="contact.Name" />
                            </label>
                            <label class="field">
                                <span>@L("Cargo", "Càrrec", "Role")</span>
                                <InputText class="text-input" @bind-Value="contact.Role" />
                            </label>
                            <label class="field">
                                <span>@L("Email", "Email", "Email")</span>
                                <InputText class="text-input" @bind-Value="contact.Email" />
                            </label>
                            <label class="field">
                                <span>@L("Telefono", "Telèfon", "Phone")</span>
                                <InputText class="text-input" @bind-Value="contact.Phone" />
                            </label>
                            <label class="field wide">
                                <span>@L("Notas", "Notes", "Notes")</span>
                                <InputTextArea class="text-area" @bind-Value="contact.Notes" />
                            </label>
                            <label class="checkbox-field">
                                <InputCheckbox Value="contact.IsPrimary"
                                               ValueChanged="value => SetPrimaryContact(index, value)"
                                               ValueExpression="() => contact.IsPrimary" />
                                <span>@L("Contacto principal", "Contacte principal", "Primary contact")</span>
                            </label>
                        </div>
                    </article>
                }
            }
        </section>

        <div class="form-actions">
            <button class="primary-button" type="submit">@L("Guardar", "Desar", "Save")</button>
            <button class="secondary-button" type="button" @onclick="CheckDuplicatesAsync">@L("Comprobar duplicados", "Comprovar duplicats", "Check duplicates")</button>
            @if (Code.HasValue)
            {
                <button class="secondary-button danger" type="button" @onclick="DeleteAsync">@L("Eliminar cliente", "Eliminar client", "Delete client")</button>
            }
            <a class="secondary-button link-button" href="/crm/clientes">@L("Volver al listado", "Tornar al llistat", "Back to list")</a>
        </div>
        </fieldset>
    </EditForm>

    @if (auditLogs.Count > 0)
    {
        <section class="panel" style="margin-top: 1rem;">
            <h2>@L("Historial reciente del cliente", "Historial recent del client", "Recent client history")</h2>
            <div class="list-block">
                @foreach (var entry in auditLogs)
                {
                    <article class="list-item">
                        <strong>@entry.Action</strong>
                        <span>@FormatAuditActor(entry)</span>
                        @if (!string.IsNullOrWhiteSpace(entry.Details))
                        {
                            <span>@entry.Details</span>
                        }
                        <span>@entry.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                    </article>
                }
            </div>
        </section>
    }
}

@code {
    [Parameter]
    public int? Code { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private SaveClienteCommand model = new();
    private IReadOnlyCollection<AuditLogEntryDto> auditLogs = [];
    private IReadOnlyCollection<ClienteDuplicateDto> duplicates = [];
    private string statusMessage = string.Empty;
    private bool isError;
    private bool isLegacySyncActive;
    private string syncStatusLabel = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();

        if (tenantId.HasValue)
        {
            model.TenantId = tenantId.Value;
        }

        if (companyId.HasValue)
        {
            model.CompanyId = companyId.Value;
        }

        await LoadSyncStatusAsync();

        if (Code.HasValue && tenantId.HasValue && companyId.HasValue)
        {
            var existing = await ClienteQueries.GetByCodeAsync(tenantId.Value, companyId.Value, Code.Value);
            if (existing is not null)
            {
                model = new SaveClienteCommand
                {
                    TenantId = tenantId.Value,
                    CompanyId = companyId.Value,
                    Code = existing.Code,
                    Name = existing.Name,
                    TaxId = existing.TaxId,
                    Address = existing.Address,
                    PostalCode = existing.PostalCode,
                    City = existing.City,
                    Province = existing.Province,
                    Country = existing.Country,
                    ContactName = existing.ContactName,
                    Phone = existing.Phone,
                    Fax = existing.Fax,
                    PrimaryEmail = existing.PrimaryEmail,
                    SecondaryEmail = existing.SecondaryEmail,
                    Website = existing.Website,
                    Notes = existing.Notes,
                    IsBlocked = existing.IsBlocked,
                    SecondaryAddresses = existing.SecondaryAddresses
                        .Select(address => new ClienteSecondaryAddressDto
                        {
                            OriginalAddress = address.OriginalAddress,
                            Name = address.Name,
                            ContactName = address.ContactName,
                            Address = address.Address,
                            PostalCode = address.PostalCode,
                            City = address.City,
                            Province = address.Province,
                            Country = address.Country,
                            Phone = address.Phone,
                            Fax = address.Fax
                        })
                        .ToList(),
                    Contacts = existing.Contacts
                        .Select(contact => new ClienteContactDto
                        {
                            Id = contact.Id,
                            Name = contact.Name,
                            Role = contact.Role,
                            Email = contact.Email,
                            Phone = contact.Phone,
                            Notes = contact.Notes,
                            IsPrimary = contact.IsPrimary
                        })
                        .ToList()
                };

                await LoadAuditAsync(existing.Code);
                await LoadDuplicatesAsync();
            }
        }
    }

    private async Task SaveAsync()
    {
        statusMessage = string.Empty;
        isError = false;

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            statusMessage = L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.");
            isError = true;
            return;
        }

        try
        {
            model.TenantId = tenantId.Value;
            model.CompanyId = companyId.Value;
            await LoadDuplicatesAsync();
            var code = await ClienteService.SaveAsync(model);
            Code = code;
            await LoadAuditAsync(code);
            NavigationManager.NavigateTo($"/crm/clientes/editar/{code}", forceLoad: true);
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private async Task DeleteAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !Code.HasValue)
        {
            return;
        }

        try
        {
            await ClienteService.DeleteAsync(tenantId.Value, companyId.Value, Code.Value);
            NavigationManager.NavigateTo("/crm/clientes", forceLoad: false);
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private async Task LoadSyncStatusAsync()
    {
        isLegacySyncActive = false;
        syncStatusLabel = string.Empty;

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var status = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
            .FirstOrDefault(item =>
                item.CompanyId == companyId.Value &&
                string.Equals(item.ModuleKey, LegacySyncModuleKeys.CrmClients, StringComparison.OrdinalIgnoreCase));

        if (status is null || !status.HasSuccessfulSync)
        {
            return;
        }

        isLegacySyncActive = true;
        syncStatusLabel = status.LastCompletedUtc.HasValue
            ? $"{L("Última sync", "Última sync", "Last sync")}: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Act: {status.LastUpdated} · Omi: {status.LastSkipped} · Err: {status.LastErrors}"
            : $"{L("Estado", "Estat", "Status")}: {status.LastStatus}";
    }

    private async Task CheckDuplicatesAsync()
    {
        statusMessage = string.Empty;
        isError = false;

        try
        {
            await LoadDuplicatesAsync();
            statusMessage = duplicates.Count == 0
                ? L("No se han encontrado duplicados relevantes.", "No s'han trobat duplicats rellevants.", "No relevant duplicates were found.")
                : L("Se han encontrado posibles duplicados. Revísalos antes de guardar.", "S'han trobat possibles duplicats. Revisa'ls abans de desar.", "Possible duplicates were found. Review them before saving.");
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private async Task SetDuplicateReviewAsync(ClienteDuplicateDto duplicate, string status)
    {
        if (!tenantId.HasValue || !companyId.HasValue || !Code.HasValue)
        {
            return;
        }

        statusMessage = string.Empty;
        isError = false;

        try
        {
            await ClienteService.SetDuplicateReviewAsync(new SetClienteDuplicateReviewCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                ClientCode = Code.Value,
                DuplicateClientCode = duplicate.Code,
                Status = status
            });

            await LoadDuplicatesAsync();
            statusMessage = status == ClienteDuplicateReviewStatus.FalsePositive
                ? L("Duplicado marcado como falso positivo.", "Duplicat marcat com a fals positiu.", "Duplicate marked as false positive.")
                : L("Duplicado marcado como revisado.", "Duplicat marcat com a revisat.", "Duplicate marked as reviewed.");
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private async Task ClearDuplicateReviewAsync(ClienteDuplicateDto duplicate)
    {
        if (!tenantId.HasValue || !companyId.HasValue || !Code.HasValue)
        {
            return;
        }

        statusMessage = string.Empty;
        isError = false;

        try
        {
            await ClienteService.SetDuplicateReviewAsync(new SetClienteDuplicateReviewCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                ClientCode = Code.Value,
                DuplicateClientCode = duplicate.Code,
                Status = null
            });

            await LoadDuplicatesAsync();
            statusMessage = L("Marca de revisión eliminada.", "Marca de revisió eliminada.", "Review mark removed.");
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private async Task LoadAuditAsync(int? code)
    {
        if (!tenantId.HasValue || !companyId.HasValue || !code.HasValue)
        {
            auditLogs = [];
            return;
        }

        auditLogs = await AuditLogService.GetRecentAsync(
            limit: 10,
            tenantId: tenantId.Value,
            companyId: companyId.Value,
            entityName: "Cliente",
            entityId: code.Value.ToString());
    }

    private async Task LoadDuplicatesAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            duplicates = [];
            return;
        }

        model.TenantId = tenantId.Value;
        model.CompanyId = companyId.Value;
        duplicates = await ClienteQueries.FindDuplicatesAsync(tenantId.Value, companyId.Value, model);
    }

    private string FormatAuditActor(AuditLogEntryDto entry)
    {
        if (!string.IsNullOrWhiteSpace(entry.ActorDisplayName) && !string.IsNullOrWhiteSpace(entry.ActorEmail))
        {
            return $"{entry.ActorDisplayName} · {entry.ActorEmail}";
        }

        if (!string.IsNullOrWhiteSpace(entry.ActorDisplayName))
        {
            return entry.ActorDisplayName;
        }

        if (!string.IsNullOrWhiteSpace(entry.ActorEmail))
        {
            return entry.ActorEmail;
        }

        return L("Actor no disponible", "Actor no disponible", "Actor unavailable");
    }

    private static string FirstNonEmpty(params string[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

    private void AddSecondaryAddress()
    {
        model.SecondaryAddresses.Add(new ClienteSecondaryAddressDto());
    }

    private void RemoveSecondaryAddress(int index)
    {
        if (index < 0 || index >= model.SecondaryAddresses.Count)
        {
            return;
        }

        model.SecondaryAddresses.RemoveAt(index);
    }

    private string GetSecondaryAddressTitle(ClienteSecondaryAddressDto address, int index)
    {
        if (!string.IsNullOrWhiteSpace(address.Name))
        {
            return address.Name;
        }

        if (!string.IsNullOrWhiteSpace(address.Address))
        {
            return address.Address;
        }

        return $"{L("Dirección", "Adreça", "Address")} {index + 1}";
    }

    private void AddContact()
    {
        model.Contacts.Add(new ClienteContactDto
        {
            IsPrimary = model.Contacts.Count == 0
        });
    }

    private void RemoveContact(int index)
    {
        if (index < 0 || index >= model.Contacts.Count)
        {
            return;
        }

        model.Contacts.RemoveAt(index);
    }

    private string GetContactTitle(ClienteContactDto contact, int index)
    {
        if (!string.IsNullOrWhiteSpace(contact.Name))
        {
            return contact.Name;
        }

        if (!string.IsNullOrWhiteSpace(contact.Email))
        {
            return contact.Email;
        }

        return $"{L("Contacto", "Contacte", "Contact")} {index + 1}";
    }

    private void SetPrimaryContact(int index, bool isPrimary)
    {
        if (index < 0 || index >= model.Contacts.Count)
        {
            return;
        }

        if (!isPrimary)
        {
            model.Contacts[index].IsPrimary = false;
            return;
        }

        for (var contactIndex = 0; contactIndex < model.Contacts.Count; contactIndex++)
        {
            model.Contacts[contactIndex].IsPrimary = contactIndex == index;
        }
    }

    private string FormatDuplicateReview(ClienteDuplicateDto duplicate)
    {
        var status = string.Equals(duplicate.ReviewStatus, ClienteDuplicateReviewStatus.FalsePositive, StringComparison.OrdinalIgnoreCase)
            ? L("Falso positivo", "Fals positiu", "False positive")
            : L("Revisado", "Revisat", "Reviewed");

        if (duplicate.ReviewUpdatedUtc.HasValue && !string.IsNullOrWhiteSpace(duplicate.ReviewUpdatedBy))
        {
            return $"{status} {L("por", "per", "by")} {duplicate.ReviewUpdatedBy} · {duplicate.ReviewUpdatedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss}";
        }

        if (duplicate.ReviewUpdatedUtc.HasValue)
        {
            return $"{status} · {duplicate.ReviewUpdatedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss}";
        }

        return status;
    }

    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };
}
