@page "/compras/facturas"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IPurchaseInvoiceQueries PurchaseInvoiceQueries
@inject AppText T

<PageTitle>@L("Compras / Facturas", "Compres / Factures", "Purchases / Invoices")</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@T["menu.purchases"]</p>
        <h1>@L("Facturas de proveedor", "Factures de proveïdor", "Supplier invoices")</h1>
        <p class="lead">@L("Registro de facturas recibidas, con trazabilidad hacia proveedor, pedido y recepciones enlazadas.", "Registre de factures rebudes, amb traçabilitat cap a proveïdor, comanda i recepcions enllaçades.", "Received invoice register with traceability to supplier, order and linked receipts.")</p>
    </div>
    <div class="quick-links">
        <a class="primary-button link-button" href="/compras/facturas/nueva">@L("Nueva factura", "Nova factura", "New invoice")</a>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("Selecciona una empresa activa para revisar las facturas de proveedor.", "Selecciona una empresa activa per revisar les factures de proveïdor.", "Select an active company to review supplier invoices.")</p>
    </div>
}
else
{
    <section class="panel">
        <div class="filter-row">
            <input class="text-input" @bind="filter.Search" placeholder="@L("Buscar por factura, proveedor, referencia o notas", "Buscar per factura, proveïdor, referència o notes", "Search by invoice, supplier, reference or notes")" disabled="@isLoading" />
            <select class="sidebar-select compact-select" @bind="filter.Status" disabled="@isLoading">
                <option value="">@L("Todos los estados", "Tots els estats", "All statuses")</option>
                @foreach (var status in PurchaseInvoiceStatuses.All)
                {
                    <option value="@status">@FormatStatus(status)</option>
                }
            </select>
            <label class="inline-checkbox">
                <input type="checkbox" @bind="filter.IncludeClosed" disabled="@isLoading" />
                <span>@L("Incluir cerradas", "Incloure tancades", "Include closed")</span>
            </label>
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? L("Cargando...", "Carregant...", "Loading...") : L("Buscar", "Buscar", "Search"))</button>
        </div>
        <div class="filter-row results-toolbar" style="margin-top: 0.85rem;">
            <span class="results-summary">
                @(totalCount == 0
                    ? L("Sin resultados", "Sense resultats", "No results")
                    : L($"Mostrando {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} facturas", $"Mostrant {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} factures", $"Showing {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} of {totalCount.ToUiString("N0")} invoices"))
            </span>
            <label class="field compact-field">
                <span>@L("Tamaño de página", "Mida de pàgina", "Page size")</span>
                <select class="sidebar-select compact-select" value="@filter.PageSize" @onchange="OnPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)">
        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>@L("Cargando facturas de proveedor...", "Carregant factures de proveïdor...", "Loading supplier invoices...")</span>
            </div>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <SortableHeader Label="@L("Factura", "Factura", "Invoice")" IsActive="@(sortColumn == nameof(PurchaseInvoiceListItemDto.InvoiceNumber))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseInvoiceListItemDto.InvoiceNumber), true))" />
                    <SortableHeader Label="@L("Proveedor", "Proveïdor", "Supplier")" IsActive="@(sortColumn == nameof(PurchaseInvoiceListItemDto.SupplierName))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseInvoiceListItemDto.SupplierName)))" />
                    <SortableHeader Label="@L("Fecha", "Data", "Date")" IsActive="@(sortColumn == nameof(PurchaseInvoiceListItemDto.DocumentDate))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseInvoiceListItemDto.DocumentDate), true))" />
                    <SortableHeader Label="@L("Vencimiento", "Venciment", "Due date")" IsActive="@(sortColumn == nameof(PurchaseInvoiceListItemDto.DueDate))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseInvoiceListItemDto.DueDate), true))" />
                    <SortableHeader Label="@L("Estado", "Estat", "Status")" IsActive="@(sortColumn == nameof(PurchaseInvoiceListItemDto.Status))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseInvoiceListItemDto.Status)))" />
                    <th>@L("Conciliación", "Conciliació", "Reconciliation")</th>
                    <SortableHeader Label="@L("Recepciones", "Recepcions", "Receipts")" IsActive="@(sortColumn == nameof(PurchaseInvoiceListItemDto.ReceiptCount))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseInvoiceListItemDto.ReceiptCount), true))" />
                    <SortableHeader Label="@L("Pedidos", "Comandes", "Orders")" IsActive="@(sortColumn == nameof(PurchaseInvoiceListItemDto.OrderCount))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseInvoiceListItemDto.OrderCount), true))" />
                    <SortableHeader Label="@L("Total", "Total", "Total")" IsActive="@(sortColumn == nameof(PurchaseInvoiceListItemDto.TotalAmount))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(PurchaseInvoiceListItemDto.TotalAmount), true))" />
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    @for (var index = 0; index < 5; index++)
                    {
                        <tr class="table-skeleton-row">
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                        </tr>
                    }
                }
                else if (items.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="table-empty">@L("Todavía no hay facturas de proveedor registradas.", "Encara no hi ha factures de proveïdor registrades.", "There are no supplier invoices registered yet.")</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>
                                <div>@item.DisplayNumber</div>
                                <div class="table-subtitle">@DisplayValue(item.SupplierDocumentNumber)</div>
                            </td>
                            <td>@item.SupplierName</td>
                            <td>@item.DocumentDate.ToString("dd/MM/yyyy")</td>
                            <td>@(item.DueDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td><span class="status-pill @GetStatusClass(item.Status)">@FormatStatus(item.Status)</span></td>
                            <td>
                                <span class="status-pill @(item.IsReconciled ? "success" : "danger")">
                                    @(item.IsReconciled ? L("Cuadrada", "Quadrada", "Balanced") : L($"{item.ReconciliationDifferenceCount} dif.", $"{item.ReconciliationDifferenceCount} dif.", $"{item.ReconciliationDifferenceCount} dif."))
                                </span>
                                @if (!item.IsReconciled)
                                {
                                                <div class="table-subtitle">@L($"Base {item.ReconciliationDifferenceAmount.ToUiString("0.00")} €", $"Base {item.ReconciliationDifferenceAmount.ToUiString("0.00")} €", $"Base {item.ReconciliationDifferenceAmount.ToUiString("0.00")} €")</div>
                                }
                            </td>
                            <td>@item.ReceiptCount</td>
                            <td>@item.OrderCount</td>
                            <td>@item.TotalAmount.ToUiString("0.00") €</td>
                            <td>
                                <div class="table-actions">
                                    <a class="inline-link" href="/compras/facturas/editar/@item.InvoiceNumber">@L("Abrir", "Obrir", "Open")</a>
                                <a class="inline-link" href="/compras/facturas/@item.InvoiceNumber/pdf" target="_blank">@L("PDF", "PDF", "PDF")</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="pagination-bar">
            <span class="muted">@L($"Página {filter.Page} de {TotalPages}", $"Pàgina {filter.Page} de {TotalPages}", $"Page {filter.Page} of {TotalPages}")</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePageAsync(1)" disabled="@(!CanGoPrevious || isLoading)">@L("Primera", "Primera", "First")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page - 1)" disabled="@(!CanGoPrevious || isLoading)">@L("Anterior", "Anterior", "Previous")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page + 1)" disabled="@(!CanGoNext || isLoading)">@L("Siguiente", "Següent", "Next")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(TotalPages)" disabled="@(!CanGoNext || isLoading)">@L("Última", "Última", "Last")</button>
            </div>
        </div>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = "closed")]
    public bool? IncludeClosedQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? PageSizeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortQuery { get; set; }

    [SupplyParameterFromQuery(Name = "desc")]
    public bool? DescQuery { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool isLoading;
    private PurchaseInvoiceFilter filter = new() { Page = 1, PageSize = 25, SortColumn = nameof(PurchaseInvoiceListItemDto.InvoiceNumber), SortDescending = true };
    private IReadOnlyCollection<PurchaseInvoiceListItemDto> items = [];
    private string errorMessage = string.Empty;
    private string sortColumn = nameof(PurchaseInvoiceListItemDto.InvoiceNumber);
    private bool sortDescending = true;
    private int totalCount;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)filter.PageSize));
    private bool CanGoPrevious => filter.Page > 1;
    private bool CanGoNext => filter.Page < TotalPages;
    private int PageStart => totalCount == 0 ? 0 : ((filter.Page - 1) * filter.PageSize) + 1;
    private int PageEnd => totalCount == 0 ? 0 : Math.Min(filter.Page * filter.PageSize, totalCount);
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
    }

    protected override async Task OnParametersSetAsync()
    {
        ApplyQueryState();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        errorMessage = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            items = [];
            totalCount = 0;
            return;
        }

        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            filter.SortColumn = sortColumn;
            filter.SortDescending = sortDescending;
            var result = await PurchaseInvoiceQueries.SearchInvoicesAsync(tenantId.Value, companyId.Value, filter);
            items = result.Items;
            totalCount = result.TotalCount;
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            items = [];
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task SearchAsync()
    {
        filter.Page = 1;
        UpdateQueryState();
        return Task.CompletedTask;
    }

    private Task SetSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(sortColumn, column, StringComparison.Ordinal))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = defaultDescending;
        }

        filter.Page = 1;
        UpdateQueryState();
        return Task.CompletedTask;
    }

    private Task ChangePageAsync(int page)
    {
        var newPage = Math.Max(1, Math.Min(page, TotalPages));
        if (newPage == filter.Page)
        {
            return Task.CompletedTask;
        }

        filter.Page = newPage;
        UpdateQueryState();
        return Task.CompletedTask;
    }

    private Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return Task.CompletedTask;
        }

        filter.PageSize = pageSize;
        filter.Page = 1;
        UpdateQueryState();
        return Task.CompletedTask;
    }

    private void ApplyQueryState()
    {
        filter.Search = SearchQuery?.Trim() ?? string.Empty;
        filter.Status = NormalizeStatus(StatusQuery);
        filter.IncludeClosed = IncludeClosedQuery ?? false;
        filter.Page = Math.Max(PageQuery.GetValueOrDefault(1), 1);
        filter.PageSize = PageSizeQuery is 25 or 50 or 100 ? PageSizeQuery.Value : 25;
        sortColumn = NormalizeSortColumn(SortQuery);
        sortDescending = DescQuery ?? true;
        filter.SortColumn = sortColumn;
        filter.SortDescending = sortDescending;
    }

    private void UpdateQueryState()
    {
        var uri = NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(filter.Search) ? null : filter.Search,
            ["status"] = string.IsNullOrWhiteSpace(filter.Status) ? null : filter.Status,
            ["closed"] = filter.IncludeClosed ? true : null,
            ["page"] = filter.Page > 1 ? filter.Page : null,
            ["pageSize"] = filter.PageSize != 25 ? filter.PageSize : null,
            ["sort"] = string.Equals(sortColumn, nameof(PurchaseInvoiceListItemDto.InvoiceNumber), StringComparison.Ordinal) ? null : sortColumn,
            ["desc"] = sortDescending ? null : false
        });
        NavigationManager.NavigateTo(uri, replace: true);
    }

    private static string NormalizeStatus(string? status) =>
        PurchaseInvoiceStatuses.All.Contains(status ?? string.Empty, StringComparer.OrdinalIgnoreCase)
            ? status!.Trim()
            : string.Empty;

    private static string NormalizeSortColumn(string? column) => column switch
    {
        nameof(PurchaseInvoiceListItemDto.SupplierName) => nameof(PurchaseInvoiceListItemDto.SupplierName),
        nameof(PurchaseInvoiceListItemDto.DocumentDate) => nameof(PurchaseInvoiceListItemDto.DocumentDate),
        nameof(PurchaseInvoiceListItemDto.DueDate) => nameof(PurchaseInvoiceListItemDto.DueDate),
        nameof(PurchaseInvoiceListItemDto.Status) => nameof(PurchaseInvoiceListItemDto.Status),
        nameof(PurchaseInvoiceListItemDto.ReceiptCount) => nameof(PurchaseInvoiceListItemDto.ReceiptCount),
        nameof(PurchaseInvoiceListItemDto.OrderCount) => nameof(PurchaseInvoiceListItemDto.OrderCount),
        nameof(PurchaseInvoiceListItemDto.TotalAmount) => nameof(PurchaseInvoiceListItemDto.TotalAmount),
        _ => nameof(PurchaseInvoiceListItemDto.InvoiceNumber)
    };

    private string FormatStatus(string status) => status switch
    {
        PurchaseInvoiceStatuses.Draft => L("Borrador", "Esborrany", "Draft"),
        PurchaseInvoiceStatuses.Registered => L("Registrada", "Registrada", "Registered"),
        PurchaseInvoiceStatuses.Paid => L("Pagada", "Pagada", "Paid"),
        PurchaseInvoiceStatuses.Cancelled => L("Anulada", "Anul·lada", "Cancelled"),
        _ => status
    };

    private static string GetStatusClass(string status) => status switch
    {
        PurchaseInvoiceStatuses.Paid => "success",
        PurchaseInvoiceStatuses.Cancelled => "danger",
        PurchaseInvoiceStatuses.Registered => "warning",
        _ => "warning"
    };

    private string DisplayValue(string value) => string.IsNullOrWhiteSpace(value) ? L("Sin referencia", "Sense referència", "No reference") : value;
}
