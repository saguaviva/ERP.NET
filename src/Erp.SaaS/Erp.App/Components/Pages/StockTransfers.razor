@page "/almacen/traspasos"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IStockQueries StockQueries
@inject AppText T

<PageTitle>@L("Almacén / Traspasos", "Magatzem / Traspassos", "Warehouse / Transfers")</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@T["menu.warehouse"]</p>
        <h1>@L("Traspasos", "Traspassos", "Transfers")</h1>
        <p class="lead">@L("Movimientos internos entre almacenes, con salida del origen y entrada en el destino.", "Moviments interns entre magatzems, amb sortida de l'origen i entrada al destí.", "Internal movements between warehouses, with output from origin and input into destination.")</p>
    </div>
    <div class="quick-links">
        <a class="primary-button link-button" href="/almacen/traspasos/nuevo">@L("Nuevo traspaso", "Nou traspàs", "New transfer")</a>
        <a class="secondary-button link-button" href="/almacen/inventarios">@L("Ver inventarios", "Veure inventaris", "View counts")</a>
        <a class="secondary-button link-button" href="/almacen/stock-actual">@L("Ver stock actual", "Veure estoc actual", "View current stock")</a>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("Selecciona una empresa activa para revisar traspasos de almacén.", "Selecciona una empresa activa per revisar traspassos de magatzem.", "Select an active company to review warehouse transfers.")</p>
    </div>
}
else
{
    <section class="panel">
        <div class="filter-row">
            <input class="text-input" @bind="filter.Search" placeholder="@L("Buscar por número, almacén, artículo, color o notas", "Buscar per número, magatzem, article, color o notes", "Search by number, warehouse, item, color or notes")" disabled="@isLoading" />
            <select class="sidebar-select compact-select" @bind="filter.Status" disabled="@isLoading">
                <option value="">@L("Todos los estados", "Tots els estats", "All statuses")</option>
                @foreach (var status in StockTransferStatuses.All)
                {
                    <option value="@status">@FormatStatus(status)</option>
                }
            </select>
            <label class="inline-checkbox">
                <input type="checkbox" @bind="filter.IncludeClosed" disabled="@isLoading" />
                <span>@L("Incluir cerrados", "Incloure tancats", "Include closed")</span>
            </label>
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? L("Cargando...", "Carregant...", "Loading...") : L("Buscar", "Buscar", "Search"))</button>
        </div>
        <div class="filter-row results-toolbar" style="margin-top: 0.85rem;">
            <span class="results-summary">
                @(totalCount == 0
                    ? L("Sin resultados", "Sense resultats", "No results")
                    : L($"Mostrando {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} traspasos", $"Mostrant {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} de {totalCount.ToUiString("N0")} traspassos", $"Showing {PageStart.ToUiString("N0")}-{PageEnd.ToUiString("N0")} of {totalCount.ToUiString("N0")} transfers"))
            </span>
            <label class="field compact-field">
                <span>@L("Tamaño de página", "Mida de pàgina", "Page size")</span>
                <select class="sidebar-select compact-select" value="@filter.PageSize" @onchange="OnPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }

    <div class="card-grid purchase-summary-grid">
        <section class="info-card">
            <h2>@totalCount</h2>
            <p class="muted">@L("traspasos", "traspassos", "transfers")</p>
        </section>
        <section class="info-card">
            <h2>@items.Count(item => string.Equals(item.Status, StockTransferStatuses.Draft, StringComparison.OrdinalIgnoreCase))</h2>
            <p class="muted">@L("borradores en página", "esborranys a la pàgina", "drafts on page")</p>
        </section>
        <section class="info-card">
            <h2>@items.Count(item => string.Equals(item.Status, StockTransferStatuses.Completed, StringComparison.OrdinalIgnoreCase))</h2>
            <p class="muted">@L("completados en página", "completats a la pàgina", "completed on page")</p>
        </section>
        <section class="info-card accent-card">
            <h2>@items.Sum(item => item.TotalQuantity).ToUiString("0.###")</h2>
            <p class="muted">@L("cantidad total en página", "quantitat total a la pàgina", "total quantity on page")</p>
        </section>
    </div>

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)">
        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>@L("Cargando traspasos de almacén...", "Carregant traspassos de magatzem...", "Loading warehouse transfers...")</span>
            </div>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <SortableHeader Label="@L("Traspaso", "Traspàs", "Transfer")" IsActive="@(sortColumn == nameof(StockTransferListItemDto.TransferNumber))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockTransferListItemDto.TransferNumber), true))" />
                    <SortableHeader Label="@L("Fecha", "Data", "Date")" IsActive="@(sortColumn == nameof(StockTransferListItemDto.TransferDate))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockTransferListItemDto.TransferDate), true))" />
                    <SortableHeader Label="@L("Estado", "Estat", "Status")" IsActive="@(sortColumn == nameof(StockTransferListItemDto.Status))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockTransferListItemDto.Status)))" />
                    <SortableHeader Label="@L("Origen", "Origen", "Origin")" IsActive="@(sortColumn == nameof(StockTransferListItemDto.FromWarehouse))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockTransferListItemDto.FromWarehouse)))" />
                    <SortableHeader Label="@L("Destino", "Destí", "Destination")" IsActive="@(sortColumn == nameof(StockTransferListItemDto.ToWarehouse))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockTransferListItemDto.ToWarehouse)))" />
                    <SortableHeader Label="@L("Líneas", "Línies", "Lines")" IsActive="@(sortColumn == nameof(StockTransferListItemDto.LineCount))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockTransferListItemDto.LineCount), true))" />
                    <SortableHeader Label="@L("Cantidad", "Quantitat", "Quantity")" IsActive="@(sortColumn == nameof(StockTransferListItemDto.TotalQuantity))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(StockTransferListItemDto.TotalQuantity), true))" />
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    @for (var index = 0; index < 5; index++)
                    {
                        <tr class="table-skeleton-row">
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                            <td><span class="skeleton-line short"></span></td>
                        </tr>
                    }
                }
                else if (items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="table-empty">@L("Todavía no hay traspasos registrados.", "Encara no hi ha traspassos registrats.", "There are no transfers registered yet.")</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.TransferNumber</td>
                            <td>@item.TransferDate.ToString("dd/MM/yyyy")</td>
                            <td><span class="status-pill @GetStatusClass(item.Status)">@FormatStatus(item.Status)</span></td>
                            <td>@DisplayValue(item.FromWarehouse)</td>
                            <td>@DisplayValue(item.ToWarehouse)</td>
                            <td>@item.LineCount</td>
                            <td>@item.TotalQuantity.ToUiString("0.###")</td>
                            <td>
                                <a class="inline-link" href="/almacen/traspasos/editar/@item.TransferNumber">@L("Abrir", "Obrir", "Open")</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="pagination-bar">
            <span class="muted">@L($"Página {filter.Page} de {TotalPages}", $"Pàgina {filter.Page} de {TotalPages}", $"Page {filter.Page} of {TotalPages}")</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePageAsync(1)" disabled="@(!CanGoPrevious || isLoading)">@L("Primera", "Primera", "First")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page - 1)" disabled="@(!CanGoPrevious || isLoading)">@L("Anterior", "Anterior", "Previous")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page + 1)" disabled="@(!CanGoNext || isLoading)">@L("Siguiente", "Següent", "Next")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(TotalPages)" disabled="@(!CanGoNext || isLoading)">@L("Última", "Última", "Last")</button>
            </div>
        </div>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = "closed")]
    public bool? IncludeClosedQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? PageSizeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortQuery { get; set; }

    [SupplyParameterFromQuery(Name = "desc")]
    public bool? DescQuery { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool isLoading;
    private string errorMessage = string.Empty;
    private StockTransferFilter filter = new() { Page = 1, PageSize = 25, SortColumn = nameof(StockTransferListItemDto.TransferDate), SortDescending = true };
    private IReadOnlyCollection<StockTransferListItemDto> items = [];
    private string sortColumn = nameof(StockTransferListItemDto.TransferDate);
    private bool sortDescending = true;
    private int totalCount;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)filter.PageSize));
    private bool CanGoPrevious => filter.Page > 1;
    private bool CanGoNext => filter.Page < TotalPages;
    private int PageStart => totalCount == 0 ? 0 : ((filter.Page - 1) * filter.PageSize) + 1;
    private int PageEnd => totalCount == 0 ? 0 : Math.Min(filter.Page * filter.PageSize, totalCount);
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
    }

    protected override async Task OnParametersSetAsync()
    {
        ApplyQueryState();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        errorMessage = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            items = [];
            totalCount = 0;
            return;
        }

        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            filter.SortColumn = sortColumn;
            filter.SortDescending = sortDescending;
            var result = await StockQueries.SearchTransfersAsync(tenantId.Value, companyId.Value, filter);
            items = result.Items;
            totalCount = result.TotalCount;
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            items = [];
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task SearchAsync()
    {
        filter.Page = 1;
        UpdateQueryState();
        return Task.CompletedTask;
    }

    private Task SetSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(sortColumn, column, StringComparison.Ordinal))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = defaultDescending;
        }

        filter.Page = 1;
        UpdateQueryState();
        return Task.CompletedTask;
    }

    private Task ChangePageAsync(int page)
    {
        var newPage = Math.Max(1, Math.Min(page, TotalPages));
        if (newPage == filter.Page)
        {
            return Task.CompletedTask;
        }

        filter.Page = newPage;
        UpdateQueryState();
        return Task.CompletedTask;
    }

    private Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return Task.CompletedTask;
        }

        filter.PageSize = pageSize;
        filter.Page = 1;
        UpdateQueryState();
        return Task.CompletedTask;
    }

    private void ApplyQueryState()
    {
        filter.Search = SearchQuery?.Trim() ?? string.Empty;
        filter.Status = StatusQuery?.Trim() ?? string.Empty;
        filter.IncludeClosed = IncludeClosedQuery ?? false;
        filter.Page = Math.Max(PageQuery.GetValueOrDefault(1), 1);
        filter.PageSize = PageSizeQuery is 25 or 50 or 100 ? PageSizeQuery.Value : 25;
        sortColumn = NormalizeSortColumn(SortQuery);
        sortDescending = DescQuery ?? true;
        filter.SortColumn = sortColumn;
        filter.SortDescending = sortDescending;
    }

    private void UpdateQueryState()
    {
        var uri = NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(filter.Search) ? null : filter.Search,
            ["status"] = string.IsNullOrWhiteSpace(filter.Status) ? null : filter.Status,
            ["closed"] = filter.IncludeClosed ? true : null,
            ["page"] = filter.Page > 1 ? filter.Page : null,
            ["pageSize"] = filter.PageSize != 25 ? filter.PageSize : null,
            ["sort"] = string.Equals(sortColumn, nameof(StockTransferListItemDto.TransferDate), StringComparison.Ordinal) ? null : sortColumn,
            ["desc"] = sortDescending ? null : false
        });

        NavigationManager.NavigateTo(uri, replace: true);
    }

    private static string NormalizeSortColumn(string? sortColumn) => sortColumn switch
    {
        nameof(StockTransferListItemDto.TransferNumber) => nameof(StockTransferListItemDto.TransferNumber),
        nameof(StockTransferListItemDto.TransferDate) => nameof(StockTransferListItemDto.TransferDate),
        nameof(StockTransferListItemDto.Status) => nameof(StockTransferListItemDto.Status),
        nameof(StockTransferListItemDto.FromWarehouse) => nameof(StockTransferListItemDto.FromWarehouse),
        nameof(StockTransferListItemDto.ToWarehouse) => nameof(StockTransferListItemDto.ToWarehouse),
        nameof(StockTransferListItemDto.LineCount) => nameof(StockTransferListItemDto.LineCount),
        nameof(StockTransferListItemDto.TotalQuantity) => nameof(StockTransferListItemDto.TotalQuantity),
        _ => nameof(StockTransferListItemDto.TransferDate)
    };

    private string FormatStatus(string status) => status switch
    {
        StockTransferStatuses.Draft => L("Borrador", "Esborrany", "Draft"),
        StockTransferStatuses.Completed => L("Completado", "Completat", "Completed"),
        StockTransferStatuses.Cancelled => L("Anulado", "Anul·lat", "Cancelled"),
        _ => status
    };

    private static string GetStatusClass(string status) => status switch
    {
        StockTransferStatuses.Completed => "success",
        StockTransferStatuses.Cancelled => "danger",
        _ => "warning"
    };

    private string DisplayValue(string value) => string.IsNullOrWhiteSpace(value) ? L("Sin dato", "Sense dada", "No data") : value;
}
