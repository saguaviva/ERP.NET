                                <span>@($"{L("Ref.", "Ref.", "Ref.")} {DisplayReference} · {L("Temp.", "Temp.", "Season")} {DisplaySeason}")</span>
                            </div>
                            <div class="print-preview-kpis">
                                <span>@($"{LineCount} {L("líneas", "línies", "lines")}")</span>
                                <span>@($"{DistinctColorCount} {L("colores", "colors", "colors")}")</span>
                                <span>@($"{DistinctSizeCount} {L("tallas", "talles", "sizes")}")</span>
