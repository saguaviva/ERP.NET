        linkedFinishOrders.Count(item => string.Equals(item.Status, status, StringComparison.OrdinalIgnoreCase));

    private static string GetLinkedOrderStatusBadgeClass(string status) => status switch
    {
        ParteAcabadoStatuses.Finished => "ok",
        ParteAcabadoStatuses.InProgress => "review",
        ParteAcabadoStatuses.Cancelled => "blocked",
