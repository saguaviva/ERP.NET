@page "/articulos/muestras/nueva"
@page "/articulos/muestras/editar/{Code}"
@page "/articulos/complementos/nueva"
@page "/articulos/complementos/editar/{Code}"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuditLogService AuditLogService
@inject IBaseCatalogQueries BaseCatalogQueries
@inject ILegacySyncService LegacySyncService
@inject IMuestraQueries MuestraQueries
@inject IParteAcabadoQueries ParteAcabadoQueries
@inject IMuestraService MuestraService
@inject NavigationManager NavigationManager
@inject AppText T

<PageTitle>@PageTitleText</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("ARTÍCULOS", "ARTICLES", "ARTICLES")</p>
        <h1>@PageTitleText</h1>
        <p class="lead">@(isLegacySyncActive
            ? L("Edición sobre la SaaS local. La importación manual desde legacy refresca solo registros marcados como legacy.", "Edició sobre la SaaS local. La importació manual des de legacy refresca només registres marcats com a legacy.", "Editing on the local SaaS copy. Manual import from legacy refreshes only records marked as legacy.")
            : L("Alta y edición sobre la tabla mostres replicada en la SaaS local, filtrada por la empresa activa.", "Alta i edició sobre la taula mostres replicada a la SaaS local, filtrada per l'empresa activa.", "Create and edit on the mostres table replicated into the local SaaS, filtered by the active company."))</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="@BuildListUrl()">@L("Volver al listado", "Tornar al llistat", "Back to list")</a>
        @if (!string.IsNullOrWhiteSpace(model.Code))
        {
            <a class="secondary-button link-button" href="@BuildCreateParteFromSampleUrl()">@L("Crear parte acabado", "Crear part d'acabat", "Create finish order")</a>
        }
        @if (model.MachineCode > 0)
        {
            <a class="secondary-button link-button" href="@BuildAcabadosByMachineUrl(model.MachineCode)">@L("Abrir acabados", "Obrir acabats", "Open finishing")</a>
        }
        @if (HasExistingRecord)
        {
            <a class="secondary-button link-button" href="@BuildSheetPrintUrl()">@L("Imprimir ficha", "Imprimir fitxa", "Print sheet")</a>
        }
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
    }

    @if (isLegacySyncActive)
    {
        <div class="alert">
            @L("Artículos", "Articles", "Articles") / @ModulePluralTitle @L("está en convivencia con legacy para esta empresa.", "està en convivència amb legacy per a aquesta empresa.", "is running in coexistence with legacy for this company.")
            @L("Esta ficha guarda cambios solo en la SaaS local y la sync manual refresca únicamente registros de origen legacy.", "Aquesta fitxa desa canvis només a la SaaS local i la sync manual refresca únicament registres d'origen legacy.", "This sheet saves changes only in the local SaaS and manual sync refreshes only legacy-origin records.")
            @if (IsComplementMode)
            {
                <span> @L("Este módulo comparte la misma base y la misma sync que Muestras.", "Aquest mòdul comparteix la mateixa base i la mateixa sync que Mostres.", "This module shares the same data base and sync as Samples.")</span>
            }
            @if (!string.IsNullOrWhiteSpace(syncStatusLabel))
            {
                <span>@syncStatusLabel</span>
            }
        </div>
    }

    @if (!canEdit && !HasExistingRecord)
    {
        <div class="alert">
            @L($"No tienes permisos de edición para crear {modulePluralLower} nuevas en esta empresa.", $"No tens permisos d'edició per crear {modulePluralLower} noves en aquesta empresa.", $"You do not have edit permissions to create new {modulePluralLower} in this company.")
        </div>
    }

    @if (IsComplementMode && canEdit && !HasExistingRecord)
    {
        <section class="panel" style="margin-bottom: 1rem;">
            <div class="detail-panel-header">
                <div>
                    <h2>@L("Duplicar desde otro complemento", "Duplicar des d'un altre complement", "Duplicate from another complement")</h2>
                    <p class="muted">@L("Carga un complemento existente como base y conserva el cliente y el código que estés preparando en esta ficha.", "Carrega un complement existent com a base i conserva el client i el codi que estiguis preparant en aquesta fitxa.", "Load an existing complement as a base and keep the client and code you are preparing in this sheet.")</p>
                </div>
            </div>
            <div class="filter-row">
                <input class="text-input" @bind="duplicateSearch" placeholder="@L("Buscar por código, cliente, referencia o descripción", "Buscar per codi, client, referència o descripció", "Search by code, client, reference or description")" />
                <button class="secondary-button" type="button" @onclick="SearchDuplicateCandidatesAsync" disabled="@isSearchingDuplicates">@(isSearchingDuplicates ? L("Buscando...", "Buscant...", "Searching...") : L("Buscar base", "Buscar base", "Search base"))</button>
            </div>
            @if (duplicateCandidates.Count > 0)
            {
                <div class="list-block" style="margin-top: 1rem;">
                    @foreach (var candidate in duplicateCandidates)
                    {
                        <article class="list-item">
                            <strong>@candidate.Code · @candidate.Description</strong>
                            <span>@(!string.IsNullOrWhiteSpace(candidate.ClientName) ? candidate.ClientName : $"{L("Cliente", "Client", "Client")} {candidate.ClientCode}")</span>
                            <span>@candidate.Reference</span>
                            <button class="secondary-button" type="button" @onclick="() => ApplyDuplicateBaseAsync(candidate.Code, candidate.ClientCode)">@L("Usar base", "Usar base", "Use base")</button>
                        </article>
                    }
                </div>
            }
        </section>
    }

    <section class="summary-card-grid">
        <article class="summary-card">
            <span class="summary-card-label">@L("Origen", "Origen", "Origin")</span>
            <strong>@DisplayOrigin</strong>
            <span class="summary-card-meta">@($"{model.CompanyCenterCode} · {LineCount} líneas")</span>
        </article>
        <article class="summary-card">
            <span class="summary-card-label">@L("Carta", "Carta", "Card")</span>
            <strong>@DistinctColorCount @L("colores", "colors", "colors")</strong>
            <span class="summary-card-meta">@($"{DistinctSizeCount} {L("tallas", "talles", "sizes")} · {DistinctClientCount} {L("clientes", "clients", "clients")}")</span>
        </article>
        <article class="summary-card">
            <span class="summary-card-label">@L("Venta media", "Venda mitjana", "Average sale")</span>
            <strong>@AverageSalePrice.ToUiString("0.00##")</strong>
            <span class="summary-card-meta">@($"{L("Coste", "Cost", "Cost")} {AverageCostPrice.ToUiString("0.00##")} · {L("margen", "marge", "margin")} {AverageMarginPercent.ToUiString("0.0#")}%")</span>
        </article>
        <article class="summary-card">
            <span class="summary-card-label">@L("Estado ficha", "Estat fitxa", "Sheet status")</span>
            <strong>@FichaStatusLabel</strong>
            <span class="summary-card-meta">@FichaStatusHelp</span>
        </article>
    </section>

    <div class="record-tabs" style="margin-top: 1rem;">
        <button class="record-tab @(activeTab == MuestraTab.Ficha ? "active" : null)" type="button" @onclick="@(() => activeTab = MuestraTab.Ficha)">@ModuleSingularTitle</button>
        <button class="record-tab @(activeTab == MuestraTab.Carta ? "active" : null)" type="button" @onclick="@(() => activeTab = MuestraTab.Carta)">@L("Carta colores · tallas", "Carta colors · talles", "Color card · sizes")</button>
        <button class="record-tab @(activeTab == MuestraTab.Desglose ? "active" : null)" type="button" @onclick="@(() => activeTab = MuestraTab.Desglose)">@L("Desglose color · máquina", "Desglossament color · màquina", "Color · machine breakdown")</button>
        <button class="record-tab @(activeTab == MuestraTab.Ordenes ? "active" : null)" type="button" @onclick="@(() => activeTab = MuestraTab.Ordenes)">@L("Órdenes fabricación", "Ordres fabricació", "Manufacturing orders")</button>
        <button class="record-tab @(activeTab == MuestraTab.Impresion ? "active" : null)" type="button" @onclick="@(() => activeTab = MuestraTab.Impresion)">@L("Impresión ficha · etiquetas", "Impressió fitxa · etiquetes", "Sheet print · labels")</button>
    </div>

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <fieldset disabled="@isReadOnly">
            @if (activeTab == MuestraTab.Ficha)
            {
                <div class="legacy-record-grid" style="margin-top: 1rem;">
                    <section class="panel detail-panel">
                        <div class="detail-panel-header">
                            <div>
                                <h2>@L("Ficha comercial", "Fitxa comercial", "Commercial sheet")</h2>
                                <p class="muted">@L($"Cabecera principal del {moduleSingularLower}, cliente, máquina y datos económicos.", $"Capçalera principal del {moduleSingularLower}, client, màquina i dades econòmiques.", $"Main header of the {moduleSingularLower}, client, machine and economic data.")</p>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(model.Code))
                            {
                                <span class="stock-state-badge ok">@model.Code</span>
                            }
                        </div>

                        <div class="form-grid">
                            <label class="field">
                                <span>@L("Código", "Codi", "Code")</span>
                                <InputText class="text-input" @bind-Value="model.Code" disabled="@HasExistingRecord" />
                            </label>
                            <label class="field wide">
                                <span>@L("Descripción", "Descripció", "Description")</span>
                                <InputText class="text-input" @bind-Value="model.Description" />
                            </label>
                            <label class="field">
                                <span>@L("Cliente", "Client", "Client")</span>
                                <InputNumber class="text-input" @bind-Value="model.ClientCode" />
                            </label>
                            <label class="field wide">
                                <span>@L("Nombre cliente", "Nom client", "Client name")</span>
                                <InputText class="text-input" @bind-Value="model.ClientName" />
                            </label>
                            <label class="field">
                                <span>@L("Referencia", "Referència", "Reference")</span>
                                <InputText class="text-input" @bind-Value="model.Reference" />
                            </label>
                            <label class="field">
                                <span>@L("Temporada", "Temporada", "Season")</span>
                                <InputText class="text-input" @bind-Value="model.Season" />
                            </label>
                            <label class="field">
                                <span>@L("Máquina", "Màquina", "Machine")</span>
                                @if (machineOptions.Count == 0)
                                {
                                    <InputNumber class="text-input" @bind-Value="model.MachineCode" />
                                }
                                else
                                {
                                    <select class="text-input" value="@model.MachineCode" @onchange="OnHeaderMachineChanged">
                                        <option value="0">@L("Selecciona máquina", "Selecciona màquina", "Select machine")</option>
                                        @foreach (var machine in machineOptions)
                                        {
                                            <option value="@ParseMachineCode(machine.Code)">@FormatMachineOption(machine)</option>
                                        }
                                    </select>
                                }
                            </label>
                            <label class="field wide">
                                <span>@L("Nombre máquina", "Nom màquina", "Machine name")</span>
                                @if (machineOptions.Count == 0)
                                {
                                    <InputText class="text-input" @bind-Value="model.MachineName" />
                                }
                                else
                                {
                                    <input class="text-input" value="@model.MachineName" disabled />
                                }
                            </label>
                            <label class="field">
                                <span>@L("% margen", "% marge", "% margin")</span>
                                <InputNumber class="text-input" @bind-Value="model.MarginPercent" />
                            </label>
                            <label class="field">
                                <span>@L("IVA", "IVA", "VAT")</span>
                                <InputText class="text-input" @bind-Value="model.VatCode" />
                            </label>
                            <label class="field">
                                <span>@L("Precio unidad", "Preu unitat", "Unit price")</span>
                                <InputNumber class="text-input" @bind-Value="model.UnitPrice" />
                            </label>
                            <label class="field wide">
                                <span>@L("Composición", "Composició", "Composition")</span>
                                <InputText class="text-input" @bind-Value="model.Composition" />
                            </label>
                        </div>

                        <div class="muestra-kpi-strip">
                            <span class="metric-chip">@L("Colores", "Colors", "Colors"): <strong>@DistinctColorCount</strong></span>
                            <span class="metric-chip">@L("Tallas", "Talles", "Sizes"): <strong>@DistinctSizeCount</strong></span>
                            <span class="metric-chip">@L("Venta total", "Venda total", "Total sale"): <strong>@TotalSalePrice.ToUiString("0.00##")</strong></span>
                            <span class="metric-chip">@L("Coste total", "Cost total", "Total cost"): <strong>@TotalCostPrice.ToUiString("0.00##")</strong></span>
                        </div>
                    </section>

                    <section class="panel detail-panel">
                        <div class="detail-panel-header">
                            <div>
                                <h2>@L("Notas y resumen", "Notes i resum", "Notes and summary")</h2>
                                <p class="muted">@L($"Contexto operativo del {moduleSingularLower} y lectura rápida de la carta.", $"Context operatiu del {moduleSingularLower} i lectura ràpida de la carta.", $"Operational context of the {moduleSingularLower} and quick reading of the card.")</p>
                            </div>
                        </div>

                        <label class="field field-full">
                            <span>@L("Notas", "Notes", "Notes")</span>
                            <InputTextArea class="text-input textarea-input muestra-notes-input" @bind-Value="model.Notes" />
                        </label>

                        <div class="muestra-overview-list">
                            <article>
                                <strong>@L("Cliente principal", "Client principal", "Main client")</strong>
                                <span>@DisplayClient</span>
                            </article>
                            <article>
                                <strong>@L("Máquina", "Màquina", "Machine")</strong>
                                <span>@DisplayMachine</span>
                            </article>
                            <article>
                                <strong>@L("Colores destacados", "Colors destacats", "Top colors")</strong>
                                <span>@TopColorsLabel</span>
                            </article>
                            <article>
                                <strong>@L("Tallas destacadas", "Talles destacades", "Top sizes")</strong>
                                <span>@TopSizesLabel</span>
                            </article>
                            <article>
                                <strong>@L("Composición", "Composició", "Composition")</strong>
                                <span>@CompositionLabel</span>
                            </article>
                        </div>
                    </section>
                </div>
            }

            @if (activeTab == MuestraTab.Carta)
            {
                <section class="panel detail-panel" style="margin-top: 1rem;">
                    <div class="detail-panel-header">
                        <div>
                            <h2>@L("Carta de colores y tallas", "Carta de colors i talles", "Color and size card")</h2>
                            <p class="muted">@L("Detalle por color, talla y cliente con coste, venta y NC code.", "Detall per color, talla i client amb cost, venda i codi NC.", "Detail by color, size and client with cost, sale and NC code.")</p>
                        </div>
                        @if (!isReadOnly)
                        {
                            <div class="quick-links">
                                <button class="secondary-button" type="button" @onclick="DuplicateSelectedClientAcrossLinesAsync">@L("Copiar cliente cabecera", "Copiar client capçalera", "Copy header client")</button>
                                <button class="secondary-button" type="button" @onclick="AddLine">@L("Añadir línea", "Afegir línia", "Add line")</button>
                            </div>
                        }
                    </div>

                    <div class="muestra-kpi-strip">
                        <span class="metric-chip">@L("Líneas", "Línies", "Lines"): <strong>@LineCount</strong></span>
                        <span class="metric-chip">@L("Colores únicos", "Colors únics", "Unique colors"): <strong>@DistinctColorCount</strong></span>
                        <span class="metric-chip">@L("Tallas únicas", "Talles úniques", "Unique sizes"): <strong>@DistinctSizeCount</strong></span>
                        <span class="metric-chip">@L("Venta media línea", "Venda mitjana línia", "Average line sale"): <strong>@AverageSalePrice.ToUiString("0.00##")</strong></span>
                    </div>

                    <div class="table-scroll">
                        <table class="data-table detail-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>@L("Talla", "Talla", "Size")</th>
                                    <th>@L("Talla H", "Talla H", "Size H")</th>
                                    <th>@L("Talla L", "Talla L", "Size L")</th>
                                    <th>@L("Descripción", "Descripció", "Description")</th>
                                    <th>@L("Color", "Color", "Color")</th>
                                    <th>@L("Coste", "Cost", "Cost")</th>
                                    <th>@L("Venta", "Venda", "Sale")</th>
                                    <th>@L("Margen", "Marge", "Margin")</th>
                                    <th>@L("Cliente", "Client", "Client")</th>
                                    <th>@L("Nombre cliente", "Nom client", "Client name")</th>
                                    <th>@L("Código NC", "Codi NC", "CN code")</th>
                                    <th>@L("Acciones", "Accions", "Actions")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (model.Lines.Count == 0)
                                {
                                    <tr>
                                        <td colspan="13" class="muted">@L($"No hay detalle cargado para este {moduleSingularLower}.", $"No hi ha detall carregat per a aquest {moduleSingularLower}.", $"There is no detail loaded for this {moduleSingularLower}.")</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var line in model.Lines.OrderBy(item => item.LineNumber))
                                    {
                                        <tr @key="line.LineNumber" class="@GetSampleLineRowClass(line)">
                                            <td><span class="line-number-badge">#@line.LineNumber</span></td>
                                            <td><InputText class="text-input table-input" @bind-Value="line.SizeCode" /></td>
                                            <td><InputText class="text-input table-input" @bind-Value="line.SizeHigh" /></td>
                                            <td><InputText class="text-input table-input" @bind-Value="line.SizeLow" /></td>
                                            <td><InputText class="text-input table-input" @bind-Value="line.Description" /></td>
                                            <td><InputText class="text-input table-input" @bind-Value="line.Color" /></td>
                                            <td><InputNumber class="text-input table-input" @bind-Value="line.CostPrice" /></td>
                                            <td><InputNumber class="text-input table-input" @bind-Value="line.SalePrice" /></td>
                                            <td>
                                                <span class="stock-state-badge @GetLineMarginBadgeClass(line)">@GetLineMarginLabel(line)</span>
                                            </td>
                                            <td><InputNumber class="text-input table-input" @bind-Value="line.ClientCode" /></td>
                                            <td><InputText class="text-input table-input" @bind-Value="line.ClientName" /></td>
                                            <td><InputText class="text-input table-input" @bind-Value="line.NcCode" /></td>
                                            <td>
                                                <button class="secondary-button inline-action-button" type="button" @onclick="() => SelectBreakdownLine(line.LineNumber)">@L("Desglose", "Desglossament", "Breakdown")</button>
                                                @if (!string.IsNullOrWhiteSpace(model.Code))
                                                {
                                                    <a class="inline-link" href="@BuildCreateParteFromSampleUrl(line.LineNumber)">@L("Parte", "Part", "Order")</a>
                                                }
                                                @if (!isReadOnly)
                                                {
                                                    <button class="danger-link" type="button" @onclick="() => RemoveLine(line.LineNumber)">@L("Quitar", "Treure", "Remove")</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }

            @if (activeTab == MuestraTab.Desglose)
            {
                <div class="legacy-record-grid" style="margin-top: 1rem;">
                    <section class="panel detail-panel">
                        <div class="detail-panel-header">
                            <div>
                                <h2>@L("Selección de color · talla", "Selecció de color · talla", "Color · size selection")</h2>
                                <p class="muted">@L("Cada línea de carta puede tener su propia ficha técnica de máquina e hilos.", "Cada línia de carta pot tenir la seva pròpia fitxa tècnica de màquina i fils.", "Each card line can have its own machine and yarn technical sheet.")</p>
                            </div>
                        </div>

                        @if (model.Lines.Count == 0)
                        {
                            <p class="muted">@L("Añade primero alguna línea a la carta de colores para poder trabajar el desglose.", "Afegeix primer alguna línia a la carta de colors per poder treballar el desglossament.", "Add at least one line to the color card first so you can work on the breakdown.")</p>
                        }
                        else
                        {
                            <div class="muestra-breakdown-selector">
                                @foreach (var line in model.Lines.OrderBy(item => item.LineNumber))
                                {
                                    <button class="muestra-breakdown-choice @(selectedBreakdownLineNumber == line.LineNumber ? "active" : null)"
                                            type="button"
                                            @onclick="@(() => SelectBreakdownLine(line.LineNumber))">
                                        <strong>@BuildLineTitle(line)</strong>
                                        <span>@(string.IsNullOrWhiteSpace(line.Color) ? L("Sin color", "Sense color", "No color") : line.Color)</span>
                                        <span>@BuildSizeLabel(line)</span>
                                        <span class="stock-state-badge @(HasBreakdownData(line) ? "ok" : "review")">@GetBreakdownStatusLabel(line)</span>
                                    </button>
                                }
                            </div>
                        }
                    </section>

                    <section class="panel detail-panel">
                        <div class="detail-panel-header">
                            <div>
                                <h2>@L("Desglose técnico", "Desglossament tècnic", "Technical breakdown")</h2>
                                <p class="muted">@L("Cabecera de máquina y detalle de hilos/proveedores para la línea seleccionada.", "Capçalera de màquina i detall de fils/proveïdors per a la línia seleccionada.", "Machine header and yarn/supplier detail for the selected line.")</p>
                            </div>
                            @if (SelectedBreakdownLine is not null)
                            {
                                <div class="quick-links">
                                    @if (!isReadOnly)
                                    {
                                        <button class="secondary-button" type="button" @onclick="CopySampleMachineIntoBreakdown">@L("Usar máquina cabecera", "Usar màquina capçalera", "Use header machine")</button>
                                        <button class="secondary-button" type="button" @onclick="AddBreakdownMaterialLine">@L("Añadir hilo", "Afegir fil", "Add yarn")</button>
                                    }
                                    @if (SelectedBreakdown is not null && SelectedBreakdown.MachineCode > 0)
                                    {
                                        <a class="secondary-button link-button" href="@BuildAcabadosByMachineUrl(SelectedBreakdown.MachineCode, SelectedBreakdown.OperationCode)">@L("Acabados máquina", "Acabats màquina", "Machine finishing")</a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(model.Code))
                                    {
                                        <a class="secondary-button link-button" href="@BuildCreateParteFromSampleUrl(SelectedBreakdownLine.LineNumber)">@L("Crear parte", "Crear part", "Create order")</a>
                                    }
                                    @if (HasExistingRecord)
                                    {
                                        <a class="secondary-button link-button" href="@BuildBreakdownPrintUrl(SelectedBreakdownLine.LineNumber)">@L("Imprimir desglose", "Imprimir desglossament", "Print breakdown")</a>
                                    }
                                </div>
                            }
                        </div>

                        @if (SelectedBreakdownLine is null || SelectedBreakdown is null)
                        {
                            <p class="muted">@L("Selecciona una línea de carta para abrir su desglose técnico.", "Selecciona una línia de carta per obrir el seu desglossament tècnic.", "Select a card line to open its technical breakdown.")</p>
                        }
                        else
                        {
                            <div class="muestra-kpi-strip">
                                <span class="metric-chip">@L("Línea", "Línia", "Line"): <strong>@SelectedBreakdownLine.LineNumber</strong></span>
                                <span class="metric-chip">@L("Materiales", "Materials", "Materials"): <strong>@SelectedBreakdown.Lines.Count</strong></span>
