                        </div>
                        @if (HasExistingRecord && SelectedBreakdownLine is not null)
                        {
                            <a class="secondary-button link-button" href="@BuildBreakdownPrintUrl(SelectedBreakdownLine.LineNumber)">@L("Abrir desglose", "Obrir desglossament", "Open breakdown")</a>
                        }
                    </article>
                </section>
            }

            @if (activeTab == MuestraTab.Ordenes)
            {
                <section class="panel detail-panel" style="margin-top: 1rem;">
                    <div class="detail-panel-header">
                        <div>
                            <h2>@L("Órdenes de fabricación relacionadas", "Ordres de fabricació relacionades", "Related manufacturing orders")</h2>
                            <p class="muted">@L($"Seguimiento del circuito histórico de producción enlazado a esta {ModuleSingularTitle.ToLowerInvariant()}.", $"Seguiment del circuit històric de producció enllaçat a aquesta {ModuleSingularTitle.ToLowerInvariant()}.", $"Tracking of the historical production flow linked to this {ModuleSingularTitle.ToLowerInvariant()}.")</p>
                        </div>
                        <div class="quick-links">
                            @if (!string.IsNullOrWhiteSpace(model.Code))
