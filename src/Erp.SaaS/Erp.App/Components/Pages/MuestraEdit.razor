                            <div class="print-preview-sheet-header">
                                <strong>@DisplaySelectedBreakdownMachine</strong>
                                <span>@DisplaySelectedBreakdownDate</span>
                                <span>@($"{SelectedBreakdown?.Lines.Count ?? 0} {L("materiales", "materials", "materials")} · {L("coste", "cost", "cost")} {BreakdownTotalCost.ToUiString("0.00##")}")</span>
                            </div>
                            <ul class="print-preview-list">
                                @if (SelectedBreakdown?.Lines.Count > 0)
                                {
                                    @foreach (var line in SelectedBreakdown.Lines.OrderBy(item => item.LineNumber).Take(5))
                                    {
<li>@($"{line.YarnCode} · {line.MaterialColor} · {L("consumo", "consum", "consumption")} {line.Consumption.ToUiString("0.00##")} · {L("imp.", "imp.", "amt.")} {CalculateBreakdownLineImport(line).ToUiString("0.00##")}")</li>
