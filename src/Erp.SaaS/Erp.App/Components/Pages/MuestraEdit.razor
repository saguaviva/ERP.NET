    private static string BuildAcabadosByMachineUrl(int machineCode, int? operationCode = null)
    {
        if (machineCode <= 0)
        {
            return "/produccion/acabados?live=true";
        }

        var uri = $"/produccion/acabados?machine={machineCode}&live=true";
        var selectedOperationCode = operationCode.GetValueOrDefault();
        return selectedOperationCode > 0
            ? $"{uri}&operation={selectedOperationCode}"
            : uri;
    }

    private string BuildCreateParteFromSampleUrl(int? lineNumber = null)
    {
        var parameters = new Dictionary<string, string?>
        {
            ["sampleCode"] = model.Code,
            ["sampleKind"] = CurrentSourceSampleKind
        };

        if (lineNumber.HasValue && lineNumber.Value > 0)
        {
            parameters["sampleLine"] = lineNumber.Value.ToString();
        }

        var query = string.Join("&",
            parameters
                .Where(item => !string.IsNullOrWhiteSpace(item.Value))
                .Select(item => $"{Uri.EscapeDataString(item.Key)}={Uri.EscapeDataString(item.Value!)}"));

        return string.IsNullOrWhiteSpace(query)
            ? "/produccion/acabados/nueva"
            : $"/produccion/acabados/nueva?{query}";
    }

    private string BuildLinkedFinishOrdersUrl()
    {
        if (string.IsNullOrWhiteSpace(model.Code))
        {
            return "/produccion/acabados?live=true";
        }

        return $"/produccion/acabados?sourceKind={Uri.EscapeDataString(CurrentSourceSampleKind)}&sourceCode={Uri.EscapeDataString(model.Code)}&live=true";
    }

    private static string BuildFinishOrderUrl(int orderNumber) => $"/produccion/acabados/editar/{orderNumber}";

    private static string BuildFinishOrderPrintUrl(int orderNumber) => $"/produccion/acabados/{orderNumber}/imprimir";

    private static MuestraDetailDto CloneMuestraForDuplication(
        MuestraDetailDto source,
        string? targetCode,
        int targetClientCode,
        string? targetClientName,
        string? targetCenter)
    {
        var clone = new MuestraDetailDto
        {
            Code = targetCode ?? string.Empty,
            CompanyCenterCode = string.IsNullOrWhiteSpace(targetCenter) ? source.CompanyCenterCode : targetCenter,
            Description = source.Description,
            ClientCode = targetClientCode,
            ClientName = targetClientName ?? string.Empty,
            Reference = source.Reference,
            Season = source.Season,
            MachineCode = source.MachineCode,
            MachineName = source.MachineName,
            MarginPercent = source.MarginPercent,
            VatCode = source.VatCode,
            Notes = source.Notes,
            Composition = source.Composition,
            UnitPrice = source.UnitPrice,
            Origin = "local"
        };

        clone.Lines = source.Lines
            .OrderBy(item => item.LineNumber)
            .Select(line => new MuestraLineDto
            {
                LineNumber = line.LineNumber,
                SizeCode = line.SizeCode,
                SizeHigh = line.SizeHigh,
                SizeLow = line.SizeLow,
                Description = line.Description,
                CostPrice = line.CostPrice,
                SalePrice = line.SalePrice,
                Color = line.Color,
                ClientCode = targetClientCode,
                ClientName = targetClientName ?? string.Empty,
                NcCode = line.NcCode,
                Breakdown = CloneBreakdown(line.Breakdown, line.LineNumber, targetClientCode, targetClientName)
            })
            .ToList();

        clone.Breakdowns = clone.Lines
            .Where(line => line.Breakdown is not null)
            .Select(line => line.Breakdown!)
            .OrderBy(item => item.SampleLineNumber)
            .ToList();

        return clone;
    }

    private static MuestraBreakdownDto CloneBreakdown(
        MuestraBreakdownDto? source,
        int sampleLineNumber,
        int targetClientCode,
        string? targetClientName)
    {
        if (source is null)
        {
            return new MuestraBreakdownDto
            {
                SampleLineNumber = sampleLineNumber,
                ClientCode = targetClientCode,
                ClientName = targetClientName ?? string.Empty
            };
        }

        return new MuestraBreakdownDto
        {
            SampleLineNumber = sampleLineNumber,
            WorkDate = source.WorkDate,
            ClientCode = targetClientCode,
            ClientName = targetClientName ?? string.Empty,
            MachineCode = source.MachineCode,
            MachineName = source.MachineName,
            OperationCode = source.OperationCode,
            OperationName = source.OperationName,
            Needles = source.Needles,
            Speed = source.Speed,
            Disk = source.Disk,
            TimeMinutes = source.TimeMinutes,
            MachineRate = source.MachineRate,
            Cuts = source.Cuts,
            Notes = source.Notes,
            Lines = source.Lines
                .OrderBy(item => item.LineNumber)
                .Select(line => new MuestraBreakdownLineDto
                {
                    LineNumber = line.LineNumber,
                    YarnCode = line.YarnCode,
                    ProviderCode = line.ProviderCode,
                    ProviderName = line.ProviderName,
                    MaterialColor = line.MaterialColor,
                    YarnMetric = line.YarnMetric,
                    Ends = line.Ends,
                    Passes = line.Passes,
                    Graduation = line.Graduation,
                    Consumption = line.Consumption,
                    Price = line.Price
                })
                .ToList()
        };
    }

    private static string BuildLineTitle(MuestraLineDto line)
    {
        if (!string.IsNullOrWhiteSpace(line.Description))
        {
            return line.Description;
        }

        var size = BuildSizeLabel(line);
        return string.IsNullOrWhiteSpace(size) ? $"Línea {line.LineNumber}" : size;
    }

    private static string BuildSizeLabel(MuestraLineDto line)
    {
        var parts = new[]
        {
            NormalizeToken(line.SizeCode),
            NormalizeToken(line.SizeHigh),
            NormalizeToken(line.SizeLow)
        }.Where(value => !string.IsNullOrWhiteSpace(value)).ToArray();

        return parts.Length == 0 ? string.Empty : string.Join(" · ", parts);
    }

    private static string BuildTopList(IEnumerable<string> items, string emptyFallback)
    {
        var topItems = items
            .GroupBy(value => value, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(group => group.Count())
            .ThenBy(group => group.Key)
            .Take(3)
            .Select(group => group.Key)
            .ToList();

        return topItems.Count == 0 ? emptyFallback : string.Join(", ", topItems);
    }

    private static string NormalizeToken(string? value) => value?.Trim() ?? string.Empty;

    private static decimal CalculateLineMarginPercent(MuestraLineDto line)
    {
        if (line.SalePrice <= 0)
        {
            return 0m;
        }

        var margin = (line.SalePrice - line.CostPrice) / line.SalePrice * 100m;
        return Math.Round(margin, 2);
    }

    private static string GetLineMarginLabel(MuestraLineDto line)
    {
        if (line.SalePrice <= 0)
        {
            return "Sin venta";
        }

        return $"{CalculateLineMarginPercent(line):0.0#}%";
    }

    private static string GetLineMarginBadgeClass(MuestraLineDto line)
    {
        if (line.SalePrice <= 0)
        {
            return "review";
        }

        return CalculateLineMarginPercent(line) switch
        {
            < 0 => "blocked",
            < 15 => "review",
            _ => "ok"
        };
    }

    private static string GetSampleLineRowClass(MuestraLineDto line)
    {
        if (line.SalePrice <= 0)
        {
            return "sample-line-row review";
        }

        return CalculateLineMarginPercent(line) < 15 ? "sample-line-row review" : "sample-line-row";
    }

    private static string DisplayNcCode(MuestraLineDto line) =>
        string.IsNullOrWhiteSpace(line.NcCode) ? "-" : line.NcCode;

    private void EnsureBreakdownState()
    {
        foreach (var line in model.Lines)
        {
            line.Breakdown ??= CreateBreakdownForLine(line);
            line.Breakdown.SampleLineNumber = line.LineNumber;
            if (line.Breakdown.ClientCode <= 0)
            {
                line.Breakdown.ClientCode = line.ClientCode > 0 ? line.ClientCode : model.ClientCode;
            }

            if (string.IsNullOrWhiteSpace(line.Breakdown.ClientName))
            {
                line.Breakdown.ClientName = !string.IsNullOrWhiteSpace(line.ClientName) ? line.ClientName : model.ClientName;
            }

            if (line.Breakdown.MachineCode <= 0)
            {
                line.Breakdown.MachineCode = model.MachineCode;
            }

            if (string.IsNullOrWhiteSpace(line.Breakdown.MachineName))
            {
                line.Breakdown.MachineName = model.MachineName;
            }

            if (line.Breakdown.OperationCode > 0 && string.IsNullOrWhiteSpace(line.Breakdown.OperationName))
            {
                line.Breakdown.OperationName = ResolveOperationName(line.Breakdown.OperationCode);
            }
        }

        if (selectedBreakdownLineNumber <= 0 || model.Lines.All(item => item.LineNumber != selectedBreakdownLineNumber))
        {
            selectedBreakdownLineNumber = model.Lines.OrderBy(item => item.LineNumber).Select(item => item.LineNumber).FirstOrDefault();
        }
    }

    private void SelectBreakdownLine(int lineNumber)
    {
        selectedBreakdownLineNumber = lineNumber;
        activeTab = MuestraTab.Desglose;
    }

    private void AddBreakdownMaterialLine()
    {
        if (SelectedBreakdown is null)
        {
            return;
        }

        var nextLineNumber = SelectedBreakdown.Lines.Count == 0
            ? 1
            : SelectedBreakdown.Lines.Max(item => item.LineNumber) + 1;

        SelectedBreakdown.Lines.Add(new MuestraBreakdownLineDto
        {
            LineNumber = nextLineNumber
        });
    }

    private void RemoveBreakdownMaterialLine(int lineNumber)
    {
        if (SelectedBreakdown is null)
        {
            return;
        }

        var line = SelectedBreakdown.Lines.FirstOrDefault(item => item.LineNumber == lineNumber);
        if (line is null)
        {
            return;
        }

        SelectedBreakdown.Lines.Remove(line);
        for (var index = 0; index < SelectedBreakdown.Lines.Count; index++)
        {
            SelectedBreakdown.Lines[index].LineNumber = index + 1;
        }
    }

    private void CopySampleMachineIntoBreakdown()
    {
        if (SelectedBreakdown is null || SelectedBreakdownLine is null)
        {
            return;
        }

        SelectedBreakdown.ClientCode = SelectedBreakdownLine.ClientCode > 0 ? SelectedBreakdownLine.ClientCode : model.ClientCode;
        SelectedBreakdown.ClientName = !string.IsNullOrWhiteSpace(SelectedBreakdownLine.ClientName) ? SelectedBreakdownLine.ClientName : model.ClientName;
        SelectedBreakdown.MachineCode = model.MachineCode;
        SelectedBreakdown.MachineName = model.MachineName;
        SelectedBreakdown.WorkDate ??= DateTime.Today;
    }

    private MuestraBreakdownDto CreateBreakdownForLine(MuestraLineDto line) =>
        new()
        {
            SampleLineNumber = line.LineNumber,
            ClientCode = line.ClientCode > 0 ? line.ClientCode : model.ClientCode,
            ClientName = !string.IsNullOrWhiteSpace(line.ClientName) ? line.ClientName : model.ClientName,
            MachineCode = model.MachineCode,
            MachineName = model.MachineName
        };

    private static decimal CalculateBreakdownLineImport(MuestraBreakdownLineDto line) =>
        Math.Round(line.Consumption * line.Price, 2);

    private string ResolveMachineName(int machineCode)
    {
        if (machineCode <= 0)
        {
            return string.Empty;
        }

        return machineOptions.FirstOrDefault(item => ParseMachineCode(item.Code) == machineCode)?.Name ?? string.Empty;
    }

    private string ResolveOperationName(int operationCode)
    {
        if (operationCode <= 0)
        {
            return string.Empty;
        }

        return operationOptions.FirstOrDefault(item => ParseOperationCode(item.Code) == operationCode)?.Name ?? string.Empty;
    }

    private static string DisplayBreakdownColor(MuestraLineDto line) =>
        string.IsNullOrWhiteSpace(line.Color) ? "Sin color" : line.Color;

    private static bool HasBreakdownData(MuestraLineDto line)
    {
        var breakdown = line.Breakdown;
        if (breakdown is null)
        {
            return false;
        }

        return breakdown.MachineCode > 0 ||
               !string.IsNullOrWhiteSpace(breakdown.MachineName) ||
               breakdown.OperationCode > 0 ||
               !string.IsNullOrWhiteSpace(breakdown.OperationName) ||
               breakdown.WorkDate.HasValue ||
               breakdown.Needles > 0 ||
               breakdown.Speed > 0 ||
               !string.IsNullOrWhiteSpace(breakdown.Disk) ||
               breakdown.TimeMinutes > 0 ||
               breakdown.MachineRate > 0 ||
               !string.IsNullOrWhiteSpace(breakdown.Cuts) ||
               !string.IsNullOrWhiteSpace(breakdown.Notes) ||
               breakdown.Lines.Count > 0;
    }

    private static string GetBreakdownStatusLabel(MuestraLineDto line) =>
        HasBreakdownData(line) ? $"{line.Breakdown.Lines.Count} mats." : "Pendiente";

