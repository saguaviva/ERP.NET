                                <span class="summary-card-meta">@L("Total enlazadas a esta ficha", "Total enllaçades a aquesta fitxa", "Total linked to this sheet")</span>
                            </article>
                            <article class="summary-card">
                                <span class="summary-card-label">@L("Pendientes", "Pendents", "Pending")</span>
                                <strong>@GetLinkedOrderStatusCount(ParteAcabadoStatuses.Pending)</strong>
                                <span class="summary-card-meta">@L("Aún no iniciadas", "Encara no iniciades", "Not started yet")</span>
                            </article>
                            <article class="summary-card">
                                <span class="summary-card-label">@L("En proceso", "En procés", "In progress")</span>
                                <strong>@GetLinkedOrderStatusCount(ParteAcabadoStatuses.InProgress)</strong>
                                <span class="summary-card-meta">@L("Trabajo vivo en planta", "Treball viu a planta", "Live work on the floor")</span>
                            </article>
                            <article class="summary-card">
                                <span class="summary-card-label">@L("Terminadas", "Terminades", "Finished")</span>
                                <strong>@GetLinkedOrderStatusCount(ParteAcabadoStatuses.Finished)</strong>
                                <span class="summary-card-meta">@L("Ya cerradas", "Ja tancades", "Already closed")</span>
                            </article>
                        </div>

                        @if (isLoadingLinkedFinishOrders)
                        {
                            <p class="muted">@L("Cargando órdenes relacionadas...", "Carregant ordres relacionades...", "Loading related orders...")</p>
                        }
                        else if (linkedFinishOrders.Count == 0)
                        {
                            <p class="muted">@L("Todavía no hay órdenes de fabricación ligadas a esta ficha.", "Encara no hi ha ordres de fabricació lligades a aquesta fitxa.", "There are no manufacturing orders linked to this sheet yet.")</p>
                        }
                        else
                        {
                            <div class="table-scroll" style="margin-top: 1rem;">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>@L("Número", "Número", "Number")</th>
                                            <th>@L("Fecha", "Data", "Date")</th>
                                            <th>@L("Estado", "Estat", "Status")</th>
                                            <th>@L("Máquina", "Màquina", "Machine")</th>
                                            <th>@L("Operación", "Operació", "Operation")</th>
                                            <th>@L("Tejido", "Teixit", "Fabric")</th>
                                            <th>@L("Color", "Color", "Color")</th>
                                            <th>@L("Piezas", "Peces", "Pieces")</th>
                                            <th>Kg</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in linkedFinishOrders)
                                        {
                                            <tr>
                                                <td>@item.OrderNumber</td>
                                                <td>@(item.Date?.ToString("dd/MM/yyyy") ?? "-")</td>
                                                <td><span class="stock-state-badge @GetLinkedOrderStatusBadgeClass(item.Status)">@GetStatusLabel(item.Status)</span></td>
                                                <td>@GetDisplayText(item.MachineName, item.MachineCode)</td>
                                                <td>@GetDisplayText(item.OperationName, item.OperationCode)</td>
                                                <td>@GetLinkedOrderFabricLabel(item)</td>
                                                <td>@(string.IsNullOrWhiteSpace(item.PrimaryColor) ? "-" : item.PrimaryColor)</td>
                                                <td>@item.TotalPieces.ToUiString("0.##")</td>
                                                <td>@item.TotalKilograms.ToUiString("0.##")</td>
                                                <td>
                                                    <div class="inline-action-list">
                                                        <a class="inline-link" href="@BuildFinishOrderUrl(item.OrderNumber)">@L("Abrir", "Obrir", "Open")</a>
                                                        <a class="inline-link" href="@BuildFinishOrderPrintUrl(item.OrderNumber)" target="_blank" rel="noopener noreferrer">@L("Imprimir", "Imprimir", "Print")</a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </section>
            }

            <div class="quick-links" style="margin-top: 1rem;">
                @if (canEdit)
                {
                    <button class="primary-button" type="submit">@L("Guardar", "Desar", "Save") @moduleSingularLower</button>
                }
                @if (canEdit && HasExistingRecord)
                {
                    <button class="secondary-button danger-button" type="button" @onclick="DeleteAsync">@L("Eliminar", "Eliminar", "Delete") @moduleSingularLower</button>
                }
                @if (HasExistingRecord)
                {
                    <button class="secondary-button" type="button" @onclick="LoadAuditAsync">@L("Recargar historial", "Recarregar historial", "Reload history")</button>
                }
            </div>
        </fieldset>
    </EditForm>

    @if (HasExistingRecord)
    {
        <section class="panel" style="margin-top: 1rem;">
            <h2>@L($"Historial reciente del {moduleSingularLower}", $"Historial recent del {moduleSingularLower}", $"Recent {moduleSingularLower} history")</h2>
            <div class="list-block">
                @if (recentAuditLogs.Count == 0)
                {
                    <p class="muted">@L($"Todavía no hay eventos auditados para este {moduleSingularLower}.", $"Encara no hi ha esdeveniments auditats per a aquest {moduleSingularLower}.", $"There are no audited events for this {moduleSingularLower} yet.")</p>
                }
                else
                {
                    @foreach (var entry in recentAuditLogs)
                    {
                        <article class="list-item">
                            <strong>@entry.Action</strong>
                            @if (!string.IsNullOrWhiteSpace(entry.Details))
                            {
                                <span>@entry.Details</span>
                            }
                            <span>@entry.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </article>
                    }
                }
            </div>
        </section>
    }
}

@code {
    [Parameter]
    public string? Code { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isReadOnly;
    private bool IsComplementMode => NavigationManager.Uri.Contains("/articulos/complementos", StringComparison.OrdinalIgnoreCase);
    private bool IsNewRoute => EditRouteMode.IsCreateRoute(
        NavigationManager,
        "articulos/muestras/nueva",
        "articulos/complementos/nueva");
    private bool HasExistingRecord => !IsNewRoute && !string.IsNullOrWhiteSpace(Code);
    private string CurrentCode => HasExistingRecord ? Uri.UnescapeDataString(Code!) : string.Empty;
    private string ModulePluralTitle => IsComplementMode
        ? L("Complementos", "Complements", "Complements")
        : L("Muestras", "Mostres", "Samples");
    private string ModuleSingularTitle => IsComplementMode
        ? L("Complemento", "Complement", "Complement")
        : L("Muestra", "Mostra", "Sample");
    private string modulePluralLower => IsComplementMode
        ? L("complementos", "complements", "complements")
        : L("muestras", "mostres", "samples");
    private string moduleSingularLower => IsComplementMode
        ? L("complemento", "complement", "complement")
        : L("muestra", "mostra", "sample");
    private MuestraDetailDto model = new();
    private string duplicateSearch = string.Empty;
    private bool isSearchingDuplicates;
    private IReadOnlyCollection<MuestraListItemDto> duplicateCandidates = [];
    private IReadOnlyCollection<BaseCatalogListItemDto> machineOptions = [];
    private IReadOnlyCollection<BaseCatalogListItemDto> operationOptions = [];
    private string? duplicateQueryAppliedKey;
    private string statusMessage = string.Empty;
    private bool isError;
    private bool isLegacySyncActive;
    private string syncStatusLabel = string.Empty;
    private IReadOnlyCollection<AuditLogEntryDto> recentAuditLogs = [];
    private IReadOnlyCollection<ParteAcabadoListItemDto> linkedFinishOrders = [];
    private bool isLoadingLinkedFinishOrders;
    private MuestraTab activeTab = MuestraTab.Ficha;
    private int selectedBreakdownLineNumber;
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    private int LineCount => model.Lines.Count;
    private int DistinctColorCount => model.Lines.Select(line => NormalizeToken(line.Color)).Where(value => !string.IsNullOrWhiteSpace(value)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    private int DistinctSizeCount => model.Lines.Select(BuildSizeLabel).Where(value => !string.IsNullOrWhiteSpace(value)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    private int DistinctClientCount => model.Lines.Select(line => line.ClientCode).Where(code => code > 0).Distinct().Count();
    private decimal TotalCostPrice => model.Lines.Sum(line => line.CostPrice);
    private decimal TotalSalePrice => model.Lines.Sum(line => line.SalePrice);
    private decimal AverageCostPrice => model.Lines.Count == 0 ? 0m : model.Lines.Average(line => line.CostPrice);
    private decimal AverageSalePrice => model.Lines.Count == 0 ? 0m : model.Lines.Average(line => line.SalePrice);
    private decimal AverageMarginPercent => model.Lines.Count == 0
        ? model.MarginPercent
        : model.Lines
            .Where(line => line.SalePrice > 0)
            .Select(CalculateLineMarginPercent)
            .DefaultIfEmpty(model.MarginPercent)
            .Average();
    private string DisplayOrigin => string.IsNullOrWhiteSpace(model.Origin) ? "local" : model.Origin;
