    private async Task SearchDuplicateCandidatesAsync()
    {
        duplicateCandidates = [];
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        isSearchingDuplicates = true;
        try
        {
            var result = await MuestraQueries.SearchAsync(tenantId.Value, companyId.Value, new MuestraFilter
            {
                Search = duplicateSearch,
                Page = 1,
                PageSize = 12,
                SortColumn = nameof(MuestraListItemDto.Code)
            });

            duplicateCandidates = result.Items
                .Where(item => !string.IsNullOrWhiteSpace(item.Code))
                .OrderBy(item => item.Code, StringComparer.OrdinalIgnoreCase)
                .ThenBy(item => item.ClientCode)
                .ToArray();
        }
        finally
        {
            isSearchingDuplicates = false;
        }
    }

    private async Task TryApplyDuplicateFromQueryAsync()
    {
        if (!IsComplementMode || HasExistingRecord || !tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var uri = new Uri(NavigationManager.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (!query.TryGetValue("duplicateCode", out var duplicateCodeValues))
        {
            return;
        }

        var duplicateCode = duplicateCodeValues.FirstOrDefault()?.Trim();
        var duplicateClient = query.TryGetValue("duplicateClient", out var duplicateClientValues)
            && int.TryParse(duplicateClientValues.FirstOrDefault(), out var parsedClient)
                ? parsedClient
                : 0;

        if (string.IsNullOrWhiteSpace(duplicateCode) || duplicateClient <= 0)
        {
            return;
        }

        var key = $"{duplicateCode}|{duplicateClient}";
        if (string.Equals(duplicateQueryAppliedKey, key, StringComparison.Ordinal))
        {
            return;
        }

        duplicateQueryAppliedKey = key;
        await ApplyDuplicateBaseAsync(duplicateCode, duplicateClient);
    }

    private async Task ApplyDuplicateBaseAsync(string sourceCode, int sourceClientCode)
    {
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var source = await MuestraQueries.GetByIdentityAsync(tenantId.Value, companyId.Value, sourceCode, sourceClientCode);
        if (source is null)
        {
            statusMessage = L("No se ha encontrado el complemento base seleccionado.", "No s'ha trobat el complement base seleccionat.", "The selected base complement was not found.");
            isError = true;
            return;
        }

        var targetCode = model.Code;
        var targetClientCode = model.ClientCode;
        var targetClientName = model.ClientName;
        var targetCenter = model.CompanyCenterCode;

        model = CloneMuestraForDuplication(source, targetCode, targetClientCode, targetClientName, targetCenter);
        EnsureBreakdownState();
            statusMessage = $"{L("Base cargada desde el complemento", "Base carregada des del complement", "Base loaded from complement")} {source.Code} {L("del cliente", "del client", "for client")} {source.ClientCode}.";
        isError = false;
    }

    private async Task SaveAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        if (isReadOnly)
        {
            statusMessage = L("No tienes permisos de edición en este tenant.", "No tens permisos d'edició en aquest tenant.", "You do not have edit permissions in this tenant.");
            isError = true;
            return;
        }

        try
        {
            statusMessage = string.Empty;
            isError = false;
            var isNew = !HasExistingRecord;

            var savedCode = await MuestraService.SaveAsync(new SaveMuestraCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                IsNew = isNew,
                Code = isNew ? model.Code : CurrentCode,
                Description = model.Description,
                ClientCode = model.ClientCode,
                ClientName = model.ClientName,
                Reference = model.Reference,
                Season = model.Season,
                MachineCode = model.MachineCode,
                MachineName = model.MachineName,
                MarginPercent = model.MarginPercent,
                VatCode = model.VatCode,
                Notes = model.Notes,
                Composition = model.Composition,
                UnitPrice = model.UnitPrice,
                Lines = model.Lines
                    .OrderBy(item => item.LineNumber)
                    .Select(item => new SaveMuestraLineInput
                    {
                        LineNumber = item.LineNumber,
                        SizeCode = item.SizeCode,
                        SizeHigh = item.SizeHigh,
                        SizeLow = item.SizeLow,
                        Description = item.Description,
                        CostPrice = item.CostPrice,
                        SalePrice = item.SalePrice,
                        Color = item.Color,
                        ClientCode = item.ClientCode,
                        ClientName = item.ClientName,
                        NcCode = item.NcCode
                    })
                    .ToList(),
                Breakdowns = model.Lines
                    .OrderBy(item => item.LineNumber)
                    .Select(item => item.Breakdown ?? CreateBreakdownForLine(item))
                    .Select(item => new SaveMuestraBreakdownInput
                    {
                        SampleLineNumber = item.SampleLineNumber,
                        WorkDate = item.WorkDate,
                        ClientCode = item.ClientCode,
                        ClientName = item.ClientName,
                        MachineCode = item.MachineCode,
                        MachineName = item.MachineName,
                        OperationCode = item.OperationCode,
                        OperationName = item.OperationName,
                        Needles = item.Needles,
                        Speed = item.Speed,
                        Disk = item.Disk,
                        TimeMinutes = item.TimeMinutes,
                        MachineRate = item.MachineRate,
                        Cuts = item.Cuts,
                        Notes = item.Notes,
                        Lines = item.Lines
                            .OrderBy(line => line.LineNumber)
                            .Select(line => new SaveMuestraBreakdownLineInput
                            {
                                LineNumber = line.LineNumber,
                                YarnCode = line.YarnCode,
                                ProviderCode = line.ProviderCode,
                                ProviderName = line.ProviderName,
                                MaterialColor = line.MaterialColor,
                                YarnMetric = line.YarnMetric,
                                Ends = line.Ends,
                                Passes = line.Passes,
                                Graduation = line.Graduation,
                                Consumption = line.Consumption,
                                Price = line.Price
                            })
                            .ToList()
                    })
                    .ToList()
            });

            statusMessage = !isNew
            ? $"{ModuleSingularTitle} {L("actualizado correctamente.", "actualitzat correctament.", "updated successfully.")}"
            : $"{ModuleSingularTitle} {L("creado correctamente.", "creat correctament.", "created successfully.")}";

            if (isNew)
            {
                NavigationManager.NavigateTo(BuildEditUrl(savedCode), forceLoad: false);
                return;
            }

            await LoadAuditAsync();
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

