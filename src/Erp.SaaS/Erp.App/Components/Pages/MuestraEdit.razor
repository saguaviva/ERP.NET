                    @if (string.IsNullOrWhiteSpace(model.Code))
                    {
                        <p class="muted">@L("Guarda primero la ficha para poder generar y seguir órdenes de fabricación.", "Desa primer la fitxa per poder generar i seguir ordres de fabricació.", "Save the sheet first to generate and track manufacturing orders.")</p>
                    }
                    else
                    {
                        <div class="summary-card-grid">
                            <article class="summary-card">
                                <span class="summary-card-label">@L("Órdenes", "Ordres", "Orders")</span>
