@page "/Error"
@using System.Diagnostics
@inject AppText T

<PageTitle>@T["error.title"]</PageTitle>

<h1 class="text-danger">@T["error.heading"]</h1>
<h2 class="text-danger">@T["error.subheading"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@T["error.requestId"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@T["error.devMode"]</h3>
<p>@T["error.devText1"]</p>
<p>
    <strong>@T["error.devText2"]</strong>
    @T["error.devText3"]
</p>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
