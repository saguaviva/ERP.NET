@page "/articulos/models"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IModeloQueries ModeloQueries
@inject ILegacySyncService LegacySyncService
@inject NavigationManager NavigationManager
@inject AppText T

<PageTitle>@L("Artículos / Models", "Articles / Models", "Articles / Models")</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("ARTÍCULOS", "ARTICLES", "ARTICLES")</p>
        <h1>@L("Models", "Models", "Models")</h1>
        <p class="lead">@(isLegacySyncActive
            ? L("Consulta y filtra los models replicados en la SaaS local. La sync manual refresca solo registros con origen legacy.",
                "Consulta i filtra els models replicats a la SaaS local. La sync manual refresca només registres amb origen legacy.",
                "Browse and filter models replicated in the local SaaS database. Manual sync only refreshes legacy-origin records.")
            : L("Consulta y filtra los models del centro legacy asociado a la empresa activa.",
                "Consulta i filtra els models del centre legacy associat a l'empresa activa.",
                "Browse and filter models from the legacy center linked to the active company."))</p>
    </div>
    <div class="quick-links">
        @if (canEdit)
        {
            <a class="primary-button link-button" href="/articulos/models/nuevo">@L("Nuevo model", "Nou model", "New model")</a>
        }
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("Selecciona una empresa activa para trabajar con models.", "Selecciona una empresa activa per treballar amb models.", "Select an active company to work with models.")</p>
    </div>
}
else
{
    <section class="panel">
        <div class="filter-row">
            <input class="text-input" @bind="filter.Search" placeholder="@L("Buscar por código, descripción, cliente, tejido o código de model", "Buscar per codi, descripció, client, teixit o codi de model", "Search by code, description, client, fabric or model code")" />
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? L("Cargando...", "Carregant...", "Loading...") : L("Buscar", "Buscar", "Search"))</button>
        </div>
        <div class="form-grid" style="margin-top: 1rem; margin-bottom: 0;">
            <label class="field">
                <span>@L("Temporada", "Temporada", "Season")</span>
                <InputText class="text-input" @bind-Value="filter.Season" />
            </label>
            <label class="field">
                <span>@L("Serie", "Sèrie", "Series")</span>
                <InputText class="text-input" @bind-Value="filter.Series" />
            </label>
        </div>
        <div class="filter-row results-toolbar" style="margin-top: 0.85rem;">
            <span class="results-summary">
                @(totalCount == 0
                    ? L("Sin resultados", "Sense resultats", "No results")
                    : string.Format(L("Mostrando {0}-{1} de {2} models", "Mostrant {0}-{1} de {2} models", "Showing {0}-{1} of {2} models"), PageStart, PageEnd, totalCount))
            </span>
            <label class="field compact-field">
                <span>@L("Tamaño de página", "Mida de pàgina", "Page size")</span>
                <select class="sidebar-select compact-select" value="@filter.PageSize" @onchange="OnPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }

    @if (isLegacySyncActive)
    {
        <div class="alert">
            @L("Artículos / Models está en convivencia con legacy para esta empresa.", "Articles / Models està en convivència amb legacy per a aquesta empresa.", "Articles / Models is running in coexistence with legacy for this company.")
            @L("La web guarda cambios solo en la SaaS local y la sync manual refresca únicamente registros de origen legacy.", "La web desa canvis només a la SaaS local i la sync manual refresca únicament registres d'origen legacy.", "The web app saves changes only in the local SaaS database and manual sync only refreshes legacy-origin records.")
            @if (!string.IsNullOrWhiteSpace(syncStatusLabel))
            {
                <span>@syncStatusLabel</span>
            }
        </div>
    }

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)" aria-busy="@isLoading">
        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>@L("Cargando models...", "Carregant models...", "Loading models...")</span>
            </div>
        }

        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <SortableHeader Label="@L("Código", "Codi", "Code")" IsActive="@(sortColumn == nameof(ModeloListItemDto.Code))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ModeloListItemDto.Code)))" />
                        <SortableHeader Label="@L("Descripción", "Descripció", "Description")" IsActive="@(sortColumn == nameof(ModeloListItemDto.Description))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ModeloListItemDto.Description)))" />
                        <SortableHeader Label="@L("Temporada", "Temporada", "Season")" IsActive="@(sortColumn == nameof(ModeloListItemDto.Season))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ModeloListItemDto.Season)))" />
                        <SortableHeader Label="@L("Serie", "Sèrie", "Series")" IsActive="@(sortColumn == nameof(ModeloListItemDto.Series))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ModeloListItemDto.Series)))" />
                        <SortableHeader Label="@L("Cliente", "Client", "Client")" IsActive="@(sortColumn == nameof(ModeloListItemDto.ClientName))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ModeloListItemDto.ClientName)))" />
                        <SortableHeader Label="@L("Tejido", "Teixit", "Fabric")" IsActive="@(sortColumn == nameof(ModeloListItemDto.FabricCode))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ModeloListItemDto.FabricCode)))" />
                        <SortableHeader Label="@L("Coste", "Cost", "Cost")" IsActive="@(sortColumn == nameof(ModeloListItemDto.CostPrice))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ModeloListItemDto.CostPrice), true))" />
                        <SortableHeader Label="@L("Venta final", "Venda final", "Final sale")" IsActive="@(sortColumn == nameof(ModeloListItemDto.FinalSalePrice))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ModeloListItemDto.FinalSalePrice), true))" />
                        <th>@L("Detalle", "Detall", "Detail")</th>
                        <SortableHeader Label="@L("Origen", "Origen", "Origin")" IsActive="@(sortColumn == nameof(ModeloListItemDto.Origin))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(ModeloListItemDto.Origin)))" />
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        @for (var index = 0; index < 5; index++)
                        {
                            <tr class="table-skeleton-row">
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                            </tr>
                        }
                    }
                    else if (items.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="table-empty">@L("No hay models para mostrar.", "No hi ha models per mostrar.", "There are no models to display.")</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in items)
                        {
                            <tr>
                                <td><a class="inline-link" href="@BuildEditUrl(item.Id)">@item.Code</a></td>
                                <td>@item.Description</td>
                                <td>@item.Season</td>
                                <td>@item.Series</td>
                                <td>@(string.IsNullOrWhiteSpace(item.ClientName) ? $"Cliente {item.ClientCode}" : item.ClientName)</td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(item.FabricCode))
                                    {
                                        <span class="muted">-</span>
                                    }
                                    else
                                    {
                                        <a class="inline-link" href="@BuildTejidoUrl(item.FabricCode)">@item.FabricCode</a>
                                    }
                                </td>
                                <td>@item.CostPrice.ToUiString("0.00##")</td>
                                <td>@item.FinalSalePrice.ToUiString("0.00##")</td>
                                <td>@($"{item.ScandalloLinesCount} {L("esc.", "esc.", "bom.")} · {item.ColorsCount} {L("col.", "col.", "col.")} · {item.ForniturasCount} {L("forn.", "forn.", "trim.")}")</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Origin) ? L("local", "local", "local") : item.Origin)</td>
                                <td>
                                    <a class="inline-link" href="@BuildEditUrl(item.Id)">@(canEdit ? L("Abrir ficha", "Obrir fitxa", "Open record") : L("Ver ficha", "Veure fitxa", "View record"))</a>
                                    <span class="muted"> · </span>
                                    <a class="inline-link" href="@BuildPrintUrl(item.Id)">@L("Imprimir", "Imprimir", "Print")</a>
                                    @if (canEdit)
                                    {
                                        <span class="muted"> · </span>
                                        <a class="inline-link" href="@BuildManufacturingOrderUrl(item.Id)">@L("Crear orden", "Crear ordre", "Create order")</a>
                                    }
                                    <span class="muted"> · </span>
                                    <a class="inline-link" href="@BuildManufacturingOrdersListUrl(item.Code)">@L("Órdenes", "Ordres", "Orders")</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-bar">
            <span class="muted">@string.Format(L("Página {0} de {1}", "Pàgina {0} de {1}", "Page {0} of {1}"), filter.Page, TotalPages)</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePageAsync(1)" disabled="@(!CanGoPrevious || isLoading)">@L("Primera", "Primera", "First")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page - 1)" disabled="@(!CanGoPrevious || isLoading)">@L("Anterior", "Anterior", "Previous")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page + 1)" disabled="@(!CanGoNext || isLoading)">@L("Siguiente", "Següent", "Next")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(TotalPages)" disabled="@(!CanGoNext || isLoading)">@L("Última", "Última", "Last")</button>
            </div>
        </div>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "season")]
    public string? SeasonQuery { get; set; }

    [SupplyParameterFromQuery(Name = "series")]
    public string? SeriesQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? PageSizeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortQuery { get; set; }

    [SupplyParameterFromQuery(Name = "desc")]
    public bool? DescQuery { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isLoading;
    private bool isLegacySyncActive;
    private string syncStatusLabel = string.Empty;
    private string errorMessage = string.Empty;
    private string sortColumn = nameof(ModeloListItemDto.Season);
    private bool sortDescending;
    private int totalCount;
    private ModeloFilter filter = new() { Page = 1, PageSize = 25, SortColumn = nameof(ModeloListItemDto.Season) };
    private IReadOnlyCollection<ModeloListItemDto> items = [];

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)filter.PageSize));
    private bool CanGoPrevious => filter.Page > 1;
    private bool CanGoNext => filter.Page < TotalPages;
    private int PageStart => totalCount == 0 ? 0 : ((filter.Page - 1) * filter.PageSize) + 1;
    private int PageEnd => totalCount == 0 ? 0 : Math.Min(filter.Page * filter.PageSize, totalCount);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);
        await LoadSyncStatusAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        ApplyQueryState();
        await LoadAsync();
    }

    private async Task LoadSyncStatusAsync()
    {
        isLegacySyncActive = false;
        syncStatusLabel = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        var status = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
            .FirstOrDefault(item =>
                item.CompanyId == companyId.Value &&
                string.Equals(item.ModuleKey, LegacySyncModuleKeys.ArticleModels, StringComparison.OrdinalIgnoreCase));

        if (status is null || !status.HasSuccessfulSync)
        {
            return;
        }

        isLegacySyncActive = true;
        syncStatusLabel = status.LastCompletedUtc.HasValue
            ? $"{L("Última sync", "Última sync", "Last sync")}: {status.LastCompletedUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss} · Ins: {status.LastInserted} · Act: {status.LastUpdated} · Omi: {status.LastSkipped} · Err: {status.LastErrors}"
            : string.Empty;
    }

    private void ApplyQueryState()
    {
        filter.Search = SearchQuery?.Trim() ?? string.Empty;
        filter.Season = SeasonQuery?.Trim().ToUpperInvariant() ?? string.Empty;
        filter.Series = SeriesQuery?.Trim().ToUpperInvariant() ?? string.Empty;
        filter.Page = Math.Max(PageQuery ?? 1, 1);
        filter.PageSize = PageSizeQuery is 25 or 50 or 100 ? PageSizeQuery.Value : 25;
        sortColumn = string.IsNullOrWhiteSpace(SortQuery) ? nameof(ModeloListItemDto.Season) : SortQuery!;
        sortDescending = DescQuery ?? false;
        filter.SortColumn = sortColumn;
        filter.SortDescending = sortDescending;
    }

    private async Task LoadAsync()
    {
        errorMessage = string.Empty;
        items = [];
        totalCount = 0;

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        isLoading = true;
        try
        {
            var result = await ModeloQueries.SearchAsync(tenantId.Value, companyId.Value, filter);
            items = result.Items;
            totalCount = result.TotalCount;
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task SearchAsync()
    {
        filter.Page = 1;
        return ReloadFromCurrentStateAsync();
    }

    private async Task SetSortAsync(string column, bool defaultDescending = false)
    {
        if (sortColumn == column)
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = defaultDescending;
        }

        filter.SortColumn = sortColumn;
        filter.SortDescending = sortDescending;
        filter.Page = 1;
        await ReloadFromCurrentStateAsync();
    }

    private async Task ChangePageAsync(int page)
    {
        filter.Page = Math.Clamp(page, 1, TotalPages);
        await ReloadFromCurrentStateAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            filter.PageSize = Math.Clamp(pageSize, 10, 200);
            filter.Page = 1;
            await ReloadFromCurrentStateAsync();
        }
    }

    private async Task ReloadFromCurrentStateAsync()
    {
        NavigationManager.NavigateTo(BuildCurrentUrl(), replace: true);
        await LoadAsync();
    }

    private string BuildCurrentUrl()
    {
        var parameters = new List<string>();
        AddQuery(parameters, "q", filter.Search);
        AddQuery(parameters, "season", filter.Season);
        AddQuery(parameters, "series", filter.Series);

        if (filter.Page > 1)
        {
            parameters.Add($"page={filter.Page}");
        }

        if (filter.PageSize != 25)
        {
            parameters.Add($"pageSize={filter.PageSize}");
        }

        if (!string.Equals(sortColumn, nameof(ModeloListItemDto.Season), StringComparison.Ordinal))
        {
            parameters.Add($"sort={Uri.EscapeDataString(sortColumn)}");
        }

        if (sortDescending)
        {
            parameters.Add("desc=true");
        }

        return parameters.Count == 0
            ? "/articulos/models"
            : $"/articulos/models?{string.Join("&", parameters)}";
    }

    private static void AddQuery(List<string> parameters, string key, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            parameters.Add($"{key}={Uri.EscapeDataString(value)}");
        }
    }

    private static string BuildEditUrl(Guid id) => $"/articulos/models/editar/{id}";
    private static string BuildPrintUrl(Guid id) => $"/articulos/models/{id}/imprimir";
    private static string BuildManufacturingOrderUrl(Guid id) => $"/compras/ordenes-fabricacion-models/nueva?modelId={Uri.EscapeDataString(id.ToString())}";
    private static string BuildManufacturingOrdersListUrl(string code) => $"/compras/ordenes-fabricacion-models?sourceKind=model&sourceCode={Uri.EscapeDataString(code)}";

    private static string BuildTejidoUrl(string fabricCode) =>
        $"/articulos/tejidos/editar/{Uri.EscapeDataString(fabricCode)}";

    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };
}
