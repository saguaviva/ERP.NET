@page "/almacen/traspasos/nuevo"
@page "/almacen/traspasos/editar/{TransferNumber:int}"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IStockQueries StockQueries
@inject IStockService StockService
@inject AppText T

<PageTitle>@(TransferNumber.HasValue ? $"{L("Traspaso", "Traspàs", "Transfer")} {TransferNumber}" : L("Nuevo traspaso", "Nou traspàs", "New transfer"))</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@L("Almacén", "Magatzem", "Warehouse")</p>
        <h1>@(TransferNumber.HasValue ? $"{L("Traspaso", "Traspàs", "Transfer")} {TransferNumber}" : L("Nuevo traspaso", "Nou traspàs", "New transfer"))</h1>
        <p class="lead">@L("Movimiento interno entre almacenes con salida del origen y entrada automática en el destino al completar.", "Moviment intern entre magatzems amb sortida de l'origen i entrada automàtica al destí en completar.", "Internal transfer between warehouses with outbound movement from the source and automatic inbound movement to the destination on completion.")</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="/almacen/traspasos">@L("Volver al listado", "Tornar al llistat", "Back to list")</a>
        <a class="secondary-button link-button" href="/almacen/inventarios">@L("Ver inventarios", "Veure inventaris", "View counts")</a>
        <a class="secondary-button link-button" href="/almacen/movimientos">@L("Ver movimientos", "Veure moviments", "View movements")</a>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("No hay empresa activa seleccionada.", "No hi ha cap empresa activa seleccionada.", "There is no active company selected.")</p>
    </div>
}
else if (!canEdit && !TransferNumber.HasValue)
{
    <div class="empty-state">
        <p>@L("No tienes permisos para crear traspasos de almacén.", "No tens permisos per crear traspassos de magatzem.", "You do not have permission to create warehouse transfers.")</p>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "danger" : "success")">@statusMessage</div>
    }

    <section class="card-grid">
        <article class="info-card">
            <p class="eyebrow">@L("Número", "Número", "Number")</p>
            <h2>@DisplayNumber</h2>
            <p class="muted">@L("Identificador interno del traspaso.", "Identificador intern del traspàs.", "Internal transfer identifier.")</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Estado", "Estat", "Status")</p>
            <h2>@FormatStatus(model.Status)</h2>
            <p class="muted">@L("Borrador editable o completado con movimientos generados.", "Esborrany editable o completat amb moviments generats.", "Editable draft or completed transfer with generated movements.")</p>
        </article>
        <article class="info-card">
            <p class="eyebrow">@L("Líneas", "Línies", "Lines")</p>
            <h2>@model.Lines.Count</h2>
            <p class="muted">@L("Posiciones incluidas en el traslado.", "Posicions incloses en el trasllat.", "Positions included in the transfer.")</p>
        </article>
        <article class="info-card accent-card">
            <p class="eyebrow">@L("Cantidad total", "Quantitat total", "Total quantity")</p>
            <h2>@model.Lines.Sum(line => line.Quantity).ToUiString("0.###")</h2>
            <p class="muted">@L("Suma de cantidades de todas las líneas.", "Suma de quantitats de totes les línies.", "Sum of quantities across all lines.")</p>
        </article>
    </section>

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <fieldset disabled="@isReadOnly">
            <div class="form-grid" style="margin-top: 1rem;">
                <label class="field">
                    <span>@L("Fecha", "Data", "Date")</span>
                    <InputDate class="text-input" @bind-Value="model.TransferDate" />
                </label>
                <label class="field">
                    <span>@L("Estado", "Estat", "Status")</span>
                    <InputSelect class="text-input" @bind-Value="model.Status">
                        @foreach (var status in StockTransferStatuses.All)
                        {
                            <option value="@status">@FormatStatus(status)</option>
                        }
                    </InputSelect>
                </label>
                <label class="field">
                    <span>@L("Almacén origen", "Magatzem origen", "Source warehouse")</span>
                    <InputText class="text-input" @bind-Value="model.FromWarehouse" />
                </label>
                <label class="field">
                    <span>@L("Almacén destino", "Magatzem destí", "Destination warehouse")</span>
                    <InputText class="text-input" @bind-Value="model.ToWarehouse" />
                </label>
                <label class="field wide">
                    <span>@L("Notas", "Notes", "Notes")</span>
                    <InputTextArea class="text-area" @bind-Value="model.Notes" />
                </label>
            </div>

            <section class="panel detail-panel" style="margin-top: 1rem;">
                <div class="detail-panel-header">
                    <div>
                        <h2>@L("Líneas del traspaso", "Línies del traspàs", "Transfer lines")</h2>
                        <p class="muted">@L("Artículo, color, cantidad y unidad a mover entre almacenes.", "Article, color, quantitat i unitat a moure entre magatzems.", "Item, color, quantity and unit to move between warehouses.")</p>
                    </div>
                    @if (!isReadOnly)
                    {
                        <button class="secondary-button" type="button" @onclick="AddLine">@L("Añadir línea", "Afegir línia", "Add line")</button>
                    }
                </div>

                <div class="table-scroll">
                    <table class="data-table detail-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>@L("Artículo", "Article", "Item")</th>
                                <th>@L("Descripción", "Descripció", "Description")</th>
                                <th>@L("Color", "Color", "Color")</th>
                                <th>@L("Cantidad", "Quantitat", "Quantity")</th>
                                <th>@L("Unidad", "Unitat", "Unit")</th>
                                <th>@L("Notas", "Notes", "Notes")</th>
                                <th>@L("Acciones", "Accions", "Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (model.Lines.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="muted">@L("No hay líneas cargadas todavía.", "Encara no hi ha línies carregades.", "There are no lines loaded yet.")</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var line in model.Lines.OrderBy(item => item.LineNumber))
                                {
                                    <tr @key="line.LineNumber">
                                        <td>@line.LineNumber</td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.ItemCode" /></td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.ItemDescription" /></td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.Color" /></td>
                                        <td><InputNumber class="text-input table-input" @bind-Value="line.Quantity" /></td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.UnitOfMeasure" /></td>
                                        <td><InputText class="text-input table-input" @bind-Value="line.Notes" /></td>
                                        <td>
                                            <div class="table-actions">
                                                @if (!string.IsNullOrWhiteSpace(line.ItemDescription))
                                                {
                                                    <a class="inline-link" href="@BuildMovementsUrl(line, model.FromWarehouse)">@L("Movs. origen", "Movs. origen", "Source moves")</a>
                                                    <a class="inline-link" href="@BuildMovementsUrl(line, model.ToWarehouse)">@L("Movs. destino", "Movs. destí", "Destination moves")</a>
                                                }
                                                @if (!isReadOnly)
                                                {
                                                    <button class="secondary-button danger-button" type="button" @onclick="() => RemoveLine(line.LineNumber)">@L("Quitar", "Treure", "Remove")</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            @if (canEdit)
            {
                <div class="quick-links" style="margin-top: 1rem;">
                    <button class="primary-button" type="submit">@L("Guardar", "Desar", "Save")</button>
                    @if (TransferNumber.HasValue && !isReadOnly)
                    {
                        <button class="secondary-button danger-button" type="button" @onclick="DeleteAsync">@L("Eliminar", "Eliminar", "Delete")</button>
                    }
                </div>
            }
        </fieldset>
    </EditForm>
}

@code {
    [Parameter]
    public int? TransferNumber { get; set; }

    [SupplyParameterFromQuery]
    public string? FromWarehouse { get; set; }

    [SupplyParameterFromQuery]
    public string? ItemCode { get; set; }

    [SupplyParameterFromQuery]
    public string? Description { get; set; }

    [SupplyParameterFromQuery]
    public string? Unit { get; set; }

    [SupplyParameterFromQuery]
    public decimal? Quantity { get; set; }

    private Guid? tenantId;
    private Guid? companyId;
    private bool canEdit;
    private bool isReadOnly;
    private bool isError;
    private string statusMessage = string.Empty;
    private StockTransferDetailDto model = new()
    {
        Status = StockTransferStatuses.Draft,
        TransferDate = DateTime.Today
    };

    private string DisplayNumber => TransferNumber?.ToString() ?? L("Nuevo", "Nou", "New");
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        canEdit = user.IsPlatformAdmin() || user.IsInRole(PlatformRoles.TenantAdmin);

        if (!tenantId.HasValue || !companyId.HasValue)
        {
            return;
        }

        if (TransferNumber.HasValue)
        {
            var detail = await StockQueries.GetTransferByNumberAsync(tenantId.Value, companyId.Value, TransferNumber.Value);
            if (detail is null)
            {
                statusMessage = L("No se ha encontrado el traspaso solicitado.", "No s'ha trobat el traspàs sol·licitat.", "The requested transfer could not be found.");
                isError = true;
                model = new StockTransferDetailDto();
                isReadOnly = true;
                return;
            }

            model = detail;
        }
        else if (model.Lines.Count == 0)
        {
            model = new StockTransferDetailDto
            {
                Status = StockTransferStatuses.Draft,
                TransferDate = DateTime.Today,
                Lines =
                [
                    new StockTransferLineDto { LineNumber = 1, UnitOfMeasure = "kg" }
                ]
            };
        }

        if (!TransferNumber.HasValue && model.Lines.Count > 0)
        {
            model.FromWarehouse = FromWarehouse?.Trim() ?? model.FromWarehouse;
            model.Lines[0].ItemCode = ItemCode?.Trim() ?? model.Lines[0].ItemCode;
            model.Lines[0].ItemDescription = Description?.Trim() ?? model.Lines[0].ItemDescription;
            model.Lines[0].UnitOfMeasure = Unit?.Trim() ?? model.Lines[0].UnitOfMeasure;
            model.Lines[0].Quantity = Quantity ?? model.Lines[0].Quantity;
        }

        isReadOnly = !canEdit ||
            string.Equals(model.Status, StockTransferStatuses.Completed, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(model.Status, StockTransferStatuses.Cancelled, StringComparison.OrdinalIgnoreCase);
    }

    private async Task SaveAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !canEdit)
        {
            return;
        }

        try
        {
            statusMessage = string.Empty;
            isError = false;

            var transferNumber = await StockService.SaveTransferAsync(new SaveStockTransferCommand
            {
                TenantId = tenantId.Value,
                CompanyId = companyId.Value,
                TransferNumber = TransferNumber,
                TransferDate = model.TransferDate,
                Status = model.Status,
                FromWarehouse = model.FromWarehouse,
                ToWarehouse = model.ToWarehouse,
                Notes = model.Notes,
                Lines = model.Lines
                    .OrderBy(line => line.LineNumber)
                    .Select(line => new StockTransferLineDto
                    {
                        LineNumber = line.LineNumber,
                        ItemCode = line.ItemCode,
                        ItemDescription = line.ItemDescription,
                        Color = line.Color,
                        Quantity = line.Quantity,
                        UnitOfMeasure = line.UnitOfMeasure,
                        Notes = line.Notes
                    })
                    .ToList()
            });

            if (!TransferNumber.HasValue)
            {
                NavigationManager.NavigateTo($"/almacen/traspasos/editar/{transferNumber}", false);
                return;
            }

            statusMessage = L("Traspaso guardado correctamente.", "Traspàs desat correctament.", "Transfer saved successfully.");
            var detail = await StockQueries.GetTransferByNumberAsync(tenantId.Value, companyId.Value, transferNumber);
            if (detail is not null)
            {
                model = detail;
                isReadOnly = string.Equals(model.Status, StockTransferStatuses.Completed, StringComparison.OrdinalIgnoreCase) ||
                             string.Equals(model.Status, StockTransferStatuses.Cancelled, StringComparison.OrdinalIgnoreCase);
            }
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private async Task DeleteAsync()
    {
        if (!tenantId.HasValue || !companyId.HasValue || !TransferNumber.HasValue || !canEdit)
        {
            return;
        }

        try
        {
            await StockService.DeleteTransferAsync(tenantId.Value, companyId.Value, TransferNumber.Value);
            NavigationManager.NavigateTo("/almacen/traspasos", false);
        }
        catch (Exception exception)
        {
            statusMessage = exception.Message;
            isError = true;
        }
    }

    private void AddLine()
    {
        var nextNumber = model.Lines.Count == 0 ? 1 : model.Lines.Max(line => line.LineNumber) + 1;
        model.Lines.Add(new StockTransferLineDto
        {
            LineNumber = nextNumber,
            UnitOfMeasure = "kg"
        });
    }

    private void RemoveLine(int lineNumber)
    {
        var line = model.Lines.FirstOrDefault(item => item.LineNumber == lineNumber);
        if (line is null)
        {
            return;
        }

        model.Lines.Remove(line);
        var ordered = model.Lines.OrderBy(item => item.LineNumber).ToList();
        for (var index = 0; index < ordered.Count; index++)
        {
            ordered[index].LineNumber = index + 1;
        }
    }

    private string BuildMovementsUrl(StockTransferLineDto line, string warehouse)
    {
        var search = string.IsNullOrWhiteSpace(line.Color)
            ? $"{line.ItemCode} {line.ItemDescription}".Trim()
            : $"{line.ItemCode} {line.Color}".Trim();

        return NavigationManager.GetUriWithQueryParameters("/almacen/movimientos", new Dictionary<string, object?>
        {
            ["search"] = string.IsNullOrWhiteSpace(search) ? null : search,
            ["warehouse"] = string.IsNullOrWhiteSpace(warehouse) ? null : warehouse
        });
    }

    private string FormatStatus(string status) => status switch
    {
        StockTransferStatuses.Draft => L("Borrador", "Esborrany", "Draft"),
        StockTransferStatuses.Completed => L("Completado", "Completat", "Completed"),
        StockTransferStatuses.Cancelled => L("Anulado", "Anul·lat", "Cancelled"),
        _ => status
    };
}
