@page "/ventas/facturas"
@attribute [Authorize(Roles = "TenantAdmin,TenantReader")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISalesOrderQueries SalesOrderQueries
@inject ILegacySyncService LegacySyncService
@inject AppText T

<PageTitle>@L("Ventas / Facturas", "Vendes / Factures", "Sales / Invoices")</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@T["menu.sales"]</p>
        <h1>@L("Facturas de cliente", "Factures de client", "Customer invoices")</h1>
        <p class="lead">@L("Facturas emitidas desde la pre-facturación, con trazabilidad completa hacia borradores y albaranes.", "Factures emeses des de la pre-facturació, amb traçabilitat completa cap a esborranys i albarans.", "Invoices issued from pre-invoicing with full traceability to drafts and shipments.")</p>
    </div>
    <div class="quick-links">
        <a class="secondary-button link-button" href="/ventas/pre-facturacion">@L("Volver a pre-facturación", "Tornar a pre-facturació", "Back to pre-invoicing")</a>
    </div>
</div>

@if (!tenantId.HasValue || !companyId.HasValue)
{
    <div class="empty-state">
        <p>@L("Selecciona una empresa activa para revisar las facturas de venta.", "Selecciona una empresa activa per revisar les factures de venda.", "Select an active company to review sales invoices.")</p>
    </div>
}
else
{
    @if (syncStatus?.HasSuccessfulSync == true)
    {
        <div class="alert warning">
            @L("Ventas / Facturas está en convivencia con legacy para esta empresa. La sync manual refresca solo las facturas con origen legacy; los cobros o cambios registrados en web convierten la factura a local y ya no se pisan.", "Vendes / Factures està en convivència amb legacy per a aquesta empresa. La sync manual refresca només les factures amb origen legacy; els cobraments o canvis registrats al web converteixen la factura a local i ja no es trepitgen.", "Sales / Invoices is running in legacy coexistence mode for this company. Manual sync refreshes only legacy-origin invoices; payments or changes recorded on the web turn the invoice local and it is no longer overwritten.")
            @if (syncStatus.LastCompletedUtc.HasValue)
            {
                <span>@L("Última sync:", "Última sync:", "Last sync:") @syncStatus.LastCompletedUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") · Ins: @syncStatus.LastInserted · Act: @syncStatus.LastUpdated · Omi: @syncStatus.LastSkipped · Err: @syncStatus.LastErrors</span>
            }
        </div>
    }

    <section class="panel">
        <div class="filter-row">
            <input class="text-input" @bind="filter.Search" placeholder="@L("Buscar por factura, borrador, cliente o notas", "Buscar per factura, esborrany, client o notes", "Search by invoice, draft, client or notes")" disabled="@isLoading" />
            <button class="secondary-button" @onclick="SearchAsync" disabled="@isLoading">@(isLoading ? L("Cargando...", "Carregant...", "Loading...") : L("Buscar", "Buscar", "Search"))</button>
        </div>
        <div class="filter-row results-toolbar" style="margin-top: 0.85rem;">
            <span class="results-summary">
                @(totalCount == 0
                    ? L("Sin resultados", "Sense resultats", "No results")
                    : L($"Mostrando {PageStart}-{PageEnd} de {totalCount} facturas", $"Mostrant {PageStart}-{PageEnd} de {totalCount} factures", $"Showing {PageStart}-{PageEnd} of {totalCount} invoices"))
            </span>
            <label class="field compact-field">
                <span>@L("Tamaño de página", "Mida de pàgina", "Page size")</span>
                <select class="sidebar-select compact-select" value="@filter.PageSize" @onchange="OnPageSizeChanged" disabled="@isLoading">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger">@errorMessage</div>
    }

    <section class="panel @(isLoading ? "loading-panel" : string.Empty)">
        @if (isLoading)
        {
            <div class="loading-banner">
                <span class="loading-indicator" aria-hidden="true"></span>
                <span>@L("Cargando facturas de cliente...", "Carregant factures de client...", "Loading customer invoices...")</span>
            </div>
        }

        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <SortableHeader Label="@L("Factura", "Factura", "Invoice")" IsActive="@(sortColumn == nameof(SalesInvoiceListItemDto.InvoiceNumber))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesInvoiceListItemDto.InvoiceNumber), true))" />
                        <SortableHeader Label="@L("Cliente", "Client", "Client")" IsActive="@(sortColumn == nameof(SalesInvoiceListItemDto.ClientName))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesInvoiceListItemDto.ClientName)))" />
                        <SortableHeader Label="@L("Fecha", "Data", "Date")" IsActive="@(sortColumn == nameof(SalesInvoiceListItemDto.IssueDate))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesInvoiceListItemDto.IssueDate), true))" />
                        <SortableHeader Label="@L("Vencimiento", "Venciment", "Due date")" IsActive="@(sortColumn == nameof(SalesInvoiceListItemDto.DueDate))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesInvoiceListItemDto.DueDate), true))" />
                        <SortableHeader Label="@L("Estado", "Estat", "Status")" IsActive="@(sortColumn == nameof(SalesInvoiceListItemDto.Status))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesInvoiceListItemDto.Status)))" />
                        <SortableHeader Label="@L("Cobro", "Cobrament", "Payment")" IsActive="@(sortColumn == nameof(SalesInvoiceListItemDto.PaymentStatus))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesInvoiceListItemDto.PaymentStatus)))" />
                        <SortableHeader Label="@L("Pendiente", "Pendent", "Outstanding")" IsActive="@(sortColumn == nameof(SalesInvoiceListItemDto.OutstandingAmount))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesInvoiceListItemDto.OutstandingAmount), true))" />
                        <SortableHeader Label="@L("Contabilidad", "Comptabilitat", "Accounting")" IsActive="@(sortColumn == nameof(SalesInvoiceListItemDto.AccountingStatus))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesInvoiceListItemDto.AccountingStatus)))" />
                        <SortableHeader Label="@L("Albaranes", "Albarans", "Shipments")" IsActive="@(sortColumn == nameof(SalesInvoiceListItemDto.ShipmentCount))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesInvoiceListItemDto.ShipmentCount), true))" />
                        <SortableHeader Label="@L("Total", "Total", "Total")" IsActive="@(sortColumn == nameof(SalesInvoiceListItemDto.TotalAmount))" Descending="@sortDescending" OnSort="@(() => SetSortAsync(nameof(SalesInvoiceListItemDto.TotalAmount), true))" />
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        @for (var index = 0; index < 5; index++)
                        {
                            <tr class="table-skeleton-row">
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                            </tr>
                        }
                    }
                    else if (items.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="table-empty">@L("Todavía no hay facturas emitidas.", "Encara no hi ha factures emeses.", "There are no issued invoices yet.")</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in items)
                        {
                            <tr>
                                <td>
                                    <div>@item.DisplayNumber</div>
                                    <div class="table-subtitle">
                                        @(string.Equals(item.Origin, SalesOrderOrigins.Legacy, StringComparison.OrdinalIgnoreCase)
                                            ? L("Legacy", "Legacy", "Legacy")
                                            : L($"Borrador {item.DraftNumber}", $"Esborrany {item.DraftNumber}", $"Draft {item.DraftNumber}"))
                                    </div>
                                </td>
                                <td>@item.ClientName</td>
                                <td>@item.IssueDate.ToString("dd/MM/yyyy")</td>
                                <td>@(item.DueDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td><span class="status-pill @GetInvoiceStatusClass(item.Status)">@FormatInvoiceStatus(item.Status)</span></td>
                                <td><span class="status-pill @GetPaymentStatusClass(item.PaymentStatus, item.IsOverdue)">@FormatPaymentStatus(item.PaymentStatus, item.IsOverdue)</span></td>
                                <td>@item.OutstandingAmount.ToString("0.00") €</td>
                                <td><span class="status-pill @GetAccountingStatusClass(item.AccountingStatus)">@FormatAccountingStatus(item.AccountingStatus)</span></td>
                                <td>@item.ShipmentCount</td>
                                <td>@item.TotalAmount.ToString("0.00") €</td>
                                <td>
                                    <div class="table-actions">
                                        <a class="inline-link" href="/ventas/facturas/@item.InvoiceNumber">@L("Abrir", "Obrir", "Open")</a>
                                        <a class="inline-link" href="/ventas/facturas/@item.InvoiceNumber/pdf" target="_blank">PDF</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-bar">
            <span class="muted">@L($"Página {filter.Page} de {TotalPages}", $"Pàgina {filter.Page} de {TotalPages}", $"Page {filter.Page} of {TotalPages}")</span>
            <div class="pagination-actions">
                <button class="secondary-button" @onclick="() => ChangePageAsync(1)" disabled="@(!CanGoPrevious || isLoading)">@L("Primera", "Primera", "First")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page - 1)" disabled="@(!CanGoPrevious || isLoading)">@L("Anterior", "Anterior", "Previous")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(filter.Page + 1)" disabled="@(!CanGoNext || isLoading)">@L("Siguiente", "Següent", "Next")</button>
                <button class="secondary-button" @onclick="() => ChangePageAsync(TotalPages)" disabled="@(!CanGoNext || isLoading)">@L("Última", "Última", "Last")</button>
            </div>
        </div>
    </section>
}

@code {
    private Guid? tenantId;
    private Guid? companyId;
    private bool isLoading;
    private SalesPreInvoiceFilter filter = new() { Page = 1, PageSize = 25, SortColumn = nameof(SalesInvoiceListItemDto.InvoiceNumber), SortDescending = true };
    private IReadOnlyCollection<SalesInvoiceListItemDto> items = [];
    private string errorMessage = string.Empty;
    private LegacySyncModuleStatusDto? syncStatus;
    private string sortColumn = nameof(SalesInvoiceListItemDto.InvoiceNumber);
    private bool sortDescending = true;
    private int totalCount;
    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)filter.PageSize));
    private bool CanGoPrevious => filter.Page > 1;
    private bool CanGoNext => filter.Page < TotalPages;
    private int PageStart => totalCount == 0 ? 0 : ((filter.Page - 1) * filter.PageSize) + 1;
    private int PageEnd => totalCount == 0 ? 0 : Math.Min(filter.Page * filter.PageSize, totalCount);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
        if (tenantId.HasValue && companyId.HasValue)
        {
            syncStatus = (await LegacySyncService.GetModuleStatusesAsync(tenantId.Value))
                .FirstOrDefault(status =>
                    status.CompanyId == companyId.Value &&
                    string.Equals(status.ModuleKey, LegacySyncModuleKeys.SalesInvoices, StringComparison.OrdinalIgnoreCase));
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        errorMessage = string.Empty;
        if (!tenantId.HasValue || !companyId.HasValue)
        {
            items = [];
            totalCount = 0;
            return;
        }

        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            filter.SortColumn = sortColumn;
            filter.SortDescending = sortDescending;
            var result = await SalesOrderQueries.SearchInvoicesAsync(tenantId.Value, companyId.Value, filter);
            items = result.Items;
            totalCount = result.TotalCount;
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            items = [];
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        filter.Page = 1;
        await LoadAsync();
    }

    private async Task SetSortAsync(string column, bool defaultDescending = false)
    {
        if (string.Equals(sortColumn, column, StringComparison.Ordinal))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = defaultDescending;
        }

        filter.Page = 1;
        await LoadAsync();
    }

    private async Task ChangePageAsync(int page)
    {
        var newPage = Math.Max(1, Math.Min(page, TotalPages));
        if (newPage == filter.Page)
        {
            return;
        }

        filter.Page = newPage;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize))
        {
            return;
        }

        filter.PageSize = pageSize;
        filter.Page = 1;
        await LoadAsync();
    }

    private string FormatInvoiceStatus(string status) => status switch
    {
        SalesInvoiceStatuses.Issued => L("Emitida", "Emesa", "Issued"),
        SalesInvoiceStatuses.Cancelled => L("Anulada", "Anul·lada", "Cancelled"),
        _ => status
    };

    private static string GetInvoiceStatusClass(string status) => status switch
    {
        SalesInvoiceStatuses.Cancelled => "danger",
        _ => "success"
    };

    private string FormatPaymentStatus(string status, bool isOverdue) => status switch
    {
        SalesInvoicePaymentStatuses.Pending when isOverdue => L("Pendiente vencida", "Pendent vençuda", "Overdue pending"),
        SalesInvoicePaymentStatuses.Pending => L("Pendiente", "Pendent", "Pending"),
        SalesInvoicePaymentStatuses.PartiallyPaid when isOverdue => L("Parcial vencida", "Parcial vençuda", "Overdue partial"),
        SalesInvoicePaymentStatuses.PartiallyPaid => L("Cobro parcial", "Cobrament parcial", "Partial payment"),
        SalesInvoicePaymentStatuses.Paid => L("Cobrada", "Cobrada", "Paid"),
        _ => status
    };

    private static string GetPaymentStatusClass(string status, bool isOverdue) => status switch
    {
        SalesInvoicePaymentStatuses.Paid => "success",
        _ when isOverdue => "danger",
        _ => "warning"
    };

    private string FormatAccountingStatus(string status) => status switch
    {
        SalesInvoiceAccountingStatuses.Pending => L("Pendiente", "Pendent", "Pending"),
        SalesInvoiceAccountingStatuses.Ready => L("Preparada", "Preparada", "Ready"),
        SalesInvoiceAccountingStatuses.Exported => L("Exportada", "Exportada", "Exported"),
        _ => status
    };

    private static string GetAccountingStatusClass(string status) => status switch
    {
        SalesInvoiceAccountingStatuses.Exported => "success",
        SalesInvoiceAccountingStatuses.Ready => "warning",
        _ => "warning"
    };
}
