@using System.Globalization
@using System.Text
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IGlobalSearchService GlobalSearchService
@inject NavigationManager NavigationManager
@inject AppText T

@if (isAuthenticated && !requiresPasswordChange)
{
    <div class="global-search-panel @CssClass">
        @if (ShowLabel)
        {
            <label class="sidebar-label" for="@InputId">@L("Buscador global", "Cercador global", "Global search")</label>
        }
        <div class="global-search-input-wrap">
            <span class="global-search-icon" aria-hidden="true">⌕</span>
            <input id="@InputId"
                   class="global-search-input"
                   type="search"
                   value="@globalSearchQuery"
                   autocomplete="off"
                   placeholder="@L("Buscar pantallas, datos o documentos", "Cercar pantalles, dades o documents", "Search screens, data, or documents")"
                   @oninput="OnGlobalSearchInput"
                   @onkeydown="OnGlobalSearchKeyDown" />
            @if (!string.IsNullOrWhiteSpace(globalSearchQuery))
            {
                <button type="button"
                        class="global-search-clear"
                        title="@L("Limpiar búsqueda", "Netejar cerca", "Clear search")"
                        aria-label="@L("Limpiar búsqueda", "Netejar cerca", "Clear search")"
                        @onclick="ClearGlobalSearch">
                    ×
                </button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(globalSearchQuery))
        {
            var navigationResults = GetGlobalSearchResults();
            var dataGroups = dataSearchResult?.Groups ?? [];
            var hasDataResults = dataGroups.Any(group => group.Items.Count > 0);
            <div class="global-search-results" role="listbox" aria-label="@L("Resultados del buscador global", "Resultats del cercador global", "Global search results")">
                @if (navigationResults.Count == 0 && !hasDataResults && !isDataSearchLoading)
                {
                    <p class="global-search-empty">@L("No encuentro accesos ni datos para esa búsqueda.", "No trobo accessos ni dades per a aquesta cerca.", "No matching shortcuts or data found.")</p>
                }
                else
                {
                    @if (navigationResults.Count > 0)
                    {
                        <div class="global-search-group-label">@L("Accesos", "Accessos", "Shortcuts")</div>
                        @foreach (var result in navigationResults.Take(5))
                        {
                            <a class="global-search-result"
                               href="@result.Entry.Href"
                               @onclick="ClearGlobalSearch"
                               role="option">
                                <span class="global-search-result-area">@result.Entry.Area</span>
                                <strong>@result.Entry.Label</strong>
                                <span>@result.Entry.Description</span>
                            </a>
                        }
                    }

                    @foreach (var group in dataGroups.Where(group => group.Items.Count > 0))
                    {
                        <div class="global-search-group-label">@GroupTitle(group)</div>
                        @foreach (var item in group.Items.Take(5))
                        {
                            <a class="global-search-result global-search-data-result"
                               href="@item.Href"
                               @onclick="ClearGlobalSearch"
                               role="option">
                                <span class="global-search-result-area">@ItemBadge(item)</span>
                                <strong>@item.Title</strong>
                                <span>@BuildItemMeta(item)</span>
                            </a>
                        }
                    }

                    @if (isDataSearchLoading)
                    {
                        <p class="global-search-empty">@L("Buscando datos reales...", "Cercant dades reals...", "Searching live data...")</p>
                    }
                }

                @if (!string.IsNullOrWhiteSpace(dataSearchError))
                {
                    <p class="global-search-empty">@dataSearchError</p>
                }

                @if (globalSearchQuery.Trim().Length >= 2)
                {
                    <a class="global-search-view-all" href="@BuildSearchPageHref()" @onclick="ClearGlobalSearch">
                        @L("Ver todos los resultados", "Veure tots els resultats", "View all results")
                    </a>
                }
            </div>
        }
        else if (ShowHint)
        {
            <p class="global-search-hint">@L("Ej.: cliente, proveedor, tejido, factura, stock, planta, hilos.", "Ex.: client, proveidor, teixit, factura, estoc, planta, fils.", "E.g.: client, supplier, fabric, invoice, stock, plant, yarns.")</p>
        }
    </div>
}

@code {
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string InputId { get; set; } = "global-navigation-search";
    [Parameter] public bool ShowHint { get; set; } = true;
    [Parameter] public bool ShowLabel { get; set; } = true;

    private bool isAuthenticated;
    private bool isPlatformAdmin;
    private bool canManageTenant;
    private bool requiresPasswordChange;
    private Guid? tenantId;
    private Guid? companyId;
    private string globalSearchQuery = string.Empty;
    private GlobalSearchResultDto? dataSearchResult;
    private CancellationTokenSource? searchDebounceCts;
    private bool isDataSearchLoading;
    private string dataSearchError = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        requiresPasswordChange = isAuthenticated && user.RequiresPasswordChange();
        isPlatformAdmin = isAuthenticated && user.IsPlatformAdmin();
        canManageTenant = isAuthenticated && (isPlatformAdmin || user.IsInRole(PlatformRoles.TenantAdmin));
        tenantId = user.GetTenantId();
        companyId = user.GetActiveCompanyId();
    }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        globalSearchQuery = string.Empty;
        dataSearchResult = null;
        dataSearchError = string.Empty;
        isDataSearchLoading = false;
        searchDebounceCts?.Cancel();
        _ = InvokeAsync(StateHasChanged);
    }

    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    private void OnGlobalSearchInput(ChangeEventArgs args)
    {
        globalSearchQuery = args.Value?.ToString() ?? string.Empty;
        _ = ScheduleDataSearchAsync(globalSearchQuery);
    }

    private void ClearGlobalSearch()
    {
        globalSearchQuery = string.Empty;
        dataSearchResult = null;
        dataSearchError = string.Empty;
        isDataSearchLoading = false;
        searchDebounceCts?.Cancel();
    }

    private void OnGlobalSearchKeyDown(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var targetHref = GetEnterTargetHref();
        if (string.IsNullOrWhiteSpace(targetHref))
        {
            return;
        }

        globalSearchQuery = string.Empty;
        dataSearchResult = null;
        NavigationManager.NavigateTo(targetHref);
    }

    private async Task ScheduleDataSearchAsync(string query)
    {
        searchDebounceCts?.Cancel();
        dataSearchError = string.Empty;

        if (query.Trim().Length < 2 || !tenantId.HasValue || !companyId.HasValue)
        {
            dataSearchResult = null;
            isDataSearchLoading = false;
            return;
        }

        var cts = new CancellationTokenSource();
        searchDebounceCts = cts;
        isDataSearchLoading = true;

        try
        {
            await Task.Delay(250, cts.Token);
            var result = await GlobalSearchService.SearchAsync(
                tenantId.Value,
                companyId.Value,
                new GlobalSearchFilter
                {
                    Search = query,
                    MaxResultsPerGroup = 5
                },
                cts.Token);

            if (searchDebounceCts == cts)
            {
                dataSearchResult = result;
                isDataSearchLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
            if (searchDebounceCts == cts)
            {
                dataSearchResult = null;
                dataSearchError = L("No he podido completar la búsqueda de datos.", "No he pogut completar la cerca de dades.", "Live data search could not be completed.");
                isDataSearchLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private string? GetEnterTargetHref()
    {
        var navigationResult = GetGlobalSearchResults().FirstOrDefault();
        if (navigationResult is not null && navigationResult.Score >= 40)
        {
            return navigationResult.Entry.Href;
        }

        var dataResult = dataSearchResult?.Groups
            .SelectMany(group => group.Items)
            .OrderByDescending(item => item.Score)
            .ThenByDescending(item => item.Date)
            .FirstOrDefault();

        return dataResult?.Href ?? navigationResult?.Entry.Href;
    }

    private string BuildSearchPageHref() =>
