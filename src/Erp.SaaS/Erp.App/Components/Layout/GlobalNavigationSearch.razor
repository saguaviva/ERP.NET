        };

    private string BuildItemMeta(GlobalSearchItemDto item)
    {
        var parts = new List<string>();
        if (item.Date.HasValue)
        {
            parts.Add(item.Date.Value.ToString("dd/MM/yyyy"));
        }

        if (!string.IsNullOrWhiteSpace(item.Subtitle))
        {
            parts.Add(item.Subtitle);
        }

        if (item.Amount.HasValue)
        {
            parts.Add($"{item.Amount.Value.ToUiString("N2")} €");
        }

        return string.Join(" · ", parts);
    }

    private IReadOnlyList<GlobalSearchResult> GetGlobalSearchResults()
    {
        var tokens = TokenizeForSearch(globalSearchQuery);
        if (tokens.Count == 0)
        {
            return [];
        }

        return BuildGlobalSearchEntries()
            .Select(entry => new GlobalSearchResult(entry, ScoreGlobalSearchEntry(entry, tokens)))
            .Where(result => result.Score > 0)
            .OrderByDescending(result => result.Score)
            .ThenBy(result => result.Entry.Area)
            .ThenBy(result => result.Entry.Label)
            .Take(9)
            .ToArray();
    }

