    private GlobalSearchEntry Entry(string label, string href, string area, string description, string keywords) =>
        new(label, href, area, description, Tags(keywords));

    private static string[] Tags(string keywords) =>
        keywords.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static int ScoreGlobalSearchEntry(GlobalSearchEntry entry, IReadOnlyList<string> tokens)
    {
        var words = TokenizeForSearch($"{entry.Label} {entry.Area} {entry.Description} {string.Join(' ', entry.Keywords)}");
        if (words.Count == 0)
        {
            return 0;
        }

        var score = 0;
        foreach (var token in tokens)
        {
            var tokenScore = 0;
            foreach (var word in words)
            {
                if (word == token)
                {
                    tokenScore = Math.Max(tokenScore, 45);
                }
                else if (word.StartsWith(token, StringComparison.Ordinal))
                {
                    tokenScore = Math.Max(tokenScore, 30);
                }
                else if (word.Contains(token, StringComparison.Ordinal) || token.Contains(word, StringComparison.Ordinal))
                {
                    tokenScore = Math.Max(tokenScore, 18);
                }
                else if (AreSimilarWords(token, word))
                {
                    tokenScore = Math.Max(tokenScore, 14);
                }
            }

            if (tokenScore == 0)
            {
                return 0;
            }

            score += tokenScore;
        }

        return score;
    }

    private static IReadOnlyList<string> TokenizeForSearch(string value)
    {
        var normalized = NormalizeForSearch(value);
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return [];
        }

        var ignored = new HashSet<string>(["de", "del", "la", "el", "los", "las", "un", "una", "y", "o", "a", "en", "per", "por", "the", "of", "to"], StringComparer.Ordinal);
        return normalized
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(token => token.Length > 1 && !ignored.Contains(token))
            .Distinct(StringComparer.Ordinal)
            .ToArray();
    }

    private static string NormalizeForSearch(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var builder = new StringBuilder(value.Length);
        var normalized = value.Normalize(NormalizationForm.FormD);
        foreach (var character in normalized)
        {
            var category = CharUnicodeInfo.GetUnicodeCategory(character);
            if (category == UnicodeCategory.NonSpacingMark)
            {
                continue;
            }

            if (char.IsLetterOrDigit(character))
            {
                builder.Append(char.ToLowerInvariant(character));
            }
            else
            {
                builder.Append(' ');
            }
        }

        return builder.ToString();
    }

    private static bool AreSimilarWords(string token, string word)
    {
        if (token.Length < 4 || word.Length < 4)
        {
            return false;
        }

        var distance = LevenshteinDistance(token, word);
        var tolerance = Math.Max(1, Math.Min(token.Length, word.Length) / 4);
        return distance <= tolerance;
    }

    private static int LevenshteinDistance(string left, string right)
    {
        var previous = new int[right.Length + 1];
        var current = new int[right.Length + 1];

        for (var column = 0; column <= right.Length; column++)
        {
            previous[column] = column;
        }

        for (var row = 1; row <= left.Length; row++)
        {
            current[0] = row;
            for (var column = 1; column <= right.Length; column++)
            {
                var cost = left[row - 1] == right[column - 1] ? 0 : 1;
                current[column] = Math.Min(
                    Math.Min(current[column - 1] + 1, previous[column] + 1),
                    previous[column - 1] + cost);
            }

            (previous, current) = (current, previous);
        }

        return previous[right.Length];
    }

    private async Task ToggleSectionAsync(string key)
    {
        if (collapsedSectionKeys.Contains(key))
        {
            collapsedSectionKeys.Remove(key);
        }
        else
        {
            collapsedSectionKeys.Add(key);
        }

        if (!navCollapseStateLoaded)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("erpUi.setCollapsedNavSections", collapsedSectionKeys.ToArray());
        }
        catch (JSException)
        {
        }
    }

    private HashSet<string> GetDefaultCollapsedSectionKeys() =>
        new(navigationSections.Select(section => section.Key), StringComparer.OrdinalIgnoreCase);

    private sealed record SidebarSection(string Key, string Title, IReadOnlyList<SidebarLink> Links);

    private sealed record SidebarLink(string Label, string Href, NavLinkMatch Match = NavLinkMatch.Prefix);

    private sealed record GlobalSearchEntry(string Label, string Href, string Area, string Description, IReadOnlyList<string> Keywords);

    private sealed record GlobalSearchResult(GlobalSearchEntry Entry, int Score);

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
