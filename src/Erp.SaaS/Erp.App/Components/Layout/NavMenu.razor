    private void OnGlobalSearchInput(ChangeEventArgs args)
    {
        globalSearchQuery = args.Value?.ToString() ?? string.Empty;
    }

    private void ClearGlobalSearch()
    {
        globalSearchQuery = string.Empty;
    }

    private void OnGlobalSearchKeyDown(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var firstResult = GetGlobalSearchResults().FirstOrDefault();
        if (firstResult is null)
        {
            return;
        }

        globalSearchQuery = string.Empty;
        NavigationManager.NavigateTo(firstResult.Entry.Href);
    }

    private IReadOnlyList<GlobalSearchResult> GetGlobalSearchResults()
    {
        var tokens = TokenizeForSearch(globalSearchQuery);
        if (tokens.Count == 0)
        {
            return [];
        }

        return BuildGlobalSearchEntries()
            .Select(entry => new GlobalSearchResult(entry, ScoreGlobalSearchEntry(entry, tokens)))
            .Where(result => result.Score > 0)
            .OrderByDescending(result => result.Score)
            .ThenBy(result => result.Entry.Area)
            .ThenBy(result => result.Entry.Label)
            .Take(9)
            .ToArray();
    }

