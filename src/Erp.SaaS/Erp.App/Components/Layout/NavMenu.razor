@using System.Globalization
@using System.Text
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject AppText T

<div class="brand-block">
    <a class="brand-link" href="/">
        <span class="brand-kicker">@T["brand.kicker"]</span>
        <strong>CoreFlow</strong>
    </a>
</div>

@if (isAuthenticated)
{
    <div class="sidebar-panel">
        <div class="sidebar-label">@T["menu.user"]</div>
        <div class="sidebar-user">@displayName</div>
        <div class="sidebar-muted">@email</div>
    </div>

    @if (requiresPasswordChange)
    {
        <div class="sidebar-panel">
            <div class="sidebar-label">@T["menu.security"]</div>
            <div class="sidebar-muted">@T["menu.security.passwordChangeRequired"]</div>
        </div>
    }
    @if (!requiresPasswordChange)
    {
        <nav class="sidebar-nav">
            <NavLink class="sidebar-link sidebar-link-home" href="/" Match="NavLinkMatch.All">@T["menu.dashboard"]</NavLink>
            <NavLink class="sidebar-link sidebar-link-home" href="/manual">@T["menu.manual"]</NavLink>
            <NavLink class="sidebar-link sidebar-link-home" href="/alertas">@T["menu.alerts"]</NavLink>
            <NavLink class="sidebar-link sidebar-link-home" href="/listados">@T["menu.reports"]</NavLink>
            <NavLink class="sidebar-link sidebar-link-home" href="/estadisticas">@T["menu.statistics"]</NavLink>

            @foreach (var navSection in navigationSections)
            {
                var isCollapsed = collapsedSectionKeys.Contains(navSection.Key);
                <div class="sidebar-nav-group">
                    <button type="button"
                            class="sidebar-group-toggle @(isCollapsed ? "collapsed" : "expanded")"
                            aria-expanded="@(!isCollapsed)"
                            @onclick="() => ToggleSectionAsync(navSection.Key)">
                        <span class="sidebar-group-title">@navSection.Title</span>
                        <span class="sidebar-group-toggle-icon" aria-hidden="true">@(isCollapsed ? "▸" : "▾")</span>
                    </button>

                    @if (!isCollapsed)
                    {
                        <div class="sidebar-group-links">
                            @foreach (var link in navSection.Links)
                            {
                            <NavLink class="sidebar-link" href="@link.Href" Match="@link.Match">@link.Label</NavLink>
                        }
                    </div>
                    }
                </div>
            }
        </nav>
    }

    <form method="post" action="/account/logout" data-enhance="false">
        <AntiforgeryToken />
        <button class="sidebar-logout" type="submit">@T["menu.logout"]</button>
    </form>
}
else
{
    <nav class="sidebar-nav">
        <NavLink class="sidebar-link" href="/login">@T["menu.login"]</NavLink>
    </nav>
}

@code {
    private bool isAuthenticated;
    private bool isPlatformAdmin;
    private bool canManageTenant;
    private bool requiresPasswordChange;
    private bool navCollapseStateLoaded;
    private string displayName = string.Empty;
    private string email = string.Empty;
    private IReadOnlyList<SidebarSection> navigationSections = [];
    private HashSet<string> collapsedSectionKeys = new(StringComparer.OrdinalIgnoreCase);
    private string globalSearchQuery = string.Empty;

    private string CurrentPath
    {
        get
        {
            var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            return string.IsNullOrWhiteSpace(relativePath) ? "/" : $"/{relativePath}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        if (!isAuthenticated)
        {
            navigationSections = [];
            return;
        }

        displayName = user.Identity?.Name ?? string.Empty;
        email = user.FindFirstValue(ClaimTypes.Email) ?? string.Empty;
        isPlatformAdmin = user.IsPlatformAdmin();
        canManageTenant = isPlatformAdmin || user.IsInRole(PlatformRoles.TenantAdmin);
        requiresPasswordChange = user.RequiresPasswordChange();

        if (requiresPasswordChange)
        {
            navigationSections = [];
            return;
        }

        navigationSections = BuildNavigationSections();
        if (!navCollapseStateLoaded)
        {
            collapsedSectionKeys = GetDefaultCollapsedSectionKeys();
        }
    }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var storedKeys = await JS.InvokeAsync<string[]?>("erpUi.getCollapsedNavSections");
            collapsedSectionKeys = storedKeys is null
                ? GetDefaultCollapsedSectionKeys()
                : new HashSet<string>(storedKeys, StringComparer.OrdinalIgnoreCase);
            navCollapseStateLoaded = true;
            StateHasChanged();
        }
        catch (JSException)
        {
            collapsedSectionKeys = GetDefaultCollapsedSectionKeys();
            navCollapseStateLoaded = true;
        }
        catch (InvalidOperationException)
        {
            collapsedSectionKeys = GetDefaultCollapsedSectionKeys();
            navCollapseStateLoaded = true;
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        globalSearchQuery = string.Empty;
        _ = InvokeAsync(StateHasChanged);
    }

    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
