@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject AppText T

<div class="shell">
    <aside class="shell-sidebar">
        <NavMenu />
    </aside>

    <main class="shell-main">
        <div class="shell-toolbar no-print">
            <button type="button"
                    class="shell-toggle"
                    aria-label="@L("Mostrar u ocultar menú lateral", "Mostrar o ocultar menú lateral", "Show or hide side menu")"
                    aria-expanded="@(!isSidebarHidden)"
                    @onclick="ToggleSidebarAsync">
                <span class="shell-toggle-icon" aria-hidden="true">@(isSidebarHidden ? "☰" : "←")</span>
                <span class="shell-toggle-label">@(isSidebarHidden ? T["shell.showMenu"] : T["shell.hideMenu"])</span>
            </button>
        </div>

        <article class="shell-content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @L("Ha ocurrido un error inesperado.", "S'ha produït un error inesperat.", "An unexpected error occurred.")
    <a href="." class="reload">@L("Recargar", "Recarregar", "Reload")</a>
    <span class="dismiss">x</span>
</div>

@code {
    private bool isSidebarHidden;

    private string L(string spanish, string catalan, string english) =>
        T.CurrentLanguage switch
        {
            AppLanguages.Catalan => catalan,
            AppLanguages.English => english,
            _ => spanish
        };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            isSidebarHidden = await JS.InvokeAsync<bool>("erpUi.getSidebarHidden");
            StateHasChanged();
        }
        catch (JSException)
        {
            isSidebarHidden = false;
        }
        catch (InvalidOperationException)
        {
            isSidebarHidden = false;
        }
    }

    private async Task ToggleSidebarAsync()
    {
        isSidebarHidden = !isSidebarHidden;

        try
        {
            await JS.InvokeVoidAsync("erpUi.setSidebarHidden", isSidebarHidden);
        }
        catch (JSException)
        {
        }
    }
}
