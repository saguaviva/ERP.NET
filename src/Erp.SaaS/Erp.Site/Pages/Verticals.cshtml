@page
@model Erp.Site.Pages.VerticalsModel
@{
    ViewData["Title"] = "Verticales";
}

<section class="section-block">
    <div class="section-heading">
        <div>
            <p class="kicker">Verticales</p>
            <h1>Especializado hoy en entornos industriales con raíz textil.</h1>
        </div>
    </div>

    <div class="section-grid">
        <article class="feature-card">
            <h2>Fabricación textil</h2>
            <p>Trazabilidad, centros legacy y una base preparada para producción, compras y control operativo.</p>
        </article>
        <article class="feature-card">
            <h2>Distribución especializada</h2>
            <p>Multiempresa para grupos que comparten clientes, personal y reglas comunes, pero operan desde varias sociedades.</p>
        </article>
        <article class="feature-card">
            <h2>Evolución a vertical genérico</h2>
            <p>Arquitectura limpia para desacoplar el origen textil y crecer hacia otras industrias sin rehacer la plataforma.</p>
        </article>
    </div>
</section>
