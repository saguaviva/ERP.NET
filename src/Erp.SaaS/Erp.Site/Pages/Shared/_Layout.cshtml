<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CoreFlow ERP</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Erp.Site.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="site-shell">
        <header class="site-header">
            <a class="site-brand" asp-page="/Index">
                <span class="site-brand-kicker">ERP SaaS</span>
                <strong>CoreFlow</strong>
            </a>

            <nav class="site-nav">
                <a asp-page="/Product">Producto</a>
                <a asp-page="/Pricing">Pricing</a>
                <a asp-page="/Verticals">Verticales</a>
                <a asp-page="/Demo" class="site-cta">Solicitar demo</a>
            </nav>
        </header>

        <main class="site-main">
            @RenderBody()
        </main>

        <footer class="site-footer">
            <div>
                <strong>CoreFlow ERP</strong>
                <p>ERP SaaS multiempresa preparado para grupos industriales y operativa diaria real.</p>
            </div>
            <div class="footer-links">
                <a asp-page="/Pricing">Planes</a>
                <a asp-page="/Demo">Demo</a>
                <a href="/login">Acceso cliente</a>
            </div>
        </footer>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
